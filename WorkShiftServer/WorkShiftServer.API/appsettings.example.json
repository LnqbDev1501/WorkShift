{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "MyCnn": "Host=YOUR_DATABASE_HOST;Port=5432;Database=postgres;Username=YOUR_DATABASE_USER;Password=YOUR_DATABASE_PASSWORD"
  },
  "Supabase": {
    "Url": "https://YOUR_PROJECT_REF.supabase.co",
    "ServiceRoleKey": "YOUR_SUPABASE_SERVICE_ROLE_KEY"
  },
  "AdminUi": {
    "SetPasswordUrl": "https://localhost:7235/Auth/SetPassword",
    "ResetPasswordUrl": "https://localhost:7235/Auth/ResetPassword"
  },
  "Cloudinary": {
    "DefaultAvatarUrl": "https://res.cloudinary.com/YOUR_CLOUD_NAME/image/upload/YOUR_DEFAULT_AVATAR_PUBLIC_ID"
  },
  "AdminNotification": {
    "CreatedByEmail": "an_active_admin@example.com"
  },
  "Resend": {
    "ApiKey": "re_your_resend_api_key",
    "AccountSetupTemplateId": "your_published_template_id_or_alias",
    "NotificationTemplateId": "your_published_notification_template_id_or_alias"
  }
}
