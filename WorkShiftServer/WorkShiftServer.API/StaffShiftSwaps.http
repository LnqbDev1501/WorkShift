@baseUrl = http://localhost:5000
@requesterToken = REPLACE_WITH_REQUESTER_STAFF_TOKEN
@targetToken = REPLACE_WITH_TARGET_STAFF_TOKEN
@requestId = 1
@sourceAssignmentId = 1
@targetAssignmentId = 2

### List own sent/received requests (Direction: ALL, SENT, RECEIVED)
# Status supports PENDING, ACCEPTED, REJECTED, CANCELLED, EXPIRED.
# Due PENDING requests are persisted as EXPIRED before filtering and paging.
GET {{baseUrl}}/api/staff/shift-swap-requests?PageNumber=1&PageSize=20&Direction=ALL&Status=PENDING
Authorization: Bearer {{requesterToken}}

### Details (only requester or target)
GET {{baseUrl}}/api/staff/shift-swap-requests/{{requestId}}
Authorization: Bearer {{requesterToken}}

### Submit (target user is resolved from the target assignment)
POST {{baseUrl}}/api/staff/shift-swap-requests
Authorization: Bearer {{requesterToken}}
Content-Type: application/json

{
  "sourceAssignmentId": {{sourceAssignmentId}},
  "targetAssignmentId": {{targetAssignmentId}},
  "reason": "Please swap these shifts with me"
}

### Cancel (requester only)
POST {{baseUrl}}/api/staff/shift-swap-requests/{{requestId}}/cancel
Authorization: Bearer {{requesterToken}}
Content-Type: application/json

{ "note": "No longer need to swap" }

### Accept (target only, no request body; exchanges assignments atomically)
# Accept/reject/cancel return 409 when now >= min(source start, target start).
# Expiry is persisted and assignments remain unchanged even when the action returns 409.
POST {{baseUrl}}/api/staff/shift-swap-requests/{{requestId}}/accept
Authorization: Bearer {{targetToken}}

### Reject (target only)
POST {{baseUrl}}/api/staff/shift-swap-requests/{{requestId}}/reject
Authorization: Bearer {{targetToken}}
Content-Type: application/json

{ "note": "Unable to take the proposed shift" }
