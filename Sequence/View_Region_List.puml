@startuml
title Sequence Diagram - View Region List

autonumber

actor Admin
boundary "Region List View" as UI
control "RegionsController" as MVC
control "RegionApiService" as Client
control "AdminRegionController" as API
control "RegionService" as BLL
entity "RegionRepo" as DAL
database "Database" as DB


' =====================================================
' ADMIN
' =====================================================

activate Admin


' =====================================================
' REGION LIST REQUEST
' =====================================================

Admin -> MVC : Open Region List
activate MVC

MVC -> Client : GetPagedAsync(page = 1, pageSize = 10)
activate Client


' =====================================================
' INTERNAL PROCESSING - CLIENT
' =====================================================

Client -> Client ++ : Build query parameters\n(pageNumber=1, pageSize=10)
deactivate Client

Client -> API : GET /api/admin/regions?pageNumber=1&pageSize=10
activate API

API -> BLL : GetPagedAsync(query)
activate BLL


' =====================================================
' INTERNAL PROCESSING - BLL
' =====================================================

BLL -> BLL ++ : Normalize pagination parameters\n(pageNumber, pageSize)
deactivate BLL

BLL -> DAL : GetPagedAsync(search = null, isActive = null, pageNumber, pageSize)
activate DAL


' =====================================================
' DATABASE QUERIES
' =====================================================

DAL -> DB : Count total region records
activate DB

DB --> DAL : Total regions count
deactivate DB


DAL -> DB : Query paged regions with\nregional minimum wage and branch count\n(OrderBy, Skip, Take)
activate DB

DB --> DAL : List of RegionData
deactivate DB


' =====================================================
' CHECK RETRIEVED DATA
' =====================================================

DAL -> DAL ++ : Check retrieved region list data
deactivate DAL


' Tạo khoảng cách giữa các bước query và ALT
||30||


' =====================================================
' RESULT
' =====================================================

alt Processing succeeds

    ' -------------------------------------------------
    ' 13 - RegionRepo kết thúc tại đây
    ' -------------------------------------------------

    DAL --> BLL : (items, totalCount)
    deactivate DAL


    ' -------------------------------------------------
    ' 14 - BLL xử lý response
    ' -------------------------------------------------

    BLL -> BLL ++ : Map RegionData list to\nPagedResponse<RegionResponse>
    deactivate BLL


    ' -------------------------------------------------
    ' 15 - RegionService kết thúc tại đây
    ' -------------------------------------------------

    BLL --> API : PagedResponse<RegionResponse>
    deactivate BLL


    ' -------------------------------------------------
    ' 16 - API trả về dữ liệu thành công
    ' -------------------------------------------------

    API --> Client : HTTP 200 OK\nJSON PagedResponse


    ' -------------------------------------------------
    ' 17 - Client deserialize và map model
    ' -------------------------------------------------

    Client -> Client ++ : Deserialize and map to\nRegionListPagedViewModel
    deactivate Client


    ' -------------------------------------------------
    ' 18 - Client trả về ViewModel cho MVC Controller
    ' -------------------------------------------------

    Client --> MVC : RegionListPagedViewModel


    ' -------------------------------------------------
    ' 19 - MVC xử lý và gán thông báo
    ' -------------------------------------------------

    MVC -> MVC ++ : Assign TempData messages\nto viewModel
    deactivate MVC


    ' -------------------------------------------------
    ' 20 - Region List View bắt đầu activation
    ' -------------------------------------------------

    MVC --> UI : View("Index", viewModel)
    activate UI


    ' -------------------------------------------------
    ' 21 - Hiển thị danh sách lên màn hình Admin
    ' -------------------------------------------------

    UI --> Admin : Display region list\nand pagination


else Backend processing fails

    ' -------------------------------------------------
    ' 22 - Ghi log lỗi tại API Controller
    ' -------------------------------------------------

    API -> API ++ : Log error
    deactivate API


    ' -------------------------------------------------
    ' 23 - AdminRegionController kết thúc tại đây
    ' -------------------------------------------------

    API --> Client : HTTP 500\nError message
    deactivate API


    ' -------------------------------------------------
    ' 24 - RegionApiService kết thúc tại đây
    ' -------------------------------------------------

    Client --> MVC : Return ViewModel with ErrorMessage\n(or HttpRequestException)
    deactivate Client


    ' -------------------------------------------------
    ' 25 - MVC xử lý lỗi
    ' -------------------------------------------------

    MVC -> MVC ++ : Log error and assign\nviewModel.ErrorMessage
    deactivate MVC


    ' -------------------------------------------------
    ' 26 - RegionsController kết thúc tại đây
    ' -------------------------------------------------

    MVC --> UI : View("Index", viewModel)
    deactivate MVC


    ' -------------------------------------------------
    ' 27 - Region List View + Admin kết thúc tại đây
    ' -------------------------------------------------

    UI --> Admin : Display region list\nloading error

    deactivate UI
    deactivate Admin

end
@enduml
