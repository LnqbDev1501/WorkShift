@startuml
title Sequence Diagram - Create Regional Minimum Wage Rate

autonumber

actor Admin
boundary "Create Wage View" as UI
control "RegionalMinimumWagesController" as MVC
control "RegionalMinimumWageApiService" as Client
control "AdminRegionalMinimumWageController" as API
control "RegionalMinimumWageService" as BLL
entity "RegionalMinimumWageRepo" as DAL
database "Database" as DB


' =====================================================
' ADMIN
' =====================================================

activate Admin


' =====================================================
' CREATE WAGE REQUEST
' =====================================================

Admin -> MVC : Submit Create Wage form (model)
activate MVC

MVC -> MVC ++ : Validate ModelState
deactivate MVC

MVC -> Client : CreateAsync(model)
activate Client


' =====================================================
' INTERNAL PROCESSING - CLIENT
' =====================================================

Client -> Client ++ : Build and serialize\nCreateRegionalMinimumWage JSON payload
deactivate Client

Client -> API : POST /api/admin/regional-minimum-wages (JSON payload)
activate API

API -> API ++ : Extract callerId from JWT Claims
deactivate API

API -> BLL : CreateAsync(request, callerId)
activate BLL


' =====================================================
' INTERNAL PROCESSING - BLL (FIELD VALIDATION)
' =====================================================

BLL -> BLL ++ : Validate WageName (<= 150 chars)\nand MinimumHourlyRate (> 0)
deactivate BLL


' =====================================================
' DATABASE VALIDATION QUERIES (IF REPLACED WAGE SPECIFIED)
' =====================================================

opt ReplacedWageId is specified

    BLL -> DAL : IsActiveAsync(replacedWageId)
    activate DAL

    DAL -> DB : SELECT * FROM regional_minimum_wages\nWHERE id = replacedWageId AND Status = 'ACTIVE'
    activate DB

    DB --> DAL : true (wage is active)
    deactivate DB

    DAL --> BLL : true
    deactivate DAL

    BLL -> DAL : GetByIdAsync(replacedWageId)
    activate DAL

    DAL -> DB : SELECT * FROM regional_minimum_wages WHERE id = replacedWageId
    activate DB

    DB --> DAL : Replaced wage record
    deactivate DB

    DAL --> BLL : Replaced wage record
    deactivate DAL

    BLL -> BLL ++ : Validate EffectiveFrom > ReplacedWage.EffectiveFrom
    deactivate BLL

end


' =====================================================
' DATABASE PERSISTENCE
' =====================================================

BLL -> DAL : CreateAsync(newWage entity with Status = 'DRAFT')
activate DAL

DAL -> DB : INSERT INTO regional_minimum_wages\n(Status = 'DRAFT', CreatedBy = callerId)\nand SaveChangesAsync
activate DB

DB --> DAL : Saved entity with generated RegionalMinimumWageId
deactivate DB


' =====================================================
' CHECK CREATED DATA
' =====================================================

DAL -> DAL ++ : Check created wage record
deactivate DAL


' Tạo khoảng cách giữa các bước query và ALT
||30||


' =====================================================
' RESULT
' =====================================================

alt Processing succeeds

    ' -------------------------------------------------
    ' 21 - RegionalMinimumWageRepo kết thúc tại đây
    ' -------------------------------------------------

    DAL --> BLL : RegionalMinimumWage entity
    deactivate DAL


    ' -------------------------------------------------
    ' 22 - BLL xử lý response
    ' -------------------------------------------------

    BLL -> BLL ++ : Map entity to RegionalMinimumWageDetailResponse
    deactivate BLL


    ' -------------------------------------------------
    ' 23 - RegionalMinimumWageService kết thúc tại đây
    ' -------------------------------------------------

    BLL --> API : RegionalMinimumWageDetailResponse
    deactivate BLL


    ' -------------------------------------------------
    ' 24 - API trả về 201 Created cùng Location Header
    ' -------------------------------------------------

    API --> Client : HTTP 201 Created\nJSON RegionalMinimumWageDetailResponse (CreatedAtAction)


    ' -------------------------------------------------
    ' 25 - Client kiểm tra status code
    ' -------------------------------------------------

    Client -> Client ++ : Check IsSuccessStatusCode
    deactivate Client


    ' -------------------------------------------------
    ' 26 - Client trả về kết quả cho MVC Controller
    ' -------------------------------------------------

    Client --> MVC : (Success = true, Data = detail, ErrorMessage = null)


    ' -------------------------------------------------
    ' 27 - MVC xử lý và gán thông báo thành công
    ' -------------------------------------------------

    MVC -> MVC ++ : Assign TempData["SuccessMessage"]
    deactivate MVC


    ' -------------------------------------------------
    ' 28 - Wage Details View bắt đầu activation
    ' -------------------------------------------------

    MVC --> UI : RedirectToAction("Details", new { id = data.Id })
    activate UI


    ' -------------------------------------------------
    ' 29 - Chuyển hướng và hiển thị thông báo thành công
    ' -------------------------------------------------

    UI --> Admin : Display success notification\nand DRAFT wage details


else Validation fails / Conflict / Backend error

    ' -------------------------------------------------
    ' 30 - Ghi log lỗi tại API Controller
    ' -------------------------------------------------

    API -> API ++ : Log error / Handle 400 BadRequest\nor 409 Conflict (Replaced wage not active)
    deactivate API


    ' -------------------------------------------------
    ' 31 - AdminRegionalMinimumWageController kết thúc tại đây
    ' -------------------------------------------------

    API --> Client : HTTP 400 / 409 / 500\nProblemDetails
    deactivate API


    ' -------------------------------------------------
    ' 32 - RegionalMinimumWageApiService kết thúc tại đây
    ' -------------------------------------------------

    Client --> MVC : (Success = false, Data = null, ErrorMessage, IsConflict)
    deactivate Client


    ' -------------------------------------------------
    ' 33 - MVC xử lý lỗi và tải lại danh sách lương active
    ' -------------------------------------------------

    MVC -> MVC ++ : Add ModelState error\nand reload ActiveWages
    deactivate MVC


    ' -------------------------------------------------
    ' 34 - RegionalMinimumWagesController kết thúc tại đây
    ' -------------------------------------------------

    MVC --> UI : View(model)
    deactivate MVC


    ' -------------------------------------------------
    ' 35 - Create Wage View + Admin kết thúc tại đây
    ' -------------------------------------------------

    UI --> Admin : Display error messages\non Create Wage form

    deactivate UI
    deactivate Admin

end
@enduml
