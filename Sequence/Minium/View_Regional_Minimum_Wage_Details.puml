@startuml
title Sequence Diagram - View Regional Minimum Wage Rate Details

autonumber

actor Admin
boundary "Wage Details View" as UI
control "RegionalMinimumWagesController" as MVC
control "RegionalMinimumWageApiService" as Client
control "AdminRegionalMinimumWageController" as API
control "RegionalMinimumWageService" as BLL
entity "RegionalMinimumWageRepo" as DAL
database "Database" as DB


' =====================================================
' ADMIN
' =====================================================

activate Admin


' =====================================================
' WAGE DETAILS REQUEST
' =====================================================

Admin -> MVC : View Wage Details (id)
activate MVC

MVC -> Client : GetByIdAsync(id)
activate Client


' =====================================================
' INTERNAL PROCESSING - CLIENT
' =====================================================

Client -> Client ++ : Validate id and build URL\n(/api/admin/regional-minimum-wages/{id})
deactivate Client

Client -> API : GET /api/admin/regional-minimum-wages/{id}
activate API

API -> BLL : GetByIdAsync(id)
activate BLL


' =====================================================
' INTERNAL PROCESSING - BLL
' =====================================================

BLL -> DAL : GetByIdAsync(id)
activate DAL


' =====================================================
' DATABASE QUERIES
' =====================================================

DAL -> DB : SELECT * FROM regional_minimum_wages\nWHERE regional_minimum_wage_id = id
activate DB

DB --> DAL : RegionalMinimumWage record
deactivate DB


' =====================================================
' CHECK RETRIEVED DATA
' =====================================================

DAL -> DAL ++ : Check retrieved wage detail record
deactivate DAL


' Tạo khoảng cách giữa các bước query và ALT
||30||


' =====================================================
' RESULT
' =====================================================

alt Processing succeeds (Wage rate found)

    ' -------------------------------------------------
    ' 09 - RegionalMinimumWageRepo kết thúc tại đây
    ' -------------------------------------------------

    DAL --> BLL : RegionalMinimumWage entity
    deactivate DAL


    ' -------------------------------------------------
    ' 10 - BLL xử lý response
    ' -------------------------------------------------

    BLL -> BLL ++ : Map entity to RegionalMinimumWageDetailResponse
    deactivate BLL


    ' -------------------------------------------------
    ' 11 - RegionalMinimumWageService kết thúc tại đây
    ' -------------------------------------------------

    BLL --> API : RegionalMinimumWageDetailResponse
    deactivate BLL


    ' -------------------------------------------------
    ' 12 - API trả về dữ liệu thành công
    ' -------------------------------------------------

    API --> Client : HTTP 200 OK\nJSON RegionalMinimumWageDetailResponse


    ' -------------------------------------------------
    ' 13 - Client deserialize và map model
    ' -------------------------------------------------

    Client -> Client ++ : Deserialize to RegionalMinimumWageDetailViewModel
    deactivate Client


    ' -------------------------------------------------
    ' 14 - Client trả về ViewModel cho MVC Controller
    ' -------------------------------------------------

    Client --> MVC : RegionalMinimumWageDetailViewModel


    ' -------------------------------------------------
    ' 15 - Wage Details View bắt đầu activation
    ' -------------------------------------------------

    MVC --> UI : View(detail)
    activate UI


    ' -------------------------------------------------
    ' 16 - Hiển thị chi tiết lên màn hình Admin
    ' -------------------------------------------------

    UI --> Admin : Display wage rate details\n(Rate, Effective Dates, Status, Replaced Wage)


else Wage rate not found or processing fails

    ' -------------------------------------------------
    ' 17 - Xử lý lỗi hoặc không tìm thấy mức lương vùng
    ' -------------------------------------------------

    API -> API ++ : Handle 404 NotFound or 500 error
    deactivate API


    ' -------------------------------------------------
    ' 18 - AdminRegionalMinimumWageController kết thúc tại đây
    ' -------------------------------------------------

    API --> Client : HTTP 404 / 500\nProblemDetails
    deactivate API


    ' -------------------------------------------------
    ' 19 - RegionalMinimumWageApiService kết thúc tại đây
    ' -------------------------------------------------

    Client --> MVC : null
    deactivate Client


    ' -------------------------------------------------
    ' 20 - MVC xử lý lỗi và thiết lập TempData
    ' -------------------------------------------------

    MVC -> MVC ++ : Set TempData["ErrorMessage"]
    deactivate MVC


    ' -------------------------------------------------
    ' 21 - RegionalMinimumWagesController kết thúc tại đây
    ' -------------------------------------------------

    MVC --> UI : RedirectToAction("Index")
    deactivate MVC


    ' -------------------------------------------------
    ' 22 - Wage Details View + Admin kết thúc tại đây
    ' -------------------------------------------------

    UI --> Admin : Display error notification\nand redirect to Wage List

    deactivate UI
    deactivate Admin

end
@enduml
