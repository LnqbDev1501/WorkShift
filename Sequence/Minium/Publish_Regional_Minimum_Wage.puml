@startuml
title Sequence Diagram - Publish Regional Minimum Wage Rate

autonumber

actor Admin
boundary "Wage Details View" as UI
control "RegionalMinimumWagesController" as MVC
control "RegionalMinimumWageApiService" as Client
control "AdminRegionalMinimumWageController" as API
control "RegionalMinimumWageService" as BLL
entity "RegionalMinimumWageRepo" as DAL
database "Database" as DB


' =====================================================
' ADMIN
' =====================================================

activate Admin


' =====================================================
' PUBLISH WAGE REQUEST
' =====================================================

Admin -> MVC : Click Publish Wage (id)
activate MVC

MVC -> MVC ++ : Validate id > 0
deactivate MVC

MVC -> Client : PublishAsync(id)
activate Client


' =====================================================
' INTERNAL PROCESSING - CLIENT
' =====================================================

Client -> Client ++ : Build POST request URL\n(/api/admin/regional-minimum-wages/{id}/publish)
deactivate Client

Client -> API : POST /api/admin/regional-minimum-wages/{id}/publish
activate API

API -> API ++ : Extract callerId from JWT Claims
deactivate API

API -> BLL : PublishAsync(id, callerId)
activate BLL


' =====================================================
' INTERNAL PROCESSING - BLL (STATUS & DATE VALIDATION)
' =====================================================

BLL -> DAL : GetByIdAsync(id)
activate DAL

DAL -> DB : SELECT * FROM regional_minimum_wages WHERE id = id
activate DB

DB --> DAL : Existing wage record (Status = "DRAFT")
deactivate DB

DAL --> BLL : RegionalMinimumWage entity
deactivate DAL

BLL -> BLL ++ : Verify Status == "DRAFT" and\nEffectiveFrom >= VietnamToday
deactivate BLL


' =====================================================
' REPLACEMENT UNIQUENESS VALIDATION
' =====================================================

opt ReplacedWageId is specified

    BLL -> DAL : IsActiveAsync(replacedWageId)
    activate DAL

    DAL -> DB : SELECT * FROM regional_minimum_wages\nWHERE id = replacedWageId AND Status = 'ACTIVE'
    activate DB

    DB --> DAL : true (active)
    deactivate DB

    DAL --> BLL : true
    deactivate DAL

    BLL -> DAL : HasPublishedReplacementAsync(replacedWageId)
    activate DAL

    DAL -> DB : Check if another PUBLISH wage replaces this ID
    activate DB

    DB --> DAL : false (no duplicate replacement)
    deactivate DB

    DAL --> BLL : false
    deactivate DAL

end


' =====================================================
' DATABASE PERSISTENCE (TRANSITION TO PUBLISH)
' =====================================================

BLL -> DAL : UpdateAsync(wage with Status = 'PUBLISH')
activate DAL

DAL -> DB : UPDATE regional_minimum_wages\nSET Status = 'PUBLISH' WHERE id = id
activate DB

DB --> DAL : Updated wage entity
deactivate DB


' =====================================================
' CHECK OPERATION RESULT
' =====================================================

DAL -> DAL ++ : Check published wage record
deactivate DAL


' Tạo khoảng cách giữa các bước query và ALT
||30||


' =====================================================
' RESULT
' =====================================================

alt Processing succeeds

    ' -------------------------------------------------
    ' 21 - RegionalMinimumWageRepo kết thúc tại đây
    ' -------------------------------------------------

    DAL --> BLL : RegionalMinimumWage entity
    deactivate DAL


    ' -------------------------------------------------
    ' 22 - BLL xử lý response
    ' -------------------------------------------------

    BLL -> BLL ++ : Map entity to RegionalMinimumWageDetailResponse
    deactivate BLL


    ' -------------------------------------------------
    ' 23 - RegionalMinimumWageService kết thúc tại đây
    ' -------------------------------------------------

    BLL --> API : RegionalMinimumWageDetailResponse
    deactivate BLL


    ' -------------------------------------------------
    ' 24 - API trả về dữ liệu thành công
    ' -------------------------------------------------

    API --> Client : HTTP 200 OK\nJSON RegionalMinimumWageDetailResponse


    ' -------------------------------------------------
    ' 25 - Client kiểm tra status code
    ' -------------------------------------------------

    Client -> Client ++ : Check IsSuccessStatusCode
    deactivate Client


    ' -------------------------------------------------
    ' 26 - Client trả về kết quả cho MVC Controller
    ' -------------------------------------------------

    Client --> MVC : (Success = true, Data = detail, ErrorMessage = null)


    ' -------------------------------------------------
    ' 27 - MVC xử lý và gán thông báo thành công
    ' -------------------------------------------------

    MVC -> MVC ++ : Assign TempData["SuccessMessage"]
    deactivate MVC


    ' -------------------------------------------------
    ' 28 - Wage Details View bắt đầu activation
    ' -------------------------------------------------

    MVC --> UI : RedirectToAction("Details", new { id })
    activate UI


    ' -------------------------------------------------
    ' 29 - Hiển thị trạng thái PUBLISH lên màn hình Admin
    ' -------------------------------------------------

    UI --> Admin : Display success notification\nand published wage details


else Not DRAFT / Invalid date / Duplicate replacement / Server error

    ' -------------------------------------------------
    ' 30 - Ghi log lỗi tại API Controller
    ' -------------------------------------------------

    API -> API ++ : Log error / Handle 400 BadRequest,\n404 NotFound, or 409 Conflict
    deactivate API


    ' -------------------------------------------------
    ' 31 - AdminRegionalMinimumWageController kết thúc tại đây
    ' -------------------------------------------------

    API --> Client : HTTP 400 / 404 / 409 / 500\nProblemDetails
    deactivate API


    ' -------------------------------------------------
    ' 32 - RegionalMinimumWageApiService kết thúc tại đây
    ' -------------------------------------------------

    Client --> MVC : (Success = false, Data = null, ErrorMessage)
    deactivate Client


    ' -------------------------------------------------
    ' 33 - MVC gán thông báo lỗi vào TempData
    ' -------------------------------------------------

    MVC -> MVC ++ : Assign TempData["ErrorMessage"]
    deactivate MVC


    ' -------------------------------------------------
    ' 34 - RegionalMinimumWagesController kết thúc tại đây
    ' -------------------------------------------------

    MVC --> UI : RedirectToAction("Details", new { id })
    deactivate MVC


    ' -------------------------------------------------
    ' 35 - Wage Details View + Admin kết thúc tại đây
    ' -------------------------------------------------

    UI --> Admin : Display error notification\non Wage Details View

    deactivate UI
    deactivate Admin

end
@enduml
