@startuml
title Sequence Diagram - Update Region

autonumber

actor Admin
boundary "Edit Region View" as UI
control "RegionsController" as MVC
control "RegionApiService" as Client
control "AdminRegionController" as API
control "RegionService" as BLL
entity "RegionRepo" as DAL
database "Database" as DB


' =====================================================
' ADMIN
' =====================================================

activate Admin


' =====================================================
' UPDATE REGION REQUEST
' =====================================================

Admin -> MVC : Submit Edit Region form (id, model)
activate MVC

MVC -> MVC ++ : Validate id == model.RegionId\nand ModelState
deactivate MVC

MVC -> Client : UpdateAsync(id, model)
activate Client


' =====================================================
' INTERNAL PROCESSING - CLIENT
' =====================================================

Client -> Client ++ : Build and serialize\nUpdateRegionRequest JSON payload
deactivate Client

Client -> API : PUT /api/admin/regions/{id} (JSON payload)
activate API

API -> BLL : UpdateAsync(id, request)
activate BLL


' =====================================================
' INTERNAL PROCESSING - BLL (FIELD VALIDATION)
' =====================================================

BLL -> BLL ++ : Validate request fields\n(name <= 150 chars, wageId)
deactivate BLL


' =====================================================
' DATABASE VALIDATION QUERIES
' =====================================================

BLL -> DAL : GetEntityByIdAsync(id)
activate DAL

DAL -> DB : SELECT Region WHERE RegionId = id
activate DB

DB --> DAL : Existing Region entity
deactivate DB

DAL --> BLL : Region entity
deactivate DAL


BLL -> DAL : Verify RegionalMinimumWage exists & ACTIVE
activate DAL

DAL -> DB : SELECT Wage WHERE WageId = id
activate DB

DB --> DAL : Wage record (Status = "ACTIVE")
deactivate DB

DAL --> BLL : Wage active status
deactivate DAL


BLL -> DAL : ExistsByNameExceptIdAsync(name, id)
activate DAL

DAL -> DB : Check if RegionName exists for other region\n(ILIKE RegionName AND RegionId != id)
activate DB

DB --> DAL : false (name not duplicated)
deactivate DB

DAL --> BLL : false
deactivate DAL


' =====================================================
' DATABASE PERSISTENCE
' =====================================================

BLL -> DAL : UpdateAsync(region)
activate DAL

DAL -> DB : UPDATE Regions\nand SaveChangesAsync
activate DB

DB --> DAL : Updated region rows affected
deactivate DB

DAL -> DB : Query updated Region detail data
activate DB

DB --> DAL : Updated RegionDetailData
deactivate DB


' =====================================================
' CHECK UPDATED DATA
' =====================================================

DAL -> DAL ++ : Check updated region data
deactivate DAL


' Tạo khoảng cách giữa các bước query và ALT
||30||


' =====================================================
' RESULT
' =====================================================

alt Processing succeeds

    ' -------------------------------------------------
    ' 26 - RegionRepo kết thúc tại đây
    ' -------------------------------------------------

    DAL --> BLL : RegionDetailData
    deactivate DAL


    ' -------------------------------------------------
    ' 27 - BLL xử lý response
    ' -------------------------------------------------

    BLL -> BLL ++ : Map data to RegionResponse
    deactivate BLL


    ' -------------------------------------------------
    ' 28 - RegionService kết thúc tại đây
    ' -------------------------------------------------

    BLL --> API : RegionResponse
    deactivate BLL


    ' -------------------------------------------------
    ' 29 - API trả về dữ liệu cập nhật thành công
    ' -------------------------------------------------

    API --> Client : HTTP 200 OK\nJSON RegionResponse


    ' -------------------------------------------------
    ' 30 - Client kiểm tra status code
    ' -------------------------------------------------

    Client -> Client ++ : Check IsSuccessStatusCode
    deactivate Client


    ' -------------------------------------------------
    ' 31 - Client trả về kết quả cho MVC Controller
    ' -------------------------------------------------

    Client --> MVC : (Success = true, ErrorMessage = null)


    ' -------------------------------------------------
    ' 32 - MVC xử lý và gán thông báo thành công
    ' -------------------------------------------------

    MVC -> MVC ++ : Assign TempData["SuccessMessage"]
    deactivate MVC


    ' -------------------------------------------------
    ' 33 - Region List View bắt đầu activation
    ' -------------------------------------------------

    MVC --> UI : RedirectToAction("Index")
    activate UI


    ' -------------------------------------------------
    ' 34 - Chuyển hướng và hiển thị thông báo thành công
    ' -------------------------------------------------

    UI --> Admin : Display success notification\nand redirect to Region List


else Validation fails / Not Found / Conflict / Error

    ' -------------------------------------------------
    ' 35 - Ghi log lỗi tại API Controller
    ' -------------------------------------------------

    API -> API ++ : Log error / Handle 400 BadRequest,\n404 NotFound, or 409 Conflict (Duplicate Name)
    deactivate API


    ' -------------------------------------------------
    ' 36 - AdminRegionController kết thúc tại đây
    ' -------------------------------------------------

    API --> Client : HTTP 400 / 404 / 409 / 500\nProblemDetails
    deactivate API


    ' -------------------------------------------------
    ' 37 - RegionApiService kết thúc tại đây
    ' -------------------------------------------------

    Client --> MVC : (Success = false, ErrorMessage)
    deactivate Client


    ' -------------------------------------------------
    ' 38 - MVC xử lý lỗi và tải lại danh sách lương vùng
    ' -------------------------------------------------

    MVC -> MVC ++ : Add ModelState error\nand reload MinimumWages
    deactivate MVC


    ' -------------------------------------------------
    ' 39 - RegionsController kết thúc tại đây
    ' -------------------------------------------------

    MVC --> UI : View(model)
    deactivate MVC


    ' -------------------------------------------------
    ' 40 - Edit Region View + Admin kết thúc tại đây
    ' -------------------------------------------------

    UI --> Admin : Display error messages\non Edit Region form

    deactivate UI
    deactivate Admin

end
@enduml
