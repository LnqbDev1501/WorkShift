@using UI_Admin.Models.Admin.AttendancePenaltyRule
@model AttendancePenaltyRuleListViewModel
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

@{
    ViewData["Title"] = "Attendance Penalty Rules";
}

@section Styles {
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet" />
<style>
    .rules-page { min-height: 100vh; padding: 16px 28px 36px; color: #20233a; background: #f6f7fb; font-family: Arial, Helvetica, sans-serif; font-style: normal; }
    .rules-body { max-width: 1440px; margin: auto; padding-top: 0; }
    .page-heading { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; margin-bottom: 16px; }
    .eyebrow { display: flex; align-items: center; gap: 9px; margin-bottom: 5px; color: #50577a; font-size: 13px; letter-spacing: .08em; text-transform: uppercase; }
    .eyebrow i { width: 8px; height: 8px; background: #4f46e5; border-radius: 50%; }
    .page-heading h1 { margin: 0; color: #191c2a; font-size: 22px; font-weight: 600; }
    .page-heading p { margin: 4px 0 0; color: #5b6074; font-size: 14px; }
    .heading-actions { display: flex; gap: 12px; }
    .ui-button { display: inline-flex; align-items: center; justify-content: center; gap: 9px; height: 41px; padding: 0 18px; border: 0; border-radius: 9px; font: 500 14px Arial, Helvetica, sans-serif; text-decoration: none; cursor: pointer; box-shadow: 0 2px 5px #1b1f360d; }
    .ui-button.light { color: #25293b; background: #fff; }
    .ui-button.primary { color: #fff; background: #5146e5; box-shadow: 0 3px 7px #4f46e540; }
    .filter-card { margin-bottom: 18px; padding: 16px; background: #fff; border-radius: 9px; box-shadow: 0 1px 3px #191c2d12; }
    .filters { display: grid; grid-template-columns: 3fr 2fr auto; gap: 12px; }
    .search-box { position: relative; }
    .search-box .search-icon { position: absolute; top: 50%; left: 14px; transform: translateY(-50%); color: #64748b; font-size: 20px; pointer-events: none; }
    .filter-control { width: 100%; height: 41px; padding: 0 13px; color: #1f2336; background: #f0f1f6; border: 0; border-radius: 7px; outline: none; font: 400 14px Arial, Helvetica, sans-serif; }
    .search-box input { padding-left: 41px; }
    .clear { min-width: 102px; color: #42475a !important; background: #f0f1f6; box-shadow: none; text-decoration: none !important; transition: background .15s, color .15s; }
    .clear:hover { color: #3028b8 !important; background: #e5e7f0; text-decoration: none !important; }
    .table-card { overflow: hidden; background: #fff; border-radius: 9px; box-shadow: 0 1px 3px #191c2d14; }
    .rules-table { width: 100%; border-collapse: collapse; table-layout: fixed; }
    .rules-table th { height: 38px; padding: 0 16px; color: #4a516f; background: #f0f1f6; font-size: 13px; font-weight: 600; text-align: left; text-transform: uppercase; }
    .rules-table td { height: 72px; padding: 10px 16px; color: #171a27; border-top: 1px solid #f3f3f6; font-size: 14px; font-style: normal; vertical-align: middle; }
    .rules-table th:nth-child(1) { width: 32%; }
    .rules-table th:nth-child(2) { width: 16%; }
    .rules-table th:nth-child(3) { width: 16%; }
    .rules-table th:nth-child(4) { width: 14%; }
    .rules-table th:nth-child(5) { width: 12%; }
    .rules-table th:nth-child(6) { width: 10%; }
    .rule-cell { display: flex; align-items: center; gap: 12px; }
    .rule-icon-box { display: grid; flex: 0 0 36px; width: 36px; height: 36px; place-items: center; color: #4f46e5; background: #eef2ff; border-radius: 11px; font-size: 18px; }
    .rule-icon-box.active { color: #059669; background: #ecfdf5; }
    .rule-icon-box.scheduled { color: #7c3aed; background: #f5f3ff; }
    .rule-icon-box.draft { color: #d97706; background: #fffbeb; }
    .rule-name { display: flex; align-items: center; gap: 7px; font-weight: 600; color: #111827; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .pill { display: inline-flex; align-items: center; gap: 5px; padding: 4px 9px; border-radius: 12px; font-size: 12px; font-weight: 500; white-space: nowrap; }
    .status.active { color: #065f46; background: #d1fae5; }
    .status.scheduled { color: #5b21b6; background: #ede9fe; }
    .status.draft { color: #92400e; background: #fef3c7; }
    .status.cancelled { color: #596071; background: #e8e9ed; }
    .dot { width: 6px; height: 6px; background: #4f46e5; border-radius: 50%; }
    .status.active .dot { background: #10b981; }
    .status.scheduled .dot { background: #8b5cf6; }
    .status.draft .dot { background: #f59e0b; }
    .status.cancelled .dot { background: #89909d; }
    .actions { display: flex; align-items: center; gap: 6px; white-space: nowrap; }
    .icon-button { display: grid; width: 32px; height: 32px; padding: 0; place-items: center; color: #4338ca; background: transparent; border: 0; border-radius: 7px; cursor: pointer; transition: background .15s; }
    .icon-button:hover { background: #eef0ff; }
    .icon-button.success { color: #059669; }
    .icon-button.success:hover { background: #ecfdf5; }
    .icon-button.danger { color: #e11d48; }
    .icon-button.danger:hover { background: #ffe4e6; }
    .list-pagination { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px; min-height: 56px; padding: 12px 20px; background: #fff; color: #475569; font-size: 13px; font-weight: 500; border-top: 1px solid #f1f5f9; }
    .list-pagination small { font-size: 11px; color: #94a3b8; }
    .list-pagination-pages { display: flex; align-items: center; gap: 6px; }
    .list-page-number { display: inline-flex; align-items: center; justify-content: center; width: 32px; height: 32px; border-radius: 8px; background: #f8fafc; color: #475569; text-decoration: none; font-size: 13px; font-weight: 600; border: 1px solid #e2e8f0; transition: all 0.15s; }
    a.list-page-number:hover { background: #eef2ff; color: #4f46e5; border-color: #c7d2fe; }
    .list-page-number.active { background: #4f46e5; color: #ffffff; border-color: #4f46e5; }
    .list-page-number.disabled { opacity: 0.4; cursor: not-allowed; }
</style>
}

<div class="rules-page">
    <div class="rules-body">

        <!-- Toast/Modal Popup Notifications -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div id="statusResultModal" class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/40 backdrop-blur-xs p-4">
                <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-2xl border border-slate-200 animate-fadeIn">
                    <div class="text-center space-y-3">
                        <div class="w-14 h-14 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center mx-auto border border-emerald-100">
                            <span class="material-symbols-outlined text-[32px]">check_circle</span>
                        </div>
                        <h3 class="text-lg font-bold text-slate-900">Success</h3>
                        <p class="text-sm text-slate-600 leading-relaxed font-medium">
                            @TempData["SuccessMessage"]
                        </p>
                    </div>
                    <div class="flex items-center justify-center mt-6">
                        <button type="button" class="px-6 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-sm transition-all shadow-sm cursor-pointer" onclick="document.getElementById('statusResultModal').remove()">
                            OK
                        </button>
                    </div>
                </div>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div id="statusResultModal" class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/40 backdrop-blur-xs p-4">
                <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-2xl border border-slate-200 animate-fadeIn">
                    <div class="text-center space-y-3">
                        <div class="w-14 h-14 rounded-2xl bg-rose-50 text-rose-600 flex items-center justify-center mx-auto border border-rose-100">
                            <span class="material-symbols-outlined text-[32px]">error</span>
                        </div>
                        <h3 class="text-lg font-bold text-slate-900">Error Notification</h3>
                        <p class="text-sm text-rose-700 leading-relaxed font-medium">
                            @TempData["ErrorMessage"]
                        </p>
                    </div>
                    <div class="flex items-center justify-center mt-6">
                        <button type="button" class="px-6 py-2.5 rounded-xl bg-rose-600 hover:bg-rose-700 text-white font-semibold text-sm transition-all shadow-sm cursor-pointer" onclick="document.getElementById('statusResultModal').remove()">
                            Close
                        </button>
                    </div>
                </div>
            </div>
        }

        <!-- Page Header -->
        <div class="page-heading">
            <div>
                <div class="eyebrow">
                    <i></i> ATTENDANCE PENALTY RULES MANAGEMENT
                </div>
                <h1>Attendance Penalty Rules</h1>
                <p>Configure progressive monetary penalty tiers for employee late check-ins and early departures.</p>
            </div>
            <div class="heading-actions">
                <a asp-action="Create" class="ui-button primary">
                    <span class="material-symbols-outlined text-[20px]">add</span>
                    Create New Rule
                </a>
            </div>
        </div>

        <!-- Metrics Cards -->
        <partial name="_ListMetrics" model='@(new ListMetricViewModel[] {
            new("Total rules", Model.TotalRules.ToString("N0"), "All configured policies", "policy", "#8b5cf6"),
            new("Active", Model.ActiveRules.ToString("N0"), "Currently in effect", "verified", "#10b981"),
            new("Scheduled", Model.ScheduledRules.ToString("N0"), "Pending effective date", "schedule", "#4f46e5"),
            new("Drafts", Model.DraftRules.ToString("N0"), "Unpublished policies", "edit_document", "#f59e0b")
        })' />

        <!-- Filters -->
        <form method="get" asp-action="List" class="ws-list-filter" role="search">
            <div class="ws-filter-row">
                <label class="ws-filter-field ws-filter-keyword"><span class="material-symbols-outlined" aria-hidden="true">search</span><input aria-label="Search rules" type="text" name="searchTerm" value="@Model.SearchTerm" placeholder="Search by rule name..." /></label>
                <div class="ws-filter-field"><select aria-label="Status" name="status">
                                <option value="">All Statuses</option>
                                <option value="ACTIVE" selected="@(string.Equals(Model.Status, "ACTIVE", StringComparison.OrdinalIgnoreCase))">Active</option>
                                <option value="SCHEDULED" selected="@(string.Equals(Model.Status, "SCHEDULED", StringComparison.OrdinalIgnoreCase))">Scheduled</option>
                                <option value="DRAFT" selected="@(string.Equals(Model.Status, "DRAFT", StringComparison.OrdinalIgnoreCase))">Draft</option>
                                <option value="CANCELLED" selected="@(string.Equals(Model.Status, "CANCELLED", StringComparison.OrdinalIgnoreCase))">Cancelled</option>
                            </select></div>
                <partial name="_ListFilterActions" model='"List"' />
            </div>
        </form>

        <!-- Rules Table -->
        <div class="table-card">
            <table class="rules-table">
                <thead>
                    <tr>
                        <th>Rule Name</th>
                        <th>Effective From</th>
                        <th>Effective To</th>
                        <th>Created Date</th>
                        <th>Status</th>
                        <th class="text-right">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="text-center py-12 text-slate-400">
                                No attendance penalty rules found.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var rule in Model.Items)
                        {
                            var statusClass = rule.Status.ToLower();
                            <tr>
                                <td>
                                    <div class="rule-cell">
                                        <div class="rule-icon-box @statusClass">
                                            <span class="material-symbols-outlined text-[20px]">gavel</span>
                                        </div>
                                        <div class="min-w-0">
                                            <span class="rule-name">@rule.RuleName</span>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="text-sm font-semibold text-slate-900">
                                        @(rule.EffectiveFrom?.ToString("yyyy-MM-dd") ?? "—")
                                    </div>
                                </td>
                                <td>
                                    <div class="text-sm text-slate-600">
                                        @(rule.EffectiveTo.HasValue ? rule.EffectiveTo.Value.ToString("yyyy-MM-dd") : "Indefinite")
                                    </div>
                                </td>
                                <td>
                                    <div class="text-sm text-slate-600">
                                        @rule.CreatedAt.ToString("yyyy-MM-dd")
                                    </div>
                                </td>
                                <td>
                                    <span class="pill status @statusClass">
                                        <span class="dot"></span>
                                        @rule.Status
                                    </span>
                                </td>
                                <td>
                                    <div class="actions justify-end">
                                        <!-- Detail Button -->
                                        <a asp-action="Detail" asp-route-id="@rule.PenaltyRuleId" class="ws-icon-action icon-button" title="View Details" aria-label="View Details">
                                            <span class="material-symbols-outlined text-[20px]">visibility</span>
                                        </a>

                                        <!-- Edit Button (if Draft) -->
                                        @if (string.Equals(rule.Status, "Draft", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <a asp-action="Edit" asp-route-id="@rule.PenaltyRuleId" class="ws-icon-action icon-button !text-amber-600 hover:!bg-amber-50" title="Edit Rule" aria-label="Edit Rule">
                                                <span class="material-symbols-outlined text-[20px]">edit</span>
                                            </a>
                                        }

                                        <!-- Publish Button (if Draft) -->
                                        @if (string.Equals(rule.Status, "Draft", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <button type="button" class="ws-icon-action icon-button success" title="Publish Rule" onclick="openPublishModal(@rule.PenaltyRuleId, '@rule.RuleName')" aria-label="Publish Rule">
                                                <span class="material-symbols-outlined text-[20px]">publish</span>
                                            </button>
                                        }

                                        <!-- Cancel Button (Only if Draft or Scheduled) -->
                                        @if (string.Equals(rule.Status, "Draft", StringComparison.OrdinalIgnoreCase) || string.Equals(rule.Status, "Scheduled", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <button type="button" class="ws-icon-action icon-button danger" title="Cancel Rule" onclick="openCancelModal(@rule.PenaltyRuleId, '@rule.RuleName', '@rule.Status')" aria-label="Cancel Rule">
                                                <span class="material-symbols-outlined text-[20px]">cancel</span>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>

            <!-- Pagination -->
            <partial name="_ListPagination" model="@(new ListPaginationViewModel
            {
                PageNumber = Model.PageNumber,
                PageSize = Model.PageSize,
                TotalItems = Model.TotalItems,
                ItemLabel = "rules",
                PageParameter = "pageNumber"
            })" />
        </div>

    </div>
</div>

<!-- Modal Publish Confirmation -->
<div id="publishModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-slate-900/40 backdrop-blur-xs p-4">
    <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-2xl border border-slate-200 animate-fadeIn">
        <form asp-action="Publish" method="post" id="publishForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="publishRuleId" />
            <input type="hidden" name="source" value="list" />
            <div class="text-center space-y-3">
                <div class="w-12 h-12 rounded-2xl bg-indigo-50 text-indigo-600 flex items-center justify-center mx-auto">
                    <span class="material-symbols-outlined text-[28px]">publish</span>
                </div>
                <h3 class="text-lg font-bold text-slate-900">Publish Penalty Rule</h3>
                <p class="text-sm text-slate-500">
                    Are you sure you want to publish the penalty rule <strong id="publishRuleName" class="text-slate-800"></strong>? The rule will automatically take effect on its scheduled effective date.
                </p>
            </div>
            <div class="flex items-center justify-end gap-3 mt-6">
                <button type="button" class="px-4 py-2 rounded-xl text-slate-600 bg-slate-100 hover:bg-slate-200 font-semibold text-sm transition-all" onclick="closePublishModal()">
                    Close
                </button>
                <button type="submit" class="px-5 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-sm transition-all shadow-sm">
                    Confirm Publish
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Cancel Confirmation -->
<div id="cancelModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-slate-900/40 backdrop-blur-xs p-4">
    <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-2xl border border-slate-200 animate-fadeIn">
        <form asp-action="Cancel" method="post" id="cancelForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="cancelRuleId" />
            <input type="hidden" name="source" value="list" />
            <div class="text-center space-y-3">
                <div class="w-12 h-12 rounded-2xl bg-rose-50 text-rose-600 flex items-center justify-center mx-auto">
                    <span class="material-symbols-outlined text-[28px]">cancel</span>
                </div>
                <h3 class="text-lg font-bold text-slate-900">Cancel Penalty Rule</h3>
                <p class="text-sm text-slate-500">
                    Are you sure you want to cancel the rule <strong id="cancelRuleName" class="text-slate-800"></strong>? This action cannot be undone.
                </p>
                <div id="cancelReasonContainer" class="text-left mt-3">
                    <label class="block text-xs font-semibold text-slate-700 uppercase mb-1">Cancellation Reason (Optional):</label>
                    <textarea name="cancellationReason" rows="2" class="w-full p-2.5 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:outline-none focus:ring-2 focus:ring-rose-500/20 focus:border-rose-500 transition-all placeholder:text-slate-400" placeholder="Enter cancellation reason..."></textarea>
                </div>
            </div>
            <div class="flex items-center justify-end gap-3 mt-6">
                <button type="button" class="px-4 py-2 rounded-xl text-slate-600 bg-slate-100 hover:bg-slate-200 font-semibold text-sm transition-all" onclick="closeCancelModal()">
                    Close
                </button>
                <button type="submit" class="px-5 py-2 rounded-xl bg-rose-600 hover:bg-rose-700 text-white font-semibold text-sm transition-all shadow-sm">
                    Confirm Cancellation
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
<script>
    function openPublishModal(id, name) {
        document.getElementById('publishRuleId').value = id;
        document.getElementById('publishRuleName').innerText = name;
        document.getElementById('publishModal').classList.remove('hidden');
    }
    function closePublishModal() {
        document.getElementById('publishModal').classList.add('hidden');
    }

    function openCancelModal(id, name, status) {
        document.getElementById('cancelRuleId').value = id;
        document.getElementById('cancelRuleName').innerText = name;

        // Hide cancellation reason input for Draft status
        const isDraft = status && status.toUpperCase() === 'DRAFT';
        const reasonBox = document.getElementById('cancelReasonContainer');
        if (isDraft) {
            reasonBox.classList.add('hidden');
        } else {
            reasonBox.classList.remove('hidden');
        }

        document.getElementById('cancelModal').classList.remove('hidden');
    }
    function closeCancelModal() {
        document.getElementById('cancelModal').classList.add('hidden');
    }

    async function reloadPenaltyRuleTableData() {
        try {
            const response = await fetch(window.location.href, {
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                cache: 'no-store'
            });
            if (!response.ok) return;

            const html = await response.text();
            const parser = new DOMParser();
            const doc = parser.parseFromString(html, 'text/html');

            const newMetrics = doc.querySelector('.list-metrics');
            const currentMetrics = document.querySelector('.list-metrics');
            if (newMetrics && currentMetrics) {
                currentMetrics.innerHTML = newMetrics.innerHTML;
            }

            const newTableCard = doc.querySelector('.table-card');
            const currentTableCard = document.querySelector('.table-card');
            if (newTableCard && currentTableCard) {
                currentTableCard.innerHTML = newTableCard.innerHTML;
            }
        } catch (err) {
            console.warn('[SignalR] Failed to reload penalty rule table:', err);
        }
    }

    // Realtime Admin Data Sync via SignalR
    (function () {
        const apiBaseUrl = '@(Configuration["WorkShiftApi:BaseUrl"]?.TrimEnd('/') ?? "https://localhost:7193")';
        const connection = new signalR.HubConnectionBuilder()
            .withUrl(`${apiBaseUrl}/hubs/admin-realtime`, {
                skipNegotiation: false,
                transport: signalR.HttpTransportType.WebSockets | signalR.HttpTransportType.LongPolling
            })
            .withAutomaticReconnect([0, 2000, 5000, 10000])
            .build();

        connection.on("AttendancePenaltyRuleChanged", function (payload) {
            console.log("[SignalR] Attendance penalty rule changed:", payload);
            reloadPenaltyRuleTableData();
        });

        connection.start()
            .then(function () {
                console.log("[SignalR] Connected to AdminRealtimeHub for Attendance Penalty Rules");
                return connection.invoke("JoinAdminGroup");
            })
            .catch(function (err) {
                console.warn("[SignalR] Connection error on AdminRealtimeHub:", err);
            });
    })();
</script>
}
