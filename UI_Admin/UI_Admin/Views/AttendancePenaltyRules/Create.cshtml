@using UI_Admin.Models.Admin.AttendancePenaltyRule
@model CreateAttendancePenaltyRuleViewModel

@{
    ViewData["Title"] = "Create Attendance Penalty Rule";
    var minDate = DateTime.UtcNow.AddHours(7).AddDays(1).ToString("yyyy-MM-dd");
}

@section Styles {
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet" />
<style>
    .field-validation-error {
        color: #dc2626;
        font-size: 12px;
        font-weight: 500;
        display: block;
        margin-top: 4px;
    }
    .input-validation-error {
        border-color: #dc2626 !important;
        background-color: #fff8f8 !important;
    }
    .table-input {
        width: 100%;
        padding: 8px 12px;
        font-size: 14px;
        font-weight: 600;
        color: #1e293b;
        background-color: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        transition: all 0.15s ease;
        outline: none;
    }
    .table-input:focus {
        background-color: #ffffff;
        border-color: #6366f1;
        box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.15);
    }
    .btn-delete-row {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 6px 12px;
        font-size: 13px;
        font-weight: 600;
        color: #e11d48;
        background: #fff1f2;
        border: 1px solid #ffe4e6;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.15s;
    }
    .btn-delete-row:hover {
        background: #ffe4e6;
        color: #be123c;
    }
    .btn-add-row {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 8px 16px;
        font-size: 13px;
        font-weight: 600;
        color: #4f46e5;
        background: #eef2ff;
        border: 1px dashed #c7d2fe;
        border-radius: 10px;
        cursor: pointer;
        transition: all 0.15s;
    }
    .btn-add-row:hover {
        background: #e0e7ff;
        border-color: #818cf8;
    }
</style>
}

<div class="w-full px-7 pt-6 pb-12 bg-[#F6F7FB] min-h-screen">
    <div class="w-full max-w-[1440px] mx-auto space-y-6">

        <!-- Client-side Validation Banner Container -->
        <div id="clientErrorContainer" class="space-y-3"></div>

        <!-- Validation Error Banner -->
        @if (!ViewData.ModelState.IsValid && ViewData.ModelState.TryGetValue(string.Empty, out var modelStateErrors) && modelStateErrors.Errors.Count > 0)
        {
            <div id="createErrorBanner" class="p-4 bg-rose-50 border border-rose-200 rounded-xl flex items-start justify-between gap-3 text-rose-800 shadow-sm">
                <div class="flex items-start gap-2.5 min-w-0">
                    <span class="material-symbols-outlined text-[20px] shrink-0 mt-0.5 text-rose-600">error</span>
                    <div class="text-sm space-y-1 leading-relaxed">
                        @foreach (var error in modelStateErrors.Errors)
                        {
                            <div>@error.ErrorMessage</div>
                        }
                    </div>
                </div>
                <button type="button" class="p-1 rounded-lg hover:bg-rose-200/50 text-rose-700 transition-colors cursor-pointer shrink-0" title="Close" onclick="document.getElementById('createErrorBanner').remove()">
                    <span class="material-symbols-outlined text-[18px]">close</span>
                </button>
            </div>
        }

        <!-- Main Form Card -->
        <form asp-action="Create" method="post" id="createPenaltyRuleForm" class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden divide-y divide-slate-100">
            @Html.AntiForgeryToken()

            <!-- 1. Header Section -->
            <div class="p-7 flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-slate-50/50">
                <div class="flex items-center gap-4">
                    <div class="w-14 h-14 rounded-2xl bg-indigo-50 border border-indigo-100 text-indigo-600 flex items-center justify-center shadow-xs shrink-0">
                        <span class="material-symbols-outlined text-[32px]">gavel</span>
                    </div>
                    <div>
                        <h1 class="text-xl font-bold text-slate-900">CREATE ATTENDANCE PENALTY RULE</h1>
                        <p class="text-sm text-slate-500 mt-1">Configure penalty fee tiers for late check-in and early departure minutes.</p>
                    </div>
                </div>
                <div class="self-start sm:self-center">
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-amber-50 text-amber-700 text-xs font-semibold border border-amber-200">
                        <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
                        Status: Draft
                    </span>
                </div>
            </div>

            <!-- 2. General Information -->
            <div class="p-7 space-y-5">
                <div class="flex items-center gap-2 pb-2 border-b border-slate-100">
                    <span class="material-symbols-outlined text-indigo-600 text-[20px]">info</span>
                    <h2 class="text-base font-semibold text-slate-800">General Information</h2>
                </div>

                <div class="space-y-4 max-w-3xl">
                    <!-- Rule Name -->
                    <div>
                        <label asp-for="RuleName" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">
                            Rule Name <span class="text-rose-500">*</span>
                        </label>
                        <input asp-for="RuleName" class="w-full px-3.5 py-2.5 text-sm bg-slate-50/60 border border-slate-200 rounded-xl focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-600 transition-all font-semibold text-slate-900 placeholder:text-slate-400 placeholder:font-normal" placeholder="e.g. Standard Attendance Penalty 2026..." required />
                        <span asp-validation-for="RuleName"></span>
                    </div>

                    <!-- Description -->
                    <div>
                        <label asp-for="Description" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">
                            Description
                        </label>
                        <textarea asp-for="Description" rows="3" class="w-full px-3.5 py-2.5 text-sm bg-slate-50/60 border border-slate-200 rounded-xl focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-600 transition-all text-slate-800 placeholder:text-slate-400" placeholder="Enter rule description and scope (optional)..."></textarea>
                        <span asp-validation-for="Description"></span>
                    </div>

                    <!-- Effective From Date -->
                    <div class="max-w-md">
                        <div class="flex items-center justify-between mb-1.5">
                            <label asp-for="EffectiveFrom" class="text-xs font-semibold text-slate-700 uppercase tracking-wider">
                                Effective From <span class="text-rose-500">*</span>
                            </label>
                            <span class="text-[11px] font-medium text-indigo-600 bg-indigo-50 px-2 py-0.5 rounded-md border border-indigo-100">Must be future date</span>
                        </div>
                        <input asp-for="EffectiveFrom" type="date" min="@minDate" class="w-full px-3.5 py-2.5 text-sm bg-slate-50/60 border border-slate-200 rounded-xl focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-600 transition-all font-semibold text-slate-900 cursor-pointer" required />
                        <span asp-validation-for="EffectiveFrom"></span>
                    </div>
                </div>
            </div>

            <!-- 3. Late Violation Levels -->
            <div class="p-7 space-y-4">
                <div class="flex items-center justify-between pb-2 border-b border-slate-100">
                    <div class="flex items-center gap-2">
                        <span class="material-symbols-outlined text-amber-600 text-[20px]">alarm_on</span>
                        <h2 class="text-base font-semibold text-slate-800">Late Violation Penalties (LATE)</h2>
                    </div>
                    <button type="button" class="btn-add-row" onclick="addLateRow()">
                        <span class="material-symbols-outlined text-[18px]">add</span>
                        Add Late Penalty Tier
                    </button>
                </div>

                <div class="overflow-x-auto rounded-xl border border-slate-200 bg-white">
                    <table class="w-full border-collapse text-left text-sm" id="tableLateLevels">
                        <thead>
                            <tr class="bg-slate-50/80 border-b border-slate-200 text-xs font-semibold uppercase tracking-wider text-slate-600">
                                <th class="py-3 px-4 w-[25%]">From (mins) <span class="text-rose-500">*</span></th>
                                <th class="py-3 px-4 w-[25%]">To (mins) <span class="text-slate-400 font-normal">(Leave empty for &infin;)</span></th>
                                <th class="py-3 px-4 w-[35%]">Penalty Amount (VNĐ) <span class="text-rose-500">*</span></th>
                                <th class="py-3 px-4 w-[15%] text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody id="tbodyLate" class="divide-y divide-slate-100">
                            <!-- Rows will be injected by JavaScript -->
                        </tbody>
                    </table>
                </div>
                <p class="text-xs text-slate-500 pt-1">Minute ranges must be continuous without gaps. The final tier can end at 480 mins or be left blank for open-ended coverage.</p>
            </div>

            <!-- 4. Early Leave Violation Levels -->
            <div class="p-7 space-y-4">
                <div class="flex items-center justify-between pb-2 border-b border-slate-100">
                    <div class="flex items-center gap-2">
                        <span class="material-symbols-outlined text-rose-600 text-[20px]">timer_off</span>
                        <h2 class="text-base font-semibold text-slate-800">Early Leave Penalties (EARLY_LEAVE)</h2>
                    </div>
                    <button type="button" class="btn-add-row" onclick="addEarlyRow()">
                        <span class="material-symbols-outlined text-[18px]">add</span>
                        Add Early Leave Penalty Tier
                    </button>
                </div>

                <div class="overflow-x-auto rounded-xl border border-slate-200 bg-white">
                    <table class="w-full border-collapse text-left text-sm" id="tableEarlyLevels">
                        <thead>
                            <tr class="bg-slate-50/80 border-b border-slate-200 text-xs font-semibold uppercase tracking-wider text-slate-600">
                                <th class="py-3 px-4 w-[25%]">From (mins) <span class="text-rose-500">*</span></th>
                                <th class="py-3 px-4 w-[25%]">To (mins) <span class="text-slate-400 font-normal">(Leave empty for &infin;)</span></th>
                                <th class="py-3 px-4 w-[35%]">Penalty Amount (VNĐ) <span class="text-rose-500">*</span></th>
                                <th class="py-3 px-4 w-[15%] text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody id="tbodyEarly" class="divide-y divide-slate-100">
                            <!-- Rows will be injected by JavaScript -->
                        </tbody>
                    </table>
                </div>
                <p class="text-xs text-slate-500 pt-1">Minute ranges must be continuous without gaps. The final tier can end at 480 mins or be left blank for open-ended coverage.</p>
            </div>

            <!-- 5. Footer Actions -->
            <div class="p-6 bg-slate-50/80 flex items-center justify-end gap-3.5">
                <a asp-action="List" class="px-5 py-2.5 rounded-xl border border-slate-200 text-slate-600 bg-white hover:bg-slate-100 font-semibold text-sm transition-all shadow-2xs">
                    Cancel
                </a>
                <button type="submit" class="px-6 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-sm transition-all shadow-sm hover:shadow-indigo-500/25 flex items-center gap-2">
                    <span class="material-symbols-outlined text-[18px]">save</span>
                    Save Draft
                </button>
            </div>
        </form>

    </div>
</div>

@section Scripts {
<partial name="_ValidationScriptsPartial" />
<script>
    // Initial data: default tiers with open-ended final tier
    let lateLevels = [
        { fromMinutes: 1, toMinutes: 15, penaltyAmount: 20000 },
        { fromMinutes: 16, toMinutes: null, penaltyAmount: 50000 }
    ];

    let earlyLevels = [
        { fromMinutes: 1, toMinutes: 15, penaltyAmount: 20000 },
        { fromMinutes: 16, toMinutes: null, penaltyAmount: 50000 }
    ];

    function recomputeTiers(levels) {
        if (!levels || levels.length === 0) return;
        levels[0].fromMinutes = 1;
        for (let i = 1; i < levels.length; i++) {
            const prevTo = levels[i - 1].toMinutes;
            levels[i].fromMinutes = (prevTo !== null && prevTo !== undefined && prevTo !== '') ? (parseInt(prevTo, 10) + 1) : (levels[i - 1].fromMinutes + 1);
        }
    }

    function renderLateTable() {
        const tbody = document.getElementById('tbodyLate');
        tbody.innerHTML = '';
        if (lateLevels.length === 0) {
            tbody.innerHTML = `<tr><td colspan="4" class="py-6 text-center text-slate-400 text-xs">No late penalty tiers configured. Click [+ Add Late Penalty Tier] to create one.</td></tr>`;
            return;
        }

        recomputeTiers(lateLevels);

        lateLevels.forEach((level, index) => {
            const isLast = index === lateLevels.length - 1;
            const tr = document.createElement('tr');
            tr.className = 'hover:bg-slate-50/50 transition-colors';
            tr.innerHTML = `
                <td class="py-3 px-4">
                    <input type="number" min="1" max="480" class="table-input bg-slate-100 text-slate-700 font-semibold cursor-not-allowed select-none" value="${level.fromMinutes}" readonly tabindex="-1" title="Auto-calculated from previous tier + 1" />
                </td>
                <td class="py-3 px-4">
                    <input type="number" min="${level.fromMinutes}" max="480" class="table-input" value="${level.toMinutes ?? ''}" onchange="updateLateTo(${index}, this.value)" placeholder="${isLast ? '∞ (Leave blank for onwards)' : 'Enter minutes (max 480)'}" />
                </td>
                <td class="py-3 px-4">
                    <div class="relative">
                        <input type="number" min="1000" step="1000" class="table-input pr-12 font-medium" value="${level.penaltyAmount ?? ''}" onchange="updateLateAmount(${index}, this.value)" required placeholder="20000" />
                        <span class="absolute right-3 top-1/2 -translate-y-1/2 text-xs font-semibold text-slate-400">VNĐ</span>
                    </div>
                </td>
                <td class="py-3 px-4 text-center">
                    <button type="button" class="btn-delete-row" onclick="deleteLateRow(${index})">
                        <span class="material-symbols-outlined text-[16px]">delete</span>
                        Delete
                    </button>
                </td>
            `;
            tbody.appendChild(tr);
        });
        updateHiddenInputs();
    }

    function renderEarlyTable() {
        const tbody = document.getElementById('tbodyEarly');
        tbody.innerHTML = '';
        if (earlyLevels.length === 0) {
            tbody.innerHTML = `<tr><td colspan="4" class="py-6 text-center text-slate-400 text-xs">No early leave penalty tiers configured. Click [+ Add Early Leave Penalty Tier] to create one.</td></tr>`;
            return;
        }

        recomputeTiers(earlyLevels);

        earlyLevels.forEach((level, index) => {
            const isLast = index === earlyLevels.length - 1;
            const tr = document.createElement('tr');
            tr.className = 'hover:bg-slate-50/50 transition-colors';
            tr.innerHTML = `
                <td class="py-3 px-4">
                    <input type="number" min="1" max="480" class="table-input bg-slate-100 text-slate-700 font-semibold cursor-not-allowed select-none" value="${level.fromMinutes}" readonly tabindex="-1" title="Auto-calculated from previous tier + 1" />
                </td>
                <td class="py-3 px-4">
                    <input type="number" min="${level.fromMinutes}" max="480" class="table-input" value="${level.toMinutes ?? ''}" onchange="updateEarlyTo(${index}, this.value)" placeholder="${isLast ? '∞ (Leave blank for onwards)' : 'Enter minutes (max 480)'}" />
                </td>
                <td class="py-3 px-4">
                    <div class="relative">
                        <input type="number" min="1000" step="1000" class="table-input pr-12 font-medium" value="${level.penaltyAmount ?? ''}" onchange="updateEarlyAmount(${index}, this.value)" required placeholder="20000" />
                        <span class="absolute right-3 top-1/2 -translate-y-1/2 text-xs font-semibold text-slate-400">VNĐ</span>
                    </div>
                </td>
                <td class="py-3 px-4 text-center">
                    <button type="button" class="btn-delete-row" onclick="deleteEarlyRow(${index})">
                        <span class="material-symbols-outlined text-[16px]">delete</span>
                        Delete
                    </button>
                </td>
            `;
            tbody.appendChild(tr);
        });
        updateHiddenInputs();
    }

    function updateLateTo(index, value) {
        const val = (value !== '' && value !== null && value !== undefined) ? parseInt(value, 10) : null;
        if (val !== null) {
            if (val < lateLevels[index].fromMinutes || val > 480) {
                showClientErrorBanner(`Late Penalties (Tier ${index + 1}): 'To (mins)' (${val}) must be between ${lateLevels[index].fromMinutes} and 480 minutes.`);
            }
        }
        lateLevels[index].toMinutes = val;
        recomputeTiers(lateLevels);
        renderLateTable();
    }

    function updateLateAmount(index, value) {
        lateLevels[index].penaltyAmount = value ? parseInt(value, 10) : null;
        updateHiddenInputs();
    }

    function updateEarlyTo(index, value) {
        const val = (value !== '' && value !== null && value !== undefined) ? parseInt(value, 10) : null;
        if (val !== null) {
            if (val < earlyLevels[index].fromMinutes || val > 480) {
                showClientErrorBanner(`Early Leave Penalties (Tier ${index + 1}): 'To (mins)' (${val}) must be between ${earlyLevels[index].fromMinutes} and 480 minutes.`);
            }
        }
        earlyLevels[index].toMinutes = val;
        recomputeTiers(earlyLevels);
        renderEarlyTable();
    }

    function updateEarlyAmount(index, value) {
        earlyLevels[index].penaltyAmount = value ? parseInt(value, 10) : null;
        updateHiddenInputs();
    }

    function addLateRow() {
        if (lateLevels.length > 0) {
            const lastIdx = lateLevels.length - 1;
            const last = lateLevels[lastIdx];
            if (last.toMinutes && parseInt(last.toMinutes, 10) >= 480) {
                showClientErrorBanner("Late Penalties: Maximum limit of 480 minutes has already been reached by the current tier.");
                return;
            }
            if (last.toMinutes === null || last.toMinutes === undefined || last.toMinutes === '') {
                last.toMinutes = Math.min(last.fromMinutes + 14, 479);
            }
        }
        recomputeTiers(lateLevels);
        const lastTo = lateLevels.length > 0 ? lateLevels[lateLevels.length - 1].toMinutes : 0;
        if (lastTo >= 480) {
            showClientErrorBanner("Late Penalties: Maximum limit of 480 minutes has already been reached.");
            return;
        }
        const nextFrom = Math.min(lastTo + 1, 480);
        lateLevels.push({ fromMinutes: nextFrom, toMinutes: null, penaltyAmount: 50000 });
        renderLateTable();
    }

    function deleteLateRow(index) {
        if (lateLevels.length <= 1) {
            showClientErrorBanner("At least one late penalty tier is required.");
            return;
        }
        lateLevels.splice(index, 1);
        if (lateLevels.length > 0) {
            const last = lateLevels[lateLevels.length - 1];
            last.toMinutes = null;
        }
        renderLateTable();
    }

    function addEarlyRow() {
        if (earlyLevels.length > 0) {
            const lastIdx = earlyLevels.length - 1;
            const last = earlyLevels[lastIdx];
            if (last.toMinutes && parseInt(last.toMinutes, 10) >= 480) {
                showClientErrorBanner("Early Leave Penalties: Maximum limit of 480 minutes has already been reached by the current tier.");
                return;
            }
            if (last.toMinutes === null || last.toMinutes === undefined || last.toMinutes === '') {
                last.toMinutes = Math.min(last.fromMinutes + 14, 479);
            }
        }
        recomputeTiers(earlyLevels);
        const lastTo = earlyLevels.length > 0 ? earlyLevels[earlyLevels.length - 1].toMinutes : 0;
        if (lastTo >= 480) {
            showClientErrorBanner("Early Leave Penalties: Maximum limit of 480 minutes has already been reached.");
            return;
        }
        const nextFrom = Math.min(lastTo + 1, 480);
        earlyLevels.push({ fromMinutes: nextFrom, toMinutes: null, penaltyAmount: 50000 });
        renderEarlyTable();
    }

    function deleteEarlyRow(index) {
        if (earlyLevels.length <= 1) {
            showClientErrorBanner("At least one early leave penalty tier is required.");
            return;
        }
        earlyLevels.splice(index, 1);
        if (earlyLevels.length > 0) {
            const last = earlyLevels[earlyLevels.length - 1];
            last.toMinutes = null;
        }
        renderEarlyTable();
    }

    function validateLevels(levels, typeName) {
        if (!levels || levels.length === 0) {
            return `At least one penalty tier is required for ${typeName}.`;
        }

        recomputeTiers(levels);

        if (levels[0].fromMinutes !== 1) {
            return `${typeName}: The first tier must start at minute 1.`;
        }

        for (let i = 0; i < levels.length; i++) {
            const lvl = levels[i];
            if (!lvl.fromMinutes || lvl.fromMinutes < 1 || lvl.fromMinutes > 480) {
                return `${typeName} (Tier ${i + 1}): 'From (mins)' must be between 1 and 480.`;
            }
            if (lvl.toMinutes !== null && lvl.toMinutes !== undefined && lvl.toMinutes !== '') {
                if (lvl.toMinutes < lvl.fromMinutes || lvl.toMinutes > 480) {
                    return `${typeName} (Tier ${i + 1}): 'To (mins)' (${lvl.toMinutes}) must be between ${lvl.fromMinutes} and 480.`;
                }
            }
            if (!lvl.penaltyAmount || lvl.penaltyAmount <= 0) {
                return `${typeName} (Tier ${i + 1}): Penalty amount must be greater than 0.`;
            }
        }

        for (let i = 0; i < levels.length - 1; i++) {
            const curr = levels[i];
            const next = levels[i + 1];
            if (curr.toMinutes === null || curr.toMinutes === undefined || curr.toMinutes === '') {
                return `${typeName}: Tier ${i + 1} (from ${curr.fromMinutes} mins) must have a 'To (mins)' value before Tier ${i + 2}.`;
            }
            if (curr.toMinutes >= next.fromMinutes) {
                return `${typeName} has overlapping minute ranges: (${curr.fromMinutes}-${curr.toMinutes} mins and ${next.fromMinutes}-${next.toMinutes} mins).`;
            }
            if (next.fromMinutes !== curr.toMinutes + 1) {
                return `${typeName}: Tier ${i + 2} must start at minute ${curr.toMinutes + 1} (right after Tier ${i + 1} ends at ${curr.toMinutes} mins).`;
            }
        }

        const lastTier = levels[levels.length - 1];
        if (lastTier.toMinutes !== null && lastTier.toMinutes !== undefined && lastTier.toMinutes !== '') {
            const lastToVal = parseInt(lastTier.toMinutes, 10);
            if (lastToVal !== 480) {
                return `${typeName}: The last tier (Tier ${levels.length}, from ${lastTier.fromMinutes} mins) must either reach 480 mins or leave 'To (mins)' blank to apply for all remaining minutes.`;
            }
        }

        return null;
    }

    function updateHiddenInputs() {
        const existing = document.querySelectorAll('.hidden-penalty-input');
        existing.forEach(el => el.remove());

        const form = document.getElementById('createPenaltyRuleForm');
        let globalIdx = 0;

        lateLevels.forEach(lvl => {
            appendHiddenInput(form, `PenaltyLevels[${globalIdx}].ViolationType`, 'LATE');
            appendHiddenInput(form, `PenaltyLevels[${globalIdx}].FromMinutes`, lvl.fromMinutes);
            appendHiddenInput(form, `PenaltyLevels[${globalIdx}].ToMinutes`, lvl.toMinutes);
            appendHiddenInput(form, `PenaltyLevels[${globalIdx}].PenaltyAmount`, lvl.penaltyAmount);
            globalIdx++;
        });

        earlyLevels.forEach(lvl => {
            appendHiddenInput(form, `PenaltyLevels[${globalIdx}].ViolationType`, 'EARLY_LEAVE');
            appendHiddenInput(form, `PenaltyLevels[${globalIdx}].FromMinutes`, lvl.fromMinutes);
            appendHiddenInput(form, `PenaltyLevels[${globalIdx}].ToMinutes`, lvl.toMinutes);
            appendHiddenInput(form, `PenaltyLevels[${globalIdx}].PenaltyAmount`, lvl.penaltyAmount);
            globalIdx++;
        });
    }

    function appendHiddenInput(form, name, value) {
        const input = document.createElement('input');
        input.type = 'hidden';
        input.className = 'hidden-penalty-input';
        input.name = name;
        input.value = value !== null && value !== undefined ? value : '';
        form.appendChild(input);
    }

    function showClientErrorBanner(message) {
        const container = document.getElementById('clientErrorContainer');
        if (!container) return;
        container.innerHTML = `
            <div class="p-4 bg-rose-50 border border-rose-200 rounded-xl flex items-start justify-between gap-3 text-rose-800 shadow-sm animate-fadeIn">
                <div class="flex items-start gap-2.5 min-w-0">
                    <span class="material-symbols-outlined text-[20px] shrink-0 mt-0.5 text-rose-600">error</span>
                    <div class="text-sm space-y-1 leading-relaxed font-semibold">
                        ${message}
                    </div>
                </div>
                <button type="button" class="p-1 rounded-lg hover:bg-rose-200/50 text-rose-700 transition-colors cursor-pointer shrink-0" title="Close" onclick="this.closest('.p-4').remove()">
                    <span class="material-symbols-outlined text-[18px]">close</span>
                </button>
            </div>
        `;
        window.scrollTo({ top: container.offsetTop - 30, behavior: 'smooth' });
    }

    document.addEventListener('DOMContentLoaded', () => {
        renderLateTable();
        renderEarlyTable();

        const form = document.getElementById('createPenaltyRuleForm');
        form.addEventListener('submit', (e) => {
            const container = document.getElementById('clientErrorContainer');
            if (container) container.innerHTML = '';

            const lateError = validateLevels(lateLevels, 'Late Penalties (LATE)');
            if (lateError) {
                e.preventDefault();
                showClientErrorBanner(lateError);
                return false;
            }

            const earlyError = validateLevels(earlyLevels, 'Early Leave Penalties (EARLY_LEAVE)');
            if (earlyError) {
                e.preventDefault();
                showClientErrorBanner(earlyError);
                return false;
            }

            updateHiddenInputs();
        });
    });
</script>
}
