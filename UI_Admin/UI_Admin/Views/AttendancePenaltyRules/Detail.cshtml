@model UI_Admin.Models.AttendancePenaltyRule.AttendancePenaltyRuleDetailViewModel
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

@{
    ViewData["Title"] = $"Details: {Model.RuleName}";
    var lateLevels = Model.PenaltyLevels.Where(l => l.ViolationType == "LATE").OrderBy(l => l.FromMinutes).ToList();
    var earlyLevels = Model.PenaltyLevels.Where(l => l.ViolationType == "EARLY_LEAVE").OrderBy(l => l.FromMinutes).ToList();
    var statusClass = Model.Status.ToLower();
}

@section Styles {
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet" />
<style>
    .pill { display: inline-flex; align-items: center; gap: 5px; padding: 4px 10px; border-radius: 12px; font-size: 12px; font-weight: 600; text-transform: uppercase; }
    .status.active { color: #065f46; background: #d1fae5; }
    .status.scheduled { color: #5b21b6; background: #ede9fe; }
    .status.draft { color: #92400e; background: #fef3c7; }
    .status.cancelled { color: #596071; background: #e8e9ed; }
    .dot { width: 6px; height: 6px; border-radius: 50%; }
    .status.active .dot { background: #10b981; }
    .status.scheduled .dot { background: #8b5cf6; }
    .status.draft .dot { background: #f59e0b; }
    .status.cancelled .dot { background: #89909d; }
</style>
}

<div class="w-full px-7 pt-6 pb-12 bg-[#F6F7FB] min-h-screen">
    <div class="w-full max-w-[1440px] mx-auto space-y-6" id="penaltyRuleDetailContainer">

        <!-- Toast/Modal Popup Notifications -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div id="statusResultModal" class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/40 backdrop-blur-xs p-4">
                <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-2xl border border-slate-200 animate-fadeIn">
                    <div class="text-center space-y-3">
                        <div class="w-14 h-14 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center mx-auto border border-emerald-100">
                            <span class="material-symbols-outlined text-[32px]">check_circle</span>
                        </div>
                        <h3 class="text-lg font-bold text-slate-900">Success</h3>
                        <p class="text-sm text-slate-600 leading-relaxed font-medium">
                            @TempData["SuccessMessage"]
                        </p>
                    </div>
                    <div class="flex items-center justify-center mt-6">
                        <button type="button" class="px-6 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-sm transition-all shadow-sm cursor-pointer" onclick="document.getElementById('statusResultModal').remove()">
                            OK
                        </button>
                    </div>
                </div>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div id="statusResultModal" class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/40 backdrop-blur-xs p-4">
                <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-2xl border border-slate-200 animate-fadeIn">
                    <div class="text-center space-y-3">
                        <div class="w-14 h-14 rounded-2xl bg-rose-50 text-rose-600 flex items-center justify-center mx-auto border border-rose-100">
                            <span class="material-symbols-outlined text-[32px]">error</span>
                        </div>
                        <h3 class="text-lg font-bold text-slate-900">Error Notification</h3>
                        <p class="text-sm text-rose-700 leading-relaxed font-medium">
                            @TempData["ErrorMessage"]
                        </p>
                    </div>
                    <div class="flex items-center justify-center mt-6">
                        <button type="button" class="px-6 py-2.5 rounded-xl bg-rose-600 hover:bg-rose-700 text-white font-semibold text-sm transition-all shadow-sm cursor-pointer" onclick="document.getElementById('statusResultModal').remove()">
                            Close
                        </button>
                    </div>
                </div>
            </div>
        }

        <!-- Top Header (No breadcrumb) -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div class="flex items-center gap-3">
                <h1 class="text-2xl font-bold text-slate-900">@Model.RuleName</h1>
                <span class="pill status @statusClass">
                    <span class="dot"></span>
                    @Model.Status
                </span>
            </div>

            <!-- Action Buttons -->
            <div class="flex items-center gap-2.5">
                <a asp-action="List" class="px-4 py-2 rounded-xl border border-slate-200 text-slate-600 bg-white hover:bg-slate-50 font-semibold text-sm transition-all shadow-2xs flex items-center gap-1.5">
                    <span class="material-symbols-outlined text-[18px]">arrow_back</span>
                    Back to List
                </a>

                @if (Model.Status == "Draft")
                {
                    <a asp-action="Edit" asp-route-id="@Model.PenaltyRuleId" class="px-4 py-2 rounded-xl bg-amber-50 hover:bg-amber-100 text-amber-700 border border-amber-200 font-semibold text-sm transition-all flex items-center gap-1.5">
                        <span class="material-symbols-outlined text-[18px]">edit</span>
                        Edit Rule
                    </a>

                    <button type="button" class="px-4 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-sm transition-all shadow-sm flex items-center gap-1.5" onclick="openPublishModal()">
                        <span class="material-symbols-outlined text-[18px]">publish</span>
                        Publish
                    </button>
                }

                @if (Model.Status == "Scheduled" || Model.Status == "Draft")
                {
                    <button type="button" class="px-4 py-2 rounded-xl bg-rose-50 hover:bg-rose-100 text-rose-600 border border-rose-200 font-semibold text-sm transition-all flex items-center gap-1.5" onclick="openCancelModal()">
                        <span class="material-symbols-outlined text-[18px]">cancel</span>
                        Cancel Rule
                    </button>
                }
            </div>
        </div>

        <!-- General Info Card -->
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 space-y-4">
            <div class="flex items-center gap-2 pb-3 border-b border-slate-100">
                <span class="material-symbols-outlined text-indigo-600 text-[20px]">info</span>
                <h2 class="text-base font-semibold text-slate-800">General Information</h2>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div>
                    <div class="text-xs font-semibold uppercase text-slate-400">Rule Name</div>
                    <div class="text-base font-bold text-slate-900 mt-1">@Model.RuleName</div>
                </div>
                <div>
                    <div class="text-xs font-semibold uppercase text-slate-400">Effective From</div>
                    <div class="text-base font-semibold text-indigo-600 mt-1">
                        @(Model.EffectiveFrom?.ToString("yyyy-MM-dd") ?? "—")
                    </div>
                </div>
                <div>
                    <div class="text-xs font-semibold uppercase text-slate-400">Effective To</div>
                    <div class="text-base font-semibold text-slate-700 mt-1">
                        @(Model.EffectiveTo.HasValue ? Model.EffectiveTo.Value.ToString("yyyy-MM-dd") : "Indefinite")
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.Description))
            {
                <div class="pt-3 border-t border-slate-100">
                    <div class="text-xs font-semibold uppercase text-slate-400 mb-1">Description</div>
                    <p class="text-sm text-slate-700 leading-relaxed">@Model.Description</p>
                </div>
            }
        </div>

        <!-- 2 Columns for Penalty Tables: Late and Early Leave -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

            <!-- 1. Mức phạt đi trễ (Late Violation Levels) -->
            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 space-y-4">
                <div class="flex items-center justify-between pb-3 border-b border-slate-100">
                    <div class="flex items-center gap-2">
                        <span class="material-symbols-outlined text-amber-600 text-[22px]">alarm_on</span>
                        <h2 class="text-base font-bold text-slate-900">Late Violation Penalties (LATE)</h2>
                    </div>
                    <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-amber-50 text-amber-700 border border-amber-200">
                        @lateLevels.Count @(lateLevels.Count == 1 ? "Tier" : "Tiers")
                    </span>
                </div>

                <div class="overflow-x-auto rounded-xl border border-slate-200">
                    <table class="w-full text-left text-sm border-collapse">
                        <thead>
                            <tr class="bg-slate-50 border-b border-slate-200 text-xs font-bold text-slate-600 uppercase">
                                <th class="py-3 px-4">Tier</th>
                                <th class="py-3 px-4">Minute Range</th>
                                <th class="py-3 px-4 text-right">Penalty Amount</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            @if (lateLevels.Count == 0)
                            {
                                <tr>
                                    <td colspan="3" class="py-6 text-center text-slate-400 text-xs">No late penalty tiers configured.</td>
                                </tr>
                            }
                            else
                            {
                                @for (int i = 0; i < lateLevels.Count; i++)
                                {
                                    var lvl = lateLevels[i];
                                    <tr class="hover:bg-slate-50/50">
                                        <td class="py-3.5 px-4 font-semibold text-slate-700">
                                            Tier @(i + 1)
                                        </td>
                                        <td class="py-3.5 px-4">
                                            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-slate-100 text-slate-800 font-semibold text-xs border border-slate-200">
                                                <span class="material-symbols-outlined text-[14px] text-amber-600">schedule</span>
                                                @(lvl.FromMinutes) – @(lvl.ToMinutes.HasValue ? $"{lvl.ToMinutes} mins" : "60 mins")
                                            </span>
                                        </td>
                                        <td class="py-3.5 px-4 text-right font-bold text-rose-600 text-base">
                                            @lvl.PenaltyAmount.ToString("N0") <span class="text-xs font-semibold text-slate-500">VNĐ</span>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- 2. Mức phạt về sớm (Early Leave Violation Levels) -->
            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 space-y-4">
                <div class="flex items-center justify-between pb-3 border-b border-slate-100">
                    <div class="flex items-center gap-2">
                        <span class="material-symbols-outlined text-rose-600 text-[22px]">timer_off</span>
                        <h2 class="text-base font-bold text-slate-900">Early Leave Penalties (EARLY_LEAVE)</h2>
                    </div>
                    <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-rose-50 text-rose-700 border border-rose-200">
                        @earlyLevels.Count @(earlyLevels.Count == 1 ? "Tier" : "Tiers")
                    </span>
                </div>

                <div class="overflow-x-auto rounded-xl border border-slate-200">
                    <table class="w-full text-left text-sm border-collapse">
                        <thead>
                            <tr class="bg-slate-50 border-b border-slate-200 text-xs font-bold text-slate-600 uppercase">
                                <th class="py-3 px-4">Tier</th>
                                <th class="py-3 px-4">Minute Range</th>
                                <th class="py-3 px-4 text-right">Penalty Amount</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            @if (earlyLevels.Count == 0)
                            {
                                <tr>
                                    <td colspan="3" class="py-6 text-center text-slate-400 text-xs">No early leave penalty tiers configured.</td>
                                </tr>
                            }
                            else
                            {
                                @for (int i = 0; i < earlyLevels.Count; i++)
                                {
                                    var lvl = earlyLevels[i];
                                    <tr class="hover:bg-slate-50/50">
                                        <td class="py-3.5 px-4 font-semibold text-slate-700">
                                            Tier @(i + 1)
                                        </td>
                                        <td class="py-3.5 px-4">
                                            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-slate-100 text-slate-800 font-semibold text-xs border border-slate-200">
                                                <span class="material-symbols-outlined text-[14px] text-rose-600">schedule</span>
                                                @(lvl.FromMinutes) – @(lvl.ToMinutes.HasValue ? $"{lvl.ToMinutes} mins" : "60 mins")
                                            </span>
                                        </td>
                                        <td class="py-3.5 px-4 text-right font-bold text-rose-600 text-base">
                                            @lvl.PenaltyAmount.ToString("N0") <span class="text-xs font-semibold text-slate-500">VNĐ</span>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

        </div>

    </div>
</div>

<!-- Modal Publish Confirmation -->
<div id="detailPublishModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-slate-900/40 backdrop-blur-xs p-4">
    <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-2xl border border-slate-200 animate-fadeIn">
        <form asp-action="Publish" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.PenaltyRuleId" />
            <input type="hidden" name="source" value="detail" />
            <div class="text-center space-y-3">
                <div class="w-12 h-12 rounded-2xl bg-indigo-50 text-indigo-600 flex items-center justify-center mx-auto">
                    <span class="material-symbols-outlined text-[28px]">publish</span>
                </div>
                <h3 class="text-lg font-bold text-slate-900">Publish Penalty Rule</h3>
                <p class="text-sm text-slate-500">
                    Are you sure you want to publish the rule <strong class="text-slate-800">@Model.RuleName</strong>?
                </p>
            </div>
            <div class="flex items-center justify-end gap-3 mt-6">
                <button type="button" class="px-4 py-2 rounded-xl text-slate-600 bg-slate-100 hover:bg-slate-200 font-semibold text-sm transition-all" onclick="closePublishModal()">
                    Close
                </button>
                <button type="submit" class="px-5 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-sm transition-all shadow-sm">
                    Confirm Publish
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Cancel Confirmation -->
<div id="detailCancelModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-slate-900/40 backdrop-blur-xs p-4">
    <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-2xl border border-slate-200 animate-fadeIn">
        <form asp-action="Cancel" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.PenaltyRuleId" />
            <input type="hidden" name="source" value="detail" />
            <div class="text-center space-y-3">
                <div class="w-12 h-12 rounded-2xl bg-rose-50 text-rose-600 flex items-center justify-center mx-auto">
                    <span class="material-symbols-outlined text-[28px]">cancel</span>
                </div>
                <h3 class="text-lg font-bold text-slate-900">Cancel Penalty Rule</h3>
                <p class="text-sm text-slate-500">
                    Are you sure you want to cancel the rule <strong class="text-slate-800">@Model.RuleName</strong>? This action cannot be undone.
                </p>
                @if (!string.Equals(Model.Status, "Draft", StringComparison.OrdinalIgnoreCase))
                {
                    <div class="text-left mt-3">
                        <label class="block text-xs font-semibold text-slate-700 uppercase mb-1">Cancellation Reason (Optional):</label>
                        <textarea name="cancellationReason" rows="2" class="w-full p-2.5 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:outline-none focus:ring-2 focus:ring-rose-500/20 focus:border-rose-500 transition-all placeholder:text-slate-400" placeholder="Enter cancellation reason..."></textarea>
                    </div>
                }
            </div>
            <div class="flex items-center justify-end gap-3 mt-6">
                <button type="button" class="px-4 py-2 rounded-xl text-slate-600 bg-slate-100 hover:bg-slate-200 font-semibold text-sm transition-all" onclick="closeCancelModal()">
                    Close
                </button>
                <button type="submit" class="px-5 py-2 rounded-xl bg-rose-600 hover:bg-rose-700 text-white font-semibold text-sm transition-all shadow-sm">
                    Confirm Cancellation
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
<script>
    const currentRuleId = @Model.PenaltyRuleId;

    function openPublishModal() {
        document.getElementById('detailPublishModal').classList.remove('hidden');
    }
    function closePublishModal() {
        document.getElementById('detailPublishModal').classList.add('hidden');
    }

    function openCancelModal() {
        document.getElementById('detailCancelModal').classList.remove('hidden');
    }
    function closeCancelModal() {
        document.getElementById('detailCancelModal').classList.add('hidden');
    }

    async function reloadPenaltyRuleDetailData() {
        try {
            const response = await fetch(window.location.href, {
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                cache: 'no-store'
            });
            if (response.status === 404) {
                window.location.href = '@Url.Action("List", "AttendancePenaltyRules")';
                return;
            }
            if (!response.ok) return;

            const html = await response.text();
            const parser = new DOMParser();
            const doc = parser.parseFromString(html, 'text/html');

            const newContainer = doc.getElementById('penaltyRuleDetailContainer');
            const currentContainer = document.getElementById('penaltyRuleDetailContainer');
            if (newContainer && currentContainer) {
                currentContainer.innerHTML = newContainer.innerHTML;
            }
        } catch (err) {
            console.warn('[SignalR] Failed to reload penalty rule detail data:', err);
        }
    }

    // Realtime Admin Data Sync via SignalR
    (function () {
        const apiBaseUrl = '@(Configuration["WorkShiftApi:BaseUrl"]?.TrimEnd('/') ?? "https://localhost:7193")';
        const connection = new signalR.HubConnectionBuilder()
            .withUrl(`${apiBaseUrl}/hubs/admin-realtime`, {
                skipNegotiation: false,
                transport: signalR.HttpTransportType.WebSockets | signalR.HttpTransportType.LongPolling
            })
            .withAutomaticReconnect([0, 2000, 5000, 10000])
            .build();

        connection.on("AttendancePenaltyRuleChanged", function (payload) {
            console.log("[SignalR] Attendance penalty rule changed on Detail:", payload);
            if (!payload || !payload.ruleId || payload.ruleId === currentRuleId || payload.action === "ACTIVATED" || payload.action === "PUBLISHED" || payload.action === "CANCELLED") {
                reloadPenaltyRuleDetailData();
            }
        });

        connection.start()
            .then(function () {
                console.log("[SignalR] Connected to AdminRealtimeHub on Detail page");
                return connection.invoke("JoinAdminGroup");
            })
            .catch(function (err) {
                console.warn("[SignalR] Connection error on AdminRealtimeHub:", err);
            });
    })();
</script>
}
