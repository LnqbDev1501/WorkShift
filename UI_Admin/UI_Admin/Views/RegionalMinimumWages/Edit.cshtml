@model UI_Admin.Models.RegionalMinimumWages.UpdateRegionalMinimumWageViewModel

@{
    ViewData["Title"] = $"Edit Minimum Wage - {Model.WageName}";
    var activeWages = Model?.ActiveWages ?? [];
}

<div class="flex flex-col w-full px-7 py-4">
    <!-- Header with Navigation -->
    <div class="flex items-center gap-3 pb-6">
        <a asp-controller="RegionalMinimumWages" asp-action="Index" class="inline-flex items-center justify-center w-9 h-9 rounded-xl bg-surface-container hover:bg-surface-container-high text-on-surface transition-colors shrink-0" title="Back to Minimum Wages">
            <span class="material-symbols-outlined text-[20px]">arrow_back</span>
        </a>
        <div>
            <h1 class="text-display-md md:text-display-lg font-bold tracking-tight text-on-surface">
                Edit Regional Minimum Wage
            </h1>
            <p class="text-body-md text-secondary mt-0.5">
                Update parameters for draft wage tier <strong class="text-on-surface">@Model.WageName</strong>.
            </p>
        </div>
    </div>

    <!-- DRAFT Notice Card -->
    <div class="mb-8 rounded-xl bg-amber-50/90 p-5 shadow-sm border border-amber-200/80">
        <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-amber-100 text-amber-800 flex items-center justify-center shrink-0 mt-0.5">
                <span class="material-symbols-outlined text-[22px]">edit_note</span>
            </div>
            <div class="flex flex-col flex-1 min-w-0">
                <span class="font-title-md font-bold text-amber-950 text-base">Draft Editing Notice</span>
                <p class="font-body-sm text-amber-900 mt-1 leading-relaxed text-xs sm:text-sm">
                    Only draft regional minimum wages can be edited. Changes made here will update the draft before it is published.
                </p>
            </div>
        </div>
    </div>

    <partial name="_NotificationModal" />

    <!-- Main Content Work Area -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        <!-- Form Card (8 Columns) -->
        <div class="lg:col-span-8 flex flex-col gap-6">
            <div class="bg-surface-container-lowest rounded-xl shadow-sm p-6 md:p-8 flex flex-col gap-7 border border-surface-container-high/60">
                <div class="flex items-start justify-between border-b border-surface-container-high pb-4">
                    <div>
                        <h3 class="text-title-lg font-bold text-on-surface">Update Draft Parameters</h3>
                        <p class="text-body-sm text-secondary mt-1">
                            Modify the wage tier name, minimum hourly rate, replaced wage, or effective date.
                        </p>
                    </div>
                    <span class="font-mono text-xs text-secondary font-semibold bg-surface-container px-2.5 py-1 rounded-md">
                        Draft ID: #@Model.RegionalMinimumWageId
                    </span>
                </div>

                <form method="post" asp-controller="RegionalMinimumWages" asp-action="Edit" asp-route-id="@Model.RegionalMinimumWageId" class="flex flex-col gap-6" id="editWageForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="RegionalMinimumWageId" />

                    <div asp-validation-summary="ModelOnly" class="p-4 rounded-xl bg-error-container/20 border border-error/30 text-error text-body-sm"></div>

                    <!-- Field 1: Wage Name -->
                    <div class="flex flex-col gap-1.5">
                        <label class="text-title-md text-on-surface font-semibold flex items-center gap-1" for="wageName">
                            Wage Name <span class="text-error font-bold">*</span>
                        </label>
                        <div class="relative flex items-center">
                            <span class="material-symbols-outlined absolute left-3.5 text-[18px] text-secondary pointer-events-none">payments</span>
                            <input autocomplete="off"
                                   class="w-full h-11 pl-10 pr-4 bg-surface-container-lowest rounded-lg text-on-surface placeholder:text-secondary/70 font-body-md border border-surface-container-high focus:ring-2 focus:ring-primary focus:outline-none transition-all"
                                   id="wageName"
                                   maxlength="150"
                                   name="WageName"
                                   value="@Model.WageName"
                                   placeholder="e.g., Vùng I"
                                   required
                                   type="text" />
                        </div>
                        <span asp-validation-for="WageName" class="text-error text-label-sm"></span>
                    </div>

                    <!-- Field 2: Minimum Hourly Rate -->
                    <div class="flex flex-col gap-1.5">
                        <label class="text-title-md text-on-surface font-semibold flex items-center gap-1" for="minimumHourlyRate">
                            Minimum Hourly Rate <span class="text-error font-bold">*</span>
                        </label>
                        <div class="relative flex items-center">
                            <span class="material-symbols-outlined absolute left-3.5 text-[18px] text-secondary pointer-events-none">attach_money</span>
                            <input autocomplete="off"
                                   class="w-full h-11 pl-10 pr-28 bg-surface-container-lowest rounded-lg text-on-surface placeholder:text-secondary/70 font-code-num font-bold text-body-md border border-surface-container-high focus:ring-2 focus:ring-primary focus:outline-none transition-all"
                                   id="minimumHourlyRate"
                                   min="1"
                                   step="1"
                                   name="MinimumHourlyRate"
                                   value="@Model.MinimumHourlyRate.ToString("0")"
                                   placeholder="e.g., 27000"
                                   required
                                   type="number" />
                            <span class="absolute right-3.5 px-2 py-0.5 rounded bg-surface-container text-secondary text-xs font-mono font-bold pointer-events-none">VND / hour</span>
                        </div>
                        <span asp-validation-for="MinimumHourlyRate" class="text-error text-label-sm"></span>
                    </div>

                    <!-- Field 3: Replaced Wage Dropdown -->
                    <div class="flex flex-col gap-1.5">
                        <label class="text-title-md text-on-surface font-semibold flex items-center gap-1.5" for="replacedWageId">
                            Replaces Existing Wage
                            <span class="text-label-sm text-secondary font-normal font-sans">(Optional)</span>
                        </label>
                        <div class="relative flex items-center">
                            <span class="material-symbols-outlined absolute left-3.5 text-[18px] text-secondary pointer-events-none">swap_horiz</span>
                            <select id="replacedWageId"
                                    name="ReplacedWageId"
                                    class="w-full h-11 pl-10 pr-10 bg-surface-container-lowest rounded-lg text-on-surface font-body-md border border-surface-container-high focus:ring-2 focus:ring-primary focus:outline-none transition-all cursor-pointer">
                                <option value="" selected="@(Model?.ReplacedWageId == null)">No replacement (New standalone wage)</option>
                                @foreach (var activeWage in activeWages)
                                {
                                    <option value="@activeWage.RegionalMinimumWageId" selected="@(Model?.ReplacedWageId == activeWage.RegionalMinimumWageId)">
                                        @activeWage.WageName — @activeWage.MinimumHourlyRate.ToString("N0") VND/hour (ID #@activeWage.RegionalMinimumWageId)
                                    </option>
                                }
                            </select>
                        </div>
                    </div>

                    <!-- Field 4: Effective From -->
                    <div class="flex flex-col gap-1.5">
                        <label class="text-title-md text-on-surface font-semibold flex items-center gap-1.5" for="effectiveFrom">
                            Effective From
                            <span class="text-label-sm text-secondary font-normal font-sans">(Optional for Draft, required before Publish)</span>
                        </label>
                        <div class="relative flex items-center">
                            <span class="material-symbols-outlined absolute left-3.5 text-[18px] text-secondary pointer-events-none">calendar_today</span>
                            <input autocomplete="off"
                                   class="w-full h-11 pl-10 pr-4 bg-surface-container-lowest rounded-lg text-on-surface placeholder:text-secondary/70 font-body-md font-mono border border-surface-container-high focus:ring-2 focus:ring-primary focus:outline-none transition-all"
                                   id="effectiveFrom"
                                   name="EffectiveFrom"
                                   value="@(Model?.EffectiveFrom.HasValue == true ? Model.EffectiveFrom.Value.ToString("yyyy-MM-dd") : "")"
                                   type="date" />
                        </div>
                    </div>

                    <!-- Field 5: Description -->
                    <div class="flex flex-col gap-1.5">
                        <label class="text-title-md text-on-surface font-semibold flex items-center gap-1.5" for="description">
                            Description
                        </label>
                        <textarea class="w-full p-3.5 bg-surface-container-lowest rounded-lg text-on-surface placeholder:text-secondary/70 font-body-md border border-surface-container-high focus:ring-2 focus:ring-primary focus:outline-none transition-all resize-y min-h-[110px]"
                                  id="description"
                                  maxlength="500"
                                  name="Description"
                                  placeholder="Provide description or notes regarding this update..."
                                  rows="4">@Model.Description</textarea>
                        <span asp-validation-for="Description" class="text-error text-label-sm"></span>
                    </div>
                </form>
            </div>
        </div>

        <!-- Sidebar Summary (4 Columns) -->
        <div class="lg:col-span-4 flex flex-col gap-6">
            <div class="bg-surface-container-lowest rounded-xl shadow-sm p-6 flex flex-col gap-4 border border-surface-container-high/60">
                <div class="flex items-center gap-2 border-b border-surface-container-high pb-3">
                    <span class="material-symbols-outlined text-primary text-[20px]">info</span>
                    <h4 class="font-title-md font-bold text-on-surface text-sm">Editing Rules</h4>
                </div>
                <div class="flex flex-col gap-3 text-xs text-secondary leading-relaxed">
                    <p>
                        Draft rules:
                    </p>
                    <ol class="list-decimal pl-4 space-y-1.5">
                        <li>Only <strong>DRAFT</strong> records can be modified.</li>
                        <li>After saving, you can publish the wage tier when ready.</li>
                        <li>Non-draft wages cannot be updated.</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>

    <!-- Action Bar Footer -->
    <div class="mt-10 pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 border-t border-surface-container-high/60">
        <div class="flex items-center gap-2 text-secondary text-xs">
            <span class="material-symbols-outlined text-[16px] text-primary">verified_user</span>
            <span>Changes will be saved to the draft record.</span>
        </div>
        <div class="flex items-center gap-3 w-full sm:w-auto justify-end">
            <a class="flex-1 sm:flex-none h-11 px-5 rounded-lg bg-surface-container hover:bg-surface-container-high text-on-surface font-title-md text-[13px] flex items-center justify-center transition-colors shadow-sm" asp-controller="RegionalMinimumWages" asp-action="Index">
                Cancel
            </a>
            <button class="flex-1 sm:flex-none h-11 px-6 rounded-lg bg-primary hover:bg-primary-container text-on-primary font-title-md text-[13px] flex items-center justify-center gap-2 shadow-md hover:shadow-lg transition-all active:scale-[0.98] cursor-pointer" type="submit" form="editWageForm">
                <span class="material-symbols-outlined text-[18px]">check_circle</span>
                <span>Save Changes</span>
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
