@model UI_Admin.Models.Catalog.StaffAccountPagedViewModel

@{
    ViewData["Title"] = "Staff Management";
}

<div class="flex flex-col w-full gap-unit-4 px-7 py-4">
    <partial name="_NotificationModal" />

    <!-- Header Title & Action Bar -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-unit-4">
        <div class="flex flex-col">
            <div class="list-eyebrow">Staff Management</div>
            <div class="flex items-center gap-unit-3">
                <h1 class="font-display-lg text-display-lg text-on-surface tracking-tight">Staff Management</h1>
            </div>
            <p class="font-body-md text-body-md text-secondary mt-1">Manage staff accounts in your branch.</p>
        </div>
        <div class="flex items-center gap-unit-3 self-start md:self-auto">
            <a asp-controller="ManagerStaff" asp-action="Create" class="inline-flex items-center justify-center gap-unit-2 h-[40px] px-unit-4 rounded-xl bg-primary-container hover:bg-primary text-on-primary font-body-md-medium text-body-md-medium transition-colors shadow-sm focus:outline-none cursor-pointer">
                <span class="material-symbols-outlined text-[20px]">add</span>
                <span>Add Staff</span>
            </a>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700">@Model.SuccessMessage</div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">@Model.ErrorMessage</div>
    }

    <partial name="_ListMetrics" model='@(new ListMetricViewModel[] {
new("Total Staff", Model.TotalItems.ToString("N0"), "Matching current filters", "groups", "#4f46e5"),
new("Active Staff", Model.Items.Count(x => x.Status == "ACTIVE").ToString("N0"), "On this page", "check_circle", "#10b981"),
new("Pending Setup", Model.Items.Count(x => x.Status == "PENDING" || !x.HasPassword).ToString("N0"), "On this page", "pending_actions", "#f59e0b"),
new("Inactive Staff", Model.Items.Count(x => x.Status == "INACTIVE").ToString("N0"), "On this page", "pause_circle", "#f59e0b")
})' />
    <!-- Filter Toolbar -->
    <form method="get" asp-controller="ManagerStaff" asp-action="Index" id="filter-form" class="ws-list-filter" role="search">
        <div class="ws-filter-row">
            <label class="ws-filter-field ws-filter-keyword"><span class="material-symbols-outlined" aria-hidden="true">search</span><input aria-label="Search" id="staff-search" name="search" value="@Model.Search" placeholder="Search name, email, phone..." type="text"></label>
            <div class="ws-filter-field"><select aria-label="Status" id="status-filter" name="status" onchange="this.form.submit()">
                        <option value="all" selected="@(Model.StatusFilter == "all")">All Status</option>
                        <option value="active" selected="@(Model.StatusFilter == "active")">Active</option>
                        <option value="pending" selected="@(Model.StatusFilter == "pending")">Pending Setup</option>
                        <option value="inactive" selected="@(Model.StatusFilter == "inactive")">Inactive</option>
                    </select></div>
            <partial name="_ListFilterActions" model='"Index"' />
        </div>
    </form>

    <!-- Main Table Container -->
    <div class="bg-surface-container-lowest rounded-xl shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left">
                <thead>
                    <tr class="h-[40px] bg-surface-container-low text-secondary text-label-md font-label-md uppercase tracking-wider">
                        <th class="px-unit-5 py-2" scope="col">Avatar</th>
                        <th class="px-unit-4 py-2" scope="col">Full Name</th>
                        <th class="px-unit-4 py-2" scope="col">Email</th>
                        <th class="px-unit-4 py-2" scope="col">Phone</th>
                        <th class="px-unit-4 py-2" scope="col">Status</th>
                        <th class="px-unit-5 py-2 text-right" scope="col">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y-0" id="staff-table-body">
                    @if (Model.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="px-unit-5 py-8 text-center text-secondary font-body-md">
                                No staff found matching your filter criteria.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Items)
                        {
                            var isInactive = item.Status.Equals("INACTIVE", StringComparison.OrdinalIgnoreCase);
                            var isPending = !isInactive && (!item.HasPassword || item.Status.Equals("PENDING", StringComparison.OrdinalIgnoreCase));
                            var isActive = !isInactive && !isPending && item.Status.Equals("ACTIVE", StringComparison.OrdinalIgnoreCase);
                            <tr class="h-[56px] hover:bg-surface-container-low transition-colors group @(isInactive ? "bg-surface-container-lowest/70" : "")">
                                <td class="px-unit-5 py-2">
                                    <div class="w-10 h-10 rounded-full bg-[#5146e5] text-white text-sm font-bold flex items-center justify-center border-2 border-surface-container shadow-sm">
                                        @item.FullName.Split(' ').TakeLast(2).Select(w => char.ToUpperInvariant(w[0])).Select(c => c.ToString()).Aggregate((a, b) => a + b)
                                    </div>
                                </td>
                                <td class="px-unit-4 py-2 font-body-md-medium text-body-md-medium @(isActive ? "text-on-surface" : "text-secondary") truncate max-w-[200px]">
                                    @item.FullName
                                </td>
                                <td class="px-unit-4 py-2 font-body-md text-body-md text-secondary break-all">@item.Email</td>
                                <td class="px-unit-4 py-2 font-body-md text-body-md text-secondary whitespace-nowrap">@item.Phone</td>
                                <td class="px-unit-4 py-2 whitespace-nowrap">
                                    @if (isPending)
                                    {
                                        <span class="inline-flex items-center gap-1.5 h-6 px-2 rounded-full text-label-sm font-label-sm bg-amber-50 text-amber-700">
                                            <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
                                            Pending
                                        </span>
                                    }
                                    else if (isActive)
                                    {
                                        <span class="inline-flex items-center gap-1.5 h-6 px-2 rounded-full text-label-sm font-label-sm bg-emerald-50 text-emerald-700">
                                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1.5 h-6 px-2 rounded-full text-label-sm font-label-sm bg-surface-container text-secondary">
                                            <span class="w-1.5 h-1.5 rounded-full bg-secondary"></span>
                                            Inactive
                                        </span>
                                    }
                                </td>
                                <td class="px-unit-5 py-2 text-right whitespace-nowrap">
                                    <div class="inline-flex items-center justify-end gap-2">
                                        @if (!item.HasPassword)
                                        {
                                            <form asp-controller="ManagerStaff" asp-action="ResendSetupLink" method="post" class="inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.UserId" />
                                                <button type="submit" class="ws-icon-action" title="Resend account setup link" aria-label="Resend account setup link"><span class="material-symbols-outlined" aria-hidden="true">mail</span></button>
                                            </form>
                                        }
                                        <a asp-controller="ManagerStaff" asp-action="Details" asp-route-id="@item.UserId" class="ws-icon-action" title="View details" aria-label="View details"><span class="material-symbols-outlined" aria-hidden="true">visibility</span></a>
                                        @if (isActive || isPending)
                                        {
                                            <button type="button"
                                                    data-id="@item.UserId"
                                                    data-name="@item.FullName"
                                                    onclick="openStaffModal('deactivate-staff-modal','deactivate-target-name','deactivate-staff-id',this)" class="ws-icon-action danger open-deactivate-btn" title="Deactivate" aria-label="Deactivate"><span class="material-symbols-outlined" aria-hidden="true">block</span></button>
                                        }
                                        else
                                        {
                                            <button type="button"
                                                    data-id="@item.UserId"
                                                    data-name="@item.FullName"
                                                    onclick="openStaffModal('restore-staff-modal','restore-target-name','restore-staff-id',this)" class="ws-icon-action open-restore-btn" title="Restore" aria-label="Restore"><span class="material-symbols-outlined" aria-hidden="true">restore</span></button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <!-- Pagination / Footer Bar -->
        <partial name="_ListPagination" model="@(new ListPaginationViewModel
        {
            PageNumber = Model.Page,
            PageSize = Model.PageSize,
            TotalItems = Model.TotalItems,
            ItemLabel = "staff",
        })" />
    </div>

    <!-- Deactivate Staff Modal Dialog -->
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-inverse-surface/50 backdrop-blur-xs transition-opacity duration-200 hidden" id="deactivate-staff-modal">
        <div class="relative w-full max-w-lg bg-surface-container-lowest rounded-xl shadow-xl overflow-hidden p-unit-6 flex flex-col gap-unit-4">
            <div class="flex items-start gap-unit-3">
                <div class="w-10 h-10 rounded-full bg-error-container text-error flex items-center justify-center shrink-0">
                    <span class="material-symbols-outlined text-[24px]">warning</span>
                </div>
                <div class="flex-1">
                    <h2 class="font-title-lg text-title-lg text-on-surface">Deactivate Staff</h2>
                    <p class="font-body-sm text-body-sm text-secondary mt-1">Are you sure you want to deactivate <strong class="text-on-surface" id="deactivate-target-name">this staff</strong>?</p>
                </div>
                <button class="text-secondary hover:text-on-surface p-1 rounded-lg hover:bg-surface-container transition-colors" id="close-deactivate-modal" type="button" onclick="closeStaffModal('deactivate-staff-modal')">
                    <span class="material-symbols-outlined text-[20px]">close</span>
                </button>
            </div>
            <div class="p-unit-3 bg-surface-container-low rounded-lg text-body-sm text-secondary space-y-1">
                <p>Deactivating this staff will prevent them from accessing the system.</p>
                <p>The staff account can be restored later if needed.</p>
            </div>
            <form method="post" asp-controller="ManagerStaff" asp-action="Deactivate" id="deactivate-form" class="flex items-center justify-end gap-unit-3 pt-unit-2">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="deactivate-staff-id" value="0" />
                <button class="h-[40px] px-unit-4 rounded-xl bg-surface-container hover:bg-surface-container-high text-on-surface font-body-md-medium text-body-md-medium transition-colors cursor-pointer" id="cancel-deactivate-modal" type="button" onclick="closeStaffModal('deactivate-staff-modal')">Cancel</button>
                <button class="h-[40px] px-unit-4 rounded-xl bg-error hover:bg-error-container hover:text-on-error-container text-white font-body-md-medium text-body-md-medium transition-colors shadow-sm cursor-pointer" id="confirm-deactivate-btn" type="submit">Deactivate Staff</button>
            </form>
        </div>
    </div>

    <!-- Restore Staff Modal Dialog -->
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-inverse-surface/50 backdrop-blur-xs transition-opacity duration-200 hidden" id="restore-staff-modal">
        <div class="relative w-full max-w-lg bg-surface-container-lowest rounded-xl shadow-xl overflow-hidden p-unit-6 flex flex-col gap-unit-4">
            <div class="flex items-start gap-unit-3">
                <div class="w-10 h-10 rounded-full bg-primary-fixed text-primary flex items-center justify-center shrink-0">
                    <span class="material-symbols-outlined text-[24px]">restart_alt</span>
                </div>
                <div class="flex-1">
                    <h2 class="font-title-lg text-title-lg text-on-surface">Restore Staff</h2>
                    <p class="font-body-sm text-body-sm text-secondary mt-1">Are you sure you want to restore <strong class="text-on-surface" id="restore-target-name">this staff</strong>?</p>
                </div>
                <button class="text-secondary hover:text-on-surface p-1 rounded-lg hover:bg-surface-container transition-colors" id="close-restore-modal" type="button" onclick="closeStaffModal('restore-staff-modal')">
                    <span class="material-symbols-outlined text-[20px]">close</span>
                </button>
            </div>
            <div class="p-unit-3 bg-surface-container-low rounded-lg text-body-sm text-secondary space-y-1">
                <p>Restoring this staff will change their status back to <strong class="text-on-surface font-medium">Active</strong>.</p>
            </div>
            <form method="post" asp-controller="ManagerStaff" asp-action="Restore" id="restore-form" class="flex items-center justify-end gap-unit-3 pt-unit-2">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="restore-staff-id" value="0" />
                <button class="h-[40px] px-unit-4 rounded-xl bg-surface-container hover:bg-surface-container-high text-on-surface font-body-md-medium text-body-md-medium transition-colors cursor-pointer" id="cancel-restore-modal" type="button" onclick="closeStaffModal('restore-staff-modal')">Cancel</button>
                <button class="h-[40px] px-unit-4 rounded-xl bg-primary hover:bg-primary-container text-on-primary font-body-md-medium text-body-md-medium transition-colors shadow-sm cursor-pointer" id="confirm-restore-btn" type="submit">Confirm Restore</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/manager-staff.js" asp-append-version="true"></script>
    <script>
        function openStaffModal(modalId, nameId, inputId, btn) {
            var modal = document.getElementById(modalId);
            if (!modal) return;
            var name = btn ? btn.getAttribute('data-name') : '';
            var id = btn ? btn.getAttribute('data-id') : '';
            var nameEl = document.getElementById(nameId);
            if (nameEl) nameEl.textContent = name || 'this staff';
            var inputEl = document.getElementById(inputId);
            if (inputEl) inputEl.value = id || '';
            modal.classList.remove('hidden');
        }
        function closeStaffModal(modalId) {
            var modal = document.getElementById(modalId);
            if (modal) modal.classList.add('hidden');
        }
    </script>
}
