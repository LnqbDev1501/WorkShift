@model UI_Admin.Models.Catalog.StaffAccountDetailViewModel

@{
    ViewData["Title"] = $"Staff - {Model.FullName}";
}

<div class="flex flex-col w-full gap-unit-4 px-7 py-4">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-unit-4">
        <div class="flex items-center gap-unit-3">
            <a asp-controller="ManagerStaff" asp-action="Index" class="inline-flex items-center justify-center h-9 w-9 rounded-xl bg-surface-container-lowest hover:bg-surface-container text-secondary hover:text-on-surface transition-colors shadow-sm" title="Back">
                <span class="material-symbols-outlined text-[20px]">arrow_back</span>
            </a>
            <div class="flex flex-col">
                <div class="list-eyebrow">Staff Management</div>
                <h1 class="font-display-lg text-display-lg text-on-surface tracking-tight">@Model.FullName</h1>
            </div>
        </div>
        <div class="flex flex-col sm:flex-row items-start sm:items-center gap-2 md:ml-auto">
            @{
                var isInactive = Model.Status.Equals("INACTIVE", StringComparison.OrdinalIgnoreCase);
                var isPending = !isInactive && (!Model.HasPassword || Model.Status.Equals("PENDING", StringComparison.OrdinalIgnoreCase));
                var isActive = !isInactive && !isPending && Model.Status.Equals("ACTIVE", StringComparison.OrdinalIgnoreCase);
            }
            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-sm font-medium
                @(isPending ? "bg-amber-50 text-amber-700 border-amber-200" :
                  isActive ? "bg-emerald-50 text-emerald-700 border-emerald-200" :
                  "bg-gray-100 text-gray-600 border-gray-200") border">
                <span class="w-2 h-2 rounded-full @(isPending ? "bg-amber-500" : isActive ? "bg-emerald-500" : "bg-gray-400")"></span>
                @(isPending ? "PENDING" : Model.Status)
            </span>
        </div>
    </div>

    <div class="w-full max-w-5xl mx-auto space-y-6">
        @if (TempData["SuccessMessage"] is string successMsg)
        {
            <div class="rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700">
                @successMsg
            </div>
        }
        @if (TempData["ErrorMessage"] is string errMsg)
        {
            <div class="rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
                @errMsg
            </div>
        }

        <!-- Profile Header Card -->
        <div class="bg-white rounded-2xl border border-gray-200 shadow-sm p-6">
            <div class="flex flex-col sm:flex-row sm:items-center gap-5">
                <div class="relative flex-shrink-0">
                    @if (!string.IsNullOrWhiteSpace(Model.AvatarUrl))
                    {
                        <img alt="@Model.FullName Avatar" class="w-24 h-24 rounded-full object-cover border-2 border-gray-100 shadow-sm" src="@Model.AvatarUrl" />
                    }
                    else
                    {
                        <div class="w-24 h-24 rounded-full bg-indigo-600 text-white text-3xl font-bold flex items-center justify-center border-2 border-gray-100 shadow-sm">
                            @Model.FullName.Split(' ').TakeLast(2).Select(w => char.ToUpperInvariant(w[0]).ToString()).Aggregate((a, b) => a + b)
                        </div>
                    }

                    @if (isActive)
                    {
                        <span class="absolute bottom-1 right-1 w-4 h-4 rounded-full bg-white flex items-center justify-center shadow-sm" title="Active">
                            <span class="w-3 h-3 rounded-full bg-emerald-500"></span>
                        </span>
                    }
                    else if (isPending)
                    {
                        <span class="absolute bottom-1 right-1 w-4 h-4 rounded-full bg-white flex items-center justify-center shadow-sm" title="Pending Setup">
                            <span class="w-3 h-3 rounded-full bg-amber-500"></span>
                        </span>
                    }
                    else
                    {
                        <span class="absolute bottom-1 right-1 w-4 h-4 rounded-full bg-white flex items-center justify-center shadow-sm" title="Inactive">
                            <span class="w-3 h-3 rounded-full bg-gray-400"></span>
                        </span>
                    }
                </div>
                <div class="flex flex-col space-y-1">
                    <div class="flex flex-wrap items-center gap-3">
                        <h1 class="text-2xl font-bold text-gray-900">@Model.FullName</h1>
                        <span class="inline-flex items-center px-2.5 py-1 rounded-full bg-indigo-50 text-indigo-700 text-xs font-semibold border border-indigo-200">
                            @Model.RoleName
                        </span>
                    </div>
                    <p class="text-sm text-gray-500 truncate">@Model.Email</p>
                    <p class="text-xs text-gray-400 font-mono">ID: @Model.UserId.ToString()[..8]...</p>
                </div>
            </div>
        </div>

        <!-- Stats Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-5">
                <p class="text-xs font-semibold uppercase tracking-wider text-gray-400 mb-1.5">Email</p>
                <p class="text-sm font-medium text-gray-900 break-all">@Model.Email</p>
            </div>
            <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-5">
                <p class="text-xs font-semibold uppercase tracking-wider text-gray-400 mb-1.5">Phone</p>
                <p class="text-sm font-medium text-gray-900">@(string.IsNullOrWhiteSpace(Model.Phone) ? "Not provided" : Model.Phone)</p>
            </div>
            <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-5">
                <p class="text-xs font-semibold uppercase tracking-wider text-gray-400 mb-1.5">Identity No</p>
                <p class="text-sm font-medium text-gray-900">@(string.IsNullOrWhiteSpace(Model.IdentityNo) ? "Not provided" : Model.IdentityNo)</p>
            </div>
            <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-5">
                <p class="text-xs font-semibold uppercase tracking-wider text-gray-400 mb-1.5">Gender</p>
                <p class="text-sm font-medium text-gray-900">@Model.Gender</p>
            </div>
            <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-5">
                <p class="text-xs font-semibold uppercase tracking-wider text-gray-400 mb-1.5">Employee Type</p>
                <p class="text-sm font-medium text-gray-900">@(string.IsNullOrWhiteSpace(Model.EmployeeTypeName) ? "Not assigned" : Model.EmployeeTypeName)</p>
            </div>
            <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-5">
                <p class="text-xs font-semibold uppercase tracking-wider text-gray-400 mb-1.5">Date of Birth</p>
                <p class="text-sm font-medium text-gray-900">@(Model.DateOfBirth == default ? "Not provided" : Model.DateOfBirth.Value.ToString("dd/MM/yyyy"))</p>
            </div>
            <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-5">
                <p class="text-xs font-semibold uppercase tracking-wider text-gray-400 mb-1.5">Address</p>
                <p class="text-sm font-medium text-gray-900 break-words">@(string.IsNullOrWhiteSpace(Model.Address) ? "Not provided" : Model.Address)</p>
            </div>
            <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-5">
                <p class="text-xs font-semibold uppercase tracking-wider text-gray-400 mb-1.5">Branch</p>
                <p class="text-sm font-medium text-gray-900">@(string.IsNullOrWhiteSpace(Model.BranchName) ? "Not assigned" : $"{Model.BranchCode} - {Model.BranchName}")</p>
            </div>
            <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-5">
                <p class="text-xs font-semibold uppercase tracking-wider text-gray-400 mb-1.5">Joined</p>
                <p class="text-sm font-medium text-gray-900">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>
            </div>
            <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-5">
                <p class="text-xs font-semibold uppercase tracking-wider text-gray-400 mb-1.5">Last Updated</p>
                <p class="text-sm font-medium text-gray-900">@Model.UpdatedAt.ToString("dd/MM/yyyy HH:mm")</p>
            </div>
            <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-5">
                <p class="text-xs font-semibold uppercase tracking-wider text-gray-400 mb-1.5">Status</p>
                <p>
                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold border
                        @(isPending ? "bg-amber-50 text-amber-700 border-amber-200" :
                          isActive ? "bg-emerald-50 text-emerald-700 border-emerald-200" :
                          "bg-gray-100 text-gray-600 border-gray-200")">
                        @(isPending ? "PENDING" : Model.Status)
                    </span>
                </p>
            </div>
        </div>

        <div class="flex items-center gap-3 pt-2 border-t border-gray-200">
            @if (!Model.HasPassword)
            {
                <form asp-controller="ManagerStaff" asp-action="ResendSetupLink" method="post" class="inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.UserId" />
                    <button type="submit" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-primary text-on-primary hover:bg-primary-container text-sm font-medium transition-colors shadow-sm cursor-pointer">
                        <span class="material-symbols-outlined text-[18px]">mail</span>
                        <span>Resend Setup Link</span>
                    </button>
                </form>
            }
            @if (isActive || isPending)
            {
                <form asp-controller="ManagerStaff" asp-action="Deactivate" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.UserId" />
                    <button type="submit" class="inline-flex items-center px-4 py-2 rounded-xl bg-white border border-gray-200 text-sm font-medium text-gray-700 hover:bg-gray-50 transition-colors shadow-sm cursor-pointer">
                        <span>Deactivate</span>
                    </button>
                </form>
            }
            else
            {
                <form asp-controller="ManagerStaff" asp-action="Restore" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.UserId" />
                    <button type="submit" class="inline-flex items-center px-4 py-2 rounded-xl bg-[#4f46e5] text-sm font-medium text-white hover:bg-[#4338ca] transition-colors shadow-sm cursor-pointer">
                        <span>Restore</span>
                    </button>
                </form>
            }
        </div>
    </div>
</div>