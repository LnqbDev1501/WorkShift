@model UI_Admin.Models.Holidays.EditHolidayViewModel
@{ ViewData["Title"] = "Edit Public Holiday"; }
@section Styles { <link rel="stylesheet" href="~/css/holidays.css" asp-append-version="true" /> }

<div class="holiday-shell">
<main class="holiday-page holiday-form-page">
    <div class="form-heading"><div><h1>Edit Public Holiday</h1><p>Update the holiday identity, calendar date, or statutory pay rate.</p></div><a asp-action="List" class="secondary-button"><span class="material-symbols-outlined">arrow_back</span>Back to holidays</a></div>
    <form asp-action="Edit" asp-route-id="@Model.PublicHolidayId" method="post" class="holiday-form-full">
        @Html.AntiForgeryToken()<input asp-for="PublicHolidayId" type="hidden" /><input asp-for="IsActive" type="hidden" />
        <div asp-validation-summary="All" class="holiday-validation"></div>
        <div class="edit-workspace">
        <section class="holiday-form-card edit-card">
            <header><div><span class="material-symbols-outlined">edit_calendar</span><div><h2>Holiday information</h2><p>Record #@Model.PublicHolidayId · Active</p></div></div><span class="status active"><i></i>Active</span></header>
            <div class="edit-fields">
                <label><span>Holiday name *</span><input asp-for="HolidayName" maxlength="150" /><span asp-validation-for="HolidayName"></span></label>
                <label><span>Holiday date *</span><input asp-for="HolidayDate" type="date" /><span asp-validation-for="HolidayDate"></span></label>
                <label><span>Pay multiplier *</span><div class="multiplier-input"><input asp-for="PayMultiplier" type="number" min="0.01" max="999.99" step="0.01" /><b>× base pay</b></div><span asp-validation-for="PayMultiplier"></span></label>
            </div>
        </section>
        <aside class="holiday-form-sidebar">
            <section class="guideline-card"><header><span class="material-symbols-outlined">policy</span><h2>Edit safeguards</h2></header><ul><li><span class="material-symbols-outlined">check_circle</span><div><strong>Name correction</strong><p>The holiday name can be corrected while the record is active.</p></div></li><li><span class="material-symbols-outlined">event</span><div><strong>Date integrity</strong><p>The new date must not be reserved by another active or inactive holiday.</p></div></li><li class="danger"><span class="material-symbols-outlined">warning</span><div><strong>Payroll protection</strong><p>Date and multiplier changes are blocked after payroll usage.</p></div></li></ul></section>
        </aside>
        </div>
        <section class="holiday-form-note warning full-note"><span class="material-symbols-outlined">warning</span><div><strong>Payroll protection</strong><p>If this holiday has been used in payroll, the backend will prevent changes to its date or multiplier.</p></div></section>
        <div class="form-actions"><a asp-action="Details" asp-route-id="@Model.PublicHolidayId" class="secondary-button">Cancel</a><button type="submit" class="primary-button"><span class="material-symbols-outlined">save</span>Save changes</button></div>
    </form>
</main>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
