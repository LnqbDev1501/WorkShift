<div class="holiday-modal" id="holiday-restore-modal" role="dialog" aria-modal="true" aria-labelledby="restore-modal-title" hidden>
    <div class="holiday-modal-card">
        <div class="delete-modal-copy">
            <div class="modal-icon success"><span class="material-symbols-outlined">restore</span></div>
            <div><h2 id="restore-modal-title">Restore holiday?</h2><p id="restore-modal-description">This holiday will become active again. Its date and pay multiplier will remain unchanged.</p></div>
        </div>
        <form asp-action="Restore" method="post" class="modal-actions" style="margin-top:24px">
            <input type="hidden" name="id" id="restore-holiday-id" />
            <button type="button" class="secondary-button" data-restore-close>Cancel</button>
            <button type="submit" class="primary-button">Confirm Restore</button>
        </form>
    </div>
</div>
