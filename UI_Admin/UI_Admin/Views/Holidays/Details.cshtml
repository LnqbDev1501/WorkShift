@model UI_Admin.Models.Holidays.HolidayItemViewModel
@using System.Globalization
@{ ViewData["Title"] = "Public Holiday Details"; }
@section Styles { <link rel="stylesheet" href="~/css/holidays.css" asp-append-version="true" /> }

<div class="holiday-shell">
<main class="holiday-page holiday-form-page">
    <div class="form-heading"><div><h1>@Model.HolidayName</h1><p>Calendar reservation and audit information for this public holiday.</p></div><div class="heading-actions"><a asp-action="List" asp-route-year="@Model.HolidayDate.Year" class="secondary-button"><span class="material-symbols-outlined">arrow_back</span>Back</a>@if (Model.IsActive) { <a asp-action="Edit" asp-route-id="@Model.PublicHolidayId" class="primary-button"><span class="material-symbols-outlined">edit</span>Edit holiday</a> }</div></div>
    @if (TempData["HolidayError"] is string error) { <div class="holiday-alert error"><span class="material-symbols-outlined">error</span><span>@error</span></div> }
    @if (!Model.IsActive)
    {
        <div class="heading-actions" style="margin-bottom:20px"><button type="button" class="primary-button" data-restore-open data-id="@Model.PublicHolidayId" data-name="@Model.HolidayName"><span class="material-symbols-outlined">restore</span>Restore holiday</button></div>
    }
    <div class="detail-workspace">
    <section class="holiday-detail-card">
        <header><span class="detail-icon material-symbols-outlined">event</span><div><span class="stat-label">Public holiday record #@Model.PublicHolidayId</span><h2>@Model.HolidayName</h2></div><span class="status @(Model.IsActive ? "active" : "inactive")"><i></i>@(Model.IsActive ? "Active" : "Inactive")</span></header>
        <div class="detail-grid">
            <div><span>Date</span><strong>@Model.HolidayDate.ToString("dddd, dd MMMM yyyy", CultureInfo.InvariantCulture)</strong></div>
            <div><span>Pay multiplier</span><strong>@Model.PayMultiplier.ToString("0.00")× base pay</strong></div>
            <div><span>Created</span><strong>@Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</strong></div>
            <div><span>Last updated</span><strong>@Model.UpdatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</strong></div>
        </div>
        @if (Model.CreatedBy.HasValue) { <footer>Created by: <code>@Model.CreatedBy</code></footer> }
    </section>
    <aside class="detail-side-card"><span class="material-symbols-outlined">calendar_month</span><span class="stat-label">Calendar status</span><h2>@Model.HolidayDate.Year statutory cycle</h2><p>This date is reserved permanently for schedule and payroll audit integrity.</p><div><span>Record state</span><strong>@(Model.IsActive ? "Active" : "Inactive")</strong></div><div><span>Reservation</span><strong>Locked</strong></div></aside>
    </div>
    @if (Model.IsActive)
    {
        <section class="danger-zone"><div><strong>Deactivate holiday</strong><p>The record becomes read-only and its date remains permanently reserved.</p></div><button type="button" data-delete-open data-id="@Model.PublicHolidayId" data-name="@Model.HolidayName"><span class="material-symbols-outlined">delete</span>Deactivate</button></section>
    }
</main>
</div>
<div class="holiday-modal" id="holiday-delete-modal" role="dialog" aria-modal="true" aria-labelledby="delete-modal-title" hidden>
    <div class="holiday-modal-card delete-modal-card">
        <div class="delete-modal-copy"><div class="modal-icon danger"><span class="material-symbols-outlined">warning</span></div><div><h2 id="delete-modal-title">Deactivate @Model.HolidayName?</h2><p id="delete-modal-description">Only this holiday will become inactive. Its date remains permanently reserved.</p></div></div>
        <div class="modal-reservation-note"><span class="material-symbols-outlined">lock</span><div><strong>Payroll and calendar protection</strong><p>The server will block deactivation if this holiday has already been used in payroll.</p></div></div>
        <form asp-action="Delete" method="post" id="holiday-delete-form" class="modal-actions">@Html.AntiForgeryToken()<input type="hidden" name="id" id="delete-holiday-id" value="@Model.PublicHolidayId" /><button type="button" class="secondary-button" data-delete-close>Cancel</button><button type="submit" class="danger-button">Confirm Deactivation</button></form>
    </div>
</div>
<partial name="_RestoreModal" />
@section Scripts { <script src="~/js/holidays.js" asp-append-version="true"></script> }
