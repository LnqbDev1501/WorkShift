@model UI_Admin.Models.Holidays.HolidayRuleViewModel
@{ ViewData["Title"] = Model.HolidayPayRuleId == 0 ? "Add Pay Rule" : "Pay Rule Details"; }
@section Styles { <link rel="stylesheet" href="~/css/holidays.css" asp-append-version="true" /> }
<div class="holiday-shell"><main class="holiday-page holiday-form-page">
    <div class="form-heading"><div><h1>@ViewData["Title"]</h1><p>Save a draft, then publish it when ready. Published rules are read-only.</p></div><a asp-action="Rules" class="secondary-button">Back to rules</a></div>
    <form asp-action="Rule" method="post">
        <input asp-for="HolidayPayRuleId" type="hidden" />
        <div asp-validation-summary="All" class="holiday-validation"></div>
        <section class="holiday-form-card"><div class="edit-fields">
            <label><span>Rule name *</span><input asp-for="RuleName" maxlength="150" readonly="@(!Model.CanEdit)" /></label>
            <label><span>Pay multiplier *</span><input asp-for="PayMultiplier" type="number" min="0.01" max="999.99" step="0.01" readonly="@(!Model.CanEdit)" /></label>
            <label><span>Effective from *</span><input asp-for="EffectiveFrom" type="date" min="@DateTime.UtcNow.AddHours(7).AddDays(1).ToString("yyyy-MM-dd")" readonly="@(!Model.CanEdit)" /></label>
        </div></section>
        <section class="holiday-form-note"><p>Drafts do not affect payroll. The effective date must be after today, both when saving and publishing, and follow the previous version. The end date is set automatically when a replacement becomes effective.</p></section>
        @if (Model.CanEdit) { <div class="form-actions"><button class="primary-button" type="submit">Save draft</button></div> }
        else { <p>This rule is read-only. Create a new version when the multiplier changes.</p> }
    </form>
    @if (Model.HolidayPayRuleId > 0) { <p>Status: <strong>@Model.StatusLabel</strong> · Effective to (exclusive): <strong>@(Model.EffectiveTo?.ToString("dd/MM/yyyy") ?? "Not set")</strong></p> }
    @if (Model.CanPublish) { <form asp-action="PublishRule" asp-route-id="@Model.HolidayPayRuleId" method="post" onsubmit="return confirm('Publish this saved draft? Its contents will be locked.');"><button type="submit" class="primary-button">Publish</button></form> }
    @if (Model.CanCancel) { <form asp-action="CancelRule" asp-route-id="@Model.HolidayPayRuleId" method="post" onsubmit="return confirm('Cancel this published rule?');"><button type="submit" class="danger-button">Cancel rule</button></form> }
    @if (Model.HolidayPayRuleId > 0 && Model.CanEdit) {
        <form asp-action="DeleteRule" asp-route-id="@Model.HolidayPayRuleId" method="post" onsubmit="return confirm('Delete this draft?');"><button class="danger-button" type="submit">Delete draft</button></form>
    }
@if (Model.Status == "ACTIVE") { <a asp-action="Rule" class="primary-button">Create new version</a> }
</main></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }


