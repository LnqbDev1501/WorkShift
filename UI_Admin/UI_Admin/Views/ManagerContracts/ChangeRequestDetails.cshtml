@model UI_Admin.Models.Manager.Contract.ManagerContractChangeRequestDetailViewModel
@{
    Layout = "_ManagerLayout";
    ViewData["Title"] = $"Yêu cầu thay đổi #{Model.ChangeRequestId}";
    var isSubmitted = string.Equals(Model.Status, "SUBMITTED", StringComparison.OrdinalIgnoreCase);
    var isApproved = string.Equals(Model.Status, "APPROVED", StringComparison.OrdinalIgnoreCase);
    var isRejected = string.Equals(Model.Status, "REJECTED", StringComparison.OrdinalIgnoreCase);
}

<div class="flex flex-col gap-6 max-w-6xl mx-auto">

    <!-- Top Navigation & Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-2 text-xs text-slate-500 mb-1.5">
                <a asp-action="ChangeRequests" class="hover:text-indigo-600 transition-colors flex items-center gap-1 font-medium">
                    <span class="material-symbols-outlined text-[16px]">arrow_back</span>
                    <span>Danh sách yêu cầu thay đổi</span>
                </a>
                <span>/</span>
                <span class="text-slate-800 font-semibold">Yêu cầu #@Model.ChangeRequestId</span>
            </div>
            <div class="flex items-center gap-3 flex-wrap">
                <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Chi tiết yêu cầu thay đổi hợp đồng</h1>
                @switch (Model.Status.ToUpperInvariant())
                {
                    case "SUBMITTED":
                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-amber-50 text-amber-700 border border-amber-200">
                            <span class="w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span>
                            Chờ Quản lý xử lý
                        </span>
                        break;
                    case "APPROVED":
                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                            Đã phê duyệt
                        </span>
                        break;
                    case "REJECTED":
                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-rose-50 text-rose-700 border border-rose-200">
                            <span class="w-2 h-2 rounded-full bg-rose-500"></span>
                            Đã từ chối
                        </span>
                        break;
                    default:
                        <span class="px-3 py-1 rounded-full text-xs font-bold bg-slate-100 text-slate-700">
                            @Model.Status
                        </span>
                        break;
                }
            </div>
        </div>

        <div class="flex items-center gap-2.5">
            <a asp-action="Details" asp-route-id="@Model.ContractId"
               class="inline-flex items-center gap-1.5 px-3.5 py-2 bg-white border border-slate-200 hover:bg-slate-50 text-slate-700 text-xs font-semibold rounded-xl shadow-sm transition-all">
                <span class="material-symbols-outlined text-[18px]">open_in_new</span>
                <span>Mở hợp đồng gốc (@Model.ContractNumber)</span>
            </a>
        </div>
    </div>

    <!-- Alert Notifications -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm flex items-center justify-between shadow-sm animate-fade-in">
            <div class="flex items-center gap-2.5">
                <span class="material-symbols-outlined text-emerald-600 text-[22px]">check_circle</span>
                <span>@TempData["SuccessMessage"]</span>
            </div>
            <button type="button" onclick="this.parentElement.remove()" class="text-emerald-500 hover:text-emerald-700 font-bold text-lg">&times;</button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-sm flex items-center justify-between shadow-sm animate-fade-in">
            <div class="flex items-center gap-2.5">
                <span class="material-symbols-outlined text-rose-600 text-[22px]">error</span>
                <span>@TempData["ErrorMessage"]</span>
            </div>
            <button type="button" onclick="this.parentElement.remove()" class="text-rose-500 hover:text-rose-700 font-bold text-lg">&times;</button>
        </div>
    }

    <!-- Overview Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        
        <!-- Contract Card -->
        <div class="bg-white rounded-2xl p-5 shadow-sm border border-slate-200 space-y-3">
            <div class="flex items-center gap-2.5 text-slate-900 font-bold text-sm border-b border-slate-100 pb-2.5">
                <span class="w-8 h-8 rounded-lg bg-indigo-50 text-indigo-600 flex items-center justify-center">
                    <span class="material-symbols-outlined text-[18px]">badge</span>
                </span>
                <span>Thông tin hợp đồng lao động</span>
            </div>
            <div class="grid grid-cols-2 gap-3 text-xs">
                <div>
                    <span class="text-slate-400 block mb-0.5">Mã hợp đồng:</span>
                    <span class="font-bold text-slate-800">@Model.ContractNumber</span>
                </div>
                <div>
                    <span class="text-slate-400 block mb-0.5">Trạng thái HĐ:</span>
                    <span class="font-semibold text-slate-700">@(Model.ContractStatus ?? "N/A")</span>
                </div>
                <div>
                    <span class="text-slate-400 block mb-0.5">Nhân viên:</span>
                    <span class="font-bold text-slate-900">@Model.StaffFullName</span>
                </div>
                <div>
                    <span class="text-slate-400 block mb-0.5">Chi nhánh:</span>
                    <span class="font-semibold text-slate-800">@(Model.BranchName ?? "Chi nhánh quản lý")</span>
                </div>
                <div>
                    <span class="text-slate-400 block mb-0.5">Phiên bản hiện tại:</span>
                    <span class="font-mono font-semibold text-slate-700">@(Model.ContractTemplateVersion ?? "1.0")</span>
                </div>
                <div>
                    <span class="text-slate-400 block mb-0.5">Mức lương hiện tại:</span>
                    <span class="font-bold text-emerald-700">@(Model.CurrentHourlyRate?.ToString("#,##0") ?? "0") VNĐ/giờ</span>
                </div>
            </div>
        </div>

        <!-- Request Summary Card -->
        <div class="bg-white rounded-2xl p-5 shadow-sm border border-slate-200 space-y-3">
            <div class="flex items-center gap-2.5 text-slate-900 font-bold text-sm border-b border-slate-100 pb-2.5">
                <span class="w-8 h-8 rounded-lg bg-amber-50 text-amber-600 flex items-center justify-center">
                    <span class="material-symbols-outlined text-[18px]">mark_chat_unread</span>
                </span>
                <span>Thông tin từ nhân viên gửi</span>
            </div>
            <div class="space-y-2 text-xs">
                <div class="flex justify-between">
                    <span class="text-slate-400">Thời điểm gửi yêu cầu:</span>
                    <span class="font-medium text-slate-700 tabular-nums">
                        @(Model.SubmittedAt?.ToString("dd/MM/yyyy HH:mm") ?? Model.CreatedAt.ToString("dd/MM/yyyy HH:mm"))
                    </span>
                </div>
                <div class="flex justify-between">
                    <span class="text-slate-400">Loại yêu cầu:</span>
                    <span class="font-semibold text-slate-800">@Model.RequestType</span>
                </div>
                <div class="pt-2 border-t border-slate-100">
                    <span class="text-slate-500 font-semibold block mb-1">Ghi chú / Ý kiến nhân viên:</span>
                    <div class="p-3 bg-slate-50 rounded-xl border border-slate-100 text-slate-700 text-xs italic">
                        @(string.IsNullOrWhiteSpace(Model.StaffComment) ? "Nhân viên không để lại ghi chú thêm." : Model.StaffComment)
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Review Status Banner (if already reviewed) -->
    @if (!isSubmitted)
    {
        <div class="p-4 rounded-2xl border @(isApproved ? "bg-emerald-50/70 border-emerald-200 text-emerald-900" : "bg-rose-50/70 border-rose-200 text-rose-900") flex items-start gap-3 text-xs">
            <span class="material-symbols-outlined @(isApproved ? "text-emerald-600" : "text-rose-600") text-[24px] shrink-0 mt-0.5">
                @(isApproved ? "verified" : "cancel")
            </span>
            <div class="space-y-1">
                <div class="font-bold text-sm">
                    @(isApproved ? "Yêu cầu thay đổi đã được bạn phê duyệt" : "Yêu cầu thay đổi đã bị từ chối")
                </div>
                <div>
                    <span>Thời điểm xử lý: <strong>@(Model.ReviewedAt?.ToString("dd/MM/yyyy HH:mm") ?? "N/A")</strong></span>
                    @if (!string.IsNullOrEmpty(Model.ReviewedByName))
                    {
                        <span class="ml-2">· Người xử lý: <strong>@Model.ReviewedByName</strong></span>
                    }
                </div>
                @if (!string.IsNullOrEmpty(Model.ReviewComment))
                {
                    <div class="pt-1">
                        <span>Ý kiến / Lý do: </span>
                        <span class="font-semibold italic">"@Model.ReviewComment"</span>
                    </div>
                }
            </div>
        </div>
    }

    <!-- Comparison & Decision Form -->
    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
        <div class="p-5 border-b border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
            <div>
                <h2 class="text-base font-bold text-slate-900">Bảng so sánh điều khoản & Giá trị chốt áp dụng</h2>
                <p class="text-xs text-slate-500 mt-0.5">
                    So sánh giá trị hiện tại với đề xuất của nhân viên. Quản lý có thể điều chỉnh giá trị cuối cùng sẽ áp dụng vào hợp đồng mới trước khi phê duyệt.
                </p>
            </div>
            @if (isSubmitted)
            {
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg text-xs font-semibold bg-indigo-50 text-indigo-700 border border-indigo-200 shrink-0">
                    <span class="material-symbols-outlined text-[16px]">edit_note</span>
                    <span>Có thể chỉnh sửa giá trị chốt</span>
                </span>
            }
        </div>

        @if (isSubmitted)
        {
            <form id="approveForm" method="post" asp-action="ApproveChangeRequest" asp-route-id="@Model.ChangeRequestId">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ChangeRequestId" value="@Model.ChangeRequestId" />

                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse text-xs">
                        <thead>
                            <tr class="bg-slate-50/80 border-b border-slate-200 text-slate-500 font-semibold uppercase tracking-wider text-[11px]">
                                <th class="py-3 px-4 w-44">Trường Thông Tin</th>
                                <th class="py-3 px-4 w-48">Giá Trị Hiện Tại</th>
                                <th class="py-3 px-4 w-56">Giá Trị Staff Đề Xuất</th>
                                <th class="py-3 px-4">Lý Do Đề Xuất</th>
                                <th class="py-3 px-4 w-64 bg-indigo-50/40 text-indigo-900 font-bold">
                                    <div class="flex items-center gap-1">
                                        <span class="material-symbols-outlined text-[16px] text-indigo-600">done_all</span>
                                        <span>Giá Trị Manager Chốt</span>
                                    </div>
                                </th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            @for (int i = 0; i < Model.Items.Count; i++)
                            {
                                var item = Model.Items[i];
                                <tr class="hover:bg-slate-50/60 transition-colors">
                                    <td class="py-4 px-4 font-bold text-slate-800">
                                        @item.FieldNameDisplay
                                        <input type="hidden" name="Items[@i].FieldName" value="@item.FieldName" />
                                    </td>
                                    <td class="py-4 px-4 text-slate-500 font-medium">
                                        @if (string.IsNullOrWhiteSpace(item.OriginalValue))
                                        {
                                            <span class="text-slate-300 italic">Chưa xác định</span>
                                        }
                                        else
                                        {
                                            <span class="px-2.5 py-1 rounded bg-slate-100 font-mono text-slate-700">@item.OriginalValue</span>
                                        }
                                    </td>
                                    <td class="py-4 px-4">
                                        <span class="px-2.5 py-1 rounded-md bg-blue-50 text-blue-700 font-mono font-bold border border-blue-200">
                                            @item.ProposedValue
                                        </span>
                                    </td>
                                    <td class="py-4 px-4 text-slate-600 italic">
                                        @(string.IsNullOrWhiteSpace(item.Reason) ? "—" : item.Reason)
                                    </td>
                                    <td class="py-3 px-4 bg-indigo-50/20">
                                        @if (string.Equals(item.FieldName, "ContractTerms", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <textarea name="Items[@i].FinalValue" rows="2"
                                                      class="w-full px-2.5 py-1.5 bg-white border border-indigo-200 rounded-lg text-xs text-slate-800 font-medium focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-600 outline-none">@item.FinalValue</textarea>
                                        }
                                        else
                                        {
                                            <input type="text" name="Items[@i].FinalValue" value="@item.FinalValue"
                                                   class="w-full h-8 px-2.5 bg-white border border-indigo-200 rounded-lg text-xs text-slate-800 font-bold focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-600 outline-none" />
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Approval Review Comment & Buttons Area -->
                <div class="p-5 bg-slate-50/60 border-t border-slate-200 space-y-4">
                    <div>
                        <label class="block font-semibold text-slate-700 text-xs mb-1">
                            Ý kiến phản hồi của Quản lý gửi nhân viên <span class="text-slate-400 font-normal">(Tùy chọn)</span>
                        </label>
                        <textarea name="ReviewComment" rows="2" placeholder="Ví dụ: Đã xem xét nguyện vọng và duyệt điều chỉnh mức lương theo đề xuất..."
                                  class="w-full px-3 py-2 bg-white border border-slate-200 rounded-xl text-xs text-slate-800 focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-600 outline-none"></textarea>
                    </div>

                    <div class="flex flex-col sm:flex-row items-center justify-between gap-3 pt-2 border-t border-slate-200">
                        <div class="text-[11px] text-slate-500 flex items-center gap-1.5">
                            <span class="material-symbols-outlined text-[16px] text-amber-500">info</span>
                            <span>Khi duyệt: Hợp đồng sẽ tạo phiên bản mới, cập nhật giá trị chốt và gửi lại để nhân viên chấp thuận. Bản PDF cũ vẫn được bảo lưu an toàn.</span>
                        </div>

                        <div class="flex items-center gap-3 w-full sm:w-auto justify-end">
                            <button type="button" onclick="openRejectModal()"
                                    class="px-4 py-2 text-xs font-semibold text-rose-700 bg-rose-50 hover:bg-rose-100 border border-rose-200 rounded-xl transition-all">
                                <span class="inline-flex items-center gap-1">
                                    <span class="material-symbols-outlined text-[16px]">close</span>
                                    <span>Từ chối yêu cầu</span>
                                </span>
                            </button>
                            <button type="button" onclick="openConfirmApproveModal()"
                                    class="px-5 py-2 text-xs font-bold text-white bg-indigo-600 hover:bg-indigo-700 rounded-xl shadow-sm transition-all">
                                <span class="inline-flex items-center gap-1.5">
                                    <span class="material-symbols-outlined text-[18px]">verified</span>
                                    <span>Phê duyệt & Áp dụng</span>
                                </span>
                            </button>
                        </div>
                    </div>
                </div>
            </form>
        }
        else
        {
            <!-- Read-only table when already reviewed -->
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse text-xs">
                    <thead>
                        <tr class="bg-slate-50/80 border-b border-slate-200 text-slate-500 font-semibold uppercase tracking-wider text-[11px]">
                            <th class="py-3 px-4">Trường Thông Tin</th>
                            <th class="py-3 px-4">Giá Trị Trước Đó</th>
                            <th class="py-3 px-4">Giá Trị Nhân Viên Đề Xuất</th>
                            <th class="py-3 px-4">Lý Do Đề Xuất</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @foreach (var item in Model.Items)
                        {
                            <tr class="hover:bg-slate-50/60 transition-colors">
                                <td class="py-3.5 px-4 font-bold text-slate-800">@item.FieldNameDisplay</td>
                                <td class="py-3.5 px-4 font-mono text-slate-500">@(string.IsNullOrWhiteSpace(item.OriginalValue) ? "—" : item.OriginalValue)</td>
                                <td class="py-3.5 px-4 font-mono font-bold text-blue-700">@item.ProposedValue</td>
                                <td class="py-3.5 px-4 text-slate-600 italic">@(string.IsNullOrWhiteSpace(item.Reason) ? "—" : item.Reason)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- Modal Xác nhận Phê duyệt -->
<div id="confirmApproveModal" class="hidden fixed inset-0 z-50 overflow-y-auto bg-black/50 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-md w-full p-6 space-y-4 shadow-xl border border-slate-100 animate-scale-in">
        <div class="flex items-center gap-3">
            <span class="w-10 h-10 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center shrink-0">
                <span class="material-symbols-outlined text-[24px]">verified</span>
            </span>
            <div>
                <h3 class="text-base font-bold text-slate-900">Xác nhận phê duyệt yêu cầu</h3>
                <p class="text-xs text-slate-500">Áp dụng giá trị Manager chốt vào hợp đồng mới.</p>
            </div>
        </div>

        <p class="text-xs text-slate-600 leading-relaxed">
            Hệ thống sẽ cập nhật thông tin hợp đồng theo các giá trị bạn đã chốt, tạo phiên bản hợp đồng mẫu kế tiếp, tạo file PDF mới và gửi cho nhân viên <strong>@Model.StaffFullName</strong> để chấp thuận.
        </p>

        <div class="flex items-center justify-end gap-2.5 pt-2">
            <button type="button" onclick="closeConfirmApproveModal()"
                    class="px-4 py-2 text-xs font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 rounded-xl transition-colors">
                Hủy bỏ
            </button>
            <button type="button" onclick="submitApproveForm()"
                    class="px-4 py-2 text-xs font-bold text-white bg-indigo-600 hover:bg-indigo-700 rounded-xl shadow-sm transition-colors">
                Xác nhận phê duyệt
            </button>
        </div>
    </div>
</div>

<!-- Modal Từ chối yêu cầu (bắt buộc nhập lý do) -->
<div id="rejectModal" class="hidden fixed inset-0 z-50 overflow-y-auto bg-black/50 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-md w-full p-6 space-y-4 shadow-xl border border-slate-100 animate-scale-in">
        <div class="flex items-center gap-3">
            <span class="w-10 h-10 rounded-xl bg-rose-50 text-rose-600 flex items-center justify-center shrink-0">
                <span class="material-symbols-outlined text-[24px]">cancel</span>
            </span>
            <div>
                <h3 class="text-base font-bold text-slate-900">Từ chối yêu cầu thay đổi</h3>
                <p class="text-xs text-slate-500">Vui lòng cung cấp lý do từ chối rõ ràng cho nhân viên.</p>
            </div>
        </div>

        <form id="rejectForm" method="post" asp-action="RejectChangeRequest" asp-route-id="@Model.ChangeRequestId" class="space-y-3 text-xs">
            @Html.AntiForgeryToken()
            <input type="hidden" name="ChangeRequestId" value="@Model.ChangeRequestId" />

            <div>
                <label class="block font-semibold text-slate-700 mb-1">
                    Lý do từ chối <span class="text-rose-500">*</span>
                </label>
                <textarea name="Reason" rows="3" required placeholder="Nhập lý do không thể chấp thuận thay đổi..."
                          class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs text-slate-800 focus:bg-white focus:ring-2 focus:ring-rose-500/20 focus:border-rose-500 outline-none"></textarea>
            </div>

            <div class="flex items-center justify-end gap-2.5 pt-2">
                <button type="button" onclick="closeRejectModal()"
                        class="px-4 py-2 text-xs font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 rounded-xl transition-colors">
                    Hủy bỏ
                </button>
                <button type="submit"
                        class="px-4 py-2 text-xs font-bold text-white bg-rose-600 hover:bg-rose-700 rounded-xl shadow-sm transition-colors">
                    Xác nhận từ chối
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function openConfirmApproveModal() {
            document.getElementById('confirmApproveModal').classList.remove('hidden');
        }
        function closeConfirmApproveModal() {
            document.getElementById('confirmApproveModal').classList.add('hidden');
        }
        function submitApproveForm() {
            closeConfirmApproveModal();
            document.getElementById('approveForm').submit();
        }

        function openRejectModal() {
            document.getElementById('rejectModal').classList.remove('hidden');
        }
        function closeRejectModal() {
            document.getElementById('rejectModal').classList.add('hidden');
        }
    </script>
}
