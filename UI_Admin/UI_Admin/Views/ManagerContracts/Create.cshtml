@model UI_Admin.Models.Manager.Contract.CreateContractViewModel
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    Layout = "_ManagerLayout";
    ViewData["Title"] = "Create Employment Contract";
    var isRenewal = string.Equals(Model.ContractType, "RENEWAL", StringComparison.OrdinalIgnoreCase);
    var missingSelection = Model.StaffUserId.HasValue && !Model.StaffOptions.Any(s => s.StaffUserId == Model.StaffUserId);
}
<div class="flex items-center gap-3 mb-2">
    <i data-lucide="file-plus" class="text-indigo-600"></i>
    <h1 class="text-2xl font-bold">Create Employment Contract</h1>
</div>
<p class="text-slate-600 mb-6">Create a new contract for fresh staff or initiate a renewal/replacement contract for staff in your branch.</p>

<form asp-action="Create" method="post" id="contract-form" class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 sm:p-8 space-y-6">
    <div asp-validation-summary="All" role="alert" class="rounded-xl bg-rose-50 border border-rose-200 p-4 text-rose-700 text-sm"></div>

    <!-- Mode Selector: New vs Renewal -->
    <div class="space-y-2.5">
        <div class="flex items-center justify-between">
            <label class="text-xs font-bold uppercase tracking-wider text-slate-700">
                Contract Creation Mode <span class="text-rose-600">*</span>
            </label>
            <span class="text-[11px] text-slate-400">Select contract mode for staff filtering</span>
        </div>
        <div class="grid sm:grid-cols-2 gap-4">
            <!-- New Contract Card -->
            <label class="relative flex items-start gap-4 p-5 rounded-2xl border-2 cursor-pointer transition-all duration-200 group @(!isRenewal ? "border-indigo-600 bg-gradient-to-br from-indigo-50/70 via-white to-indigo-50/20 shadow-md shadow-indigo-100/50 ring-4 ring-indigo-600/10" : "border-slate-200 bg-white hover:border-slate-300 hover:shadow-sm")" id="label-mode-new">
                <input type="radio" asp-for="ContractType" value="NEW" class="sr-only" id="radio-mode-new" checked="@(!isRenewal)" />

                <div class="w-12 h-12 rounded-xl flex items-center justify-center shrink-0 transition-all duration-200 @(!isRenewal ? "bg-indigo-600 text-white shadow-sm shadow-indigo-300 scale-105" : "bg-slate-100 text-slate-500 group-hover:bg-slate-200")" id="icon-box-new">
                    <span class="material-symbols-outlined text-[26px]">person_add</span>
                </div>

                <div class="flex-1 min-w-0 pr-6">
                    <div class="flex items-center gap-2 mb-1 flex-wrap">
                        <span class="font-bold text-slate-900 text-sm group-hover:text-indigo-600 transition-colors">New Contract</span>
                        <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold tracking-wide uppercase bg-emerald-50 text-emerald-700 border border-emerald-200/60">
                            First-Time Hire
                        </span>
                    </div>
                    <p class="text-xs text-slate-500 leading-relaxed">
                        For new staff members who have never had an employment contract in the system.
                    </p>
                </div>

                <!-- Custom Check Indicator -->
                <div class="absolute top-4 right-4 w-5 h-5 rounded-full border-2 flex items-center justify-center transition-all duration-200 @(!isRenewal ? "border-indigo-600 bg-indigo-600 text-white shadow-sm" : "border-slate-300 bg-white text-transparent")" id="indicator-new">
                    <span class="material-symbols-outlined text-[13px] font-bold">check</span>
                </div>
            </label>

            <!-- Renewal / Replacement Card -->
            <label class="relative flex items-start gap-4 p-5 rounded-2xl border-2 cursor-pointer transition-all duration-200 group @(isRenewal ? "border-indigo-600 bg-gradient-to-br from-indigo-50/70 via-white to-indigo-50/20 shadow-md shadow-indigo-100/50 ring-4 ring-indigo-600/10" : "border-slate-200 bg-white hover:border-slate-300 hover:shadow-sm")" id="label-mode-renewal">
                <input type="radio" asp-for="ContractType" value="RENEWAL" class="sr-only" id="radio-mode-renewal" checked="@isRenewal" />

                <div class="w-12 h-12 rounded-xl flex items-center justify-center shrink-0 transition-all duration-200 @(isRenewal ? "bg-indigo-600 text-white shadow-sm shadow-indigo-300 scale-105" : "bg-slate-100 text-slate-500 group-hover:bg-slate-200")" id="icon-box-renewal">
                    <span class="material-symbols-outlined text-[26px]">autorenew</span>
                </div>

                <div class="flex-1 min-w-0 pr-6">
                    <div class="flex items-center gap-2 mb-1 flex-wrap">
                        <span class="font-bold text-slate-900 text-sm group-hover:text-indigo-600 transition-colors">Renewal / Replacement</span>
                        <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold tracking-wide uppercase bg-indigo-50 text-indigo-700 border border-indigo-200/60">
                            Branch Staff
                        </span>
                    </div>
                    <p class="text-xs text-slate-500 leading-relaxed">
                        For staff currently in your branch who had a prior contract that needs to be renewed or replaced.
                    </p>
                </div>

                <!-- Custom Check Indicator -->
                <div class="absolute top-4 right-4 w-5 h-5 rounded-full border-2 flex items-center justify-center transition-all duration-200 @(isRenewal ? "border-indigo-600 bg-indigo-600 text-white shadow-sm" : "border-slate-300 bg-white text-transparent")" id="indicator-renewal">
                    <span class="material-symbols-outlined text-[13px] font-bold">check</span>
                </div>
            </label>
        </div>
        <input type="hidden" asp-for="ReplacesContractId" id="ReplacesContractId" />
    </div>

    <!-- Staff Selection -->
    <div>
        <label asp-for="StaffUserId" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-1.5">
            <span id="staff-select-label">@(isRenewal ? "Staff for Renewal" : "New Staff")</span> <span class="text-rose-600">*</span>
        </label>
        <select asp-for="StaffUserId" id="StaffUserId" required class="w-full h-11 px-3.5 rounded-xl border border-slate-300 text-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 cursor-pointer">
            <option value="">-- Select Staff Member --</option>
            @foreach (var opt in Model.StaffOptions)
            {
                var isSelected = Model.StaffUserId == opt.StaffUserId;
                string display;
                if (isRenewal && !string.IsNullOrEmpty(opt.CurrentContractNumber))
                {
                    var badge = opt.ExpirationCategory switch
                    {
                        "EXPIRED" => $"🔴 Expired ({Math.Abs(opt.DaysUntilExpiration ?? 0)}d ago)",
                        "URGENT" => $"🔴 Expires in {opt.DaysUntilExpiration}d",
                        "UPCOMING" => $"🟡 Expires in {opt.DaysUntilExpiration}d",
                        "LONG_TERM" => $"🟢 Active ({opt.DaysUntilExpiration}d left)",
                        "INDEFINITE" => "🟢 Active (Indefinite)",
                        _ => "Active"
                    };
                    display = $"{badge} • {opt.FullName} ({opt.CurrentContractNumber}{(string.IsNullOrEmpty(opt.CurrentPosition) ? "" : $" - {opt.CurrentPosition}")})";
                }
                else
                {
                    display = string.IsNullOrEmpty(opt.CurrentPosition) ? opt.FullName : $"{opt.FullName} ({opt.CurrentPosition})";
                }
                <option value="@opt.StaffUserId"
                        data-contract-id="@(opt.CurrentContractId?.ToString() ?? "")"
                        data-contract-number="@(opt.CurrentContractNumber ?? "")"
                        data-position="@(opt.CurrentPosition ?? "")"
                        data-start-date="@(opt.CurrentStartDate?.ToString("yyyy-MM-dd") ?? "")"
                        data-end-date="@(opt.CurrentEndDate?.ToString("yyyy-MM-dd") ?? "")"
                        data-hourly-rate="@(opt.CurrentHourlyRate?.ToString("N0") ?? "")"
                        data-hourly-rate-raw="@(opt.CurrentHourlyRate?.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) ?? "")"
                        data-contract-terms="@(opt.CurrentContractTerms ?? "")"
                        data-days-left="@(opt.DaysUntilExpiration?.ToString() ?? "")"
                        data-category="@(opt.ExpirationCategory ?? "")"
                        selected="@isSelected">
                    @display
                </option>
            }
            @if (missingSelection)
            {
                <option value="@Model.StaffUserId" selected>Selected staff is no longer available (@Model.StaffUserId)</option>
            }
        </select>
        <span asp-validation-for="StaffUserId" class="text-xs text-rose-600 mt-1 block"></span>
        <p id="staff-help-text" class="text-xs text-slate-500 mt-1.5">
            @(isRenewal
                ? "Only displaying staff belonging to your branch who previously had an employment contract."
                : "Only displaying staff without an active contract (including new staff or staff whose previous contract was cancelled/expired). Branch and minimum wage will follow your managed branch.")
        </p>
        <div id="no-staff-warning" class="text-amber-700 text-xs mt-1.5 @(Model.StaffOptions.Count > 0 ? "hidden" : "")">
            No eligible staff members available for this mode.
        </div>
    </div>

    <!-- Smart Guidance & Current Contract Snapshot Card (Renewal Mode) -->
    <div id="renewal-guidance-card" class="hidden rounded-2xl border transition-all duration-200 overflow-hidden bg-slate-50 border-slate-200">
        <div class="p-5 space-y-4">
            <!-- Header with Badge -->
            <div class="flex flex-wrap items-center justify-between gap-3">
                <div class="flex items-center gap-2.5">
                    <div id="guidance-icon-box" class="w-9 h-9 rounded-xl flex items-center justify-center shrink-0 shadow-sm bg-indigo-100 text-indigo-700">
                        <span id="guidance-icon" class="material-symbols-outlined text-[20px]">smart_toy</span>
                    </div>
                    <div>
                        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-500">Current Contract Snapshot</h4>
                        <span id="guidance-status-badge" class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold">
                            <!-- Populated dynamically -->
                        </span>
                    </div>
                </div>

                <!-- Quick Apply Button -->
                <button type="button" id="btn-apply-suggested-date" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-semibold bg-white border border-slate-300 shadow-sm hover:border-indigo-400 hover:text-indigo-600 hover:bg-indigo-50/50 transition-all cursor-pointer">
                    <span class="material-symbols-outlined text-[16px] text-amber-500">bolt</span>
                    <span id="btn-apply-suggested-date-text">Apply Suggested Start Date</span>
                </button>
            </div>

            <!-- 4 Metrics Grid -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
                <div class="bg-white/80 p-3 rounded-xl border border-slate-200/80 shadow-2xs">
                    <span class="text-[10px] uppercase font-bold text-slate-400 tracking-wider block">Contract No.</span>
                    <span id="snapshot-contract-number" class="text-xs font-semibold text-slate-800 break-all font-mono">--</span>
                </div>
                <div class="bg-white/80 p-3 rounded-xl border border-slate-200/80 shadow-2xs">
                    <span class="text-[10px] uppercase font-bold text-slate-400 tracking-wider block">Position</span>
                    <span id="snapshot-position" class="text-xs font-semibold text-slate-800 truncate block">--</span>
                </div>
                <div class="bg-white/80 p-3 rounded-xl border border-slate-200/80 shadow-2xs">
                    <span class="text-[10px] uppercase font-bold text-slate-400 tracking-wider block">Current Wage (History)</span>
                    <span id="snapshot-hourly-rate" class="text-xs font-semibold text-slate-800">--</span>
                </div>
                <div class="bg-white/80 p-3 rounded-xl border border-slate-200/80 shadow-2xs">
                    <span class="text-[10px] uppercase font-bold text-slate-400 tracking-wider block">Validity Term</span>
                    <span id="snapshot-term" class="text-xs font-semibold text-slate-800">--</span>
                </div>
            </div>

            <!-- Guidance Message Box -->
            <div id="guidance-message-box" class="p-3.5 rounded-xl text-xs leading-relaxed flex items-start gap-2.5">
                <span class="material-symbols-outlined text-[18px] shrink-0 mt-0.5">info</span>
                <p id="guidance-message-text" class="text-xs"></p>
            </div>
        </div>
    </div>

    <!-- Contract Period -->
    <div class="grid sm:grid-cols-2 gap-5">
        <div>
            <div class="flex items-center justify-between mb-1.5">
                <label asp-for="StartDate" class="block text-xs font-semibold uppercase tracking-wider text-slate-700">Start Date <span class="text-rose-600">*</span></label>
                <span id="start-date-tip" class="text-[11px] font-medium text-indigo-600 hidden"></span>
            </div>
            <input asp-for="StartDate" id="StartDate" type="date" asp-format="{0:yyyy-MM-dd}" required class="w-full h-11 px-3.5 rounded-xl border border-slate-300 text-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" />
            <span asp-validation-for="StartDate" class="text-xs text-rose-600 mt-1 block"></span>
            <p id="start-date-guidance-note" class="text-[11px] text-slate-500 mt-1"></p>
        </div>
        <div>
            <label asp-for="EndDate" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-1.5">End Date</label>
            <input asp-for="EndDate" id="EndDate" type="date" asp-format="{0:yyyy-MM-dd}" class="w-full h-11 px-3.5 rounded-xl border border-slate-300 text-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" />
            <span asp-validation-for="EndDate" class="text-xs text-rose-600 mt-1 block"></span>
            <p class="text-[11px] text-slate-400 mt-1">Leave blank for an indefinite-term contract.</p>
        </div>
    </div>

    <!-- Position & Hourly Rate -->
    <div class="grid sm:grid-cols-2 gap-5">
        <div>
            <div class="flex items-center justify-between mb-1.5">
                <label asp-for="EmployeePosition" class="block text-xs font-semibold uppercase tracking-wider text-slate-700">
                    Position / Title <span class="text-rose-600">*</span>
                </label>
                <span class="text-[11px] text-emerald-600 font-medium flex items-center gap-1">
                    <span class="material-symbols-outlined text-[14px]">lock</span>
                    Auto-retrieved from User
                </span>
            </div>
            <div class="relative">
                <input asp-for="EmployeePosition" id="EmployeePosition" type="text" readonly required
                       placeholder="Auto-filled when staff is selected..."
                       class="w-full h-11 px-3.5 pr-10 rounded-xl border border-slate-200 bg-slate-50 text-slate-800 text-sm font-semibold focus:outline-none cursor-not-allowed select-none transition-colors" />
                <span class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none text-slate-400">
                    <span class="material-symbols-outlined text-[20px]">badge</span>
                </span>
            </div>
            <span asp-validation-for="EmployeePosition" class="text-xs text-rose-600 mt-1 block"></span>
            <p id="position-guidance-note" class="text-[11px] text-slate-500 mt-1">
                Position is retrieved automatically from the employee's assigned position when user was created.
            </p>
        </div>
        <div>
            <div class="flex items-center justify-between mb-1.5">
                <label asp-for="HourlyRate" class="block text-xs font-semibold uppercase tracking-wider text-slate-700">Hourly Rate (VND/h)</label>
                <span id="wage-source-badge" class="text-[11px] @(!isRenewal ? "text-indigo-600 font-medium" : "text-emerald-600 font-medium")">
                    @(!isRenewal ? "Regional min wage" : "History salary")
                </span>
            </div>
            <div class="relative">
                <input asp-for="HourlyRate" id="HourlyRate" type="number" step="1000" min="0" placeholder="e.g. 25000" class="w-full h-11 px-3.5 pr-14 rounded-xl border border-slate-300 text-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 font-mono" />
                <span class="absolute inset-y-0 right-0 flex items-center pr-3.5 pointer-events-none text-xs font-medium text-slate-400">VND/h</span>
            </div>
            <span asp-validation-for="HourlyRate" class="text-xs text-rose-600 mt-1 block"></span>
            <p id="hourly-rate-guidance-note" class="text-[11px] text-slate-500 mt-1">
                @(!isRenewal ? "Auto-filled with regional minimum wage (can be adjusted)." : "Auto-filled from staff salary history (can be adjusted).")
            </p>
            <input type="hidden" id="regional-minimum-wage-data" value="@(Model.RegionalMinimumWage > 0 ? Model.RegionalMinimumWage.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) : "")" />
        </div>
    </div>

    <!-- Terms -->
    <div>
        <label asp-for="ContractTerms" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-1.5">Contract Terms</label>
        <textarea asp-for="ContractTerms" id="ContractTerms" rows="5" placeholder="Enter additional agreed contract terms (optional)..." class="w-full p-3.5 rounded-xl border border-slate-300 text-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"></textarea>
    </div>

    <!-- Info Note -->
    <div class="rounded-xl bg-indigo-50/70 border border-indigo-100 text-indigo-900 p-4 text-xs flex gap-3 items-start">
        <span class="material-symbols-outlined text-indigo-600 text-[20px] shrink-0 mt-0.5">info</span>
        <div class="space-y-1 leading-relaxed">
            <p class="font-bold text-indigo-950">Branch & Minimum Wage Policy:</p>
            <p>The contract automatically adopts the branch, region, and regional minimum wage of your managed branch upon start date. The contract will be saved in DRAFT status. The staff's branch assignment will be finalized when the contract becomes active.</p>
        </div>
    </div>

    <!-- Actions -->
    <div class="flex flex-col-reverse sm:flex-row justify-end gap-3 border-t border-slate-100 pt-5">
        <a asp-action="Index" class="px-5 py-2.5 rounded-xl border border-slate-200 text-slate-600 hover:bg-slate-100 text-sm font-semibold transition-colors text-center">Cancel</a>
        <button type="submit" id="save-contract" class="px-6 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold shadow-sm transition-all cursor-pointer disabled:opacity-50" disabled="@(Model.StaffOptions.Count == 0)">
            Save Draft
        </button>
    </div>
</form>

@section Scripts {
<script src="~/js/manager-contract-create.js" asp-append-version="true"></script>
}
