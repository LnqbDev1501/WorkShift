@model UI_Admin.Models.Manager.EditContractViewModel
@{
    Layout = "_ManagerLayout";
    ViewData["Title"] = $"Edit Contract {Model.ContractNumber}";
}

<div class="flex flex-col gap-6 max-w-3xl mx-auto">

    <!-- Top Navigation Header -->
    <div class="flex items-center gap-3">
        <a asp-action="Details" asp-route-id="@Model.ContractId"
           class="inline-flex items-center justify-center w-10 h-10 rounded-xl bg-white border border-slate-200 hover:bg-slate-100 text-slate-700 transition-colors shrink-0"
           title="Back to details">
            <span class="material-symbols-outlined text-[20px]">arrow_back</span>
        </a>
        <div>
            <div class="flex items-center gap-2">
                <h1 class="text-xl sm:text-2xl font-bold text-slate-900 tracking-tight">Edit Draft Contract</h1>
                <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-50 text-amber-700 border border-amber-200">
                    <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>Draft
                </span>
            </div>
            <p class="font-mono text-xs text-slate-500 mt-0.5">@Model.ContractNumber</p>
        </div>
    </div>

    <!-- Read-only Contract Context Banner -->
    <div class="bg-white rounded-2xl p-5 shadow-sm border border-slate-200 grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs">
        <div>
            <span class="text-slate-400 uppercase font-semibold text-[10px] tracking-wider block">Staff Member</span>
            <span class="text-sm font-bold text-slate-800 mt-0.5 block">@Model.EmployeeFullName</span>
        </div>
        <div>
            <span class="text-slate-400 uppercase font-semibold text-[10px] tracking-wider block">Branch & Region</span>
            <span class="text-sm font-semibold text-slate-800 mt-0.5 block">@Model.BranchName (@Model.RegionName)</span>
        </div>
        <div>
            <span class="text-slate-400 uppercase font-semibold text-[10px] tracking-wider block">Current Hourly Rate</span>
            <span class="text-sm font-bold text-indigo-600 mt-0.5 block tabular-nums">@Model.CurrentHourlyRate.ToString("N0") VND/hr</span>
        </div>
    </div>

    <!-- Edit Form -->
    <form asp-action="Edit" asp-route-id="@Model.ContractId" method="post" id="contract-form" class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 sm:p-8 space-y-6">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="All" role="alert" class="rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-sm p-4"></div>

        <div class="grid sm:grid-cols-2 gap-5">
            <div>
                <label asp-for="StartDate" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-1.5">
                    Start Date <span class="text-rose-600">*</span>
                </label>
                <input asp-for="StartDate" type="date" asp-format="{0:yyyy-MM-dd}" required
                       class="w-full h-11 px-3.5 rounded-xl border border-slate-300 text-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" />
                <span asp-validation-for="StartDate" class="text-xs text-rose-600 mt-1 block"></span>
            </div>
            <div>
                <label asp-for="EndDate" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-1.5">
                    End Date
                </label>
                <input asp-for="EndDate" type="date" asp-format="{0:yyyy-MM-dd}"
                       class="w-full h-11 px-3.5 rounded-xl border border-slate-300 text-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" />
                <span asp-validation-for="EndDate" class="text-xs text-rose-600 mt-1 block"></span>
                <p class="text-[11px] text-slate-400 mt-1">Leave blank for an indefinite-term contract.</p>
            </div>
        </div>

        <div>
            <label asp-for="EmployeePosition" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-1.5">
                Position / Title <span class="text-rose-600">*</span>
            </label>
            <input asp-for="EmployeePosition" maxlength="100" required placeholder="e.g. Cashier or Waiter"
                   class="w-full h-11 px-3.5 rounded-xl border border-slate-300 text-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" />
            <span asp-validation-for="EmployeePosition" class="text-xs text-rose-600 mt-1 block"></span>
        </div>

        <div>
            <label asp-for="ContractTerms" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-1.5">
                Contract Terms
            </label>
            <textarea asp-for="ContractTerms" rows="6" placeholder="Enter additional agreed contract terms (optional)..."
                      class="w-full p-3.5 rounded-xl border border-slate-300 text-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"></textarea>
            <span asp-validation-for="ContractTerms" class="text-xs text-rose-600 mt-1 block"></span>
        </div>

        <div class="rounded-xl bg-indigo-50/70 border border-indigo-100 text-indigo-900 p-4 text-xs flex gap-3 items-start">
            <span class="material-symbols-outlined text-indigo-600 text-[20px] shrink-0 mt-0.5">info</span>
            <p class="leading-relaxed">
                When modifying the <strong>Start Date</strong>, the system automatically re-validates the regional minimum wage configuration for the new date and updates the hourly rate for this draft.
            </p>
        </div>

        <div class="flex items-center justify-end gap-3 border-t border-slate-100 pt-5">
            <a asp-action="Details" asp-route-id="@Model.ContractId"
               class="px-5 py-2.5 rounded-xl border border-slate-200 text-slate-600 hover:bg-slate-100 text-sm font-semibold transition-colors">
                Cancel
            </a>
            <button type="submit"
                    class="px-6 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold shadow-sm transition-all cursor-pointer">
                Save Changes
            </button>
        </div>
    </form>

</div>
