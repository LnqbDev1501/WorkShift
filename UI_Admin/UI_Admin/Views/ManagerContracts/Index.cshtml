@model UI_Admin.Models.Manager.ManagerContractListViewModel
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    Layout = "_ManagerLayout";
    ViewData["Title"] = "Employment Contracts Management";
    var items = Model.Items;
    var hasFilters = !string.IsNullOrWhiteSpace(Model.Search)
        || (!string.IsNullOrWhiteSpace(Model.StatusFilter) && !Model.StatusFilter.Equals("all", StringComparison.OrdinalIgnoreCase))
        || (Model.StaffUserIdFilter.HasValue && Model.StaffUserIdFilter.Value != Guid.Empty);
}

<div class="flex flex-col gap-6">

    <!-- Header Section -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-3">
                <div class="p-2.5 bg-indigo-50 text-indigo-600 rounded-xl">
                    <span class="material-symbols-outlined text-[28px]">contract</span>
                </div>
                <div>
                    <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Employment Contracts</h1>
                    <p class="text-slate-500 text-sm mt-0.5">Manage and monitor staff employment contracts in your branch.</p>
                </div>
            </div>
        </div>
        <div class="flex items-center gap-3">
            <a asp-action="Create" class="inline-flex items-center gap-2 px-4 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold rounded-xl shadow-sm transition-all">
                <span class="material-symbols-outlined text-[20px]">add</span>
                <span>Create New Contract</span>
            </a>
        </div>
    </div>

    <!-- Filter Bar -->
    <partial name="_ListMetrics" model='@(new ListMetricViewModel[] {
        new("Matching contracts", Model.TotalItems.ToString("N0"), "Matching current filters", "contract"),
        new("Active", Model.Items.Count(x => x.Status == "ACTIVE").ToString("N0"), "On this page", "verified"),
        new("Drafts", Model.Items.Count(x => x.Status == "DRAFT").ToString("N0"), "On this page", "edit_document"),
        new("Awaiting staff", Model.Items.Count(x => x.Status == "PENDING_STAFF").ToString("N0"), "On this page", "person")
    })' />
    <form method="get" asp-action="Index" class="ws-list-filter" role="search">
        <div class="ws-filter-row">
            <label class="ws-filter-field ws-filter-keyword"><span class="material-symbols-outlined" aria-hidden="true">search</span><input type="text" id="contract-search-input" name="search" aria-label="Search by contract # or staff name" value="@Model.Search" placeholder="Contract # or staff name..." /></label>
            <div class="ws-filter-field"><select id="contract-staff-select" name="staffUserId" aria-label="Filter by staff member">
                            <option value="">All Staff Members</option>
                            @foreach (var staff in Model.StaffOptions)
                            {
                                <option value="@staff.StaffUserId" selected="@(Model.StaffUserIdFilter == staff.StaffUserId)">@staff.FullName</option>
                            }
                        </select></div>
            <div class="ws-filter-field"><select id="contract-status-select" name="status" aria-label="Filter by contract status">
                            <option value="all" selected="@(string.IsNullOrEmpty(Model.StatusFilter) || Model.StatusFilter == "all")">All Statuses</option>
                            <option value="DRAFT" selected="@(Model.StatusFilter == "DRAFT")">Draft (DRAFT)</option>
                            <option value="PENDING_STAFF" selected="@(Model.StatusFilter == "PENDING_STAFF")">Pending Staff Response</option>
                            <option value="PENDING_MANAGER_APPROVAL" selected="@(Model.StatusFilter == "PENDING_MANAGER_APPROVAL")">Pending Approval</option>
                            <option value="ACTIVE" selected="@(Model.StatusFilter == "ACTIVE")">Active (ACTIVE)</option>
                            <option value="CANCELLED" selected="@(Model.StatusFilter == "CANCELLED")">Cancelled (CANCELLED)</option>
                            <option value="REJECTED" selected="@(Model.StatusFilter == "REJECTED")">Rejected (REJECTED)</option>
                            <option value="TERMINATED" selected="@(Model.StatusFilter == "TERMINATED")">Terminated (TERMINATED)</option>
                            <option value="EXPIRED" selected="@(Model.StatusFilter == "EXPIRED")">Expired (EXPIRED)</option>
                        </select></div>
            <partial name="_ListFilterActions" model='"Index"' />
        </div>
    </form>

    <!-- Table -->
    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
        <div class="overflow-x-auto custom-scrollbar">
            <table class="w-full text-left border-collapse min-w-[960px]">
                <thead>
                    <tr class="bg-slate-50/90 border-b border-slate-200 text-slate-500 text-xs uppercase tracking-wider font-semibold">
                        <th class="px-5 py-3.5 whitespace-nowrap">Contract #</th>
                        <th class="px-4 py-3.5 whitespace-nowrap">Staff Member</th>
                        <th class="px-4 py-3.5 whitespace-nowrap">Position</th>
                        <th class="px-4 py-3.5 whitespace-nowrap">Duration</th>
                        <th class="px-4 py-3.5 whitespace-nowrap">Hourly Rate</th>
                        <th class="px-4 py-3.5 whitespace-nowrap">Status</th>
                        <th class="px-5 py-3.5 whitespace-nowrap text-right sticky right-0 bg-slate-50/95 backdrop-blur-sm shadow-[-6px_0_10px_-4px_rgba(0,0,0,0.06)]">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @if (!items.Any())
                    {
                        <tr>
                            <td colspan="7" class="px-6 py-14 text-center">
                                <div class="flex flex-col items-center gap-2.5 text-slate-400">
                                    <span class="material-symbols-outlined text-[48px] text-slate-300">description</span>
                                    <p class="font-medium text-slate-600 text-sm">No contracts found matching your filters.</p>
                                    @if (hasFilters)
                                    {
                                        <a asp-action="Index" class="text-indigo-600 hover:underline text-xs font-semibold">Clear filters</a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var contract in items)
                        {
                            var statusUpper = contract.Status?.ToUpperInvariant() ?? "";
                            var isDraft = statusUpper == "DRAFT";
                            <tr class="hover:bg-slate-50/80 transition-colors group">
                                <!-- Contract Number -->
                                <td class="px-5 py-3.5 whitespace-nowrap align-middle">
                                    <div class="flex items-center gap-1.5">
                                        <span class="font-mono text-xs font-bold text-slate-900 block truncate max-w-[150px]" title="@contract.ContractNumber">
                                            @contract.ContractNumber
                                        </span>
                                        <button type="button"
                                                onclick="copyContractNumber('@contract.ContractNumber', this)"
                                                class="text-slate-400 hover:text-indigo-600 transition-colors shrink-0"
                                                title="Copy Contract #">
                                            <span class="material-symbols-outlined text-[15px] align-middle">content_copy</span>
                                        </button>
                                    </div>
                                    <span class="text-[11px] text-slate-400 block whitespace-nowrap mt-0.5">Created: @contract.CreatedAt.ToString("dd/MM/yyyy")</span>
                                </td>
                                <!-- Employee -->
                                <td class="px-4 py-3.5 whitespace-nowrap align-middle">
                                    <div class="font-semibold text-slate-900 text-sm">@contract.EmployeeFullName</div>
                                    <div class="text-[11px] text-slate-400 font-mono">@contract.StaffUserId.ToString()[..8]…</div>
                                </td>
                                <!-- Position -->
                                <td class="px-4 py-3.5 whitespace-nowrap align-middle">
                                    <span class="text-sm font-medium text-slate-700">@contract.EmployeePosition</span>
                                </td>
                                <!-- Period -->
                                <td class="px-4 py-3.5 whitespace-nowrap align-middle">
                                    <div class="inline-flex items-center gap-1.5 text-xs text-slate-800 tabular-nums">
                                        <span class="font-medium text-slate-900">@contract.StartDate.ToString("dd/MM/yyyy")</span>
                                        <span class="text-slate-400">→</span>
                                        <span class="text-slate-600">@(contract.EndDate.HasValue ? contract.EndDate.Value.ToString("dd/MM/yyyy") : "Indefinite")</span>
                                    </div>
                                </td>
                                <!-- Rate -->
                                <td class="px-4 py-3.5 whitespace-nowrap align-middle">
                                    <span class="font-semibold text-slate-900 text-sm tabular-nums">@contract.HourlyRate.ToString("N0")&nbsp;VND/hr</span>
                                </td>
                                <!-- Status Badge -->
                                <td class="px-4 py-3.5 whitespace-nowrap align-middle">
                                    @switch (statusUpper)
                                    {
                                        case "DRAFT":
                                             <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-50 text-amber-700 border border-amber-200 whitespace-nowrap">
                                                 <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>Draft
                                             </span>
                                             break;
                                        case "PENDING_STAFF":
                                             <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-purple-50 text-purple-700 border border-purple-200 whitespace-nowrap">
                                                 <span class="w-1.5 h-1.5 rounded-full bg-purple-500 animate-pulse"></span>Pending Staff
                                             </span>
                                             break;
                                        case "PENDING_MANAGER_APPROVAL":
                                             <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-blue-50 text-blue-700 border border-blue-200 whitespace-nowrap">
                                                 <span class="w-1.5 h-1.5 rounded-full bg-blue-500 animate-pulse"></span>Pending Approval
                                             </span>
                                             break;
                                        case "ACTIVE":
                                             <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200 whitespace-nowrap">
                                                 <span class="w-1.5 h-1.5 rounded-full bg-emerald-600 animate-pulse"></span>Active
                                             </span>
                                             break;
                                        case "CANCELLED":
                                             <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-rose-50 text-rose-700 border border-rose-200 whitespace-nowrap">
                                                 <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>Cancelled
                                             </span>
                                             break;
                                        case "REJECTED":
                                             <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-rose-50 text-rose-700 border border-rose-200 whitespace-nowrap">
                                                 <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>Rejected
                                             </span>
                                             break;
                                        case "TERMINATED":
                                             <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-slate-100 text-slate-600 border border-slate-200 whitespace-nowrap">
                                                 <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>Terminated
                                             </span>
                                             break;
                                        default:
                                             <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-slate-100 text-slate-600 border border-slate-200 whitespace-nowrap">
                                                 @contract.Status
                                             </span>
                                             break;
                                    }
                                </td>
                                <!-- Actions -->
                                <td class="px-5 py-3.5 whitespace-nowrap text-right align-middle sticky right-0 bg-white/95 group-hover:bg-slate-50/95 backdrop-blur-sm transition-colors shadow-[-6px_0_10px_-4px_rgba(0,0,0,0.06)]">
                                    <div class="inline-flex items-center justify-end gap-1.5">
                                        <a asp-action="Details" asp-route-id="@contract.ContractId"
                                           title="View Details" class="ws-icon-action" aria-label="View Details"><span class="material-symbols-outlined" aria-hidden="true">visibility</span></a>

                                        @if (isDraft)
                                        {
                                            <a asp-action="Edit" asp-route-id="@contract.ContractId"
                                               class="ws-icon-action"
                                               title="Edit Draft" aria-label="Edit draft"><span class="material-symbols-outlined" aria-hidden="true">edit</span></a>
                                        }

                                        @{
                                            var todayVn = DateOnly.FromDateTime(DateTime.UtcNow.AddHours(7));
                                            var isUnactive = statusUpper is "DRAFT" or "PENDING_STAFF" or "PENDING_MANAGER_APPROVAL" or "SCHEDULED";
                                            var isCancellable = isDraft || (isUnactive && contract.StartDate >= todayVn);
                                        }

                                        @if (isCancellable)
                                        {
                                            <button type="button"
                                                    onclick="openCancelModal(@contract.ContractId, '@contract.ContractNumber', '@contract.Status', '@contract.StartDate.ToString("dd/MM/yyyy")')"
                                                    class="ws-icon-action danger"
                                                    title="@(isDraft ? "Cancel Draft" : "Cancel Contract Before Effective Date")" aria-label="Cancel contract"><span class="material-symbols-outlined" aria-hidden="true">cancel</span></button>
                                        }
                                        else if (statusUpper == "ACTIVE")
                                        {
                                            <a asp-action="Terminate" asp-route-id="@contract.ContractId"
                                               class="ws-icon-action danger"
                                               title="@(contract.CanTerminateEarly ? "Chấm dứt hợp đồng sớm (Đã đủ 3/3 cảnh báo)" : "Cảnh báo vi phạm & Chấm dứt hợp đồng (" + contract.TerminationWarningCount + "/3)")" aria-label="Terminate contract"><span class="material-symbols-outlined" aria-hidden="true">gavel</span></a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <partial name="_ListPagination" model="@(new ListPaginationViewModel
    {
        PageNumber = Model.PageNumber,
        PageSize = Model.PageSize,
        TotalItems = Model.TotalItems,
        PageParameter = "page",
        ItemLabel = "contracts",
    })" />
</div>

<!-- Cancel Contract Modal -->
<div id="cancel-modal" class="fixed inset-0 z-50 hidden bg-slate-900/50 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl shadow-xl border border-slate-200 max-w-md w-full p-6 animate-scale-up">
        <div class="flex items-center gap-3 mb-4">
            <div class="p-2.5 bg-rose-100 text-rose-600 rounded-xl">
                <span class="material-symbols-outlined text-[24px]">warning</span>
            </div>
            <div>
                <h3 class="text-lg font-bold text-slate-900" id="cancel-modal-title">Cancel Employment Contract</h3>
                <p id="cancel-modal-number" class="text-xs text-slate-500 font-mono mt-0.5"></p>
            </div>
        </div>

        <p class="text-sm text-slate-600 mb-4" id="cancel-modal-desc">
            This contract will be transitioned to <strong>CANCELLED</strong>. This record cannot be edited or reactivated once cancelled.
        </p>

        <form id="cancel-form" method="post" asp-action="Cancel" onsubmit="disableCancelBtn(this)">
            @Html.AntiForgeryToken()
            <input type="hidden" id="cancel-contract-id" name="id" value="" />
            <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />

            <div class="mb-5">
                <label for="cancel-reason" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-1.5">
                    Cancellation Reason <span class="text-rose-600">*</span>
                </label>
                <textarea id="cancel-reason"
                          name="reason"
                          rows="3"
                          required
                          placeholder="Enter reason for cancelling this contract before effective date..."
                          class="w-full px-3 py-2 border border-slate-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-rose-500 focus:border-rose-500"></textarea>
            </div>

            <div class="flex items-center justify-end gap-3">
                <button type="button"
                        onclick="closeCancelModal()"
                        class="px-4 py-2 border border-slate-200 text-slate-600 hover:bg-slate-100 rounded-xl text-sm font-medium transition-colors cursor-pointer">
                    Close
                </button>
                <button type="submit" id="confirm-cancel-btn"
                        class="inline-flex items-center gap-1.5 px-4 py-2 bg-rose-600 hover:bg-rose-700 text-white rounded-xl text-sm font-semibold transition-colors shadow-sm cursor-pointer">
                    <span class="material-symbols-outlined text-[18px]">cancel</span>
                    <span>Confirm Cancel</span>
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Terminate Contract Modal -->
<div id="terminate-modal" class="fixed inset-0 z-50 hidden bg-slate-900/50 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl shadow-xl border border-slate-200 max-w-lg w-full p-6 animate-scale-up">
        <div class="flex items-center gap-3 mb-4">
            <div class="p-2.5 bg-rose-100 text-rose-600 rounded-xl">
                <span class="material-symbols-outlined text-[24px]">gavel</span>
            </div>
            <div>
                <h3 class="text-lg font-bold text-slate-900">Terminate Contract Early</h3>
                <p id="terminate-modal-number" class="text-xs text-slate-500 font-mono mt-0.5"></p>
            </div>
        </div>

        <div class="p-3.5 mb-4 rounded-xl bg-amber-50 border border-amber-200 flex items-start gap-2.5 text-xs text-amber-800">
            <span class="material-symbols-outlined text-amber-600 text-[18px] shrink-0 mt-0.5">warning</span>
            <span>
                <strong>Warning:</strong> This action will transition the contract to <strong>TERMINATED</strong> status. The employee will receive a system notification and cannot be assigned shifts after the effective date.
            </span>
        </div>

        <form id="terminate-form" method="post" asp-action="Terminate" onsubmit="disableTerminateBtn(this)">
            @Html.AntiForgeryToken()
            <input type="hidden" id="terminate-contract-id" name="id" value="" />
            <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />

            <div class="mb-4">
                <label for="terminate-effective-date" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-1.5">
                    Termination Effective Date <span class="text-rose-600">*</span>
                </label>
                <input type="date"
                       id="terminate-effective-date"
                       name="terminationEffectiveDate"
                       value="@DateTime.Now.ToString("yyyy-MM-dd")"
                       required
                       class="w-full px-3 py-2 border border-slate-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-rose-500 focus:border-rose-500" />
                <p id="terminate-date-help" class="text-[11px] text-slate-500 mt-1">Default is today.</p>
            </div>

            <div class="mb-5">
                <label for="terminate-reason-input" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-1.5">
                    Termination Reason <span class="text-rose-600">*</span>
                </label>
                <textarea id="terminate-reason-input"
                          name="reason"
                          rows="3"
                          required
                          maxlength="500"
                          placeholder="Enter reason for early contract termination (max 500 characters)..."
                          class="w-full px-3 py-2 border border-slate-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-rose-500 focus:border-rose-500"></textarea>
                <p class="text-[11px] text-slate-400 mt-1">Reason is required for audit history and staff notification.</p>
            </div>

            <div class="flex items-center justify-end gap-3 pt-2 border-t border-slate-100">
                <button type="button"
                        onclick="closeTerminateModal()"
                        class="px-4 py-2 border border-slate-200 text-slate-600 hover:bg-slate-100 rounded-xl text-sm font-medium transition-colors cursor-pointer">
                    Close
                </button>
                <button type="submit" id="confirm-terminate-btn"
                        class="inline-flex items-center gap-1.5 px-4 py-2 bg-rose-600 hover:bg-rose-700 text-white rounded-xl text-sm font-semibold transition-colors shadow-sm cursor-pointer">
                    <span class="material-symbols-outlined text-[18px]">gavel</span>
                    <span>Confirm Termination</span>
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    function copyContractNumber(text, btn) {
        if (!navigator.clipboard) return;
        navigator.clipboard.writeText(text).then(function() {
            var icon = btn.querySelector('.material-symbols-outlined');
            if (icon) {
                var oldText = icon.textContent;
                icon.textContent = 'check';
                icon.classList.add('text-emerald-600');
                setTimeout(function() {
                    icon.textContent = oldText;
                    icon.classList.remove('text-emerald-600');
                }, 1400);
            }
        });
    }

    function openCancelModal(id, contractNumber, status, startDate) {
        document.getElementById('cancel-contract-id').value = id;
        document.getElementById('cancel-modal-number').textContent = contractNumber + (status ? ' - Status: ' + status : '');
        var reasonInput = document.getElementById('cancel-reason');
        if (reasonInput) reasonInput.value = '';
        var titleEl = document.getElementById('cancel-modal-title');
        var descEl = document.getElementById('cancel-modal-desc');
        if (status === 'DRAFT') {
            if (titleEl) titleEl.textContent = 'Confirm Draft Contract Cancellation';
            if (descEl) descEl.innerHTML = 'This draft contract will be transitioned to <strong>CANCELLED</strong>. This draft record cannot be edited or sent once cancelled.';
        } else {
            if (titleEl) titleEl.textContent = 'Cancel Contract Before Effective Date';
            if (descEl) descEl.innerHTML = 'This contract has not taken effect yet and will be transitioned to <strong>CANCELLED</strong> before its effective start date' + (startDate ? ' (' + startDate + ')' : '') + '. The employee will receive a system notification and cannot receive shifts from this contract.';
        }
        document.getElementById('cancel-modal').classList.remove('hidden');
    }

    function closeCancelModal() {
        document.getElementById('cancel-modal').classList.add('hidden');
    }

    function disableCancelBtn(form) {
        var btn = document.getElementById('confirm-cancel-btn');
        if (btn) {
            btn.disabled = true;
            btn.innerHTML = '<span class="material-symbols-outlined animate-spin text-[18px]">progress_activity</span> Processing...';
        }
    }

    function openTerminateModal(id, contractNumber, staffName, startDate) {
        document.getElementById('terminate-contract-id').value = id;
        document.getElementById('terminate-modal-number').textContent = contractNumber + ' • ' + staffName;
        document.getElementById('terminate-reason-input').value = '';
        var dateInput = document.getElementById('terminate-effective-date');
        if (dateInput) {
            dateInput.min = startDate;
            dateInput.value = new Date().toISOString().split('T')[0];
        }
        var helpText = document.getElementById('terminate-date-help');
        if (helpText && startDate) {
            helpText.textContent = 'Default is today. Cannot be before contract start date (' + startDate + ').';
        }
        document.getElementById('terminate-modal').classList.remove('hidden');
    }

    function closeTerminateModal() {
        document.getElementById('terminate-modal').classList.add('hidden');
    }

    function disableTerminateBtn(form) {
        var btn = document.getElementById('confirm-terminate-btn');
        if (btn) {
            btn.disabled = true;
            btn.innerHTML = '<span class="material-symbols-outlined animate-spin text-[18px]">progress_activity</span> Processing...';
        }
    }

    window.onclick = function(event) {
        var cancelModal = document.getElementById('cancel-modal');
        var terminateModal = document.getElementById('terminate-modal');
        if (event.target === cancelModal) closeCancelModal();
        if (event.target === terminateModal) closeTerminateModal();
    }

    document.addEventListener('keydown', function(event) {
        if (event.key === 'Escape') {
            closeCancelModal();
            closeTerminateModal();
        }
    });
</script>
}
