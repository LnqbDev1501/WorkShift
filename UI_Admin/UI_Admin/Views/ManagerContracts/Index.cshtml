@model UI_Admin.Models.Manager.ManagerContractListViewModel
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    Layout = "_ManagerLayout";
    ViewData["Title"] = "Employment Contracts Management";
    var items = Model.Items;
    var currentPage = Model.PageNumber;
    var totalPages = Model.TotalPages;
    var hasFilters = !string.IsNullOrWhiteSpace(Model.Search)
        || (!string.IsNullOrWhiteSpace(Model.StatusFilter) && !Model.StatusFilter.Equals("all", StringComparison.OrdinalIgnoreCase))
        || (Model.StaffUserIdFilter.HasValue && Model.StaffUserIdFilter.Value != Guid.Empty);
}

<div class="flex flex-col gap-6">

    <!-- Header Section -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-3">
                <div class="p-2.5 bg-indigo-50 text-indigo-600 rounded-xl">
                    <span class="material-symbols-outlined text-[28px]">contract</span>
                </div>
                <div>
                    <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Employment Contracts</h1>
                    <p class="text-slate-500 text-sm mt-0.5">Manage and monitor staff employment contracts in your branch.</p>
                </div>
            </div>
        </div>
        <div class="flex items-center gap-3">
            <a asp-action="Create" class="inline-flex items-center gap-2 px-4 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold rounded-xl shadow-sm transition-all">
                <span class="material-symbols-outlined text-[20px]">add</span>
                <span>Create New Contract</span>
            </a>
        </div>
    </div>

    <!-- Filter Bar -->
    <div class="bg-white rounded-2xl p-4 sm:p-5 shadow-sm border border-slate-200">
        <form method="get" asp-action="Index" class="flex flex-col gap-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">

                <!-- Search Input -->
                <div class="relative">
                    <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-[20px]">search</span>
                    <input type="text"
                           name="search"
                           value="@Model.Search"
                           placeholder="Contract # or staff name..."
                           class="w-full h-10 pl-10 pr-3 rounded-lg border border-slate-300 text-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all" />
                </div>

                <!-- Staff Filter -->
                <div>
                    <select name="staffUserId"
                            class="w-full h-10 px-3 rounded-lg border border-slate-300 text-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 cursor-pointer transition-all">
                        <option value="">All Staff Members</option>
                        @foreach (var staff in Model.StaffOptions)
                        {
                            <option value="@staff.StaffUserId" selected="@(Model.StaffUserIdFilter == staff.StaffUserId)">@staff.FullName</option>
                        }
                    </select>
                </div>

                <!-- Status Filter -->
                <div>
                    <select name="status"
                            class="w-full h-10 px-3 rounded-lg border border-slate-300 text-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 cursor-pointer transition-all">
                        <option value="all" selected="@(string.IsNullOrEmpty(Model.StatusFilter) || Model.StatusFilter == "all")">All Statuses</option>
                        <option value="DRAFT" selected="@(Model.StatusFilter == "DRAFT")">Draft (DRAFT)</option>
                        <option value="PENDING_STAFF" selected="@(Model.StatusFilter == "PENDING_STAFF")">Pending Staff Response</option>
                        <option value="PENDING_MANAGER_APPROVAL" selected="@(Model.StatusFilter == "PENDING_MANAGER_APPROVAL")">Pending Approval</option>
                        <option value="ACTIVE" selected="@(Model.StatusFilter == "ACTIVE")">Active (ACTIVE)</option>
                        <option value="CANCELLED" selected="@(Model.StatusFilter == "CANCELLED")">Cancelled (CANCELLED)</option>
                        <option value="REJECTED" selected="@(Model.StatusFilter == "REJECTED")">Rejected (REJECTED)</option>
                        <option value="TERMINATED" selected="@(Model.StatusFilter == "TERMINATED")">Terminated (TERMINATED)</option>
                        <option value="EXPIRED" selected="@(Model.StatusFilter == "EXPIRED")">Expired (EXPIRED)</option>
                    </select>
                </div>

                <!-- Filter Actions -->
                <div class="flex items-center gap-2">
                    <button type="submit"
                            class="h-10 px-4 rounded-lg bg-slate-900 hover:bg-slate-800 text-white font-medium text-sm flex items-center justify-center gap-1.5 transition-colors cursor-pointer flex-1">
                        <span class="material-symbols-outlined text-[18px]">filter_list</span>
                        <span>Filter</span>
                    </button>
                    @if (hasFilters)
                    {
                        <a asp-action="Index"
                           class="h-10 px-3 rounded-lg text-slate-500 hover:text-slate-800 hover:bg-slate-100 font-medium text-sm flex items-center justify-center gap-1 transition-colors"
                           title="Clear filters">
                            <span class="material-symbols-outlined text-[18px]">close</span>
                            <span>Clear</span>
                        </a>
                    }
                </div>

            </div>
        </form>
    </div>

    <!-- Summary -->
    <div class="flex items-center justify-between px-1">
        <p class="text-xs text-slate-500 font-medium">
            @if (Model.TotalItems == 0)
            {
                <span>No matching contracts found.</span>
            }
            else
            {
                var first = (currentPage - 1) * Model.PageSize + 1;
                var last = Math.Min(currentPage * Model.PageSize, Model.TotalItems);
                <span>Showing @first–@last of @Model.TotalItems contracts</span>
            }
        </p>
    </div>

    <!-- Table -->
    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-slate-50/80 border-b border-slate-200 text-slate-500 text-xs uppercase tracking-wider font-semibold">
                        <th class="px-5 py-3.5">Contract #</th>
                        <th class="px-4 py-3.5">Staff Member</th>
                        <th class="px-4 py-3.5">Position</th>
                        <th class="px-4 py-3.5">Duration</th>
                        <th class="px-4 py-3.5">Hourly Rate</th>
                        <th class="px-4 py-3.5">Status</th>
                        <th class="px-5 py-3.5 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @if (!items.Any())
                    {
                        <tr>
                            <td colspan="7" class="px-6 py-14 text-center">
                                <div class="flex flex-col items-center gap-2.5 text-slate-400">
                                    <span class="material-symbols-outlined text-[48px] text-slate-300">description</span>
                                    <p class="font-medium text-slate-600 text-sm">No contracts found matching your filters.</p>
                                    @if (hasFilters)
                                    {
                                        <a asp-action="Index" class="text-indigo-600 hover:underline text-xs font-semibold">Clear filters</a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var contract in items)
                        {
                            var statusUpper = contract.Status?.ToUpperInvariant() ?? "";
                            var isDraft = statusUpper == "DRAFT";
                            <tr class="hover:bg-slate-50/80 transition-colors">
                                <!-- Contract Number -->
                                <td class="px-5 py-4">
                                    <span class="font-mono text-xs font-bold text-slate-900 block truncate max-w-[200px]" title="@contract.ContractNumber">
                                        @contract.ContractNumber
                                    </span>
                                    <span class="text-[11px] text-slate-400">Created: @contract.CreatedAt.ToString("dd/MM/yyyy")</span>
                                </td>
                                <!-- Employee -->
                                <td class="px-4 py-4">
                                    <div class="font-semibold text-slate-900 text-sm">@contract.EmployeeFullName</div>
                                    <div class="text-[11px] text-slate-400 font-mono">@contract.StaffUserId.ToString()[..8]…</div>
                                </td>
                                <!-- Position -->
                                <td class="px-4 py-4">
                                    <span class="text-sm text-slate-700">@contract.EmployeePosition</span>
                                </td>
                                <!-- Period -->
                                <td class="px-4 py-4">
                                    <div class="text-xs text-slate-800 tabular-nums">
                                        <span class="font-medium">@contract.StartDate.ToString("dd/MM/yyyy")</span>
                                        <span class="text-slate-400 mx-1">→</span>
                                        <span class="text-slate-600">@(contract.EndDate.HasValue ? contract.EndDate.Value.ToString("dd/MM/yyyy") : "Indefinite")</span>
                                    </div>
                                </td>
                                <!-- Rate -->
                                <td class="px-4 py-4">
                                    <span class="font-semibold text-slate-900 text-sm tabular-nums">@contract.HourlyRate.ToString("N0") VND/hr</span>
                                </td>
                                <!-- Status Badge -->
                                <td class="px-4 py-4">
                                    @switch (statusUpper)
                                    {
                                        case "DRAFT":
                                             <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-50 text-amber-700 border border-amber-200">
                                                 <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>Draft
                                             </span>
                                             break;
                                        case "PENDING_STAFF":
                                             <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-purple-50 text-purple-700 border border-purple-200">
                                                 <span class="w-1.5 h-1.5 rounded-full bg-purple-500 animate-pulse"></span>Pending Staff
                                             </span>
                                             break;
                                        case "PENDING_MANAGER_APPROVAL":
                                             <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-blue-50 text-blue-700 border border-blue-200">
                                                 <span class="w-1.5 h-1.5 rounded-full bg-blue-500 animate-pulse"></span>Pending Approval
                                             </span>
                                             break;
                                        case "ACTIVE":
                                             <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
                                                 <span class="w-1.5 h-1.5 rounded-full bg-emerald-600 animate-pulse"></span>Active
                                             </span>
                                             break;
                                        case "CANCELLED":
                                             <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-rose-50 text-rose-700 border border-rose-200">
                                                 <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>Cancelled
                                             </span>
                                             break;
                                        case "REJECTED":
                                             <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-rose-50 text-rose-700 border border-rose-200">
                                                 <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>Rejected
                                             </span>
                                             break;
                                        case "TERMINATED":
                                             <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-slate-100 text-slate-600 border border-slate-200">
                                                 <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>Terminated
                                             </span>
                                             break;
                                        default:
                                             <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-slate-100 text-slate-600 border border-slate-200">
                                                 @contract.Status
                                             </span>
                                             break;
                                    }
                                </td>
                                <!-- Actions -->
                                <td class="px-5 py-4 text-right">
                                    <div class="flex items-center justify-end gap-1.5">
                                        <a asp-action="Details" asp-route-id="@contract.ContractId"
                                           class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-medium transition-colors"
                                           title="View Details">
                                            <span class="material-symbols-outlined text-[16px]">visibility</span>
                                            <span>Details</span>
                                        </a>

                                        @if (isDraft)
                                        {
                                            <a asp-action="Edit" asp-route-id="@contract.ContractId"
                                               class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-lg bg-indigo-50 hover:bg-indigo-100 text-indigo-700 text-xs font-medium transition-colors"
                                               title="Edit Draft">
                                                <span class="material-symbols-outlined text-[16px]">edit</span>
                                                <span>Edit</span>
                                            </a>

                                            <button type="button"
                                                    onclick="openCancelModal(@contract.ContractId, '@contract.ContractNumber')"
                                                    class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-lg bg-rose-50 hover:bg-rose-100 text-rose-700 text-xs font-medium transition-colors cursor-pointer"
                                                    title="Cancel Draft">
                                                <span class="material-symbols-outlined text-[16px]">cancel</span>
                                                <span>Cancel</span>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Pagination -->
    @if (totalPages > 1)
    {
        <div class="flex items-center justify-center gap-2 pt-2">
            @if (currentPage > 1)
            {
                <a asp-action="Index"
                   asp-route-page="@(currentPage - 1)"
                   asp-route-search="@Model.Search"
                   asp-route-status="@Model.StatusFilter"
                   asp-route-staffUserId="@Model.StaffUserIdFilter"
                   class="inline-flex items-center justify-center w-9 h-9 rounded-lg bg-white border border-slate-200 hover:bg-slate-100 text-slate-700 transition-colors">
                    <span class="material-symbols-outlined text-[18px]">chevron_left</span>
                </a>
            }

            @for (int p = Math.Max(1, currentPage - 2); p <= Math.Min(totalPages, currentPage + 2); p++)
            {
                <a asp-action="Index"
                   asp-route-page="@p"
                   asp-route-search="@Model.Search"
                   asp-route-status="@Model.StatusFilter"
                   asp-route-staffUserId="@Model.StaffUserIdFilter"
                   class="inline-flex items-center justify-center w-9 h-9 rounded-lg text-sm font-semibold transition-colors @(p == currentPage ? "bg-indigo-600 text-white shadow-sm" : "bg-white border border-slate-200 hover:bg-slate-100 text-slate-700")">
                    @p
                </a>
            }

            @if (currentPage < totalPages)
            {
                <a asp-action="Index"
                   asp-route-page="@(currentPage + 1)"
                   asp-route-search="@Model.Search"
                   asp-route-status="@Model.StatusFilter"
                   asp-route-staffUserId="@Model.StaffUserIdFilter"
                   class="inline-flex items-center justify-center w-9 h-9 rounded-lg bg-white border border-slate-200 hover:bg-slate-100 text-slate-700 transition-colors">
                    <span class="material-symbols-outlined text-[18px]">chevron_right</span>
                </a>
            }
        </div>
        <p class="text-center text-xs text-slate-400 pb-2">Page @currentPage of @totalPages</p>
    }

</div>

<!-- Cancel Contract Modal -->
<div id="cancel-modal" class="fixed inset-0 z-50 hidden bg-slate-900/50 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl shadow-xl border border-slate-200 max-w-md w-full p-6 animate-scale-up">
        <div class="flex items-center gap-3 mb-4">
            <div class="p-2.5 bg-rose-100 text-rose-600 rounded-xl">
                <span class="material-symbols-outlined text-[24px]">warning</span>
            </div>
            <div>
                <h3 class="text-lg font-bold text-slate-900">Confirm Draft Contract Cancellation</h3>
                <p id="cancel-modal-number" class="text-xs text-slate-500 font-mono mt-0.5"></p>
            </div>
        </div>

        <p class="text-sm text-slate-600 mb-4">
            This contract will be transitioned to <strong>CANCELLED</strong>. This draft record cannot be edited or reactivated once cancelled.
        </p>

        <form id="cancel-form" method="post" asp-action="Cancel">
            @Html.AntiForgeryToken()
            <input type="hidden" id="cancel-contract-id" name="id" value="" />

            <div class="mb-5">
                <label for="cancel-reason" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-1.5">
                    Cancellation Reason <span class="text-rose-600">*</span>
                </label>
                <textarea id="cancel-reason"
                          name="reason"
                          rows="3"
                          required
                          placeholder="Enter reason for cancelling this draft contract..."
                          class="w-full px-3 py-2 border border-slate-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-rose-500 focus:border-rose-500"></textarea>
            </div>

            <div class="flex items-center justify-end gap-3">
                <button type="button"
                        onclick="closeCancelModal()"
                        class="px-4 py-2 border border-slate-200 text-slate-600 hover:bg-slate-100 rounded-xl text-sm font-medium transition-colors cursor-pointer">
                    Close
                </button>
                <button type="submit"
                        class="px-4 py-2 bg-rose-600 hover:bg-rose-700 text-white rounded-xl text-sm font-semibold transition-colors shadow-sm cursor-pointer">
                    Confirm Cancel
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    function openCancelModal(id, contractNumber) {
        document.getElementById('cancel-contract-id').value = id;
        document.getElementById('cancel-modal-number').textContent = contractNumber;
        document.getElementById('cancel-reason').value = '';
        document.getElementById('cancel-modal').classList.remove('hidden');
    }

    function closeCancelModal() {
        document.getElementById('cancel-modal').classList.add('hidden');
    }

    window.onclick = function(event) {
        var modal = document.getElementById('cancel-modal');
        if (event.target === modal) {
            closeCancelModal();
        }
    }
</script>
}
