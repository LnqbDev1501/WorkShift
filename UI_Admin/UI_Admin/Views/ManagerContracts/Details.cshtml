@model UI_Admin.Models.Manager.ManagerContractDetailViewModel
@{
    Layout = "_ManagerLayout";
    ViewData["Title"] = $"Contract {Model.ContractNumber} - Details";
    var statusUpper = Model.Status?.ToUpperInvariant() ?? "DRAFT";
    var isDraft = statusUpper == "DRAFT";
    var isAutoCancel = string.Equals(Model.CancellationReason, "NOT_ACCEPTED_BY_START_DATE", StringComparison.OrdinalIgnoreCase)
        || (Model.CancellationReason?.Contains("quá ngày bắt đầu", StringComparison.OrdinalIgnoreCase) ?? false);
}

<div class="flex flex-col gap-6 max-w-5xl mx-auto">

    <!-- Top Navigation Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div class="flex items-center gap-3">
            <a asp-action="Index"
               class="inline-flex items-center justify-center w-10 h-10 rounded-xl bg-white border border-slate-200 hover:bg-slate-100 text-slate-700 transition-colors shrink-0"
               title="Back to contract list">
                <span class="material-symbols-outlined text-[20px]">arrow_back</span>
            </a>
            <div>
                <div class="flex items-center gap-2.5">
                    <h1 class="text-xl sm:text-2xl font-bold text-slate-900 tracking-tight">Contract Details</h1>
                    @switch (statusUpper)
                    {
                        case "DRAFT":
                            <span class="inline-flex items-center gap-1.5 px-3 py-0.5 rounded-full text-xs font-semibold bg-amber-50 text-amber-700 border border-amber-200">
                                <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>Draft
                            </span>
                            break;
                        case "PENDING_STAFF":
                            <span class="inline-flex items-center gap-1.5 px-3 py-0.5 rounded-full text-xs font-semibold bg-purple-50 text-purple-700 border border-purple-200">
                                <span class="w-1.5 h-1.5 rounded-full bg-purple-500 animate-pulse"></span>Pending Staff
                            </span>
                            break;
                        case "PENDING_MANAGER_APPROVAL":
                            <span class="inline-flex items-center gap-1.5 px-3 py-0.5 rounded-full text-xs font-semibold bg-blue-50 text-blue-700 border border-blue-200">
                                <span class="w-1.5 h-1.5 rounded-full bg-blue-500 animate-pulse"></span>Pending Approval
                            </span>
                            break;
                        case "ACTIVE":
                            <span class="inline-flex items-center gap-1.5 px-3 py-0.5 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
                                <span class="w-1.5 h-1.5 rounded-full bg-emerald-600 animate-pulse"></span>Active
                            </span>
                            break;
                        case "CANCELLED":
                            <span class="inline-flex items-center gap-1.5 px-3 py-0.5 rounded-full text-xs font-semibold bg-rose-50 text-rose-700 border border-rose-200">
                                <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>Cancelled
                            </span>
                            break;
                        case "REJECTED":
                            <span class="inline-flex items-center gap-1.5 px-3 py-0.5 rounded-full text-xs font-semibold bg-rose-50 text-rose-700 border border-rose-200">
                                <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>Rejected
                            </span>
                            break;
                        case "TERMINATED":
                            <span class="inline-flex items-center gap-1.5 px-3 py-0.5 rounded-full text-xs font-semibold bg-slate-100 text-slate-600 border border-slate-200">
                                <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>Terminated
                            </span>
                            break;
                        default:
                            <span class="inline-flex items-center gap-1.5 px-3 py-0.5 rounded-full text-xs font-semibold bg-slate-100 text-slate-600 border border-slate-200">
                                @Model.Status
                            </span>
                            break;
                    }
                </div>
                <p class="font-mono text-xs text-slate-500 mt-0.5">@Model.ContractNumber</p>
            </div>
        </div>

        <div class="flex items-center gap-2 flex-wrap">
            <a href="#contract-history-section"
               class="inline-flex items-center gap-1.5 px-3.5 py-2 bg-white border border-slate-200 hover:bg-slate-50 text-slate-700 text-sm font-semibold rounded-xl shadow-sm transition-all">
                <span class="material-symbols-outlined text-[18px] text-indigo-600">manage_history</span>
                <span>Contract History</span>
                @if (Model.History?.TotalItems > 0)
                {
                    <span class="px-2 py-0.5 rounded-full text-xs bg-indigo-50 text-indigo-700 font-bold">@Model.History.TotalItems</span>
                }
            </a>

            @if (isDraft)
            {
                <a asp-action="PreviewPdf" asp-route-id="@Model.ContractId" target="_blank"
                   class="inline-flex items-center gap-1.5 px-3.5 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-sm font-semibold rounded-xl transition-all">
                    <span class="material-symbols-outlined text-[18px]">picture_as_pdf</span>
                    <span>Preview PDF</span>
                </a>
                <button type="button"
                        onclick="openSendModal()"
                        class="inline-flex items-center gap-1.5 px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold rounded-xl shadow-sm transition-all cursor-pointer">
                    <span class="material-symbols-outlined text-[18px]">send</span>
                    <span>Send to Staff</span>
                </button>
                <a asp-action="Edit" asp-route-id="@Model.ContractId"
                   class="inline-flex items-center gap-1.5 px-3.5 py-2 bg-white border border-slate-200 hover:bg-slate-50 text-slate-700 text-sm font-semibold rounded-xl shadow-sm transition-all">
                    <span class="material-symbols-outlined text-[18px]">edit</span>
                    <span>Edit</span>
                </a>
                <button type="button"
                        onclick="openCancelModal()"
                        class="inline-flex items-center gap-1.5 px-3.5 py-2 bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 text-sm font-semibold rounded-xl transition-all cursor-pointer">
                    <span class="material-symbols-outlined text-[18px]">cancel</span>
                    <span>Cancel Draft</span>
                </button>
            }
            else
            {
                <a asp-action="Pdf" asp-route-id="@Model.ContractId" target="_blank"
                   class="inline-flex items-center gap-1.5 px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold rounded-xl shadow-sm transition-all">
                    <span class="material-symbols-outlined text-[18px]">visibility</span>
                    <span>View PDF</span>
                </a>
                <a asp-action="DownloadPdf" asp-route-id="@Model.ContractId"
                   class="inline-flex items-center gap-1.5 px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-sm font-semibold rounded-xl transition-all">
                    <span class="material-symbols-outlined text-[18px]">download</span>
                    <span>Download PDF</span>
                </a>
                @if (statusUpper == "ACTIVE")
                {
                    <button type="button"
                            onclick="openTerminateModal()"
                            class="inline-flex items-center gap-1.5 px-4 py-2 bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 text-sm font-semibold rounded-xl shadow-sm transition-all cursor-pointer"
                            title="Chấm dứt hợp đồng trước hạn">
                        <span class="material-symbols-outlined text-[18px]">gavel</span>
                        <span>Chấm dứt HĐ</span>
                    </button>
                }
            }
        </div>
    </div>

    <!-- Cancellation / Rejection Banner -->
    @if (statusUpper == "CANCELLED")
    {
        <div class="p-5 rounded-2xl bg-rose-50/80 border border-rose-200 shadow-sm flex items-start gap-4">
            <div class="p-2.5 bg-rose-100 text-rose-700 rounded-xl shrink-0 mt-0.5">
                <span class="material-symbols-outlined text-[24px]">event_busy</span>
            </div>
            <div class="flex-1">
                <div class="flex items-center gap-2 flex-wrap mb-2">
                    <h3 class="font-bold text-rose-900 text-sm">Contract has been cancelled</h3>
                    <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-rose-100 text-rose-700 border border-rose-300">
                        <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>CANCELLED
                    </span>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-x-6 gap-y-2 text-xs">
                    <div>
                        <span class="text-rose-600/80 font-medium block">Cancellation Reason:</span>
                        <span class="font-semibold text-rose-900">
                            @if (isAutoCancel)
                            {
                                <span>Quá ngày bắt đầu hợp đồng mà nhân viên chưa xác nhận chấp thuận (Hệ thống tự động hủy)</span>
                            }
                            else
                            {
                                @(string.IsNullOrWhiteSpace(Model.CancellationReason) ? "Draft cancelled by manager" : Model.CancellationReason)
                            }
                        </span>
                    </div>
                    <div>
                        <span class="text-rose-600/80 font-medium block">Cancelled At:</span>
                        <span class="font-semibold text-rose-900 tabular-nums">
                            @(Model.CancelledAt.HasValue ? Model.CancelledAt.Value.ToString("dd/MM/yyyy HH:mm:ss") : "—")
                        </span>
                    </div>
                    <div>
                        <span class="text-rose-600/80 font-medium block">Performed By:</span>
                        <span class="font-semibold text-rose-900">
                            @if (isAutoCancel || !Model.CancelledBy.HasValue)
                            {
                                <span class="inline-flex items-center gap-1 font-semibold text-slate-800">
                                    <span class="material-symbols-outlined text-[14px]">smart_toy</span> System
                                </span>
                            }
                            else
                            {
                                <span class="font-mono">@Model.CancelledBy.Value</span>
                            }
                        </span>
                    </div>
                </div>
            </div>
        </div>
    }
    @if (statusUpper == "REJECTED" && !string.IsNullOrWhiteSpace(Model.ManagerRejectionComment))
    {
        <div class="p-4 rounded-2xl bg-rose-50 border border-rose-200 flex items-start gap-3">
            <span class="material-symbols-outlined text-rose-600 text-[22px] mt-0.5 shrink-0">block</span>
            <div>
                <p class="font-bold text-rose-800 text-sm">Contract has been rejected</p>
                <p class="text-rose-700 text-xs mt-1">Reason: @Model.ManagerRejectionComment</p>
            </div>
        </div>
    }

    <!-- Termination Banner -->
    @if (statusUpper == "TERMINATED")
    {
        <div class="p-5 rounded-2xl bg-rose-50/80 border border-rose-200 shadow-sm flex items-start gap-4">
            <div class="p-2.5 bg-rose-100 text-rose-700 rounded-xl shrink-0 mt-0.5">
                <span class="material-symbols-outlined text-[24px]">gavel</span>
            </div>
            <div class="flex-1">
                <div class="flex items-center gap-2 flex-wrap mb-2">
                    <h3 class="font-bold text-rose-900 text-sm">Hợp đồng đã chấm dứt trước thời hạn</h3>
                    <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-rose-100 text-rose-700 border border-rose-300">
                        <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>TERMINATED
                    </span>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-x-6 gap-y-2 text-xs">
                    <div>
                        <span class="text-rose-600/80 font-medium block">Lý do chấm dứt:</span>
                        <span class="font-semibold text-rose-900">
                            @(string.IsNullOrWhiteSpace(Model.TerminationReason) ? "Đã chấm dứt bởi quản lý" : Model.TerminationReason)
                        </span>
                    </div>
                    <div>
                        <span class="text-rose-600/80 font-medium block">Ngày có hiệu lực:</span>
                        <span class="font-semibold text-rose-900 tabular-nums">
                            @(Model.TerminationEffectiveAt.HasValue ? Model.TerminationEffectiveAt.Value.ToString("dd/MM/yyyy") : "—")
                        </span>
                    </div>
                    <div>
                        <span class="text-rose-600/80 font-medium block">Thời điểm thực hiện:</span>
                        <span class="font-semibold text-rose-900 tabular-nums">
                            @(Model.TerminatedAt.HasValue ? Model.TerminatedAt.Value.ToString("dd/MM/yyyy HH:mm:ss") : "—")
                        </span>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (statusUpper == "PENDING_MANAGER_APPROVAL" || Model.OpenChangeRequestId.HasValue)
    {
        <div class="p-5 rounded-2xl bg-amber-50 border border-amber-200 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div class="flex items-start gap-3.5">
                <div class="p-2.5 bg-amber-100 text-amber-700 rounded-xl shrink-0 mt-0.5">
                    <span class="material-symbols-outlined text-[24px]">pending_actions</span>
                </div>
                <div>
                    <div class="flex items-center gap-2">
                        <h3 class="font-bold text-amber-900 text-sm">Pending Contract Change Request</h3>
                        <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-200 text-amber-800">
                            PENDING_MANAGER_APPROVAL
                        </span>
                    </div>
                    <p class="text-xs text-amber-700 mt-1">
                        The employee has submitted proposed modifications to this contract. Please review, compare values, and decide before approving.
                    </p>
                </div>
            </div>
            @if (Model.OpenChangeRequestId.HasValue)
            {
                <a asp-action="ChangeRequestDetails" asp-route-id="@Model.OpenChangeRequestId.Value"
                   class="inline-flex items-center gap-1.5 px-4 py-2 bg-amber-600 hover:bg-amber-700 text-white text-xs font-bold rounded-xl shadow-sm transition-all shrink-0">
                    <span class="material-symbols-outlined text-[18px]">rule</span>
                    <span>Review Change Request</span>
                </a>
            }
            else
            {
                <a asp-action="ChangeRequests" asp-route-status="SUBMITTED"
                   class="inline-flex items-center gap-1.5 px-4 py-2 bg-amber-600 hover:bg-amber-700 text-white text-xs font-bold rounded-xl shadow-sm transition-all shrink-0">
                    <span class="material-symbols-outlined text-[18px]">rule</span>
                    <span>View Change Requests</span>
                </a>
            }
        </div>
    }

    <!-- Content Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

        <!-- Left Column: Contract & Terms (2 cols) -->
        <div class="lg:col-span-2 flex flex-col gap-6">

            <!-- Card: Contract Info -->
            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
                <div class="px-6 py-4 border-b border-slate-100 flex items-center gap-2">
                    <span class="material-symbols-outlined text-indigo-600 text-[20px]">description</span>
                    <h2 class="text-sm font-bold text-slate-900 uppercase tracking-wide">Contract Information</h2>
                </div>
                <div class="p-6 grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-4">
                    <div>
                        <p class="text-xs text-slate-500 font-medium">Contract Number</p>
                        <p class="font-mono text-sm font-bold text-slate-900 mt-0.5">@Model.ContractNumber</p>
                    </div>
                    <div>
                        <p class="text-xs text-slate-500 font-medium">Status</p>
                        <p class="text-sm font-semibold text-slate-900 mt-0.5">@Model.Status</p>
                    </div>
                    <div>
                        <p class="text-xs text-slate-500 font-medium">Start Date</p>
                        <p class="text-sm font-semibold text-slate-900 tabular-nums mt-0.5">@Model.StartDate.ToString("dd/MM/yyyy")</p>
                    </div>
                    <div>
                        <p class="text-xs text-slate-500 font-medium">End Date</p>
                        <p class="text-sm font-semibold text-slate-900 tabular-nums mt-0.5">
                            @(Model.EndDate.HasValue ? Model.EndDate.Value.ToString("dd/MM/yyyy") : "Indefinite")
                        </p>
                    </div>
                    <div>
                        <p class="text-xs text-slate-500 font-medium">Applicable Hourly Rate</p>
                        <p class="text-base font-extrabold text-indigo-600 tabular-nums mt-0.5">@Model.HourlyRate.ToString("N0") VND/hr</p>
                    </div>
                    <div>
                        <p class="text-xs text-slate-500 font-medium">Position / Title</p>
                        <p class="text-sm font-semibold text-slate-900 mt-0.5">@Model.EmployeePosition</p>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.ContractTerms))
                    {
                        <div class="sm:col-span-2 border-t border-slate-100 pt-4 mt-2">
                            <p class="text-xs text-slate-500 font-medium mb-1.5">Contract Terms</p>
                            <div class="p-4 rounded-xl bg-slate-50 border border-slate-100 text-sm text-slate-800 leading-relaxed whitespace-pre-line">
                                @Model.ContractTerms
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Card: Employee Snapshot -->
            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
                <div class="px-6 py-4 border-b border-slate-100 flex items-center gap-2">
                    <span class="material-symbols-outlined text-indigo-600 text-[20px]">person</span>
                    <h2 class="text-sm font-bold text-slate-900 uppercase tracking-wide">Staff Member Information (Snapshot)</h2>
                </div>
                <div class="p-6 grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-4">
                    <div>
                        <p class="text-xs text-slate-500 font-medium">Full Name</p>
                        <p class="text-sm font-bold text-slate-900 mt-0.5">@Model.EmployeeFullName</p>
                    </div>
                    <div>
                        <p class="text-xs text-slate-500 font-medium">Phone Number</p>
                        <p class="text-sm font-medium text-slate-900 mt-0.5">@(string.IsNullOrWhiteSpace(Model.EmployeePhone) ? "—" : Model.EmployeePhone)</p>
                    </div>
                    <div>
                        <p class="text-xs text-slate-500 font-medium">National ID / Citizen ID</p>
                        <p class="text-sm font-mono text-slate-900 mt-0.5">@(string.IsNullOrWhiteSpace(Model.EmployeeIdentityNo) ? "—" : Model.EmployeeIdentityNo)</p>
                    </div>
                    <div>
                        <p class="text-xs text-slate-500 font-medium">Staff User ID</p>
                        <p class="text-xs font-mono text-slate-600 mt-0.5">@Model.StaffUserId</p>
                    </div>
                    <div class="sm:col-span-2">
                        <p class="text-xs text-slate-500 font-medium">Residential Address</p>
                        <p class="text-sm text-slate-800 mt-0.5">@(string.IsNullOrWhiteSpace(Model.EmployeeAddress) ? "—" : Model.EmployeeAddress)</p>
                    </div>
                </div>
            </div>

        </div>

        <!-- Right Column: Location & Audit Info (1 col) -->
        <div class="flex flex-col gap-6">

            <!-- Card: Branch & Region Snapshot -->
            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
                <div class="px-6 py-4 border-b border-slate-100 flex items-center gap-2">
                    <span class="material-symbols-outlined text-indigo-600 text-[20px]">store</span>
                    <h2 class="text-sm font-bold text-slate-900 uppercase tracking-wide">Branch & Region</h2>
                </div>
                <div class="p-6 flex flex-col gap-4">
                    <div>
                        <p class="text-xs text-slate-500 font-medium">Managing Branch</p>
                        <p class="text-sm font-bold text-slate-900 mt-0.5">@Model.BranchName</p>
                        <p class="text-xs text-slate-500 mt-0.5">@Model.BranchAddress</p>
                    </div>
                    <div class="border-t border-slate-100 pt-3">
                        <p class="text-xs text-slate-500 font-medium">Region / Minimum Wage Zone</p>
                        <p class="text-sm font-semibold text-slate-900 mt-0.5">@Model.RegionName</p>
                    </div>
                </div>
            </div>

            <!-- Card: Audit Lifecycle -->
            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
                <div class="px-6 py-4 border-b border-slate-100 flex items-center gap-2">
                    <span class="material-symbols-outlined text-indigo-600 text-[20px]">history</span>
                    <h2 class="text-sm font-bold text-slate-900 uppercase tracking-wide">Contract Lifecycle</h2>
                </div>
                <div class="p-6">
                    <ol class="relative border-l border-slate-200 ml-2.5 space-y-3.5">
                        <!-- Created -->
                        <li class="ml-4">
                            <div class="absolute w-2.5 h-2.5 rounded-full bg-indigo-500 -left-[5px] mt-1"></div>
                            <p class="text-xs font-semibold text-slate-900">Created</p>
                            <p class="text-[11px] text-slate-500 tabular-nums">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>
                            <p class="text-[11px] text-slate-400 font-mono">
                                by @(string.IsNullOrWhiteSpace(Model.CreatedByManagerName) ? Model.CreatedBy.ToString()[..8] + "…" : Model.CreatedByManagerName)
                            </p>
                        </li>

                        <!-- Sent to Staff -->
                        @if (Model.SentToStaffAt.HasValue)
                        {
                            <li class="ml-4">
                                <div class="absolute w-2.5 h-2.5 rounded-full bg-blue-500 -left-[5px] mt-1"></div>
                                <p class="text-xs font-semibold text-slate-900">Sent to Staff</p>
                                <p class="text-[11px] text-slate-500 tabular-nums">@Model.SentToStaffAt.Value.ToString("dd/MM/yyyy HH:mm")</p>
                            </li>
                        }

                        <!-- Staff Accepted -->
                        @if (Model.StaffAcceptedAt.HasValue)
                        {
                            <li class="ml-4">
                                <div class="absolute w-2.5 h-2.5 rounded-full bg-emerald-500 -left-[5px] mt-1"></div>
                                <p class="text-xs font-semibold text-emerald-700">Staff Accepted</p>
                                <p class="text-[11px] text-slate-500 tabular-nums">@Model.StaffAcceptedAt.Value.ToString("dd/MM/yyyy HH:mm")</p>
                            </li>
                        }

                        <!-- Rejected -->
                        @if (statusUpper == "REJECTED" && !string.IsNullOrWhiteSpace(Model.ManagerRejectionComment))
                        {
                            <li class="ml-4">
                                <div class="absolute w-2.5 h-2.5 rounded-full bg-rose-500 -left-[5px] mt-1"></div>
                                <p class="text-xs font-semibold text-rose-700">Rejected</p>
                                <p class="text-[11px] text-rose-600 mt-0.5 italic">"@Model.ManagerRejectionComment"</p>
                            </li>
                        }

                        <!-- Cancelled -->
                        @if (Model.CancelledAt.HasValue || statusUpper == "CANCELLED")
                        {
                            <li class="ml-4">
                                <div class="absolute w-2.5 h-2.5 rounded-full bg-rose-500 -left-[5px] mt-1"></div>
                                <p class="text-xs font-semibold text-rose-700">Cancelled</p>
                                @if (Model.CancelledAt.HasValue)
                                {
                                    <p class="text-[11px] text-slate-500 tabular-nums">@Model.CancelledAt.Value.ToString("dd/MM/yyyy HH:mm")</p>
                                }
                                <p class="text-[11px] text-slate-400 font-mono">
                                    by @(Model.CancelledBy.HasValue ? Model.CancelledBy.Value.ToString()[..8] + "…" : "System")
                                </p>
                                @if (!string.IsNullOrWhiteSpace(Model.CancellationReason))
                                {
                                    var displayReason = isAutoCancel || Model.CancellationReason.Contains("NOT_ACCEPTED_BY_START_DATE", StringComparison.OrdinalIgnoreCase)
                                        ? "Quá ngày bắt đầu mà nhân viên chưa xác nhận chấp thuận"
                                        : Model.CancellationReason;
                                    <p class="text-[11px] text-rose-600 mt-0.5 italic">"@displayReason"</p>
                                }
                            </li>
                        }

                        <!-- Terminated -->
                        @if (Model.TerminatedAt.HasValue || statusUpper == "TERMINATED")
                        {
                            <li class="ml-4">
                                <div class="absolute w-2.5 h-2.5 rounded-full bg-slate-500 -left-[5px] mt-1"></div>
                                <p class="text-xs font-semibold text-slate-700">Terminated</p>
                                @if (Model.TerminatedAt.HasValue)
                                {
                                    <p class="text-[11px] text-slate-500 tabular-nums">@Model.TerminatedAt.Value.ToString("dd/MM/yyyy HH:mm")</p>
                                }
                                @if (!string.IsNullOrWhiteSpace(Model.TerminationReason))
                                {
                                    <p class="text-[11px] text-slate-500 italic mt-0.5">"@Model.TerminationReason"</p>
                                }
                            </li>
                        }

                        <!-- Last Updated -->
                        <li class="ml-4">
                            <div class="absolute w-2.5 h-2.5 rounded-full bg-slate-400 -left-[5px] mt-1"></div>
                            <p class="text-xs font-semibold text-slate-700">Last Updated</p>
                            <p class="text-[11px] text-slate-500 tabular-nums">@Model.UpdatedAt.ToString("dd/MM/yyyy HH:mm")</p>
                        </li>
                    </ol>
                </div>
            </div>

        </div>

    </div>

    <!-- Complete Contract Audit History S    <div id="contract-history-section" class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
        <div class="px-6 py-5 border-b border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-slate-50/50">
            <div class="flex items-center gap-3">
                <div class="p-2.5 bg-indigo-50 text-indigo-600 rounded-xl">
                    <span class="material-symbols-outlined text-[24px]">manage_history</span>
                </div>
                <div>
                    <h2 class="text-base font-bold text-slate-900">Contract History (Audit Timeline)</h2>
                    <p class="text-xs text-slate-500 mt-0.5">Track chronological events, approvals, and contract changes in your branch.</p>
                </div>
            </div>
            @if (Model.History?.TotalItems > 0)
            {
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-indigo-50 text-indigo-700 self-start sm:self-auto">
                    <span class="w-1.5 h-1.5 rounded-full bg-indigo-600"></span>
                    @Model.History.TotalItems events
                </span>
            }
        </div>

        <div class="p-6">
            @if (Model.HistoryLoadFailed)
            {
                <div class="py-10 text-center flex flex-col items-center justify-center text-rose-600 bg-rose-50/50 rounded-xl border border-rose-200/60 p-6">
                    <span class="material-symbols-outlined text-[48px] text-rose-500 mb-2">error_outline</span>
                    <p class="text-sm font-semibold text-rose-900">Unable to load contract history</p>
                    <p class="text-xs text-rose-700 mt-1">@(Model.HistoryErrorMessage ?? "An error occurred while connecting to the contract history service.")</p>
                    <a asp-action="Details"
                       asp-route-id="@Model.ContractId"
                       asp-fragment="contract-history-section"
                       class="mt-4 px-4 py-2 rounded-xl bg-white hover:bg-slate-50 border border-slate-200 text-slate-700 text-xs font-semibold transition-all inline-flex items-center gap-1.5 shadow-sm">
                        <span class="material-symbols-outlined text-[16px]">refresh</span>
                        <span>Retry</span>
                    </a>
                </div>
            }
            else if (Model.History?.Items != null && Model.History.Items.Count > 0)
            {
                <div class="relative border-l-2 border-slate-200 ml-4 space-y-6">
                    @foreach (var entry in Model.History.Items)
                    {
                        var isSystem = entry.ActorRole == "SYSTEM" || entry.ActorId == null || string.Equals(entry.ActorName, "Hệ thống", StringComparison.OrdinalIgnoreCase) || string.Equals(entry.ActorName, "System", StringComparison.OrdinalIgnoreCase);
                        var isManager = string.Equals(entry.ActorRole, "MANAGER", StringComparison.OrdinalIgnoreCase);
                        var isStaff = string.Equals(entry.ActorRole, "STAFF", StringComparison.OrdinalIgnoreCase);
                        var isEntryAutoCancel = string.Equals(entry.Action, "AUTO_CANCEL_CONTRACT", StringComparison.OrdinalIgnoreCase);

                        <div class="relative pl-6">
                            <!-- Bullet Icon -->
                            <div class="absolute -left-[17px] top-1 w-8 h-8 rounded-full border-2 border-white flex items-center justify-center shadow-sm @(isEntryAutoCancel ? "bg-rose-500 text-white" : isSystem ? "bg-slate-700 text-white" : isManager ? "bg-indigo-600 text-white" : "bg-teal-600 text-white")">
                                <span class="material-symbols-outlined text-[16px]">
                                    @(isEntryAutoCancel ? "event_busy" : isSystem ? "smart_toy" : isManager ? "badge" : "person")
                                </span>
                            </div>

                            <!-- Event Card -->
                            <div class="p-4 rounded-xl border border-slate-200 bg-white hover:border-indigo-300 transition-colors shadow-sm">
                                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-2 border-b border-slate-100">
                                    <div class="flex items-center gap-2 flex-wrap">
                                        <h3 class="text-sm font-bold text-slate-900">@entry.ActionTitle</h3>
                                        <span class="px-2 py-0.5 rounded text-[11px] font-mono bg-slate-100 text-slate-700">@entry.Action</span>

                                        <!-- Actor Badge -->
                                        @if (isSystem)
                                        {
                                            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-slate-100 text-slate-700 border border-slate-300">
                                                <span class="material-symbols-outlined text-[14px]">smart_toy</span> System
                                            </span>
                                        }
                                        else if (isManager)
                                        {
                                            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-indigo-50 text-indigo-700 border border-indigo-200">
                                                <span class="material-symbols-outlined text-[14px]">badge</span> Manager: @entry.ActorName
                                            </span>
                                        }
                                        else if (isStaff)
                                        {
                                            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-teal-50 text-teal-700 border border-teal-200">
                                                <span class="material-symbols-outlined text-[14px]">person</span> Staff: @entry.ActorName
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-medium bg-slate-50 text-slate-600 border border-slate-200">
                                                @entry.ActorRole: @entry.ActorName
                                            </span>
                                        }
                                    </div>
                                    <span class="text-xs text-slate-500 tabular-nums font-medium shrink-0">
                                        @entry.Timestamp.ToString("dd/MM/yyyy HH:mm:ss")
                                    </span>
                                </div>

                                <!-- AUTO_CANCEL_CONTRACT Callout -->
                                @if (isEntryAutoCancel)
                                {
                                    <div class="mt-3 p-3 rounded-xl bg-rose-50 border border-rose-200 text-xs text-rose-800 flex items-start gap-2.5">
                                        <span class="material-symbols-outlined text-rose-600 text-[18px] shrink-0 mt-0.5">warning</span>
                                        <div>
                                            <p class="font-bold text-rose-900">System auto-cancelled contract due to staff not accepting on time:</p>
                                            <p class="text-rose-700 mt-0.5">
                                                The contract expired for staff acceptance (past effective start date).
                                                Status changed to <strong class="font-mono text-rose-900">CANCELLED</strong> with reason <strong class="text-rose-900">Quá ngày bắt đầu mà nhân viên chưa xác nhận chấp thuận</strong> (not TERMINATED).
                                            </p>
                                        </div>
                                    </div>
                                }

                                <!-- Status Transition -->
                                @if (!string.IsNullOrWhiteSpace(entry.FromStatus) || !string.IsNullOrWhiteSpace(entry.ToStatus))
                                {
                                    <div class="mt-3 flex items-center gap-2 text-xs">
                                        <span class="text-slate-500 font-medium">Status:</span>
                                        @if (!string.IsNullOrWhiteSpace(entry.FromStatus))
                                        {
                                            <span class="px-2 py-0.5 rounded font-mono bg-slate-100 text-slate-700">@entry.FromStatus</span>
                                            <span class="material-symbols-outlined text-[16px] text-slate-400">arrow_forward</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(entry.ToStatus))
                                        {
                                            var toUpper = entry.ToStatus.ToUpperInvariant();
                                            var toClass = toUpper switch
                                            {
                                                "ACTIVE" => "bg-emerald-50 text-emerald-700 border border-emerald-200 font-semibold",
                                                "CANCELLED" => "bg-rose-50 text-rose-700 border border-rose-200 font-semibold",
                                                "TERMINATED" => "bg-slate-100 text-slate-700 border border-slate-300 font-medium",
                                                "PENDING_STAFF" => "bg-purple-50 text-purple-700 border border-purple-200",
                                                "REJECTED" => "bg-rose-50 text-rose-700 border border-rose-200",
                                                _ => "bg-slate-100 text-slate-700 font-mono"
                                            };
                                            <span class="px-2 py-0.5 rounded font-mono @toClass">@entry.ToStatus</span>
                                        }
                                    </div>
                                }

                                <!-- Reason & Notes -->
                                @if (!string.IsNullOrWhiteSpace(entry.Reason))
                                {
                                    <div class="mt-2.5 p-2.5 rounded-lg bg-amber-50/70 border border-amber-200/60 text-xs text-amber-900 flex items-start gap-2">
                                        <span class="material-symbols-outlined text-amber-600 text-[18px] shrink-0 mt-0.5">info</span>
                                        <div>
                                            @if (entry.Reason == "NOT_ACCEPTED_BY_START_DATE" || (entry.Reason?.Contains("quá ngày bắt đầu", StringComparison.OrdinalIgnoreCase) ?? false))
                                            {
                                                <span class="font-semibold">Reason:</span> <span>Quá ngày bắt đầu mà nhân viên chưa xác nhận chấp thuận</span>
                                            }
                                            else
                                            {
                                                <span class="font-semibold">Reason:</span> @entry.Reason
                                            }
                                        </div>
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(entry.Note))
                                {
                                    <div class="mt-2 text-xs text-slate-500 italic">
                                        Note: @entry.Note
                                    </div>
                                }

                                <!-- Changed Fields Table (for UPDATE_DRAFT) -->
                                @if (entry.ChangedFields != null && entry.ChangedFields.Count > 0)
                                {
                                    <div class="mt-3 overflow-x-auto rounded-lg border border-slate-200">
                                        <table class="w-full text-left text-xs">
                                            <thead class="bg-slate-50 text-slate-600 font-semibold border-b border-slate-200">
                                                <tr>
                                                    <th class="py-1.5 px-3">Field</th>
                                                    <th class="py-1.5 px-3">Previous Value</th>
                                                    <th class="py-1.5 px-3">New Value</th>
                                                </tr>
                                            </thead>
                                            <tbody class="divide-y divide-slate-100">
                                                @foreach (var field in entry.ChangedFields)
                                                {
                                                    <tr>
                                                        <td class="py-1.5 px-3 font-medium text-slate-800">@field.FieldName</td>
                                                        <td class="py-1.5 px-3 text-slate-500">@(field.OldValue ?? "—")</td>
                                                        <td class="py-1.5 px-3 font-semibold text-indigo-600">@(field.NewValue ?? "—")</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }

                                <!-- Change Request Items -->
                                @if (entry.ChangeRequestItems != null && entry.ChangeRequestItems.Count > 0)
                                {
                                    <div class="mt-3 overflow-x-auto rounded-lg border border-slate-200">
                                        <table class="w-full text-left text-xs">
                                            <thead class="bg-slate-50 text-slate-600 font-semibold border-b border-slate-200">
                                                <tr>
                                                    <th class="py-1.5 px-3">Field Name</th>
                                                    <th class="py-1.5 px-3">Original Value</th>
                                                    <th class="py-1.5 px-3">Proposed Value</th>
                                                    <th class="py-1.5 px-3">Reason</th>
                                                </tr>
                                            </thead>
                                            <tbody class="divide-y divide-slate-100">
                                                @foreach (var crItem in entry.ChangeRequestItems)
                                                {
                                                    <tr>
                                                        <td class="py-1.5 px-3 font-medium text-slate-800">@crItem.FieldName</td>
                                                        <td class="py-1.5 px-3 text-slate-500">@(crItem.OriginalValue ?? "—")</td>
                                                        <td class="py-1.5 px-3 font-semibold text-indigo-600">@crItem.ProposedValue</td>
                                                        <td class="py-1.5 px-3 text-slate-500 italic">@(crItem.Reason ?? "—")</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>

                <!-- History Pagination -->
                @if (Model.History != null && Model.History.TotalPages > 1)
                {
                    var currentHistoryPage = Model.History.PageNumber;
                    var totalHistoryPages = Model.History.TotalPages;
                    var historyPageSize = Model.History.PageSize;

                    <div class="mt-6 pt-4 border-t border-slate-100 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs">
                        <div class="text-slate-500">
                            Page <span class="font-semibold text-slate-800">@currentHistoryPage</span> of <span class="font-semibold text-slate-800">@totalHistoryPages</span> (Total @Model.History.TotalItems events)
                        </div>
                        <div class="flex items-center gap-1.5">
                            @if (currentHistoryPage > 1)
                            {
                                <a asp-action="Details"
                                   asp-route-id="@Model.ContractId"
                                   asp-route-historyPage="@(currentHistoryPage - 1)"
                                   asp-route-historyPageSize="@historyPageSize"
                                   asp-fragment="contract-history-section"
                                   class="px-3 py-1.5 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 font-medium transition-colors flex items-center gap-1">
                                    <span class="material-symbols-outlined text-[16px]">chevron_left</span>
                                    <span>Previous</span>
                                </a>
                            }
                            else
                            {
                                <button type="button" disabled class="px-3 py-1.5 rounded-lg border border-slate-200 bg-slate-50 text-slate-400 font-medium cursor-not-allowed flex items-center gap-1">
                                    <span class="material-symbols-outlined text-[16px]">chevron_left</span>
                                    <span>Previous</span>
                                </button>
                            }

                            @for (var p = Math.Max(1, currentHistoryPage - 2); p <= Math.Min(totalHistoryPages, currentHistoryPage + 2); p++)
                            {
                                var isCur = p == currentHistoryPage;
                                if (isCur)
                                {
                                    <span class="px-3 py-1.5 rounded-lg bg-indigo-600 text-white font-bold">@p</span>
                                }
                                else
                                {
                                    <a asp-action="Details"
                                       asp-route-id="@Model.ContractId"
                                       asp-route-historyPage="@p"
                                       asp-route-historyPageSize="@historyPageSize"
                                       asp-fragment="contract-history-section"
                                       class="px-3 py-1.5 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 font-medium transition-colors">@p</a>
                                }
                            }

                            @if (currentHistoryPage < totalHistoryPages)
                            {
                                <a asp-action="Details"
                                   asp-route-id="@Model.ContractId"
                                   asp-route-historyPage="@(currentHistoryPage + 1)"
                                   asp-route-historyPageSize="@historyPageSize"
                                   asp-fragment="contract-history-section"
                                   class="px-3 py-1.5 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 font-medium transition-colors flex items-center gap-1">
                                    <span>Next</span>
                                    <span class="material-symbols-outlined text-[16px]">chevron_right</span>
                                </a>
                            }
                            else
                            {
                                <button type="button" disabled class="px-3 py-1.5 rounded-lg border border-slate-200 bg-slate-50 text-slate-400 font-medium cursor-not-allowed flex items-center gap-1">
                                    <span>Next</span>
                                    <span class="material-symbols-outlined text-[16px]">chevron_right</span>
                                </button>
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="py-10 text-center flex flex-col items-center justify-center text-slate-400">
                    <span class="material-symbols-outlined text-[48px] text-slate-300 mb-2">history_toggle_off</span>
                    <p class="text-sm font-semibold text-slate-700">No history events recorded for this contract yet.</p>
                    <p class="text-xs text-slate-500 mt-1">Submission, approval, change, and automated actions will be tracked here.</p>
                </div>
            }
        </div>
    </div>

</div>

<!-- Send Contract Modal -->
@if (isDraft)
{
    <div id="send-modal" class="fixed inset-0 z-50 hidden bg-slate-900/50 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl shadow-xl border border-slate-200 max-w-md w-full p-6 animate-scale-up">
            <div class="flex items-center gap-3 mb-4">
                <div class="p-2.5 bg-indigo-100 text-indigo-600 rounded-xl">
                    <span class="material-symbols-outlined text-[24px]">send</span>
                </div>
                <div>
                    <h3 class="text-lg font-bold text-slate-900">Send Contract to Staff</h3>
                    <p class="text-xs text-slate-500 font-mono mt-0.5">@Model.ContractNumber</p>
                </div>
            </div>

            <p class="text-sm text-slate-600 mb-5">
                Generating the official PDF document will transition the status to <strong>PENDING_STAFF</strong> and deliver the contract notification to the staff member. Are you sure you want to proceed?
            </p>

            <form method="post" asp-action="Send" onsubmit="disableSendBtn(this)">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.ContractId" />

                <div class="flex items-center justify-end gap-3">
                    <button type="button"
                            onclick="closeSendModal()"
                            class="px-4 py-2 border border-slate-200 text-slate-600 hover:bg-slate-100 rounded-xl text-sm font-medium transition-colors cursor-pointer">
                        Cancel
                    </button>
                    <button type="submit" id="confirm-send-btn"
                            class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl text-sm font-semibold transition-colors shadow-sm cursor-pointer inline-flex items-center gap-2">
                        <span class="material-symbols-outlined text-[18px]">send</span>
                        <span>Confirm & Send</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
}

<!-- Cancel Contract Modal -->
@if (isDraft)
{
    <div id="cancel-modal" class="fixed inset-0 z-50 hidden bg-slate-900/50 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl shadow-xl border border-slate-200 max-w-md w-full p-6 animate-scale-up">
            <div class="flex items-center gap-3 mb-4">
                <div class="p-2.5 bg-rose-100 text-rose-600 rounded-xl">
                    <span class="material-symbols-outlined text-[24px]">warning</span>
                </div>
                <div>
                    <h3 class="text-lg font-bold text-slate-900">Confirm Contract Draft Cancellation</h3>
                    <p class="text-xs text-slate-500 font-mono mt-0.5">@Model.ContractNumber</p>
                </div>
            </div>

            <p class="text-sm text-slate-600 mb-4">
                This contract will be transitioned to <strong>CANCELLED</strong>. This draft record cannot be edited or reactivated once cancelled.
            </p>

            <form method="post" asp-action="Cancel">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.ContractId" />

                <div class="mb-5">
                    <label for="cancel-reason" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-1.5">
                        Cancellation Reason <span class="text-rose-600">*</span>
                    </label>
                    <textarea id="cancel-reason"
                              name="reason"
                              rows="3"
                              required
                              placeholder="Enter cancellation reason for this draft contract..."
                              class="w-full px-3 py-2 border border-slate-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-rose-500 focus:border-rose-500"></textarea>
                </div>

                <div class="flex items-center justify-end gap-3">
                    <button type="button"
                            onclick="closeCancelModal()"
                            class="px-4 py-2 border border-slate-200 text-slate-600 hover:bg-slate-100 rounded-xl text-sm font-medium transition-colors cursor-pointer">
                        Close
                    </button>
                    <button type="submit"
                            class="px-4 py-2 bg-rose-600 hover:bg-rose-700 text-white rounded-xl text-sm font-semibold transition-colors shadow-sm cursor-pointer">
                        Confirm Cancel
                    </button>
                </div>
            </form>
        </div>
    </div>
}

<!-- Terminate Contract Modal -->
@if (statusUpper == "ACTIVE")
{
    <div id="terminate-modal" class="fixed inset-0 z-50 hidden bg-slate-900/50 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl shadow-xl border border-slate-200 max-w-lg w-full p-6 animate-scale-up">
            <div class="flex items-center gap-3 mb-4">
                <div class="p-2.5 bg-rose-100 text-rose-600 rounded-xl">
                    <span class="material-symbols-outlined text-[24px]">gavel</span>
                </div>
                <div>
                    <h3 class="text-lg font-bold text-slate-900">Chấm dứt hợp đồng trước thời hạn</h3>
                    <p class="text-xs text-slate-500 font-mono mt-0.5">@Model.ContractNumber &bull; @Model.EmployeeFullName</p>
                </div>
            </div>

            <div class="p-3.5 mb-4 rounded-xl bg-amber-50 border border-amber-200 flex items-start gap-2.5 text-xs text-amber-800">
                <span class="material-symbols-outlined text-amber-600 text-[18px] shrink-0 mt-0.5">warning</span>
                <span>
                    <strong>Cảnh báo:</strong> Thao tác này sẽ chấm dứt hợp đồng đang có hiệu lực. Trạng thái sẽ chuyển sang <strong>TERMINATED</strong>, nhân viên sẽ nhận thông báo hệ thống và không được phân ca làm việc sau ngày hiệu lực.
                </span>
            </div>

            <form method="post" asp-action="Terminate" onsubmit="disableTerminateBtn(this)">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.ContractId" />

                <div class="mb-4">
                    <label for="termination-effective-date" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-1.5">
                        Ngày có hiệu lực chấm dứt <span class="text-rose-600">*</span>
                    </label>
                    <input type="date"
                           id="termination-effective-date"
                           name="terminationEffectiveDate"
                           value="@DateTime.Now.ToString("yyyy-MM-dd")"
                           min="@Model.StartDate.ToString("yyyy-MM-dd")"
                           required
                           class="w-full px-3 py-2 border border-slate-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-rose-500 focus:border-rose-500" />
                    <p class="text-[11px] text-slate-500 mt-1">
                        Mặc định là ngày hôm nay. Không được chọn ngày trước ngày bắt đầu hợp đồng (@Model.StartDate.ToString("dd/MM/yyyy")).
                    </p>
                </div>

                <div class="mb-5">
                    <label for="terminate-reason" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-1.5">
                        Lý do chấm dứt hợp đồng <span class="text-rose-600">*</span>
                    </label>
                    <textarea id="terminate-reason"
                              name="reason"
                              rows="3"
                              required
                              maxlength="500"
                              placeholder="Nhập lý do chấm dứt hợp đồng trước hạn (tối đa 500 ký tự)..."
                              class="w-full px-3 py-2 border border-slate-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-rose-500 focus:border-rose-500"></textarea>
                    <p class="text-[11px] text-slate-400 mt-1">Bắt buộc nhập lý do để lưu lịch sử và thông báo cho nhân viên.</p>
                </div>

                <div class="flex items-center justify-end gap-3 pt-2 border-t border-slate-100">
                    <button type="button"
                            onclick="closeTerminateModal()"
                            class="px-4 py-2 border border-slate-200 text-slate-600 hover:bg-slate-100 rounded-xl text-sm font-medium transition-colors cursor-pointer">
                        Đóng
                    </button>
                    <button type="submit" id="confirm-terminate-btn"
                            class="inline-flex items-center gap-1.5 px-4 py-2 bg-rose-600 hover:bg-rose-700 text-white rounded-xl text-sm font-semibold transition-colors shadow-sm cursor-pointer">
                        <span class="material-symbols-outlined text-[18px]">gavel</span>
                        <span>Xác nhận chấm dứt</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
}

@section Scripts {
<script>
    function openSendModal() {
        var modal = document.getElementById('send-modal');
        if (modal) modal.classList.remove('hidden');
    }

    function closeSendModal() {
        var modal = document.getElementById('send-modal');
        if (modal) modal.classList.add('hidden');
    }

    function disableSendBtn(form) {
        var btn = document.getElementById('confirm-send-btn');
        if (btn) {
            btn.disabled = true;
            btn.innerHTML = '<span class="material-symbols-outlined animate-spin text-[18px]">progress_activity</span> Sending...';
        }
    }

    function openCancelModal() {
        var modal = document.getElementById('cancel-modal');
        if (modal) modal.classList.remove('hidden');
    }

    function closeCancelModal() {
        var modal = document.getElementById('cancel-modal');
        if (modal) modal.classList.add('hidden');
    }

    function openTerminateModal() {
        var modal = document.getElementById('terminate-modal');
        if (modal) modal.classList.remove('hidden');
    }

    function closeTerminateModal() {
        var modal = document.getElementById('terminate-modal');
        if (modal) modal.classList.add('hidden');
    }

    function disableTerminateBtn(form) {
        var btn = document.getElementById('confirm-terminate-btn');
        if (btn) {
            btn.disabled = true;
            btn.innerHTML = '<span class="material-symbols-outlined animate-spin text-[18px]">progress_activity</span> Đang xử lý...';
        }
    }

    window.onclick = function(event) {
        var sendModal = document.getElementById('send-modal');
        var cancelModal = document.getElementById('cancel-modal');
        var terminateModal = document.getElementById('terminate-modal');
        if (event.target === sendModal) closeSendModal();
        if (event.target === cancelModal) closeCancelModal();
        if (event.target === terminateModal) closeTerminateModal();
    }

    document.addEventListener('keydown', function(event) {
        if (event.key === 'Escape') {
            closeSendModal();
            closeCancelModal();
            closeTerminateModal();
        }
    });
</script>
}
