@model UI_Admin.Models.Manager.ManagerContractDetailViewModel
@{
    Layout = "_ManagerLayout";
    ViewData["Title"] = $"Contract {Model.ContractNumber} - Details";
    var statusUpper = Model.Status?.ToUpperInvariant() ?? "DRAFT";
    var isDraft = statusUpper == "DRAFT";
}

<div class="flex flex-col gap-6 max-w-5xl mx-auto">

    <!-- Top Navigation Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div class="flex items-center gap-3">
            <a asp-action="Index"
               class="inline-flex items-center justify-center w-10 h-10 rounded-xl bg-white border border-slate-200 hover:bg-slate-100 text-slate-700 transition-colors shrink-0"
               title="Back to contract list">
                <span class="material-symbols-outlined text-[20px]">arrow_back</span>
            </a>
            <div>
                <div class="flex items-center gap-2.5">
                    <h1 class="text-xl sm:text-2xl font-bold text-slate-900 tracking-tight">Contract Details</h1>
                    @switch (statusUpper)
                    {
                        case "DRAFT":
                            <span class="inline-flex items-center gap-1.5 px-3 py-0.5 rounded-full text-xs font-semibold bg-amber-50 text-amber-700 border border-amber-200">
                                <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>Draft
                            </span>
                            break;
                        case "PENDING_STAFF":
                            <span class="inline-flex items-center gap-1.5 px-3 py-0.5 rounded-full text-xs font-semibold bg-purple-50 text-purple-700 border border-purple-200">
                                <span class="w-1.5 h-1.5 rounded-full bg-purple-500 animate-pulse"></span>Pending Staff
                            </span>
                            break;
                        case "PENDING_MANAGER_APPROVAL":
                            <span class="inline-flex items-center gap-1.5 px-3 py-0.5 rounded-full text-xs font-semibold bg-blue-50 text-blue-700 border border-blue-200">
                                <span class="w-1.5 h-1.5 rounded-full bg-blue-500 animate-pulse"></span>Pending Approval
                            </span>
                            break;
                        case "ACTIVE":
                            <span class="inline-flex items-center gap-1.5 px-3 py-0.5 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
                                <span class="w-1.5 h-1.5 rounded-full bg-emerald-600 animate-pulse"></span>Active
                            </span>
                            break;
                        case "CANCELLED":
                            <span class="inline-flex items-center gap-1.5 px-3 py-0.5 rounded-full text-xs font-semibold bg-slate-100 text-slate-600 border border-slate-200">
                                <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>Cancelled
                            </span>
                            break;
                        case "REJECTED":
                            <span class="inline-flex items-center gap-1.5 px-3 py-0.5 rounded-full text-xs font-semibold bg-rose-50 text-rose-700 border border-rose-200">
                                <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>Rejected
                            </span>
                            break;
                        case "TERMINATED":
                            <span class="inline-flex items-center gap-1.5 px-3 py-0.5 rounded-full text-xs font-semibold bg-slate-100 text-slate-600 border border-slate-200">
                                <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>Terminated
                            </span>
                            break;
                        default:
                            <span class="inline-flex items-center gap-1.5 px-3 py-0.5 rounded-full text-xs font-semibold bg-slate-100 text-slate-600 border border-slate-200">
                                @Model.Status
                            </span>
                            break;
                    }
                </div>
                <p class="font-mono text-xs text-slate-500 mt-0.5">@Model.ContractNumber</p>
            </div>
        </div>

        <div class="flex items-center gap-2 flex-wrap">
            @if (isDraft)
            {
                <a asp-action="PreviewPdf" asp-route-id="@Model.ContractId" target="_blank"
                   class="inline-flex items-center gap-1.5 px-3.5 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-sm font-semibold rounded-xl transition-all">
                    <span class="material-symbols-outlined text-[18px]">picture_as_pdf</span>
                    <span>Preview PDF</span>
                </a>
                <button type="button"
                        onclick="openSendModal()"
                        class="inline-flex items-center gap-1.5 px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold rounded-xl shadow-sm transition-all cursor-pointer">
                    <span class="material-symbols-outlined text-[18px]">send</span>
                    <span>Send to Staff</span>
                </button>
                <a asp-action="Edit" asp-route-id="@Model.ContractId"
                   class="inline-flex items-center gap-1.5 px-3.5 py-2 bg-white border border-slate-200 hover:bg-slate-50 text-slate-700 text-sm font-semibold rounded-xl shadow-sm transition-all">
                    <span class="material-symbols-outlined text-[18px]">edit</span>
                    <span>Edit</span>
                </a>
                <button type="button"
                        onclick="openCancelModal()"
                        class="inline-flex items-center gap-1.5 px-3.5 py-2 bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 text-sm font-semibold rounded-xl transition-all cursor-pointer">
                    <span class="material-symbols-outlined text-[18px]">cancel</span>
                    <span>Cancel Draft</span>
                </button>
            }
            else
            {
                <a asp-action="Pdf" asp-route-id="@Model.ContractId" target="_blank"
                   class="inline-flex items-center gap-1.5 px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold rounded-xl shadow-sm transition-all">
                    <span class="material-symbols-outlined text-[18px]">visibility</span>
                    <span>View PDF</span>
                </a>
                <a asp-action="DownloadPdf" asp-route-id="@Model.ContractId"
                   class="inline-flex items-center gap-1.5 px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-sm font-semibold rounded-xl transition-all">
                    <span class="material-symbols-outlined text-[18px]">download</span>
                    <span>Download PDF</span>
                </a>
            }
        </div>
    </div>

    <!-- Cancellation / Rejection Banner -->
    @if (statusUpper == "CANCELLED" && !string.IsNullOrWhiteSpace(Model.TerminationReason))
    {
        <div class="p-4 rounded-2xl bg-amber-50 border border-amber-200 flex items-start gap-3">
            <span class="material-symbols-outlined text-amber-600 text-[22px] mt-0.5 shrink-0">cancel</span>
            <div>
                <p class="font-bold text-amber-800 text-sm">Contract has been cancelled</p>
                <p class="text-amber-700 text-xs mt-1">Reason: @Model.TerminationReason</p>
            </div>
        </div>
    }
    @if (statusUpper == "REJECTED" && !string.IsNullOrWhiteSpace(Model.ManagerRejectionComment))
    {
        <div class="p-4 rounded-2xl bg-rose-50 border border-rose-200 flex items-start gap-3">
            <span class="material-symbols-outlined text-rose-600 text-[22px] mt-0.5 shrink-0">block</span>
            <div>
                <p class="font-bold text-rose-800 text-sm">Contract has been rejected</p>
                <p class="text-rose-700 text-xs mt-1">Reason: @Model.ManagerRejectionComment</p>
            </div>
        </div>
    }

    <!-- Content Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

        <!-- Left Column: Contract & Terms (2 cols) -->
        <div class="lg:col-span-2 flex flex-col gap-6">

            <!-- Card: Contract Info -->
            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
                <div class="px-6 py-4 border-b border-slate-100 flex items-center gap-2">
                    <span class="material-symbols-outlined text-indigo-600 text-[20px]">description</span>
                    <h2 class="text-sm font-bold text-slate-900 uppercase tracking-wide">Contract Information</h2>
                </div>
                <div class="p-6 grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-4">
                    <div>
                        <p class="text-xs text-slate-500 font-medium">Contract Number</p>
                        <p class="font-mono text-sm font-bold text-slate-900 mt-0.5">@Model.ContractNumber</p>
                    </div>
                    <div>
                        <p class="text-xs text-slate-500 font-medium">Status</p>
                        <p class="text-sm font-semibold text-slate-900 mt-0.5">@Model.Status</p>
                    </div>
                    <div>
                        <p class="text-xs text-slate-500 font-medium">Start Date</p>
                        <p class="text-sm font-semibold text-slate-900 tabular-nums mt-0.5">@Model.StartDate.ToString("dd/MM/yyyy")</p>
                    </div>
                    <div>
                        <p class="text-xs text-slate-500 font-medium">End Date</p>
                        <p class="text-sm font-semibold text-slate-900 tabular-nums mt-0.5">
                            @(Model.EndDate.HasValue ? Model.EndDate.Value.ToString("dd/MM/yyyy") : "Indefinite")
                        </p>
                    </div>
                    <div>
                        <p class="text-xs text-slate-500 font-medium">Applicable Hourly Rate</p>
                        <p class="text-base font-extrabold text-indigo-600 tabular-nums mt-0.5">@Model.HourlyRate.ToString("N0") VND/hr</p>
                    </div>
                    <div>
                        <p class="text-xs text-slate-500 font-medium">Position / Title</p>
                        <p class="text-sm font-semibold text-slate-900 mt-0.5">@Model.EmployeePosition</p>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.ContractTerms))
                    {
                        <div class="sm:col-span-2 border-t border-slate-100 pt-4 mt-2">
                            <p class="text-xs text-slate-500 font-medium mb-1.5">Contract Terms</p>
                            <div class="p-4 rounded-xl bg-slate-50 border border-slate-100 text-sm text-slate-800 leading-relaxed whitespace-pre-line">
                                @Model.ContractTerms
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Card: Employee Snapshot -->
            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
                <div class="px-6 py-4 border-b border-slate-100 flex items-center gap-2">
                    <span class="material-symbols-outlined text-indigo-600 text-[20px]">person</span>
                    <h2 class="text-sm font-bold text-slate-900 uppercase tracking-wide">Staff Member Information (Snapshot)</h2>
                </div>
                <div class="p-6 grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-4">
                    <div>
                        <p class="text-xs text-slate-500 font-medium">Full Name</p>
                        <p class="text-sm font-bold text-slate-900 mt-0.5">@Model.EmployeeFullName</p>
                    </div>
                    <div>
                        <p class="text-xs text-slate-500 font-medium">Phone Number</p>
                        <p class="text-sm font-medium text-slate-900 mt-0.5">@(string.IsNullOrWhiteSpace(Model.EmployeePhone) ? "—" : Model.EmployeePhone)</p>
                    </div>
                    <div>
                        <p class="text-xs text-slate-500 font-medium">National ID / Citizen ID</p>
                        <p class="text-sm font-mono text-slate-900 mt-0.5">@(string.IsNullOrWhiteSpace(Model.EmployeeIdentityNo) ? "—" : Model.EmployeeIdentityNo)</p>
                    </div>
                    <div>
                        <p class="text-xs text-slate-500 font-medium">Staff User ID</p>
                        <p class="text-xs font-mono text-slate-600 mt-0.5">@Model.StaffUserId</p>
                    </div>
                    <div class="sm:col-span-2">
                        <p class="text-xs text-slate-500 font-medium">Residential Address</p>
                        <p class="text-sm text-slate-800 mt-0.5">@(string.IsNullOrWhiteSpace(Model.EmployeeAddress) ? "—" : Model.EmployeeAddress)</p>
                    </div>
                </div>
            </div>

        </div>

        <!-- Right Column: Location & Audit Info (1 col) -->
        <div class="flex flex-col gap-6">

            <!-- Card: Branch & Region Snapshot -->
            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
                <div class="px-6 py-4 border-b border-slate-100 flex items-center gap-2">
                    <span class="material-symbols-outlined text-indigo-600 text-[20px]">store</span>
                    <h2 class="text-sm font-bold text-slate-900 uppercase tracking-wide">Branch & Region</h2>
                </div>
                <div class="p-6 flex flex-col gap-4">
                    <div>
                        <p class="text-xs text-slate-500 font-medium">Managing Branch</p>
                        <p class="text-sm font-bold text-slate-900 mt-0.5">@Model.BranchName</p>
                        <p class="text-xs text-slate-500 mt-0.5">@Model.BranchAddress</p>
                    </div>
                    <div class="border-t border-slate-100 pt-3">
                        <p class="text-xs text-slate-500 font-medium">Region / Minimum Wage Zone</p>
                        <p class="text-sm font-semibold text-slate-900 mt-0.5">@Model.RegionName</p>
                    </div>
                </div>
            </div>

            <!-- Card: Audit Timestamps -->
            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
                <div class="px-6 py-4 border-b border-slate-100 flex items-center gap-2">
                    <span class="material-symbols-outlined text-indigo-600 text-[20px]">history</span>
                    <h2 class="text-sm font-bold text-slate-900 uppercase tracking-wide">Audit History</h2>
                </div>
                <div class="p-6 flex flex-col gap-3 text-xs text-slate-600">
                    <div class="flex items-center justify-between">
                        <span class="text-slate-500">Created At:</span>
                        <span class="font-medium text-slate-800">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                    </div>
                    <div class="flex items-center justify-between">
                        <span class="text-slate-500">Last Updated:</span>
                        <span class="font-medium text-slate-800">@Model.UpdatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                    </div>
                    <div class="flex items-center justify-between border-t border-slate-100 pt-2.5">
                        <span class="text-slate-500">Create Manager:</span>
                        <span class="font-semibold text-slate-800">
                            @(string.IsNullOrWhiteSpace(Model.CreatedByManagerName) ? Model.CreatedBy.ToString()[..8] + "…" : Model.CreatedByManagerName)
                        </span>
                    </div>
                </div>
            </div>

        </div>

    </div>

</div>

<!-- Send Contract Modal -->
@if (isDraft)
{
    <div id="send-modal" class="fixed inset-0 z-50 hidden bg-slate-900/50 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl shadow-xl border border-slate-200 max-w-md w-full p-6 animate-scale-up">
            <div class="flex items-center gap-3 mb-4">
                <div class="p-2.5 bg-indigo-100 text-indigo-600 rounded-xl">
                    <span class="material-symbols-outlined text-[24px]">send</span>
                </div>
                <div>
                    <h3 class="text-lg font-bold text-slate-900">Send Contract to Staff</h3>
                    <p class="text-xs text-slate-500 font-mono mt-0.5">@Model.ContractNumber</p>
                </div>
            </div>

            <p class="text-sm text-slate-600 mb-5">
                Generating the official PDF document will transition the status to <strong>PENDING_STAFF</strong> and deliver the contract notification to the staff member. Are you sure you want to proceed?
            </p>

            <form method="post" asp-action="Send" onsubmit="disableSendBtn(this)">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.ContractId" />

                <div class="flex items-center justify-end gap-3">
                    <button type="button"
                            onclick="closeSendModal()"
                            class="px-4 py-2 border border-slate-200 text-slate-600 hover:bg-slate-100 rounded-xl text-sm font-medium transition-colors cursor-pointer">
                        Cancel
                    </button>
                    <button type="submit" id="confirm-send-btn"
                            class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl text-sm font-semibold transition-colors shadow-sm cursor-pointer inline-flex items-center gap-2">
                        <span class="material-symbols-outlined text-[18px]">send</span>
                        <span>Confirm & Send</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
}

<!-- Cancel Contract Modal -->
@if (isDraft)
{
    <div id="cancel-modal" class="fixed inset-0 z-50 hidden bg-slate-900/50 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl shadow-xl border border-slate-200 max-w-md w-full p-6 animate-scale-up">
            <div class="flex items-center gap-3 mb-4">
                <div class="p-2.5 bg-rose-100 text-rose-600 rounded-xl">
                    <span class="material-symbols-outlined text-[24px]">warning</span>
                </div>
                <div>
                    <h3 class="text-lg font-bold text-slate-900">Confirm Contract Draft Cancellation</h3>
                    <p class="text-xs text-slate-500 font-mono mt-0.5">@Model.ContractNumber</p>
                </div>
            </div>

            <p class="text-sm text-slate-600 mb-4">
                This contract will be transitioned to <strong>CANCELLED</strong>. This draft record cannot be edited or reactivated once cancelled.
            </p>

            <form method="post" asp-action="Cancel">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.ContractId" />

                <div class="mb-5">
                    <label for="cancel-reason" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-1.5">
                        Cancellation Reason <span class="text-rose-600">*</span>
                    </label>
                    <textarea id="cancel-reason"
                              name="reason"
                              rows="3"
                              required
                              placeholder="Enter cancellation reason for this draft contract..."
                              class="w-full px-3 py-2 border border-slate-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-rose-500 focus:border-rose-500"></textarea>
                </div>

                <div class="flex items-center justify-end gap-3">
                    <button type="button"
                            onclick="closeCancelModal()"
                            class="px-4 py-2 border border-slate-200 text-slate-600 hover:bg-slate-100 rounded-xl text-sm font-medium transition-colors cursor-pointer">
                        Close
                    </button>
                    <button type="submit"
                            class="px-4 py-2 bg-rose-600 hover:bg-rose-700 text-white rounded-xl text-sm font-semibold transition-colors shadow-sm cursor-pointer">
                        Confirm Cancel
                    </button>
                </div>
            </form>
        </div>
    </div>
}

@section Scripts {
<script>
    function openSendModal() {
        var modal = document.getElementById('send-modal');
        if (modal) modal.classList.remove('hidden');
    }

    function closeSendModal() {
        var modal = document.getElementById('send-modal');
        if (modal) modal.classList.add('hidden');
    }

    function disableSendBtn(form) {
        var btn = document.getElementById('confirm-send-btn');
        if (btn) {
            btn.disabled = true;
            btn.innerHTML = '<span class="material-symbols-outlined animate-spin text-[18px]">progress_activity</span> Sending...';
        }
    }

    function openCancelModal() {
        var modal = document.getElementById('cancel-modal');
        if (modal) modal.classList.remove('hidden');
    }

    function closeCancelModal() {
        var modal = document.getElementById('cancel-modal');
        if (modal) modal.classList.add('hidden');
    }

    window.onclick = function(event) {
        var sendModal = document.getElementById('send-modal');
        var cancelModal = document.getElementById('cancel-modal');
        if (event.target === sendModal) closeSendModal();
        if (event.target === cancelModal) closeCancelModal();
    }
</script>
}
