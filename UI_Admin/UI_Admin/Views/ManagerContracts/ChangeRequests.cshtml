@model UI_Admin.Models.Manager.Contract.ManagerContractChangeRequestListViewModel
@{
    Layout = "_ManagerLayout";
    ViewData["Title"] = "Yêu cầu thay đổi hợp đồng";
    var items = Model.Items;
    var currentFilter = string.IsNullOrWhiteSpace(Model.StatusFilter) ? "SUBMITTED" : Model.StatusFilter.ToUpperInvariant();
}

<div class="flex flex-col gap-6">

    <!-- Header Section -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-3">
                <div class="p-2.5 bg-amber-50 text-amber-600 rounded-xl">
                    <span class="material-symbols-outlined text-[28px]">pending_actions</span>
                </div>
                <div>
                    <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Yêu cầu thay đổi hợp đồng</h1>
                    <p class="text-slate-500 text-sm mt-0.5">Xem xét và xử lý các đề xuất điều chỉnh điều khoản hợp đồng từ nhân viên chi nhánh.</p>
                </div>
            </div>
        </div>
        <div class="flex items-center gap-3">
            <a asp-action="Index" class="inline-flex items-center gap-2 px-4 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 text-sm font-semibold rounded-xl transition-all">
                <span class="material-symbols-outlined text-[20px]">contract</span>
                <span>Danh sách hợp đồng</span>
            </a>
        </div>
    </div>

    <!-- Alert Notifications -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm flex items-center justify-between shadow-sm">
            <div class="flex items-center gap-2.5">
                <span class="material-symbols-outlined text-emerald-600 text-[22px]">check_circle</span>
                <span>@TempData["SuccessMessage"]</span>
            </div>
            <button type="button" onclick="this.parentElement.remove()" class="text-emerald-500 hover:text-emerald-700 font-bold text-lg">&times;</button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-sm flex items-center justify-between shadow-sm">
            <div class="flex items-center gap-2.5">
                <span class="material-symbols-outlined text-rose-600 text-[22px]">error</span>
                <span>@TempData["ErrorMessage"]</span>
            </div>
            <button type="button" onclick="this.parentElement.remove()" class="text-rose-500 hover:text-rose-700 font-bold text-lg">&times;</button>
        </div>
    }

    <!-- Status Tabs -->
    <div class="bg-white rounded-2xl p-2 shadow-sm border border-slate-200 flex flex-wrap gap-1">
        <a asp-action="ChangeRequests" asp-route-status="SUBMITTED"
           class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-bold transition-all @(currentFilter == "SUBMITTED" ? "bg-amber-500 text-white shadow-sm" : "text-slate-600 hover:bg-slate-100")">
            <span class="material-symbols-outlined text-[18px]">hourglass_top</span>
            <span>Chờ xử lý (SUBMITTED)</span>
        </a>
        <a asp-action="ChangeRequests" asp-route-status="APPROVED"
           class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-bold transition-all @(currentFilter == "APPROVED" ? "bg-emerald-600 text-white shadow-sm" : "text-slate-600 hover:bg-slate-100")">
            <span class="material-symbols-outlined text-[18px]">check_circle</span>
            <span>Đã chấp thuận</span>
        </a>
        <a asp-action="ChangeRequests" asp-route-status="REJECTED"
           class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-bold transition-all @(currentFilter == "REJECTED" ? "bg-rose-600 text-white shadow-sm" : "text-slate-600 hover:bg-slate-100")">
            <span class="material-symbols-outlined text-[18px]">cancel</span>
            <span>Đã từ chối</span>
        </a>
        <a asp-action="ChangeRequests" asp-route-status="all"
           class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-bold transition-all @(currentFilter == "ALL" ? "bg-slate-800 text-white shadow-sm" : "text-slate-600 hover:bg-slate-100")">
            <span class="material-symbols-outlined text-[18px]">list</span>
            <span>Tất cả</span>
        </a>
    </div>

    <!-- Table Section -->
    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
        @if (items == null || items.Count == 0)
        {
            <div class="p-12 text-center">
                <div class="w-16 h-16 rounded-full bg-slate-100 text-slate-400 flex items-center justify-center mx-auto mb-3">
                    <span class="material-symbols-outlined text-[32px]">folder_off</span>
                </div>
                <h3 class="text-base font-bold text-slate-800">Không có yêu cầu thay đổi nào</h3>
                <p class="text-xs text-slate-500 mt-1 max-w-sm mx-auto">
                    Hiện không có yêu cầu thay đổi hợp đồng nào phù hợp với bộ lọc đã chọn.
                </p>
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse text-xs">
                    <thead>
                        <tr class="bg-slate-50/80 border-b border-slate-200 text-slate-500 font-semibold uppercase tracking-wider text-[11px]">
                            <th class="py-3 px-4">Mã Yêu Cầu</th>
                            <th class="py-3 px-4">Hợp Đồng</th>
                            <th class="py-3 px-4">Nhân Viên</th>
                            <th class="py-3 px-4">Nội Dung Đề Xuất</th>
                            <th class="py-3 px-4">Thời Điểm Gửi</th>
                            <th class="py-3 px-4">Trạng Thái</th>
                            <th class="py-3 px-4 text-right">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @foreach (var cr in items)
                        {
                            <tr class="hover:bg-slate-50/60 transition-colors">
                                <td class="py-3.5 px-4 font-mono font-bold text-slate-900">
                                    #@cr.ChangeRequestId
                                </td>
                                <td class="py-3.5 px-4">
                                    <a asp-action="Details" asp-route-id="@cr.ContractId" class="font-semibold text-indigo-600 hover:text-indigo-800 hover:underline">
                                        @cr.ContractNumber
                                    </a>
                                </td>
                                <td class="py-3.5 px-4">
                                    <div class="font-bold text-slate-900">@cr.StaffFullName</div>
                                </td>
                                <td class="py-3.5 px-4">
                                    <div class="space-y-1 max-w-xs">
                                        <div class="font-semibold text-slate-700">@cr.FieldsSummary</div>
                                        @if (!string.IsNullOrEmpty(cr.StaffComment))
                                        {
                                            <p class="text-[11px] text-slate-500 truncate" title="@cr.StaffComment">
                                                "@cr.StaffComment"
                                            </p>
                                        }
                                    </div>
                                </td>
                                <td class="py-3.5 px-4 text-slate-500 tabular-nums">
                                    @(cr.SubmittedAt?.ToString("dd/MM/yyyy HH:mm") ?? cr.CreatedAt.ToString("dd/MM/yyyy HH:mm"))
                                </td>
                                <td class="py-3.5 px-4">
                                    @switch (cr.Status.ToUpperInvariant())
                                    {
                                        case "SUBMITTED":
                                            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-bold bg-amber-50 text-amber-700 border border-amber-200">
                                                <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span>
                                                Chờ xử lý
                                            </span>
                                            break;
                                        case "APPROVED":
                                            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                                                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                                                Đã duyệt
                                            </span>
                                            break;
                                        case "REJECTED":
                                            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-bold bg-rose-50 text-rose-700 border border-rose-200">
                                                <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>
                                                Từ chối
                                            </span>
                                            break;
                                        default:
                                            <span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-slate-100 text-slate-700">
                                                @cr.Status
                                            </span>
                                            break;
                                    }
                                </td>
                                <td class="py-3.5 px-4 text-right">
                                    <a asp-action="ChangeRequestDetails" asp-route-id="@cr.ChangeRequestId"
                                       class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold @(cr.Status == "SUBMITTED" ? "bg-indigo-600 hover:bg-indigo-700 text-white shadow-sm" : "bg-slate-100 hover:bg-slate-200 text-slate-700") transition-colors">
                                        <span class="material-symbols-outlined text-[16px]">visibility</span>
                                        <span>@(cr.Status == "SUBMITTED" ? "Xử lý" : "Chi tiết")</span>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination Bar -->
            @if (Model.TotalPages > 1)
            {
                <div class="p-4 border-t border-slate-200 flex items-center justify-between text-xs text-slate-500">
                    <div>Hiển thị trang @Model.PageNumber / @Model.TotalPages (Tổng cộng @Model.TotalItems yêu cầu)</div>
                    <div class="flex items-center gap-1">
                        @if (Model.PageNumber > 1)
                        {
                            <a asp-action="ChangeRequests" asp-route-status="@Model.StatusFilter" asp-route-page="@(Model.PageNumber - 1)"
                               class="px-3 py-1.5 rounded-lg border border-slate-200 hover:bg-slate-50 font-medium text-slate-700">Trước</a>
                        }
                        @for (var p = 1; p <= Model.TotalPages; p++)
                        {
                            if (p == Model.PageNumber)
                            {
                                <span class="px-3 py-1.5 rounded-lg bg-indigo-600 font-bold text-white">@p</span>
                            }
                            else if (p == 1 || p == Model.TotalPages || Math.Abs(p - Model.PageNumber) <= 2)
                            {
                                <a asp-action="ChangeRequests" asp-route-status="@Model.StatusFilter" asp-route-page="@p"
                                   class="px-3 py-1.5 rounded-lg border border-slate-200 hover:bg-slate-50 font-medium text-slate-700">@p</a>
                            }
                        }
                        @if (Model.PageNumber < Model.TotalPages)
                        {
                            <a asp-action="ChangeRequests" asp-route-status="@Model.StatusFilter" asp-route-page="@(Model.PageNumber + 1)"
                               class="px-3 py-1.5 rounded-lg border border-slate-200 hover:bg-slate-50 font-medium text-slate-700">Sau</a>
                        }
                    </div>
                </div>
            }
        }
    </div>
</div>
