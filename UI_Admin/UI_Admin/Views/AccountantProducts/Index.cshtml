@model UI_Admin.Models.Accountant.AccountantProductListViewModel

@{
    ViewData["Title"] = "Products";
    var canWrite = false; // Accountant is read-only
}

<div class="flex flex-col w-full gap-unit-4 px-7 py-4">

    <partial name="_NotificationModal" />

    <!-- Header Title & Action Bar -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-unit-4">
        <div class="flex flex-col">
            <div class="list-eyebrow">Product Catalog</div>
            <div class="flex items-center gap-unit-3">
                <h1 class="font-display-lg text-display-lg text-on-surface tracking-tight">Products</h1>
            </div>
            <p class="font-body-md text-body-md text-secondary mt-1">View sellable products, pricing and availability across all branches. Read-only access for Accountant role.</p>
        </div>
    </div>

    <partial name="_ListMetrics" model='@(new ListMetricViewModel[] {
new("Matching Products", Model.TotalItems.ToString("N0"), "Matching current filters", "inventory_2", "#4f46e5"),
new("Active Products", Model.Items.Count(x => x.Status == "ACTIVE").ToString("N0"), "On this page", "check_circle", "#10b981"),
new("Inactive Products", Model.Items.Count(x => x.Status == "INACTIVE").ToString("N0"), "On this page", "pause_circle", "#f59e0b"),
new("Categories", Model.Categories.Count.ToString("N0"), "Available for filtering", "category", "#8b5cf6"),
new("Branches", Model.Branches.Count.ToString("N0"), "Available for filtering", "location_on", "#10b981")
})' />
    <!-- Filter Toolbar -->
    <form method="get" asp-controller="AccountantProducts" asp-action="Index" id="filter-form" class="flex flex-col lg:flex-row items-stretch lg:items-center justify-between gap-unit-3 p-unit-4 bg-surface-container-lowest rounded-xl shadow-sm">
        <div class="flex flex-1 flex-col sm:flex-row items-stretch sm:items-center gap-unit-3">
            <!-- Search Input -->
            <div class="relative flex-1">
                <span class="material-symbols-outlined absolute left-unit-3 top-1/2 -translate-y-1/2 text-[18px] text-secondary">search</span>
                <input class="w-full h-[40px] pl-9 pr-unit-3 bg-surface-container-lowest border border-surface-container-high rounded-xl text-on-surface font-body-md text-body-md placeholder:text-secondary focus:outline-none focus:ring-1 focus:ring-primary-container"
                       id="product-search"
                       name="search"
                       value="@Model.Search"
                       placeholder="Search product code or name..."
                       type="text">
            </div>
            <!-- Branch Filter Dropdown -->
            @if (Model.Branches.Count > 0)
            {
                <div class="relative sm:w-56">
                    <select class="w-full h-[40px] px-unit-3 appearance-none bg-surface-container-lowest border border-surface-container-high rounded-xl text-on-surface font-body-md text-body-md focus:outline-none focus:ring-1 focus:ring-primary-container pr-8 cursor-pointer"
                            id="branch-filter"
                            name="branchId"
                            onchange="this.form.submit()">
                        <option value="">All Branches</option>
                        @foreach (var branch in Model.Branches)
                        {
                            <option value="@branch.Id" selected="@(Model.BranchId == branch.Id)">@branch.Name</option>
                        }
                    </select>
                    <span class="material-symbols-outlined absolute right-unit-3 top-1/2 -translate-y-1/2 pointer-events-none text-[18px] text-secondary">expand_more</span>
                </div>
            }
            <!-- Category Filter Dropdown -->
            <div class="relative sm:w-56">
                <select class="w-full h-[40px] px-unit-3 appearance-none bg-surface-container-lowest border border-surface-container-high rounded-xl text-on-surface font-body-md text-body-md focus:outline-none focus:ring-1 focus:ring-primary-container pr-8 cursor-pointer"
                        id="category-filter"
                        name="categoryId"
                        onchange="this.form.submit()">
                    <option value="">All Categories</option>
                    @foreach (var category in Model.Categories)
                    {
                        <option value="@category.Id" selected="@(Model.CategoryId == category.Id)">@category.Name</option>
                    }
                </select>
                <span class="material-symbols-outlined absolute right-unit-3 top-1/2 -translate-y-1/2 pointer-events-none text-[18px] text-secondary">expand_more</span>
            </div>
            <!-- Status Filter Dropdown -->
            <div class="relative sm:w-48">
                <select class="w-full h-[40px] px-unit-3 appearance-none bg-surface-container-lowest border border-surface-container-high rounded-xl text-on-surface font-body-md text-body-md focus:outline-none focus:ring-1 focus:ring-primary-container pr-8 cursor-pointer"
                        id="status-filter"
                        name="status"
                        onchange="this.form.submit()">
                    <option value="all" selected="@(Model.StatusFilter == "all")">All Statuses</option>
                    <option value="active" selected="@(Model.StatusFilter == "active")">Active</option>
                    <option value="inactive" selected="@(Model.StatusFilter == "inactive")">Inactive</option>
                </select>
                <span class="material-symbols-outlined absolute right-unit-3 top-1/2 -translate-y-1/2 pointer-events-none text-[18px] text-secondary">expand_more</span>
            </div>
        </div>
        <partial name="_ListFilterActions" model='"Index"' />
    </form>

    <!-- Main Table Container -->
    <div class="bg-surface-container-lowest rounded-xl shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left">
                <thead>
                    <tr class="h-[40px] bg-surface-container-low text-secondary text-label-md font-label-md uppercase tracking-wider">
                        <th class="px-unit-5 py-2" scope="col">Product Code</th>
                        <th class="px-unit-4 py-2" scope="col">Product Name</th>
                        <th class="px-unit-4 py-2" scope="col">Branch</th>
                        <th class="px-unit-4 py-2" scope="col">Category</th>
                        <th class="px-unit-4 py-2 text-right" scope="col">Price</th>
                        <th class="px-unit-4 py-2" scope="col">Status</th>
                        <th class="px-unit-5 py-2 text-right" scope="col">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y-0" id="products-table-body">
                    @if (Model.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="px-unit-5 py-8 text-center text-secondary font-body-md">
                                No products found matching your filter criteria.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Items)
                        {
                            var isActive = item.Status.Equals("ACTIVE", StringComparison.OrdinalIgnoreCase);
                            <tr class="h-[56px] hover:bg-surface-container-low transition-colors group @(!isActive ? "bg-surface-container-lowest/70" : "")">
                                <td class="px-unit-5 py-2">
                                    <span class="font-code-num text-code-num @(isActive ? "text-primary" : "text-secondary") font-semibold bg-surface-container px-2 py-1 rounded">@item.ProductCode</span>
                                </td>
                                <td class="px-unit-4 py-2 font-body-md-medium text-body-md-medium @(isActive ? "text-on-surface" : "text-secondary")">
                                    @item.ProductName
                                </td>
                                <td class="px-unit-4 py-2 font-body-md text-body-md text-secondary whitespace-nowrap">
                                    @item.BranchName
                                </td>
                                <td class="px-unit-4 py-2 font-body-md text-body-md text-secondary whitespace-nowrap">
                                    @item.CategoryName
                                </td>
                                <td class="px-unit-4 py-2 font-code-num text-code-num @(isActive ? "text-on-surface" : "text-secondary") text-right whitespace-nowrap">
                                    @UI_Admin.Helpers.CurrencyHelper.FormatVnd(item.Price)
                                </td>
                                <td class="px-unit-4 py-2 whitespace-nowrap">
                                    @if (isActive)
                                    {
                                        <span class="inline-flex items-center gap-1.5 h-6 px-2 rounded-full text-label-sm font-label-sm bg-emerald-50 text-emerald-700">
                                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1.5 h-6 px-2 rounded-full text-label-sm font-label-sm bg-surface-container text-secondary">
                                            <span class="w-1.5 h-1.5 rounded-full bg-secondary"></span>
                                            Inactive
                                        </span>
                                    }
                                </td>
                                <td class="px-unit-5 py-2 text-right whitespace-nowrap">
                                    <div class="inline-flex items-center justify-end gap-2">
                                        <a href="@Url.Action("Details", "AccountantProducts", new { id = item.ProductId })" class="inline-flex items-center justify-center h-8 px-unit-3 rounded-lg text-primary hover:bg-surface-container font-body-md-medium text-body-sm transition-colors">View Details</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <!-- Pagination / Footer Bar -->
        <partial name="_ListPagination" model="@(new ListPaginationViewModel
        {
            PageNumber = Model.PageNumber,
            PageSize = Model.PageSize,
            TotalItems = Model.TotalItems,
            ItemLabel = "products",
        })" />
    </div>

</div>