@model UI_Admin.Models.Manager.Timesheet.ManagerWeeklyTimesheetDetailViewModel
@{
    Layout = "_ManagerLayout";
    ViewData["Title"] = $"Week {Model.Period} Details";
    var isNotGenerated = string.Equals(Model.Status, "NOT GENERATED", StringComparison.OrdinalIgnoreCase);
    var isGenerated = string.Equals(Model.Status, "GENERATED", StringComparison.OrdinalIgnoreCase);
    var isLocked = string.Equals(Model.Status, "LOCKED", StringComparison.OrdinalIgnoreCase);
}

<div class="px-7 py-6 max-w-[1400px] mx-auto space-y-6">
    <!-- Header Title & Action Bar -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-1.5 text-xs text-indigo-600 font-semibold uppercase tracking-wider mb-1">
                <a asp-action="Index" class="hover:underline flex items-center gap-1">
                    <span class="material-symbols-outlined text-sm">table_chart</span>
                    <span>Weekly Timesheets</span>
                </a>
                <span>/</span>
                <span class="text-slate-400">Week @Model.Period Details</span>
            </div>
            <div class="flex items-center gap-3">
                <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Week @Model.Period</h1>
                
                <!-- Status Badge -->
                @if (isLocked)
                {
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                        <span>LOCKED</span>
                    </span>
                }
                else if (isGenerated)
                {
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-amber-50 text-amber-700 border border-amber-200">
                        <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
                        <span>GENERATED</span>
                    </span>
                }
                else
                {
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-slate-100 text-slate-600 border border-slate-200">
                        <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
                        <span>NOT GENERATED</span>
                    </span>
                }
            </div>
            <p class="text-sm text-slate-500 mt-1 flex items-center gap-2">
                <span>Branch: <strong class="text-slate-700">@Model.BranchName</strong></span>
                <span>•</span>
                <span>Schedule: <strong class="text-slate-700">@Model.WeekStartDate.ToString("dd/MM/yyyy") – @Model.WeekEndDate.ToString("dd/MM/yyyy")</strong></span>
            </p>
        </div>

        <!-- Action Buttons -->
        <div class="flex items-center gap-3">
            <a asp-action="Index" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-white hover:bg-slate-50 text-slate-700 hover:text-slate-900 border border-slate-200 text-sm font-semibold transition-all shadow-sm">
                <span class="material-symbols-outlined text-lg">arrow_back</span>
                <span>Back to List</span>
            </a>

            @if (Model.CanGenerateTimesheet)
            {
                <!-- Ready Button: Generate Timesheet (UI button placed as requested, backend processing to follow) -->
                <button type="button" id="btnGenerateTimesheet"
                        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 active:bg-indigo-800 text-white text-sm font-semibold shadow-sm transition-all cursor-pointer">
                    <span class="material-symbols-outlined text-lg">auto_awesome</span>
                    <span>Generate Timesheet</span>
                </button>
            }
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm flex items-center gap-3 shadow-sm">
            <span class="material-symbols-outlined text-emerald-600">check_circle</span>
            <span>@Model.SuccessMessage</span>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-sm flex items-center gap-3 shadow-sm">
            <span class="material-symbols-outlined text-rose-600">error</span>
            <span>@Model.ErrorMessage</span>
        </div>
    }

    @if (isNotGenerated)
    {
        <!-- Informational banner for NOT GENERATED state -->
        <div class="p-4 rounded-2xl bg-amber-50/80 border border-amber-200 text-amber-900 text-sm flex items-start gap-3.5 shadow-sm">
            <span class="material-symbols-outlined text-amber-600 text-xl shrink-0 mt-0.5">info</span>
            <div>
                <p class="font-bold text-amber-900">Timesheet Not Generated Yet</p>
                <p class="text-xs text-amber-800 mt-0.5">
                    This week has active shift schedules but attendance records have not been compiled into a timesheet batch. 
                    Review the assigned staff list below and click <strong class="font-semibold text-amber-950">Generate Timesheet</strong> to create attendance records.
                </p>
            </div>
        </div>
    }

    <!-- Metric Cards Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- Card 1: Total Staff -->
        <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-indigo-50 border border-indigo-100 flex items-center justify-center text-indigo-600 shrink-0">
                <span class="material-symbols-outlined text-2xl">groups</span>
            </div>
            <div>
                <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider block">Total Staff</span>
                <span class="text-xl font-bold text-slate-900">@Model.TotalStaff</span>
                <span class="text-[11px] text-slate-400 block mt-0.5">Assigned to shifts</span>
            </div>
        </div>

        <!-- Card 2: Staff Confirmation -->
        <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-emerald-50 border border-emerald-100 flex items-center justify-center text-emerald-600 shrink-0">
                <span class="material-symbols-outlined text-2xl">verified</span>
            </div>
            <div>
                <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider block">Staff Confirmation</span>
                @if (isNotGenerated)
                {
                    <span class="text-xl font-bold text-slate-400">-</span>
                    <span class="text-[11px] text-slate-400 block mt-0.5">Pending generation</span>
                }
                else
                {
                    <span class="text-xl font-bold text-slate-900">@Model.ConfirmedStaff / @Model.TotalStaff</span>
                    <span class="text-[11px] text-emerald-600 font-semibold block mt-0.5">@Model.ConfirmationRate% confirmed</span>
                }
            </div>
        </div>

        <!-- Card 3: Total Work Hours -->
        <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-blue-50 border border-blue-100 flex items-center justify-center text-blue-600 shrink-0">
                <span class="material-symbols-outlined text-2xl">schedule</span>
            </div>
            <div>
                <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider block">Total Work Hours</span>
                @if (isNotGenerated)
                {
                    <span class="text-xl font-bold text-slate-400">-</span>
                    <span class="text-[11px] text-slate-400 block mt-0.5">Pending computation</span>
                }
                else
                {
                    <span class="text-xl font-bold text-slate-900">@Model.TotalWorkHours.ToString("N1") hrs</span>
                    <span class="text-[11px] text-slate-400 block mt-0.5">Compiled work time</span>
                }
            </div>
        </div>

        <!-- Card 4: Total Late Minutes -->
        <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-amber-50 border border-amber-100 flex items-center justify-center text-amber-600 shrink-0">
                <span class="material-symbols-outlined text-2xl">alarm_off</span>
            </div>
            <div>
                <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider block">Total Late Time</span>
                @if (isNotGenerated)
                {
                    <span class="text-xl font-bold text-slate-400">-</span>
                    <span class="text-[11px] text-slate-400 block mt-0.5">Pending computation</span>
                }
                else
                {
                    <span class="text-xl font-bold text-slate-900">@Model.TotalLateMinutes mins</span>
                    <span class="text-[11px] text-amber-600 font-semibold block mt-0.5">Attendance deviations</span>
                }
            </div>
        </div>
    </div>

    <!-- Staff Timesheet Table Card -->
    <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden">
        <div class="px-6 py-4 border-b border-slate-150 flex items-center justify-between bg-slate-50/60">
            <div class="flex items-center gap-2.5">
                <span class="material-symbols-outlined text-indigo-600 text-xl">badge</span>
                <h2 class="text-sm font-bold text-slate-900">Staff Weekly Timesheet Records</h2>
                <span class="ml-2 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-indigo-50 text-indigo-700 border border-indigo-200">
                    @Model.StaffTimesheets.Count Staff Members
                </span>
            </div>
            <span class="text-xs text-slate-500 font-medium">Timezone: Vietnam (UTC+7)</span>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm text-slate-700">
                <thead class="bg-slate-50 text-xs font-semibold text-slate-500 uppercase tracking-wider border-b border-slate-200">
                    <tr>
                        <th scope="col" class="px-6 py-3.5">Staff Member</th>
                        <th scope="col" class="px-6 py-3.5">Role</th>
                        <th scope="col" class="px-6 py-3.5 text-center">Assigned Shifts</th>
                        <th scope="col" class="px-6 py-3.5 text-center">Completed Shifts</th>
                        <th scope="col" class="px-6 py-3.5 text-center">Work Hours</th>
                        <th scope="col" class="px-6 py-3.5 text-center">Late (Mins)</th>
                        <th scope="col" class="px-6 py-3.5 text-center">Confirmation</th>
                        <th scope="col" class="px-6 py-3.5 text-right">Status</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 font-medium">
                    @if (Model.StaffTimesheets == null || Model.StaffTimesheets.Count == 0)
                    {
                        <tr>
                            <td colspan="8" class="px-6 py-12 text-center text-slate-400">
                                <div class="flex flex-col items-center justify-center gap-3">
                                    <div class="w-14 h-14 rounded-2xl bg-slate-100 flex items-center justify-center text-slate-400">
                                        <span class="material-symbols-outlined text-3xl">person_off</span>
                                    </div>
                                    <div class="text-base font-semibold text-slate-700">No Staff Assigned In This Week</div>
                                    <p class="text-xs text-slate-400 max-w-sm">No shift assignments or timesheet records found for this week period.</p>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var staff in Model.StaffTimesheets)
                        {
                            var isStaffConfirmed = string.Equals(staff.StaffReviewStatus, "CONFIRMED", StringComparison.OrdinalIgnoreCase);

                            <tr class="hover:bg-slate-50/80 transition-colors">
                                <!-- Staff Member -->
                                <td class="px-6 py-4">
                                    <div class="flex items-center gap-3">
                                        <div class="w-9 h-9 rounded-full bg-slate-100 border border-slate-200 flex items-center justify-center font-bold text-slate-700 text-xs">
                                            @(string.IsNullOrWhiteSpace(staff.FullName) ? "U" : staff.FullName[..1].ToUpper())
                                        </div>
                                        <div class="flex flex-col">
                                            <span class="font-bold text-slate-900 text-sm">@staff.FullName</span>
                                            <span class="text-xs text-slate-400 mt-0.5">@(staff.Email ?? staff.Phone ?? "No contact")</span>
                                        </div>
                                    </div>
                                </td>

                                <!-- Role -->
                                <td class="px-6 py-4">
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-slate-100 text-slate-700 border border-slate-200">
                                        @(staff.RoleName ?? "Staff")
                                    </span>
                                </td>

                                <!-- Assigned Shifts -->
                                <td class="px-6 py-4 text-center">
                                    <span class="font-semibold text-slate-800">@staff.TotalAssignedShifts</span>
                                </td>

                                <!-- Completed Shifts -->
                                <td class="px-6 py-4 text-center">
                                    @if (isNotGenerated)
                                    {
                                        <span class="text-slate-400">-</span>
                                    }
                                    else
                                    {
                                        <span class="font-semibold text-slate-800">@staff.CompletedShifts</span>
                                    }
                                </td>

                                <!-- Work Hours -->
                                <td class="px-6 py-4 text-center">
                                    @if (isNotGenerated)
                                    {
                                        <span class="text-slate-400">-</span>
                                    }
                                    else
                                    {
                                        <span class="font-bold text-slate-900">@staff.TotalWorkHours.ToString("N1") hrs</span>
                                    }
                                </td>

                                <!-- Late (Mins) -->
                                <td class="px-6 py-4 text-center">
                                    @if (isNotGenerated)
                                    {
                                        <span class="text-slate-400">-</span>
                                    }
                                    else
                                    {
                                        <span class="@(staff.TotalLateMinutes > 0 ? "text-amber-600 font-bold" : "text-slate-500 font-semibold")">
                                            @staff.TotalLateMinutes m
                                        </span>
                                    }
                                </td>

                                <!-- Confirmation -->
                                <td class="px-6 py-4 text-center">
                                    @if (isNotGenerated || staff.StaffReviewStatus == "-")
                                    {
                                        <span class="text-slate-400">-</span>
                                    }
                                    else if (isStaffConfirmed)
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                                            <span class="material-symbols-outlined text-xs">check</span>
                                            <span>CONFIRMED</span>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-bold bg-amber-50 text-amber-700 border border-amber-200">
                                            <span class="material-symbols-outlined text-xs">schedule</span>
                                            <span>PENDING</span>
                                        </span>
                                    }
                                </td>

                                <!-- Status -->
                                <td class="px-6 py-4 text-right">
                                    @if (isNotGenerated)
                                    {
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-slate-100 text-slate-600 border border-slate-200">
                                            NOT GENERATED
                                        </span>
                                    }
                                    else if (string.Equals(staff.Status, "LOCKED", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                                            LOCKED
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-amber-50 text-amber-700 border border-amber-200">
                                            GENERATED
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const btnGenerate = document.getElementById('btnGenerateTimesheet');
        if (btnGenerate) {
            btnGenerate.addEventListener('click', () => {
                alert('The "Generate Timesheet" button is ready. The generation logic will be connected in the next step.');
            });
        }
    </script>
}
