@model UI_Admin.Models.Manager.Timesheet.ManagerTimesheetListViewModel
@{
    Layout = "_ManagerLayout";
    ViewData["Title"] = "Weekly Timesheets";
    var selectedPeriod = Model.AvailablePeriods?.FirstOrDefault(p => p.ScheduleWeekId == Model.ScheduleWeekId);
}

<div class="px-7 py-6 max-w-[1400px] mx-auto space-y-6">
    <!-- Header Title & Action Bar -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-1.5 text-xs text-indigo-600 font-semibold uppercase tracking-wider mb-1">
                <span class="material-symbols-outlined text-sm">table_chart</span>
                <span>Manager / Attendance &amp; Timesheets</span>
            </div>
            <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Weekly Timesheets</h1>
            <p class="text-sm text-slate-500 mt-0.5">Track weekly attendance batches, staff confirmation progress, and finalize branch timesheets.</p>
        </div>
        <div class="flex items-center gap-3">
            <a asp-action="Index" class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-white hover:bg-slate-50 text-slate-700 hover:text-slate-900 border border-slate-200 text-sm font-medium transition-all shadow-sm">
                <span class="material-symbols-outlined text-lg">refresh</span>
                <span>Refresh</span>
            </a>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div id="alertSuccessBanner" class="p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm flex items-center justify-between gap-3 shadow-sm transition-all duration-300">
            <div class="flex items-center gap-3">
                <span class="material-symbols-outlined text-emerald-600 text-xl shrink-0">check_circle</span>
                <span class="font-medium">@Model.SuccessMessage</span>
            </div>
            <button type="button" aria-label="Close message" onclick="document.getElementById('alertSuccessBanner')?.remove()" class="text-emerald-600 hover:text-emerald-950 hover:bg-emerald-100/70 p-1.5 rounded-lg transition-colors cursor-pointer shrink-0 inline-flex items-center justify-center">
                <span class="material-symbols-outlined text-lg leading-none block">close</span>
            </button>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div id="alertErrorBanner" class="p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-sm flex items-center justify-between gap-3 shadow-sm transition-all duration-300">
            <div class="flex items-center gap-3">
                <span class="material-symbols-outlined text-rose-600 text-xl shrink-0">error</span>
                <span class="font-medium">@Model.ErrorMessage</span>
            </div>
            <button type="button" aria-label="Close message" onclick="document.getElementById('alertErrorBanner')?.remove()" class="text-rose-600 hover:text-rose-950 hover:bg-rose-100/70 p-1.5 rounded-lg transition-colors cursor-pointer shrink-0 inline-flex items-center justify-center">
                <span class="material-symbols-outlined text-lg leading-none block">close</span>
            </button>
        </div>
    }

    <!-- Search & Filter Card (Harmonized Heights & Clean White Theme) -->
    <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm">
        <form method="get" id="timesheetFilterForm" class="grid grid-cols-1 md:grid-cols-12 gap-4 items-end">
            <!-- Search Input -->
            <div class="md:col-span-4">
                <label for="search" class="block text-xs font-semibold text-slate-600 uppercase tracking-wider mb-2 truncate">Search</label>
                <div class="relative flex items-center">
                    <span class="material-symbols-outlined absolute left-3.5 pointer-events-none text-slate-400 text-lg">search</span>
                    <input type="text" id="search" name="search" value="@Model.Search" placeholder="Search branch, period code..."
                           class="w-full h-11 pl-10 pr-4 bg-slate-50/50 hover:bg-white focus:bg-white border border-slate-200 rounded-xl text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 transition-all box-border" />
                </div>
            </div>

            <!-- Week / Period Filter Dropdown (Scrollable Container) -->
            <div class="md:col-span-4 relative" id="periodDropdownContainer">
                <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wider mb-2 truncate">Period (Weekly)</label>
                <input type="hidden" name="scheduleWeekId" id="scheduleWeekId" value="@(Model.ScheduleWeekId?.ToString() ?? "")" />
                
                <!-- Dropdown Trigger Button (Matched h-11 height) -->
                <button type="button" id="periodDropdownBtn"
                        class="w-full h-11 flex items-center justify-between px-3.5 bg-slate-50/50 hover:bg-white focus:bg-white border border-slate-200 rounded-xl text-sm text-slate-800 focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 transition-all text-left cursor-pointer box-border">
                    <span id="periodDropdownLabel" class="truncate font-medium text-slate-800 text-sm">
                        @if (selectedPeriod != null)
                        {
                            @:Week @selectedPeriod.Period (@selectedPeriod.WeekStartDate.ToString("dd/MM") – @selectedPeriod.WeekEndDate.ToString("dd/MM/yyyy"))
                        }
                        else
                        {
                            @:All Created Weeks
                        }
                    </span>
                    <span class="material-symbols-outlined text-slate-400 text-lg ml-2 shrink-0 transition-transform duration-200" id="periodDropdownArrow">expand_more</span>
                </button>

                <!-- Scrollable Dropdown Menu -->
                <div id="periodDropdownMenu"
                     class="hidden absolute z-30 left-0 right-0 mt-1.5 bg-white border border-slate-200 rounded-xl shadow-xl max-h-56 overflow-y-auto divide-y divide-slate-100 py-1">
                    <!-- Option: All Weeks -->
                    <button type="button"
                            onclick="selectPeriod('', 'All Created Weeks')"
                            class="w-full text-left px-3.5 py-2.5 text-xs hover:bg-indigo-50 hover:text-indigo-700 flex items-center justify-between transition-colors @(Model.ScheduleWeekId == null ? "bg-indigo-50/70 text-indigo-700 font-bold" : "text-slate-700")">
                        <div>
                            <span class="font-medium text-slate-800">All Created Weeks</span>
                            <span class="block text-[11px] text-slate-400 font-normal">Show all created weeks for this branch</span>
                        </div>
                        @if (Model.ScheduleWeekId == null)
                        {
                            <span class="material-symbols-outlined text-indigo-600 text-base">check</span>
                        }
                    </button>

                    @if (Model.AvailablePeriods != null && Model.AvailablePeriods.Count > 0)
                    {
                        @foreach (var period in Model.AvailablePeriods)
                        {
                            var isSelected = Model.ScheduleWeekId == period.ScheduleWeekId;
                            <button type="button"
                                    onclick="selectPeriod('@period.ScheduleWeekId', 'Week @period.Period (@period.WeekStartDate.ToString("dd/MM") – @period.WeekEndDate.ToString("dd/MM/yyyy"))')"
                                    class="w-full text-left px-3.5 py-2.5 text-xs hover:bg-indigo-50 hover:text-indigo-700 flex items-center justify-between transition-colors @(isSelected ? "bg-indigo-50/70 text-indigo-700 font-bold" : "text-slate-700")">
                                <div>
                                    <span class="font-semibold text-slate-800">Week @period.Period</span>
                                    <span class="block text-[11px] text-slate-400 font-normal">@period.WeekStartDate.ToString("dd/MM/yyyy") – @period.WeekEndDate.ToString("dd/MM/yyyy")</span>
                                </div>
                                @if (isSelected)
                                {
                                    <span class="material-symbols-outlined text-indigo-600 text-base">check</span>
                                }
                            </button>
                        }
                    }
                    else
                    {
                        <div class="px-3.5 py-3 text-xs text-slate-400 text-center">No weeks created for this branch yet</div>
                    }
                </div>
            </div>

            <!-- Status Filter (Matched h-11 height) -->
            <div class="md:col-span-2">
                <label for="status" class="block text-xs font-semibold text-slate-600 uppercase tracking-wider mb-2 truncate">Status</label>
                <select id="status" name="status"
                        class="w-full h-11 px-3.5 bg-slate-50/50 hover:bg-white focus:bg-white border border-slate-200 rounded-xl text-sm text-slate-800 focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 transition-all cursor-pointer box-border">
                    <option value="ALL" selected="@(string.Equals(Model.Status, "ALL", StringComparison.OrdinalIgnoreCase))">All Statuses</option>
                    <option value="NOT GENERATED" selected="@(string.Equals(Model.Status, "NOT GENERATED", StringComparison.OrdinalIgnoreCase))">NOT GENERATED</option>
                    <option value="GENERATED" selected="@(string.Equals(Model.Status, "GENERATED", StringComparison.OrdinalIgnoreCase))">GENERATED</option>
                    <option value="REVIEWED" selected="@(string.Equals(Model.Status, "REVIEWED", StringComparison.OrdinalIgnoreCase))">REVIEWED</option>
                    <option value="LOCKED" selected="@(string.Equals(Model.Status, "LOCKED", StringComparison.OrdinalIgnoreCase))">LOCKED</option>
                </select>
            </div>

            <!-- Filter Action Buttons (Matched h-11 height) -->
            <div class="md:col-span-2 flex items-center gap-2">
                <button type="submit" class="flex-1 h-11 inline-flex items-center justify-center gap-1.5 px-3 bg-indigo-600 hover:bg-indigo-700 active:bg-indigo-800 text-white rounded-xl text-sm font-semibold shadow-sm transition-all cursor-pointer box-border">
                    <span class="material-symbols-outlined text-base">filter_alt</span>
                    <span>Filter</span>
                </button>
                <a asp-action="Index" class="h-11 w-11 shrink-0 inline-flex items-center justify-center bg-slate-100 hover:bg-slate-200 text-slate-600 hover:text-slate-900 rounded-xl text-sm transition-all box-border" title="Reset Filters">
                    <span class="material-symbols-outlined text-base">restart_alt</span>
                </a>
            </div>
        </form>
    </div>

    <!-- Timesheet Table Card (Clean White Theme) -->
    <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden">
        <div class="px-6 py-4 border-b border-slate-150 flex items-center justify-between bg-slate-50/60">
            <div class="flex items-center gap-2.5">
                <span class="material-symbols-outlined text-indigo-600 text-xl">date_range</span>
                <h2 class="text-sm font-bold text-slate-900">Weekly Timesheet Batches</h2>
                <span class="ml-2 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-indigo-50 text-indigo-700 border border-indigo-200">
                    @Model.TotalItems Weeks
                </span>
            </div>
            <span class="text-xs text-slate-500 font-medium">Timezone: Vietnam (UTC+7)</span>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm text-slate-700">
                <thead class="bg-slate-50 text-xs font-semibold text-slate-500 uppercase tracking-wider border-b border-slate-200">
                    <tr>
                        <th scope="col" class="px-6 py-3.5">Period (Weekly)</th>
                        <th scope="col" class="px-6 py-3.5">Branch</th>
                        <th scope="col" class="px-6 py-3.5">Status</th>
                        <th scope="col" class="px-6 py-3.5">Staff Confirmation</th>
                        <th scope="col" class="px-6 py-3.5 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 font-medium">
                    @if (Model.Items == null || Model.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="5" class="px-6 py-12 text-center text-slate-400">
                                <div class="flex flex-col items-center justify-center gap-3">
                                    <div class="w-14 h-14 rounded-2xl bg-slate-100 flex items-center justify-center text-slate-400">
                                        <span class="material-symbols-outlined text-3xl">calendar_today</span>
                                    </div>
                                    <div class="text-base font-semibold text-slate-700">No Weekly Timesheets Found</div>
                                    <p class="text-xs text-slate-400 max-w-sm">No timesheet records match your filter criteria. Try adjusting the search query or week filter.</p>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Items)
                        {
                            var isReviewed = string.Equals(item.Status, "REVIEWED", StringComparison.OrdinalIgnoreCase);
                            var isLocked = string.Equals(item.Status, "LOCKED", StringComparison.OrdinalIgnoreCase);
                            var isGenerated = string.Equals(item.Status, "GENERATED", StringComparison.OrdinalIgnoreCase);
                            var isNotGenerated = string.Equals(item.Status, "NOT GENERATED", StringComparison.OrdinalIgnoreCase);
                            var isAllConfirmed = item.TotalStaff > 0 && item.ConfirmedStaff == item.TotalStaff;

                            <tr class="hover:bg-slate-50/80 transition-colors group">
                                <!-- Period -->
                                <td class="px-6 py-4">
                                    <div class="flex flex-col">
                                        <div class="flex items-center gap-2">
                                            <span class="font-bold text-slate-900 text-sm group-hover:text-indigo-600 transition-colors">
                                                Week @item.Period
                                            </span>
                                            <span class="px-2 py-0.5 rounded text-[11px] font-semibold bg-slate-100 text-slate-600">
                                                Mon – Sun
                                            </span>
                                        </div>
                                        <span class="text-xs text-slate-400 mt-1">
                                            @item.WeekStartDate.ToString("dd/MM/yyyy") – @item.WeekEndDate.ToString("dd/MM/yyyy")
                                        </span>
                                    </div>
                                </td>

                                <!-- Branch -->
                                <td class="px-6 py-4">
                                    <div class="flex items-center gap-2">
                                        <span class="material-symbols-outlined text-slate-400 text-base">storefront</span>
                                        <span class="text-slate-800 font-semibold">@item.BranchName</span>
                                    </div>
                                </td>

                                <!-- Status Badge -->
                                <td class="px-6 py-4">
                                    @if (isReviewed)
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-blue-50 text-blue-700 border border-blue-200">
                                            <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>
                                            <span>REVIEWED</span>
                                        </span>
                                    }
                                    else if (isLocked)
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                                            <span>LOCKED</span>
                                        </span>
                                    }
                                    else if (isGenerated)
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-amber-50 text-amber-700 border border-amber-200">
                                            <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
                                            <span>GENERATED</span>
                                        </span>
                                    }
                                    else if (isNotGenerated)
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-slate-100 text-slate-600 border border-slate-200">
                                            <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
                                            <span>NOT GENERATED</span>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-slate-100 text-slate-700 border border-slate-200">
                                            <span>@item.Status</span>
                                        </span>
                                    }
                                </td>

                                <!-- Staff Confirmation -->
                                <td class="px-6 py-4">
                                    @if (isNotGenerated || item.StaffReview == "-")
                                    {
                                        <span class="text-slate-400 font-semibold text-sm pl-2">-</span>
                                    }
                                    else
                                    {
                                        <div class="flex flex-col gap-1.5 min-w-[170px]">
                                            <div class="flex items-center justify-between text-xs">
                                                <span class="font-bold @(isAllConfirmed ? "text-emerald-600" : "text-slate-800")">
                                                    @item.ConfirmedStaff/@item.TotalStaff Confirmed
                                                </span>
                                                <span class="text-slate-500 font-semibold">@item.ConfirmationRate%</span>
                                            </div>
                                            <div class="w-full h-2 rounded-full bg-slate-100 overflow-hidden border border-slate-200">
                                                <div class="h-full rounded-full transition-all duration-500 @(isAllConfirmed ? "bg-emerald-500" : "bg-indigo-600")"
                                                     style="width: @(Math.Min(100, item.ConfirmationRate))%"></div>
                                            </div>
                                        </div>
                                    }
                                </td>

                                <!-- Action -->
                                <td class="px-6 py-4 text-right">
                                    <div class="inline-flex items-center gap-2">
                                        <a asp-action="ExportExcel" asp-route-id="@item.ScheduleWeekId"
                                           title="Export weekly timesheet to Excel"
                                           class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg bg-emerald-50 hover:bg-emerald-600 text-emerald-700 hover:text-white border border-emerald-200 hover:border-emerald-600 text-xs font-semibold transition-all shadow-xs">
                                            <span class="material-symbols-outlined text-sm">download</span>
                                            <span>Excel</span>
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.ScheduleWeekId"
                                           class="inline-flex items-center gap-1 px-3.5 py-1.5 rounded-lg bg-slate-100 hover:bg-indigo-600 text-slate-700 hover:text-white border border-slate-200 hover:border-indigo-600 text-xs font-semibold transition-all shadow-sm">
                                            <span>Details</span>
                                            <span class="material-symbols-outlined text-sm">arrow_forward</span>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination Footer -->
        @if (Model.TotalPages > 1)
        {
            <div class="px-6 py-4 border-t border-slate-100 bg-slate-50/50 flex items-center justify-between">
                <span class="text-xs text-slate-500">
                    Showing page <strong class="text-slate-800">@Model.PageIndex</strong> of <strong class="text-slate-800">@Model.TotalPages</strong>
                </span>
                <div class="flex items-center gap-1.5">
                    @if (Model.PageIndex > 1)
                    {
                        <a asp-action="Index"
                           asp-route-search="@Model.Search"
                           asp-route-scheduleWeekId="@Model.ScheduleWeekId"
                           asp-route-status="@Model.Status"
                           asp-route-pageIndex="@(Model.PageIndex - 1)"
                           class="px-3 py-1.5 rounded-lg bg-white hover:bg-slate-100 text-xs font-semibold text-slate-700 border border-slate-200 transition-all">
                            Previous
                        </a>
                    }
                    @for (int i = Math.Max(1, Model.PageIndex - 2); i <= Math.Min(Model.TotalPages, Model.PageIndex + 2); i++)
                    {
                        <a asp-action="Index"
                           asp-route-search="@Model.Search"
                           asp-route-scheduleWeekId="@Model.ScheduleWeekId"
                           asp-route-status="@Model.Status"
                           asp-route-pageIndex="@i"
                           class="px-3 py-1.5 rounded-lg text-xs font-bold transition-all @(Model.PageIndex == i ? "bg-indigo-600 text-white shadow-sm" : "bg-white hover:bg-slate-100 text-slate-700 border border-slate-200")">
                            @i
                        </a>
                    }
                    @if (Model.PageIndex < Model.TotalPages)
                    {
                        <a asp-action="Index"
                           asp-route-search="@Model.Search"
                           asp-route-scheduleWeekId="@Model.ScheduleWeekId"
                           asp-route-status="@Model.Status"
                           asp-route-pageIndex="@(Model.PageIndex + 1)"
                           class="px-3 py-1.5 rounded-lg bg-white hover:bg-slate-100 text-xs font-semibold text-slate-700 border border-slate-200 transition-all">
                            Next
                        </a>
                    }
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        const dropdownContainer = document.getElementById('periodDropdownContainer');
        const dropdownBtn = document.getElementById('periodDropdownBtn');
        const dropdownMenu = document.getElementById('periodDropdownMenu');
        const dropdownArrow = document.getElementById('periodDropdownArrow');
        const scheduleWeekInput = document.getElementById('scheduleWeekId');
        const filterForm = document.getElementById('timesheetFilterForm');

        if (dropdownBtn && dropdownMenu) {
            dropdownBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                const isHidden = dropdownMenu.classList.contains('hidden');
                if (isHidden) {
                    dropdownMenu.classList.remove('hidden');
                    dropdownArrow.classList.add('rotate-180');
                } else {
                    dropdownMenu.classList.add('hidden');
                    dropdownArrow.classList.remove('rotate-180');
                }
            });

            document.addEventListener('click', (e) => {
                if (!dropdownContainer.contains(e.target)) {
                    dropdownMenu.classList.add('hidden');
                    dropdownArrow.classList.remove('rotate-180');
                }
            });

            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape') {
                    dropdownMenu.classList.add('hidden');
                    dropdownArrow.classList.remove('rotate-180');
                }
            });
        }

        function selectPeriod(weekId, labelText) {
            if (scheduleWeekInput) {
                scheduleWeekInput.value = weekId;
            }
            const labelEl = document.getElementById('periodDropdownLabel');
            if (labelEl) {
                labelEl.textContent = labelText;
            }
            if (dropdownMenu) {
                dropdownMenu.classList.add('hidden');
            }
            if (dropdownArrow) {
                dropdownArrow.classList.remove('rotate-180');
            }
            if (filterForm) {
                filterForm.submit();
            }
        }
    </script>
}
