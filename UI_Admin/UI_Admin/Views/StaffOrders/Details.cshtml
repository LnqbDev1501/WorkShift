@model UI_Admin.Models.Staff.Orders.StaffOrderDetailViewModel

@{
    ViewData["Title"] = $"Order - {Model.OrderNumber}";
    var isCompleted = Model.Status.Equals("COMPLETED", StringComparison.OrdinalIgnoreCase);
    var isCancelled = Model.Status.Equals("CANCELLED", StringComparison.OrdinalIgnoreCase);
    var isDraft = Model.Status.Equals("DRAFT", StringComparison.OrdinalIgnoreCase);
    var isActive = Model.Status.Equals("ACTIVE", StringComparison.OrdinalIgnoreCase);
    var isPaid = Model.PaymentStatus.Equals("PAID", StringComparison.OrdinalIgnoreCase);
    // Complete: only for ACTIVE + PAID orders
    var canComplete = isActive && isPaid;
    // Cancel: for ACTIVE and DRAFT orders (not completed/cancelled)
    var canCancel = (isActive || isDraft) && !isCompleted && !isCancelled;
}

<div class="flex flex-col w-full gap-unit-4 px-7 py-4">
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="bg-red-50 border border-red-200 text-red-800 px-4 py-3 rounded-xl text-sm font-medium flex items-center gap-2">
            <span class="material-symbols-outlined text-[20px]">error</span>
            @TempData["ErrorMessage"]
        </div>
    }
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="bg-emerald-50 border border-emerald-200 text-emerald-800 px-4 py-3 rounded-xl text-sm font-medium flex items-center gap-2">
            <span class="material-symbols-outlined text-[20px]">check_circle</span>
            @TempData["SuccessMessage"]
        </div>
    }
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-unit-4">
        <div class="flex items-center gap-unit-3">
            <a asp-controller="StaffOrders" asp-action="Index" class="inline-flex items-center justify-center h-9 w-9 rounded-xl bg-surface-container-lowest hover:bg-surface-container text-secondary hover:text-on-surface transition-colors shadow-sm">
                <span class="material-symbols-outlined text-[20px]">arrow_back</span>
            </a>
            <div class="flex flex-col">
                <div class="list-eyebrow">Order Management</div>
                <h1 class="font-display-lg text-display-lg text-on-surface tracking-tight">@Model.OrderNumber</h1>
            </div>
            @if (isCompleted)
            {
                <span class="inline-flex items-center gap-1.5 h-6 px-2 rounded-full text-label-sm font-label-sm bg-emerald-50 text-emerald-700">Completed</span>
            }
            else if (isCancelled)
            {
                <span class="inline-flex items-center gap-1.5 h-6 px-2 rounded-full text-label-sm font-label-sm bg-surface-container text-secondary">Cancelled</span>
            }
            else if (isDraft)
            {
                <span class="inline-flex items-center gap-1.5 h-6 px-2 rounded-full text-label-sm font-label-sm bg-amber-50 text-amber-700">Draft</span>
            }
            else
            {
                <span class="inline-flex items-center gap-1.5 h-6 px-2 rounded-full text-label-sm font-label-sm bg-blue-50 text-blue-700">Active</span>
            }
        </div>
        <div class="flex items-center gap-unit-3 self-start md:self-auto">
            @if (canComplete)
            {
                <form method="post" asp-controller="StaffOrders" asp-action="Complete" asp-route-id="@Model.OrderId" class="inline">
                    <button type="submit" class="inline-flex items-center justify-center gap-unit-2 h-[40px] px-unit-4 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-body-md-medium text-body-md-medium transition-colors shadow-sm cursor-pointer" onclick="return confirm('Mark this order as completed?');">
                        <span class="material-symbols-outlined text-[20px]">check_circle</span>
                        <span>Complete</span>
                    </button>
                </form>
            }
            @if (canCancel)
            {
                <form method="post" asp-controller="StaffOrders" asp-action="Cancel" asp-route-id="@Model.OrderId" class="inline">
                    <button type="submit" class="inline-flex items-center justify-center gap-unit-2 h-[40px] px-unit-4 rounded-xl bg-red-600 hover:bg-red-700 text-white font-body-md-medium text-body-md-medium transition-colors shadow-sm cursor-pointer" onclick="return confirm('Cancel this order?');">
                        <span class="material-symbols-outlined text-[20px]">cancel</span>
                        <span>Cancel</span>
                    </button>
                </form>
            }
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-unit-4">
        <!-- General Info -->
        <div class="bg-surface-container-lowest rounded-xl shadow-sm p-unit-6">
            <div class="flex items-center gap-2.5 pb-unit-4 border-b border-surface-container-highest">
                <span class="p-2 rounded-lg bg-surface-container text-primary flex items-center justify-center">
                    <span class="material-symbols-outlined text-[20px]">receipt_long</span>
                </span>
                <h2 class="font-title-md text-title-md text-on-surface">Order Information</h2>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-y-unit-4 gap-x-unit-6 pt-unit-4">
                <div class="flex flex-col">
                    <span class="font-label-sm text-secondary uppercase tracking-wider text-[11px]">Order Number</span>
                    <div class="mt-0.5">
                        <span class="font-code-num text-code-num text-primary font-semibold bg-surface-container px-2 py-1 rounded">@Model.OrderNumber</span>
                    </div>
                </div>
                <div class="flex flex-col">
                    <span class="font-label-sm text-secondary uppercase tracking-wider text-[11px]">Order Date</span>
                    <span class="font-body-md-medium text-on-surface text-body-md mt-0.5">@Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</span>
                </div>
                <div class="flex flex-col sm:col-span-2">
                    <span class="font-label-sm text-secondary uppercase tracking-wider text-[11px]">Status</span>
                    <span class="font-body-md-medium text-body-md mt-0.5 font-semibold @(isCompleted ? "text-emerald-700" : isCancelled ? "text-secondary" : isDraft ? "text-amber-700" : "text-blue-700")">@Model.Status</span>
                </div>
                <div class="flex flex-col">
                    <span class="font-label-sm text-secondary uppercase tracking-wider text-[11px]">Payment Status</span>
                    <span class="font-body-md-medium text-body-md mt-0.5 font-semibold @(isPaid ? "text-emerald-700" : "text-amber-700")">@Model.PaymentStatus</span>
                </div>
                <div class="flex flex-col sm:col-span-2">
                    <span class="font-label-sm text-secondary uppercase tracking-wider text-[11px]">Note</span>
                    <span class="font-body-md text-on-surface text-body-md mt-0.5">@(string.IsNullOrWhiteSpace(Model.Note) ? "No notes provided." : Model.Note)</span>
                </div>
            </div>
        </div>

        <!-- Financial Summary -->
        <div class="bg-surface-container-lowest rounded-xl shadow-sm p-unit-6">
            <div class="flex items-center gap-2.5 pb-unit-4 border-b border-surface-container-highest">
                <span class="p-2 rounded-lg bg-surface-container text-primary flex items-center justify-center">
                    <span class="material-symbols-outlined text-[20px]">payments</span>
                </span>
                <h2 class="font-title-md text-title-md text-on-surface">Financial Summary</h2>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-y-unit-4 gap-x-unit-6 pt-unit-4">
                <div class="flex flex-col">
                    <span class="font-label-sm text-secondary uppercase tracking-wider text-[11px]">Subtotal</span>
                    <span class="font-body-md-medium text-on-surface text-body-md mt-0.5 font-code-num font-semibold">@UI_Admin.Helpers.CurrencyHelper.FormatVnd(Model.Subtotal)</span>
                </div>
                <div class="flex flex-col">
                    <span class="font-label-sm text-secondary uppercase tracking-wider text-[11px]">Total Amount</span>
                    <span class="font-display-md text-display-md text-primary mt-0.5 font-code-num font-bold">@UI_Admin.Helpers.CurrencyHelper.FormatVnd(Model.TotalAmount)</span>
                </div>
                @if (Model.PaidAt.HasValue)
                {
                    <div class="flex flex-col sm:col-span-2">
                        <span class="font-label-sm text-secondary uppercase tracking-wider text-[11px]">Paid At</span>
                        <span class="font-body-md-medium text-on-surface text-body-md mt-0.5">@Model.PaidAt.Value.ToString("dd/MM/yyyy HH:mm")</span>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Order Items -->
    <div class="bg-surface-container-lowest rounded-xl shadow-sm p-unit-6">
        <div class="flex items-center justify-between pb-unit-4 border-b border-surface-container-highest">
            <div class="flex items-center gap-2.5">
                <span class="p-2 rounded-lg bg-surface-container text-primary flex items-center justify-center">
                    <span class="material-symbols-outlined text-[20px]">inventory_2</span>
                </span>
                <h2 class="font-title-md text-title-md text-on-surface">Order Items (@Model.Items.Count)</h2>
            </div>
        </div>
        <div class="pt-unit-4 overflow-x-auto">
            <table class="w-full text-left">
                <thead>
                    <tr class="h-[40px] bg-surface-container-low text-secondary text-label-md font-label-md uppercase tracking-wider">
                        <th class="px-unit-5 py-2" scope="col">Product</th>
                        <th class="px-unit-4 py-2 text-right" scope="col">Unit Price</th>
                        <th class="px-unit-4 py-2 text-right" scope="col">Qty</th>
                        <th class="px-unit-4 py-2 text-right" scope="col">Discount</th>
                        <th class="px-unit-5 py-2 text-right" scope="col">Total</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-surface-container-high">
                    @foreach (var item in Model.Items)
                    {
                        <tr class="h-[56px] hover:bg-surface-container-low transition-colors">
                            <td class="px-unit-5 py-2 font-body-md-medium text-body-md-medium text-on-surface">
                                @item.ProductName
                                @if (!string.IsNullOrEmpty(item.Note))
                                {
                                    <div class="mt-1 text-xs text-secondary font-normal">
                                        <span class="material-symbols-outlined text-[14px] align-middle mr-1">note</span>
                                        @item.Note
                                    </div>
                                }
                            </td>
                            <td class="px-unit-4 py-2 font-code-num text-code-num text-on-surface text-right">
                                @UI_Admin.Helpers.CurrencyHelper.FormatVnd(item.UnitPrice)
                            </td>
                            <td class="px-unit-4 py-2 font-body-md text-body-md text-secondary text-right whitespace-nowrap">
                                @item.Quantity
                            </td>
                            <td class="px-unit-4 py-2 font-code-num text-code-num text-amber-700 text-right">
                                @UI_Admin.Helpers.CurrencyHelper.FormatVnd(item.DiscountAmount)
                            </td>
                            <td class="px-unit-5 py-2 font-code-num text-code-num text-primary font-semibold text-right">
                                @UI_Admin.Helpers.CurrencyHelper.FormatVnd(item.TotalAmount)
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Payments -->
    @if (Model.Payments.Count > 0)
    {
        <div class="bg-surface-container-lowest rounded-xl shadow-sm p-unit-6">
            <div class="flex items-center justify-between pb-unit-4 border-b border-surface-container-highest">
                <div class="flex items-center gap-2.5">
                    <span class="p-2 rounded-lg bg-surface-container text-primary flex items-center justify-center">
                        <span class="material-symbols-outlined text-[20px]">payments</span>
                    </span>
                    <h2 class="font-title-md text-title-md text-on-surface">Payments (@Model.Payments.Count)</h2>
                </div>
            </div>
            <div class="pt-unit-4 overflow-x-auto">
                <table class="w-full text-left">
                    <thead>
                        <tr class="h-[40px] bg-surface-container-low text-secondary text-label-md font-label-md uppercase tracking-wider">
                            <th class="px-unit-5 py-2" scope="col">Date</th>
                            <th class="px-unit-4 py-2" scope="col">Method</th>
                            <th class="px-unit-4 py-2" scope="col">Reference</th>
                            <th class="px-unit-4 py-2 text-right" scope="col">Amount</th>
                            <th class="px-unit-5 py-2" scope="col">Recorded By</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-surface-container-high">
                        @foreach (var payment in Model.Payments)
                        {
                            <tr class="h-[56px] hover:bg-surface-container-low transition-colors">
                                <td class="px-unit-5 py-2 font-body-md text-body-md text-secondary">
                                    @payment.RecordedAt.ToString("dd/MM/yyyy HH:mm")
                                </td>
                                <td class="px-unit-4 py-2 font-body-md text-body-md text-on-surface">
                                    @payment.PaymentMethod
                                </td>
                                <td class="px-unit-4 py-2 font-code-num text-code-num text-secondary">
                                    @(string.IsNullOrWhiteSpace(payment.ReferenceNumber) ? "-" : payment.ReferenceNumber)
                                </td>
                                <td class="px-unit-4 py-2 font-code-num text-code-num text-emerald-700 font-semibold text-right">
                                    @UI_Admin.Helpers.CurrencyHelper.FormatVnd(payment.Amount)
                                </td>
                                <td class="px-unit-5 py-2 font-body-md text-body-md text-secondary">
                                    @payment.RecordedByName
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- Order Note -->
    <div class="bg-surface-container-lowest rounded-xl shadow-sm p-unit-6">
        <div class="flex items-center gap-2.5 pb-unit-4 border-b border-surface-container-highest">
            <span class="p-2 rounded-lg bg-surface-container text-primary flex items-center justify-center">
                <span class="material-symbols-outlined text-[20px]">sticky_note_2</span>
            </span>
            <h2 class="font-title-md text-title-md text-on-surface">Order Note</h2>
        </div>
        <div class="pt-unit-4">
            @if (!string.IsNullOrEmpty(Model.Note))
            {
                <p class="font-body-md text-body-md text-on-surface">@Model.Note</p>
            }
            else
            {
                <p class="font-body-md text-body-md text-secondary italic">Không có</p>
            }
        </div>
    }
</div>