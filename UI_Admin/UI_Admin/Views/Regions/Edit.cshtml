@model UI_Admin.Models.Regions.EditRegionViewModel

@{
    ViewData["Title"] = "Regions";
    var isActive = Model.Status.Equals("ACTIVE", StringComparison.OrdinalIgnoreCase);
}

<div class="flex flex-col w-full">
    <!-- Top Context Header Bar: Breadcrumb Trail -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-unit-2 pb-unit-5">
        <div class="flex items-center flex-wrap gap-unit-2 font-body-sm text-on-surface-variant">
            <span class="hover:text-primary-container transition-colors">Admin</span>
            <span class="material-symbols-outlined text-[14px] text-outline-variant">chevron_right</span>
            <span class="hover:text-primary-container transition-colors">WorkShift Control</span>
            <span class="material-symbols-outlined text-[14px] text-outline-variant">chevron_right</span>
            <a class="hover:text-primary-container transition-colors font-body-md-medium" asp-controller="Regions" asp-action="Index">Regions</a>
            <span class="material-symbols-outlined text-[14px] text-outline-variant">chevron_right</span>
            <span class="text-on-surface-variant">@Model.RegionName (@Model.RegionCode)</span>
            <span class="material-symbols-outlined text-[14px] text-outline-variant">chevron_right</span>
            <span class="font-body-md-medium text-on-surface">Edit Region</span>
        </div>
        <div class="flex items-center gap-unit-1 text-on-surface-variant font-code-num text-body-sm">
        </div>
    </div>

    <!-- Primary Page Header with Operational Status -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-unit-4 pb-unit-6">
        <div class="flex flex-col gap-unit-1">
            <div class="flex items-center gap-unit-3 flex-wrap">
                <h1 class="font-display-md text-on-surface tracking-tight">Edit Region</h1>
                @if (isActive)
                {
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-semibold tracking-wider uppercase bg-[#ECFDF5] text-[#059669] border border-[#A7F3D0]">
                        <span class="w-1.5 h-1.5 rounded-full bg-[#059669] animate-pulse"></span>
                        OPERATIONAL / ACTIVE
                    </span>
                }
                else
                {
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-semibold tracking-wider uppercase bg-surface-container text-secondary border border-outline-variant/60">
                        <span class="w-1.5 h-1.5 rounded-full bg-secondary"></span>
                        INACTIVE
                    </span>
                }
            </div>
            <p class="font-body-md text-on-surface-variant">Update the region name and description.</p>
        </div>
        <!-- Quick Navigation Anchor Link -->
        <div class="flex items-center gap-unit-2">
            <button class="h-input-height px-unit-4 rounded-xl bg-surface-container-lowest text-on-surface font-body-md-medium shadow-sm hover:bg-surface-container transition-colors inline-flex items-center gap-unit-2 text-body-sm cursor-pointer" type="button" id="btnResetForm">
                Reset
            </button>
        </div>
    </div>

    <!-- Policy Guard Notice: Locked Immutable Identifier Box -->
    <div class="mb-unit-6 rounded-xl bg-[#FFFBEB] p-unit-4 shadow-sm">
        <div class="flex items-start gap-unit-3">
            <div class="w-8 h-8 rounded-lg bg-[#FEF3C7] text-[#B45309] flex items-center justify-center shrink-0 mt-0.5">
                <span class="material-symbols-outlined text-[20px]">lock</span>
            </div>
            <div class="flex flex-col flex-1 min-w-0">
                <span class="font-title-md text-[#92400E]">Region Code is locked</span>
                <p class="font-body-sm text-[#B45309] mt-unit-1">
                    Region Code is locked and cannot be changed after the region is created.
                </p>
            </div>
        </div>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All" class="mb-unit-6 p-unit-4 bg-error-container text-on-error-container rounded-xl text-body-md font-body-md-medium shadow-sm"></div>
    }

    <!-- Main Content Grid (2 Columns: 65% Main Form / 35% Sidebar Context) -->
    <form class="grid grid-cols-1 lg:grid-cols-12 gap-unit-6 items-start pb-unit-12" id="editRegionForm" method="post" asp-controller="Regions" asp-action="Edit" asp-route-id="@Model.RegionId">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="RegionId" />
        <input type="hidden" asp-for="RegionCode" />
        <input type="hidden" asp-for="Status" />
        <input type="hidden" asp-for="BranchCount" />

        <!-- Left Column: Unified Main Form Card (8 cols) -->
        <div class="lg:col-span-8 flex flex-col gap-unit-6">
            <div class="bg-surface-container-lowest rounded-xl p-unit-6 shadow-sm border border-surface-container-high flex flex-col gap-unit-6">
                <!-- Card Header -->
                <div class="border-b border-surface-container-high pb-unit-4 flex items-center justify-between">
                    <div>
                        <h2 class="font-title-lg text-on-surface tracking-tight">Region Information</h2>
                        <p class="font-body-sm text-on-surface-variant mt-0.5">Update the regional display label and operational scope. The identifier code is locked for audit integrity.</p>
                    </div>
                    @if (isActive)
                    {
                        <span class="hidden sm:inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-semibold tracking-wider uppercase bg-[#ECFDF5] text-[#059669] border border-[#A7F3D0]">
                            <span class="w-1.5 h-1.5 rounded-full bg-[#059669] animate-pulse"></span>
                            ACTIVE
                        </span>
                    }
                    else
                    {
                        <span class="hidden sm:inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-semibold tracking-wider uppercase bg-surface-container text-secondary border border-outline-variant/60">
                            <span class="w-1.5 h-1.5 rounded-full bg-secondary"></span>
                            INACTIVE
                        </span>
                    }
                </div>

                <!-- Field 1: Region Code (Immutable / Read-only) -->
                <div class="flex flex-col gap-unit-1.5">
                    <label class="font-label-md text-on-surface flex items-center justify-between">
                        <span class="flex items-center gap-1.5 font-semibold text-[13px]">Region Code <span class="text-error">*</span></span>
                        <span class="font-label-sm text-on-surface-variant font-normal">Locked identifier</span>
                    </label>
                    <div class="relative">
                        <input class="w-full h-input-height px-unit-3 pl-unit-10 pr-24 rounded-xl bg-surface-container-low text-on-surface-variant font-code-num text-body-md cursor-not-allowed select-all border border-surface-container-high" readonly="" type="text" value="@Model.RegionCode">
                        <span class="material-symbols-outlined absolute left-unit-3 top-1/2 -translate-y-1/2 text-outline-variant text-[18px]">lock</span>
                        <span class="absolute right-unit-3 top-1/2 -translate-y-1/2 px-2.5 py-0.5 rounded text-[10px] font-code-num uppercase tracking-wider bg-surface-container-high text-on-surface-variant font-semibold border border-outline-variant/60">LOCKED</span>
                    </div>
                    <p class="font-body-sm text-on-surface-variant text-[12px]">Region code is permanently locked and cannot be edited.</p>
                </div>

                <!-- Field 2: Region Name -->
                <div class="flex flex-col gap-unit-1.5">
                    <div class="flex items-center justify-between">
                        <label class="font-label-md text-on-surface font-semibold text-[13px]" for="regionName">
                            Region Name <span class="text-error">*</span>
                        </label>
                        <span class="font-code-num text-label-sm text-on-surface-variant" id="nameCounter">@((Model.RegionName ?? string.Empty).Length) / 150</span>
                    </div>
                    <div class="relative">
                        <input class="w-full h-input-height px-unit-3 rounded-xl bg-surface-container-lowest text-on-surface font-body-md ring-1 ring-outline-variant/60 focus:ring-2 focus:ring-primary-container focus:outline-none transition-all"
                               id="regionName"
                               name="RegionName"
                               maxlength="150"
                               placeholder="Enter descriptive region name..."
                               type="text"
                               value="@Model.RegionName"
                               required>
                    </div>
                    <span asp-validation-for="RegionName" class="text-error text-label-sm"></span>
                    <p class="font-body-sm text-on-surface-variant text-[12px]">Display label visible across scheduling dashboards and branch filters.</p>
                </div>

                <!-- Field 3: Description -->
                <div class="flex flex-col gap-unit-1.5">
                    <div class="flex items-center justify-between">
                        <label class="font-label-md text-on-surface font-semibold text-[13px]" for="scopeDescription">
                            Description
                        </label>
                        <span class="font-code-num text-label-sm text-on-surface-variant" id="descCounter">@((Model.Description ?? string.Empty).Length) / 500</span>
                    </div>
                    <textarea class="w-full p-unit-3 rounded-xl bg-surface-container-lowest text-on-surface font-body-md ring-1 ring-outline-variant/60 focus:ring-2 focus:ring-primary-container focus:outline-none transition-all resize-y leading-relaxed"
                              id="scopeDescription"
                              name="Description"
                              maxlength="500"
                              placeholder="Provide context on coverage boundaries, logistics centers, or market segments..."
                              rows="4">@Model.Description</textarea>
                    <span asp-validation-for="Description" class="text-error text-label-sm"></span>
                    <p class="font-body-sm text-on-surface-variant text-[12px]">Optional summary of regional jurisdiction and operational coverage.</p>
                </div>
            </div>
        </div>

        <!-- Right Column: Context & Reference Sidebar (4 cols) -->
        <div class="lg:col-span-4 flex flex-col gap-unit-5">
            <!-- Card: Region Snapshot -->
            <div class="bg-surface-container-lowest rounded-xl p-unit-5 shadow-sm border border-surface-container-high flex flex-col gap-unit-4">
                <div class="flex items-center justify-between border-b border-surface-container-high pb-unit-3">
                    <div class="flex items-center gap-unit-2">
                        <span class="material-symbols-outlined text-primary-container text-[20px]">info</span>
                        <h3 class="font-title-md text-on-surface text-[15px]">Region Snapshot</h3>
                    </div>
                    <span class="font-code-num text-[11px] text-on-surface-variant font-medium">@Model.RegionCode</span>
                </div>
                <div class="flex flex-col gap-unit-3 font-body-sm text-[13px]">
                    <div class="flex items-center justify-between py-1">
                        <span class="text-on-surface-variant">Associated Branches</span>
                        <span class="font-semibold text-on-surface">@Model.BranchCount Branches</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Bottom Unified Operational Action Bar -->
        <div class="lg:col-span-12 sticky bottom-4 z-30 bg-surface-container-lowest/95 backdrop-blur-md rounded-xl p-unit-4 shadow-lg ring-1 ring-surface-container-high/80 flex flex-col sm:flex-row items-center justify-between gap-unit-4">
            <div class="flex items-center gap-unit-2 text-on-surface-variant text-[13px]">
                <span class="material-symbols-outlined text-[18px] text-outline-variant">history</span>
                <span>Unsaved changes will be discarded upon navigating away.</span>
            </div>
            <div class="flex items-center gap-unit-3 w-full sm:w-auto justify-end">
                <a class="h-input-height px-unit-5 rounded-xl bg-surface-container hover:bg-surface-container-high text-on-surface font-body-md-medium transition-colors inline-flex items-center justify-center text-body-sm" asp-controller="Regions" asp-action="Index">
                    Cancel
                </a>
                <button class="h-input-height px-unit-6 rounded-xl hover:bg-[#4338CA] text-on-primary font-body-md-medium shadow-sm transition-all inline-flex items-center justify-center gap-unit-2 text-body-sm active:scale-[0.99] bg-primary-container cursor-pointer" id="btnSaveRegion" type="submit">
                    <span class="material-symbols-outlined text-[18px]">check_circle</span>
                    Save Changes
                </button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const initialName = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RegionName ?? string.Empty));
            const initialDesc = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Description ?? string.Empty));

            const regionNameInput = document.getElementById('regionName');
            const nameCounter = document.getElementById('nameCounter');
            const descInput = document.getElementById('scopeDescription');
            const descCounter = document.getElementById('descCounter');
            const resetBtn = document.getElementById('btnResetForm');

            function updateNameCount() {
                if (regionNameInput && nameCounter) {
                    nameCounter.textContent = `${regionNameInput.value.length} / 150`;
                }
            }

            function updateDescCount() {
                if (descInput && descCounter) {
                    descCounter.textContent = `${descInput.value.length} / 500`;
                }
            }

            if (regionNameInput) {
                regionNameInput.addEventListener('input', updateNameCount);
            }

            if (descInput) {
                descInput.addEventListener('input', updateDescCount);
            }

            if (resetBtn) {
                resetBtn.addEventListener('click', function () {
                    if (regionNameInput) regionNameInput.value = initialName;
                    if (descInput) descInput.value = initialDesc;
                    updateNameCount();
                    updateDescCount();
                });
            }
        })();
    </script>
}
