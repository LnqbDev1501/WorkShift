@model UI_Admin.Models.Manager.TimesheetAdjustment.ManagerTimesheetAdjustmentItemModel
@{
    Layout = "_ManagerLayout";
    ViewData["Title"] = $"Adjustment Request #{Model.AdjustmentRequestId}";

    var status = (Model.Status ?? "PENDING").ToUpper();
    var isPending = status == "PENDING";
    var isApproved = status == "APPROVED";
    var isRejected = status == "REJECTED";
}

<div class="px-7 py-6 max-w-[1440px] mx-auto space-y-6">
    <!-- Breadcrumb & Top Bar Navigation -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-1.5 text-xs text-indigo-600 font-semibold uppercase tracking-wider mb-1">
                <a asp-controller="ManagerTimesheet" asp-action="Index" class="hover:underline flex items-center gap-1">
                    <span class="material-symbols-outlined text-sm">table_chart</span>
                    <span>Timesheets</span>
                </a>
                <span>/</span>
                <a asp-controller="ManagerTimesheetAdjustment" asp-action="Index" class="hover:underline">
                    <span>Adjustments</span>
                </a>
                <span>/</span>
                <span class="text-slate-400">Request #@Model.AdjustmentRequestId</span>
            </div>
            <div class="flex items-center gap-3">
                <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Adjustment Request #@Model.AdjustmentRequestId</h1>
                @if (isPending)
                {
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-amber-50 text-amber-700 border border-amber-200">
                        <span class="w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span>
                        <span>PENDING REVIEW</span>
                    </span>
                }
                else if (isApproved)
                {
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                        <span class="material-symbols-outlined text-sm">check_circle</span>
                        <span>APPROVED</span>
                    </span>
                }
                else if (isRejected)
                {
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-rose-50 text-rose-700 border border-rose-200">
                        <span class="material-symbols-outlined text-sm">cancel</span>
                        <span>REJECTED</span>
                    </span>
                }
            </div>
            <p class="text-xs text-slate-500 mt-1">
                Submitted on @Model.CreatedAt.AddHours(7).ToString("dd/MM/yyyy 'at' HH:mm") by @Model.StaffName
            </p>
        </div>

        <div class="flex items-center gap-3">
            <a asp-action="Index"
               class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-white hover:bg-slate-50 text-slate-700 border border-slate-200 text-xs font-semibold transition-all shadow-xs">
                <span class="material-symbols-outlined text-sm">arrow_back</span>
                <span>Back to Adjustments</span>
            </a>
        </div>
    </div>

    <!-- Alert Messages (Toast Banners) -->
    @if (TempData["SuccessMessage"] is string successMsg)
    {
        <div id="alertSuccessBanner" class="p-4 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-900 text-sm flex items-center justify-between gap-3 shadow-xs">
            <div class="flex items-center gap-2.5">
                <span class="material-symbols-outlined text-emerald-600 text-xl shrink-0">check_circle</span>
                <span class="font-medium">@successMsg</span>
            </div>
            <button type="button" onclick="document.getElementById('alertSuccessBanner')?.remove()" class="text-emerald-700 hover:text-emerald-950 p-1 rounded-lg">
                <span class="material-symbols-outlined text-lg leading-none">close</span>
            </button>
        </div>
    }

    @if (TempData["ErrorMessage"] is string errorMsg)
    {
        <div id="alertErrorBanner" class="p-4 rounded-2xl bg-rose-50 border border-rose-200 text-rose-900 text-sm flex items-center justify-between gap-3 shadow-xs">
            <div class="flex items-center gap-2.5">
                <span class="material-symbols-outlined text-rose-600 text-xl shrink-0">error</span>
                <span class="font-medium">@errorMsg</span>
            </div>
            <button type="button" onclick="document.getElementById('alertErrorBanner')?.remove()" class="text-rose-700 hover:text-rose-950 p-1 rounded-lg">
                <span class="material-symbols-outlined text-lg leading-none">close</span>
            </button>
        </div>
    }

    <!-- Main Layout Grid: Left (Comparison & Details) | Right (Staff, Shift & Actions) -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Left Column (2 Cols) -->
        <div class="lg:col-span-2 space-y-6">
            <!-- Card 1: Side-by-Side Comparison -->
            <div class="bg-white border border-slate-200 rounded-2xl shadow-xs overflow-hidden">
                <div class="px-6 py-4 border-b border-slate-150 flex items-center justify-between bg-slate-50/60">
                    <div class="flex items-center gap-2.5">
                        <span class="material-symbols-outlined text-indigo-600 text-xl">compare_arrows</span>
                        <h2 class="text-sm font-bold text-slate-900">Attendance Time Comparison</h2>
                    </div>
                    <span class="text-xs text-slate-500 font-medium">Timezone: UTC+7</span>
                </div>

                <div class="p-6">
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                        <!-- Original Attendance Record -->
                        <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200 space-y-4">
                            <div class="flex items-center justify-between border-b border-slate-200 pb-3">
                                <span class="text-xs font-bold text-slate-500 uppercase tracking-wider flex items-center gap-1.5">
                                    <span class="material-symbols-outlined text-base text-slate-400">history</span>
                                    <span>Original System Log</span>
                                </span>
                                <span class="text-[11px] font-semibold text-slate-400 bg-white px-2 py-0.5 rounded-full border border-slate-200">
                                    Recorded
                                </span>
                            </div>

                            <div class="space-y-3">
                                <div>
                                    <span class="text-xs text-slate-400 block mb-1">Check-in Time</span>
                                    <div class="flex items-center gap-2">
                                        <span class="material-symbols-outlined text-slate-400 text-lg">login</span>
                                        <span class="text-lg font-bold font-mono text-slate-800">
                                            @Model.OriginalCheckInDisplay
                                        </span>
                                    </div>
                                </div>

                                <div>
                                    <span class="text-xs text-slate-400 block mb-1">Check-out Time</span>
                                    <div class="flex items-center gap-2">
                                        <span class="material-symbols-outlined text-slate-400 text-lg">logout</span>
                                        <span class="text-lg font-bold font-mono text-slate-800">
                                            @Model.OriginalCheckOutDisplay
                                        </span>
                                    </div>
                                </div>

                                <div class="pt-2 border-t border-slate-200/60">
                                    <span class="text-xs text-slate-400 block mb-1">Scheduled Shift Hours</span>
                                    <span class="text-xs font-semibold text-slate-600">
                                        @Model.ScheduledRangeDisplay
                                    </span>
                                </div>
                            </div>
                        </div>

                        <!-- Requested Adjustment Record -->
                        <div class="p-5 rounded-2xl bg-amber-50/50 border border-amber-200 space-y-4">
                            <div class="flex items-center justify-between border-b border-amber-200 pb-3">
                                <span class="text-xs font-bold text-amber-800 uppercase tracking-wider flex items-center gap-1.5">
                                    <span class="material-symbols-outlined text-base text-amber-600">edit_calendar</span>
                                    <span>Requested Adjustment</span>
                                </span>
                                <span class="text-[11px] font-bold text-amber-700 bg-white px-2 py-0.5 rounded-full border border-amber-200">
                                    Claimed
                                </span>
                            </div>

                            <div class="space-y-3">
                                <div>
                                    <div class="flex items-center justify-between mb-1">
                                        <span class="text-xs text-slate-500">Requested Check-in</span>
                                        @if (Model.AdjustCheckIn)
                                        {
                                            <span class="px-2 py-0.5 rounded-md text-[10px] font-bold bg-amber-100 text-amber-800 border border-amber-300">
                                                MODIFIED
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="px-2 py-0.5 rounded-md text-[10px] font-medium bg-slate-100 text-slate-500">
                                                UNCHANGED
                                            </span>
                                        }
                                    </div>
                                    <div class="flex items-center gap-2">
                                        <span class="material-symbols-outlined text-amber-600 text-lg">login</span>
                                        <span class="text-lg font-bold font-mono @(Model.AdjustCheckIn ? "text-amber-900 font-extrabold" : "text-slate-500")">
                                            @Model.RequestedCheckInDisplay
                                        </span>
                                    </div>
                                </div>

                                <div>
                                    <div class="flex items-center justify-between mb-1">
                                        <span class="text-xs text-slate-500">Requested Check-out</span>
                                        @if (Model.AdjustCheckOut)
                                        {
                                            <span class="px-2 py-0.5 rounded-md text-[10px] font-bold bg-amber-100 text-amber-800 border border-amber-300">
                                                MODIFIED
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="px-2 py-0.5 rounded-md text-[10px] font-medium bg-slate-100 text-slate-500">
                                                UNCHANGED
                                            </span>
                                        }
                                    </div>
                                    <div class="flex items-center gap-2">
                                        <span class="material-symbols-outlined text-amber-600 text-lg">logout</span>
                                        <span class="text-lg font-bold font-mono @(Model.AdjustCheckOut ? "text-amber-900 font-extrabold" : "text-slate-500")">
                                            @Model.RequestedCheckOutDisplay
                                        </span>
                                    </div>
                                </div>

                                <div class="pt-2 border-t border-amber-200/60">
                                    <span class="text-xs text-amber-700/80 block mb-1">Impact on Approval</span>
                                    <span class="text-xs font-semibold text-amber-900">
                                        Actual working hours and penalties will be automatically re-computed.
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Card 2: Staff Reason & Justification -->
            <div class="bg-white border border-slate-200 rounded-2xl shadow-xs overflow-hidden">
                <div class="px-6 py-4 border-b border-slate-150 flex items-center justify-between bg-slate-50/60">
                    <div class="flex items-center gap-2.5">
                        <span class="material-symbols-outlined text-indigo-600 text-xl">comment</span>
                        <h2 class="text-sm font-bold text-slate-900">Staff Claim Reason</h2>
                    </div>
                    <span class="text-xs text-slate-400">Written by employee</span>
                </div>

                <div class="p-6">
                    <div class="p-4 rounded-xl bg-slate-50/80 border border-slate-200 text-slate-800 text-sm leading-relaxed">
                        <p class="font-normal italic">
                            "@Model.Reason"
                        </p>
                    </div>
                </div>
            </div>

            <!-- Card 3: Manager Review Audit Trail -->
            @if (isApproved || isRejected)
            {
                <div class="bg-white border border-slate-200 rounded-2xl shadow-xs overflow-hidden">
                    <div class="px-6 py-4 border-b border-slate-150 flex items-center justify-between bg-slate-50/60">
                        <div class="flex items-center gap-2.5">
                            <span class="material-symbols-outlined text-indigo-600 text-xl">fact_check</span>
                            <h2 class="text-sm font-bold text-slate-900">Review Outcome & Audit Trail</h2>
                        </div>
                        <span class="text-xs font-semibold @(isApproved ? "text-emerald-600" : "text-rose-600")">
                            Status: @Model.Status
                        </span>
                    </div>

                    <div class="p-6 space-y-4">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-xl @(isApproved ? "bg-emerald-50 text-emerald-600 border border-emerald-200" : "bg-rose-50 text-rose-600 border border-rose-200") flex items-center justify-center shrink-0">
                                <span class="material-symbols-outlined text-xl">
                                    @(isApproved ? "verified" : "cancel")
                                </span>
                            </div>
                            <div>
                                <span class="text-xs text-slate-400 block">Reviewed By</span>
                                <span class="text-sm font-bold text-slate-900">
                                    @(Model.ReviewedByName ?? "Store Manager")
                                </span>
                                @if (Model.ReviewedAt.HasValue)
                                {
                                    <span class="text-xs text-slate-400 ml-2">
                                        on @Model.ReviewedAt.Value.AddHours(7).ToString("dd/MM/yyyy 'at' HH:mm")
                                    </span>
                                }
                            </div>
                        </div>

                        @if (isRejected && !string.IsNullOrWhiteSpace(Model.ManagerNote))
                        {
                            <div class="p-4 rounded-xl bg-rose-50 border border-rose-200 space-y-1">
                                <span class="text-xs font-bold text-rose-800 uppercase tracking-wider block">Manager Rejection Note</span>
                                <p class="text-xs text-rose-900 font-medium">
                                    @Model.ManagerNote
                                </p>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- Right Column (1 Col) -->
        <div class="space-y-6">
            <!-- Staff Information Card -->
            <div class="bg-white border border-slate-200 rounded-2xl shadow-xs overflow-hidden">
                <div class="px-6 py-4 border-b border-slate-150 flex items-center gap-2.5 bg-slate-50/60">
                    <span class="material-symbols-outlined text-indigo-600 text-xl">person</span>
                    <h2 class="text-sm font-bold text-slate-900">Staff Member</h2>
                </div>

                <div class="p-6 space-y-3">
                    <div>
                        <h3 class="text-base font-bold text-slate-900">@Model.StaffName</h3>
                        <span class="inline-block mt-1 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-slate-100 text-slate-600 border border-slate-200">
                            @Model.RoleName
                        </span>
                    </div>

                    <div class="w-full pt-3 border-t border-slate-100 space-y-2 text-xs text-slate-600">
                        @if (!string.IsNullOrWhiteSpace(Model.StaffEmail))
                        {
                            <div class="flex items-center gap-2">
                                <span class="material-symbols-outlined text-slate-400 text-sm">mail</span>
                                <span class="truncate">@Model.StaffEmail</span>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.StaffPhone))
                        {
                            <div class="flex items-center gap-2">
                                <span class="material-symbols-outlined text-slate-400 text-sm">call</span>
                                <span>@Model.StaffPhone</span>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Shift & Timesheet Reference Card -->
            <div class="bg-white border border-slate-200 rounded-2xl shadow-xs overflow-hidden">
                <div class="px-6 py-4 border-b border-slate-150 flex items-center gap-2.5 bg-slate-50/60">
                    <span class="material-symbols-outlined text-indigo-600 text-xl">calendar_month</span>
                    <h2 class="text-sm font-bold text-slate-900">Shift Reference</h2>
                </div>

                <div class="p-6 space-y-3 text-xs text-slate-600">
                    <div>
                        <span class="text-slate-400 block mb-0.5">Shift Name</span>
                        <span class="font-bold text-slate-900 text-sm">@Model.ShiftName</span>
                    </div>

                    <div>
                        <span class="text-slate-400 block mb-0.5">Shift Date</span>
                        <span class="font-semibold text-slate-800">@Model.ShiftDateDisplay</span>
                    </div>

                    <div>
                        <span class="text-slate-400 block mb-0.5">Scheduled Shift Range</span>
                        <span class="font-semibold text-slate-800">@Model.ScheduledRangeDisplay</span>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.Period))
                    {
                        <div>
                            <span class="text-slate-400 block mb-0.5">Timesheet Week</span>
                            <span class="font-semibold text-indigo-600">Week @Model.Period</span>
                        </div>
                    }
                </div>
            </div>

            <!-- Actions Card -->
            <div class="bg-white border border-slate-200 rounded-2xl shadow-xs overflow-hidden">
                <div class="px-6 py-4 border-b border-slate-150 flex items-center gap-2.5 bg-slate-50/60">
                    <span class="material-symbols-outlined text-indigo-600 text-xl">gavel</span>
                    <h2 class="text-sm font-bold text-slate-900">Decision & Action</h2>
                </div>

                <div class="p-6">
                    @if (isPending)
                    {
                        <div class="space-y-3">
                            <p class="text-xs text-slate-500">
                                Review the requested changes above carefully. Approving will update attendance timestamps immediately.
                            </p>

                            <!-- Approve Button -->
                            <button type="button" onclick="openApproveModal()"
                                    class="w-full flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs transition-all shadow-xs cursor-pointer">
                                <span class="material-symbols-outlined text-base">check_circle</span>
                                <span>Approve Adjustment</span>
                            </button>

                            <!-- Reject Button -->
                            <button type="button" onclick="openRejectModal()"
                                    class="w-full flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 font-bold text-xs transition-all shadow-xs cursor-pointer">
                                <span class="material-symbols-outlined text-base">cancel</span>
                                <span>Reject Request</span>
                            </button>
                        </div>
                    }
                    else if (isApproved)
                    {
                        <div class="p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-center space-y-2">
                            <span class="material-symbols-outlined text-emerald-600 text-2xl">task_alt</span>
                            <div class="text-xs font-bold text-emerald-900">Request Approved</div>
                            <p class="text-[11px] text-emerald-700">
                                This request has already been approved and attendance metrics have been adjusted.
                            </p>
                        </div>
                    }
                    else if (isRejected)
                    {
                        <div class="p-4 rounded-xl bg-rose-50 border border-rose-200 text-center space-y-2">
                            <span class="material-symbols-outlined text-rose-600 text-2xl">block</span>
                            <div class="text-xs font-bold text-rose-900">Request Rejected</div>
                            <p class="text-[11px] text-rose-700">
                                This claim was dismissed by the store manager.
                            </p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Approve Confirmation -->
<div id="modalApproveAdjustment" class="fixed inset-0 z-50 hidden overflow-y-auto" aria-labelledby="modal-title" role="dialog" aria-modal="true">
    <div class="flex min-h-screen items-center justify-center p-4 text-center">
        <div class="fixed inset-0 bg-slate-900/40 backdrop-blur-xs transition-opacity" onclick="closeApproveModal()"></div>

        <div class="relative transform overflow-hidden rounded-2xl bg-white text-left shadow-2xl transition-all sm:my-8 sm:w-full sm:max-w-lg p-6 border border-slate-200">
            <div class="flex items-start gap-4">
                <div class="w-12 h-12 rounded-xl bg-emerald-50 border border-emerald-100 flex items-center justify-center text-emerald-600 shrink-0">
                    <span class="material-symbols-outlined text-2xl">check_circle</span>
                </div>
                <div class="flex-1">
                    <h3 class="text-base font-bold text-slate-900" id="modal-title">Approve Adjustment Request</h3>
                    <p class="text-xs text-slate-500 mt-1.5">
                        Are you sure you want to approve this shift adjustment claim for <strong>@Model.StaffName</strong>?
                    </p>
                    <p class="text-xs text-emerald-800 font-medium bg-emerald-50/80 p-2.5 rounded-xl border border-emerald-200 mt-3">
                        The requested Check-in / Check-out time will be updated into actual attendance logs, and timesheet hours will be recalculated immediately.
                    </p>
                </div>
            </div>

            <form method="post" asp-action="Approve" class="mt-6 flex justify-end gap-3">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.AdjustmentRequestId" />

                <button type="button" onclick="closeApproveModal()"
                        class="px-4 py-2 rounded-xl border border-slate-200 hover:bg-slate-50 text-slate-700 font-semibold text-xs cursor-pointer">
                    Cancel
                </button>
                <button type="submit"
                        class="px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-xs transition-all shadow-xs cursor-pointer">
                    Yes, Approve
                </button>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Reject Adjustment (Prompt for Reason) -->
<div id="modalRejectAdjustment" class="fixed inset-0 z-50 hidden overflow-y-auto" aria-labelledby="modal-reject-title" role="dialog" aria-modal="true">
    <div class="flex min-h-screen items-center justify-center p-4 text-center">
        <div class="fixed inset-0 bg-slate-900/40 backdrop-blur-xs transition-opacity" onclick="closeRejectModal()"></div>

        <div class="relative transform overflow-hidden rounded-2xl bg-white text-left shadow-2xl transition-all sm:my-8 sm:w-full sm:max-w-lg p-6 border border-slate-200">
            <div class="flex items-start gap-4">
                <div class="w-12 h-12 rounded-xl bg-rose-50 border border-rose-100 flex items-center justify-center text-rose-600 shrink-0">
                    <span class="material-symbols-outlined text-2xl">cancel</span>
                </div>
                <div class="flex-1">
                    <h3 class="text-base font-bold text-slate-900" id="modal-reject-title">Reject Adjustment Request</h3>
                    <p class="text-xs text-slate-500 mt-1.5">
                        Please provide a reason or note explaining why this adjustment for <strong>@Model.StaffName</strong> is rejected.
                    </p>
                </div>
            </div>

            <form method="post" asp-action="Reject" class="mt-4 space-y-4">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.AdjustmentRequestId" />

                <div>
                    <label for="rejectManagerNote" class="block text-xs font-semibold text-slate-700 mb-1">
                        Rejection Reason / Manager Note <span class="text-rose-500">*</span>
                    </label>
                    <textarea id="rejectManagerNote" name="managerNote" rows="3" required minlength="3" maxlength="500"
                              placeholder="e.g. CCTV records do not match the claimed arrival time..."
                              class="w-full p-3 rounded-xl border border-slate-200 text-xs focus:outline-none focus:border-rose-500 focus:ring-1 focus:ring-rose-500"></textarea>
                </div>

                <div class="flex justify-end gap-3 pt-2">
                    <button type="button" onclick="closeRejectModal()"
                            class="px-4 py-2 rounded-xl border border-slate-200 hover:bg-slate-50 text-slate-700 font-semibold text-xs cursor-pointer">
                        Cancel
                    </button>
                    <button type="submit"
                            class="px-4 py-2 rounded-xl bg-rose-600 hover:bg-rose-700 text-white font-semibold text-xs transition-all shadow-xs cursor-pointer">
                        Confirm Rejection
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openApproveModal() {
            document.getElementById('modalApproveAdjustment').classList.remove('hidden');
        }

        function closeApproveModal() {
            document.getElementById('modalApproveAdjustment').classList.add('hidden');
        }

        function openRejectModal() {
            document.getElementById('rejectManagerNote').value = '';
            document.getElementById('modalRejectAdjustment').classList.remove('hidden');
        }

        function closeRejectModal() {
            document.getElementById('modalRejectAdjustment').classList.add('hidden');
        }
    </script>
}
