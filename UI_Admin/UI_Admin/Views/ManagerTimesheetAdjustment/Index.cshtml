@model UI_Admin.Models.Manager.TimesheetAdjustment.ManagerTimesheetAdjustmentListViewModel
@{
    Layout = "_ManagerLayout";
    ViewData["Title"] = "Timesheet Adjustments";
}

<div class="px-7 py-6 max-w-[1440px] mx-auto space-y-6">
    <!-- Breadcrumb & Header Title -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-1.5 text-xs text-indigo-600 font-semibold uppercase tracking-wider mb-1">
                <a asp-controller="ManagerTimesheet" asp-action="Index" class="hover:underline flex items-center gap-1">
                    <span class="material-symbols-outlined text-sm">table_chart</span>
                    <span>Timesheets</span>
                </a>
                <span>/</span>
                <span class="text-slate-400">Timesheet Adjustments</span>
            </div>
            <div class="flex items-center gap-3">
                <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Timesheet Adjustments</h1>
                @if (Model.PendingCount > 0)
                {
                    <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-amber-50 text-amber-700 border border-amber-200">
                        @Model.PendingCount Pending
                    </span>
                }
            </div>
            <p class="text-xs text-slate-500 mt-1">
                Review and resolve shift time adjustment claims submitted by branch staff members.
            </p>
        </div>

        <div class="flex items-center gap-3">
            <a asp-controller="ManagerTimesheet" asp-action="Index"
               class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-white hover:bg-slate-50 text-slate-700 border border-slate-200 text-sm font-semibold transition-all shadow-xs">
                <span class="material-symbols-outlined text-sm">table_chart</span>
                <span>Weekly Timesheets</span>
            </a>
        </div>
    </div>

    <!-- Alert Messages (Toast Banners) -->
    @if (TempData["SuccessMessage"] is string successMsg)
    {
        <div id="alertSuccessBanner" class="p-4 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-900 text-sm flex items-center justify-between gap-3 shadow-xs">
            <div class="flex items-center gap-2.5">
                <span class="material-symbols-outlined text-emerald-600 text-xl shrink-0">check_circle</span>
                <span class="font-medium">@successMsg</span>
            </div>
            <button type="button" onclick="document.getElementById('alertSuccessBanner')?.remove()" class="text-emerald-700 hover:text-emerald-950 p-1 rounded-lg">
                <span class="material-symbols-outlined text-lg leading-none">close</span>
            </button>
        </div>
    }

    @if (TempData["ErrorMessage"] is string errorMsg)
    {
        <div id="alertErrorBanner" class="p-4 rounded-2xl bg-rose-50 border border-rose-200 text-rose-900 text-sm flex items-center justify-between gap-3 shadow-xs">
            <div class="flex items-center gap-2.5">
                <span class="material-symbols-outlined text-rose-600 text-xl shrink-0">error</span>
                <span class="font-medium">@errorMsg</span>
            </div>
            <button type="button" onclick="document.getElementById('alertErrorBanner')?.remove()" class="text-rose-700 hover:text-rose-950 p-1 rounded-lg">
                <span class="material-symbols-outlined text-lg leading-none">close</span>
            </button>
        </div>
    }

    <partial name="_ListMetrics" model='@(new ListMetricViewModel[] {
        new("Adjustment requests", Model.TotalCount.ToString("N0"), "Matching current scope", "assignment"),
        new("Pending", Model.PendingCount.ToString("N0"), "Awaiting review", "pending_actions"),
        new("Approved", Model.ApprovedCount.ToString("N0"), "Hours updated", "check_circle"),
        new("Rejected", Model.RejectedCount.ToString("N0"), "Requests dismissed", "cancel")
    })' />

    <!-- Search & Filter Bar (Dropdown Filter) -->
    <form method="get" asp-action="Index" id="adjustmentFilterForm" class="ws-list-filter" role="search">
        <input type="hidden" name="scheduleWeekId" value="@Model.ScheduleWeekId" />
        <input type="hidden" name="pageSize" value="@Model.PageSize" />
        <div class="ws-filter-row">
            <label class="ws-filter-field ws-filter-keyword"><span class="material-symbols-outlined" aria-hidden="true">search</span><input aria-label="Search" type="text" name="search" value="@Model.Search" placeholder="Search by staff name, shift..." /></label>
            <div class="ws-filter-field"><select aria-label="Status" name="status" onchange="this.form.submit()">
                            <option value="ALL" selected="@(Model.Status == "ALL")">All Statuses (@Model.TotalCount)</option>
                            <option value="PENDING" selected="@(Model.Status == "PENDING")">Pending Review (@Model.PendingCount)</option>
                            <option value="APPROVED" selected="@(Model.Status == "APPROVED")">Approved (@Model.ApprovedCount)</option>
                            <option value="REJECTED" selected="@(Model.Status == "REJECTED")">Rejected (@Model.RejectedCount)</option>
                            <option value="CANCELLED" selected="@(Model.Status == "CANCELLED")">Cancelled</option>
                        </select></div>
            <partial name="_ListFilterActions" model='"Index"' />
        </div>
    </form>

    <!-- Data Table Card -->
    <div class="bg-white border border-slate-200 rounded-2xl shadow-xs overflow-hidden">
        <div class="px-6 py-4 border-b border-slate-150 flex items-center justify-between bg-slate-50/60">
            <div class="flex items-center gap-2.5">
                <span class="material-symbols-outlined text-indigo-600 text-xl">rule</span>
                <h2 class="text-sm font-bold text-slate-900">Adjustment Requests Log</h2>
                <span class="ml-2 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-indigo-50 text-indigo-700 border border-indigo-200">
                    @Model.TotalCount Claims
                </span>
            </div>
            <span class="text-xs text-slate-500 font-medium">Timezone: Vietnam (UTC+7)</span>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm text-slate-700">
                <thead class="bg-slate-50 text-xs font-semibold text-slate-500 uppercase tracking-wider border-b border-slate-200">
                    <tr>
                        <th scope="col" class="px-6 py-3.5">ID</th>
                        <th scope="col" class="px-6 py-3.5">Staff Member</th>
                        <th scope="col" class="px-6 py-3.5">Shift Name</th>
                        <th scope="col" class="px-6 py-3.5">Shift Date</th>
                        <th scope="col" class="px-6 py-3.5">Submitted At</th>
                        <th scope="col" class="px-6 py-3.5 text-center">Status</th>
                        <th scope="col" class="px-6 py-3.5 text-right">Action</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 font-medium text-xs">
                    @if (Model.Items == null || Model.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="px-6 py-12 text-center text-slate-400">
                                <div class="flex flex-col items-center justify-center gap-3">
                                    <div class="w-14 h-14 rounded-2xl bg-slate-100 flex items-center justify-center text-slate-400">
                                        <span class="material-symbols-outlined text-3xl">task_alt</span>
                                    </div>
                                    <div class="text-base font-semibold text-slate-700">No Adjustment Requests Found</div>
                                    <p class="text-xs text-slate-400 max-w-sm">No time adjustment claims match the selected status or filters.</p>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Items)
                        {
                            var status = (item.Status ?? "PENDING").ToUpper();
                            var isPending = status == "PENDING";
                            var isApproved = status == "APPROVED";
                            var isRejected = status == "REJECTED";
                            var isCancelled = status == "CANCELLED";

                            <tr class="hover:bg-slate-50/80 transition-colors">
                                <!-- ID -->
                                <td class="px-6 py-4 font-mono font-bold text-slate-500">
                                    #@item.AdjustmentRequestId
                                </td>

                                <!-- Staff Member (Avatar removed as requested) -->
                                <td class="px-6 py-4">
                                    <div class="flex flex-col">
                                        <span class="font-bold text-slate-900 text-sm">@item.StaffName</span>
                                        <span class="text-xs text-slate-400 mt-0.5">@item.RoleName</span>
                                    </div>
                                </td>

                                <!-- Shift Name -->
                                <td class="px-6 py-4">
                                    <span class="font-semibold text-slate-900 text-sm">@item.ShiftName</span>
                                </td>

                                <!-- Shift Date -->
                                <td class="px-6 py-4 text-slate-600">
                                    <div>@item.ShiftDateDisplay</div>
                                    <div class="text-[11px] text-slate-400">@item.ScheduledRangeDisplay</div>
                                </td>

                                <!-- Submitted At -->
                                <td class="px-6 py-4 text-slate-500 text-xs">
                                    @item.CreatedAt.AddHours(7).ToString("HH:mm dd/MM/yyyy")
                                </td>

                                <!-- Status Badge -->
                                <td class="px-6 py-4 text-center">
                                    @if (isPending)
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-amber-50 text-amber-700 border border-amber-200">
                                            <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span>
                                            <span>PENDING</span>
                                        </span>
                                    }
                                    else if (isApproved)
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                                            <span>APPROVED</span>
                                        </span>
                                    }
                                    else if (isRejected)
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-rose-50 text-rose-700 border border-rose-200">
                                            <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>
                                            <span>REJECTED</span>
                                        </span>
                                    }
                                    else if (isCancelled)
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-slate-100 text-slate-700 border border-slate-200">
                                            <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
                                            <span>CANCELLED</span>
                                        </span>
                                    }
                                </td>

                                <!-- Action: View Details -->
                                <td class="px-6 py-4 text-right">
                                    <a asp-action="Details" asp-route-id="@item.AdjustmentRequestId" class="ws-icon-action" title="View details" aria-label="View details"><span class="material-symbols-outlined" aria-hidden="true">visibility</span></a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination / Footer Bar -->
        <partial name="_ListPagination" model="@(new ListPaginationViewModel
        {
            PageNumber = Model.PageIndex,
            PageSize = Model.PageSize,
            TotalItems = Model.TotalCount,
            PageParameter = "pageIndex",
            ItemLabel = "claims",
        })" />
    </div>
</div>
