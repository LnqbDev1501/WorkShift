@model UI_Admin.Models.EmployeeAdjustments.SaveEmployeeAdjustmentViewModel
@using UI_Admin.Models.EmployeeAdjustments
@{
    var label = EmployeeAdjustmentTypes.Label(Model.AdjustmentType);
}
<input asp-for="AdjustmentType" type="hidden" />
<div class="grid grid-cols-1 md:grid-cols-2 gap-unit-4">
    <div>
        <label asp-for="UserId" class="block text-label-md text-secondary mb-2">Employee *</label>
        <select asp-for="UserId" required class="w-full h-[44px] px-3 border border-surface-container-high rounded-xl">
            <option value="">Select employee</option>
            @foreach (var staff in Model.StaffOptions) { <option value="@staff.UserId">@staff.FullName · @staff.Email</option> }
        </select>
        <span asp-validation-for="UserId" class="text-red-700 text-sm"></span>
    </div>
    <div>
        <label asp-for="PayrollPeriodId" class="block text-label-md text-secondary mb-2">Payroll period *</label>
        <select asp-for="PayrollPeriodId" class="w-full h-[44px] px-3 border border-surface-container-high rounded-xl">
            <option value="">Select payroll period</option>
            @foreach (var period in Model.PayrollPeriodOptions)
            {
                <option value="@period.PayrollPeriodId">@period.PeriodCode · @period.PeriodName (@period.StartDate.ToString("dd/MM/yyyy") – @period.EndDate.ToString("dd/MM/yyyy")) · @period.Status</option>
            }
        </select>
        @if (Model.OptionsLoaded && Model.PayrollPeriodOptions.Count == 0)
        {
            <p class="text-xs text-amber-700 mt-2">No DRAFT/OPEN payroll period is available in your branch. Create or open a period first.</p>
        }
        <span asp-validation-for="PayrollPeriodId" class="text-red-700 text-sm"></span>
    </div>
    <div>
        <label asp-for="AdjustmentName" class="block text-label-md text-secondary mb-2">@label name *</label>
        <input asp-for="AdjustmentName" type="text" maxlength="100" required placeholder="e.g. Monthly performance bonus" class="w-full h-[44px] px-3 border border-surface-container-high rounded-xl" />
        <span asp-validation-for="AdjustmentName" class="text-red-700 text-sm"></span>
    </div>
    <div>
        <label asp-for="Amount" class="block text-label-md text-secondary mb-2">Amount (VND) *</label>
        <input asp-for="Amount" type="number" min="0.01" max="9999999999999999.99" step="0.01" required class="w-full h-[44px] px-3 border border-surface-container-high rounded-xl" />
        <span asp-validation-for="Amount" class="text-red-700 text-sm"></span>
    </div>
</div>
<div>
    <label asp-for="Reason" class="block text-label-md text-secondary mb-2">Reason *</label>
    <textarea asp-for="Reason" rows="4" maxlength="500" required class="w-full px-3 py-3 border border-surface-container-high rounded-xl"></textarea>
    <span asp-validation-for="Reason" class="text-red-700 text-sm"></span>
</div>
