@model UI_Admin.Models.EmployeeAdjustments.EmployeeAdjustmentListViewModel
@using D = UI_Admin.Models.EmployeeAdjustments.EmployeeAdjustmentDisplay
@using UI_Admin.Models.EmployeeAdjustments
@{
    var admin = User.IsInRole("ADMIN");
    var manager = User.IsInRole("MANAGER");
    Layout = admin ? "_AdminLayout" : manager ? "_ManagerLayout" : "_AccountantLayout";
    var label = EmployeeAdjustmentTypes.Label(Model.AdjustmentType);
    var plural = EmployeeAdjustmentTypes.Plural(Model.AdjustmentType);
    ViewData["Title"] = $"Employee {plural}";
}
<div class="flex flex-col w-full gap-unit-4 px-7 py-4">
    <div class="flex flex-wrap justify-between items-center gap-3">
        <div class="form-heading">
            <div class="list-eyebrow">People · Compensation</div>
            <h1 class="text-display-lg font-display-lg text-on-surface">@ViewData["Title"]</h1>
            <p>@(manager
                ? $"Record and track employee {plural.ToLowerInvariant()} for approval."
                : $"View and manage employee {plural.ToLowerInvariant()} across the organization.")</p>
        </div>
        @if (manager) { <a asp-action="Create" class="btn btn-primary inline-flex items-center gap-2"><span class="material-symbols-outlined">add</span>Create @label.ToLowerInvariant()</a> }
    </div>
    <partial name="~/Views/Shared/EmployeeAdjustments/_Messages.cshtml" />
    @if (Model.ErrorMessage != null)
    { <div role="alert" class="rounded-xl bg-red-50 text-red-700 p-unit-4">@Model.ErrorMessage <a href="@Context.Request.Path@Context.Request.QueryString" class="underline">Retry</a></div> }
    <partial name="_ListMetrics" model='@(new ListMetricViewModel[] {
        new($"Matching {plural.ToLowerInvariant()}", Model.TotalItems.ToString("N0"), "Matching current filters", Model.AdjustmentType == EmployeeAdjustmentTypes.Penalty ? "gavel" : "workspace_premium"),
        new("Pending", Model.Items.Count(x => x.ApprovalStatus == "PENDING").ToString(), "On this page", "pending_actions"),
        new("Approved", Model.Items.Count(x => x.ApprovalStatus == "APPROVED").ToString(), "On this page", "check_circle"),
        new("Rejected", Model.Items.Count(x => x.ApprovalStatus == "REJECTED").ToString(), "On this page", "cancel")
    })' />
    <form asp-action="Index" method="get" class="ws-list-filter" role="search">
        <div class="ws-filter-row">
            <label class="ws-filter-field ws-filter-keyword"><span class="material-symbols-outlined" aria-hidden="true">search</span><input aria-label="Search" id="Keyword" name="Keyword" value="@Model.Query.Keyword" maxlength="200" placeholder="Search..." /></label>
            <div class="ws-filter-field"><select aria-label="Approval status" id="ApprovalStatus" name="ApprovalStatus"><option value="">All statuses</option>@foreach (var s in new[] { "PENDING", "APPROVED", "REJECTED" }) { <option value="@s" selected="@(Model.Query.ApprovalStatus == s)">@s</option> }</select></div>
            <details class="ws-filter-advanced">
                <summary title="Advanced filters" aria-label="Advanced filters"><span class="material-symbols-outlined" aria-hidden="true">tune</span>
                    @if (Context.Request.Query.Any(q => new[] { "UserId", "PayrollPeriodId", "CreatedFrom", "CreatedTo", "BranchId" }.Contains(q.Key, StringComparer.OrdinalIgnoreCase) && !string.IsNullOrWhiteSpace(q.Value.ToString()))) { <span class="ws-filter-indicator" aria-label="Advanced filters active"></span> }
                </summary>
                <div class="ws-filter-panel">
                    <label class="ws-filter-field"><span>Staff ID</span><input aria-label="Staff ID" id="UserId" name="UserId" value="@Model.Query.UserId" /></label>
                    <label class="ws-filter-field"><span>Payroll period ID</span><input aria-label="Payroll period ID" id="PayrollPeriodId" name="PayrollPeriodId" type="number" min="1" value="@Model.Query.PayrollPeriodId" /></label>
                    <label class="ws-filter-field"><span>Created from (UTC+7)</span><input aria-label="Created from (UTC+7)" id="CreatedFrom" name="CreatedFrom" type="date" value="@Model.Query.CreatedFrom?.ToString("yyyy-MM-dd")" /></label>
                    <label class="ws-filter-field"><span>Created to (UTC+7)</span><input aria-label="Created to (UTC+7)" id="CreatedTo" name="CreatedTo" type="date" value="@Model.Query.CreatedTo?.ToString("yyyy-MM-dd")" /></label>
                    @if (admin) { <label class="ws-filter-field"><span>Branch</span><input aria-label="Branch" id="BranchId" name="BranchId" type="number" min="1" value="@Model.Query.BranchId" /></label> }
                    <button type="submit" class="ws-filter-apply">Apply filters</button>
                </div>
            </details>
            <partial name="_ListFilterActions" model='"Index"' />
        </div>
        <div asp-validation-summary="All" class="text-red-700" role="alert"></div>
    </form>
    <div class="bg-surface-container-lowest rounded-xl shadow-sm overflow-hidden">
        <div class="overflow-x-auto"><table class="w-full text-left">
            <thead><tr class="bg-surface-container-low text-secondary text-label-md uppercase"><th class="px-5 py-3">Employee</th><th class="px-4 py-3">@label</th><th class="px-4 py-3">Amount</th><th class="px-4 py-3">Payroll period</th><th class="px-4 py-3">Status</th><th class="px-4 py-3">Created (UTC+7)</th><th class="px-5 py-3 text-right">Details</th></tr></thead>
            <tbody>
                @if (Model.Items.Count == 0) { <tr><td colspan="7" class="px-5 py-12 text-center text-secondary">@(Model.ErrorMessage != null ? $"{plural} could not be loaded." : !ViewData.ModelState.IsValid ? "Please correct the filters above." : $"No {plural.ToLowerInvariant()} match your filters.")</td></tr> }
                @foreach (var row in Model.Items)
                {
                    <tr class="h-[64px] hover:bg-surface-container-low border-b border-surface-container-low">
                        <td class="px-5 py-3"><strong>@row.EmployeeName</strong><div class="text-xs text-secondary">@row.BranchName · #@row.RewardPenaltyId</div></td>
                        <td class="px-4 py-3">@row.AdjustmentName</td>
                        <td class="px-4 py-3 whitespace-nowrap font-semibold @(Model.AdjustmentType == EmployeeAdjustmentTypes.Penalty ? "text-red-600" : "text-emerald-600")">@D.Money(row.Amount)</td>
                        <td class="px-4 py-3 whitespace-nowrap">@row.PeriodName<div class="text-xs text-secondary">@row.PeriodCode · @D.Date(row.PeriodStart) → @D.Date(row.PeriodEnd)</div></td>
                        <td class="px-4 py-3"><span class="rounded-full px-3 py-1 text-xs font-semibold @D.Badge(row.ApprovalStatus)">@row.ApprovalStatus</span></td>
                        <td class="px-4 py-3 whitespace-nowrap text-secondary">@D.Time(row.CreatedAt)</td>
                        <td class="px-5 py-3 text-right"><a asp-action="Details" asp-route-id="@row.RewardPenaltyId" title="View details" aria-label="View details" class="ws-icon-action"><span class="material-symbols-outlined" aria-hidden="true">visibility</span></a></td>
                    </tr>
                }
            </tbody>
        </table></div>
        @if (Model.ErrorMessage == null && ViewData.ModelState.IsValid) { <partial name="_ListPagination" model='@(new ListPaginationViewModel { PageNumber = Model.PageNumber, PageSize = Model.PageSize, TotalItems = Model.TotalItems, ItemLabel = plural.ToLowerInvariant() })' /> }
    </div>
</div>
