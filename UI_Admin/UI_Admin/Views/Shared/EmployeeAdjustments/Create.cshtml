@model UI_Admin.Models.EmployeeAdjustments.SaveEmployeeAdjustmentViewModel
@using UI_Admin.Models.EmployeeAdjustments
@{
    Layout = "_ManagerLayout";
    var label = EmployeeAdjustmentTypes.Label(Model.AdjustmentType);
    ViewData["Title"] = $"Create Employee {label}";
}
<div class="flex flex-col w-full gap-unit-4 px-7 py-4">
    <div class="flex flex-wrap justify-between items-center gap-3">
        <div class="form-heading">
            <div class="list-eyebrow">People · Compensation</div>
            <h1 class="text-display-lg font-display-lg text-on-surface">Create Employee @label</h1>
            <p>Record a @label.ToLowerInvariant() for an employee and send it to Admin for approval.</p>
        </div>
        <a asp-action="Index" class="btn btn-secondary">Back to list</a>
    </div>
    <form asp-action="Create" method="post" class="bg-surface-container-lowest rounded-xl shadow-sm p-unit-5 flex flex-col gap-unit-4">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="text-red-700" role="alert"></div>
        <partial name="~/Views/Shared/EmployeeAdjustments/_FormFields.cshtml" model="Model" />
        <p class="text-body-md text-secondary">The item is created with a PENDING approval status. Only Admin can approve or reject it before it is included in payroll.</p>
        <div class="flex justify-end gap-3">
            <a asp-action="Index" class="btn btn-secondary">Back</a>
            <button type="submit" disabled="@(!Model.OptionsLoaded || Model.StaffOptions.Count == 0 || Model.PayrollPeriodOptions.Count == 0)" class="btn btn-primary">Send to Admin</button>
        </div>
    </form>
</div>
