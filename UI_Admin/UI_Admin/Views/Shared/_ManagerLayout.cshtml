@{
    Layout = "_AdminLayout";
}
@section Styles {
    <link rel="stylesheet" href="~/css/notifications.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
}
<div class="manager-page">
    @RenderBody()
</div>
@if (TempData["SuccessMessage"] is string message)
{
    <div class="success-toast" role="status">@message <button type="button" aria-label="Đóng thông báo" onclick="this.parentElement.remove()" class="ml-3">×</button></div>
}
@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="fixed bottom-6 right-6 z-50 flex items-center gap-3 bg-red-600 text-white px-5 py-3 rounded-xl shadow-lg border border-red-700 font-medium text-sm animate-fade-in" role="alert">
        <span>@errorMessage</span>
        <button type="button" aria-label="Đóng thông báo" onclick="this.parentElement.remove()" class="ml-2 text-white hover:text-red-200 text-lg leading-none font-bold">×</button>
    </div>
}
@section Scripts {
    <script src="https://unpkg.com/lucide@0.468.0/dist/umd/lucide.min.js"></script>
    <script>window.lucide?.createIcons();</script>
    @await RenderSectionAsync("Scripts", required: false)
}
