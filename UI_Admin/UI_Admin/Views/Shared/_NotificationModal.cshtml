@{
    var successMsg = TempData["SuccessMessage"] as string;
    var errorMsg = TempData["ErrorMessage"] as string;

    if (string.IsNullOrEmpty(successMsg) && ViewData.Model is object validSuccessModel)
    {
        var prop = validSuccessModel.GetType().GetProperty("SuccessMessage");
        if (prop != null)
        {
            successMsg = prop.GetValue(validSuccessModel) as string;
        }
    }

    if (string.IsNullOrEmpty(errorMsg) && ViewData.Model is object validErrorModel)
    {
        var prop = validErrorModel.GetType().GetProperty("ErrorMessage");
        if (prop != null)
        {
            errorMsg = prop.GetValue(validErrorModel) as string;
        }
    }

    var modelStateErrors = new List<string>();
    if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
    {
        foreach (var state in ViewData.ModelState.Values)
        {
            foreach (var error in state.Errors)
            {
                if (!string.IsNullOrWhiteSpace(error.ErrorMessage))
                {
                    modelStateErrors.Add(error.ErrorMessage);
                }
            }
        }
    }
}

<!-- Success Popup Modal -->
@if (!string.IsNullOrEmpty(successMsg))
{
    <div id="notification-success-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-[#111827]/50 backdrop-blur-sm transition-opacity">
        <div class="bg-surface-container-lowest rounded-2xl max-w-md w-full p-6 shadow-2xl flex flex-col gap-4 border border-surface-container-high animate-fadeIn">
            <div class="flex items-center gap-3">
                <div class="w-11 h-11 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center shrink-0">
                    <span class="material-symbols-outlined text-[24px]">check_circle</span>
                </div>
                <div>
                    <h3 class="font-title-lg text-title-lg text-on-surface font-bold">Thành công</h3>
                    <p class="font-label-sm text-label-sm text-emerald-600 font-semibold uppercase tracking-wider">Thông báo hệ thống</p>
                </div>
            </div>
            <p class="font-body-md text-on-surface-variant leading-relaxed">
                @successMsg
            </p>
            <div class="flex justify-end pt-2">
                <button type="button" onclick="closeNotificationModal('notification-success-modal')" class="px-5 h-10 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-body-md-medium shadow-md transition-all cursor-pointer">
                    Đồng ý
                </button>
            </div>
        </div>
    </div>
}

<!-- Error / Failure Popup Modal -->
@if (!string.IsNullOrEmpty(errorMsg))
{
    <div id="notification-error-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-[#111827]/50 backdrop-blur-sm transition-opacity">
        <div class="bg-surface-container-lowest rounded-2xl max-w-md w-full p-6 shadow-2xl flex flex-col gap-4 border border-surface-container-high animate-fadeIn">
            <div class="flex items-center gap-3">
                <div class="w-11 h-11 rounded-full bg-error-container text-error flex items-center justify-center shrink-0">
                    <span class="material-symbols-outlined text-[24px]">error</span>
                </div>
                <div>
                    <h3 class="font-title-lg text-title-lg text-on-surface font-bold">Thông báo lỗi</h3>
                    <p class="font-label-sm text-label-sm text-error font-semibold uppercase tracking-wider">Thao tác không thành công</p>
                </div>
            </div>
            <p class="font-body-md text-on-surface-variant leading-relaxed">
                @errorMsg
            </p>
            <div class="flex justify-end pt-2">
                <button type="button" onclick="closeNotificationModal('notification-error-modal')" class="px-5 h-10 rounded-xl bg-error hover:bg-red-700 text-white font-body-md-medium shadow-md transition-all cursor-pointer">
                    Đóng
                </button>
            </div>
        </div>
    </div>
}

<!-- Form Validation Errors Popup Modal -->
@if (modelStateErrors.Count > 0)
{
    <div id="notification-validation-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-[#111827]/50 backdrop-blur-sm transition-opacity">
        <div class="bg-surface-container-lowest rounded-2xl max-w-md w-full p-6 shadow-2xl flex flex-col gap-4 border border-surface-container-high animate-fadeIn">
            <div class="flex items-center gap-3">
                <div class="w-11 h-11 rounded-full bg-amber-100 text-amber-700 flex items-center justify-center shrink-0">
                    <span class="material-symbols-outlined text-[24px]">warning</span>
                </div>
                <div>
                    <h3 class="font-title-lg text-title-lg text-on-surface font-bold">Vui lòng kiểm tra lại dữ liệu</h3>
                    <p class="font-label-sm text-label-sm text-amber-700 font-semibold uppercase tracking-wider">Lỗi nhập liệu</p>
                </div>
            </div>
            <ul class="space-y-2 text-body-sm text-on-surface-variant list-disc list-inside bg-surface-container-low p-3.5 rounded-xl max-h-52 overflow-y-auto">
                @foreach (var err in modelStateErrors)
                {
                    <li>@err</li>
                }
            </ul>
            <div class="flex justify-end pt-2">
                <button type="button" onclick="closeNotificationModal('notification-validation-modal')" class="px-5 h-10 rounded-xl bg-amber-600 hover:bg-amber-700 text-white font-body-md-medium shadow-md transition-all cursor-pointer">
                    Đóng
                </button>
            </div>
        </div>
    </div>
}

<script>
    function closeNotificationModal(modalId) {
        const modal = document.getElementById(modalId);
        if (modal) {
            modal.classList.add('hidden');
        }
    }

    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') {
            closeNotificationModal('notification-success-modal');
            closeNotificationModal('notification-error-modal');
            closeNotificationModal('notification-validation-modal');
        }
    });
</script>
