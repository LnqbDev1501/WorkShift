@model IReadOnlyList<UI_Admin.Models.ListMetricViewModel>
<section class="list-metrics" aria-label="List summary">
@foreach (var metric in Model)
{
    <article class="list-metric">
        <div class="list-metric-label">@metric.Label</div>
        <div class="list-metric-value">@metric.Value</div>
        <div class="list-metric-note">@metric.Note</div>
        <span class="list-metric-icon material-symbols-outlined" aria-hidden="true">@metric.Icon</span>
    </article>
}
</section>
