@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}

<aside class="fixed left-0 top-0 h-screen w-[232px] bg-[#111827] z-50 flex flex-col justify-between border-r border-[#1f2937]">
    <div class="flex flex-col flex-1 min-h-0">
        <div class="h-[64px] px-unit-5 flex items-center gap-unit-3 border-b border-[#1f2937]">
            <img alt="WorkShift Brand Wordmark" class="h-8 w-auto object-contain" src="https://lh3.googleusercontent.com/aida/AEtjO1Vdtno8pCn7_VpmeA-4JkIGfjHZW74ukz0coovXPBJSigEzaCdvvEtVuPeZDZkUoSdXaEHUEv_m8tBaEmaC8ffgCKgi9UHPcMuNQfg6pXbn1QoWzoe-614XjgoBOgDOwee4_OSNrjisQ8P5ChBEuU36UmOK867KVwKSM0YhY2HHcYrCL8ZNP5Eskqvwyw1ipN-xNtj0C04-1lV7r4y8Fx6SWYt8MRz70cNwSAEHV1gXwBcQj03eaVm2GT6f">
            <div class="flex flex-col">
                <span class="font-title-md text-white text-[15px] leading-tight tracking-tight">WorkShift</span>
                <span class="font-label-sm text-[#9ca3af] text-[10px] tracking-wider uppercase">Admin Engine</span>
            </div>
        </div>
        <div class="flex-1 overflow-y-auto px-unit-3 py-unit-4 space-y-unit-6">
            <nav class="space-y-unit-1">
                <div class="px-unit-3 pb-unit-1">
                    <span class="font-label-sm text-[#6b7280] uppercase tracking-wider text-[10px]">WORKSPACE</span>
                </div>
                <a asp-controller="Dashboard" asp-action="Index" class="flex items-center gap-unit-3 px-unit-3 py-unit-2 rounded-lg @(currentController == "Dashboard" ? "bg-primary-container text-white font-title-md" : "text-[#9ca3af] hover:bg-[#1f2937] hover:text-white") transition-colors duration-150">
                    <span class="material-symbols-outlined text-[18px]">dashboard</span>
                    <span class="font-body-md-medium text-[13px]">Overview</span>
                </a>
                <a asp-controller="User" asp-action="List" class="flex items-center gap-unit-3 px-unit-3 py-unit-2 rounded-lg @(currentController == "User" || currentController == "Users" ? "bg-primary-container text-white font-title-md" : "text-[#9ca3af] hover:bg-[#1f2937] hover:text-white") transition-colors duration-150">
                    <span class="material-symbols-outlined text-[18px]">group</span>
                    <span class="font-body-md-medium text-[13px]">User Accounts</span>
                </a>
            </nav>
            <nav class="space-y-unit-1">
                <div class="px-unit-3 pb-unit-1">
                    <span class="font-label-sm text-[#6b7280] uppercase tracking-wider text-[10px]">ORGANIZATION</span>
                </div>
                <a asp-controller="Regions" asp-action="Index" class="flex items-center gap-unit-3 px-unit-3 py-unit-2 rounded-lg @(currentController == "Regions" ? "bg-primary-container text-white font-title-md" : "text-[#9ca3af] hover:bg-[#1f2937] hover:text-white") transition-colors duration-150">
                    <span class="material-symbols-outlined text-[18px]">map</span>
                    <span class="font-body-md-medium text-[13px]">Regions</span>
                </a>
                <a asp-controller="Branches" asp-action="List" class="flex items-center gap-unit-3 px-unit-3 py-unit-2 rounded-lg @(currentController == "Branches" ? "bg-primary-container text-white font-title-md" : "text-[#9ca3af] hover:bg-[#1f2937] hover:text-white") transition-colors duration-150">
                    <span class="material-symbols-outlined text-[18px]">store</span>
                    <span class="font-body-md-medium text-[13px]">Branches</span>
                </a>
                <a asp-controller="ShiftTemplates" asp-action="List" class="flex items-center gap-unit-3 px-unit-3 py-unit-2 rounded-lg @(currentController == "ShiftTemplates" ? "bg-primary-container text-white font-title-md" : "text-[#9ca3af] hover:bg-[#1f2937] hover:text-white") transition-colors duration-150">
                    <span class="material-symbols-outlined text-[18px]">schedule</span>
                    <span class="font-body-md-medium text-[13px]">Shift Templates</span>
                </a>
            </nav>
            <nav class="space-y-unit-1">
                <div class="px-unit-3 pb-unit-1">
                    <span class="font-label-sm text-[#6b7280] uppercase tracking-wider text-[10px]">OPERATIONS</span>
                </div>
                <a asp-controller="Payroll" asp-action="List" class="flex items-center gap-unit-3 px-unit-3 py-unit-2 rounded-lg @(currentController == "Payroll" ? "bg-primary-container text-white font-title-md" : "text-[#9ca3af] hover:bg-[#1f2937] hover:text-white") transition-colors duration-150">
                    <span class="material-symbols-outlined text-[18px]">payments</span>
                    <span class="font-body-md-medium text-[13px]">Payroll Approvals</span>
                </a>
                <a asp-controller="Requests" asp-action="List" class="flex items-center gap-unit-3 px-unit-3 py-unit-2 rounded-lg @(currentController == "Requests" ? "bg-primary-container text-white font-title-md" : "text-[#9ca3af] hover:bg-[#1f2937] hover:text-white") transition-colors duration-150">
                    <span class="material-symbols-outlined text-[18px]">check_circle</span>
                    <span class="font-body-md-medium text-[13px]">Requests</span>
                </a>
                <a asp-controller="Notifications" asp-action="List" class="flex items-center gap-unit-3 px-unit-3 py-unit-2 rounded-lg @(currentController == "Notifications" ? "bg-primary-container text-white font-title-md" : "text-[#9ca3af] hover:bg-[#1f2937] hover:text-white") transition-colors duration-150">
                    <span class="material-symbols-outlined text-[18px]">notifications</span>
                    <span class="font-body-md-medium text-[13px]">Notifications</span>
                </a>
            </nav>
        </div>
    </div>
    <div class="p-unit-3 border-t border-[#1f2937] bg-[#0d131f]">
        <div class="flex items-center gap-unit-3 px-unit-2 py-unit-1">
            <img alt="Profile" class="w-8 h-8 rounded-full object-cover border border-[#374151]" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDxBqyVKY3tSSdbSk2R1vAcGD4081GVIvabN1KxoezORlQQQU4QL834LccRH3msx2wGRRYrXCubaeO0clG7Ln26m_rObsktqf1a-b4MzFcLnDFoqubTn0QZxCPOi1ocOcwRgVp2UcUm2Ii-fXYDIWONx_TYhOA-nr6tHzsSrjIj6tH_2VJ2HW_5rij3HSL21l6w64l7mqTh8DMiVGq21fjjJMgt4JO44tEWiuglcaNqGZlE8_ean_HMrw">
            <div class="flex flex-col min-w-0 flex-1">
                <span class="font-title-md text-white text-[13px] leading-snug truncate">Nguyen Minh Chau</span>
                <span class="font-label-sm text-[#9ca3af] text-[11px] truncate">Super Admin</span>
            </div>
        </div>
    </div>
</aside>
