@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    var realtimeAction = ViewContext.RouteData.Values["action"]?.ToString();
    var realtimeEnabled = realtimeAction is "Index" or "List" or "Detail" or "Details" or "Rules" or "Rule";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WorkShift Admin</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <style>
        @@layer base {
            html, body { margin: 0; padding: 0; }
            body { overscroll-behavior: none; }
            main > :first-child { margin-top: 0 !important; }
            main > :last-child { margin-bottom: 0 !important; }
        }
        ::-webkit-scrollbar { display: none; }
        .material-symbols-outlined {
            font-family: 'Material Symbols Outlined', sans-serif;
            font-weight: normal;
            font-style: normal;
            line-height: 1;
            letter-spacing: normal;
            text-transform: none;
            display: inline-block;
            white-space: nowrap;
            word-wrap: normal;
            direction: ltr;
            -webkit-font-smoothing: antialiased;
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
            user-select: none;
        }
    </style>

    <script src="https://cdn.tailwindcss.com"></script>
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "on-error": "#ffffff",
                        "on-primary-fixed": "#0f0069",
                        "on-primary-container": "#dad7ff",
                        "on-primary-fixed-variant": "#3323cc",
                        "on-primary-fixed-variant": "#3323cc",
                        "on-primary-container": "#dad7ff",
                        "on-primary-fixed": "#0f0069",
                        "surface": "#f8f9fd",
                        "surface-container-low": "#f2f3f7",
                        "surface-dim": "#d9dade",
                        "inverse-surface": "#2e3134",
                        "background": "#f8f9fd",
                        "surface-bright": "#f8f9fd",
                        "on-background": "#191c1f",
                        "on-tertiary-fixed": "#0b1c30",
                        "outline": "#777587",
                        "on-tertiary": "#ffffff",
                        "tertiary-fixed-dim": "#b7c8e1",
                        "primary-container": "#4f46e5",
                        "on-secondary-container": "#5c6274",
                        "secondary-container": "#d9dff5",
                        "inverse-primary": "#c3c0ff",
                        "surface-container-high": "#e7e8ec",
                        "secondary-fixed": "#dce2f7",
                        "on-secondary-fixed": "#141b2b",
                        "surface-container-lowest": "#ffffff",
                        "tertiary-fixed": "#d3e4fe",
                        "on-error-container": "#93000a",
                        "on-tertiary-container": "#ccdcf7",
                        "surface-tint": "#4d44e3",
                        "on-surface": "#191c1f",
                        "primary-fixed-dim": "#c3c0ff",
                        "primary-fixed": "#e2dfff",
                        "inverse-on-surface": "#eff1f5",
                        "on-secondary": "#ffffff",
                        "surface-container-highest": "#e1e2e6",
                        "surface-container": "#edeef2",
                        "on-surface-variant": "#464555",
                        "tertiary": "#3a495f",
                        "error": "#ba1a1a",
                        "outline-variant": "#c7c4d8",
                        "tertiary-container": "#516177",
                        "surface-variant": "#e1e2e6",
                        "secondary-fixed-dim": "#c0c6db",
                        "error-container": "#ffdad6",
                        "secondary": "#575e70",
                        "primary": "#3525cd",
                        "on-primary": "#ffffff",
                        "on-secondary-fixed-variant": "#404758",
                        "on-tertiary-fixed-variant": "#38485d"
                    },
                    "borderRadius": { "DEFAULT": "0.125rem", "lg": "0.25rem", "xl": "0.5rem", "full": "0.75rem" },
                    "spacing": {
                        "unit-4": "1rem", "sidebar-width": "16.25rem", "input-height": "2.5rem",
                        "unit-8": "2rem", "unit-6": "1.5rem", "unit-12": "3rem", "unit-10": "2.5rem",
                        "unit-2": "0.5rem", "unit-1": "0.25rem", "topbar-height": "4rem",
                        "unit-3": "0.75rem", "table-row-height": "3.5rem", "unit-5": "1.25rem"
                    },
                    "fontFamily": {
                        "title-md": ["Inter", "Arial", "Helvetica", "sans-serif"], "label-md": ["Inter", "Arial", "Helvetica", "sans-serif"], "label-sm": ["Inter", "Arial", "Helvetica", "sans-serif"],
                        "display-lg": ["Inter", "Arial", "Helvetica", "sans-serif"], "code-num": ["Inter", "Arial", "Helvetica", "sans-serif"], "display-md": ["Inter", "Arial", "Helvetica", "sans-serif"],
                        "title-lg": ["Inter", "Arial", "Helvetica", "sans-serif"], "body-md-medium": ["Inter", "Arial", "Helvetica", "sans-serif"], "body-md": ["Inter", "Arial", "Helvetica", "sans-serif"],
                        "body-sm": ["Inter", "Arial", "Helvetica", "sans-serif"]
                    },
                    "fontSize": {
                        "title-md": ["16px", { "lineHeight": "24px", "letterSpacing": "-0.005em", "fontWeight": "600" }],
                        "label-md": ["12px", { "lineHeight": "16px", "letterSpacing": "0.02em", "fontWeight": "600" }],
                        "label-sm": ["11px", { "lineHeight": "14px", "letterSpacing": "0.03em", "fontWeight": "500" }],
                        "display-lg": ["32px", { "lineHeight": "40px", "letterSpacing": "-0.02em", "fontWeight": "700" }],
                        "code-num": ["13px", { "lineHeight": "18px", "letterSpacing": "-0.01em", "fontWeight": "500" }],
                        "display-md": ["24px", { "lineHeight": "32px", "letterSpacing": "-0.015em", "fontWeight": "600" }],
                        "title-lg": ["20px", { "lineHeight": "28px", "letterSpacing": "-0.01em", "fontWeight": "600" }],
                        "body-md-medium": ["14px", { "lineHeight": "20px", "letterSpacing": "0em", "fontWeight": "500" }],
                        "body-md": ["14px", { "lineHeight": "20px", "letterSpacing": "0em", "fontWeight": "400" }],
                        "body-sm": ["13px", { "lineHeight": "18px", "letterSpacing": "0em", "fontWeight": "400" }]
                    }
                }
            }
        };
    </script>

    <style>
        /* Collapsible Sidebar Styles */
        #admin-sidebar {
            transition: width 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        }
        #main-content-wrapper {
            transition: padding-left 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .sidebar-collapsed #admin-sidebar {
            width: 72px !important;
        }
        .sidebar-collapsed #main-content-wrapper {
            padding-left: 72px !important;
        }
        .sidebar-collapsed .sidebar-full-label,
        .sidebar-collapsed .sidebar-header-full,
        .sidebar-collapsed .sidebar-user-full,
        .sidebar-collapsed .sidebar-category-header {
            display: none !important;
        }
        .sidebar-collapsed .sidebar-header-collapsed,
        .sidebar-collapsed .sidebar-user-collapsed {
            display: flex !important;
        }
        .sidebar-collapsed .sidebar-nav-item {
            justify-content: center !important;
            padding-left: 0.5rem !important;
            padding-right: 0.5rem !important;
        }
    </style>

    <script>
        // Prevent layout flash on initial load
        (function() {
            try {
                if (localStorage.getItem('admin_sidebar_collapsed') === 'true') {
                    document.documentElement.classList.add('sidebar-collapsed');
                }
            } catch (e) {}
        })();
    </script>

    @await RenderSectionAsync("Styles", required: false)
    <link rel="stylesheet" href="~/css/workshift-theme.css" asp-append-version="true" />
    @if (User.IsInRole("MANAGER"))
    {
        <link rel="stylesheet" href="~/css/manager-workspace.css" asp-append-version="true" />
    }
</head>
<body class="workshift-theme bg-background font-body-md text-on-surface @(User.IsInRole("MANAGER") ? "manager-workspace" : "")">
    <partial name="_AdminSidebar" />

    <div id="main-content-wrapper" class="pl-[232px]">
        <main class="relative bg-[#F6F7FB] min-h-screen">
            @RenderBody()
        </main>
    </div>

    <script>
        function toggleAdminSidebar() {
            const isCollapsed = document.documentElement.classList.toggle('sidebar-collapsed');
            try {
                localStorage.setItem('admin_sidebar_collapsed', isCollapsed ? 'true' : 'false');
            } catch (e) {}
        }
    </script>

    <script src="~/js/page-mascot.js"></script>
    @if (realtimeEnabled)
    {
        <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
        <script id="admin-realtime-config" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new { apiBaseUrl = Configuration["WorkShiftApi:BaseUrl"]?.TrimEnd('/') ?? "https://localhost:7193" }))</script>
        <script src="~/js/admin-realtime.js" asp-append-version="true"></script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
