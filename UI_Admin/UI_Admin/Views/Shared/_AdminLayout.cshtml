<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WorkShift Admin</title>

    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    
    <style>
        @@layer base {
            html, body { margin: 0; padding: 0; }
            body { overscroll-behavior: none; }
            main > :first-child { margin-top: 0 !important; }
            main > :last-child { margin-bottom: 0 !important; }
        }
        ::-webkit-scrollbar { display: none; }
    </style>

    <script src="https://cdn.tailwindcss.com"></script>
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "on-error": "#ffffff",
                        "on-primary-fixed": "#0f0069",
                        "on-primary-container": "#dad7ff",
                        "on-primary-fixed-variant": "#3323cc",
                        "surface": "#f8f9fd",
                        "surface-container-low": "#f2f3f7",
                        "surface-dim": "#d9dade",
                        "inverse-surface": "#2e3134",
                        "background": "#f8f9fd",
                        "surface-bright": "#f8f9fd",
                        "on-background": "#191c1f",
                        "on-tertiary-fixed": "#0b1c30",
                        "outline": "#777587",
                        "on-tertiary": "#ffffff",
                        "tertiary-fixed-dim": "#b7c8e1",
                        "primary-container": "#4f46e5",
                        "on-secondary-container": "#5c6274",
                        "secondary-container": "#d9dff5",
                        "inverse-primary": "#c3c0ff",
                        "surface-container-high": "#e7e8ec",
                        "secondary-fixed": "#dce2f7",
                        "on-secondary-fixed": "#141b2b",
                        "surface-container-lowest": "#ffffff",
                        "tertiary-fixed": "#d3e4fe",
                        "on-error-container": "#93000a",
                        "on-tertiary-container": "#ccdcf7",
                        "surface-tint": "#4d44e3",
                        "on-surface": "#191c1f",
                        "primary-fixed-dim": "#c3c0ff",
                        "primary-fixed": "#e2dfff",
                        "inverse-on-surface": "#eff1f5",
                        "on-secondary": "#ffffff",
                        "surface-container-highest": "#e1e2e6",
                        "surface-container": "#edeef2",
                        "on-surface-variant": "#464555",
                        "tertiary": "#3a495f",
                        "error": "#ba1a1a",
                        "outline-variant": "#c7c4d8",
                        "tertiary-container": "#516177",
                        "surface-variant": "#e1e2e6",
                        "secondary-fixed-dim": "#c0c6db",
                        "error-container": "#ffdad6",
                        "secondary": "#575e70",
                        "primary": "#3525cd",
                        "on-primary": "#ffffff",
                        "on-secondary-fixed-variant": "#404758",
                        "on-tertiary-fixed-variant": "#38485d"
                    },
                    "borderRadius": { "DEFAULT": "0.125rem", "lg": "0.25rem", "xl": "0.5rem", "full": "0.75rem" },
                    "spacing": {
                        "unit-4": "1rem", "sidebar-width": "16.25rem", "input-height": "2.5rem",
                        "unit-8": "2rem", "unit-6": "1.5rem", "unit-12": "3rem", "unit-10": "2.5rem",
                        "unit-2": "0.5rem", "unit-1": "0.25rem", "topbar-height": "4rem",
                        "unit-3": "0.75rem", "table-row-height": "3.5rem", "unit-5": "1.25rem"
                    },
                    "fontFamily": {
                        "title-md": ["Inter"], "label-md": ["Inter"], "label-sm": ["Inter"],
                        "display-lg": ["Inter"], "code-num": ["Inter"], "display-md": ["Inter"],
                        "title-lg": ["Inter"], "body-md-medium": ["Inter"], "body-md": ["Inter"],
                        "body-sm": ["Inter"]
                    },
                    "fontSize": {
                        "title-md": ["16px", { "lineHeight": "24px", "letterSpacing": "-0.005em", "fontWeight": "600" }],
                        "label-md": ["12px", { "lineHeight": "16px", "letterSpacing": "0.02em", "fontWeight": "600" }],
                        "label-sm": ["11px", { "lineHeight": "14px", "letterSpacing": "0.03em", "fontWeight": "500" }],
                        "display-lg": ["32px", { "lineHeight": "40px", "letterSpacing": "-0.02em", "fontWeight": "700" }],
                        "code-num": ["13px", { "lineHeight": "18px", "letterSpacing": "-0.01em", "fontWeight": "500" }],
                        "display-md": ["24px", { "lineHeight": "32px", "letterSpacing": "-0.015em", "fontWeight": "600" }],
                        "title-lg": ["20px", { "lineHeight": "28px", "letterSpacing": "-0.01em", "fontWeight": "600" }],
                        "body-md-medium": ["14px", { "lineHeight": "20px", "letterSpacing": "0em", "fontWeight": "500" }],
                        "body-md": ["14px", { "lineHeight": "20px", "letterSpacing": "0em", "fontWeight": "400" }],
                        "body-sm": ["13px", { "lineHeight": "18px", "letterSpacing": "0em", "fontWeight": "400" }]
                    }
                }
            }
        };
    </script>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="bg-background font-body-md text-on-surface">
    <partial name="_AdminSidebar" />

    <div class="pl-[232px]">
        <header class="fixed top-0 left-[232px] right-0 h-[64px] bg-surface-container-lowest border-b border-surface-container-highest z-40 flex items-center justify-between px-unit-8">
            <div class="flex items-center gap-unit-3">
                <div class="flex items-center gap-unit-2 font-label-md text-secondary">
                    <span class="font-body-md text-secondary">Admin</span>
                    <span class="material-symbols-outlined text-[16px] text-outline-variant">chevron_right</span>
                    <span class="font-body-md-medium text-on-surface">@ViewData["Title"]</span>
                </div>
            </div>
            <div class="flex items-center gap-unit-4">
                <div class="flex items-center gap-unit-3 border-l border-surface-container-high pl-unit-4">
                    <div class="flex flex-col text-right">
                        <span class="font-title-md text-on-surface text-[13px] leading-none">Nguyen Minh Chau</span>
                        <span class="font-label-sm text-secondary text-[11px] mt-0.5">Super Admin</span>
                    </div>
                    <img alt="Profile" class="w-8 h-8 rounded-full object-cover border border-outline-variant" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDxBqyVKY3tSSdbSk2R1vAcGD4081GVIvabN1KxoezORlQQQU4QL834LccRH3msx2wGRRYrXCubaeO0clG7Ln26m_rObsktqf1a-b4MzFcLnDFoqubTn0QZxCPOi1ocOcwRgVp2UcUm2Ii-fXYDIWONx_TYhOA-nr6tHzsSrjIj6tH_2VJ2HW_5rij3HSL21l6w64l7mqTh8DMiVGq21fjjJMgt4JO44tEWiuglcaNqGZlE8_ean_HMrw">
                </div>
            </div>
        </header>

        <main class="relative pt-[64px] bg-[#F6F7FB] min-h-screen px-unit-8 py-unit-8">
            <div class="w-full max-w-[1440px] mx-auto">
                @RenderBody()
            </div>
        </main>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>