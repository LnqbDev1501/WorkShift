                                    <span class="material-symbols-outlined text-[18px]" id="copy-icon">content_copy</span>
                                </button>
                            </div>
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-unit-4">
                            <div class="flex flex-col">
                                <span class="font-label-sm text-secondary uppercase tracking-wider text-[11px]">Current Status</span>
                                <div class="flex items-center gap-1.5 mt-0.5">
                                    <span class="w-2 h-2 rounded-full bg-[#f59e0b]"></span>
                                    <span class="font-body-md-medium text-[#b45309] text-body-md font-semibold">PENDING</span>
                                </div>
                            </div>
                            <div class="flex flex-col">
                                <span class="font-label-sm text-secondary uppercase tracking-wider text-[11px]">Previous Status</span>
                                <span class="font-code-num text-secondary text-body-md mt-0.5 italic">None (null)</span>
                            </div>
                            <div class="flex flex-col">
                                <span class="font-label-sm text-secondary uppercase tracking-wider text-[11px]">Soft Deleted (deletedAt)</span>
                                <div class="flex items-center gap-1.5 mt-0.5">
                                    <span class="material-symbols-outlined text-[16px] text-[#059669]">check_circle</span>
                                    <span class="font-code-num text-on-surface text-body-md">null <span class="text-secondary text-[12px] font-body-sm">(Active Record)</span></span>
                                </div>
                            </div>
                            <div class="flex flex-col">
