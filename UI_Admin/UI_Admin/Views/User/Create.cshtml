@{
    ViewData["Title"] = "Create User Account";
}

@section Styles {
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "on-error": "#ffffff",
                        "on-primary-fixed": "#0f0069",
                        "on-primary-container": "#dad7ff",
                        "on-primary-fixed-variant": "#3323cc",
                        "surface": "#f8f9fd",
                        "surface-container-low": "#f2f3f7",
                        "surface-dim": "#d9dade",
                        "inverse-surface": "#2e3134",
                        "background": "#f8f9fd",
                        "surface-bright": "#f8f9fd",
                        "on-background": "#191c1f",
                        "on-tertiary-fixed": "#0b1c30",
                        "outline": "#777587",
                        "on-tertiary": "#ffffff",
                        "tertiary-fixed-dim": "#b7c8e1",
                        "primary-container": "#4f46e5",
                        "on-secondary-container": "#5c6274",
                        "secondary-container": "#d9dff5",
                        "inverse-primary": "#c3c0ff",
                        "surface-container-high": "#e7e8ec",
                        "secondary-fixed": "#dce2f7",
                        "on-secondary-fixed": "#141b2b",
                        "surface-container-lowest": "#ffffff",
                        "tertiary-fixed": "#d3e4fe",
                        "on-error-container": "#93000a",
                        "on-tertiary-container": "#ccdcf7",
                        "surface-tint": "#4d44e3",
                        "on-surface": "#191c1f",
                        "primary-fixed-dim": "#c3c0ff",
                        "primary-fixed": "#e2dfff",
                        "inverse-on-surface": "#eff1f5",
                        "on-secondary": "#ffffff",
                        "surface-container-highest": "#e1e2e6",
                        "surface-container": "#edeef2",
                        "on-surface-variant": "#464555",
                        "tertiary": "#3a495f",
                        "error": "#ba1a1a",
                        "outline-variant": "#c7c4d8",
                        "tertiary-container": "#516177",
                        "surface-variant": "#e1e2e6",
                        "secondary-fixed-dim": "#c0c6db",
                        "error-container": "#ffdad6",
                        "secondary": "#575e70",
                        "primary": "#3525cd",
                        "on-primary": "#ffffff",
                        "on-secondary-fixed-variant": "#404758",
                        "on-tertiary-fixed-variant": "#38485d"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.125rem",
                        "lg": "0.25rem",
                        "xl": "0.5rem",
                        "full": "0.75rem"
                    },
                    "spacing": {
                        "unit-4": "1rem",
                        "sidebar-width": "16.25rem",
                        "input-height": "2.5rem",
                        "unit-8": "2rem",
                        "unit-6": "1.5rem",
                        "unit-12": "3rem",
                        "unit-10": "2.5rem",
                        "unit-2": "0.5rem",
                        "unit-1": "0.25rem",
                        "topbar-height": "4rem",
                        "unit-3": "0.75rem",
                        "table-row-height": "3.5rem",
                        "unit-5": "1.25rem"
                    },
                    "fontFamily": {
                        "title-md": ["Inter"],
                        "label-md": ["Inter"],
                        "label-sm": ["Inter"],
                        "display-lg": ["Inter"],
                        "code-num": ["Inter"],
                        "display-md": ["Inter"],
                        "title-lg": ["Inter"],
                        "body-md-medium": ["Inter"],
                        "body-md": ["Inter"],
                        "body-sm": ["Inter"]
                    },
                    "fontSize": {
                        "title-md": ["16px", { "lineHeight": "24px", "letterSpacing": "-0.005em", "fontWeight": "600" }],
                        "label-md": ["12px", { "lineHeight": "16px", "letterSpacing": "0.02em", "fontWeight": "600" }],
                        "label-sm": ["11px", { "lineHeight": "14px", "letterSpacing": "0.03em", "fontWeight": "500" }],
                        "display-lg": ["32px", { "lineHeight": "40px", "letterSpacing": "-0.02em", "fontWeight": "700" }],
                        "code-num": ["13px", { "lineHeight": "18px", "letterSpacing": "-0.01em", "fontWeight": "500" }],
                        "display-md": ["24px", { "lineHeight": "32px", "letterSpacing": "-0.015em", "fontWeight": "600" }],
                        "title-lg": ["20px", { "lineHeight": "28px", "letterSpacing": "-0.01em", "fontWeight": "600" }],
                        "body-md-medium": ["14px", { "lineHeight": "20px", "letterSpacing": "0em", "fontWeight": "500" }],
                        "body-md": ["14px", { "lineHeight": "20px", "letterSpacing": "0em", "fontWeight": "400" }],
                        "body-sm": ["13px", { "lineHeight": "18px", "letterSpacing": "0em", "fontWeight": "400" }]
                    }
                }
            }
        };
    </script>
}

<header class="fixed top-0 left-[232px] right-0 h-[64px] bg-surface-container-lowest border-b border-surface-container-highest z-40 flex items-center justify-between px-unit-8">
    <div class="flex items-center gap-unit-3">
        <div class="flex items-center gap-unit-2 font-label-md text-secondary">
            <span class="font-body-md text-secondary">Admin</span>
            <span class="material-symbols-outlined text-[16px] text-outline-variant">chevron_right</span>
            <span class="font-body-md text-secondary">WorkShift Control</span>
            <span class="material-symbols-outlined text-[16px] text-outline-variant">chevron_right</span>
            <a asp-controller="User" asp-action="List" class="font-body-md text-secondary hover:text-primary-container transition-colors text-decoration-none">User Accounts</a>
            <span class="material-symbols-outlined text-[16px] text-outline-variant">chevron_right</span>
            <span class="font-body-md-medium text-on-surface">Create Account</span>
        </div>
    </div>
    <div class="flex items-center gap-unit-4">
        <div class="flex items-center gap-unit-3 border-l border-surface-container-high pl-unit-4">
            <div class="flex flex-col text-right">
                <span class="font-title-md text-on-surface text-[13px] leading-none">Nguyen Minh Chau</span>
                <span class="font-label-sm text-secondary text-[11px] mt-0.5">Super Admin</span>
            </div>
            <img alt="Profile" class="w-8 h-8 rounded-full object-cover border border-outline-variant" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDxBqyVKY3tSSdbSk2R1vAcGD4081GVIvabN1KxoezORlQQQU4QL834LccRH3msx2wGRRYrXCubaeO0clG7Ln26m_rObsktqf1a-b4MzFcLnDFoqubTn0QZxCPOi1ocOcwRgVp2UcUm2Ii-fXYDIWONx_TYhOA-nr6tHzsSrjIj6tH_2VJ2HW_5rij3HSL21l6w64l7mqTh8DMiVGq21fjjJMgt4JO44tEWiuglcaNqGZlE8_ean_HMrw">
        </div>
    </div>
</header>

<main class="relative pt-[64px] bg-[#F6F7FB] min-h-screen px-unit-8 py-unit-8">
    <div class="w-full max-w-[1440px] mx-auto">
        <div class="flex flex-col w-full">
            <!-- Page Header Breadcrumb & Actions Bar -->
            <div class="mb-unit-6 flex flex-col md:flex-row md:items-center justify-between gap-unit-4">
                <div class="space-y-unit-1">
                    <div class="inline-flex items-center gap-unit-2 px-unit-2 py-0.5 bg-surface-container-high rounded-full">
                        <span class="w-1.5 h-1.5 rounded-full bg-primary-container"></span>
                        <span class="font-label-sm text-secondary tracking-wider uppercase text-[10px]">Staff Provisioning • RBAC Enforcement</span>
                    </div>
                    <h1 class="font-display-lg text-on-surface tracking-tight text-[26px]">Create User Account</h1>
                    <p class="font-body-md text-secondary text-[13px]">Provision and onboard operational Manager or Accountant credentials with Supabase Auth invitation and branch quota enforcement.</p>
                </div>
                <div class="flex items-center gap-unit-3">
                    <a asp-controller="User" asp-action="List" class="h-input-height px-unit-4 rounded-xl bg-surface-container-lowest text-slate-700 font-body-md-medium hover:bg-surface-container border border-surface-container-high transition-colors duration-150 inline-flex items-center gap-unit-2 shadow-sm text-[13px] text-decoration-none">
                        <span class="material-symbols-outlined text-[18px]">arrow_back</span>
                        <span>Back to List</span>
                    </a>
                </div>
            </div>

            <!-- Single Unified Enterprise Form Card -->
            <div class="bg-surface-container-lowest rounded-xl shadow-sm border border-surface-container-high overflow-hidden">
                <!-- Section 1: Identity & Personal Details -->
                <div class="p-unit-6 border-b border-surface-container-high">
                    <div class="flex items-center justify-between mb-unit-5 pb-unit-3 border-b border-surface-container-low">
                        <div class="flex items-center gap-unit-3">
                            <span class="w-8 h-8 rounded-lg bg-primary-container/10 text-primary-container flex items-center justify-center material-symbols-outlined text-[18px]">badge</span>
                            <div>
                                <h2 class="font-title-md text-on-surface leading-snug text-[15px]">Identity &amp; Personal Details</h2>
                                <p class="font-label-sm text-secondary text-[11px]">Core personnel records, contact details, and citizen identification.</p>
                            </div>
                        </div>
                        <span class="font-code-num text-secondary bg-surface-container-high px-unit-2 py-0.5 rounded text-[11px]">SECTION 1</span>
                    </div>

                    <div class="space-y-unit-4">
                        <!-- Row 1: Full Name & Official Work Email -->
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-unit-5">
                            <div class="space-y-unit-1">
                                <label class="font-label-md text-on-surface flex items-center gap-unit-1" for="input-fullname">
                                    Full Name <span class="text-error">*</span>
                                </label>
                                <div class="relative">
                                    <input class="w-full h-input-height px-unit-3 bg-surface-container-lowest rounded-lg font-body-md text-on-surface shadow-sm border border-outline-variant focus:outline-none focus:ring-2 focus:ring-primary-container placeholder:text-outline-variant text-[13px]" id="input-fullname" maxlength="150" placeholder="e.g. Nguyen Van An" type="text" value="Nguyen Van An">
                                    <span class="material-symbols-outlined absolute right-3 top-2.5 text-outline text-[18px] pointer-events-none">person</span>
                                </div>
                                <p class="font-label-sm text-secondary text-[11px]">Required, max 150 characters. Auto-trimmed.</p>
                            </div>
                            <div class="space-y-unit-1">
                                <label class="font-label-md text-on-surface flex items-center gap-unit-1" for="input-email">
                                    Official Work Email <span class="text-error">*</span>
                                </label>
                                <div class="relative">
                                    <input class="w-full h-input-height px-unit-3 bg-surface-container-lowest rounded-lg font-body-md text-on-surface shadow-sm border border-outline-variant focus:outline-none focus:ring-2 focus:ring-primary-container placeholder:text-outline-variant text-[13px]" id="input-email" maxlength="254" placeholder="nva@workshift.vn" type="email" value="nva@workshift.vn">
                                    <span class="material-symbols-outlined absolute right-3 top-2.5 text-outline text-[18px] pointer-events-none">mail</span>
                                </div>
                                <p class="font-label-sm text-secondary text-[11px]">Required, max 254 chars. Lowercase enforced, verified via Supabase Auth &amp; public.users.</p>
                            </div>
                        </div>

                        <!-- Row 2: Mobile Phone & National Citizen ID -->
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-unit-5">
                            <div class="space-y-unit-1">
                                <label class="font-label-md text-on-surface flex items-center gap-unit-1" for="input-phone">
                                    Mobile Phone Number <span class="text-error">*</span>
                                </label>
                                <div class="relative">
                                    <input class="w-full h-input-height px-unit-3 bg-surface-container-lowest rounded-lg font-body-md text-on-surface shadow-sm border border-outline-variant focus:outline-none focus:ring-2 focus:ring-primary-container placeholder:text-outline-variant text-[13px]" id="input-phone" maxlength="10" placeholder="0912345678" type="tel" value="0912345678">
                                    <span class="material-symbols-outlined absolute right-3 top-2.5 text-outline text-[18px] pointer-events-none">call</span>
                                </div>
                                <p class="font-label-sm text-secondary text-[11px]">10 digits, valid Vietnam mobile prefix (03x, 05x, 07x, 08x, 09x). Verified unique.</p>
                            </div>
                            <div class="space-y-unit-1">
                                <label class="font-label-md text-on-surface flex items-center gap-unit-1" for="input-cccd">
                                    National Citizen ID (CCCD/CMND) <span class="text-error">*</span>
                                </label>
                                <div class="relative">
                                    <input class="w-full h-input-height px-unit-3 bg-surface-container-lowest rounded-lg font-code-num text-on-surface shadow-sm border border-outline-variant focus:outline-none focus:ring-2 focus:ring-primary-container placeholder:text-outline-variant text-[13px]" id="input-cccd" maxlength="12" placeholder="079099012345" type="text" value="079099012345">
                                    <span class="material-symbols-outlined absolute right-3 top-2.5 text-outline text-[18px] pointer-events-none">badge</span>
                                </div>
                                <p class="font-label-sm text-secondary text-[11px]">9 or 12 numeric digits. Must be strictly unique across active and archived staff.</p>
                            </div>
                        </div>

                        <!-- Row 3: Gender & Date of Birth -->
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-unit-5">
                            <div class="space-y-unit-1">
                                <label class="font-label-md text-on-surface flex items-center gap-unit-1">
                                    Gender <span class="text-error">*</span>
                                </label>
                                <div class="grid grid-cols-3 gap-unit-2">
                                    <label class="flex items-center justify-center gap-unit-2 h-input-height rounded-lg border border-outline-variant bg-surface-container-low px-unit-2 cursor-pointer hover:bg-surface-container transition-colors">
                                        <input checked="" class="w-4 h-4 text-primary-container focus:ring-primary-container" name="gender" type="radio" value="MALE">
                                        <span class="font-label-md text-on-surface text-[12px]">MALE</span>
                                    </label>
                                    <label class="flex items-center justify-center gap-unit-2 h-input-height rounded-lg border border-outline-variant bg-surface-container-low px-unit-2 cursor-pointer hover:bg-surface-container transition-colors">
                                        <input class="w-4 h-4 text-primary-container focus:ring-primary-container" name="gender" type="radio" value="FEMALE">
                                        <span class="font-label-md text-on-surface text-[12px]">FEMALE</span>
                                    </label>
                                    <label class="flex items-center justify-center gap-unit-2 h-input-height rounded-lg border border-outline-variant bg-surface-container-low px-unit-2 cursor-pointer hover:bg-surface-container transition-colors">
                                        <input class="w-4 h-4 text-primary-container focus:ring-primary-container" name="gender" type="radio" value="OTHER">
                                        <span class="font-label-md text-on-surface text-[12px]">OTHER</span>
                                    </label>
                                </div>
                                <p class="font-label-sm text-secondary text-[11px]">Stored as uppercase enum (MALE / FEMALE / OTHER).</p>
                            </div>
                            <div class="space-y-unit-1">
                                <label class="font-label-md text-on-surface flex items-center gap-unit-1" for="input-dob">
                                    Date of Birth <span class="text-error">*</span>
                                </label>
                                <div class="relative">
                                    <input class="w-full h-input-height px-unit-3 bg-surface-container-lowest rounded-lg font-body-md text-on-surface shadow-sm border border-outline-variant focus:outline-none focus:ring-2 focus:ring-primary-container text-[13px]" id="input-dob" max="2007-01-01" min="1900-01-01" type="date" value="2000-05-15">
                                </div>
                                <p class="font-label-sm text-secondary text-[11px]">Must be &gt;= 01/01/1900 and applicant must be at least 18 years old.</p>
                            </div>
                        </div>

                        <!-- Row 4: Residential Address -->
                        <div class="space-y-unit-1">
                            <label class="font-label-md text-on-surface flex items-center gap-unit-1" for="input-address">
                                Residential Address <span class="text-error">*</span>
                            </label>
                            <div class="relative">
                                <textarea class="w-full p-unit-3 bg-surface-container-lowest rounded-lg font-body-md text-on-surface shadow-sm border border-outline-variant focus:outline-none focus:ring-2 focus:ring-primary-container placeholder:text-outline-variant text-[13px]" id="input-address" maxlength="500" placeholder="e.g. 45 Le Thanh Ton Street, Ben Nghe Ward, District 1, Ho Chi Minh City" rows="2">45 Le Thanh Ton Street, Ben Nghe Ward, District 1, Ho Chi Minh City</textarea>
                            </div>
                            <p class="font-label-sm text-secondary text-[11px]">Required, max 500 characters. Auto-trimmed.</p>
                        </div>
                    </div>
                </div>

                <!-- Section 2: Role & Branch Allocation -->
                <div class="p-unit-6 border-b border-surface-container-high bg-surface-container-low/30">
                    <div class="flex items-center justify-between mb-unit-5 pb-unit-3 border-b border-surface-container-low">
                        <div class="flex items-center gap-unit-3">
                            <span class="w-8 h-8 rounded-lg bg-primary-container/10 text-primary-container flex items-center justify-center material-symbols-outlined text-[18px]">admin_panel_settings</span>
                            <div>
                                <h2 class="font-title-md text-on-surface leading-snug text-[15px]">Role Assignment &amp; Branch Allocation</h2>
                                <p class="font-label-sm text-secondary text-[11px]">Role assignment strictly restricted to MANAGER or ACCOUNTANT with branch quota validation.</p>
                            </div>
                        </div>
                        <span class="font-code-num text-secondary bg-surface-container-high px-unit-2 py-0.5 rounded text-[11px]">SECTION 2</span>
                    </div>

                    <div class="space-y-unit-4">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-unit-5">
                            <!-- Role Selector -->
                            <div class="space-y-unit-1">
                                <label class="font-label-md text-on-surface flex items-center gap-unit-1" for="select-role">
                                    System Role <span class="text-error">*</span>
                                </label>
                                <div class="relative">
                                    <select class="w-full h-input-height px-unit-3 bg-surface-container-lowest rounded-lg font-body-md text-on-surface shadow-sm border border-outline-variant focus:outline-none focus:ring-2 focus:ring-primary-container appearance-none pr-unit-10 cursor-pointer text-[13px]" id="select-role" onchange="handleRoleChange(this.value)">
                                        <option selected="" value="MANAGER">MANAGER (Role ID: 2 - Branch Operations Manager)</option>
                                        <option value="ACCOUNTANT">ACCOUNTANT (Role ID: 3 - Branch Payroll Accountant)</option>
                                    </select>
                                    <span class="material-symbols-outlined absolute right-3 top-2.5 text-outline text-[20px] pointer-events-none">expand_more</span>
                                </div>
                                <p class="font-label-sm text-secondary text-[11px]">Strict scope: MANAGER (RoleId: 2) or ACCOUNTANT (RoleId: 3) only.</p>
                            </div>

                            <!-- Branch Selector -->
                            <div class="space-y-unit-1">
                                <label class="font-label-md text-on-surface flex items-center gap-unit-1" for="select-branch">
                                    Target Branch <span class="text-error">*</span>
                                </label>
                                <div class="relative">
                                    <select class="w-full h-input-height px-unit-3 bg-surface-container-lowest rounded-lg font-body-md text-on-surface shadow-sm border border-outline-variant focus:outline-none focus:ring-2 focus:ring-primary-container appearance-none pr-unit-10 cursor-pointer text-[13px]" id="select-branch" onchange="handleBranchChange(this.value)">
                                        <option selected="" value="District 1 Flagship (D1-FLAGSHIP)">District 1 Flagship (D1-FLAGSHIP) - Active</option>
                                        <option value="District 7 Hub (D7-HUB)">District 7 Hub (D7-HUB) - Active</option>
                                        <option value="Thu Duc Innovation Hub (TD-TECH)">Thu Duc Innovation Hub (TD-TECH) - Active</option>
                                        <option value="Tan Binh Logistics Depot (TB-LOG)">Tan Binh Logistics Depot (TB-LOG) - Active</option>
                                    </select>
                                    <span class="material-symbols-outlined absolute right-3 top-2.5 text-outline text-[20px] pointer-events-none">expand_more</span>
                                </div>
                                <p class="font-label-sm text-secondary text-[11px]">BranchId must be greater than 0 and operational.</p>
                            </div>
                        </div>

                        <!-- Branch Quota Status Banner (Compact & Integrated) -->
                        <div class="p-unit-3 rounded-lg bg-amber-50 border border-amber-200 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-unit-3">
                            <div class="flex items-center gap-unit-2 text-amber-800">
                                <span class="material-symbols-outlined text-[#D97706] text-[20px]">info</span>
                                <div class="text-[12px]">
                                    <span class="font-medium">Branch Quota Policy:</span> Maximum 1 Manager &amp; 1 Accountant per branch.
                                </div>
                            </div>
                            <div class="flex items-center gap-unit-2 flex-wrap" id="slot-indicator-box">
                                <div class="flex items-center gap-1 text-[11px] bg-emerald-100 text-[#059669] px-unit-2 py-0.5 rounded font-label-md border border-emerald-200">
                                    <span class="material-symbols-outlined text-[14px]">check_circle</span> Manager: 0/1 (Slot Available)
                                </div>
                                <div class="flex items-center gap-1 text-[11px] bg-rose-100 text-error px-unit-2 py-0.5 rounded font-label-md border border-rose-200">
                                    <span class="material-symbols-outlined text-[14px]">block</span> Accountant: 1/1 (Quota Reached)
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Section 3: Provisioning Pipeline Guarantee & Action Bar -->
                <div class="p-unit-5 bg-surface-container-lowest flex flex-col sm:flex-row items-center justify-between gap-unit-4 border-t border-surface-container-high">
                    <div class="flex items-center gap-unit-2 text-secondary font-body-sm text-[12px]">
                        <span class="material-symbols-outlined text-primary-container text-[18px]">verified</span>
                        <span>Supabase Auth Invite will be dispatched • Default Cloudinary avatar assigned • Auto-rollback on failure</span>
                    </div>
                    <div class="flex items-center gap-unit-3 w-full sm:w-auto justify-end">
                        <a asp-controller="User" asp-action="List" class="h-input-height px-unit-4 rounded-xl bg-surface-container-low text-on-surface font-body-md-medium hover:bg-surface-container transition-colors duration-150 flex items-center gap-unit-2 border border-surface-container-high text-[13px] text-decoration-none">
                            <span class="material-symbols-outlined text-[18px]">close</span>
                            <span>Cancel</span>
                        </a>
                        <button class="h-input-height px-unit-5 rounded-xl bg-primary-container hover:bg-primary text-white font-body-md-medium transition-all duration-150 flex items-center gap-unit-2 shadow-sm focus:ring-2 focus:ring-offset-2 focus:ring-primary-container text-[13px]" id="btn-create-account" onclick="simulateAccountCreation()" type="button">
                            <span class="material-symbols-outlined text-[18px]">send</span>
                            <span>Send Invite &amp; Create Account</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    <script>
        function handleRoleChange(role) {
            // dynamic handler if needed
        }
        function handleBranchChange(branch) {
            // dynamic handler if needed
        }
        function simulateAccountCreation() {
            const btn = document.getElementById('btn-create-account');
            const originalText = btn.innerHTML;
            btn.innerHTML = `<span class="material-symbols-outlined animate-spin text-[18px]">progress_activity</span><span>Provisioning Account...</span>`;
            btn.disabled = true;
            setTimeout(() => {
                btn.innerHTML = `<span class="material-symbols-outlined text-[18px]">check</span><span>Account Created!</span>`;
                btn.classList.remove('bg-primary-container');
                btn.classList.add('bg-[#059669]');
                setTimeout(() => {
                    btn.innerHTML = originalText;
                    btn.disabled = false;
                    btn.classList.remove('bg-[#059669]');
                    btn.classList.add('bg-primary-container');
                    alert('User account provisioned successfully. Supabase activation invite dispatched to ' + document.getElementById('input-email').value);
                }, 1200);
            }, 900);
        }
    </script>
}
