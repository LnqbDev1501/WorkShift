@{
    ViewData["Title"] = "User Accounts";
}

@section Styles {
<style>
    .users-page{min-height:100vh;padding:0 28px 48px;color:#20233a;background:#f6f7fb;font-family:Georgia,"Times New Roman",serif}.users-topbar{display:flex;align-items:center;justify-content:space-between;height:64px;margin:0 -28px;padding:0 28px;background:#fff;border-bottom:1px solid #e8e9ef}.breadcrumb-row{display:flex;align-items:center;gap:11px;font-size:15px}.breadcrumb-row span{color:#9ba1b2;font-size:20px}.top-user{display:flex;align-items:center;gap:12px;padding-left:18px;border-left:1px solid #e4e5eb;text-align:right}.top-user strong,.top-user small{display:block}.top-user strong{font-size:13px;font-weight:500;color:#171923}.top-user small{margin-top:2px;font-size:11px;color:#565b6c}.avatar-photo{display:grid;width:32px;height:32px;place-items:center;color:#fff;background:linear-gradient(135deg,#7c83a8,#28344d);border-radius:50%;font:600 11px Arial,sans-serif}.users-body{max-width:1440px;margin:auto;padding-top:25px}.page-heading{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;margin-bottom:24px}.eyebrow{display:flex;align-items:center;gap:9px;margin-bottom:7px;color:#50577a;font-size:15px;letter-spacing:.08em;text-transform:uppercase}.eyebrow i{width:8px;height:8px;background:#4f46e5;border-radius:50%}.page-heading h1{margin:0;color:#191c2a;font-size:18px;font-weight:500}.page-heading p{margin:10px 0 0;color:#464b63;font-size:15px}.heading-actions{display:flex;gap:12px}.ui-button{display:inline-flex;align-items:center;justify-content:center;gap:9px;height:41px;padding:0 18px;border:0;border-radius:9px;font:15px Georgia,"Times New Roman",serif;cursor:pointer;box-shadow:0 2px 5px #1b1f360d}.ui-button.light{color:#25293b;background:#fff}.ui-button.primary{color:#fff;background:#5146e5;box-shadow:0 3px 7px #4f46e540}.symbol{font-family:Arial,sans-serif;font-size:17px}.metrics{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;margin-bottom:23px}.metric{display:flex;align-items:center;justify-content:space-between;min-height:108px;padding:17px 16px;background:#fff;border-radius:9px;box-shadow:0 1px 3px #191c2d0d}.metric-label{color:#454c6d;font-size:15px;letter-spacing:.02em;text-transform:uppercase}.metric-value{margin-top:9px;color:#11131d;font-size:15px}.metric-note{margin-top:7px;color:#555b71;font-size:14px}.metric-note.danger{color:#d11515}.metric-icon{display:grid;flex:0 0 40px;width:40px;height:40px;margin-left:14px;place-items:center;color:#4f46e5;background:#f1f2f7;border-radius:6px;font:21px Arial,sans-serif}.filter-card{margin-bottom:24px;padding:16px;background:#fff;border-radius:9px;box-shadow:0 1px 3px #191c2d12}.filters{display:grid;grid-template-columns:2fr 1fr 1.5fr 1fr auto;gap:12px}.search-box{position:relative}.search-box span{position:absolute;top:50%;left:14px;transform:translateY(-50%);color:#3f4a68;font:19px Arial,sans-serif}.filter-control{width:100%;height:41px;padding:0 13px;color:#1f2336;background:#f0f1f6;border:0;border-radius:5px;outline:none;font:14px Georgia,"Times New Roman",serif}.search-box input{padding-left:41px}.clear{min-width:102px;background:#f0f1f6;box-shadow:none}.table-card{overflow:hidden;background:#fff;border-radius:9px;box-shadow:0 1px 3px #191c2d14}.users-table{width:100%;border-collapse:collapse;table-layout:fixed}.users-table th{height:38px;padding:0 16px;color:#4a516f;background:#f0f1f6;font-size:15px;font-weight:600;text-align:left;text-transform:uppercase}.users-table td{height:72px;padding:10px 16px;color:#171a27;border-top:1px solid #f3f3f6;font-size:14px;vertical-align:middle}.users-table th:nth-child(1){width:22%}.users-table th:nth-child(2){width:10%}.users-table th:nth-child(3){width:12%}.users-table th:nth-child(4){width:14%}.users-table th:nth-child(5){width:16%}.users-table th:nth-child(6){width:11%}.users-table th:nth-child(7){width:15%}.user-cell{display:flex;align-items:center;gap:12px}.initials{display:grid;flex:0 0 36px;width:36px;height:36px;place-items:center;color:#28305c;background:#dfe5f8;border-radius:11px;font-size:13px}.initials.primary{color:#fff;background:#5146e5}.initials.muted{color:#868a98;background:#e9eaee}.user-name{display:flex;align-items:center;gap:7px;margin-bottom:5px;white-space:nowrap}.user-email{color:#425070;white-space:nowrap}.deleted-label{padding:3px 5px;color:#c83232;background:#fee3e3;font-size:9px}.pill{display:inline-flex;align-items:center;gap:5px;padding:5px 10px;background:#e9eaee;border-radius:14px;white-space:nowrap}.status{background:#dfe5f8}.status.pending{background:#dbeafe}.status.inactive{color:#596071;background:#e8e9ed}.dot{width:6px;height:6px;background:#4f46e5;border-radius:50%}.pending .dot{background:#47789e}.inactive .dot{background:#89909d}.previous{display:block;margin-top:5px;color:#596073;font-size:10px}.deleted-row{background:#fbfbfc}.deleted-row td,.deleted-row .user-email{color:#737889}.actions{display:flex;align-items:center;gap:18px;white-space:nowrap}.action{display:inline-flex;align-items:center;gap:6px;color:#3323cc;background:none;border:0;font:14px Georgia,"Times New Roman",serif;text-decoration:none}.action.neutral{color:#454c64}.more{color:#39425d;font:bold 19px Arial,sans-serif}.table-footer{display:flex;align-items:center;justify-content:space-between;min-height:66px;padding:0 24px;color:#31364c;font-size:14px}.table-footer small{color:#6d7283}.pagination{display:flex;align-items:center;gap:5px}.page-number{display:grid;min-width:32px;height:32px;padding:0 7px;place-items:center;color:#30354b;border-radius:5px;text-decoration:none}.page-number.active{color:#fff;background:#5146e5}.page-number.disabled{color:#c8cbd5}
    @@media(max-width:1100px){.metrics{grid-template-columns:repeat(2,1fr)}.filters{grid-template-columns:repeat(2,1fr)}.table-card{overflow-x:auto}.users-table{min-width:1050px}}@@media(max-width:700px){.users-page{padding:0 16px 32px}.users-topbar{margin:0 -16px;padding:0 16px}.page-heading{align-items:flex-start;flex-direction:column}.metrics{grid-template-columns:1fr}.filters{grid-template-columns:1fr}.top-user{display:none}}
</style>
}

