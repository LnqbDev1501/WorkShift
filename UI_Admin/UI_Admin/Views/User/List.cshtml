@model UserListViewModel

@{
    ViewData["Title"] = "User Accounts";
}

@section Styles {
<style>
    .users-page{min-height:100vh;padding:16px 28px 36px;color:#20233a;background:#f6f7fb;font-family:Arial,Helvetica,sans-serif;font-style:normal}.users-topbar{display:flex;align-items:center;justify-content:space-between;height:64px;margin:0 -28px;padding:0 28px;background:#fff;border-bottom:1px solid #e8e9ef}.breadcrumb-row{display:flex;align-items:center;gap:11px;font-size:15px}.breadcrumb-row span{color:#9ba1b2;font-size:20px}.top-user{display:flex;align-items:center;gap:12px;padding-left:18px;border-left:1px solid #e4e5eb;text-align:right}.top-user strong,.top-user small{display:block}.top-user strong{font-size:13px;font-weight:500;color:#171923}.top-user small{margin-top:2px;font-size:11px;color:#565b6c}.avatar-photo{display:grid;width:32px;height:32px;place-items:center;color:#fff;background:linear-gradient(135deg,#7c83a8,#28344d);border-radius:50%;font:600 11px Arial,sans-serif}.users-body{max-width:1440px;margin:auto;padding-top:0}.page-heading{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;margin-bottom:16px}.eyebrow{display:flex;align-items:center;gap:9px;margin-bottom:5px;color:#50577a;font-size:13px;letter-spacing:.08em;text-transform:uppercase}.eyebrow i{width:8px;height:8px;background:#4f46e5;border-radius:50%}.page-heading h1{margin:0;color:#191c2a;font-size:22px;font-weight:600}.page-heading p{margin:4px 0 0;color:#5b6074;font-size:14px}.heading-actions{display:flex;gap:12px}.ui-button{display:inline-flex;align-items:center;justify-content:center;gap:9px;height:41px;padding:0 18px;border:0;border-radius:9px;font:500 14px Arial,Helvetica,sans-serif;text-decoration:none;cursor:pointer;box-shadow:0 2px 5px #1b1f360d}.ui-button.light{color:#25293b;background:#fff}.ui-button.primary{color:#fff;background:#5146e5;box-shadow:0 3px 7px #4f46e540}.symbol{font-family:Arial,sans-serif;font-size:17px}.metrics{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;margin-bottom:18px}.metric{display:flex;align-items:center;justify-content:space-between;min-height:108px;padding:17px 16px;background:#fff;border-radius:9px;box-shadow:0 1px 3px #191c2d0d}.metric-label{color:#454c6d;font-size:13px;font-weight:600;letter-spacing:.04em;text-transform:uppercase}.metric-value{margin-top:9px;color:#11131d;font-size:20px;font-weight:600}.metric-note{margin-top:7px;color:#555b71;font-size:13px}.metric-note.danger{color:#d11515}.metric-icon{display:grid;flex:0 0 40px;width:40px;height:40px;margin-left:14px;place-items:center;color:#4f46e5;background:#f1f2f7;border-radius:6px;font:21px Arial,sans-serif}.filter-card{margin-bottom:18px;padding:16px;background:#fff;border-radius:9px;box-shadow:0 1px 3px #191c2d12}.filters{display:grid;grid-template-columns:2fr 1fr 1.5fr 1fr auto;gap:12px}.search-box{position:relative}.search-box span{position:absolute;top:50%;left:14px;transform:translateY(-50%);color:#3f4a68;font:19px Arial,sans-serif}.filter-control{width:100%;height:41px;padding:0 13px;color:#1f2336;background:#f0f1f6;border:0;border-radius:7px;outline:none;font:400 14px Arial,Helvetica,sans-serif}.search-box input{padding-left:41px}.clear{min-width:102px;color:#42475a!important;background:#f0f1f6;box-shadow:none;text-decoration:none!important;transition:background .15s,color .15s}.clear:hover{color:#3028b8!important;background:#e5e7f0;text-decoration:none!important}.table-card{overflow:hidden;background:#fff;border-radius:9px;box-shadow:0 1px 3px #191c2d14}.users-table{width:100%;border-collapse:collapse;table-layout:fixed}.users-table th{height:38px;padding:0 16px;color:#4a516f;background:#f0f1f6;font-size:13px;font-weight:600;text-align:left;text-transform:uppercase}.users-table td{height:72px;padding:10px 16px;color:#171a27;border-top:1px solid #f3f3f6;font-size:14px;font-style:normal;vertical-align:middle}.users-table th:nth-child(1){width:22%}.users-table th:nth-child(2){width:10%}.users-table th:nth-child(3){width:12%}.users-table th:nth-child(4){width:14%}.users-table th:nth-child(5){width:16%}.users-table th:nth-child(6){width:11%}.users-table th:nth-child(7){width:15%}.user-cell{display:flex;align-items:center;gap:12px}.initials{display:grid;flex:0 0 36px;width:36px;height:36px;place-items:center;color:#28305c;background:#dfe5f8;border-radius:11px;font-size:13px}.initials.primary{color:#fff;background:#5146e5}.initials.muted{color:#868a98;background:#e9eaee}.user-name{display:flex;align-items:center;gap:7px;margin-bottom:5px;font-weight:500;white-space:nowrap}.user-email{color:#425070;font-size:13px;white-space:nowrap}.deleted-label{padding:3px 5px;color:#c83232;background:#fee3e3;font-size:9px}.pill{display:inline-flex;align-items:center;gap:5px;padding:5px 10px;background:#e9eaee;border-radius:14px;font-style:normal;white-space:nowrap}.status{background:#dfe5f8}.status.pending{background:#dbeafe}.status.inactive{color:#596071;background:#e8e9ed}.dot{width:6px;height:6px;background:#4f46e5;border-radius:50%}.pending .dot{background:#47789e}.inactive .dot{background:#89909d}.previous{display:block;margin-top:5px;color:#596073;font-size:10px;font-style:normal}.deleted-row{background:#fbfbfc}.deleted-row td,.deleted-row .user-email{color:#737889}.actions{display:flex;align-items:center;gap:18px;white-space:nowrap}.action{display:inline-flex;align-items:center;gap:6px;color:#3323cc;background:none;border:0;font:14px Arial,Helvetica,sans-serif;text-decoration:none}.action.neutral{color:#454c64}.more{color:#39425d;font:bold 19px Arial,sans-serif}.table-footer{display:flex;align-items:center;justify-content:space-between;min-height:66px;padding:0 24px;color:#31364c;font-size:14px;font-style:normal}.table-footer small{color:#6d7283}.pagination{display:flex;align-items:center;gap:5px}.page-number{display:grid;min-width:32px;height:32px;padding:0 7px;place-items:center;color:#30354b;border-radius:5px;text-decoration:none}.page-number.active{color:#fff;background:#5146e5}.page-number.disabled{color:#c8cbd5}
    .avatar-image{width:36px;height:36px;object-fit:cover;border-radius:11px}.alert-box{margin-bottom:16px;padding:12px 16px;border-radius:8px;font-size:14px}.alert-box.success{color:#17613a;background:#dcfce7}.alert-box.error{color:#991b1b;background:#fee2e2}.empty-row{text-align:center!important;color:#6b7280!important;height:100px!important}.icon-button{display:grid;width:32px;height:32px;padding:0;place-items:center;color:#4338ca;background:transparent;border:0;border-radius:7px;cursor:pointer}.icon-button:hover{background:#eef0ff}.icon-button.danger{color:#c62828}.icon-button svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}.inline-action{display:inline-flex;margin:0}.filter-submit{color:#fff;background:#5146e5;box-shadow:none}.validation-errors{margin:0 0 16px;color:#991b1b;font-size:13px}.users-table .actions{gap:5px}
    @@media(max-width:1100px){.metrics{grid-template-columns:repeat(2,1fr)}.filters{grid-template-columns:repeat(2,1fr)}.table-card{overflow-x:auto}.users-table{min-width:1050px}}@@media(max-width:700px){.users-page{padding:16px 16px 32px}.users-topbar{margin:0 -16px;padding:0 16px}.page-heading{align-items:flex-start;flex-direction:column}.metrics{grid-template-columns:1fr}.filters{grid-template-columns:1fr}.top-user{display:none}}
</style>
}

@functions {
    string QueryUrl(int page) => Url.Action("List", "User", new {
        pageNumber = page,
        search = Model.Query.Search,
        status = Model.Query.Status,
        roleId = Model.Query.RoleId,
        branchId = Model.Query.BranchId
    }) ?? "#";

    string DisplayName(string value) => System.Globalization.CultureInfo.InvariantCulture.TextInfo
        .ToTitleCase(value.ToLowerInvariant());
}

@if (TempData["AccountCreatedSuccess"] is true or "true")
{
    <div id="successPopupModal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/40 backdrop-blur-sm p-4 animate-fade-in">
        <div class="bg-white rounded-2xl p-6 max-w-md w-full shadow-2xl border border-[#e2e8f0] flex flex-col items-center text-center space-y-4">
            <div class="w-14 h-14 rounded-full bg-[#ecfdf5] border-2 border-[#a7f3d0] text-[#059669] flex items-center justify-center shadow-sm">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
            </div>
            <div class="space-y-1">
                <h3 class="text-[18px] font-semibold text-[#191c2a]">Account Created Successfully</h3>
                <p class="text-[14px] text-[#5b6074]">
                    User account provisioned successfully. An activation invite has been dispatched to their email.
                </p>
            </div>
            <button type="button" class="w-full py-2.5 px-4 rounded-xl bg-[#5146e5] hover:bg-[#4338ca] text-white font-medium text-[14px] transition-colors shadow-sm cursor-pointer" onclick="document.getElementById('successPopupModal').remove()">
                OK
            </button>
        </div>
    </div>
}

<section class="users-page">
    <div class="users-body">
        <div class="page-heading">
            <div><div class="eyebrow"><i></i>Enterprise Access Directory</div><h1>User Accounts</h1><p>View user profiles and manage manager and accountant accounts.</p></div>
            <div class="heading-actions">
                <a asp-action="Create" class="ui-button primary"><span class="symbol">♙+</span>Create Account</a></div>
        </div>
        @if (TempData["SuccessMessage"] is string successMessage) { <div class="alert-box success">@successMessage</div> }
        @if (TempData["ErrorMessage"] is string actionError) { <div class="alert-box error">@actionError</div> }
        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage)) { <div class="alert-box error">Could not load users: @Model.ErrorMessage</div> }
        <div asp-validation-summary="ModelOnly" class="validation-errors"></div>
        <div class="metrics">
            <article class="metric"><div><div class="metric-label">Total Active Users</div><div class="metric-value">@Model.ActiveUsers.ToString("N0")</div><div class="metric-note">Currently active accounts</div></div><span class="metric-icon">▣</span></article>
            <article class="metric"><div><div class="metric-label">Managers &amp; Accountants</div><div class="metric-value">@Model.ElevatedUsers.ToString("N0")</div><div class="metric-note">Elevated operational roles</div></div><span class="metric-icon">♧</span></article>
            <article class="metric"><div><div class="metric-label">Pending Activation</div><div class="metric-value">@Model.PendingUsers.ToString("N0")</div><div class="metric-note danger">Awaiting account setup</div></div><span class="metric-icon">⌛</span></article>
            <article class="metric"><div><div class="metric-label">Branch Deployment</div><div class="metric-value">@Model.ActiveBranches / @Model.TotalBranches</div><div class="metric-note">Active branches</div></div><span class="metric-icon">⌘</span></article>
        </div>
        <form asp-action="List" method="get" class="filter-card"><div class="filters">
            <label class="search-box"><span>⌕</span><input asp-for="Query.Search" name="search" class="filter-control" type="search" placeholder="Search name, email, phone, or identity number" /></label>
            <select asp-for="Query.RoleId" name="roleId" class="filter-control" aria-label="Role"><option value="">All Roles</option>@foreach (var role in Model.Roles) { <option value="@role.Id">@role.Name</option> }</select>
            <select asp-for="Query.BranchId" name="branchId" class="filter-control" aria-label="Branch"><option value="">All Branches</option>@foreach (var branch in Model.Branches) { <option value="@branch.Id">@branch.Name</option> }</select>
            <select asp-for="Query.Status" name="status" class="filter-control" aria-label="Status"><option value="">All Statuses</option><option value="ACTIVE">Active</option><option value="PENDING">Pending Activation</option><option value="INACTIVE">Inactive</option></select>
            <div class="heading-actions"><button class="ui-button filter-submit" type="submit" title="Apply filters">⌕</button><a asp-action="List" class="ui-button clear" title="Clear filters"><span class="symbol">↻</span>Clear</a></div>
        </div></form>
        <div class="table-card">
            <table class="users-table"><thead><tr><th>User</th><th>Phone</th><th>Role</th><th>Branch</th><th>Status</th><th>Created</th><th>Actions</th></tr></thead><tbody>
                @if (Model.Items.Count == 0) { <tr><td colspan="7" class="empty-row">No user accounts found.</td></tr> }
                @foreach (var user in Model.Items)
                {
                    var isInactive = user.Status.Equals("INACTIVE", StringComparison.OrdinalIgnoreCase);
                    var isPending = user.Status.Equals("PENDING", StringComparison.OrdinalIgnoreCase);
                    <tr class="@(isInactive ? "deleted-row" : null)">
                        <td><div class="user-cell">@if (!string.IsNullOrWhiteSpace(user.AvatarUrl)) { <img class="avatar-image" src="@user.AvatarUrl" alt="" /> } else { <span class="initials @(isInactive ? "muted" : null)">@user.Initials</span> }<div><div class="user-name">@user.FullName @if (user.DeletedAt.HasValue) { <span class="deleted-label">Deleted</span> }</div><div class="user-email">@user.Email</div></div></div></td>
                        <td>@user.Phone</td><td><span class="pill">@DisplayName(user.RoleName)</span></td>
                        <td>@(user.BranchName ?? "—") @if (!string.IsNullOrWhiteSpace(user.PreviousBranchName)) { <span class="previous">Prev: @user.PreviousBranchName</span> }</td>
                        <td><span class="pill status @(isPending ? "pending" : isInactive ? "inactive" : null)"><i class="dot"></i>@(isPending ? "Pending Activation" : DisplayName(user.Status))</span></td>
                        <td>@user.CreatedAt.ToString("dd MMM yyyy")</td>
                        <td><div class="actions">
                            <a asp-action="Detail" asp-route-id="@user.UserId" class="icon-button" title="View account" aria-label="View account"><svg viewBox="0 0 24 24"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z"/><circle cx="12" cy="12" r="2.5"/></svg></a>
                            @if (isPending) { <form asp-action="ResendSetupLink" method="post" class="inline-action"><input type="hidden" name="userId" value="@user.UserId" /><partial name="_UserQueryFields" model="Model.Query" /><button class="icon-button" type="submit" title="Resend setup link" aria-label="Resend setup link"><svg viewBox="0 0 24 24"><path d="m4 4 16 8-16 8 3-8-3-8Z"/><path d="M7 12h13"/></svg></button></form> }
                            else if (isInactive) { <form asp-action="Restore" method="post" class="inline-action"><input type="hidden" name="userId" value="@user.UserId" /><input type="hidden" name="branchId" value="@user.PreviousBranchId" /><partial name="_UserQueryFields" model="Model.Query" /><button class="icon-button" type="submit" title="Restore account" aria-label="Restore account"><svg viewBox="0 0 24 24"><path d="M3 12a9 9 0 1 0 3-6.7"/><path d="M3 4v6h6"/></svg></button></form> }
                            else if (user.RoleName.Equals("MANAGER", StringComparison.OrdinalIgnoreCase) || user.RoleName.Equals("ACCOUNTANT", StringComparison.OrdinalIgnoreCase)) { <a asp-action="Edit" asp-route-id="@user.UserId" class="icon-button" title="Edit account" aria-label="Edit account"><svg viewBox="0 0 24 24"><path d="m14 5 5 5L8 21H3v-5L14 5Z"/><path d="m12 7 5 5"/></svg></a><form asp-action="Delete" method="post" class="inline-action" onsubmit="return confirm('Deactivate this account?');"><input type="hidden" name="userId" value="@user.UserId" /><partial name="_UserQueryFields" model="Model.Query" /><button class="icon-button danger" type="submit" title="Deactivate account" aria-label="Deactivate account"><svg viewBox="0 0 24 24"><path d="M3 6h18M8 6V4h8v2m-9 0 1 15h8l1-15M10 10v7m4-7v7"/></svg></button></form> }
                        </div></td>
                    </tr>
                }
            </tbody></table>
            <footer class="table-footer"><div>Showing @(Model.TotalItems == 0 ? 0 : ((Model.PageNumber - 1) * Model.PageSize) + 1) to @Math.Min(Model.PageNumber * Model.PageSize, Model.TotalItems) of @Model.TotalItems.ToString("N0") accounts <small>(Fixed @Model.PageSize / page)</small></div><nav class="pagination">
                <a class="page-number @(Model.PageNumber <= 1 ? "disabled" : null)" href="@(Model.PageNumber <= 1 ? "#" : QueryUrl(Model.PageNumber - 1))">‹</a>
                @for (var pageNumber = Math.Max(1, Model.PageNumber - 2); pageNumber <= Math.Min(Model.TotalPages, Model.PageNumber + 2); pageNumber++) { <a class="page-number @(pageNumber == Model.PageNumber ? "active" : null)" href="@QueryUrl(pageNumber)">@pageNumber</a> }
                <a class="page-number @(Model.PageNumber >= Model.TotalPages ? "disabled" : null)" href="@(Model.PageNumber >= Model.TotalPages ? "#" : QueryUrl(Model.PageNumber + 1))">›</a>
            </nav></footer>
        </div>
    </div>
</section>
