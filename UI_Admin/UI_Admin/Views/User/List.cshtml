}

@section Styles {
<style>
    .users-page{min-height:100vh;padding:16px 28px 36px;color:#20233a;background:#f6f7fb;font-family:Arial,Helvetica,sans-serif;font-style:normal}.users-topbar{display:flex;align-items:center;justify-content:space-between;height:64px;margin:0 -28px;padding:0 28px;background:#fff;border-bottom:1px solid #e8e9ef}.breadcrumb-row{display:flex;align-items:center;gap:11px;font-size:15px}.breadcrumb-row span{color:#9ba1b2;font-size:20px}.top-user{display:flex;align-items:center;gap:12px;padding-left:18px;border-left:1px solid #e4e5eb;text-align:right}.top-user strong,.top-user small{display:block}.top-user strong{font-size:13px;font-weight:500;color:#171923}.top-user small{margin-top:2px;font-size:11px;color:#565b6c}.avatar-photo{display:grid;width:32px;height:32px;place-items:center;color:#fff;background:linear-gradient(135deg,#7c83a8,#28344d);border-radius:50%;font:600 11px Arial,sans-serif}.users-body{max-width:1440px;margin:auto;padding-top:0}.page-heading{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;margin-bottom:16px}.eyebrow{display:flex;align-items:center;gap:9px;margin-bottom:5px;color:#50577a;font-size:13px;letter-spacing:.08em;text-transform:uppercase}.eyebrow i{width:8px;height:8px;background:#4f46e5;border-radius:50%}.page-heading h1{margin:0;color:#191c2a;font-size:22px;font-weight:600}.page-heading p{margin:4px 0 0;color:#5b6074;font-size:14px}.heading-actions{display:flex;gap:12px}.ui-button{display:inline-flex;align-items:center;justify-content:center;gap:9px;height:41px;padding:0 18px;border:0;border-radius:9px;font:500 14px Arial,Helvetica,sans-serif;text-decoration:none;cursor:pointer;box-shadow:0 2px 5px #1b1f360d}.ui-button.light{color:#25293b;background:#fff}.ui-button.primary{color:#fff;background:#5146e5;box-shadow:0 3px 7px #4f46e540}.symbol{font-family:Arial,sans-serif;font-size:17px}.metrics{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;margin-bottom:18px}.metric{display:flex;align-items:center;justify-content:space-between;min-height:108px;padding:17px 16px;background:#fff;border-radius:9px;box-shadow:0 1px 3px #191c2d0d}.metric-label{color:#454c6d;font-size:13px;font-weight:600;letter-spacing:.04em;text-transform:uppercase}.metric-value{margin-top:9px;color:#11131d;font-size:20px;font-weight:600}.metric-note{margin-top:7px;color:#555b71;font-size:13px}.metric-note.danger{color:#d11515}.metric-icon{display:grid;flex:0 0 40px;width:40px;height:40px;margin-left:14px;place-items:center;color:#4f46e5;background:#f1f2f7;border-radius:6px;font:21px Arial,sans-serif}.filter-card{margin-bottom:18px;padding:16px;background:#fff;border-radius:9px;box-shadow:0 1px 3px #191c2d12}.filters{display:grid;grid-template-columns:2fr 1fr 1.5fr 1fr auto;gap:12px}.search-box{position:relative}.search-box span{position:absolute;top:50%;left:14px;transform:translateY(-50%);color:#3f4a68;font:19px Arial,sans-serif}.filter-control{width:100%;height:41px;padding:0 13px;color:#1f2336;background:#f0f1f6;border:0;border-radius:7px;outline:none;font:400 14px Arial,Helvetica,sans-serif}.search-box input{padding-left:41px}.clear{min-width:102px;color:#42475a!important;background:#f0f1f6;box-shadow:none;text-decoration:none!important;transition:background .15s,color .15s}.clear:hover{color:#3028b8!important;background:#e5e7f0;text-decoration:none!important}.table-card{overflow:hidden;background:#fff;border-radius:9px;box-shadow:0 1px 3px #191c2d14}.users-table{width:100%;border-collapse:collapse;table-layout:fixed}.users-table th{height:38px;padding:0 16px;color:#4a516f;background:#f0f1f6;font-size:13px;font-weight:600;text-align:left;text-transform:uppercase}.users-table td{height:72px;padding:10px 16px;color:#171a27;border-top:1px solid #f3f3f6;font-size:14px;font-style:normal;vertical-align:middle}.users-table th:nth-child(1){width:22%}.users-table th:nth-child(2){width:10%}.users-table th:nth-child(3){width:12%}.users-table th:nth-child(4){width:14%}.users-table th:nth-child(5){width:16%}.users-table th:nth-child(6){width:11%}.users-table th:nth-child(7){width:15%}.user-cell{display:flex;align-items:center;gap:12px}.initials{display:grid;flex:0 0 36px;width:36px;height:36px;place-items:center;color:#28305c;background:#dfe5f8;border-radius:11px;font-size:13px}.initials.primary{color:#fff;background:#5146e5}.initials.muted{color:#868a98;background:#e9eaee}.user-name{display:flex;align-items:center;gap:7px;margin-bottom:5px;font-weight:500;white-space:nowrap}.user-email{color:#425070;font-size:13px;white-space:nowrap}.deleted-label{padding:3px 5px;color:#c83232;background:#fee3e3;font-size:9px}.pill{display:inline-flex;align-items:center;gap:5px;padding:5px 10px;background:#e9eaee;border-radius:14px;font-style:normal;white-space:nowrap}.status{background:#dfe5f8}.status.pending{background:#dbeafe}.status.inactive{color:#596071;background:#e8e9ed}.dot{width:6px;height:6px;background:#4f46e5;border-radius:50%}.pending .dot{background:#47789e}.inactive .dot{background:#89909d}.previous{display:block;margin-top:5px;color:#596073;font-size:10px;font-style:normal}.deleted-row{background:#fbfbfc}.deleted-row td,.deleted-row .user-email{color:#737889}.actions{display:flex;align-items:center;gap:18px;white-space:nowrap}.action{display:inline-flex;align-items:center;gap:6px;color:#3323cc;background:none;border:0;font:14px Arial,Helvetica,sans-serif;text-decoration:none}.action.neutral{color:#454c64}.more{color:#39425d;font:bold 19px Arial,sans-serif}
    .avatar-image{width:36px;height:36px;object-fit:cover;border-radius:11px}.alert-box{margin-bottom:16px;padding:12px 16px;border-radius:8px;font-size:14px}.alert-box.success{color:#17613a;background:#dcfce7}.alert-box.error{color:#991b1b;background:#fee2e2}.empty-row{text-align:center!important;color:#6b7280!important;height:100px!important}.icon-button{display:grid;width:32px;height:32px;padding:0;place-items:center;color:#4338ca;background:transparent;border:0;border-radius:7px;cursor:pointer}.icon-button:hover{background:#eef0ff}.icon-button.danger{color:#c62828}.icon-button svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}.inline-action{display:inline-flex;margin:0}.filter-submit{color:#fff;background:#5146e5;box-shadow:none}.validation-errors{margin:0 0 16px;color:#991b1b;font-size:13px}.users-table .actions{gap:5px}
    @@media(max-width:1100px){.metrics{grid-template-columns:repeat(2,1fr)}.filters{grid-template-columns:repeat(2,1fr)}.table-card{overflow-x:auto}.users-table{min-width:1050px}}@@media(max-width:700px){.users-page{padding:16px 16px 32px}.users-topbar{margin:0 -16px;padding:0 16px}.page-heading{align-items:flex-start;flex-direction:column}.metrics{grid-template-columns:1fr}.filters{grid-template-columns:1fr}.top-user{display:none}}
</style>
}

@functions {

    string DisplayName(string value) => System.Globalization.CultureInfo.InvariantCulture.TextInfo
        .ToTitleCase(value.ToLowerInvariant());
}

@if (TempData["AccountCreatedSuccess"] is true or "true")
{
    <div id="successPopupModal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/40 backdrop-blur-sm p-4 animate-fade-in">
        <div class="bg-white rounded-2xl p-6 max-w-md w-full shadow-2xl border border-[#e2e8f0] flex flex-col items-center text-center space-y-4">
            <div class="w-14 h-14 rounded-full bg-[#ecfdf5] border-2 border-[#a7f3d0] text-[#059669] flex items-center justify-center shadow-sm">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
            </div>
            <div class="space-y-1">
                <h3 class="text-[18px] font-semibold text-[#191c2a]">Account Created Successfully</h3>
                <p class="text-[14px] text-[#5b6074]">
                    User account provisioned successfully. An activation invite has been dispatched to their email.
                </p>
            </div>
            <button type="button" class="w-full py-2.5 px-4 rounded-xl bg-[#5146e5] hover:bg-[#4338ca] text-white font-medium text-[14px] transition-colors shadow-sm cursor-pointer" onclick="document.getElementById('successPopupModal').remove()">
                OK
            </button>
        </div>
    </div>
}

