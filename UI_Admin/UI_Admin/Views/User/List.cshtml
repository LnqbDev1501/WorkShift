<div id="deactivateConfirmModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/40 backdrop-blur-sm p-4 animate-fade-in">
    <div class="bg-white rounded-2xl p-6 max-w-md w-full shadow-2xl border border-[#e2e8f0] flex flex-col items-center text-center space-y-4">
        <div class="w-14 h-14 rounded-full bg-[#fef2f2] border-2 border-[#fecaca] text-[#dc2626] flex items-center justify-center shadow-sm">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
            </svg>
        </div>
        <div class="space-y-1">
            <h3 class="text-[18px] font-semibold text-[#191c2a]">Deactivate User Account?</h3>
            <p class="text-[14px] text-[#5b6074]">
                Are you sure you want to deactivate <strong id="deactivateUserNameText" class="text-[#191c2a] font-semibold"></strong>? This will revoke system access and mark the account as Inactive.
            </p>
        </div>
        <form asp-action="Delete" method="post" id="deactivateUserForm" class="w-full space-y-2">
            @Html.AntiForgeryToken()
            <input type="hidden" name="userId" id="deactivateUserIdInput" value="" />
            <partial name="_UserQueryFields" model="Model.Query" />
            <div class="flex items-center gap-3 pt-2">
                <button type="button" class="flex-1 py-2.5 px-4 rounded-xl bg-[#f3f4f6] hover:bg-[#e5e7eb] text-[#374151] font-medium text-[14px] transition-colors cursor-pointer" onclick="closeDeactivateModal()">
                    Cancel
                </button>
                <button type="submit" class="flex-1 py-2.5 px-4 rounded-xl bg-[#dc2626] hover:bg-[#b91c1c] text-white font-medium text-[14px] transition-colors shadow-sm cursor-pointer">
                    Deactivate
                </button>
            </div>
        </form>
    </div>
</div>

<section class="users-page">
    <div class="users-body">
        <div class="page-heading">
            <div><div class="eyebrow"><i></i>Enterprise Access Directory</div><h1>User Accounts</h1><p>View user profiles and manage manager and accountant accounts.</p></div>
            <div class="heading-actions">
                <a asp-action="Create" class="ui-button primary"><span class="symbol">♙+</span>Create Account</a></div>
        </div>
        <div asp-validation-summary="ModelOnly" class="validation-errors"></div>
        <partial name="_ListMetrics" model='@(new ListMetricViewModel[] {
            new("Total Active Users", Model.ActiveUsers.ToString("N0"), "Currently active accounts", "group"),
            new("Managers & Accountants", Model.ElevatedUsers.ToString("N0"), "Elevated operational roles", "admin_panel_settings"),
            new("Pending Activation", Model.PendingUsers.ToString("N0"), "Awaiting account setup", "pending_actions"),
            new("Branch Deployment", $"{Model.ActiveBranches} / {Model.TotalBranches}", "Active branches", "account_tree")
        })' />
        <form asp-action="List" method="get" class="ws-list-filter" role="search">
            <div class="ws-filter-row">
                <label class="ws-filter-field ws-filter-keyword"><span class="material-symbols-outlined" aria-hidden="true">search</span><input aria-label="Search" asp-for="Query.Search" name="search" type="search" placeholder="Search name, email, phone, or identity number" /></label>
                <div class="ws-filter-field"><select asp-for="Query.RoleId" name="roleId" aria-label="Role"><option value="">All Roles</option>@foreach (var role in Model.Roles) { <option value="@role.Id">@role.Name</option> }</select></div>
                <div class="ws-filter-field"><select asp-for="Query.BranchId" name="branchId" aria-label="Branch"><option value="">All Branches</option>@foreach (var branch in Model.Branches) { <option value="@branch.Id">@branch.Name</option> }</select></div>
                <div class="ws-filter-field"><select asp-for="Query.Status" name="status" aria-label="Status"><option value="">All Statuses</option><option value="ACTIVE">Active</option><option value="PENDING">Pending Activation</option><option value="INACTIVE">Inactive</option></select></div>
                <partial name="_ListFilterActions" model='"List"' />
            </div>
        </form>
        <div class="table-card">
            <table class="users-table"><thead><tr><th>User</th><th>Phone</th><th>Role</th><th>Branch</th><th>Status</th><th>Created</th><th>Actions</th></tr></thead><tbody>
                @if (Model.Items.Count == 0) { <tr><td colspan="7" class="empty-row">No user accounts found.</td></tr> }
                @foreach (var user in Model.Items)
                {
                    var isInactive = user.Status.Equals("INACTIVE", StringComparison.OrdinalIgnoreCase);
                    var isPending = user.Status.Equals("PENDING", StringComparison.OrdinalIgnoreCase);
                    <tr class="@(isInactive ? "deleted-row" : null)">
                        <td><div class="user-cell">@if (!string.IsNullOrWhiteSpace(user.AvatarUrl)) { <img class="avatar-image" src="@user.AvatarUrl" alt="" /> } else { <span class="initials @(isInactive ? "muted" : null)">@user.Initials</span> }<div><div class="user-name">@user.FullName @if (user.DeletedAt.HasValue) { <span class="deleted-label">Deleted</span> }</div><div class="user-email">@user.Email</div></div></div></td>
                        <td>@user.Phone</td><td><span class="pill">@DisplayName(user.RoleName)</span></td>
                        <td>@(user.BranchName ?? "—") @if (!string.IsNullOrWhiteSpace(user.PreviousBranchName)) { <span class="previous">Prev: @user.PreviousBranchName</span> }</td>
                        <td><span class="pill status @(isPending ? "pending" : isInactive ? "inactive" : null)"><i class="dot"></i>@(isPending ? "Pending Activation" : DisplayName(user.Status))</span></td>
                        <td>@user.CreatedAt.ToString("dd MMM yyyy")</td>
                        <td><div class="actions">
                            <a asp-action="Detail" asp-route-id="@user.UserId" class="ws-icon-action icon-button" title="View account" aria-label="View account"><svg viewBox="0 0 24 24"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z"/><circle cx="12" cy="12" r="2.5"/></svg></a>
                            @if (isPending) {
                                <form asp-action="ResendSetupLink" method="post" class="inline-action"><input type="hidden" name="userId" value="@user.UserId" /><partial name="_UserQueryFields" model="Model.Query" /><button class="ws-icon-action icon-button" type="submit" title="Resend setup link" aria-label="Resend setup link"><svg viewBox="0 0 24 24"><path d="m4 4 16 8-16 8 3-8-3-8Z"/><path d="M7 12h13"/></svg></button></form>
                                <a asp-action="Edit" asp-route-id="@user.UserId" class="ws-icon-action icon-button" title="Edit account" aria-label="Edit account"><svg viewBox="0 0 24 24"><path d="m14 5 5 5L8 21H3v-5L14 5Z"/><path d="m12 7 5 5"/></svg></a>
                                @if (!user.RoleName.Equals("ADMIN", StringComparison.OrdinalIgnoreCase)) {
                                    <button class="ws-icon-action icon-button danger" type="button" title="Deactivate account" aria-label="Deactivate account" onclick="openDeactivateModal('@user.UserId', '@Html.Raw(user.FullName.Replace("'", "\\'"))')"><svg viewBox="0 0 24 24"><path d="M3 6h18M8 6V4h8v2m-9 0 1 15h8l1-15M10 10v7m4-7v7"/></svg></button>
                                }
                            }
                            else if (isInactive) {
                                <a asp-action="Restore" asp-route-id="@user.UserId" class="ws-icon-action icon-button" title="Restore account" aria-label="Restore account"><svg viewBox="0 0 24 24"><path d="M3 12a9 9 0 1 0 3-6.7"/><path d="M3 4v6h6"/></svg></a>
                            }
                            else if (user.RoleName.Equals("MANAGER", StringComparison.OrdinalIgnoreCase) || user.RoleName.Equals("ACCOUNTANT", StringComparison.OrdinalIgnoreCase) || user.RoleName.Equals("ADMIN", StringComparison.OrdinalIgnoreCase)) { <a asp-action="Edit" asp-route-id="@user.UserId" class="ws-icon-action icon-button" title="Edit account" aria-label="Edit account"><svg viewBox="0 0 24 24"><path d="m14 5 5 5L8 21H3v-5L14 5Z"/><path d="m12 7 5 5"/></svg></a>@if (!user.RoleName.Equals("ADMIN", StringComparison.OrdinalIgnoreCase)) { <button class="ws-icon-action icon-button danger" type="button" title="Deactivate account" aria-label="Deactivate account" onclick="openDeactivateModal('@user.UserId', '@Html.Raw(user.FullName.Replace("'", "\\'"))')"><svg viewBox="0 0 24 24"><path d="M3 6h18M8 6V4h8v2m-9 0 1 15h8l1-15M10 10v7m4-7v7"/></svg></button> } }
                        </div></td>
                    </tr>
                }
            </tbody></table>
            <partial name="_ListPagination" model="@(new ListPaginationViewModel
            {
                PageNumber = Model.PageNumber,
                PageSize = Model.PageSize,
                TotalItems = Model.TotalItems,
                ItemLabel = "accounts",
                PageParameter = "pageNumber",
            })" />
        </div>
    </div>
</section>

@section Scripts {

<script>
    function openDeactivateModal(userId, fullName) {
        document.getElementById('deactivateUserIdInput').value = userId;
        document.getElementById('deactivateUserNameText').textContent = fullName;
        document.getElementById('deactivateConfirmModal').classList.remove('hidden');
    }
    function closeDeactivateModal() {
        document.getElementById('deactivateConfirmModal').classList.add('hidden');
    }

</script>
}
