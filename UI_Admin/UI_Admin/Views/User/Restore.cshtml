@model UserRestoreViewModel

@{
    ViewData["Title"] = $"Restore Account - {Model.FullName}";
}

@section Styles {
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet" />
    <style>
        .field-validation-error {
            color: #ba1a1a;
            font-size: 12px;
            font-weight: 500;
            display: block;
            margin-top: 4px;
        }
        .input-validation-error {
            border-color: #ba1a1a !important;
            background-color: #fff8f8 !important;
        }
    </style>
}

<div class="w-full px-7 pt-6 pb-12">
    <div class="w-full max-w-5xl mx-auto space-y-6">
        
        <!-- Top Back Navigation Bar -->
        <div class="flex items-center justify-between">
            <a asp-action="List" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-white hover:bg-slate-50 text-slate-700 font-medium text-sm transition-colors border border-slate-200 shadow-sm cursor-pointer">
                <span class="material-symbols-outlined text-[18px]">arrow_back</span>
                <span>Back to User Accounts</span>
            </a>
            <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-slate-100 text-slate-600 text-xs font-semibold uppercase tracking-wider border border-slate-200 shadow-2xs">
                <span class="w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span>
                Account Reactivation
            </div>
        </div>

        <!-- System & Validation Error Notification Banner -->
        @if (TempData["ErrorMessage"] is string tempErrorMessage && !string.IsNullOrWhiteSpace(tempErrorMessage))
        {
            <div id="restoreTempErrorBanner" class="p-4 bg-rose-50 border border-rose-200 rounded-xl flex items-center justify-between gap-3 text-rose-800 shadow-sm animate-fade-in">
                <div class="flex items-center gap-2.5 min-w-0">
                    <span class="material-symbols-outlined text-[20px] text-rose-600 shrink-0">error</span>
                    <span class="text-sm font-medium leading-relaxed break-words">@tempErrorMessage</span>
                </div>
                <button type="button" 
                        class="p-1 rounded-lg hover:bg-rose-200/50 text-rose-700 transition-colors cursor-pointer shrink-0 inline-flex items-center justify-center" 
                        title="Dismiss" 
                        aria-label="Close" 
                        onclick="document.getElementById('restoreTempErrorBanner').remove()">
                    <span class="material-symbols-outlined text-[18px]">close</span>
                </button>
            </div>
        }

        @if (!ViewData.ModelState.IsValid && ViewData.ModelState.TryGetValue(string.Empty, out var modelStateErrors) && modelStateErrors.Errors.Count > 0)
        {
            <div id="restoreModelStateErrorBanner" class="p-4 bg-rose-50 border border-rose-200 rounded-xl flex items-start justify-between gap-3 text-rose-800 shadow-sm animate-fade-in">
                <div class="flex items-start gap-2.5 min-w-0">
                    <span class="material-symbols-outlined text-[20px] shrink-0 mt-0.5 text-rose-600">error</span>
                    <div class="text-sm space-y-1 leading-relaxed">
                        @foreach (var error in modelStateErrors.Errors)
                        {
                            <div>@error.ErrorMessage</div>
                        }
                    </div>
                </div>
                <button type="button" 
                        class="p-1 rounded-lg hover:bg-rose-200/50 text-rose-700 transition-colors cursor-pointer shrink-0 inline-flex items-center justify-center" 
                        title="Dismiss" 
                        aria-label="Close" 
                        onclick="document.getElementById('restoreModelStateErrorBanner').remove()">
                    <span class="material-symbols-outlined text-[18px]">close</span>
                </button>
            </div>
        }

        <!-- Main Restore Card (Stacked Top-Bottom) -->
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden divide-y divide-slate-100">
            
            <!-- 1. Header Section -->
            <div class="p-7 flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-slate-50/40">
                <div class="flex items-center gap-4">
                    <div class="w-14 h-14 rounded-2xl bg-indigo-50 border border-indigo-100 text-indigo-600 flex items-center justify-center shadow-xs shrink-0">
                        <span class="material-symbols-outlined text-[32px]">restore</span>
                    </div>
                    <div>
                        <h1 class="text-xl font-bold text-slate-900">Restore User Account</h1>
                        <p class="text-sm text-slate-500 mt-1">Reactivate credentials, remove inactive status, and assign an active operating branch.</p>
                    </div>
                </div>
                <div class="self-start sm:self-center">
                    <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-50 text-amber-700 text-xs font-semibold border border-amber-200 shadow-2xs">
                        <span class="w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span>
                        Currently Inactive
                    </span>
                </div>
            </div>

            <!-- 2. Account Profile Preview Section -->
            <div class="p-7 space-y-4">
                <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-slate-500">
                    <span class="material-symbols-outlined text-[18px] text-slate-400">person</span>
                    <span>Account Profile Preview</span>
                </div>

                <div class="p-5 rounded-2xl bg-slate-50/70 border border-slate-200 flex flex-col md:flex-row md:items-center justify-between gap-6">
                    <div class="flex items-center gap-4 min-w-0">
                        @if (!string.IsNullOrWhiteSpace(Model.AvatarUrl))
                        {
                            <img src="@Model.AvatarUrl" alt="@Model.FullName" class="w-16 h-16 rounded-2xl object-cover border-2 border-white shadow-sm ring-1 ring-slate-200 shrink-0" />
                        }
                        else
                        {
                            <div class="w-16 h-16 rounded-2xl bg-slate-800 text-white font-bold text-xl flex items-center justify-center border-2 border-white shadow-sm ring-1 ring-slate-200 shrink-0">
                                @Model.Initials
                            </div>
                        }
                        <div class="space-y-1.5 min-w-0">
                            <div class="flex items-center gap-2.5 flex-wrap">
                                <h2 class="text-base font-bold text-slate-900 truncate">@Model.FullName</h2>
                                <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-indigo-50 text-indigo-700 border border-indigo-100">
                                    @Model.RoleName
                                </span>
                            </div>
                            <div class="flex items-center gap-4 text-xs text-slate-500 flex-wrap">
                                <div class="flex items-center gap-1.5">
                                    <span class="material-symbols-outlined text-[16px] text-slate-400">mail</span>
                                    <span>@Model.Email</span>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(Model.Phone))
                                {
                                    <div class="flex items-center gap-1.5">
                                        <span class="material-symbols-outlined text-[16px] text-slate-400">call</span>
                                        <span>@Model.Phone</span>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="md:text-right border-t md:border-t-0 md:border-l border-slate-200 pt-3 md:pt-0 md:pl-6 shrink-0 space-y-1">
                        <div class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Previous Branch</div>
                        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl bg-white border border-slate-200 text-slate-800 font-semibold text-sm shadow-2xs">
                            <span class="material-symbols-outlined text-[18px] text-indigo-600">storefront</span>
                            <span>@(Model.PreviousBranchName ?? "Not Assigned")</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 3. Form & Branch Assignment Section -->
            <form asp-controller="User" asp-action="Restore" asp-route-id="@Model.UserId" method="post" id="restoreUserForm" class="p-7 space-y-6">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="UserId" />
                <input type="hidden" asp-for="FullName" />
                <input type="hidden" asp-for="Email" />
                <input type="hidden" asp-for="Phone" />
                <input type="hidden" asp-for="RoleName" />
                <input type="hidden" asp-for="AvatarUrl" />
                <input type="hidden" asp-for="Initials" />
                <input type="hidden" asp-for="PreviousBranchId" />
                <input type="hidden" asp-for="PreviousBranchName" />

                <div class="space-y-4">
                    <div class="space-y-2">
                        <label asp-for="BranchId" class="block text-sm font-semibold text-slate-900">
                            Assign Target Branch <span class="text-rose-600">*</span>
                        </label>
                        <div class="relative">
                            <select asp-for="BranchId" class="w-full h-12 px-4 pr-10 rounded-xl bg-white border border-slate-300 text-slate-900 text-sm font-medium focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all cursor-pointer shadow-2xs">
                                <option value="">-- Select target branch to assign --</option>
                                @foreach (var branch in Model.AvailableBranches)
                                {
                                    var isPrevious = Model.PreviousBranchId.HasValue && branch.Id == Model.PreviousBranchId.Value;
                                    <option value="@branch.Id" selected="@(Model.BranchId == branch.Id)">
                                        @branch.Name @(isPrevious ? " (Previous Branch)" : "")
                                    </option>
                                }
                            </select>
                            <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3.5 text-slate-400">
                                <span class="material-symbols-outlined text-[22px]">expand_more</span>
                            </div>
                        </div>
                        <span asp-validation-for="BranchId" class="field-validation-error"></span>
                    </div>

                    <div class="p-4 rounded-xl bg-indigo-50/70 border border-indigo-100 text-xs text-indigo-950 flex items-start gap-3 leading-relaxed">
                        <span class="material-symbols-outlined text-[20px] text-indigo-600 shrink-0 mt-0.5">info</span>
                        <div>
                            The selected branch must not already have an active personnel holding the <strong>@Model.RoleName</strong> role. If the previous branch already has another assigned staff, you can choose a different branch from the dropdown above.
                        </div>
                    </div>
                </div>

                <!-- Footer Action Buttons -->
                <div class="pt-6 border-t border-slate-100 flex items-center justify-end gap-3">
                    <a asp-action="List" class="px-5 h-11 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium text-sm transition-colors flex items-center justify-center cursor-pointer">
                        Cancel
                    </a>
                    <button type="submit" class="px-6 h-11 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-medium text-sm shadow-sm transition-all flex items-center gap-2 cursor-pointer shadow-indigo-200">
                        <span class="material-symbols-outlined text-[18px]">check_circle</span>
                        <span>Confirm & Restore Account</span>
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>
