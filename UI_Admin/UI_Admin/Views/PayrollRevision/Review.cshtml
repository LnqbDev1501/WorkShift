@model UI_Admin.Models.PayrollDocuments.PayrollReview
@using D = UI_Admin.Models.Accountant.PayrollPeriods.PeriodDisplay
@using W = UI_Admin.Models.PayrollDocuments.PayrollDocumentDisplay
@{ var p = Model.Payroll; var accountant = User.IsInRole("ACCOUNTANT"); var previous = Model.History.Versions.FirstOrDefault(v => v.PayrollId == p.PreviousPayrollId); ViewData["Title"] = "Payroll Revision Review"; }
@section Styles { <link rel="stylesheet" href="~/css/payroll.css" asp-append-version="true" /> }
<div class="payroll-page"><header class="payroll-heading"><div><div class="list-eyebrow">PAYROLL · SUBMISSION & REVISION</div><h1>@p.EmployeeName</h1><p>Payroll #@p.PayrollId · V@(p.VersionNo) · @p.Status · Period @Model.PeriodStatus</p></div><div class="flex flex-wrap gap-2"><a asp-controller="@(accountant ? "AccountantPayrollPeriods" : "Payroll")" asp-action="Details" asp-route-id="@p.PayrollPeriodId" class="payroll-button">Back to period</a><a asp-controller="@(accountant ? "AccountantPayrollCalculation" : "AdminPayrollCalculation")" asp-action="Details" asp-route-id="@p.PayrollId" class="payroll-button">Calculation Details</a></div></header><partial name="_PayrollWorkflowMessages" />
    @if (p.RejectReason != null) { <div class="bg-red-50 text-red-700 rounded-xl p-4 mb-4"><strong>@p.RejectionCategory</strong>: @p.RejectReason</div> }
    @if (p.CorrectionReason != null) { <p class="payroll-compliance">Correction reason: @p.CorrectionReason</p> }
    <section class="bg-surface-container-lowest p-5 rounded-xl mb-5"><h2 class="font-semibold mb-3">Review Actions</h2><div class="flex gap-3 flex-wrap">
        @if (accountant && Model.Latest && p.Status == "REJECTED" && Model.PeriodStatus == "REVISION_REQUIRED") { <a asp-action="Correct" asp-route-id="@p.PayrollId" class="payroll-button primary">Create Corrected Version</a> }
        @if (accountant && Model.Latest && p.Status == "CALCULATED" && p.PreviousPayrollId.HasValue && Model.PeriodStatus is "REVISION_REQUIRED" or "APPROVED") { <form asp-action="Submit" asp-route-id="@p.PayrollId" method="post"><button class="payroll-button primary" type="submit">Submit This Corrected Payroll</button></form> }
        @if (accountant && Model.PeriodStatus == "APPROVED") { <a asp-controller="AccountantPayrollFeedback" asp-action="Index" asp-route-userId="@p.UserId" asp-route-payrollPeriodId="@p.PayrollPeriodId" class="payroll-button">Linked Feedback</a> }
        @if (!accountant && Model.Latest && p.Status == "SUBMITTED" && p.PreviousPayrollId.HasValue && Model.PeriodStatus == "APPROVED") { <form asp-action="ApproveCorrection" asp-route-id="@p.PayrollId" method="post"><button class="payroll-button primary" type="submit">Approve Correction & Replacement Payslip</button></form> }
        @if (!accountant && Model.PeriodStatus is "SUBMITTED" or "REVISION_REQUIRED") { <a asp-controller="Payroll" asp-action="Details" asp-route-id="@p.PayrollPeriodId" class="payroll-button">Review / Approve Entire Period</a> }
    </div>
    @if (!accountant && Model.Latest && p.Status == "SUBMITTED" && Model.PeriodStatus is "SUBMITTED" or "REVISION_REQUIRED" or "APPROVED")
    { <form asp-action="Reject" asp-route-id="@p.PayrollId" method="post" class="mt-5"><label for="category">Rejection category</label><select id="category" name="RejectionCategory" required class="border rounded-xl p-3 w-full mb-3"><option value="">Choose category</option>@foreach (var r in W.Reasons) { <option value="@r">@r</option> }</select><label for="reject-reason">Reason</label><textarea id="reject-reason" name="Reason" required maxlength="1000" rows="3" class="border rounded-xl p-3 w-full mb-3"></textarea><button class="payroll-button" type="submit">Reject This Payroll</button></form> }
    </section>
    <section class="payroll-table-card"><div class="payroll-table-toolbar"><strong>Before / After Comparison</strong><span>Work source remains fixed</span></div><div class="payroll-table-scroll"><table><thead><tr><th>FIELD</th><th>PREVIOUS VERSION</th><th>VIEWED VERSION</th></tr></thead><tbody>
        <tr><td>Timesheet</td><td>@(previous?.TimesheetId.ToString() ?? "—")</td><td>@p.TimesheetId</td></tr><tr><td>Work hours</td><td>@(previous?.TotalWorkHours.ToString("0.############################") ?? "—")</td><td>@p.TotalWorkHours.ToString("0.############################")</td></tr>
        @foreach (var row in new[] { ("Hourly rate", previous?.HourlyRate, p.HourlyRate), ("Work pay", previous?.WorkPay, p.WorkPay), ("Reward", previous?.TotalReward, p.TotalReward), ("Penalty", previous?.TotalPenalty, p.TotalPenalty), ("Attendance deduction", previous?.AttendanceDeduction, p.AttendanceDeduction), ("Carry Forward applied", previous?.CarryForwardDeduction, p.CarryForwardDeduction), ("Gross", previous?.GrossSalary, p.GrossSalary), ("Applied deduction", previous?.TotalDeduction, p.TotalDeduction), ("Deferred deduction", previous?.DeferredDeductionAmount, p.DeferredDeductionAmount), ("Net salary", previous?.NetSalary, p.NetSalary) }) { <tr><td>@row.Item1</td><td>@(row.Item2.HasValue ? D.Money(row.Item2.Value) : "—")</td><td>@D.Money(row.Item3)</td></tr> }
    </tbody></table></div></section>
    <section class="payroll-table-card"><div class="payroll-table-toolbar"><strong>Payroll Version History</strong><span>Effective #@Model.History.EffectivePayrollId · Latest candidate #@Model.History.LatestCandidatePayrollId</span></div><div class="payroll-table-scroll"><table><thead><tr><th>VERSION</th><th>STATUS</th><th class="money">NET</th><th>REASON / REJECTION</th><th>ACTIONS</th></tr></thead><tbody>@foreach (var v in Model.History.Versions.OrderByDescending(v => v.VersionNo)) { <tr><td>V@(v.VersionNo) · #@v.PayrollId</td><td>@v.Status</td><td class="money">@D.Money(v.NetSalary)</td><td>@v.CorrectionReason<small>@v.RejectReason</small></td><td><a asp-action="Review" asp-route-id="@v.PayrollId" class="payroll-button">View Version</a></td></tr> }</tbody></table></div></section>
</div>
