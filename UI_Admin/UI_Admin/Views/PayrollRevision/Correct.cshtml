@model UI_Admin.Models.PayrollDocuments.CorrectionForm
@using D = UI_Admin.Models.Accountant.PayrollPeriods.PeriodDisplay
@{ ViewData["Title"] = "Create Payroll Correction"; }
<div class="px-7 py-4"><header class="form-heading"><h1 class="text-display-lg font-display-lg">Create Payroll Correction</h1><p>@Model.Payroll.EmployeeName · Source Payroll #@Model.Payroll.PayrollId · V@(Model.Payroll.VersionNo)</p></header>
    <form asp-action="@(Model.FromFeedback ? "CorrectFeedback" : "Correct")" asp-route-id="@Model.SourceId" method="post" class="bg-surface-container-lowest rounded-xl p-5 max-w-4xl"><div asp-validation-summary="All" class="text-red-700 mb-4" role="alert"></div>
        <p class="bg-surface-container-low rounded-xl p-4 mb-4">Timesheet #@Model.Payroll.TimesheetId · @Model.Payroll.TotalWorkHours.ToString("0.############################") hours. Work inputs are fixed; a new Payroll version is created. No changes overwrite the source version.</p>
        <label for="correctionReason">Correction reason (required)</label><textarea id="correctionReason" name="CorrectionReason" required maxlength="1000" rows="3" class="w-full border rounded-xl p-3 mb-4">@Model.Input.CorrectionReason</textarea>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4"><label>Salary history ID (optional)<input type="number" min="1" name="SalaryHistoryId" value="@Model.Input.SalaryHistoryId" class="w-full border rounded-xl p-3" /></label><label>Holiday pay rule ID (optional)<input type="number" min="1" name="HolidayPayRuleId" value="@Model.Input.HolidayPayRuleId" class="w-full border rounded-xl p-3" /></label></div><p class="text-secondary mb-4">Leave IDs blank to let the backend select applicable records. Only valid approved reward/penalty sources are recalculated. Net/gross totals are calculated by the backend.</p><a asp-controller="AccountantSalaryHistory" asp-action="Index" asp-route-userId="@Model.Payroll.UserId" class="text-primary inline-block mb-4">Find this employee's salary history</a>
        @for (var i = 0; i < Model.Input.AttendanceDeductions.Count; i++)
        { var row = Model.Input.AttendanceDeductions[i]; <fieldset class="border rounded-xl p-4 mb-4"><legend>Attendance deduction #@row.AttendancePenaltyId</legend><input type="hidden" name="AttendanceDeductions[@i].AttendancePenaltyId" value="@row.AttendancePenaltyId" /><label for="amount-@i">New deduction amount</label><input id="amount-@i" type="number" min="0" step="any" required name="AttendanceDeductions[@i].Amount" value="@row.Amount.ToString(System.Globalization.CultureInfo.InvariantCulture)" class="w-full border rounded-xl p-3 mb-3" /><label for="note-@i">Reason</label><input id="note-@i" required maxlength="500" name="AttendanceDeductions[@i].Reason" value="@row.Reason" class="w-full border rounded-xl p-3" /></fieldset> }
        <p class="text-secondary mb-4">Changing only the reason/note does not create a new version. The calculation inputs or result must change.</p><button class="bg-primary-container text-white rounded-xl px-5 py-2" type="submit">Create New Version</button><a asp-action="Review" asp-route-id="@Model.Payroll.PayrollId" class="inline-block ml-4">Back to Payroll</a>
    </form>
</div>
