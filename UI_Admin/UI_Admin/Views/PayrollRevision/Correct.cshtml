@model UI_Admin.Models.PayrollDocuments.CorrectionForm
@using D = UI_Admin.Models.Accountant.PayrollPeriods.PeriodDisplay
@{
    ViewData["Title"] = "Create Payroll Correction";
}

<div class="px-7 py-6 max-w-[1400px] mx-auto space-y-6">
    <!-- Header Title & Action Bar -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-1.5 text-xs text-indigo-600 font-semibold uppercase tracking-wider mb-1">
                <span class="material-symbols-outlined text-sm">edit_note</span>
                <span>Payroll / Revision &amp; Correction</span>
            </div>
            <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Create Payroll Correction</h1>
            <p class="text-sm text-slate-500 mt-0.5">
                @Model.Payroll.EmployeeName • Payroll #@Model.Payroll.PayrollId • Version V@(Model.Payroll.VersionNo)
            </p>
        </div>
        <div class="flex items-center gap-3">
            <a asp-action="Review" asp-route-id="@Model.Payroll.PayrollId"
               class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-white hover:bg-slate-50 text-slate-700 hover:text-slate-900 border border-slate-200 text-sm font-medium transition-all shadow-sm">
                <span class="material-symbols-outlined text-lg">arrow_back</span>
                <span>Back to Review</span>
            </a>
        </div>
    </div>

    <!-- Correction Form Card (Manager Style) -->
    <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm max-w-3xl space-y-5">
        <form asp-action="@(Model.FromFeedback ? "CorrectFeedback" : "Correct")" asp-route-id="@Model.SourceId" method="post" class="space-y-5" onsubmit="return handleCorrectionSubmit(this)">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-sm" role="alert"></div>

            <div class="p-4 rounded-xl bg-slate-50 border border-slate-200 text-xs text-slate-700">
                Timesheet #@Model.Payroll.TimesheetId • @Model.Payroll.TotalWorkHours.ToString("0.##") Hours. Work inputs are fixed; a new Payroll version will be created. The original version is preserved for audit history.
            </div>

            <div>
                <label for="correctionReason" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">
                    Correction Reason <span class="text-rose-500">*</span>
                </label>
                <textarea id="correctionReason" name="CorrectionReason" required maxlength="1000" rows="3"
                          placeholder="Describe the reason for creating this correction..."
                          class="w-full px-3.5 py-2.5 bg-slate-50/50 hover:bg-white focus:bg-white border border-slate-200 rounded-xl text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 transition-all box-border">@Model.Input.CorrectionReason</textarea>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label for="salaryHistoryId" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">
                        Salary History ID (Optional)
                    </label>
                    <input type="number" id="salaryHistoryId" min="1" name="SalaryHistoryId" value="@Model.Input.SalaryHistoryId" placeholder="Leave blank for automatic"
                           class="w-full h-11 px-3.5 bg-slate-50/50 hover:bg-white focus:bg-white border border-slate-200 rounded-xl text-sm text-slate-900 focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 transition-all box-border" />
                </div>
                <div>
                    <label for="holidayPayRuleId" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">
                        Holiday Pay Rule ID (Optional)
                    </label>
                    <input type="number" id="holidayPayRuleId" min="1" name="HolidayPayRuleId" value="@Model.Input.HolidayPayRuleId" placeholder="Leave blank for automatic"
                           class="w-full h-11 px-3.5 bg-slate-50/50 hover:bg-white focus:bg-white border border-slate-200 rounded-xl text-sm text-slate-900 focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 transition-all box-border" />
                </div>
            </div>

            <div class="flex items-center justify-between text-xs text-slate-500 pt-1">
                <span>Leave IDs blank to let the system select applicable records automatically.</span>
                <a asp-controller="AccountantSalaryHistory" asp-action="Index" asp-route-userId="@Model.Payroll.UserId" class="text-indigo-600 font-semibold hover:underline">
                    View Salary History &rarr;
                </a>
            </div>

            @if (Model.Input.AttendanceDeductions.Count > 0)
            {
                <div class="space-y-4 pt-2">
                    <h3 class="text-xs font-bold text-slate-900 uppercase tracking-wider">Attendance Deductions</h3>
                    @for (var i = 0; i < Model.Input.AttendanceDeductions.Count; i++)
                    {
                        var row = Model.Input.AttendanceDeductions[i];
                        <div class="p-4 rounded-xl border border-slate-200 bg-slate-50/50 space-y-3">
                            <span class="text-xs font-bold text-slate-800">Attendance Deduction #@row.AttendancePenaltyId</span>
                            <input type="hidden" name="AttendanceDeductions[@i].AttendancePenaltyId" value="@row.AttendancePenaltyId" />
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                <div>
                                    <label for="amount-@i" class="block text-xs font-semibold text-slate-600 mb-1">New Deduction Amount</label>
                                    <input id="amount-@i" type="number" min="0" step="any" required name="AttendanceDeductions[@i].Amount" value="@row.Amount.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                           class="w-full h-10 px-3 bg-white border border-slate-200 rounded-xl text-sm text-slate-900 focus:outline-none focus:border-indigo-500 box-border" />
                                </div>
                                <div>
                                    <label for="note-@i" class="block text-xs font-semibold text-slate-600 mb-1">Reason</label>
                                    <input id="note-@i" required maxlength="500" name="AttendanceDeductions[@i].Reason" value="@row.Reason"
                                           class="w-full h-10 px-3 bg-white border border-slate-200 rounded-xl text-sm text-slate-900 focus:outline-none focus:border-indigo-500 box-border" />
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }

            <p class="text-xs text-slate-500 pt-1">
                Updating only the reason or note does not create a new version; calculated figures must change.
            </p>

            <div class="flex items-center gap-3 pt-2">
                <button type="submit" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 active:bg-indigo-800 text-white text-sm font-semibold shadow-sm transition-all cursor-pointer">
                    <span class="material-symbols-outlined text-sm">add_circle</span>
                    <span>Create New Version</span>
                </button>
                <a asp-action="Review" asp-route-id="@Model.Payroll.PayrollId"
                   class="px-4 py-2.5 rounded-xl bg-white hover:bg-slate-100 text-slate-700 border border-slate-200 text-sm font-semibold transition-all shadow-xs cursor-pointer">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function handleCorrectionSubmit(form) {
            if (form.dataset.submitting === 'true') return false;
            form.dataset.submitting = 'true';
            const btn = form.querySelector('button[type="submit"]');
            if (btn) {
                btn.disabled = true;
                btn.classList.add('opacity-75', 'cursor-not-allowed');
                btn.innerText = 'Creating...';
            }
            return true;
        }
    </script>
}
