@model UI_Admin.Models.Accountant.RecordPaymentViewModel

@{
    ViewData["Title"] = "Record Payment";
}

<div class="flex flex-col w-full gap-unit-4 px-7 py-4">
    <div class="flex items-center gap-unit-3">
        <a asp-controller="AccountantOrders" asp-action="Index" class="inline-flex items-center justify-center h-9 w-9 rounded-xl bg-surface-container-lowest hover:bg-surface-container text-secondary hover:text-on-surface transition-colors shadow-sm">
            <span class="material-symbols-outlined text-[20px]">arrow_back</span>
        </a>
        <div class="flex flex-col">
            <div class="list-eyebrow">Order Management</div>
            <h1 class="font-display-lg text-display-lg text-on-surface tracking-tight">Record Payment</h1>
            <p class="font-body-sm text-body-sm text-secondary mt-1">@ViewData["OrderNumber"]</p>
        </div>
    </div>

    <div class="w-full max-w-xl bg-surface-container-lowest rounded-xl shadow-sm p-unit-6">
        <form method="post" asp-controller="AccountantOrders" asp-action="RecordPayment" asp-route-id="@ViewData["OrderId"]" class="flex flex-col gap-unit-4">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-error font-body-sm text-body-sm"></div>

            <div class="bg-surface-container-low rounded-xl p-unit-4 mb-4">
                <div class="grid grid-cols-2 gap-4 text-sm">
                    <div>
                        <span class="font-label-sm text-secondary">Order Number</span>
                        <div class="font-body-md-medium text-on-surface mt-1">@ViewData["OrderNumber"]</div>
                    </div>
                    <div>
                        <span class="font-label-sm text-secondary">Total Amount</span>
                        <div class="font-body-md-medium text-primary font-bold mt-1">@UI_Admin.Helpers.CurrencyHelper.FormatVnd((decimal)ViewData["TotalAmount"])</div>
                    </div>
                    <div>
                        <span class="font-label-sm text-secondary">Payment Status</span>
                        <div class="font-body-md-medium text-body-md mt-1 @(((string)ViewData["PaymentStatus"]) == "PAID" ? "text-emerald-700" : "text-amber-700")">@ViewData["PaymentStatus"]</div>
                    </div>
                    <div>
                        <span class="font-label-sm text-secondary">Remaining</span>
                        <div class="font-body-md-medium text-on-surface font-bold mt-1">@UI_Admin.Helpers.CurrencyHelper.FormatVnd((decimal)ViewData["Remaining"])</div>
                    </div>
                </div>
            </div>

            <div class="flex flex-col gap-unit-2">
                <label asp-for="Amount" class="font-label-md text-label-md text-on-surface">Amount <span class="text-error">*</span></label>
                <input asp-for="Amount" class="w-full h-[40px] px-unit-3 bg-surface-container-lowest border border-surface-container-high rounded-xl text-on-surface font-body-md text-body-md focus:outline-none focus:ring-1 focus:ring-primary-container" type="number" step="0.01" min="0.01" />
                <span asp-validation-for="Amount" class="text-error font-body-sm text-body-sm"></span>
            </div>

            <div class="flex flex-col gap-unit-2">
                <label asp-for="PaymentMethod" class="font-label-md text-label-md text-on-surface">Payment Method <span class="text-error">*</span></label>
                <select asp-for="PaymentMethod" class="w-full h-[40px] px-unit-3 bg-surface-container-lowest border border-surface-container-high rounded-xl text-on-surface font-body-md text-body-md focus:outline-none focus:ring-1 focus:ring-primary-container cursor-pointer">
                    <option value="">-- Select Method --</option>
                    <option value="CASH">Cash</option>
                    <option value="BANK_TRANSFER">Bank Transfer</option>
                    <option value="CARD">Credit/Debit Card</option>
                    <option value="EWALLET">E-Wallet</option>
                </select>
                <span asp-validation-for="PaymentMethod" class="text-error font-body-sm text-body-sm"></span>
            </div>

            <div class="flex flex-col gap-unit-2">
                <label asp-for="ReferenceNumber" class="font-label-md text-label-md text-on-surface">Reference Number</label>
                <input asp-for="ReferenceNumber" class="w-full h-[40px] px-unit-3 bg-surface-container-lowest border border-surface-container-high rounded-xl text-on-surface font-body-md text-body-md placeholder:text-secondary focus:outline-none focus:ring-1 focus:ring-primary-container" placeholder="Transaction ID, check number, etc." />
                <span asp-validation-for="ReferenceNumber" class="text-error font-body-sm text-body-sm"></span>
            </div>

            <div class="flex flex-col gap-unit-2">
                <label asp-for="Note" class="font-label-md text-label-md text-on-surface">Note</label>
                <textarea asp-for="Note" rows="3" class="w-full px-unit-3 py-2 bg-surface-container-lowest border border-surface-container-high rounded-xl text-on-surface font-body-md text-body-md placeholder:text-secondary focus:outline-none focus:ring-1 focus:ring-primary-container" placeholder="Optional notes..."></textarea>
                <span asp-validation-for="Note" class="text-error font-body-sm text-body-sm"></span>
            </div>

            <div class="flex items-center justify-end gap-unit-3 pt-unit-2 border-t border-surface-container-high">
                <a asp-controller="AccountantOrders" asp-action="Index" class="inline-flex items-center justify-center h-[40px] px-unit-4 rounded-xl bg-surface-container hover:bg-surface-container-high text-on-surface font-body-md-medium text-body-md-medium transition-colors">Cancel</a>
                <button type="submit" class="inline-flex items-center justify-center gap-unit-2 h-[40px] px-unit-4 rounded-xl bg-primary-container hover:bg-primary text-on-primary font-body-md-medium text-body-md-medium transition-colors shadow-sm cursor-pointer">
                    <span class="material-symbols-outlined text-[20px]">payments</span>
                    <span>Record Payment</span>
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}