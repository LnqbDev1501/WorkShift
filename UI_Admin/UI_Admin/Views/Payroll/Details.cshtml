@model UI_Admin.Models.Payroll.PayrollPeriodDetailResponse
@{ ViewData["Title"] = Model.PeriodCode; }
@section Styles { <link rel="stylesheet" href="~/css/payroll.css" asp-append-version="true" /> }
<header class="payroll-topbar"><a asp-action="List">‹ Payroll Periods</a><span>@Model.PeriodCode</span></header>
<div class="payroll-page">
    <div class="payroll-heading"><div><h1>@Model.PeriodName</h1><p>@Model.BranchName · @Model.StartDate.ToString("dd MMM yyyy") – @Model.EndDate.ToString("dd MMM yyyy")</p></div><span class="payroll-status @Model.Status.ToLowerInvariant()">@Model.Status.Replace('_', ' ')</span></div>
    <section class="payroll-stats"><article><div>EMPLOYEES</div><p><strong>@Model.Summary.TotalPayrolls</strong></p></article><article><div>NET SALARY</div><p><strong>@Model.Summary.TotalNetSalary.ToString("N0") ₫</strong></p></article><article><div>REWARDS</div><p><strong>@Model.Summary.TotalReward.ToString("N0") ₫</strong></p></article><article><div>REQUIRING REVISION</div><p><strong class="red">@Model.Summary.RejectedPayrollCount</strong></p></article></section>
    <div class="payroll-compliance"><div><strong>Submitted by @(Model.SubmittedBy?.FullName ?? "—")</strong><small>@Model.SubmittedAt?.ToString("dd MMM yyyy, HH:mm") · Approved by @(Model.ApprovedBy?.FullName ?? "—") @Model.ApprovedAt?.ToString("dd MMM yyyy, HH:mm")</small></div></div>
    <section class="payroll-table-card"><div class="payroll-table-toolbar"><strong>Employee payroll details</strong></div><div class="payroll-table-scroll"><table><thead><tr><th>EMPLOYEE</th><th>HOURS</th><th class="money">GROSS SALARY</th><th class="money">DEDUCTIONS</th><th class="money">NET SALARY</th><th>STATUS / AUDIT</th></tr></thead><tbody>
    @foreach (var pay in Model.Payrolls.Items) { <tr><td><strong>@pay.EmployeeFullName</strong><small>@pay.EmployeePosition</small><details><summary>Pay breakdown</summary>@foreach (var detail in pay.Details) { <p>@detail.Description: @detail.Amount.ToString("N0") ₫ <small>@detail.Note</small></p> }</details></td><td>@pay.TotalWorkHours.ToString("N2")</td><td class="money">@pay.GrossSalary.ToString("N0") ₫</td><td class="money">@pay.TotalDeduction.ToString("N0") ₫</td><td class="money"><strong>@pay.NetSalary.ToString("N0") ₫</strong></td><td><span class="payroll-status @pay.Status.ToLowerInvariant()">@pay.Status</span>@if (pay.Rejection != null) { <small class="red">@pay.Rejection.Reason</small><small>@pay.Rejection.RejectedByName · @pay.Rejection.RejectedAt?.ToString("dd MMM yyyy, HH:mm")</small> }</td></tr> }
    @if (Model.Payrolls.Items.Count == 0) { <tr><td colspan="6" class="payroll-empty">No employee payrolls found.</td></tr> }
    </tbody></table></div><footer class="payroll-pagination"><span>@Model.Payrolls.TotalCount employee payrolls</span><nav>@if (Model.Payrolls.PageNumber > 1) { <a asp-action="Details" asp-route-id="@Model.PayrollPeriodId" asp-route-pageNumber="@(Model.Payrolls.PageNumber - 1)">‹ Previous</a> }<span>Page @Model.Payrolls.PageNumber / @Math.Max(1, Model.Payrolls.TotalPages)</span>@if (Model.Payrolls.PageNumber < Model.Payrolls.TotalPages) { <a asp-action="Details" asp-route-id="@Model.PayrollPeriodId" asp-route-pageNumber="@(Model.Payrolls.PageNumber + 1)">Next ›</a> }</nav></footer></section>
</div>
