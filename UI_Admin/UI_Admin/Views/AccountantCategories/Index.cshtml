@model UI_Admin.Models.Accountant.AccountantCategoryListViewModel

@{
    ViewData["Title"] = "Categories";
}

<div class="flex flex-col w-full gap-unit-4 px-7 py-4">

    <partial name="_NotificationModal" />

    <!-- Header Title & Action Bar -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-unit-4">
        <div class="flex flex-col">
            <div class="list-eyebrow">Product Catalog</div>
            <div class="flex items-center gap-unit-3">
                <h1 class="font-display-lg text-display-lg text-on-surface tracking-tight">Categories</h1>
            </div>
            <p class="font-body-md text-body-md text-secondary mt-1">Organize products into categories for ordering and reporting. Read-only access for Accountant role.</p>
        </div>
    </div>

    <partial name="_ListMetrics" model='@(new ListMetricViewModel[] {
new("Matching Categories", Model.TotalItems.ToString("N0"), "Matching current filters", "category", "#8b5cf6"),
new("Active Categories", Model.Items.Count(x => x.Status == "ACTIVE").ToString("N0"), "On this page", "check_circle", "#10b981"),
new("Inactive Categories", Model.Items.Count(x => x.Status == "INACTIVE").ToString("N0"), "On this page", "pause_circle", "#f59e0b"),
new("Products", Model.Items.Sum(x => x.ProductCount).ToString("N0"), "Across categories on this page", "inventory_2", "#4f46e5")
})' />
    <!-- Filter Toolbar -->
    <form method="get" asp-controller="AccountantCategories" asp-action="Index" id="filter-form" class="ws-list-filter" role="search">
        <div class="ws-filter-row">
            <label class="ws-filter-field ws-filter-keyword"><span class="material-symbols-outlined" aria-hidden="true">search</span><input aria-label="Search" id="category-search" name="search" value="@Model.Search" placeholder="Search category name..." type="text"></label>
            <div class="ws-filter-field"><select aria-label="Status" id="status-filter" name="status" onchange="this.form.submit()">
                        <option value="all" selected="@(Model.StatusFilter == "all")">All Statuses</option>
                        <option value="active" selected="@(Model.StatusFilter == "active")">Active</option>
                        <option value="inactive" selected="@(Model.StatusFilter == "inactive")">Inactive</option>
                    </select></div>
            <partial name="_ListFilterActions" model='"Index"' />
        </div>
    </form>

    <!-- Main Table Container -->
    <div class="bg-surface-container-lowest rounded-xl shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left">
                <thead>
                    <tr class="h-[40px] bg-surface-container-low text-secondary text-label-md font-label-md uppercase tracking-wider">
                        <th class="px-unit-5 py-2" scope="col">Category Name</th>
                        <th class="px-unit-4 py-2" scope="col">Description</th>
                        <th class="px-unit-4 py-2 text-right" scope="col">Products</th>
                        <th class="px-unit-4 py-2" scope="col">Status</th>
                        <th class="px-unit-5 py-2 text-right" scope="col">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y-0" id="categories-table-body">
                    @if (Model.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="5" class="px-unit-5 py-8 text-center text-secondary font-body-md">
                                No categories found matching your filter criteria.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Items)
                        {
                            var isActive = item.Status.Equals("ACTIVE", StringComparison.OrdinalIgnoreCase);
                            <tr class="h-[56px] hover:bg-surface-container-low transition-colors group @(!isActive ? "bg-surface-container-lowest/70" : "")">
                                <td class="px-unit-5 py-2 font-body-md-medium text-body-md-medium @(isActive ? "text-on-surface" : "text-secondary")">
                                    @item.CategoryName
                                </td>
                                <td class="px-unit-4 py-2 font-body-md text-body-md text-secondary max-w-sm truncate">
                                    @(string.IsNullOrWhiteSpace(item.Description) ? "No description provided." : item.Description)
                                </td>
                                <td class="px-unit-4 py-2 font-code-num text-code-num @(isActive ? "text-on-surface" : "text-secondary") text-right whitespace-nowrap">
                                    @item.ProductCount products
                                </td>
                                <td class="px-unit-4 py-2 whitespace-nowrap">
                                    @if (isActive)
                                    {
                                        <span class="inline-flex items-center gap-1.5 h-6 px-2 rounded-full text-label-sm font-label-sm bg-emerald-50 text-emerald-700">
                                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1.5 h-6 px-2 rounded-full text-label-sm font-label-sm bg-surface-container text-secondary">
                                            <span class="w-1.5 h-1.5 rounded-full bg-secondary"></span>
                                            Inactive
                                        </span>
                                    }
                                </td>
                                <td class="px-unit-5 py-2 text-right whitespace-nowrap">
                                    <div class="inline-flex items-center justify-end gap-2">
                                        <a href="@Url.Action("Details", "AccountantCategories", new { id = item.CategoryId })" title="View details" aria-label="View details" class="ws-icon-action"><span class="material-symbols-outlined" aria-hidden="true">visibility</span></a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <!-- Pagination / Footer Bar -->
        <partial name="_ListPagination" model="@(new ListPaginationViewModel
        {
            PageNumber = Model.PageNumber,
            PageSize = Model.PageSize,
            TotalItems = Model.TotalItems,
            ItemLabel = "categories",
        })" />
    </div>

</div>