@model UI_Admin.Models.ShiftTemplateListViewModel
@{
    ViewData["Title"] = "Shift Templates";
    var filterRoutes = new Dictionary<string, string>
    {
        ["search"] = Model.Query.Search ?? "",
        ["status"] = Model.Query.Status ?? "",
        ["startTime"] = Model.Query.StartTime?.ToString("HH:mm:ss", System.Globalization.CultureInfo.InvariantCulture) ?? "",
        ["endTime"] = Model.Query.EndTime?.ToString("HH:mm:ss", System.Globalization.CultureInfo.InvariantCulture) ?? ""
    };
}
@section Styles {
    <link rel="stylesheet" href="~/css/shift-templates.css" asp-append-version="true" />
}
<div class="shift-page">
    <section class="shift-content" aria-labelledby="shift-heading">
        <div class="shift-heading">
            <div><div class="list-eyebrow">Enterprise Schedule Directory</div><h1 id="shift-heading">Shift Templates</h1><p>Manage reusable shift hours and break durations.</p></div>
            <a asp-action="Create" class="shift-primary" style="text-decoration:none"><span aria-hidden="true">＋</span> Create Template</a>
        </div>
    <partial name="_ListMetrics" model='@(new ListMetricViewModel[] {
new("Matching Templates", Model.Result.TotalItems.ToString("N0"), "Matching current filters", "calendar_view_week"),
new("Active Templates", Model.Result.Items.Count(x => x.IsActive).ToString("N0"), "On this page", "check_circle"),
new("Inactive Templates", Model.Result.Items.Count(x => x.Status == "INACTIVE").ToString("N0"), "On this page", "pause_circle"),
new("Templates Shown", Model.Result.Items.Count.ToString("N0"), "On this page", "view_list")
})' />
        <partial name="_Feedback" />
        <div class="shift-card">
            <div class="shift-toolbar">
                <form asp-controller="ShiftTemplates" asp-action="List" method="get" class="shift-search shift-filters" role="search">
                    <div class="shift-filter-field shift-filter-search"><label for="table-search">Search</label>
                    <input id="table-search" name="search" value="@Model.Query.Search" placeholder="Search name or description" type="search" />
                    </div>
                    <div class="shift-filter-field"><label for="status-filter">Status</label>
                        <select id="status-filter" name="status">
                            <option value="">All statuses</option>
                            <option value="ACTIVE" selected="@(Model.Query.Status == "ACTIVE")">Active</option>
                            <option value="INACTIVE" selected="@(Model.Query.Status == "INACTIVE")">Inactive</option>
                        </select>
                    </div>
                    <div class="shift-filter-field"><label for="start-time">Starts at or after (24h)</label><input id="start-time" name="startTime" value="@(Model.Query.StartTime?.ToString(Model.Query.StartTime.Value.Second == 0 ? "HH:mm" : "HH:mm:ss"))" type="text" placeholder="HH:mm" pattern="([01][0-9]|2[0-3]):[0-5][0-9](:[0-5][0-9])?" maxlength="8" title="Use 24-hour time, e.g. 05:00 or 18:30." autocomplete="off" /></div>
                    <div class="shift-filter-field"><label for="end-time">Ends at or before (24h)</label><input id="end-time" name="endTime" value="@(Model.Query.EndTime?.ToString(Model.Query.EndTime.Value.Second == 0 ? "HH:mm" : "HH:mm:ss"))" type="text" placeholder="HH:mm" pattern="([01][0-9]|2[0-3]):[0-5][0-9](:[0-5][0-9])?" maxlength="8" title="Use 24-hour time, e.g. 05:00 or 18:30." autocomplete="off" /></div>
                    <partial name="_ListFilterActions" model='"List"' />
                    <div asp-validation-summary="All" class="text-danger shift-filter-help" role="alert"></div>
                </form>
            </div>
            @if (Model.ErrorMessage is not null)
            {
                <div class="shift-empty" role="alert"><h2>Could not load templates</h2><p>@Model.ErrorMessage</p><a asp-action="List" asp-all-route-data="filterRoutes" class="shift-reset">Try again</a></div>
            }
            else
            {
                <div class="shift-table-wrap">
                    <table class="shift-table">
                        <colgroup><col class="shift-name-column" /><col /><col /><col /><col /><col /><col /></colgroup>
                        <thead><tr><th scope="col">Shift Name</th><th scope="col">Start Time</th><th scope="col">End Time</th><th scope="col">Break Minutes</th><th scope="col">Status</th><th scope="col">Created</th><th scope="col" class="shift-actions">Actions</th></tr></thead>
                        <tbody>
                        @foreach (var item in Model.Result.Items)
                        {
                            <tr>
                                <td><strong>@item.ShiftName</strong></td>
                                <td class="shift-number">@item.StartTime.ToString("HH:mm:ss")</td>
                                <td class="shift-number">@item.EndTime.ToString("HH:mm:ss")</td>
                                <td class="shift-number">@item.BreakMinutes mins</td>
                                <td><span class="shift-status @(item.IsActive ? "is-active" : "is-inactive")"><span aria-hidden="true">●</span> @(item.IsActive ? "Active" : item.Status == "INACTIVE" ? "Inactive" : item.Status)</span></td>
                                <td class="shift-created">
                                    @if (item.CreatedAt is DateTime createdAt)
                                    {
                                        <time datetime="@createdAt.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)">@createdAt.ToString("dd MMM yyyy", System.Globalization.CultureInfo.InvariantCulture)</time>
                                    }
                                    else
                                    {
                                        <span aria-label="Creation date unavailable">—</span>
                                    }
                                </td>
                                <td class="shift-actions"><a asp-action="Details" asp-route-id="@item.ShiftTemplateId" aria-label="View details for @item.ShiftName" title="View details" class="inline-flex items-center justify-center w-[30px] h-8 text-secondary align-middle"><span class="material-symbols-outlined text-[19px]" aria-hidden="true">visibility</span></a><a asp-action="Edit" asp-route-id="@item.ShiftTemplateId" aria-label="Edit @item.ShiftName" title="Edit template" class="inline-flex items-center justify-center w-[30px] h-8 text-primary align-middle"><span class="material-symbols-outlined text-[19px]" aria-hidden="true">edit</span></a>@if (item.IsActive || string.Equals(item.Status, "INACTIVE", StringComparison.OrdinalIgnoreCase))
{
    <button type="button" class="template-status-trigger @(item.IsActive ? "" : "template-restore-trigger")" data-id="@item.ShiftTemplateId" data-name="@item.ShiftName" data-restore="@((!item.IsActive).ToString().ToLowerInvariant())" aria-label="@(item.IsActive ? "Deactivate" : "Restore") @item.ShiftName" title="@(item.IsActive ? "Deactivate template" : "Restore template")"><span class="material-symbols-outlined" aria-hidden="true">@(item.IsActive ? "pause_circle" : "restore")</span></button>
}</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
                @if (Model.Result.Items.Count == 0)
                {
                    <div class="shift-empty"><div class="shift-empty-icon" aria-hidden="true">⌕</div><h2>No shift templates found</h2><p>@(!Model.HasFilters ? "There are no shift templates in the catalog yet." : "No templates match the entered query. Check for typos or reset filters.")</p>
                        @if (Model.HasFilters) { <a asp-action="List" class="shift-reset">Reset Search</a> }
                    </div>
                }
                <partial name="_ListPagination" model="@(new ListPaginationViewModel
                {
                    PageNumber = Model.Query.Page,
                    TotalItems = Model.Result.TotalItems,
                    ItemLabel = "templates",
                    MaximumPages = 20,
                })" />
                @if (Model.Result.TotalPages > 20) { <p class="shift-limit">Only the first 20 pages are available. Refine your search to find more templates.</p> }
            }
        </div>
    </section>
</div>
<dialog id="list-status-dialog" class="template-status-dialog" aria-labelledby="list-status-title" aria-describedby="list-status-description">
    <h2 id="list-status-title">Change template status?</h2>
    <p id="list-status-description"></p>
    <form asp-action="ChangeStatus" method="post">
        <input type="hidden" name="id" id="list-status-id" />
        <input type="hidden" name="restore" id="list-status-restore" />
        <input type="hidden" name="returnUrl" value="@(Context.Request.PathBase + Context.Request.Path + Context.Request.QueryString)" />
        <div class="template-status-actions"><button type="button" id="list-status-cancel" autofocus>Cancel</button><button type="submit" id="list-status-confirm">Confirm</button></div>
    </form>
</dialog>
@section Scripts {
    <script src="~/js/shift-template-status.js" asp-append-version="true"></script>
    <script src="~/js/shift-time-picker.js" asp-append-version="true"></script>
    <script src="~/js/shift-template-success.js" asp-append-version="true"></script>
}
