@model UI_Admin.Models.NotificationListPageViewModel
@{
    ViewData["Title"] = "Notifications";
}
@section Styles { <link rel="stylesheet" href="~/css/notifications.css" asp-append-version="true" /> }

<section class="notifications-page">
    <header class="notification-header">
        <div>
            <span class="list-eyebrow">OPERATIONS ENGINE / COMMS HUB</span>
            <h1>Notifications</h1>
            <p>Review notification history and send operational announcements.</p>
        </div>
        <div class="header-actions"><span class="history-chip">◷ History</span><a asp-action="Send" class="btn-primary">✦ Send Notification</a></div>
    </header>

    <div class="list-summary-grid">
        <div class="summary-card"><span class="summary-icon">◎</span><span>Total broadcasts</span><strong>@Model.TotalCount</strong><small>Matching current filters</small></div>
        <div class="summary-card"><span class="summary-icon">▤</span><span>Current page</span><strong>@Model.Page</strong><small>@Model.Items.Count notifications shown</small></div>
        <div class="summary-card"><span class="summary-icon">↕</span><span>Sort order</span><strong>@(Model.SortOrder == "asc" ? "Oldest" : "Newest")</strong><small>By creation date</small></div>
    </div>

    <form method="get" class="notification-filter-card">
        <input name="Search" value="@Model.Search" placeholder="Search notification title or message..." />
        <select name="Type">
            <option value="">All types</option>
            <option value="Broadcast" selected="@(Model.Type == "Broadcast")">Broadcast</option>
        </select>
        <input name="DateFrom" value="@(Model.DateFrom?.ToString("yyyy-MM-dd"))" type="date" />
        <input name="DateTo" value="@(Model.DateTo?.ToString("yyyy-MM-dd"))" type="date" />
        <select name="SortOrder">
            <option value="desc" selected="@(Model.SortOrder == "desc")">Newest first</option>
            <option value="asc" selected="@(Model.SortOrder == "asc")">Oldest first</option>
        </select>
        <input type="hidden" name="SortBy" value="CreatedAt" />
        <partial name="_ListFilterActions" model='"History"' />
    </form>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage)) { <div class="notice-error">@Model.ErrorMessage</div> }
    <div class="notification-table-card">
        @if (Model.Items.Count == 0)
        {
            <div class="notification-empty">No notifications match the selected filters.</div>
        }
        else
        {
            <div class="table-scroll"><table class="notification-table"><thead><tr><th>Title</th><th>Type</th><th>Audience</th><th>Channels</th><th>Created</th><th></th></tr></thead><tbody>
            @foreach (var item in Model.Items)
            {
                <tr><td><div class="title-cell"><span class="title-icon">✉</span><div><strong>@item.Title</strong><span class="subline">Notification #@item.NotificationId</span></div></div></td><td><span class="type-pill">@item.NotificationType</span></td><td><span class="audience-cell">◉ @item.Audience</span></td><td><div class="channel-list">@foreach (var channel in item.Channels ?? Enumerable.Empty<string>()) { <span>@(channel == "InApp" ? "▣ In-App" : "✉ Email")</span> }</div></td><td>@item.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td><td><a asp-action="Detail" asp-route-id="@item.NotificationId" class="detail-link">View details →</a></td></tr>
            }
            </tbody></table></div>

        }
        <partial name="_ListPagination" model="@(new ListPaginationViewModel
        {
            PageNumber = Model.Page,
            PageSize = Model.PageSize,
            TotalItems = Model.TotalCount,
            ItemLabel = "notifications",
        })" />
    </div>
</section>
