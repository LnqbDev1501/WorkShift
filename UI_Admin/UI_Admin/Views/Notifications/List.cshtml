@model UI_Admin.Models.NotificationListPageViewModel
@{
    ViewData["Title"] = "Notifications";
    var totalPages = Math.Max(1, (int)Math.Ceiling(Model.TotalCount / (double)Model.PageSize));
}
@section Styles { <link rel="stylesheet" href="~/css/notifications.css" asp-append-version="true" /> }

<section class="notifications-page">
    <header class="notification-header">
        <div>
            <span class="eyebrow">OPERATIONS ENGINE / COMMS HUB</span>
            <h1>Notifications</h1>
            <p>Review notification history and send operational announcements.</p>
        </div>
        <a asp-action="Send" class="btn-primary">+ Send Notification</a>
    </header>

    <form method="get" class="notification-filter-card">
        <input name="Search" value="@Model.Search" placeholder="Search notification title or message..." />
        <select name="Type">
            <option value="">All types</option>
            <option value="Broadcast" selected="@(Model.Type == "Broadcast")">Broadcast</option>
        </select>
        <input name="DateFrom" value="@(Model.DateFrom?.ToString("yyyy-MM-dd"))" type="date" />
        <input name="DateTo" value="@(Model.DateTo?.ToString("yyyy-MM-dd"))" type="date" />
        <select name="SortOrder">
            <option value="desc" selected="@(Model.SortOrder == "desc")">Newest first</option>
            <option value="asc" selected="@(Model.SortOrder == "asc")">Oldest first</option>
        </select>
        <input type="hidden" name="SortBy" value="CreatedAt" />
        <button type="submit" class="btn-secondary">Apply filters</button>
    </form>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage)) { <div class="notice-error">@Model.ErrorMessage</div> }
    <div class="notification-table-card">
        @if (Model.Items.Count == 0)
        {
            <div class="notification-empty">No notifications match the selected filters.</div>
        }
        else
        {
            <div class="table-scroll"><table class="notification-table"><thead><tr><th>Title</th><th>Type</th><th>Audience</th><th>Channels</th><th>Created</th><th></th></tr></thead><tbody>
            @foreach (var item in Model.Items)
            {
                <tr><td><strong>@item.Title</strong><span class="subline">Notification #@item.NotificationId</span></td><td><span class="type-pill">@item.NotificationType</span></td><td>@item.Audience</td><td><div class="channel-list">@foreach (var channel in item.Channels) { <span>@channel</span> }</div></td><td>@item.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td><td><a asp-action="Detail" asp-route-id="@item.NotificationId" class="detail-link">View details</a></td></tr>
            }
            </tbody></table></div>
            <footer class="notification-pagination"><span>Showing @Model.Items.Count of @Model.TotalCount notifications</span><div>@if (Model.Page > 1) { <a asp-route-page="@(Model.Page - 1)" asp-route-pageSize="@Model.PageSize" asp-route-search="@Model.Search" asp-route-type="@Model.Type" asp-route-sortOrder="@Model.SortOrder">Previous</a> } <span>Page @Model.Page / @totalPages</span> @if (Model.Page < totalPages) { <a asp-route-page="@(Model.Page + 1)" asp-route-pageSize="@Model.PageSize" asp-route-search="@Model.Search" asp-route-type="@Model.Type" asp-route-sortOrder="@Model.SortOrder">Next</a> }</div></footer>
        }
    </div>
</section>
