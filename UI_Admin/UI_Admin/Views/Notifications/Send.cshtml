@model UI_Admin.Models.SendNotificationViewModel
@{ ViewData["Title"] = "Send Notification"; }
@section Styles { <link rel="stylesheet" href="~/css/notifications.css" asp-append-version="true" /> }
<section class="notifications-page send-page">
    <header class="notification-header"><div><span class="eyebrow">OPERATIONAL BROADCAST</span><h1>Send Notification</h1><p>Publish an announcement to an active audience through In-App or Email delivery.</p></div><a asp-action="List" class="btn-secondary">View history</a></header>
    @if (Model.Result != null) { <div class="send-result"><h2>Notification sent</h2><p>Notification #@Model.Result.NotificationId was created successfully.</p><div class="metric-grid"><div><span>Total recipients</span><strong>@Model.Result.RecipientCount</strong></div><div><span>In-App</span><strong>@Model.Result.InAppRecipientCount</strong></div><div><span>Emails sent</span><strong>@Model.Result.EmailSentCount</strong></div><div><span>Email failures</span><strong>@Model.Result.EmailFailedCount</strong></div></div><a asp-action="Detail" asp-route-id="@Model.Result.NotificationId" class="detail-link">View notification detail</a></div> }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage)) { <div class="notice-error">@Model.ErrorMessage</div> }
    <form method="post" class="send-form"><div asp-validation-summary="ModelOnly" class="notice-error"></div>
        <section class="form-card"><div class="form-card-heading"><span class="payload-icon">⌘</span><div><h2>Target Scope &amp; Audience</h2><p>Choose one scope. The API sends to active users in that audience.</p></div></div><div class="scope-cards"><label class="scope-card"><input asp-for="Target" type="radio" value="All" /><span><strong>Entire organization</strong><small>All active personnel</small></span></label><label class="scope-card"><input asp-for="Target" type="radio" value="Staff" /><span><strong>Staff</strong><small>Active staff only</small></span></label><label class="scope-card"><input asp-for="Target" type="radio" value="Manager" /><span><strong>Managers</strong><small>Active managers only</small></span></label><label class="scope-card"><input asp-for="Target" type="radio" value="Accountant" /><span><strong>Accountants</strong><small>Active accountants only</small></span></label><label class="scope-card"><input asp-for="Target" type="radio" value="Region" /><span><strong>One region</strong><small>Enter its Region ID below</small></span></label><label class="scope-card"><input asp-for="Target" type="radio" value="Branch" /><span><strong>One branch</strong><small>Enter its Branch ID below</small></span></label></div><div class="field-grid scope-id-fields"><label id="region-field">Region ID<input asp-for="RegionId" type="number" min="1" placeholder="Required for Region" /></label><label id="branch-field">Branch ID<input asp-for="BranchId" type="number" min="1" placeholder="Required for Branch" /></label></div></section>
        <section class="form-card"><h2>Notification Content</h2><div class="form-stack"><label>Notification title <span>*</span><input asp-for="Title" maxlength="200" placeholder="Enter a clear, actionable subject" /><small><span asp-validation-for="Title"></span></small></label><label>Message body <span>*</span><textarea asp-for="Message" rows="7" placeholder="Write the notification content..."></textarea><small><span asp-validation-for="Message"></span></small></label></div></section>
        <section class="form-card"><h2>Delivery Channels</h2><p>Select at least one delivery channel.</p><div class="channel-options"><label><input type="checkbox" name="Channels" value="InApp" checked="@(Model.Channels.Contains("InApp"))" /> In-App notification</label><label><input type="checkbox" name="Channels" value="Email" checked="@(Model.Channels.Contains("Email"))" /> Email via Resend template</label></div></section>
        <div class="send-actions"><button type="submit" class="btn-primary">Send Notification</button></div>
    </form>
</section>
@section Scripts { <script>const targets=document.querySelectorAll('input[name="Target"]'),region=document.getElementById('region-field'),branch=document.getElementById('branch-field');function scope(){const value=document.querySelector('input[name="Target"]:checked')?.value;region.hidden=value!=='Region';branch.hidden=value!=='Branch';}targets.forEach(target=>target.addEventListener('change',scope));scope();</script> }
