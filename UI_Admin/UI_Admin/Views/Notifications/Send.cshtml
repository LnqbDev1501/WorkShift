@model UI_Admin.Models.SendNotificationViewModel
@{ ViewData["Title"] = "Send Notification"; }
@section Styles { <link rel="stylesheet" href="~/css/notifications.css" asp-append-version="true" /> }
<section class="notifications-page send-page">
    <header class="notification-header"><div><span class="eyebrow">OPERATIONAL BROADCAST</span><h1>Send Notification</h1><p>Publish an announcement to active roles, optionally narrowed by region and branch.</p></div><a asp-action="History" class="btn-secondary">View history</a></header>
    @if (TempData["NotificationSuccess"] is string successMessage) { <div class="success-toast" role="status">@successMessage</div> }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage)) { <div class="notice-error">@Model.ErrorMessage</div> }
    <form method="post" class="send-form"><div asp-validation-summary="ModelOnly" class="notice-error"></div><input asp-for="Target" type="hidden" value="Custom" />
        <section class="form-card"><div class="form-card-heading"><span class="payload-icon">⌘</span><div><h2>Audience</h2><p>Select one or more roles. Region and branch filters are optional and combine with roles.</p></div></div><div class="scope-cards"><label class="scope-card"><input type="checkbox" name="TargetRoles" value="STAFF" checked="@(Model.TargetRoles.Contains("STAFF"))" /><span><strong>Staff</strong><small>Active staff only</small></span></label><label class="scope-card"><input type="checkbox" name="TargetRoles" value="MANAGER" checked="@(Model.TargetRoles.Contains("MANAGER"))" /><span><strong>Managers</strong><small>Active managers only</small></span></label><label class="scope-card"><input type="checkbox" name="TargetRoles" value="ACCOUNTANT" checked="@(Model.TargetRoles.Contains("ACCOUNTANT"))" /><span><strong>Accountants</strong><small>Active accountants only</small></span></label></div><span asp-validation-for="TargetRoles" class="validation-message"></span><div class="field-grid scope-id-fields"><label>Region<select asp-for="RegionId"><option value="">All regions</option>@foreach (var region in Model.Regions) { <option value="@region.RegionId">@region.RegionName</option> }</select></label><label>Branch<select asp-for="BranchId"><option value="">All branches</option>@foreach (var branch in Model.Branches) { <option value="@branch.BranchId" data-region-id="@branch.RegionId">@branch.BranchName</option> }</select></label></div></section>
        <section class="form-card"><h2>Notification Content</h2><div class="form-stack"><label>Notification title <span>*</span><input asp-for="Title" maxlength="200" placeholder="Enter a clear, actionable subject" /><small><span asp-validation-for="Title"></span></small></label><label>Message body <span>*</span><textarea asp-for="Message" rows="7" placeholder="Write the notification content..."></textarea><small><span asp-validation-for="Message"></span></small></label></div></section>
        <section class="form-card"><h2>Delivery Channels</h2><p>Select at least one delivery channel.</p><div class="channel-options"><label><input type="checkbox" name="Channels" value="InApp" checked="@(Model.Channels.Contains("InApp"))" /> In-App notification</label><label><input type="checkbox" name="Channels" value="Email" checked="@(Model.Channels.Contains("Email"))" /> Email via Resend template</label></div></section>
        <div class="send-actions"><button type="submit" class="btn-primary">Send Notification</button></div>
    </form>
</section>
@section Scripts { <script>const region=document.getElementById('RegionId'),branch=document.getElementById('BranchId');function filterBranches(){const regionId=region.value;for(const option of branch.options){option.hidden=!!regionId&&option.dataset.regionId&&option.dataset.regionId!==regionId;}if(branch.selectedOptions[0]?.hidden) branch.value='';}region.addEventListener('change',filterBranches);filterBranches();setTimeout(()=>document.querySelector('.success-toast')?.remove(),5000);</script> }
