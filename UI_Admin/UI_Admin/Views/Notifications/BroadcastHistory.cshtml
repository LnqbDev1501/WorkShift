@model UI_Admin.Models.BroadcastHistoryPageViewModel
@{
    ViewData["Title"] = "Broadcast History";
}
@section Styles { <link rel="stylesheet" href="~/css/notifications.css" asp-append-version="true" /> }

<section class="notifications-page">
    <a asp-action="Index" class="back-link">← Back to Notifications</a>
    <header class="notification-header">
        <div>
            <span class="list-eyebrow">OPERATIONS ENGINE / COMMS HUB</span>
            <h1>Broadcast History</h1>
            <p>All broadcast notifications sent by admins.</p>
        </div>
    </header>

    <partial name="_ListMetrics" model='@(new ListMetricViewModel[] {
        new("Matching broadcasts", Model.TotalCount.ToString("N0"), "Matching current filters", "notifications"),
        new("Shown", Model.Items.Count.ToString("N0"), "On this page", "view_list"),
        new("In-app", Model.Items.Count(x => x.Channels != null && x.Channels.Contains("InApp")).ToString("N0"), "On this page", "campaign"),
        new("Email", Model.Items.Count(x => x.Channels != null && x.Channels.Contains("Email")).ToString("N0"), "On this page", "mail")
    })' />


    <form method="get" class="ws-list-filter" role="search">
        <input type="hidden" name="SortBy" value="CreatedAt" />
        <div class="ws-filter-row">
            <label class="ws-filter-field ws-filter-keyword"><span class="material-symbols-outlined" aria-hidden="true">search</span><input aria-label="Search" name="Search" value="@Model.Search" placeholder="Search broadcast title or message..." /></label>
            <div class="ws-filter-field"><select aria-label="Notification type" name="Type">
                <option value="">All types</option>
                <option value="Broadcast" selected="@(Model.Type == "Broadcast")">Broadcast</option>
            </select></div>
            <div class="ws-filter-field"><select aria-label="Sort order" name="SortOrder">
                <option value="desc" selected="@(Model.SortOrder == "desc")">Newest first</option>
                <option value="asc" selected="@(Model.SortOrder == "asc")">Oldest first</option>
            </select></div>
            <details class="ws-filter-advanced">
                <summary title="Advanced filters" aria-label="Advanced filters"><span class="material-symbols-outlined" aria-hidden="true">tune</span>
                    @if (Context.Request.Query.Any(q => new[] { "DateFrom", "DateTo" }.Contains(q.Key, StringComparer.OrdinalIgnoreCase) && !string.IsNullOrWhiteSpace(q.Value.ToString()))) { <span class="ws-filter-indicator" aria-label="Advanced filters active"></span> }
                </summary>
                <div class="ws-filter-panel">
                    <label class="ws-filter-field"><span>Created from</span><input aria-label="Created from" name="DateFrom" value="@(Model.DateFrom?.ToString("yyyy-MM-dd"))" type="date" /></label>
                    <label class="ws-filter-field"><span>Created to</span><input aria-label="Created to" name="DateTo" value="@(Model.DateTo?.ToString("yyyy-MM-dd"))" type="date" /></label>
                    <button type="submit" class="ws-filter-apply">Apply filters</button>
                </div>
            </details>
            <partial name="_ListFilterActions" model='"BroadcastHistory"' />
        </div>
    </form>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage)) { <div class="notice-error">@Model.ErrorMessage</div> }

    <div class="notification-table-card">
        @if (Model.Items.Count == 0)
        {
            <div class="notification-empty">
                <span class="material-symbols-outlined">campaign</span>
                <p>No broadcast notifications match the selected filters.</p>
            </div>
        }
        else
        {
            <div class="table-scroll"><table class="notification-table"><thead><tr><th>Title</th><th>Type</th><th>Channels</th><th>Sent</th><th>Your Status</th><th>Actions</th></tr></thead><tbody>
                @foreach (var item in Model.Items)
                {
                    <tr class="@(item.IsRead ? "read" : "unread") notification-row" data-url="@Url.Action("BroadcastDetail", new { id = item.NotificationId })">
                        <td><div class="title-cell"><span class="title-icon">📢</span><div><strong>@item.Title</strong><span class="subline">Broadcast #@item.NotificationId</span></div></div></td>
                        <td><span class="type-pill">@item.NotificationType</span></td>
                        <td><div class="channel-list">@foreach (var channel in item.Channels ?? Enumerable.Empty<string>()) { <span>@(channel == "InApp" ? "▣ In-App" : "✉ Email")</span> }</div></td>
                        <td>@item.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                        <td>
                            <span class="status-pill @(item.IsRead ? "read" : "unread")">
                                @(item.IsRead ? "Read" : "Unread")
                                @if (item.ReadAt.HasValue)
                                {
                                    <span class="read-time">@item.ReadAt.Value.ToLocalTime().ToString("dd MMM HH:mm")</span>
                                }
                            </span>
                        </td>
                        <td><a asp-action="BroadcastDetail" asp-route-id="@item.NotificationId" class="ws-icon-action" title="View broadcast details" aria-label="View broadcast details"><span class="material-symbols-outlined" aria-hidden="true">visibility</span></a></td>
                    </tr>
                }
            </tbody></table></div>
            <partial name="_ListPagination" model="@(new ListPaginationViewModel
            {
                PageNumber = Model.Page,
                PageSize = Model.PageSize,
                TotalItems = Model.TotalCount,
                ItemLabel = "broadcasts"
            })" />
        }
    </div>
</section>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('.notification-row[data-url]').forEach(function (row) {
                row.style.cursor = 'pointer';
                row.addEventListener('click', function (e) {
                    if (e.target.closest('a, button, form, input, select')) return;
                    window.location.href = this.dataset.url;
                });
            });
        });
    </script>
}
