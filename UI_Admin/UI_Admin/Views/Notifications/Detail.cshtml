@model UI_Admin.Models.NotificationDetailViewModel
@{ ViewData["Title"] = "Notification Detail"; }
@section Styles { <link rel="stylesheet" href="~/css/notifications.css" asp-append-version="true" /> }
<section class="notifications-page detail-page">
    <a asp-action="List" class="back-link">← Back to Notification List</a>
    <header class="detail-header"><div><span class="eyebrow">NOTIFICATION #@Model.NotificationId</span><h1>@Model.Title</h1><p>Created @Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm") by <strong>@Model.CreatedByName</strong></p></div><span class="type-pill">@Model.NotificationType</span></header>
    <div class="metric-grid"><div><span>Audience</span><strong>@Model.Audience</strong></div><div><span>In-App recipients</span><strong>@Model.InAppRecipientCount</strong></div><div><span>Channels</span><strong>@string.Join(" + ", Model.Channels)</strong></div><div><span>Target scope</span><strong>@(Model.TargetBranchId.HasValue ? $"Branch #{Model.TargetBranchId}" : Model.TargetRegionId.HasValue ? $"Region #{Model.TargetRegionId}" : "Organization / role")</strong></div></div>
    <article class="detail-card"><span class="eyebrow">MESSAGE BODY</span><h2>Notification payload</h2><p class="message-body">@Model.Message</p></article>
</section>
