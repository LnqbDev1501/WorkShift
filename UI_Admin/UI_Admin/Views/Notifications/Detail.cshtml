@model UI_Admin.Models.NotificationDetailViewModel
@{ ViewData["Title"] = "Notification Detail"; }
@section Styles { <link rel="stylesheet" href="~/css/notifications.css" asp-append-version="true" /> }
<section class="notifications-page detail-page">
    <a asp-action="List" class="back-link">← Back to Notification List</a>
    <header class="detail-header"><div><div class="detail-badges"><span class="type-pill">@Model.NotificationType</span><span class="scope-pill">● @Model.Audience</span></div><span class="eyebrow">NOTIFICATION #@Model.NotificationId</span><h1>@Model.Title</h1><p>◷ Created @Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm") <span class="dot">•</span> ◉ Dispatched by <strong>@Model.CreatedByName</strong></p></div></header>
    <div class="metric-grid"><div><span>Audience</span><strong>@Model.Audience</strong></div><div><span>In-App recipients</span><strong>@Model.InAppRecipientCount</strong></div><div><span>Channels</span><strong>@string.Join(" + ", Model.Channels ?? Enumerable.Empty<string>())</strong></div><div><span>Target scope</span><strong>@(Model.TargetBranchId.HasValue ? $"Branch #{Model.TargetBranchId}" : Model.TargetRegionId.HasValue ? $"Region #{Model.TargetRegionId}" : "Organization / role")</strong></div></div>
    <article class="detail-card"><div class="detail-card-heading"><span class="payload-icon">✉</span><div><span class="eyebrow">MESSAGE BODY</span><h2>Notification payload</h2></div></div><p class="message-body">@Model.Message</p></article>
</section>
