@model UI_Admin.Models.Branches.EditBranchViewModel
@inject IConfiguration Configuration

@{
    ViewData["Title"] = $"Edit {Model.BranchName} - Branch Details";
    var isBranchActive = string.Equals(Model.Status, "ACTIVE", StringComparison.OrdinalIgnoreCase);
    var branchCodeVal = !string.IsNullOrWhiteSpace(Model.BranchCode) ? Model.BranchCode : "BRANCH-CODE";
    var branchNameVal = !string.IsNullOrWhiteSpace(Model.BranchName) ? Model.BranchName : "Branch";
    var branchAddressVal = Model.Address ?? string.Empty;
    var currentRegion = Model.AvailableRegions.FirstOrDefault(r => r.RegionId == Model.RegionId);
    var regionDisplayName = currentRegion != null ? $"{currentRegion.RegionName} ({currentRegion.RegionCode})" : "Select Region";
    var coordinatesDisplay = Model.Latitude.HasValue && Model.Longitude.HasValue
        ? $"{Model.Latitude.Value:F6}° N, {Model.Longitude.Value:F6}° E"
        : "Unconfigured";
    var vietMapTileKey = Configuration["VietMap:TileMapKey"] ?? string.Empty;
}

@section Styles {
    <link rel="stylesheet" href="https://unpkg.com/@@vietmap/vietmap-gl-js@6.0.1/dist/vietmap-gl.css" />
    <link rel="stylesheet" href="~/css/branches.css" asp-append-version="true" />
}


<div class="flex flex-col w-full ws-form-page px-4 sm:px-6 py-6"><div class="max-w-5xl mx-auto w-full">
    <!-- Top Header Bar -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-unit-4 pb-unit-6">
        <div class="flex items-center gap-3">
            <a asp-controller="Branches" asp-action="Index" class="inline-flex items-center justify-center w-9 h-9 rounded-xl bg-surface-container hover:bg-surface-container-high text-on-surface transition-colors shrink-0" title="Cancel">
                <span class="material-symbols-outlined text-[20px]">close</span>
            </a>
            <div class="flex flex-col gap-unit-1">
                <div class="flex items-center gap-unit-3">
                    <h1 class="font-display-md text-on-surface tracking-tight">Edit Branch</h1>
                    @if (isBranchActive)
                    {
                        <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[11px] font-medium tracking-wide uppercase bg-[#ECFDF5] text-[#059669]">
                            <span class="w-1.5 h-1.5 rounded-full bg-[#059669]"></span>
                            Active
                        </span>
                    }
                    else
                    {
                        <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[11px] font-medium tracking-wide uppercase bg-surface-container text-secondary">
                            <span class="w-1.5 h-1.5 rounded-full bg-secondary"></span>
                            @Model.Status
                        </span>
                    }
                </div>
                <p class="font-body-md text-on-surface-variant">Update branch metadata, contact information, and physical coordinates.</p>
            </div>
        </div>
    </div>

    <!-- Locked Code Context Warning Banner -->
    <div class="mb-unit-6 p-unit-4 rounded-xl bg-[#FFFBEB] text-[#92400E] flex items-start gap-unit-3 shadow-sm border border-amber-200">
        <span class="material-symbols-outlined text-[#D97706] text-[20px] shrink-0 mt-0.5" style="font-variation-settings: 'FILL' 1;">lock</span>
        <div class="flex flex-col sm:flex-row sm:items-center justify-between w-full gap-unit-2">
            <div class="text-body-sm leading-relaxed">
                <span class="font-body-md-medium text-[#78350F]">Notice:</span>
                <span>Branch code cannot be changed after creation. Changes to branch information take effect across active schedules.</span>
            </div>
        </div>
    </div>

    <partial name="_NotificationModal" />


    <!-- Main Grid: 2-Column Bento Layout (Form left 8 cols, Operational Telemetry right 4 cols) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-unit-6 items-start">
        <!-- Primary Form Column -->
        <form method="post" asp-controller="Branches" asp-action="Edit" asp-route-id="@Model.BranchId" class="lg:col-span-8 flex flex-col gap-unit-6" id="branch-edit-form">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="BranchId" />
            <input type="hidden" asp-for="BranchCode" />
            <input type="hidden" asp-for="Status" />
            <input type="hidden" asp-for="EmployeeCount" />

            <!-- Section 1: Branch Information -->
            <section class="p-unit-6 rounded-xl bg-surface-container-lowest shadow-sm flex flex-col gap-unit-5 border border-surface-container-high">
                <div class="flex items-center justify-between pb-unit-3 border-b border-surface-container-high">
                    <div class="flex items-center gap-unit-3">
                        <span class="w-7 h-7 rounded-lg bg-primary-fixed flex items-center justify-center text-primary font-bold text-[13px]">01</span>
                        <div>
                            <h2 class="font-title-md text-on-surface">Branch Information</h2>
                            <p class="font-body-sm text-on-surface-variant">Core administrative parameters and organizational division</p>
                        </div>
                    </div>
                    <span class="material-symbols-outlined text-outline-variant">domain</span>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-unit-5 pt-unit-2">
                    <!-- Branch Code (Read-Only) -->
                    <div class="flex flex-col gap-unit-2">
                        <div class="flex items-center justify-between">
                            <label class="font-label-md text-on-surface flex items-center gap-unit-1" for="branch-code">
                                <span>Branch Code</span>
                                <span class="text-error">*</span>
                            </label>
                            <span class="inline-flex items-center gap-1 font-label-sm text-on-surface-variant">
                                <span class="material-symbols-outlined text-[13px]">lock</span>
                                Locked
                            </span>
                        </div>
                        <div class="relative flex items-center">
                            <input class="h-input-height w-full px-unit-3 pl-unit-10 rounded-lg bg-surface-container-low text-secondary font-code-num text-body-md cursor-not-allowed select-none border border-surface-container-high"
                                   id="branch-code"
                                   type="text"
                                   value="@Model.BranchCode"
                                   readonly />
                            <span class="material-symbols-outlined absolute left-unit-3 text-[18px] text-outline">lock</span>
                        </div>
                        <p class="font-body-sm text-on-surface-variant flex items-center gap-1">
                            <span class="material-symbols-outlined text-[14px] text-secondary">info</span>
                            Branch code cannot be changed after creation.
                        </p>
                    </div>

                    <!-- Branch Name (Editable) -->
                    <div class="flex flex-col gap-unit-2">
                        <div class="flex items-center justify-between">
                            <label class="font-label-md text-on-surface flex items-center gap-unit-1" asp-for="BranchName">
                                <span>Branch Name</span>
                                <span class="text-error">*</span>
                            </label>
                            <span class="font-label-sm text-outline-variant" id="char-counter">@(Model.BranchName?.Length ?? 0) / 150</span>
                        </div>
                        <div class="relative flex items-center">
                            <input asp-for="BranchName"
                                   class="h-input-height w-full px-unit-3 rounded-lg bg-surface-container-lowest text-on-surface font-body-md shadow-sm border border-surface-container-high focus:outline-none focus:border-primary-container focus:ring-1 focus:ring-primary-container transition-all"
                                   id="branch-name"
                                   maxlength="150"
                                   required />
                        </div>
                        <span asp-validation-for="BranchName" class="text-error text-body-sm"></span>
                        <p class="font-body-sm text-on-surface-variant">Display label used in shift schedules and employee check-ins.</p>
                    </div>

                    <!-- Region Selection -->
                    <div class="md:col-span-2 flex flex-col gap-unit-2">
                        <div class="flex items-center justify-between">
                            <label class="font-label-md text-on-surface flex items-center gap-unit-1" asp-for="RegionId">
                                <span>Region</span>
                                <span class="text-error">*</span>
                            </label>
                            <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[11px] font-medium bg-[#ECFDF5] text-[#059669]">
                                <span class="w-1.5 h-1.5 rounded-full bg-[#059669]"></span>
                                Active
                            </span>
                        </div>
                        <div class="relative flex items-center">
                            <select asp-for="RegionId"
                                    class="h-input-height w-full px-unit-3 pr-unit-10 rounded-lg bg-surface-container-lowest text-on-surface font-body-md shadow-sm border border-surface-container-high focus:outline-none focus:border-primary-container focus:ring-1 focus:ring-primary-container appearance-none cursor-pointer"
                                    id="branch-region"
                                    required>
                                @foreach (var reg in Model.AvailableRegions)
                                {
                                    <option value="@reg.RegionId" data-region-name="@reg.RegionName" selected="@(reg.RegionId == Model.RegionId)">@reg.RegionName (@reg.RegionCode)</option>
                                }
                            </select>
                            <span class="material-symbols-outlined absolute right-unit-3 text-[18px] text-on-surface-variant pointer-events-none">expand_more</span>
                        </div>
                        <span asp-validation-for="RegionId" class="text-error text-body-sm"></span>
                        <p class="font-body-sm text-on-surface-variant">Select an active operational region. Inactive regions are not permitted.</p>
                    </div>
                </div>
            </section>

            <!-- Section 2: Location & Coordinates -->
            <section class="p-unit-6 rounded-xl bg-surface-container-lowest shadow-sm flex flex-col gap-unit-5 border border-surface-container-high">
                <div class="flex items-center justify-between pb-unit-3 border-b border-surface-container-high">
                    <div class="flex items-center gap-unit-3">
                        <span class="w-7 h-7 rounded-lg bg-primary-fixed flex items-center justify-center text-primary font-bold text-[13px]">02</span>
                        <div>
                            <h2 class="font-title-md text-on-surface">Location &amp; Physical Geofence</h2>
                            <p class="font-body-sm text-on-surface-variant">Address records and GPS boundaries for shift check-in radius verification</p>
                        </div>
                    </div>
                    <span class="material-symbols-outlined text-outline-variant">location_on</span>
                </div>

                <div class="flex flex-col gap-unit-5 pt-unit-2">
                    <!-- VietMap Search Location (Autocomplete) -->
                    <div class="flex flex-col gap-unit-2 relative z-20" id="search-location-container">
                        <div class="flex items-center justify-between">
                            <label class="font-label-md text-on-surface flex items-center gap-unit-1" for="searchLocationInput">
                                <span>Search Location</span>
                                <span class="text-primary-container text-[11px] font-normal">(VIETMAP Autocomplete)</span>
                            </label>
                            <span class="font-label-sm text-on-surface-variant">Search place, address, or coordinates (Lat, Lng)</span>
                        </div>
                        <div class="relative flex items-center">
                            <input class="h-input-height w-full px-unit-3 pl-unit-10 pr-unit-10 rounded-lg bg-surface-container-lowest text-on-surface font-body-md shadow-sm border border-surface-container-high focus:outline-none focus:border-primary-container focus:ring-1 focus:ring-primary-container transition-all"
                                   id="searchLocationInput"
                                   type="text"
                                   placeholder="Type place or coordinates (e.g. 10.0376, 105.8307)..."
                                   autocomplete="off" />
                            <span class="material-symbols-outlined absolute left-unit-3 text-[18px] text-outline">search</span>
                            <button type="button" id="clearSearchBtn" class="hidden absolute right-unit-3 text-outline-variant hover:text-on-surface text-[18px] cursor-pointer">
                                <span class="material-symbols-outlined text-[18px]">close</span>
                            </button>
                        </div>
                        <div id="searchResultsDropdown"
                             class="hidden absolute left-0 right-0 top-full mt-1 bg-surface-container-lowest rounded-xl shadow-xl border border-surface-container-high z-50 max-h-60 overflow-y-auto divide-y divide-surface-container-high">
                        </div>
                    </div>

                    <!-- Physical Address Textarea -->
                    <div class="flex flex-col gap-unit-2">
                        <div class="flex items-center justify-between">
                            <label class="font-label-md text-on-surface flex items-center gap-unit-1" asp-for="Address">
                                <span>Address</span>
                                <span class="text-error">*</span>
                            </label>
                            <span class="font-label-sm text-outline-variant" id="address-char-counter">@(Model.Address?.Length ?? 0) / 500</span>
                        </div>
                        <textarea asp-for="Address"
                                  class="w-full p-unit-3 rounded-lg bg-surface-container-lowest text-on-surface font-body-md shadow-sm border border-surface-container-high focus:outline-none focus:border-primary-container focus:ring-1 focus:ring-primary-container resize-none transition-all leading-relaxed"
                                  id="branch-address"
                                  maxlength="500"
                                  rows="2"
                                  required></textarea>
                        <span asp-validation-for="Address" class="text-error text-body-sm"></span>
                        <p class="font-body-sm text-on-surface-variant">Physical address including building, street, district, and city.</p>
                    </div>

                    <!-- Latitude & Longitude Sub-grid -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-unit-5">
                        <!-- Latitude -->
                        <div class="flex flex-col gap-unit-2">
                            <div class="flex items-center justify-between">
                                <label class="font-label-md text-on-surface flex items-center gap-unit-1" asp-for="Latitude">
                                    <span>Latitude</span>
                                    <span class="text-on-surface-variant text-[11px] font-normal">(Optional)</span>
                                </label>
                                <span class="font-label-sm text-on-surface-variant">WGS 84</span>
                            </div>
                            <div class="relative flex items-center">
                                <input asp-for="Latitude"
                                       class="h-input-height w-full px-unit-3 pl-unit-10 rounded-lg bg-surface-container-lowest text-on-surface font-code-num text-body-md shadow-sm border border-surface-container-high focus:outline-none focus:border-primary-container focus:ring-1 focus:ring-primary-container transition-all"
                                       id="branch-latitude"
                                       max="90"
                                       min="-90"
                                       step="0.000001"
                                       type="number" />
                                <span class="material-symbols-outlined absolute left-unit-3 text-[18px] text-outline">explore</span>
                            </div>
                            <span asp-validation-for="Latitude" class="text-error text-body-sm"></span>
                            <p class="font-body-sm text-on-surface-variant">Valid range -90 to 90</p>
                        </div>

                        <!-- Longitude -->
                        <div class="flex flex-col gap-unit-2">
                            <div class="flex items-center justify-between">
                                <label class="font-label-md text-on-surface flex items-center gap-unit-1" asp-for="Longitude">
                                    <span>Longitude</span>
                                    <span class="text-on-surface-variant text-[11px] font-normal">(Optional)</span>
                                </label>
                                <span class="font-label-sm text-on-surface-variant">WGS 84</span>
                            </div>
                            <div class="relative flex items-center">
                                <input asp-for="Longitude"
                                       class="h-input-height w-full px-unit-3 pl-unit-10 rounded-lg bg-surface-container-lowest text-on-surface font-code-num text-body-md shadow-sm border border-surface-container-high focus:outline-none focus:border-primary-container focus:ring-1 focus:ring-primary-container transition-all"
                                       id="branch-longitude"
                                       max="180"
                                       min="-180"
                                       step="0.000001"
                                       type="number" />
                                <span class="material-symbols-outlined absolute left-unit-3 text-[18px] text-outline">explore</span>
                            </div>
                            <span asp-validation-for="Longitude" class="text-error text-body-sm"></span>
                            <p class="font-body-sm text-on-surface-variant">Valid range -180 to 180</p>
                        </div>
                    </div>

                    <!-- Map Section -->
                    <div class="flex flex-col gap-unit-2 pt-unit-2">
                        <label class="font-label-md text-on-surface flex items-center justify-between">
                            <span>Branch Location Map</span>
                            <span class="text-on-surface-variant text-[11px] font-normal">VIETMAP GL JS</span>
                        </label>
                        <div id="branchMap"></div>
                    </div>
                </div>
            </section>

            <!-- Section 3: Contact Channels -->
            <section class="p-unit-6 rounded-xl bg-surface-container-lowest shadow-sm flex flex-col gap-unit-5 border border-surface-container-high">
                <div class="flex items-center justify-between pb-unit-3 border-b border-surface-container-high">
                    <div class="flex items-center gap-unit-3">
                        <span class="w-7 h-7 rounded-lg bg-primary-fixed flex items-center justify-center text-primary font-bold text-[13px]">03</span>
                        <div>
                            <h2 class="font-title-md text-on-surface">Contact Channels</h2>
                            <p class="font-body-sm text-on-surface-variant">Direct site supervisor communications and operational alert routing</p>
                        </div>
                    </div>
                    <span class="material-symbols-outlined text-outline-variant">contact_phone</span>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-unit-5 pt-unit-2">
                    <!-- Telephone Input -->
                    <div class="flex flex-col gap-unit-2">
                        <div class="flex items-center justify-between">
                            <label class="font-label-md text-on-surface flex items-center gap-unit-1" asp-for="Phone">
                                <span>Phone Number</span>
                                <span class="text-on-surface-variant text-[11px] font-normal">(Optional)</span>
                            </label>
                            <span class="font-label-sm text-on-surface-variant">Max 20 chars</span>
                        </div>
                        <div class="relative flex items-center">
                            <input asp-for="Phone"
                                   class="h-input-height w-full px-unit-3 pl-unit-10 rounded-lg bg-surface-container-lowest text-on-surface font-body-md shadow-sm border border-surface-container-high focus:outline-none focus:border-primary-container focus:ring-1 focus:ring-primary-container transition-all"
                                   id="branch-phone"
                                   maxlength="20"
                                   type="tel" />
                            <span class="material-symbols-outlined absolute left-unit-3 text-[18px] text-outline">call</span>
                        </div>
                        <span asp-validation-for="Phone" class="text-error text-body-sm"></span>
                        <p class="font-body-sm text-on-surface-variant">Landline or dedicated facility on-duty desk line.</p>
                    </div>

                    <!-- Email Input -->
                    <div class="flex flex-col gap-unit-2">
                        <div class="flex items-center justify-between">
                            <label class="font-label-md text-on-surface flex items-center gap-unit-1" asp-for="Email">
                                <span>Email</span>
                                <span class="text-on-surface-variant text-[11px] font-normal">(Optional)</span>
                            </label>
                        </div>
                        <div class="relative flex items-center">
                            <input asp-for="Email"
                                   class="h-input-height w-full px-unit-3 pl-unit-10 rounded-lg bg-surface-container-lowest text-on-surface font-body-md shadow-sm border border-surface-container-high focus:outline-none focus:border-primary-container focus:ring-1 focus:ring-primary-container transition-all"
                                   id="branch-email"
                                   type="email" />
                            <span class="material-symbols-outlined absolute left-unit-3 text-[18px] text-outline">mail</span>
                        </div>
                        <span asp-validation-for="Email" class="text-error text-body-sm"></span>
                        <p class="font-body-sm text-on-surface-variant">Operational communication and contact email.</p>
                    </div>
                </div>
            </section>

            <!-- Bottom Action Bar (Fixed Enterprise Workflow) -->
            <div class="p-unit-5 rounded-xl bg-surface-container-lowest shadow-sm flex flex-col sm:flex-row items-center justify-between gap-unit-4 border border-surface-container-high">
                <!-- Destructive / Lifecycle Tertiary Trigger -->
                @if (isBranchActive)
                {
                    <button class="w-full sm:w-auto inline-flex items-center justify-center gap-unit-2 px-unit-4 h-input-height rounded-lg text-error hover:bg-error-container/40 transition-colors font-body-md-medium cursor-pointer"
                            id="btn-deactivate-branch"
                            type="button">
                        <span class="material-symbols-outlined text-[18px]">power_settings_new</span>
                        <span>Deactivate Branch</span>
                    </button>
                }
                else
                {
                    <div class="w-full sm:w-auto text-secondary text-body-sm">Branch status: @Model.Status</div>
                }

                <!-- Cancel & Save Controls -->
                <div class="w-full sm:w-auto flex items-center justify-end gap-unit-3">
                    <a asp-controller="Branches" asp-action="Details" asp-route-id="@Model.BranchId"
                       class="w-full sm:w-auto inline-flex items-center justify-center px-unit-5 h-input-height rounded-lg bg-surface-container hover:bg-surface-container-high text-on-surface font-body-md-medium transition-colors"
                       id="btn-cancel">
                        Cancel
                    </a>
                    <button class="w-full sm:w-auto inline-flex items-center justify-center gap-unit-2 px-unit-6 h-input-height rounded-lg bg-[#4F46E5] hover:bg-[#4338CA] text-white font-body-md-medium shadow-md transition-all active:scale-[0.98] cursor-pointer"
                            id="btn-save-changes"
                            type="submit">
                        <span class="material-symbols-outlined text-[18px]">save</span>
                        <span>Save Changes</span>
                    </button>
                </div>
            </div>
        </form>

        <!-- Sidebar Column: Operational Telemetry & Lifecycle Context Box -->
        <div class="lg:col-span-4 flex flex-col gap-unit-6">
            <!-- Card 1: Branch Snapshot -->
            <div class="bg-surface-container-lowest rounded-xl p-unit-5 shadow-sm border border-surface-container-high flex flex-col gap-unit-4">
                <div class="flex items-center justify-between border-b border-surface-container-high pb-unit-3">
                    <div class="flex items-center gap-unit-2">
                        <span class="material-symbols-outlined text-primary-container text-[20px]">info</span>
                        <h3 class="font-title-md text-on-surface text-[15px]">Branch Snapshot</h3>
                    </div>
                    <span class="font-code-num text-[11px] text-on-surface-variant font-medium">@Model.BranchCode</span>
                </div>
                <div class="flex flex-col gap-unit-3 font-body-sm text-[13px]">
                    <div class="flex items-center justify-between py-1 border-b border-surface-container-high/60">
                        <span class="text-on-surface-variant">Status</span>
                        @if (isBranchActive)
                        {
                            <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[11px] font-semibold uppercase bg-[#ECFDF5] text-[#059669]">
                                <span class="w-1.5 h-1.5 rounded-full bg-[#059669]"></span>
                                Active
                            </span>
                        }
                        else
                        {
                            <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[11px] font-semibold uppercase bg-surface-container text-secondary">
                                <span class="w-1.5 h-1.5 rounded-full bg-secondary"></span>
                                @Model.Status
                            </span>
                        }
                    </div>
                    <div class="flex items-center justify-between py-1 border-b border-surface-container-high/60">
                        <span class="text-on-surface-variant">Region</span>
                        <span class="font-semibold text-on-surface text-right truncate max-w-[200px]" id="sidebar-region-display">@regionDisplayName</span>
                    </div>
                    <div class="flex items-center justify-between py-1">
                        <span class="text-on-surface-variant">Employees</span>
                        <span class="font-semibold text-on-surface">@Model.EmployeeCount</span>
                    </div>
            </div>
        </div>
    </div>

    <!-- Deactivation Confirmation Modal Overlay (Submits to UI Controller Deactivate action) -->
    <div class="fixed inset-0 z-50 bg-[#111827]/50 backdrop-blur-sm hidden items-center justify-center p-unit-4 transition-opacity" id="deactivate-modal">
        <div class="bg-surface-container-lowest rounded-xl max-w-md w-full p-unit-6 shadow-2xl flex flex-col gap-unit-4 border border-surface-container-high">
            <div class="flex items-center gap-unit-3 text-error">
                <div class="w-10 h-10 rounded-full bg-error-container flex items-center justify-center shrink-0">
                    <span class="material-symbols-outlined text-[22px]">warning</span>
                </div>
                <div>
                    <h4 class="font-title-md text-on-surface">Deactivate Branch Facility?</h4>
                    <span class="font-label-sm text-error uppercase tracking-wider">Critical Operational Action</span>
                </div>
            </div>
            <p class="font-body-md text-on-surface-variant leading-relaxed">
                Deactivating <strong class="text-on-surface">@Model.BranchName (@Model.BranchCode)</strong> will prevent new shifts from being scheduled and invalidate clock-ins.
                @if (Model.EmployeeCount > 0)
                {
                    <span>@Model.EmployeeCount assigned personnel will need reassignment.</span>
                }
            </p>
            <div class="flex items-center justify-end gap-unit-3 pt-unit-2">
                <button class="px-unit-4 h-input-height rounded-lg bg-surface-container hover:bg-surface-container-high text-on-surface font-body-md-medium transition-colors cursor-pointer"
                        id="modal-cancel-btn"
                        type="button">
                    Dismiss
                </button>
                <form method="post" asp-controller="Branches" asp-action="Deactivate" asp-route-id="@Model.BranchId" class="inline">
                    @Html.AntiForgeryToken()
                    <button class="px-unit-4 h-input-height rounded-lg bg-error hover:bg-[#b91c1c] text-on-error font-body-md-medium transition-colors cursor-pointer"
                            type="submit">
                        Confirm Deactivation
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://unpkg.com/@@vietmap/vietmap-gl-js@6.0.1/dist/vietmap-gl.js"></script>
    <script>
        window.vietMapConfig = {
            tileMapKey: '@vietMapTileKey'
        };
    </script>
    <script src="~/js/branch-map.js" asp-append-version="true"></script>
    <script>
        (function initEditBranchInteractions() {
            const branchNameInput = document.getElementById('branch-name');
            const charCounter = document.getElementById('char-counter');
            const addressInput = document.getElementById('branch-address');
            const addressCharCounter = document.getElementById('address-char-counter');
            const regionSelect = document.getElementById('branch-region');
            const sidebarRegionDisplay = document.getElementById('sidebar-region-display');
            const latInput = document.getElementById('branch-latitude');
            const lngInput = document.getElementById('branch-longitude');
            const sidebarCoordsDisplay = document.getElementById('sidebar-coords-display');

            const deactivateBtn = document.getElementById('btn-deactivate-branch');
            const deactivateModal = document.getElementById('deactivate-modal');
            const modalCancelBtn = document.getElementById('modal-cancel-btn');

            // Dynamic character counters
            if (branchNameInput && charCounter) {
                branchNameInput.addEventListener('input', () => {
                    charCounter.textContent = `${branchNameInput.value.length} / 150`;
                });
            }

            if (addressInput && addressCharCounter) {
                addressInput.addEventListener('input', () => {
                    addressCharCounter.textContent = `${addressInput.value.length} / 500`;
                });
            }

            // Sync region select to sidebar preview & auto-fill map search location
            if (regionSelect) {
                regionSelect.addEventListener('change', () => {
                    const selectedOpt = regionSelect.options[regionSelect.selectedIndex];
                    const selectedText = selectedOpt?.text;
                    const regionName = selectedOpt?.getAttribute('data-region-name') || (selectedText ? selectedText.split(' (')[0].trim() : '');

                    if (sidebarRegionDisplay && selectedText) {
                        sidebarRegionDisplay.textContent = selectedText;
                    }

                    // Auto-fill VietMap search location box when region is selected
                    const searchInput = document.getElementById('searchLocationInput');
                    const clearSearchBtn = document.getElementById('clearSearchBtn');
                    if (searchInput && regionSelect.value && regionName) {
                        searchInput.value = regionName;
                        if (clearSearchBtn) clearSearchBtn.classList.remove('hidden');
                        searchInput.dispatchEvent(new Event('input', { bubbles: true }));
                    }
                });
            }

            // Modal lifecycle handling
            function toggleModal(show) {
                if (!deactivateModal) return;
                if (show) {
                    deactivateModal.classList.remove('hidden');
                    deactivateModal.classList.add('flex');
                } else {
                    deactivateModal.classList.add('hidden');
                    deactivateModal.classList.remove('flex');
                }
            }

            if (deactivateBtn) {
                deactivateBtn.addEventListener('click', () => toggleModal(true));
            }
            if (modalCancelBtn) {
                modalCancelBtn.addEventListener('click', () => toggleModal(false));
            }
        })();
    </script>
}
