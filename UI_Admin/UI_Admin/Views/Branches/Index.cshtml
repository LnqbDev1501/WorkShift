@model UI_Admin.Models.Branches.BranchListPagedViewModel

@{
    ViewData["Title"] = "Branches";
    var isFiltered = !string.IsNullOrWhiteSpace(Model.Search) || Model.RegionId.HasValue || (!string.IsNullOrEmpty(Model.Status) && !Model.Status.Equals("ALL", StringComparison.OrdinalIgnoreCase));
    var selectedRegionName = Model.RegionId.HasValue ? Model.AvailableRegions.FirstOrDefault(r => r.RegionId == Model.RegionId.Value)?.RegionName : null;
}

<div class="flex flex-col w-full gap-unit-4 px-7 py-4">

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="flex items-center justify-between p-unit-4 bg-emerald-50 border border-emerald-200 rounded-xl text-emerald-800 text-body-md font-body-md-medium shadow-sm">
            <div class="flex items-center gap-unit-3">
                <span class="material-symbols-outlined text-[20px] text-emerald-600">check_circle</span>
                <span>@Model.SuccessMessage</span>
            </div>
            <button type="button" onclick="this.parentElement.remove()" class="text-emerald-600 hover:text-emerald-900 cursor-pointer">
                <span class="material-symbols-outlined text-[18px]">close</span>
            </button>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="flex items-center justify-between p-unit-4 bg-error-container border border-error/20 rounded-xl text-on-error-container text-body-md font-body-md-medium shadow-sm">
            <div class="flex items-center gap-unit-3">
                <span class="material-symbols-outlined text-[20px] text-error">error</span>
                <span>@Model.ErrorMessage</span>
            </div>
            <button type="button" onclick="this.parentElement.remove()" class="text-on-error-container hover:opacity-75 cursor-pointer">
                <span class="material-symbols-outlined text-[18px]">close</span>
            </button>
        </div>
    }

    <!-- Top Page Header Bar & Primary Action -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-unit-4">
        <div>
            <h1 class="font-display-md text-on-surface text-2xl font-bold tracking-tight">Branches</h1>
            <p class="font-body-md text-secondary mt-0.5">Manage branch information and view assigned users across operational jurisdictions.</p>
        </div>
        <div class="flex items-center gap-unit-3">
            <a asp-controller="Branches" asp-action="Create" class="inline-flex items-center justify-center gap-unit-2 h-[40px] px-unit-4 rounded-xl bg-primary-container hover:bg-primary text-on-primary font-body-md-medium text-body-md-medium transition-colors shadow-sm focus:outline-none cursor-pointer">
                <span class="material-symbols-outlined text-[20px]">add</span>
                <span>Create Branch</span>
            </a>
        </div>
    </div>

    <!-- Operational Lifecycle Notice Banner -->
    <div class="bg-surface-container-lowest rounded-xl p-unit-4 shadow-sm flex items-start gap-unit-3 relative overflow-hidden">
        <div class="w-1.5 absolute left-0 top-0 bottom-0 bg-primary"></div>
        <div class="p-1.5 rounded-lg bg-primary-fixed text-primary shrink-0 mt-0.5">
            <span class="material-symbols-outlined text-[20px]">info</span>
        </div>
        <div class="flex-1 min-w-0 pr-4">
            <div class="font-title-md text-[14px] text-on-surface font-semibold">Operational State &amp; User Assignment Integrity</div>
            <p class="font-body-sm text-secondary mt-0.5">Deactivating a branch only changes the branch status to Inactive. User accounts and historical records are not automatically changed.</p>
        </div>
    </div>

    <!-- Table Container Card with Filter Toolbar -->
    <div class="bg-surface-container-lowest rounded-xl shadow-sm overflow-hidden flex flex-col">
        <!-- Filter Toolbar -->
        <form method="get" asp-controller="Branches" asp-action="Index" id="branch-filter-form" class="p-unit-4 bg-surface-container-lowest flex flex-col lg:flex-row lg:items-center justify-between gap-unit-3 border-b border-surface-container-high/60">
            <input type="hidden" name="page" value="1" />
            <input type="hidden" name="pageSize" value="@Model.PageSize" />

            <div class="flex flex-col sm:flex-row sm:items-center gap-unit-3 flex-1">
                <!-- Search Input -->
                <div class="relative flex-1 max-w-lg">
                    <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-secondary text-[18px]">search</span>
                    <input class="w-full h-10 pl-9 pr-4 bg-surface-container-low text-on-surface placeholder:text-secondary rounded-lg font-body-md text-[13px] focus:outline-none focus:bg-surface-container-lowest focus:ring-1 focus:ring-primary transition-all"
                           id="branch-search"
                           name="search"
                           value="@Model.Search"
                           placeholder="Search branch code, name, or address..."
                           type="text">
                </div>
                <!-- Region Dropdown Filter -->
                <div class="relative w-full sm:w-56">
                    <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-secondary text-[18px]">map</span>
                    <select class="w-full h-10 pl-9 pr-8 bg-surface-container-low text-on-surface rounded-lg font-body-md text-[13px] appearance-none focus:outline-none focus:bg-surface-container-lowest focus:ring-1 focus:ring-primary transition-all cursor-pointer"
                            id="region-filter"
                            name="regionId"
                            onchange="this.form.submit()">
                        <option value="">All Regions</option>
                        @foreach (var r in Model.AvailableRegions)
                        {
                            <option value="@r.RegionId" selected="@(Model.RegionId == r.RegionId)">@r.RegionName (@r.RegionCode)</option>
                        }
                    </select>
                    <span class="material-symbols-outlined absolute right-2.5 top-1/2 -translate-y-1/2 text-secondary pointer-events-none text-[18px]">expand_more</span>
                </div>
                <!-- Status Dropdown Filter -->
                <div class="relative w-full sm:w-44">
                    <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-secondary text-[18px]">tune</span>
                    <select class="w-full h-10 pl-9 pr-8 bg-surface-container-low text-on-surface rounded-lg font-body-md text-[13px] appearance-none focus:outline-none focus:bg-surface-container-lowest focus:ring-1 focus:ring-primary transition-all cursor-pointer"
                            id="status-filter"
                            name="status"
                            onchange="this.form.submit()">
                        <option value="ALL" selected="@(string.IsNullOrEmpty(Model.Status) || Model.Status.Equals("ALL", StringComparison.OrdinalIgnoreCase))">All Statuses</option>
                        <option value="ACTIVE" selected="@(string.Equals(Model.Status, "ACTIVE", StringComparison.OrdinalIgnoreCase))">Active</option>
                        <option value="INACTIVE" selected="@(string.Equals(Model.Status, "INACTIVE", StringComparison.OrdinalIgnoreCase))">Inactive</option>
                        <option value="CLOSED" selected="@(string.Equals(Model.Status, "CLOSED", StringComparison.OrdinalIgnoreCase))">Closed</option>
                    </select>
                    <span class="material-symbols-outlined absolute right-2.5 top-1/2 -translate-y-1/2 text-secondary pointer-events-none text-[18px]">expand_more</span>
                </div>
            </div>
            <!-- Clear Action & Stats -->
            <div class="flex items-center gap-unit-3 self-end lg:self-center">
                @if (isFiltered)
                {
                    <a asp-controller="Branches" asp-action="Index" class="inline-flex items-center gap-1 text-[13px] text-secondary hover:text-primary transition-colors cursor-pointer" id="clear-filters-btn">
                        <span class="material-symbols-outlined text-[16px]">restart_alt</span>
                        <span>Clear Filters</span>
                    </a>
                }
            </div>
        </form>

        <!-- Active Filtering Feedback Pill Bar -->
        @if (isFiltered)
        {
            <div class="px-unit-4 py-2 bg-surface-container-low flex items-center justify-between" id="filter-state-bar">
                <div class="flex items-center gap-2">
                    <span class="font-label-sm text-secondary">Active Filters:</span>
                    <span class="px-2 py-0.5 rounded bg-surface-container-lowest text-primary text-[12px] font-medium inline-flex items-center gap-1 shadow-sm" id="filter-tag">
                        Region: @(string.IsNullOrEmpty(selectedRegionName) ? "ALL" : selectedRegionName) | Status: @(string.IsNullOrEmpty(Model.Status) ? "ALL" : Model.Status)@(string.IsNullOrWhiteSpace(Model.Search) ? "" : $" | \"{Model.Search}\"")
                    </span>
                </div>
                <span class="font-label-sm text-secondary">Showing matched records below</span>
            </div>
        }

        <!-- Main Branches Table -->
        <div class="overflow-x-auto w-full">
            <table class="w-full text-left border-collapse min-w-[960px]">
                <thead>
                    <tr class="h-10 bg-surface-container-low text-secondary font-label-md text-[11px] tracking-wider uppercase">
                        <th class="px-unit-4 w-40">Branch Code</th>
                        <th class="px-unit-4">Branch Name</th>
                        <th class="px-unit-4">Region</th>
                        <th class="px-unit-4 min-w-[260px]">Address</th>
                        <th class="px-unit-4 w-36 text-right">Employees</th>
                        <th class="px-unit-4 w-32 text-center">Status</th>
                        <th class="px-unit-4 w-44 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y-0 text-on-surface font-body-md" id="branches-table-body">
                    @if (Model.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="py-12 px-4 text-center">
                                <div class="flex flex-col items-center justify-center gap-2 text-secondary">
                                    <span class="material-symbols-outlined text-[40px] text-outline-variant">store</span>
                                    <p class="font-title-md text-[15px] text-on-surface">No branches found</p>
                                    <p class="font-body-sm text-[13px]">Try adjusting your search keyword, region or status filter.</p>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @for (var i = 0; i < Model.Items.Count; i++)
                        {
                            var branch = Model.Items[i];
                            var isEven = i % 2 == 1;
                            var rowBg = isEven ? "bg-surface-container-low/30 hover:bg-surface-container-low/70" : "bg-surface-container-lowest hover:bg-surface-container-low/60";

                            <tr class="h-14 @rowBg transition-colors group">
                                <td class="px-unit-4">
                                    <div class="flex items-center gap-2">
                                        <span class="w-1.5 h-6 rounded-full bg-primary shrink-0 opacity-0 group-hover:opacity-100 transition-opacity"></span>
                                        <span class="font-code-num text-[13px] font-semibold tracking-tight text-primary px-2 py-1 bg-primary-fixed rounded">@branch.BranchCode</span>
                                    </div>
                                </td>
                                <td class="px-unit-4">
                                    <div class="font-title-md text-[14px] text-on-surface font-medium truncate">@branch.BranchName</div>
                                </td>
                                <td class="px-unit-4">
                                    <span class="inline-flex items-center gap-1.5 text-[13px] text-on-surface font-body-md">
                                        <span class="material-symbols-outlined text-[16px] text-secondary">location_on</span>
                                        @branch.RegionName (@branch.RegionCode)
                                    </span>
                                </td>
                                <td class="px-unit-4">
                                    <div class="font-body-sm text-secondary line-clamp-1 text-[13px]" title="@branch.Address">
                                        @branch.Address
                                    </div>
                                </td>
                                <td class="px-unit-4 text-right">
                                    <div class="inline-flex items-center gap-1 font-code-num text-on-surface font-semibold text-[13px]">
                                        <span class="material-symbols-outlined text-[15px] text-secondary">group</span>
                                        <span>@branch.EmployeeCount employees</span>
                                    </div>
                                </td>
                                <td class="px-unit-4 text-center">
                                    @if (branch.IsActive)
                                    {
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[12px] font-medium bg-[#ECFDF5] text-[#059669]">
                                            <span class="w-1.5 h-1.5 rounded-full bg-[#059669] mr-1.5 animate-pulse"></span>
                                            Active
                                        </span>
                                    }
                                    else if (branch.IsInactive)
                                    {
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[12px] font-medium bg-[#F1F5F9] text-[#64748B]">
                                            <span class="w-1.5 h-1.5 rounded-full bg-[#64748B] mr-1.5"></span>
                                            Inactive
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[12px] font-medium bg-[#FFFBEB] text-[#D97706]">
                                            <span class="w-1.5 h-1.5 rounded-full bg-[#D97706] mr-1.5"></span>
                                            @branch.Status
                                        </span>
                                    }
                                </td>
                                <td class="px-unit-4 text-right">
                                    <div class="flex items-center justify-end gap-2">
                                        <a href="@Url.Action("Details", "Branches", new { id = branch.BranchId })" class="w-8 h-8 flex items-center justify-center text-secondary hover:text-primary hover:bg-surface-container rounded-lg transition-colors" title="View Details">
                                            <span class="material-symbols-outlined text-[18px]">visibility</span>
                                        </a>
                                        <a href="@Url.Action("Edit", "Branches", new { id = branch.BranchId })" class="w-8 h-8 flex items-center justify-center text-secondary hover:text-primary hover:bg-surface-container rounded-lg transition-colors" title="Edit">
                                            <span class="material-symbols-outlined text-[18px]">edit</span>
                                        </a>
                                        @if (branch.IsActive)
                                        {
                                            <button onclick="openDeactivateModal(@branch.BranchId, '@branch.BranchName', '@branch.BranchCode')" class="w-8 h-8 flex items-center justify-center text-secondary hover:text-error hover:bg-error-container/40 rounded-lg transition-colors cursor-pointer" title="Deactivate" type="button">
                                                <span class="material-symbols-outlined text-[18px]">block</span>
                                            </button>
                                        }
                                        else if (branch.IsInactive)
                                        {
                                            <button onclick="openRestoreModal(@branch.BranchId, '@branch.BranchName', '@branch.BranchCode')" class="w-8 h-8 flex items-center justify-center text-primary hover:bg-primary-fixed rounded-lg transition-colors cursor-pointer" title="Restore Branch" type="button">
                                                <span class="material-symbols-outlined text-[18px]">restart_alt</span>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Table Footer / Pagination -->
        <div class="px-unit-4 py-3 bg-surface-container-low/50 flex flex-col sm:flex-row items-center justify-between gap-unit-3 border-t border-surface-container-high/60">
            <div class="flex items-center gap-unit-3 font-body-sm text-secondary text-[13px]">
                <span>Showing <span class="font-semibold text-on-surface font-code-num">@Model.StartItemIndex</span> to <span class="font-semibold text-on-surface font-code-num">@Model.EndItemIndex</span> of <span class="font-semibold text-on-surface font-code-num">@Model.TotalItems</span> branches</span>
                <span class="hidden sm:inline text-outline-variant">•</span>
                <span class="hidden sm:inline">Page @Model.PageNumber of @Math.Max(1, Model.TotalPages)</span>
            </div>

            <div class="flex items-center gap-unit-2">
                @if (Model.HasPreviousPage)
                {
                    <a href="@Url.Action("Index", "Branches", new { search = Model.Search, regionId = Model.RegionId, status = Model.Status, page = Model.PageNumber - 1, pageSize = Model.PageSize })" class="w-8 h-8 flex items-center justify-center rounded-lg bg-surface-container hover:bg-surface-container-high text-on-surface transition-colors shadow-sm" title="Previous Page">
                        <span class="material-symbols-outlined text-[18px]">chevron_left</span>
                    </a>
                }
                else
                {
                    <button class="w-8 h-8 flex items-center justify-center rounded-lg bg-surface-container text-secondary opacity-50 cursor-not-allowed" disabled type="button">
                        <span class="material-symbols-outlined text-[18px]">chevron_left</span>
                    </button>
                }

                @{
                    var startPage = Math.Max(1, Model.PageNumber - 2);
                    var endPage = Math.Min(Model.TotalPages, startPage + 4);
                    if (endPage - startPage < 4 && Model.TotalPages >= 5)
                    {
                        startPage = Math.Max(1, endPage - 4);
                    }
                }

                @for (var p = startPage; p <= endPage; p++)
                {
                    if (p == Model.PageNumber)
                    {
                        <button class="w-8 h-8 flex items-center justify-center rounded-lg bg-primary-container text-on-primary font-body-md-medium text-[13px] shadow-sm" type="button">@p</button>
                    }
                    else
                    {
                        <a href="@Url.Action("Index", "Branches", new { search = Model.Search, regionId = Model.RegionId, status = Model.Status, page = p, pageSize = Model.PageSize })" class="w-8 h-8 flex items-center justify-center rounded-lg bg-surface-container-lowest hover:bg-surface-container text-on-surface font-body-md-medium text-[13px] transition-colors shadow-sm">@p</a>
                    }
                }

                @if (Model.HasNextPage)
                {
                    <a href="@Url.Action("Index", "Branches", new { search = Model.Search, regionId = Model.RegionId, status = Model.Status, page = Model.PageNumber + 1, pageSize = Model.PageSize })" class="w-8 h-8 flex items-center justify-center rounded-lg bg-surface-container hover:bg-surface-container-high text-on-surface transition-colors shadow-sm" title="Next Page">
                        <span class="material-symbols-outlined text-[18px]">chevron_right</span>
                    </a>
                }
                else
                {
                    <button class="w-8 h-8 flex items-center justify-center rounded-lg bg-surface-container-lowest hover:bg-surface-container text-secondary opacity-50 cursor-not-allowed" disabled type="button">
                        <span class="material-symbols-outlined text-[18px]">chevron_right</span>
                    </button>
                }
            </div>
        </div>
    </div>
</div>

<!-- Deactivate Confirmation Modal Overlay -->
<div class="hidden fixed inset-0 z-50 flex items-center justify-center bg-[#111827]/50 backdrop-blur-sm p-unit-4" id="deactivate-modal">
    <div class="bg-surface-container-lowest max-w-md w-full rounded-xl p-unit-6 shadow-2xl animate-in fade-in zoom-in duration-150">
        <div class="flex items-start gap-unit-3">
            <div class="p-unit-2 rounded-full bg-error-container text-error shrink-0">
                <span class="material-symbols-outlined text-[24px]">warning</span>
            </div>
            <div>
                <h3 class="font-title-lg text-on-surface" id="deactivate-title">Deactivate Branch?</h3>
                <p class="font-body-sm text-on-surface-variant mt-unit-2" id="deactivate-desc">Are you sure you want to deactivate this branch? Only the branch will become inactive. Existing employee assignments and historical records will remain intact.</p>
            </div>
        </div>
        <form method="post" asp-controller="Branches" asp-action="Deactivate" id="deactivate-form" class="mt-unit-6 flex items-center justify-end gap-unit-3">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="deactivate-branch-id" value="0" />
            <button class="h-input-height px-unit-4 bg-surface-container-low hover:bg-surface-container-high text-on-surface font-body-md-medium rounded-lg transition-colors cursor-pointer" onclick="closeDeactivateModal()" type="button">Cancel</button>
            <button class="h-input-height px-unit-4 bg-error text-on-error hover:bg-error/90 font-body-md-medium rounded-lg transition-colors shadow-sm cursor-pointer" type="submit">Confirm Deactivation</button>
        </form>
    </div>
</div>

<!-- Restore Confirmation Modal Overlay -->
<div class="hidden fixed inset-0 z-50 flex items-center justify-center bg-[#111827]/50 backdrop-blur-sm p-unit-4" id="restore-modal">
    <div class="bg-surface-container-lowest max-w-md w-full rounded-xl p-unit-6 shadow-2xl animate-in fade-in zoom-in duration-150">
        <div class="flex items-start gap-unit-3">
            <div class="p-unit-2 rounded-full bg-primary-fixed text-primary shrink-0">
                <span class="material-symbols-outlined text-[24px]">restart_alt</span>
            </div>
            <div>
                <h3 class="font-title-lg text-on-surface" id="restore-title">Restore Branch?</h3>
                <p class="font-body-sm text-on-surface-variant mt-unit-2" id="restore-desc">Are you sure you want to restore this branch back to ACTIVE status? Its parent region must also be active.</p>
            </div>
        </div>
        <form method="post" asp-controller="Branches" asp-action="Restore" id="restore-form" class="mt-unit-6 flex items-center justify-end gap-unit-3">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="restore-branch-id" value="0" />
            <button class="h-input-height px-unit-4 bg-surface-container-low hover:bg-surface-container-high text-on-surface font-body-md-medium rounded-lg transition-colors cursor-pointer" onclick="closeRestoreModal()" type="button">Cancel</button>
            <button class="h-input-height px-unit-4 bg-primary text-on-primary hover:bg-primary-container font-body-md-medium rounded-lg transition-colors shadow-sm cursor-pointer" type="submit">Confirm Restore</button>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function openDeactivateModal(id, name, code) {
            document.getElementById('deactivate-branch-id').value = id;
            document.getElementById('deactivate-title').innerText = `Deactivate Branch ${code}?`;
            document.getElementById('deactivate-desc').innerText = `Are you sure you want to deactivate "${name}" (${code})? Only the branch will become inactive.`;
            document.getElementById('deactivate-modal').classList.remove('hidden');
        }

        function closeDeactivateModal() {
            document.getElementById('deactivate-modal').classList.add('hidden');
        }

        function openRestoreModal(id, name, code) {
            document.getElementById('restore-branch-id').value = id;
            document.getElementById('restore-title').innerText = `Restore Branch ${code}?`;
            document.getElementById('restore-desc').innerText = `Are you sure you want to restore "${name}" (${code}) back to ACTIVE status?`;
            document.getElementById('restore-modal').classList.remove('hidden');
        }

        function closeRestoreModal() {
            document.getElementById('restore-modal').classList.add('hidden');
        }
    </script>
}
