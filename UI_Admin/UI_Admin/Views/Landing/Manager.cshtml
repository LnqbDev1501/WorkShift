@{
    Layout = "_ManagerLayout";
    ViewData["Title"] = "Tổng quan chi nhánh";
}
@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}
<div class="manager-dashboard">
    <div class="dashboard-heading">
        <div><div class="eyebrow">KHÔNG GIAN MANAGER</div><h1>Tổng quan chi nhánh</h1><p>Xin chào @User.Identity?.Name. Quản lý hợp đồng và danh mục tại một nơi.</p></div>
        <a asp-controller="ManagerContracts" asp-action="Create" class="manager-primary"><span class="material-symbols-outlined" aria-hidden="true">add</span>Tạo hợp đồng</a>
    </div>
    <section class="manager-hero dashboard-card">
        <div class="manager-hero-icon"><span class="material-symbols-outlined" aria-hidden="true">contract</span></div>
        <div><div class="eyebrow">QUẢN LÝ NHÂN SỰ</div><h2>Chuẩn bị hợp đồng cho nhân viên</h2><p>Chọn nhân viên thuộc chi nhánh, nhập thời hạn và điều khoản để lưu hợp đồng nháp.</p><a asp-controller="ManagerContracts" asp-action="Create" class="manager-text-link">Mở màn hình tạo hợp đồng <span aria-hidden="true">→</span></a></div>
        <span class="manager-badge">Hợp đồng nháp · DRAFT</span>
    </section>
    <section aria-labelledby="manager-shortcuts" class="manager-shortcuts">
        <div class="manager-section-heading"><h2 id="manager-shortcuts">Truy cập nhanh</h2><span>Công cụ quản lý</span></div>
        <div class="manager-card-grid">
            <a asp-controller="ManagerContracts" asp-action="Index" class="dashboard-card manager-shortcut"><span class="material-symbols-outlined manager-tool-icon" aria-hidden="true">contract</span><h3>Quản lý hợp đồng</h3><p>Xem danh sách và quản lý hợp đồng chi nhánh.</p><span class="manager-text-link">Mở danh sách hợp đồng →</span></a>
            <a asp-controller="Categories" asp-action="Index" class="dashboard-card manager-shortcut"><span class="material-symbols-outlined manager-tool-icon" aria-hidden="true">category</span><h3>Danh mục</h3><p>Xem và quản lý các nhóm sản phẩm.</p><span class="manager-text-link">Mở danh mục →</span></a>
            <a asp-controller="Products" asp-action="Index" class="dashboard-card manager-shortcut"><span class="material-symbols-outlined manager-tool-icon" aria-hidden="true">inventory_2</span><h3>Sản phẩm</h3><p>Tra cứu và cập nhật thông tin sản phẩm.</p><span class="manager-text-link">Mở sản phẩm →</span></a>
        </div>
    </section>
</div>
