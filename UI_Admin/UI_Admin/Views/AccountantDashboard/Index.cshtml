@{
    ViewData["Title"] = "Tổng quan Kế toán (Accountant)";
}

<div class="p-6 max-w-[1440px] mx-auto space-y-6">
    <!-- Header Banner -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-white p-6 rounded-2xl border border-gray-100 shadow-sm">
        <div>
            <div class="flex items-center gap-2 mb-1.5">
                <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-100">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-600 animate-pulse"></span>
                    ACCOUNTANT WORKSPACE
                </span>
            </div>
            <h1 class="text-2xl font-bold text-gray-900 tracking-tight">Tổng quan Nghiệp vụ Kế toán</h1>
            <p class="text-sm text-gray-500 mt-0.5">Quản lý kỳ lương, tính lương và xử lý thanh toán nhân viên</p>
        </div>
        <div>
            <a asp-action="Index" class="inline-flex items-center gap-2 px-4 py-2 text-xs font-semibold text-gray-700 bg-gray-50 hover:bg-gray-100 border border-gray-200 rounded-xl transition-colors">
                <span class="material-symbols-outlined text-[16px]">refresh</span>
                Làm mới
            </a>
        </div>
    </div>

    <!-- Developer Notice Frame -->
    <div class="bg-gradient-to-br from-emerald-50 to-teal-50 p-6 rounded-2xl border border-emerald-100 text-emerald-950">
        <div class="flex items-center gap-2 font-bold text-base mb-1.5 text-emerald-900">
            <span class="material-symbols-outlined text-[22px]">developer_mode</span>
            Khuôn mẫu làm việc cho Accountant
        </div>
        <p class="text-sm text-emerald-800/80 leading-relaxed">
            Thư mục <code>Controllers/Accountant</code>, <code>Models/Accountant</code>, <code>Services/Accountant</code> đã sẵn sàng. Bạn có thể tạo thêm các Controller (ví dụ: <code>AccountantPayrollController</code>, ...) và tạo View tương ứng trong <code>Views/[TênController]/</code>.
        </p>
    </div>
</div>
