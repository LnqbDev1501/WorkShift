@model UI_Admin.Models.PayrollDocuments.PayslipVersionHistoryResponse
@using D = UI_Admin.Models.Accountant.PayrollPeriods.PeriodDisplay
@{ ViewData["Title"] = "Payslip Version History"; }
@section Styles { <link rel="stylesheet" href="~/css/payroll.css" asp-append-version="true" /> }
<div class="payroll-page"><header class="payroll-heading"><div><h1>Payslip Version History</h1><p>Period #@Model.PayrollPeriodId · Current payslip #@Model.CurrentPayslipId</p></div><a asp-action="Index" class="payroll-button">Back to payslips</a></header><section class="payroll-table-card"><div class="payroll-table-scroll"><table><thead><tr><th>VERSION</th><th>STATUS</th><th class="money">NET SALARY</th><th>REASON</th><th>PUBLISHED (UTC+7)</th><th>DETAILS</th></tr></thead><tbody>@foreach (var p in Model.Versions.OrderByDescending(p => p.VersionNo)) { <tr><td>V@(p.VersionNo) @(p.PayslipId == Model.CurrentPayslipId ? "· CURRENT" : "")</td><td>@p.Status</td><td class="money">@D.Money(p.NetSalary)</td><td>@p.CorrectionReason</td><td>@D.Time(p.PublishedAt)</td><td><a asp-action="Details" asp-route-id="@p.PayslipId" class="payroll-button">View saved version</a></td></tr> }</tbody></table></div></section></div>
