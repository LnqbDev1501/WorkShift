@model UI_Admin.Models.PayrollDocuments.PayslipDetailsResponse
@using D = UI_Admin.Models.Accountant.PayrollPeriods.PeriodDisplay
@using W = UI_Admin.Models.PayrollDocuments.PayrollDocumentDisplay
@{ var p = Model.Payslip; ViewData["Title"] = "Payslip"; }
@section Styles { <link rel="stylesheet" href="~/css/payroll.css" asp-append-version="true" /> }
<div class="payroll-page"><header class="payroll-heading"><div><div class="list-eyebrow">PAYROLL · PUBLISHED STATEMENT</div><h1>PHIẾU LƯƠNG</h1><p>@p.PeriodStart.ToString("dd/MM/yyyy") – @p.PeriodEnd.ToString("dd/MM/yyyy") · @p.PeriodCode</p></div><div class="flex gap-2 flex-wrap"><a asp-action="Index" class="payroll-button">Back to payslips</a><a asp-action="Versions" asp-route-id="@p.PayslipId" class="payroll-button">Version History</a></div></header><partial name="_PayrollWorkflowMessages" />
    <section class="bg-surface-container-lowest rounded-xl p-5 mb-5"><h2 class="font-semibold mb-4">Thông tin nhân viên</h2><dl class="grid grid-cols-1 md:grid-cols-3 gap-4"><div><dt class="text-xs text-secondary">Nhân viên</dt><dd>@p.EmployeeName</dd></div><div><dt class="text-xs text-secondary">Chi nhánh / vị trí</dt><dd>@p.BranchName · @p.EmployeePosition</dd></div><div><dt class="text-xs text-secondary">Đơn giá giờ</dt><dd>@D.Money(p.HourlyRate) / giờ</dd></div><div><dt class="text-xs text-secondary">Payslip version / status</dt><dd>V@(p.VersionNo) · @p.Status</dd></div><div><dt class="text-xs text-secondary">Published at (UTC+7)</dt><dd>@D.Time(p.PublishedAt)</dd></div><div><dt class="text-xs text-secondary">Feedback deadline (UTC+7)</dt><dd>@D.Time(p.FeedbackDeadlineAt)</dd></div></dl>
    @if (p.CorrectionReason != null) { <p class="mt-4">Lý do thay đổi: @p.CorrectionReason</p> }</section>
    @if (User.IsInRole("STAFF"))
    { <section class="bg-surface-container-lowest rounded-xl p-4 mb-5" data-feedback-deadline="@p.FeedbackDeadlineAt.ToString("O")"><p class="text-secondary mb-3">@(p.CanSubmitFeedback ? "Bạn có thể gửi phản hồi khi phát hiện sai sót trước hạn trên phiếu." : p.FeedbackBlockedReason)</p>@if (p.CanSubmitFeedback) { <a asp-controller="StaffPayrollFeedback" asp-action="Create" asp-route-id="@p.PayslipId" class="payroll-button primary" data-feedback-link>Gửi phản hồi</a> }<a asp-controller="StaffPayrollFeedback" asp-action="Index" asp-route-payslipId="@p.PayslipId" class="payroll-button">Lịch sử phản hồi</a></section> }
    <section class="payroll-table-card"><div class="payroll-table-toolbar"><strong>1. THÔNG TIN CÔNG</strong><span>Tổng giờ: @p.TotalWorkHours.ToString("0.############################") giờ</span></div><div class="payroll-table-scroll"><table><thead><tr><th>NGÀY</th><th>CA / GIỜ DỰ KIẾN</th><th>GIỜ VÀO</th><th>GIỜ RA</th><th>CÔNG ĐƯỢC TÍNH</th><th>ĐI TRỄ / VỀ SỚM</th><th>GHI CHÚ</th></tr></thead><tbody>@foreach (var w in Model.WorkDetails.OrderBy(w => w.DisplayOrder)) { <tr><td>@w.WorkDate.ToString("dd/MM/yyyy")</td><td>@w.ShiftName<small>@W.Time(w.ScheduledStartAt) – @W.Time(w.ScheduledEndAt) · Nghỉ @w.BreakMinutes phút</small></td><td>@W.Time(w.CheckInTime)</td><td>@W.Time(w.CheckOutTime)</td><td>@w.PayableMinutes phút<small>Thực tế: @w.ActualWorkingMinutes phút</small></td><td>Trễ: @w.TotalLateMinutes phút (@w.ChargeableLateMinutes tính phạt)<small>Về sớm: @w.TotalEarlyLeaveMinutes phút (@w.ChargeableEarlyLeaveMinutes tính phạt)</small></td><td>@w.AttendanceStatus<small>@w.Note</small></td></tr> }@if (Model.WorkDetails.Count == 0) { <tr><td colspan="7" class="p-5 text-secondary">Không có dòng công trên phiếu này.</td></tr> }</tbody></table></div></section>
    @foreach (var group in new[] { (Title: "2. TIỀN CÔNG", Types: new[] { "WORK" }), (Title: "3. THƯỞNG", Types: new[] { "REWARD" }), (Title: "4. CÁC KHOẢN GIẢM TRỪ", Types: new[] { "PENALTY", "ATTENDANCE_DEDUCTION", "CARRY_FORWARD_DEDUCTION" }) })
    { <section class="payroll-table-card"><div class="payroll-table-toolbar"><strong>@group.Title</strong></div><div class="payroll-table-scroll"><table><thead><tr><th>KHOẢN</th><th>NGÀY / SỐ LƯỢNG</th><th>ĐƠN GIÁ / HỆ SỐ</th><th class="money">TOÀN BỘ GIÁ TRỊ</th><th class="money">ĐÃ ÁP DỤNG VÀO LƯƠNG</th></tr></thead><tbody>
        @foreach (var d in Model.CalculationDetails.Where(d => group.Types.Contains(d.Type)).OrderBy(d => d.DisplayOrder)) { <tr><td><strong>@d.Description</strong><small>@d.Type · @d.Note</small></td><td>@d.WorkFrom?.ToString("dd/MM/yyyy") – @d.WorkTo?.ToString("dd/MM/yyyy")<small>@d.Quantity?.ToString("0.############################")</small></td><td>@if (d.Rate.HasValue) { <span>@D.Money(d.Rate.Value) × @d.Multiplier.ToString("0.############################")</span> } else { <span>—</span> }</td><td class="money">@D.Money(d.Amount)</td><td class="money">@(d.AppliedAmount.HasValue ? D.Money(d.AppliedAmount.Value) : "—")</td></tr> }
        @if (!Model.CalculationDetails.Any(d => group.Types.Contains(d.Type))) { <tr><td colspan="5" class="p-5 text-secondary">Không phát sinh.</td></tr> }
    </tbody></table></div></section> }
    <section class="bg-surface-container-lowest rounded-xl p-5"><dl class="grid grid-cols-1 md:grid-cols-2 gap-4"><div><dt>Tổng tiền công</dt><dd>@D.Money(p.WorkPay)</dd></div><div><dt>Tổng thưởng</dt><dd>@D.Money(p.TotalReward)</dd></div><div><dt>Tổng giảm trừ thực áp dụng</dt><dd>@D.Money(p.TotalDeduction)</dd></div><div><dt>Giảm trừ mới chuyển kỳ sau</dt><dd>@D.Money(p.DeferredDeductionAmount)</dd></div></dl><div class="border-t mt-5 pt-5"><strong>THỰC NHẬN</strong><p class="text-display-md font-semibold text-primary break-words">@D.Money(p.NetSalary)</p></div></section>
</div>
@section Scripts { <script src="~/js/payslip-feedback-window.js" asp-append-version="true"></script> }
