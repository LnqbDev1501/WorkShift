@{
    ViewData["Title"] = "Tổng quan chi nhánh (Manager)";
}

<div class="p-6 max-w-[1440px] mx-auto space-y-6">
    <!-- Header Banner -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-white p-6 rounded-2xl border border-gray-100 shadow-sm">
        <div>
            <div class="flex items-center gap-2 mb-1.5">
                <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-blue-50 text-blue-700 border border-blue-100">
                    <span class="w-1.5 h-1.5 rounded-full bg-blue-600 animate-pulse"></span>
                    MANAGER WORKSPACE
                </span>
            </div>
            <h1 class="text-2xl font-bold text-gray-900 tracking-tight">Tổng quan Quản lý Chi nhánh</h1>
            <p class="text-sm text-gray-500 mt-0.5">Bảng điều khiển &amp; vận hành ca làm việc chi nhánh</p>
        </div>
        <div>
            <a asp-action="Index" class="inline-flex items-center gap-2 px-4 py-2 text-xs font-semibold text-gray-700 bg-gray-50 hover:bg-gray-100 border border-gray-200 rounded-xl transition-colors">
                <span class="material-symbols-outlined text-[16px]">refresh</span>
                Làm mới
            </a>
        </div>
    </div>

    <!-- Stat Cards Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        <div class="bg-white p-5 rounded-2xl border border-gray-100 shadow-sm">
            <div class="flex items-center justify-between">
                <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Tổng nhân sự</span>
                <span class="w-9 h-9 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center">
                    <span class="material-symbols-outlined text-[20px]">group</span>
                </span>
            </div>
            <div class="my-3">
                <div class="text-3xl font-bold text-gray-900">24</div>
                <div class="text-xs text-emerald-600 font-medium mt-1">22 hợp đồng hoạt động</div>
            </div>
            <div class="text-[11px] text-gray-400 border-t border-gray-50 pt-2">Chi nhánh hiện tại</div>
        </div>

        <div class="bg-white p-5 rounded-2xl border border-gray-100 shadow-sm">
            <div class="flex items-center justify-between">
                <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Đi làm hôm nay</span>
                <span class="w-9 h-9 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center">
                    <span class="material-symbols-outlined text-[20px]">work</span>
                </span>
            </div>
            <div class="my-3">
                <div class="text-3xl font-bold text-gray-900">14</div>
                <div class="text-xs text-indigo-600 font-medium mt-1">3 ca trong ngày</div>
            </div>
            <div class="text-[11px] text-gray-400 border-t border-gray-50 pt-2">Theo lịch phân công</div>
        </div>

        <div class="bg-white p-5 rounded-2xl border border-gray-100 shadow-sm">
            <div class="flex items-center justify-between">
                <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Yêu cầu chờ duyệt</span>
                <span class="w-9 h-9 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center">
                    <span class="material-symbols-outlined text-[20px]">pending_actions</span>
                </span>
            </div>
            <div class="my-3">
                <div class="text-3xl font-bold text-amber-600">6</div>
                <div class="text-xs text-gray-500 font-medium mt-1">3 ca · 2 đổi ca · 1 nghỉ phép</div>
            </div>
            <div class="text-[11px] text-gray-400 border-t border-gray-50 pt-2">Cần xử lý sớm</div>
        </div>

        <div class="bg-white p-5 rounded-2xl border border-gray-100 shadow-sm">
            <div class="flex items-center justify-between">
                <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Tỷ lệ đúng giờ</span>
                <span class="w-9 h-9 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center">
                    <span class="material-symbols-outlined text-[20px]">verified</span>
                </span>
            </div>
            <div class="my-3">
                <div class="text-3xl font-bold text-emerald-600">92.8%</div>
                <div class="text-xs text-gray-500 font-medium mt-1">13/14 nhân viên</div>
            </div>
            <div class="text-[11px] text-gray-400 border-t border-gray-50 pt-2">Hôm nay</div>
        </div>
    </div>

    <!-- Developer Notice Frame -->
    <div class="bg-gradient-to-br from-indigo-50 to-blue-50 p-6 rounded-2xl border border-indigo-100 text-indigo-950">
        <div class="flex items-center gap-2 font-bold text-base mb-1.5 text-indigo-900">
            <span class="material-symbols-outlined text-[22px]">developer_mode</span>
            Khuôn mẫu làm việc cho Manager
        </div>
        <p class="text-sm text-indigo-800/80 leading-relaxed">
            Thư mục <code>Controllers/Manager</code>, <code>Models/Manager</code>, <code>Services/Manager</code> đã sẵn sàng. Bạn có thể tạo thêm các Controller (ví dụ: <code>ManagerStaffController</code>, <code>ManagerScheduleController</code>, ...) và tạo View tương ứng trong <code>Views/[TênController]/</code>.
        </p>
    </div>
</div>
