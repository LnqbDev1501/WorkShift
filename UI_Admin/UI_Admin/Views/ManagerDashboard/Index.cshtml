@{
    ViewData["Title"] = "Tổng quan chi nhánh (Manager)";
}

<div class="p-6 max-w-[1440px] mx-auto space-y-6">
    <!-- Header Banner -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-white p-6 rounded-2xl border border-gray-100 shadow-sm">
        <div>
            <div class="flex items-center gap-2 mb-1.5">
                <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-blue-50 text-blue-700 border border-blue-100">
                    <span class="w-1.5 h-1.5 rounded-full bg-blue-600 animate-pulse"></span>
                    MANAGER WORKSPACE
                </span>
            </div>
            <h1 class="text-2xl font-bold text-gray-900 tracking-tight">Tổng quan Quản lý Chi nhánh</h1>
            <p class="text-sm text-gray-500 mt-0.5">Bảng điều khiển &amp; vận hành ca làm việc chi nhánh</p>
        </div>
        <div class="flex flex-wrap items-center gap-2.5">
            <a asp-controller="ManagerContracts" asp-action="Create" class="inline-flex items-center gap-1.5 px-3.5 py-2 text-xs font-semibold text-white bg-blue-600 hover:bg-blue-700 rounded-xl shadow-sm transition-colors">
                <span class="material-symbols-outlined text-[16px]">add</span>
                Tạo hợp đồng
            </a>
            <a asp-controller="ManagerContracts" asp-action="Index" class="inline-flex items-center gap-1.5 px-3.5 py-2 text-xs font-semibold text-blue-700 bg-blue-50 hover:bg-blue-100 border border-blue-200 rounded-xl transition-colors">
                <span class="material-symbols-outlined text-[16px]">description</span>
                Quản lý hợp đồng
            </a>
            <a asp-action="Index" class="inline-flex items-center gap-1.5 px-3 py-2 text-xs font-semibold text-gray-700 bg-gray-50 hover:bg-gray-100 border border-gray-200 rounded-xl transition-colors">
                <span class="material-symbols-outlined text-[16px]">refresh</span>
                Làm mới
            </a>
        </div>
    </div>

    <!-- Stat Cards Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        <div class="bg-white p-5 rounded-2xl border border-gray-100 shadow-sm flex flex-col justify-between">
            <div>
                <div class="flex items-center justify-between">
                    <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Tổng nhân sự</span>
                    <span class="w-9 h-9 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center">
                        <span class="material-symbols-outlined text-[20px]">group</span>
                    </span>
                </div>
                <div class="my-3">
                    <div class="text-3xl font-bold text-gray-900">24</div>
                    <div class="text-xs text-emerald-600 font-medium mt-1">22 hợp đồng hoạt động</div>
                </div>
            </div>
            <a asp-controller="ManagerContracts" asp-action="Index" class="text-[11px] text-blue-600 hover:text-blue-800 font-medium border-t border-gray-100 pt-2.5 flex items-center justify-between group">
                <span>Quản lý hợp đồng chi nhánh</span>
                <span class="material-symbols-outlined text-[14px] group-hover:translate-x-0.5 transition-transform">arrow_forward</span>
            </a>
        </div>

        <div class="bg-white p-5 rounded-2xl border border-gray-100 shadow-sm flex flex-col justify-between">
            <div>
                <div class="flex items-center justify-between">
                    <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Đi làm hôm nay</span>
                    <span class="w-9 h-9 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center">
                        <span class="material-symbols-outlined text-[20px]">work</span>
                    </span>
                </div>
                <div class="my-3">
                    <div class="text-3xl font-bold text-gray-900">14</div>
                    <div class="text-xs text-indigo-600 font-medium mt-1">3 ca trong ngày</div>
                </div>
            </div>
            <div class="text-[11px] text-gray-400 border-t border-gray-100 pt-2.5">Theo lịch phân công</div>
        </div>

        <div class="bg-white p-5 rounded-2xl border border-gray-100 shadow-sm flex flex-col justify-between">
            <div>
                <div class="flex items-center justify-between">
                    <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Yêu cầu chờ duyệt</span>
                    <span class="w-9 h-9 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center">
                        <span class="material-symbols-outlined text-[20px]">pending_actions</span>
                    </span>
                </div>
                <div class="my-3">
                    <div class="text-3xl font-bold text-amber-600">6</div>
                    <div class="text-xs text-gray-500 font-medium mt-1">3 ca · 2 đổi ca · 1 nghỉ phép</div>
                </div>
            </div>
            <div class="text-[11px] text-gray-400 border-t border-gray-100 pt-2.5">Cần xử lý sớm</div>
        </div>

        <div class="bg-white p-5 rounded-2xl border border-gray-100 shadow-sm flex flex-col justify-between">
            <div>
                <div class="flex items-center justify-between">
                    <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Tỷ lệ đúng giờ</span>
                    <span class="w-9 h-9 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center">
                        <span class="material-symbols-outlined text-[20px]">verified</span>
                    </span>
                </div>
                <div class="my-3">
                    <div class="text-3xl font-bold text-emerald-600">92.8%</div>
                    <div class="text-xs text-gray-500 font-medium mt-1">13/14 nhân viên</div>
                </div>
            </div>
            <div class="text-[11px] text-gray-400 border-t border-gray-100 pt-2.5">Hôm nay</div>
        </div>
    </div>

    <!-- Quick Operations: Employment Contracts & Personnel -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        <!-- Contracts Card -->
        <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm hover:border-blue-100 transition-all flex flex-col justify-between">
            <div>
                <div class="flex items-center gap-3 mb-3">
                    <span class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center">
                        <span class="material-symbols-outlined text-[22px]">description</span>
                    </span>
                    <div>
                        <h2 class="text-base font-bold text-gray-900">Quản lý Hợp đồng lao động</h2>
                        <span class="text-xs text-gray-400">Employment Contracts</span>
                    </div>
                </div>
                <p class="text-xs text-gray-600 leading-relaxed mb-4">
                    Quản lý danh sách hợp đồng nhân sự chi nhánh: lập hợp đồng nháp DRAFT, xem trước PDF, gửi duyệt, theo dõi trạng thái kích hoạt, gia hạn hoặc hủy bỏ.
                </p>
            </div>
            <div class="flex items-center gap-2 pt-3 border-t border-gray-50">
                <a asp-controller="ManagerContracts" asp-action="Index" class="inline-flex items-center gap-1.5 px-3 py-2 text-xs font-semibold text-blue-700 bg-blue-50 hover:bg-blue-100 rounded-lg transition-colors">
                    <span class="material-symbols-outlined text-[16px]">list</span>
                    Danh sách hợp đồng
                </a>
                <a asp-controller="ManagerContracts" asp-action="Create" class="inline-flex items-center gap-1.5 px-3 py-2 text-xs font-semibold text-gray-700 bg-gray-50 hover:bg-gray-100 rounded-lg transition-colors">
                    <span class="material-symbols-outlined text-[16px]">add</span>
                    Tạo DRAFT
                </a>
            </div>
        </div>

        <!-- Branch Staff Card -->
        <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm hover:border-indigo-100 transition-all flex flex-col justify-between">
            <div>
                <div class="flex items-center gap-3 mb-3">
                    <span class="w-10 h-10 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center">
                        <span class="material-symbols-outlined text-[22px]">badge</span>
                    </span>
                    <div>
                        <h2 class="text-base font-bold text-gray-900">Nhân viên Chi nhánh</h2>
                        <span class="text-xs text-gray-400">Branch Personnel</span>
                    </div>
                </div>
                <p class="text-xs text-gray-600 leading-relaxed mb-4">
                    Xem danh sách nhân viên trực thuộc chi nhánh, thông tin liên hệ, chức vụ, bộ phận và tình trạng hợp đồng lao động hiện hành.
                </p>
            </div>
            <div class="flex items-center gap-2 pt-3 border-t border-gray-50">
                <a asp-controller="ManagerStaff" asp-action="Index" class="inline-flex items-center gap-1.5 px-3 py-2 text-xs font-semibold text-indigo-700 bg-indigo-50 hover:bg-indigo-100 rounded-lg transition-colors">
                    <span class="material-symbols-outlined text-[16px]">groups</span>
                    Danh sách nhân viên
                </a>
            </div>
        </div>

        <!-- Schedules Card -->
        <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm hover:border-emerald-100 transition-all flex flex-col justify-between">
            <div>
                <div class="flex items-center gap-3 mb-3">
                    <span class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center">
                        <span class="material-symbols-outlined text-[22px]">calendar_month</span>
                    </span>
                    <div>
                        <h2 class="text-base font-bold text-gray-900">Lịch làm việc tuần</h2>
                        <span class="text-xs text-gray-400">Schedules &amp; Shifts</span>
                    </div>
                </div>
                <p class="text-xs text-gray-600 leading-relaxed mb-4">
                    Theo dõi lịch trực ca tuần, phân bổ vị trí làm việc cho nhân viên và phê duyệt các yêu cầu đổi ca, đăng ký ca phát sinh.
                </p>
            </div>
            <div class="flex items-center gap-2 pt-3 border-t border-gray-50">
                <a asp-controller="ManagerSchedule" asp-action="Index" class="inline-flex items-center gap-1.5 px-3 py-2 text-xs font-semibold text-emerald-700 bg-emerald-50 hover:bg-emerald-100 rounded-lg transition-colors">
                    <span class="material-symbols-outlined text-[16px]">event</span>
                    Xem lịch làm việc
                </a>
            </div>
        </div>
    </div>
</div>
