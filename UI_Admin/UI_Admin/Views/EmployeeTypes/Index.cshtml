@model UI_Admin.Models.EmployeeTypes.EmployeeTypeListPagedViewModel
@{ ViewData["Title"] = "Employee Types"; }
<div class="flex flex-col w-full gap-unit-4 px-7 py-4">
    <partial name="_NotificationModal" />
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-unit-4">
        <div>
            <div class="list-eyebrow">Workforce Directory</div>
            <h1 class="font-display-lg text-display-lg text-on-surface tracking-tight">Employee Types</h1>
            <p class="font-body-md text-body-md text-secondary mt-1">Manage employee classifications and their availability across your workforce.</p>
        </div>
        <a asp-action="Create" class="inline-flex items-center justify-center gap-unit-2 h-[40px] px-unit-4 rounded-xl bg-primary-container hover:bg-primary text-on-primary font-body-md-medium text-body-md-medium transition-colors shadow-sm self-start">
            <span class="material-symbols-outlined text-[20px]">add</span><span>Create Employee Type</span>
        </a>
    </div>
    <partial name="_ListMetrics" model='@(new ListMetricViewModel[] {
        new("Matching Types", Model.TotalItems.ToString("N0"), "Matching current filters", "badge"),
        new("Active Types", Model.Items.Count(x => x.Status == "ACTIVE").ToString("N0"), "On this page", "check_circle"),
        new("Inactive Types", Model.Items.Count(x => x.Status == "INACTIVE").ToString("N0"), "On this page", "pause_circle"),
        new("Current Page", Model.PageNumber.ToString("N0"), $"Of {Math.Max(1, Model.TotalPages)} pages", "auto_stories")
    })' />
    <form method="get" asp-action="Index" class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-unit-3 p-unit-4 bg-surface-container-lowest rounded-xl shadow-sm">
        <input type="hidden" name="pageSize" value="@Model.PageSize" />
        <div class="flex flex-1 flex-col sm:flex-row gap-unit-3 max-w-2xl">
            <div class="relative flex-1">
                <label for="employee-type-search" class="sr-only">Search employee types</label>
                <span class="material-symbols-outlined absolute left-unit-3 top-1/2 -translate-y-1/2 text-[18px] text-secondary" aria-hidden="true">search</span>
                <input id="employee-type-search" name="search" value="@Model.Search" placeholder="Search employee type name..." type="search" class="w-full h-[40px] pl-9 pr-unit-3 bg-surface-container-lowest border border-surface-container-high rounded-xl text-on-surface font-body-md text-body-md focus:outline-none focus:ring-1 focus:ring-primary-container" />
            </div>
            <div class="relative sm:w-48">
                <label for="status-filter" class="sr-only">Status</label>
                <select id="status-filter" name="status" onchange="this.form.submit()" class="w-full h-[40px] px-unit-3 appearance-none bg-surface-container-lowest border border-surface-container-high rounded-xl text-on-surface font-body-md text-body-md focus:outline-none focus:ring-1 focus:ring-primary-container pr-8 cursor-pointer">
                    <option value="all" selected="@(Model.StatusFilter == "all")">All Statuses</option>
                    <option value="active" selected="@(Model.StatusFilter == "active")">Active</option>
                    <option value="inactive" selected="@(Model.StatusFilter == "inactive")">Inactive</option>
                </select>
                <span class="material-symbols-outlined absolute right-unit-3 top-1/2 -translate-y-1/2 pointer-events-none text-[18px] text-secondary" aria-hidden="true">expand_more</span>
            </div>
        </div>
        <partial name="_ListFilterActions" model='"Index"' />
    </form>
    <div class="bg-surface-container-lowest rounded-xl shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left">
                <thead><tr class="h-[40px] bg-surface-container-low text-secondary text-label-md font-label-md uppercase tracking-wider">
                    <th scope="col" class="px-unit-5 py-2">Employee Type</th>
                    <th scope="col" class="px-unit-4 py-2">Description</th>
                    <th scope="col" class="px-unit-4 py-2">Status</th>
                    <th scope="col" class="px-unit-5 py-2 text-right">Actions</th>
                </tr></thead>
                <tbody>
                @if (Model.Items.Count == 0)
                {
                    <tr><td colspan="4" class="px-unit-5 py-8 text-center text-secondary font-body-md">No employee types found matching your filter criteria.</td></tr>
                }
                @foreach (var item in Model.Items)
                {
                    <tr class="h-[56px] hover:bg-surface-container-low transition-colors">
                        <td class="px-unit-5 py-2 font-body-md-medium text-body-md-medium text-on-surface">@item.TypeName</td>
                        <td class="px-unit-4 py-2 font-body-md text-body-md text-secondary max-w-sm truncate" title="@item.Description">@(string.IsNullOrWhiteSpace(item.Description) ? "No description provided." : item.Description)</td>
                        <td class="px-unit-4 py-2 whitespace-nowrap"><partial name="_StatusBadge" model="item.Status" /></td>
                        <td class="px-unit-5 py-2 text-right whitespace-nowrap"><div class="inline-flex items-center justify-end gap-2">
                            <a asp-action="Details" asp-route-id="@item.EmployeeTypeId" title="View details" aria-label="View details for @item.TypeName" class="inline-flex items-center justify-center w-8 h-8 rounded-lg text-secondary hover:bg-surface-container transition-colors"><span class="material-symbols-outlined text-[19px]" aria-hidden="true">visibility</span></a>
                            <a asp-action="Edit" asp-route-id="@item.EmployeeTypeId" title="Edit employee type" aria-label="Edit @item.TypeName" class="inline-flex items-center justify-center w-8 h-8 rounded-lg text-primary hover:bg-surface-container transition-colors"><span class="material-symbols-outlined text-[19px]" aria-hidden="true">edit</span></a>
                            <button type="button" title="@(item.Status == "ACTIVE" ? "Deactivate" : "Restore")" aria-label="@(item.Status == "ACTIVE" ? "Deactivate" : "Restore") @item.TypeName" data-employee-type-action="@(item.Status == "ACTIVE" ? "deactivate" : "restore")" data-id="@item.EmployeeTypeId" data-name="@item.TypeName" class="inline-flex items-center justify-center w-8 h-8 rounded-lg @(item.Status == "ACTIVE" ? "text-error hover:bg-error-container" : "text-primary hover:bg-surface-container") transition-colors cursor-pointer">
                                <span class="material-symbols-outlined text-[19px]" aria-hidden="true">@(item.Status == "ACTIVE" ? "block" : "restore")</span>
                            </button>
                        </div></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <div class="flex flex-wrap items-center justify-between gap-unit-3 px-unit-5 py-unit-3 bg-surface-container-low text-secondary text-body-sm font-body-sm">
            <span>Showing <strong class="text-on-surface">@(Model.Items.Count == 0 ? 0 : (Model.PageNumber - 1) * Model.PageSize + 1) to @(Model.Items.Count == 0 ? 0 : (Model.PageNumber - 1) * Model.PageSize + Model.Items.Count)</strong> of <strong class="text-on-surface">@Model.TotalItems</strong> employee types</span>
            <nav aria-label="Employee type pagination" class="flex items-center gap-unit-2">
                @if (Model.PageNumber > 1)
                {
                    <a asp-action="Index" asp-route-page="@(Model.PageNumber - 1)" asp-route-pageSize="@Model.PageSize" asp-route-search="@Model.Search" asp-route-status="@Model.StatusFilter" class="inline-flex items-center gap-1 px-unit-3 py-1 rounded-lg border border-outline-variant bg-surface-container-lowest hover:bg-surface-container text-on-surface"><span class="material-symbols-outlined text-[16px]">chevron_left</span>Previous</a>
                }
                else { <button type="button" disabled class="px-unit-3 py-1 opacity-50">Previous</button> }
                <span class="px-2 py-0.5 rounded bg-primary-container text-white font-code-num text-body-sm font-semibold" aria-current="page">@Model.PageNumber</span>
                <span>of @Math.Max(1, Model.TotalPages)</span>
                @if (Model.PageNumber < Model.TotalPages)
                {
                    <a asp-action="Index" asp-route-page="@(Model.PageNumber + 1)" asp-route-pageSize="@Model.PageSize" asp-route-search="@Model.Search" asp-route-status="@Model.StatusFilter" class="inline-flex items-center gap-1 px-unit-3 py-1 rounded-lg border border-outline-variant bg-surface-container-lowest hover:bg-surface-container text-on-surface">Next<span class="material-symbols-outlined text-[16px]">chevron_right</span></a>
                }
                else { <button type="button" disabled class="px-unit-3 py-1 opacity-50">Next</button> }
            </nav>
        </div>
    </div>
    <partial name="_StatusDialogs" />
</div>
@section Scripts { <script src="~/js/employee-types.js" asp-append-version="true"></script> }
