@model UI_Admin.Models.EmployeeTypes.EmployeeTypeListPagedViewModel
@{ ViewData["Title"] = "Employee Types"; }
<div class="flex flex-col w-full gap-unit-4 px-7 py-4">
    @if (Model.IsLoaded)
    {
        <partial name="_NotificationModal" />
    }
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-unit-4">
        <div>
            <div class="list-eyebrow">Workforce Directory</div>
            <h1 class="font-display-lg text-display-lg text-on-surface tracking-tight">Employee Types</h1>
            <p class="font-body-md text-body-md text-secondary mt-1">Manage employee classifications and their availability across your workforce.</p>
        </div>
        <a asp-action="Create" class="inline-flex items-center justify-center gap-unit-2 h-[40px] px-unit-4 rounded-xl bg-primary-container hover:bg-primary text-on-primary font-body-md-medium text-body-md-medium transition-colors shadow-sm self-start">
            <span class="material-symbols-outlined text-[20px]">add</span><span>Create Employee Type</span>
        </a>
    </div>
    @if (Model.IsLoaded)
    {
        <partial name="_ListMetrics" model='@(new ListMetricViewModel[] {
        new("Matching Types", Model.TotalItems.ToString("N0"), "Matching current filters", "badge", "#0891b2"),
        new("Active Types", Model.Items.Count(x => x.Status == "ACTIVE").ToString("N0"), "On this page", "check_circle", "#10b981"),
        new("Inactive Types", Model.Items.Count(x => x.Status == "INACTIVE").ToString("N0"), "On this page", "pause_circle", "#f59e0b"),
        new("Current Page", Model.PageNumber.ToString("N0"), $"Of {Math.Max(1, Model.TotalPages)} pages", "auto_stories")
    })' />
    }
    <form method="get" asp-action="Index" class="ws-list-filter" role="search">
        <input type="hidden" name="pageSize" value="@Model.PageSize" />
        <div class="ws-filter-row">
            <label class="ws-filter-field ws-filter-keyword"><span class="material-symbols-outlined" aria-hidden="true">search</span><input aria-label="Search" id="employee-type-search" name="search" value="@Model.Search" placeholder="Search employee type name..." type="search" /></label>
            <div class="ws-filter-field"><select aria-label="Status" id="status-filter" name="status" onchange="this.form.submit()">
                        <option value="all" selected="@(Model.StatusFilter == "all")">All Statuses</option>
                        <option value="active" selected="@(Model.StatusFilter == "active")">Active</option>
                        <option value="inactive" selected="@(Model.StatusFilter == "inactive")">Inactive</option>
                    </select></div>
            <partial name="_ListFilterActions" model='"Index"' />
        </div>
    </form>
    @if (!Model.IsLoaded)
    {
        <section role="alert" class="flex flex-col items-center gap-unit-4 p-unit-6 bg-surface-container-lowest rounded-xl shadow-sm text-center">
            <span class="material-symbols-outlined text-error text-[32px]" aria-hidden="true">error_outline</span>
            <p class="font-body-md text-body-md text-on-surface">@Model.ErrorMessage</p>
            <a asp-action="Index" asp-route-search="@Model.Search" asp-route-status="@Model.StatusFilter" asp-route-page="@Model.PageNumber" asp-route-pageSize="@Model.PageSize" class="inline-flex items-center justify-center gap-unit-2 h-[40px] px-unit-4 rounded-xl bg-primary-container hover:bg-primary text-on-primary font-body-md-medium transition-colors">
                <span class="material-symbols-outlined text-[20px]" aria-hidden="true">refresh</span>Try again
            </a>
        </section>
    }
    else
    {
    <div class="bg-surface-container-lowest rounded-xl shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left">
                <thead><tr class="h-[40px] bg-surface-container-low text-secondary text-label-md font-label-md uppercase tracking-wider">
                    <th scope="col" class="px-unit-5 py-2">Employee Type</th>
                    <th scope="col" class="px-unit-4 py-2">Description</th>
                    <th scope="col" class="px-unit-4 py-2">Status</th>
                    <th scope="col" class="px-unit-5 py-2 text-right">Actions</th>
                </tr></thead>
                <tbody>
                @if (Model.Items.Count == 0)
                {
                    <tr><td colspan="4" class="px-unit-5 py-8 text-center text-secondary font-body-md">No employee types found matching your filter criteria.</td></tr>
                }
                @foreach (var item in Model.Items)
                {
                    <tr class="h-[56px] hover:bg-surface-container-low transition-colors">
                        <td class="px-unit-5 py-2 font-body-md-medium text-body-md-medium text-on-surface">@item.TypeName</td>
                        <td class="px-unit-4 py-2 font-body-md text-body-md text-secondary max-w-sm truncate" title="@item.Description">@(string.IsNullOrWhiteSpace(item.Description) ? "No description provided." : item.Description)</td>
                        <td class="px-unit-4 py-2 whitespace-nowrap"><partial name="_StatusBadge" model="item.Status" /></td>
                        <td class="px-unit-5 py-2 text-right whitespace-nowrap"><div class="inline-flex items-center justify-end gap-2">
                            <a asp-action="Details" asp-route-id="@item.EmployeeTypeId" title="View details" aria-label="View details for @item.TypeName" class="ws-icon-action inline-flex items-center justify-center w-8 h-8 rounded-lg text-secondary hover:bg-surface-container transition-colors"><span class="material-symbols-outlined text-[19px]" aria-hidden="true">visibility</span></a>
                            <a asp-action="Edit" asp-route-id="@item.EmployeeTypeId" title="Edit employee type" aria-label="Edit @item.TypeName" class="ws-icon-action inline-flex items-center justify-center w-8 h-8 rounded-lg text-primary hover:bg-surface-container transition-colors"><span class="material-symbols-outlined text-[19px]" aria-hidden="true">edit</span></a>
                            <button type="button" title="@(item.Status == "ACTIVE" ? "Deactivate" : "Restore")" aria-label="@(item.Status == "ACTIVE" ? "Deactivate" : "Restore") @item.TypeName" data-employee-type-action="@(item.Status == "ACTIVE" ? "deactivate" : "restore")" data-id="@item.EmployeeTypeId" data-confirmation-url="@Url.Action("StatusConfirmation", new { id = item.EmployeeTypeId, operation = item.Status == "ACTIVE" ? "deactivate" : "restore" })" class="ws-icon-action inline-flex items-center justify-center w-8 h-8 rounded-lg @(item.Status == "ACTIVE" ? "text-error hover:bg-error-container" : "text-primary hover:bg-surface-container") transition-colors cursor-pointer">
                                <span class="material-symbols-outlined text-[19px]" aria-hidden="true">@(item.Status == "ACTIVE" ? "block" : "restore")</span>
                            </button>
                        </div></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <partial name="_ListPagination" model="@(new ListPaginationViewModel
        {
            PageNumber = Model.PageNumber,
            PageSize = Model.PageSize,
            TotalItems = Model.TotalItems,
            ItemLabel = "employee types",
        })" />
    </div>
    <partial name="_StatusDialogs" />
    }
</div>
@section Scripts { <script src="~/js/employee-types.js" asp-append-version="true"></script> }
