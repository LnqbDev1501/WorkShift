@model UI_Admin.Models.Staff.Contract.StaffContractListViewModel
@{
    Layout = "_StaffLayout";
    ViewData["Title"] = "Hợp đồng lao động của tôi";
}

<div class="p-6 max-w-[1440px] mx-auto space-y-6">
    <!-- Header Banner -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-white p-6 rounded-2xl border border-gray-100 shadow-sm">
        <div>
            <div class="flex items-center gap-2 mb-1.5">
                <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-100">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-600 animate-pulse"></span>
                    STAFF PORTAL
                </span>
            </div>
            <h1 class="text-2xl font-bold text-gray-900 tracking-tight">Hợp đồng lao động của tôi</h1>
            <p class="text-sm text-gray-500 mt-0.5">Theo dõi hồ sơ hợp đồng, kiểm tra thông tin lương và xác nhận chấp thuận hợp đồng.</p>
        </div>
        <div class="flex items-center gap-2">
            <a asp-action="Index" class="inline-flex items-center gap-1.5 px-4 py-2 text-xs font-semibold text-gray-700 bg-gray-50 hover:bg-gray-100 border border-gray-200 rounded-xl transition-colors">
                <span class="material-symbols-outlined text-[16px]">refresh</span>
                Làm mới
            </a>
        </div>
    </div>

    <!-- Shift Registration Notice -->
    <div class="bg-gradient-to-r from-blue-50 to-indigo-50 border border-blue-200 rounded-2xl p-4 sm:p-5 flex items-start gap-3.5 text-blue-900 shadow-sm">
        <span class="material-symbols-outlined text-blue-600 text-[24px] flex-shrink-0 mt-0.5">info</span>
        <div class="space-y-1">
            <h2 class="text-sm font-bold text-blue-950">Quy định về việc Đăng ký ca làm việc</h2>
            <p class="text-xs text-blue-800 leading-relaxed">
                Nhân viên chỉ có thể đăng ký ca làm việc khi có hợp đồng lao động <strong>đã được chấp thuận</strong> và <strong>đang có hiệu lực</strong> (hoặc đã lên lịch bắt đầu hợp lệ). Hợp đồng đang ở trạng thái chờ chấp thuận (<span class="font-semibold text-amber-700">Pending Approval</span>), đã hủy hoặc chấm dứt sẽ không đủ điều kiện phân ca.
            </p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="bg-red-50 border border-red-200 rounded-2xl p-4 flex items-center gap-3 text-red-800">
            <span class="material-symbols-outlined text-red-600 text-[20px]">error</span>
            <span class="text-sm font-medium">@Model.ErrorMessage</span>
        </div>
    }

    <!-- Filter & Search Bar -->
    <div class="bg-white p-5 rounded-2xl border border-gray-100 shadow-sm">
        <form method="get" asp-action="Index" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3.5 items-end">
            <div class="lg:col-span-2">
                <label class="block text-xs font-semibold text-gray-600 mb-1.5">Tìm kiếm</label>
                <div class="relative">
                    <span class="material-symbols-outlined absolute left-3 top-2.5 text-gray-400 text-[18px]">search</span>
                    <input type="text" name="search" value="@Model.Search" placeholder="Mã hợp đồng, tên chi nhánh..."
                           class="w-full pl-9 pr-3 py-2 text-xs bg-gray-50 border border-gray-200 rounded-xl focus:bg-white focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all outline-none" />
                </div>
            </div>

            <div>
                <label class="block text-xs font-semibold text-gray-600 mb-1.5">Trạng thái</label>
                <select name="status" class="w-full px-3 py-2 text-xs bg-gray-50 border border-gray-200 rounded-xl focus:bg-white focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all outline-none">
                    <option value="">Tất cả trạng thái</option>
                    <option value="PENDING_STAFF" selected="@(Model.StatusFilter == "PENDING_STAFF")">Chờ tôi chấp thuận</option>
                    <option value="ACTIVE" selected="@(Model.StatusFilter == "ACTIVE")">Đang hiệu lực (Active)</option>
                    <option value="SCHEDULED" selected="@(Model.StatusFilter == "SCHEDULED")">Đã chấp thuận (Scheduled)</option>
                    <option value="EXPIRED" selected="@(Model.StatusFilter == "EXPIRED")">Đã hết hạn (Expired)</option>
                    <option value="CANCELLED" selected="@(Model.StatusFilter == "CANCELLED")">Đã hủy (Cancelled)</option>
                    <option value="TERMINATED" selected="@(Model.StatusFilter == "TERMINATED")">Đã chấm dứt (Terminated)</option>
                </select>
            </div>

            <div>
                <label class="block text-xs font-semibold text-gray-600 mb-1.5">Ngày bắt đầu từ</label>
                <input type="date" name="startDateFrom" value="@Model.StartDateFrom"
                       class="w-full px-3 py-2 text-xs bg-gray-50 border border-gray-200 rounded-xl focus:bg-white focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all outline-none" />
            </div>

            <div class="flex items-center gap-2">
                <button type="submit" class="flex-1 inline-flex items-center justify-center gap-1.5 px-4 py-2 text-xs font-semibold text-white bg-blue-600 hover:bg-blue-700 rounded-xl transition-colors shadow-sm">
                    <span class="material-symbols-outlined text-[16px]">filter_alt</span>
                    Lọc
                </button>
                <a asp-action="Index" class="inline-flex items-center justify-center p-2 text-gray-500 hover:text-gray-700 bg-gray-50 hover:bg-gray-100 border border-gray-200 rounded-xl transition-colors" title="Đặt lại">
                    <span class="material-symbols-outlined text-[16px]">restart_alt</span>
                </a>
            </div>
        </form>
    </div>

    <!-- Contracts List Table -->
    <div class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-gray-50/75 border-b border-gray-100 text-[11px] font-bold text-gray-500 uppercase tracking-wider">
                        <th class="py-3.5 px-5">Mã hợp đồng</th>
                        <th class="py-3.5 px-4">Chức danh &amp; Lương</th>
                        <th class="py-3.5 px-4">Chi nhánh</th>
                        <th class="py-3.5 px-4">Thời hạn</th>
                        <th class="py-3.5 px-4 text-center">Trạng thái</th>
                        <th class="py-3.5 px-5 text-right">Thao tác</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100 text-xs">
                    @if (Model.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="py-12 text-center text-gray-400">
                                <span class="material-symbols-outlined text-[36px] text-gray-300 block mb-2">description</span>
                                Không có hợp đồng lao động nào phù hợp với bộ lọc.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var c in Model.Items)
                        {
                            <tr class="hover:bg-gray-50/50 transition-colors">
                                <td class="py-4 px-5">
                                    <div class="font-bold text-gray-900">@c.ContractNumber</div>
                                    <div class="text-[11px] text-gray-400 mt-0.5">Tạo: @c.CreatedAt.ToString("dd/MM/yyyy")</div>
                                </td>
                                <td class="py-4 px-4">
                                    <div class="font-semibold text-gray-800">@c.EmployeePosition</div>
                                    <div class="text-emerald-700 font-bold mt-0.5">@c.HourlyRate.ToString("#,##0") đ<span class="text-[10px] text-gray-400 font-normal">/giờ</span></div>
                                </td>
                                <td class="py-4 px-4">
                                    <div class="font-medium text-gray-900">@c.BranchName</div>
                                    <div class="text-[11px] text-gray-400">@c.RegionName</div>
                                </td>
                                <td class="py-4 px-4">
                                    <div class="text-gray-900 font-medium">@c.StartDate.ToString("dd/MM/yyyy")</div>
                                    <div class="text-[11px] text-gray-400">
                                        @(c.EndDate.HasValue ? $"đến {c.EndDate.Value:dd/MM/yyyy}" : "Vô thời hạn")
                                    </div>
                                </td>
                                <td class="py-4 px-4 text-center">
                                    @switch (c.Status)
                                    {
                                        case "PENDING_STAFF":
                                            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-amber-50 text-amber-700 border border-amber-200">
                                                <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span>Chờ bạn chấp thuận
                                            </span>
                                            break;
                                        case "SCHEDULED":
                                            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-blue-50 text-blue-700 border border-blue-200">
                                                <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>Đã chấp thuận (Chờ hiệu lực)
                                            </span>
                                            break;
                                        case "ACTIVE":
                                            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
                                                <span class="w-1.5 h-1.5 rounded-full bg-emerald-600 animate-pulse"></span>Đang hiệu lực
                                            </span>
                                            break;
                                        case "CANCELLED":
                                            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-rose-50 text-rose-700 border border-rose-200">
                                                <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>Đã hủy
                                            </span>
                                            break;
                                        case "TERMINATED":
                                            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-slate-100 text-slate-700 border border-slate-300">
                                                <span class="w-1.5 h-1.5 rounded-full bg-slate-500"></span>Đã chấm dứt
                                            </span>
                                            break;
                                        case "EXPIRED":
                                            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-gray-100 text-gray-600 border border-gray-200">
                                                <span class="w-1.5 h-1.5 rounded-full bg-gray-400"></span>Hết hạn
                                            </span>
                                            break;
                                        default:
                                            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-gray-100 text-gray-700 border border-gray-200">
                                                @c.Status
                                            </span>
                                            break;
                                    }
                                </td>
                                <td class="py-4 px-5 text-right">
                                    <div class="inline-flex items-center gap-1.5 justify-end">
                                        <a asp-action="Details" asp-route-id="@c.ContractId"
                                           class="inline-flex items-center gap-1 px-3 py-1.5 text-xs font-semibold text-blue-700 bg-blue-50 hover:bg-blue-100 border border-blue-200 rounded-xl transition-colors">
                                            <span class="material-symbols-outlined text-[15px]">visibility</span>
                                            Chi tiết
                                        </a>
                                        @if (c.HasPdf)
                                        {
                                            <a asp-action="Pdf" asp-route-id="@c.ContractId" target="_blank"
                                               class="inline-flex items-center justify-center p-1.5 text-gray-600 hover:text-red-600 bg-gray-50 hover:bg-red-50 border border-gray-200 rounded-xl transition-colors"
                                               title="Xem tệp PDF">
                                                <span class="material-symbols-outlined text-[16px]">picture_as_pdf</span>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
