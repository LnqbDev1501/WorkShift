@model UI_Admin.Models.PayrollCalculation.CalculationViewModel
@using D = UI_Admin.Models.Accountant.PayrollPeriods.PeriodDisplay
@{
    ViewData["Title"] = $"Calculation Workspace - Period #{Model.PeriodId}";
    var periodStatus = Model.Readiness?.PeriodStatus ?? "";
    var isOpen = periodStatus == "OPEN";
    var isCalculated = periodStatus == "CALCULATED";
    var hasCalculatedPayrolls = Model.Readiness?.Employees.Any(e => e.ExistingPayrollId.HasValue) == true;
}

<div class="px-7 py-6 max-w-[1400px] mx-auto space-y-6">
    <!-- Header Title & Action Bar -->
    <div class="flex flex-col md:flex-row md:items-start justify-between gap-4">
        <div>
            <!-- Breadcrumb -->
            <div class="flex items-center gap-1.5 text-xs text-indigo-600 font-semibold uppercase tracking-wider mb-1">
                <span class="material-symbols-outlined text-sm">calculate</span>
                <span>Payroll / Calculation Workspace</span>
            </div>

            <!-- Title & Status Badge -->
            <div class="flex items-center gap-3 flex-wrap">
                <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Calculation Workspace — Period #@Model.PeriodId</h1>
                @if (isOpen)
                {
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-blue-50 text-blue-700 border border-blue-200">
                        OPEN
                    </span>
                }
                else if (isCalculated)
                {
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-sky-50 text-sky-700 border border-sky-200">
                        CALCULATED
                    </span>
                }
                else if (!string.IsNullOrEmpty(periodStatus))
                {
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-slate-100 text-slate-700 border border-slate-200">
                        @periodStatus
                    </span>
                }
            </div>

            <!-- Subtitle -->
            <p class="text-sm text-slate-500 mt-1">
                Verify employee source readiness from reviewed timesheets, holiday pay rates, and adjustments before batch calculation.
            </p>
        </div>

        <!-- Top Right Actions -->
        <div class="flex items-center gap-3 shrink-0 flex-wrap">
            <a asp-controller="AccountantPayrollPeriods" asp-action="Details" asp-route-id="@Model.PeriodId"
               class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-white hover:bg-slate-50 text-slate-700 hover:text-slate-900 border border-slate-200 text-sm font-medium transition-all shadow-sm">
                <span class="material-symbols-outlined text-lg">arrow_back</span>
                <span>Period Details</span>
            </a>

            @if (isOpen && !hasCalculatedPayrolls)
            {
                <a asp-action="Preview" asp-route-id="@Model.PeriodId"
                   class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold transition-all shadow-sm">
                    <span class="material-symbols-outlined text-base">play_arrow</span>
                    <span>Preview &amp; Calculate Period</span>
                </a>
            }

            <a asp-action="Index" asp-route-id="@Model.PeriodId"
               class="inline-flex items-center justify-center h-10 w-10 rounded-xl bg-white hover:bg-slate-50 text-slate-700 border border-slate-200 text-sm transition-all shadow-sm" title="Refresh">
                <span class="material-symbols-outlined text-lg">refresh</span>
            </a>
        </div>
    </div>

    <!-- Alert / Status Notice -->
    @if (Model.Error != null)
    {
        <div class="p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-sm flex items-center gap-3 shadow-sm">
            <span class="material-symbols-outlined text-rose-600 text-xl shrink-0">error</span>
            <span class="font-medium">@Model.Error</span>
        </div>
    }

    @if (isCalculated || hasCalculatedPayrolls)
    {
        <!-- Informational banner: CALCULATED is normal; revisions belong to correction workflow -->
        <div class="p-4 rounded-2xl bg-sky-50 border border-sky-200 text-sky-900 text-sm flex items-start justify-between gap-4 shadow-sm">
            <div class="flex items-start gap-3">
                <span class="material-symbols-outlined text-sky-600 text-xl shrink-0 mt-0.5">info</span>
                <div>
                    <strong class="font-bold">Period Payrolls Calculated</strong>
                    <p class="text-xs text-sky-800 mt-0.5">
                        Saved payrolls are recorded for this period and ready for staff preview distribution. Arbitrary whole-period recalculation is disabled; for discrepancies or source updates, please use the Correction Workflow.
                    </p>
                </div>
            </div>
            <a asp-controller="AccountantPayrollPeriods" asp-action="Details" asp-route-id="@Model.PeriodId"
               class="shrink-0 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white hover:bg-sky-100 text-sky-800 border border-sky-300 text-xs font-semibold transition-all">
                <span>Period Details</span>
                <span class="material-symbols-outlined text-sm">arrow_forward</span>
            </a>
        </div>
    }
    else if (isOpen)
    {
        var readyCount = Model.Readiness?.Employees.Count(e => e.CanCalculate) ?? 0;
        var blockedCount = Model.Readiness?.Employees.Count(e => !e.CanCalculate && e.ExistingPayrollId == null) ?? 0;
        <div class="p-4 rounded-2xl bg-indigo-50 border border-indigo-200 text-indigo-900 text-sm flex items-start justify-between gap-4 shadow-sm">
            <div class="flex items-start gap-3">
                <span class="material-symbols-outlined text-indigo-600 text-xl shrink-0 mt-0.5">verified</span>
                <div>
                    <strong class="font-bold">Period Open for Initial Calculation</strong>
                    <p class="text-xs text-indigo-800 mt-0.5">
                        Readiness status: <strong>@readyCount</strong> employee(s) ready, <strong>@blockedCount</strong> blocked by missing source data. When ready, click "Preview &amp; Calculate Period" to run the initial batch calculation.
                    </p>
                </div>
            </div>
            @if (readyCount > 0)
            {
                <a asp-action="Preview" asp-route-id="@Model.PeriodId"
                   class="shrink-0 inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold shadow-sm transition-all">
                    <span>Preview Entire Period</span>
                    <span class="material-symbols-outlined text-sm">arrow_forward</span>
                </a>
            }
        </div>
    }

    @if (Model.Batch != null)
    {
        <div class="p-4 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-900 text-sm shadow-sm">
            <div class="flex items-center gap-2 font-bold mb-1">
                <span class="material-symbols-outlined text-emerald-600 text-lg">check_circle</span>
                <span>Batch Calculation Completed</span>
            </div>
            <p class="text-xs text-emerald-800">
                @Model.Batch.Payrolls.Count payrolls saved successfully. Period status is now <strong>@Model.Batch.PeriodStatus</strong>.
            </p>
            @if (Model.Batch.FailedEmployees.Count > 0)
            {
                <div class="mt-2 text-xs text-amber-800 bg-amber-50 p-2.5 rounded-xl border border-amber-200">
                    <strong>@Model.Batch.FailedEmployees.Count employee(s) require attention:</strong>
                    <ul class="list-disc pl-5 mt-1">
                        @foreach (var e in Model.Batch.FailedEmployees)
                        {
                            <li><strong>@e.EmployeeName</strong>: @string.Join(" • ", e.BlockingReasons)</li>
                        }
                    </ul>
                </div>
            }
        </div>
    }

    <!-- Search & Filter Card (Manager Style) -->
    <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm">
        <form method="get" asp-action="Index" asp-route-id="@Model.PeriodId" class="grid grid-cols-1 md:grid-cols-12 gap-4 items-end">
            <!-- Keyword Input -->
            <div class="md:col-span-5">
                <label for="keyword" class="block text-xs font-semibold text-slate-600 uppercase tracking-wider mb-2 truncate">Search Employee</label>
                <div class="relative flex items-center">
                    <span class="material-symbols-outlined absolute left-3.5 pointer-events-none text-slate-400 text-lg">search</span>
                    <input type="text" id="keyword" name="Keyword" value="@Model.Query.Keyword" placeholder="Search by employee name or ID..."
                           class="w-full h-11 pl-10 pr-4 bg-slate-50/50 hover:bg-white focus:bg-white border border-slate-200 rounded-xl text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 transition-all box-border" />
                </div>
            </div>

            <!-- Status Filter -->
            <div class="md:col-span-3">
                <label for="status" class="block text-xs font-semibold text-slate-600 uppercase tracking-wider mb-2 truncate">Payroll Status</label>
                <select id="status" name="Status"
                        class="w-full h-11 px-3.5 bg-slate-50/50 hover:bg-white focus:bg-white border border-slate-200 rounded-xl text-sm text-slate-800 focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 transition-all cursor-pointer box-border">
                    <option value="" selected="@(string.IsNullOrEmpty(Model.Query.Status))">All Statuses</option>
                    @if (Model.Accountant)
                    {
                        <option value="NOT_CALCULATED" selected="@(Model.Query.Status == "NOT_CALCULATED")">Not Calculated</option>
                    }
                    <option value="CALCULATED" selected="@(Model.Query.Status == "CALCULATED")">CALCULATED</option>
                    <option value="SUBMITTED" selected="@(Model.Query.Status == "SUBMITTED")">SUBMITTED</option>
                    <option value="REJECTED" selected="@(Model.Query.Status == "REJECTED")">REJECTED</option>
                    <option value="APPROVED" selected="@(Model.Query.Status == "APPROVED")">APPROVED</option>
                    <option value="PAID" selected="@(Model.Query.Status == "PAID")">PAID</option>
                    <option value="REPLACED" selected="@(Model.Query.Status == "REPLACED")">REPLACED</option>
                </select>
            </div>

            <!-- Calculation State Filter -->
            <div class="md:col-span-2">
                <label for="calcState" class="block text-xs font-semibold text-slate-600 uppercase tracking-wider mb-2 truncate">Readiness</label>
                <select id="calcState" name="CalculationState"
                        class="w-full h-11 px-3.5 bg-slate-50/50 hover:bg-white focus:bg-white border border-slate-200 rounded-xl text-sm text-slate-800 focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 transition-all cursor-pointer box-border">
                    <option value="" selected="@(string.IsNullOrEmpty(Model.Query.CalculationState))">All</option>
                    <option value="READY" selected="@(Model.Query.CalculationState == "READY")">Ready</option>
                    <option value="BLOCKED" selected="@(Model.Query.CalculationState == "BLOCKED")">Blocked</option>
                </select>
            </div>

            <!-- Action Buttons -->
            <div class="md:col-span-2 flex items-center gap-2">
                <button type="submit" class="flex-1 h-11 inline-flex items-center justify-center gap-1.5 px-3 bg-indigo-600 hover:bg-indigo-700 active:bg-indigo-800 text-white rounded-xl text-sm font-semibold shadow-sm transition-all cursor-pointer box-border">
                    <span class="material-symbols-outlined text-base">filter_alt</span>
                    <span>Filter</span>
                </button>
                <a asp-action="Index" asp-route-id="@Model.PeriodId" class="h-11 w-11 shrink-0 inline-flex items-center justify-center bg-slate-100 hover:bg-slate-200 text-slate-600 hover:text-slate-900 rounded-xl text-sm transition-all box-border" title="Reset Filters">
                    <span class="material-symbols-outlined text-base">restart_alt</span>
                </a>
            </div>
        </form>
    </div>

    <!-- Employee Readiness Table Card (Manager Style) -->
    <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden">
        <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between bg-slate-50/60">
            <div class="flex items-center gap-2.5">
                <span class="material-symbols-outlined text-indigo-600 text-xl">fact_check</span>
                <h2 class="text-sm font-bold text-slate-900">Employee Calculation Readiness</h2>
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold bg-indigo-50 text-indigo-700 border border-indigo-200">
                    @Model.ReadinessTotal @(Model.ReadinessTotal == 1 ? "Employee" : "Employees")
                </span>
            </div>
            <div class="text-xs text-slate-400 font-medium hidden sm:block">
                Period Status: <strong class="text-slate-700">@(Model.Readiness?.PeriodStatus ?? "—")</strong>
            </div>
        </div>

        @if (Model.ReadinessError != null)
        {
            <div class="p-4 text-xs text-rose-700 bg-rose-50 border-b border-rose-100">
                @Model.ReadinessError
            </div>
        }

        @if (Model.Readiness?.Employees.Count is null or 0)
        {
            <div class="p-12 text-center">
                <div class="w-14 h-14 bg-slate-100 rounded-2xl flex items-center justify-center mx-auto mb-4 text-slate-400">
                    <span class="material-symbols-outlined text-3xl">group_off</span>
                </div>
                <h3 class="text-base font-bold text-slate-900">No Employees Match Filter</h3>
                <p class="text-xs text-slate-500 max-w-sm mx-auto mt-1">Try resetting the keyword or status filters above.</p>
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="border-b border-slate-150 bg-slate-50/50 text-[11px] font-bold text-slate-500 uppercase tracking-wider">
                            <th class="py-3.5 px-6">Employee</th>
                            <th class="py-3.5 px-6">Timesheet Source</th>
                            <th class="py-3.5 px-6">Current Payroll</th>
                            <th class="py-3.5 px-6">Readiness / Status</th>
                            <th class="py-3.5 px-6 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 text-sm">
                        @foreach (var e in Model.Readiness.Employees)
                        {
                            <tr class="hover:bg-slate-50/80 transition-colors">
                                <!-- Employee Info -->
                                <td class="py-4 px-6">
                                    <div class="flex items-center gap-3">
                                        <div class="w-9 h-9 rounded-xl bg-indigo-50 border border-indigo-100 flex items-center justify-center font-bold text-xs text-indigo-700 shrink-0">
                                            @(string.IsNullOrWhiteSpace(e.EmployeeName) ? "?" : e.EmployeeName.Trim()[..1])
                                        </div>
                                        <div>
                                            <div class="font-semibold text-slate-900">@e.EmployeeName</div>
                                            <div class="text-[11px] font-mono text-slate-400 mt-0.5">ID: @e.UserId</div>
                                        </div>
                                    </div>
                                </td>

                                <!-- Timesheet Source -->
                                <td class="py-4 px-6">
                                    @if (e.TimesheetId.HasValue)
                                    {
                                        <span class="inline-flex items-center gap-1 text-xs text-slate-800 font-medium bg-slate-100 px-2 py-1 rounded-lg">
                                            <span class="material-symbols-outlined text-sm text-slate-500">schedule</span>
                                            <span>Timesheet #@e.TimesheetId</span>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-xs text-slate-400">Not generated</span>
                                    }
                                </td>

                                <!-- Current Payroll -->
                                <td class="py-4 px-6">
                                    @if (e.ExistingPayrollId.HasValue)
                                    {
                                        <div class="font-semibold text-slate-900 text-xs">Payroll #@e.ExistingPayrollId</div>
                                        <div class="mt-1">
                                            @if (e.ExistingPayrollStatus == "CALCULATED")
                                            {
                                                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-bold bg-sky-50 text-sky-700 border border-sky-200">
                                                    CALCULATED
                                                </span>
                                            }
                                            else if (e.ExistingPayrollStatus == "REJECTED")
                                            {
                                                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-bold bg-rose-50 text-rose-700 border border-rose-200">
                                                    REJECTED
                                                </span>
                                            }
                                            else if (e.ExistingPayrollStatus == "APPROVED")
                                            {
                                                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                                                    APPROVED
                                                </span>
                                            }
                                            else if (e.ExistingPayrollStatus == "PAID")
                                            {
                                                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-bold bg-teal-50 text-teal-700 border border-teal-200">
                                                    PAID
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-bold bg-slate-100 text-slate-700 border border-slate-200">
                                                    @e.ExistingPayrollStatus
                                                </span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-xs text-slate-400">Not calculated</span>
                                    }
                                </td>

                                <!-- Readiness / Status (Normal state for existing payroll is NOT red!) -->
                                <td class="py-4 px-6">
                                    @if (e.ExistingPayrollId.HasValue)
                                    {
                                        <span class="inline-flex items-center gap-1 text-xs text-slate-700 font-medium">
                                            <span class="material-symbols-outlined text-sm text-emerald-600">check_circle</span>
                                            <span>Payroll recorded</span>
                                        </span>
                                    }
                                    else if (e.CanCalculate)
                                    {
                                        <span class="inline-flex items-center gap-1 text-xs text-emerald-700 font-semibold">
                                            <span class="material-symbols-outlined text-sm">check_circle</span>
                                            <span>Ready for calculation</span>
                                        </span>
                                    }
                                    else
                                    {
                                        <div class="space-y-0.5">
                                            @foreach (var reason in e.BlockingReasons)
                                            {
                                                <p class="text-rose-700 text-xs font-medium flex items-center gap-1">
                                                    <span class="material-symbols-outlined text-xs">cancel</span>
                                                    <span>@reason</span>
                                                </p>
                                            }
                                            @foreach (var warning in e.Warnings)
                                            {
                                                <p class="text-amber-700 text-xs flex items-center gap-1">
                                                    <span class="material-symbols-outlined text-xs">warning</span>
                                                    <span>@warning</span>
                                                </p>
                                            }
                                        </div>
                                    }
                                </td>

                                <!-- Actions -->
                                <td class="py-4 px-6 text-right">
                                    @if (e.ExistingPayrollId.HasValue)
                                    {
                                        <a asp-action="Details" asp-route-id="@e.ExistingPayrollId"
                                           class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold transition-all">
                                            <span class="material-symbols-outlined text-sm">visibility</span>
                                            <span>Details</span>
                                        </a>
                                    }
                                    else
                                    {
                                        <a asp-action="Preview" asp-route-id="@Model.PeriodId" asp-route-userId="@e.UserId"
                                           class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg @(e.CanCalculate ? "bg-indigo-600 hover:bg-indigo-700 text-white" : "bg-slate-100 hover:bg-slate-200 text-slate-600") text-xs font-semibold transition-all">
                                            <span class="material-symbols-outlined text-sm">@(e.CanCalculate ? "preview" : "info")</span>
                                            <span>@(e.CanCalculate ? "Preview Staff" : "View Source")</span>
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        @if (Model.ReadinessError == null && Model.Readiness != null && ViewData.ModelState.IsValid && Model.ReadinessTotal > 20)
        {
            <div class="px-6 py-4 border-t border-slate-100 bg-slate-50/50">
                <partial name="_ListPagination" model='@(new ListPaginationViewModel { PageNumber = Model.Query.Page, PageSize = 20, TotalItems = Model.ReadinessTotal, ItemLabel = "employees" })' />
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="~/js/payroll-calculation.js" asp-append-version="true"></script>
}
