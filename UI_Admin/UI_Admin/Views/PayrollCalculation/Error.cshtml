@model string
@{ ViewData["Title"] = "Payroll unavailable"; Layout = User.IsInRole("STAFF") ? "_StaffLayout" : "_AdminLayout"; }
<div class="px-7 py-4"><h1 class="text-display-lg font-display-lg">Payroll unavailable</h1><div class="bg-red-50 text-red-700 rounded-xl p-4 mt-4" role="alert">@Model</div><a asp-controller="@(User.IsInRole("STAFF") ? "StaffPayslips" : User.IsInRole("ACCOUNTANT") ? "AccountantPayrollPeriods" : "Payroll")" asp-action="@(User.IsInRole("ADMIN") ? "List" : "Index")" class="inline-block mt-4 text-primary">Back to payroll records</a></div>
