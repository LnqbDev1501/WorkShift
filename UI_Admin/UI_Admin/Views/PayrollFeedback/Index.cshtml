@model UI_Admin.Models.PayrollDocuments.FeedbackListViewModel
@using D = UI_Admin.Models.Accountant.PayrollPeriods.PeriodDisplay
@using W = UI_Admin.Models.PayrollDocuments.PayrollDocumentDisplay
@{ ViewData["Title"] = User.IsInRole("STAFF") ? "My Payroll Feedback" : "Payroll Feedback"; }
@section Styles { <link rel="stylesheet" href="~/css/payroll.css" asp-append-version="true" /> }
<div class="payroll-page"><header class="payroll-heading"><div><div class="list-eyebrow">PAYROLL · FEEDBACK</div><h1>@ViewData["Title"]</h1><p>Track submitted feedback and its correction result.</p></div></header><partial name="_PayrollWorkflowMessages" />
    @if (Model.Error != null) { <div role="alert" class="bg-red-50 text-red-700 p-4 mb-4 rounded-xl">@Model.Error</div> }
    <section class="payroll-filters"><form method="get" asp-action="Index"><div asp-validation-summary="All" class="text-red-700 w-full"></div><label class="search-field">Search<input name="Keyword" value="@Model.Query.Keyword" maxlength="200" /></label><label>Status<select name="Status"><option value="">All</option>@foreach (var s in new[] { "SUBMITTED", "APPROVED", "REJECTED" }) { <option value="@s" selected="@(Model.Query.Status == s)">@s</option> }</select></label><label>Correction<select name="CorrectionStatus"><option value="">All</option>@foreach (var s in new[] { "PENDING", "IN_PROGRESS", "COMPLETED" }) { <option value="@s" selected="@(Model.Query.CorrectionStatus == s)">@s</option> }</select></label><label>Reason<select name="ReasonCode"><option value="">All</option>@foreach (var s in W.Reasons) { <option value="@s" selected="@(Model.Query.ReasonCode == s)">@s</option> }</select></label><label>Created from<input type="date" name="CreatedFrom" value="@Model.Query.CreatedFrom?.ToString("yyyy-MM-dd")" /></label><label>Created to<input type="date" name="CreatedTo" value="@Model.Query.CreatedTo?.ToString("yyyy-MM-dd")" /></label>
    @if (User.IsInRole("ACCOUNTANT")) { <label>Staff ID<input name="UserId" value="@Model.Query.UserId" /></label> }<label>Period ID<input type="number" min="1" name="PayrollPeriodId" value="@Model.Query.PayrollPeriodId" /></label><label>Payslip ID<input type="number" min="1" name="PayslipId" value="@Model.Query.PayslipId" /></label><partial name="_ListFilterActions" model='"Index"' /></form></section>
    <section class="payroll-table-card"><div class="payroll-table-scroll"><table><thead><tr><th>EMPLOYEE / PERIOD</th><th>PAYSLIP</th><th>REASON</th><th>STATUS</th><th>CORRECTION</th><th>CREATED (UTC+7)</th><th>ACTIONS</th></tr></thead><tbody>@foreach (var f in Model.Data.Items) { <tr><td><strong>@f.EmployeeName</strong><small>@f.PeriodCode · @f.BranchName</small></td><td>#@f.PayslipId · V@(f.PayslipVersionNo)</td><td>@f.ReasonCode</td><td>@f.Status</td><td>@(f.CorrectionStatus ?? "—")</td><td>@D.Time(f.CreatedAt)</td><td><a asp-action="Details" asp-route-id="@f.FeedbackId" class="payroll-button">View Feedback</a></td></tr> }@if (Model.Data.Items.Count == 0) { <tr><td colspan="7" class="payroll-empty">No feedback matches the filters.</td></tr> }</tbody></table></div>@if (Model.Error == null && ViewData.ModelState.IsValid) { <partial name="_ListPagination" model='@(new ListPaginationViewModel { PageNumber = Model.Data.Page, PageSize = Model.Data.PageSize, TotalItems = Model.Data.TotalItems, ItemLabel = "feedback requests" })' /> }</section>
</div>
