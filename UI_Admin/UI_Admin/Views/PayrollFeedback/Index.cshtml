@model UI_Admin.Models.PayrollDocuments.FeedbackListViewModel
@using D = UI_Admin.Models.Accountant.PayrollPeriods.PeriodDisplay
@using W = UI_Admin.Models.PayrollDocuments.PayrollDocumentDisplay
@{
    ViewData["Title"] = User.IsInRole("STAFF") ? "My Payroll Feedback" : "Payroll Feedback";
}

<div class="px-7 py-6 max-w-[1400px] mx-auto space-y-6">
    <!-- Header Title & Action Bar -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-1.5 text-xs text-indigo-600 font-semibold uppercase tracking-wider mb-1">
                <span class="material-symbols-outlined text-sm">mark_email_read</span>
                <span>Payroll / Staff Feedback</span>
            </div>
            <h1 class="text-2xl font-bold text-slate-900 tracking-tight">@ViewData["Title"]</h1>
            <p class="text-sm text-slate-500 mt-0.5">Track employee feedback requests, review submissions, and manage resolution workflows.</p>
        </div>
        <div class="flex items-center gap-3">
            <a asp-action="Index"
               class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-white hover:bg-slate-50 text-slate-700 hover:text-slate-900 border border-slate-200 text-sm font-medium transition-all shadow-sm">
                <span class="material-symbols-outlined text-lg">refresh</span>
                <span>Refresh</span>
            </a>
        </div>
    </div>

    <!-- Alert Notifications -->
    <partial name="_PayrollWorkflowMessages" />
    @if (Model.Error != null)
    {
        <div class="p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-sm flex items-center gap-3 shadow-sm">
            <span class="material-symbols-outlined text-rose-600 text-xl shrink-0">error</span>
            <span class="font-medium">@Model.Error</span>
        </div>
    }

    <!-- Search & Filter Card (Manager Style) -->
    <partial name="_ListMetrics" model='@(new ListMetricViewModel[] {
        new("Matching feedback", Model.Data.TotalItems.ToString("N0"), "Matching current filters", "feedback"),
        new("Submitted", Model.Data.Items.Count(x => x.Status == "SUBMITTED").ToString("N0"), "On this page", "pending_actions"),
        new("Approved", Model.Data.Items.Count(x => x.Status == "APPROVED").ToString("N0"), "On this page", "verified"),
        new("Rejected", Model.Data.Items.Count(x => x.Status == "REJECTED").ToString("N0"), "On this page", "cancel")
    })' />
    <form method="get" asp-action="Index" class="ws-list-filter" role="search">
        <div class="ws-filter-row">
            <label class="ws-filter-field ws-filter-keyword"><span class="material-symbols-outlined" aria-hidden="true">search</span><input aria-label="Search" type="text" id="keyword" name="Keyword" value="@Model.Query.Keyword" maxlength="200" placeholder="Search employee name or remarks..." /></label>
            <div class="ws-filter-field"><select aria-label="Status" id="status" name="Status">
                        <option value="" selected="@(string.IsNullOrEmpty(Model.Query.Status))">All Statuses</option>
                        @foreach (var s in new[] { "SUBMITTED", "APPROVED", "EXPLAINED", "REJECTED" })
                        {
                            <option value="@s" selected="@(Model.Query.Status == s)">@s</option>
                        }
                    </select></div>
            <div class="ws-filter-field"><select aria-label="Correction status" id="corrStatus" name="CorrectionStatus">
                        <option value="" selected="@(string.IsNullOrEmpty(Model.Query.CorrectionStatus))">All</option>
                        @foreach (var s in new[] { "PENDING", "IN_PROGRESS", "COMPLETED" })
                        {
                            <option value="@s" selected="@(Model.Query.CorrectionStatus == s)">@s.Replace('_', ' ')</option>
                        }
                    </select></div>
            <div class="ws-filter-field"><select aria-label="Reason" id="reasonCode" name="ReasonCode">
                        <option value="" selected="@(string.IsNullOrEmpty(Model.Query.ReasonCode))">All Reasons</option>
                        @foreach (var s in W.Reasons)
                        {
                            <option value="@s" selected="@(Model.Query.ReasonCode == s)">@s</option>
                        }
                    </select></div>
            <partial name="_ListFilterActions" model='"Index"' />
        </div>
    </form>

    <!-- Table Card (Manager Style) -->
    <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden">
        <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between bg-slate-50/60">
            <div class="flex items-center gap-2.5">
                <span class="material-symbols-outlined text-indigo-600 text-xl">reviews</span>
                <h2 class="text-sm font-bold text-slate-900">Feedback Requests</h2>
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold bg-indigo-50 text-indigo-700 border border-indigo-200">
                    @Model.Data.TotalItems @(Model.Data.TotalItems == 1 ? "Record" : "Records")
                </span>
            </div>
        </div>

        @if (Model.Data.Items.Count == 0)
        {
            <div class="p-12 text-center">
                <div class="w-14 h-14 bg-slate-100 rounded-2xl flex items-center justify-center mx-auto mb-4 text-slate-400">
                    <span class="material-symbols-outlined text-3xl">task_alt</span>
                </div>
                <h3 class="text-base font-bold text-slate-900">No Feedback Requests Found</h3>
                <p class="text-xs text-slate-500 max-w-sm mx-auto mt-1">No feedback requests match your current filters.</p>
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="border-b border-slate-150 bg-slate-50/50 text-[11px] font-bold text-slate-500 uppercase tracking-wider">
                            <th class="py-3.5 px-6">Employee</th>
                            <th class="py-3.5 px-6">Period &amp; Payslip</th>
                            <th class="py-3.5 px-6">Reason Code</th>
                            <th class="py-3.5 px-6">Status</th>
                            <th class="py-3.5 px-6">Correction</th>
                            <th class="py-3.5 px-6">Created (UTC+7)</th>
                            <th class="py-3.5 px-6 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 text-sm">
                        @foreach (var f in Model.Data.Items)
                        {
                            <tr class="hover:bg-slate-50/80 transition-colors">
                                <td class="py-4 px-6 font-semibold text-slate-900">
                                    @f.EmployeeName
                                </td>
                                <td class="py-4 px-6">
                                    <div class="font-medium text-slate-800">@f.PeriodCode • @f.BranchName</div>
                                    <div class="text-xs text-slate-400 mt-0.5">Payslip #@f.PayslipId · V@(f.PayslipVersionNo)</div>
                                </td>
                                <td class="py-4 px-6 text-xs font-semibold text-slate-700">
                                    @f.ReasonCode
                                </td>
                                <td class="py-4 px-6">
                                    @if (f.Status == "SUBMITTED")
                                    {
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-amber-50 text-amber-700 border border-amber-200">
                                            SUBMITTED
                                        </span>
                                    }
                                    else if (f.Status == "APPROVED")
                                    {
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                                            APPROVED
                                        </span>
                                    }
                                    else if (f.Status == "EXPLAINED")
                                    {
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-indigo-50 text-indigo-700 border border-indigo-200">
                                            EXPLAINED
                                        </span>
                                    }
                                    else if (f.Status == "REJECTED")
                                    {
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-rose-50 text-rose-700 border border-rose-200">
                                            REJECTED
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-slate-100 text-slate-700 border border-slate-200">
                                            @f.Status
                                        </span>
                                    }
                                </td>
                                <td class="py-4 px-6 text-xs font-medium text-slate-600">
                                    @(string.IsNullOrEmpty(f.CorrectionStatus) ? "—" : f.CorrectionStatus.Replace('_', ' '))
                                </td>
                                <td class="py-4 px-6 text-xs text-slate-600">
                                    @D.Time(f.CreatedAt)
                                </td>
                                <td class="py-4 px-6 text-right">
                                    <a asp-action="Details" asp-route-id="@f.FeedbackId" title="View details" aria-label="View details" class="ws-icon-action"><span class="material-symbols-outlined" aria-hidden="true">visibility</span></a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        @if (Model.Error == null && ViewData.ModelState.IsValid)
        {
            <partial name="_ListPagination" model='@(new ListPaginationViewModel { PageNumber = Model.Data.Page, PageSize = Model.Data.PageSize, TotalItems = Model.Data.TotalItems, ItemLabel = "feedback requests" })' />
        }
    </div>
</div>
