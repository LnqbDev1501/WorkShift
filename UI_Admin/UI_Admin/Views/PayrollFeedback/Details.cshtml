@model UI_Admin.Models.PayrollDocuments.PayrollFeedbackDetailsResponse
@using D = UI_Admin.Models.Accountant.PayrollPeriods.PeriodDisplay
@using W = UI_Admin.Models.PayrollDocuments.PayrollDocumentDisplay
@{ var f = Model.Feedback; var accountant = User.IsInRole("ACCOUNTANT"); ViewData["Title"] = "Payroll Feedback Details"; }
@section Styles { <link rel="stylesheet" href="~/css/payroll.css" asp-append-version="true" /> }
<div class="payroll-page"><header class="payroll-heading"><div><h1>Payroll Feedback #@f.FeedbackId</h1><p>@f.EmployeeName · @f.PeriodCode · @f.Status · @(f.CorrectionStatus ?? "—")</p></div><a asp-action="Index" class="payroll-button">Back to feedback</a></header><partial name="_PayrollWorkflowMessages" />
    <section class="bg-surface-container-lowest rounded-xl p-5 mb-5"><h2 class="font-semibold">@f.ReasonCode</h2><p class="whitespace-pre-wrap break-words mt-3">@f.Description</p><dl class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-5"><div><dt class="text-xs text-secondary">Created (UTC+7)</dt><dd>@D.Time(f.CreatedAt)</dd></div><div><dt class="text-xs text-secondary">Processed (UTC+7)</dt><dd>@D.Time(f.ProcessedAt)</dd></div><div><dt class="text-xs text-secondary">Resolved (UTC+7)</dt><dd>@D.Time(f.ResolvedAt)</dd></div></dl><p class="mt-4 whitespace-pre-wrap">@f.ResolutionNote</p><a asp-controller="@(W.RolePrefix(User) + "Payslips")" asp-action="Details" asp-route-id="@f.PayslipId" class="payroll-button mt-4">Original Payslip V@(f.PayslipVersionNo)</a></section>
    @if (accountant && f.Status == "SUBMITTED")
    { <section class="bg-surface-container-lowest rounded-xl p-5 mb-5"><h2 class="font-semibold mb-3">Review Feedback</h2><form asp-action="Approve" asp-route-id="@f.FeedbackId" method="post" class="mb-5"><label for="approve-note">Resolution note (optional)</label><textarea id="approve-note" name="ResolutionNote" maxlength="2000" rows="3" class="w-full border rounded-xl p-3 mt-2"></textarea><button class="payroll-button primary mt-3" type="submit">Approve Feedback</button></form><form asp-action="Reject" asp-route-id="@f.FeedbackId" method="post"><label for="reject-note">Rejection reason (required)</label><textarea id="reject-note" name="ResolutionNote" required maxlength="2000" rows="3" class="w-full border rounded-xl p-3 mt-2"></textarea><button class="payroll-button mt-3" type="submit">Reject Feedback</button></form></section> }
    @if (accountant && f.Status == "APPROVED" && f.CorrectionStatus != "COMPLETED" && (Model.CorrectionPayroll == null || Model.CorrectionPayroll.Status == "REJECTED")) { <a asp-controller="AccountantPayrollRevision" asp-action="CorrectFeedback" asp-route-id="@f.FeedbackId" class="payroll-button primary mb-5">Create Payroll Correction</a> }
    <section class="payroll-table-card"><div class="payroll-table-toolbar"><strong>Original and Correction Payroll</strong></div><div class="payroll-table-scroll"><table><thead><tr><th>VERSION</th><th>STATUS</th><th class="money">GROSS</th><th class="money">DEDUCTION</th><th class="money">NET</th><th>ACTIONS</th></tr></thead><tbody>@foreach (var p in new[] { Model.OriginalPayroll, Model.CorrectionPayroll }.Where(p => p != null)) { <tr><td>Payroll #@p!.PayrollId · V@(p.VersionNo)</td><td>@p.Status</td><td class="money">@D.Money(p.GrossSalary)</td><td class="money">@D.Money(p.TotalDeduction)</td><td class="money">@D.Money(p.NetSalary)</td><td>@if (accountant) { <a asp-controller="AccountantPayrollRevision" asp-action="Review" asp-route-id="@p.PayrollId" class="payroll-button">Review / Submit</a> }</td></tr> }</tbody></table></div></section>
    @if (f.CorrectionPayslipId.HasValue) { <a asp-controller="@(W.RolePrefix(User) + "Payslips")" asp-action="Details" asp-route-id="@f.CorrectionPayslipId" class="payroll-button primary">View Replacement Payslip</a> }
</div>
