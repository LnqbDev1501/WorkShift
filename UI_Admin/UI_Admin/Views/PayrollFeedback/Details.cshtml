@model UI_Admin.Models.PayrollDocuments.PayrollFeedbackDetailsResponse
@using D = UI_Admin.Models.Accountant.PayrollPeriods.PeriodDisplay
@using W = UI_Admin.Models.PayrollDocuments.PayrollDocumentDisplay
@{
    var f = Model.Feedback;
    var accountant = User.IsInRole("ACCOUNTANT");
    ViewData["Title"] = $"Feedback Details #{f.FeedbackId}";
}

<div class="px-7 py-6 max-w-[1400px] mx-auto space-y-6">
    <!-- Header Title & Action Bar -->
    <div class="flex flex-col md:flex-row md:items-start justify-between gap-4">
        <div>
            <div class="flex items-center gap-1.5 text-xs text-indigo-600 font-semibold uppercase tracking-wider mb-1">
                <span class="material-symbols-outlined text-sm">mark_email_read</span>
                <span>Payroll / Feedback Details</span>
            </div>
            <div class="flex items-center gap-3 flex-wrap">
                <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Feedback #@f.FeedbackId — @f.EmployeeName</h1>
                @if (f.Status == "SUBMITTED")
                {
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-amber-50 text-amber-700 border border-amber-200">
                        SUBMITTED
                    </span>
                }
                else if (f.Status == "APPROVED")
                {
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                        APPROVED
                    </span>
                }
                else if (f.Status == "REJECTED")
                {
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-rose-50 text-rose-700 border border-rose-200">
                        REJECTED
                    </span>
                }
                else
                {
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-slate-100 text-slate-700 border border-slate-200">
                        @f.Status
                    </span>
                }
            </div>
            <p class="text-sm text-slate-500 mt-1 flex flex-wrap items-center gap-2">
                <span>Period: @f.PeriodCode</span>
                <span>•</span>
                <span>Correction Status: <strong class="text-slate-800 font-medium">@(f.CorrectionStatus ?? "—")</strong></span>
            </p>
        </div>

        <div class="flex items-center gap-3 shrink-0">
            <a asp-action="Index"
               class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-white hover:bg-slate-50 text-slate-700 hover:text-slate-900 border border-slate-200 text-sm font-medium transition-all shadow-sm">
                <span class="material-symbols-outlined text-lg">arrow_back</span>
                <span>Back to Feedback</span>
            </a>
        </div>
    </div>

    <!-- Alert Notifications -->
    <partial name="_PayrollWorkflowMessages" />

    <!-- Feedback Details Card (Manager Style) -->
    <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm space-y-4">
        <div class="flex items-center justify-between border-b border-slate-100 pb-3">
            <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-indigo-600 text-lg">comment</span>
                <h2 class="text-sm font-bold text-slate-900 uppercase tracking-wider">Employee Feedback Submission</h2>
            </div>
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-indigo-50 text-indigo-700 border border-indigo-200">
                Reason: @f.ReasonCode
            </span>
        </div>

        <div class="p-4 rounded-xl bg-slate-50 border border-slate-100 text-sm">
            <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider block mb-1">Employee Remarks</span>
            <p class="text-slate-800 whitespace-pre-wrap">@(string.IsNullOrWhiteSpace(f.Description) ? "No remarks provided" : f.Description)</p>
        </div>

        <dl class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs">
            <div class="p-3 rounded-xl bg-slate-50 border border-slate-100">
                <dt class="text-slate-500 font-medium">Submitted (UTC+7)</dt>
                <dd class="text-sm font-bold text-slate-900 mt-0.5">@D.Time(f.CreatedAt)</dd>
            </div>
            <div class="p-3 rounded-xl bg-slate-50 border border-slate-100">
                <dt class="text-slate-500 font-medium">Processed (UTC+7)</dt>
                <dd class="text-sm font-bold text-slate-900 mt-0.5">@D.Time(f.ProcessedAt)</dd>
            </div>
            <div class="p-3 rounded-xl bg-slate-50 border border-slate-100">
                <dt class="text-slate-500 font-medium">Resolved (UTC+7)</dt>
                <dd class="text-sm font-bold text-slate-900 mt-0.5">@D.Time(f.ResolvedAt)</dd>
            </div>
        </dl>

        @if (!string.IsNullOrEmpty(f.ResolutionNote))
        {
            <div class="p-4 rounded-xl bg-slate-50 border border-slate-100 text-xs">
                <span class="font-semibold text-slate-500 uppercase tracking-wider block mb-1">Resolution Note</span>
                <p class="text-slate-900 font-medium whitespace-pre-wrap">@f.ResolutionNote</p>
            </div>
        }

        <div class="pt-2">
            <a asp-controller="@(W.RolePrefix(User) + "Payslips")" asp-action="Details" asp-route-id="@f.PayslipId"
               class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold transition-all">
                <span class="material-symbols-outlined text-sm">receipt_long</span>
                <span>View Original Payslip V@(f.PayslipVersionNo)</span>
            </a>
            @if (f.CorrectionPayslipId.HasValue)
            {
                <a asp-controller="@(W.RolePrefix(User) + "Payslips")" asp-action="Details" asp-route-id="@f.CorrectionPayslipId"
                   class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-indigo-50 hover:bg-indigo-100 text-indigo-700 text-xs font-semibold transition-all ml-2">
                    <span class="material-symbols-outlined text-sm">receipt</span>
                    <span>View Replacement Payslip</span>
                </a>
            }
        </div>
    </div>

    <!-- Review Actions (if pending review by Accountant) -->
    @if (accountant && f.Status == "SUBMITTED")
    {
        <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm space-y-4">
            <div class="flex items-center gap-2 border-b border-slate-100 pb-3">
                <span class="material-symbols-outlined text-indigo-600 text-lg">gavel</span>
                <h3 class="text-sm font-bold text-slate-900 uppercase tracking-wider">Accountant Review Decision</h3>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Approve Form -->
                <form asp-action="Approve" asp-route-id="@f.FeedbackId" method="post" class="space-y-3 p-4 rounded-xl bg-emerald-50/40 border border-emerald-200">
                    @Html.AntiForgeryToken()
                    <div class="font-bold text-emerald-950 text-sm flex items-center gap-1.5">
                        <span class="material-symbols-outlined text-emerald-600">check_circle</span>
                        <span>Approve Feedback</span>
                    </div>
                    <div>
                        <label for="approve-note" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Resolution Note (Optional)</label>
                        <textarea id="approve-note" name="ResolutionNote" maxlength="2000" rows="2"
                                  placeholder="Enter resolution details..."
                                  class="w-full px-3 py-2 bg-white border border-slate-200 rounded-xl text-xs text-slate-900 focus:outline-none focus:border-emerald-500 box-border"></textarea>
                    </div>
                    <button type="submit" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold shadow-sm transition-all cursor-pointer">
                        <span class="material-symbols-outlined text-sm">check</span>
                        <span>Confirm Approval</span>
                    </button>
                </form>

                <!-- Reject Form -->
                <form asp-action="Reject" asp-route-id="@f.FeedbackId" method="post" class="space-y-3 p-4 rounded-xl bg-rose-50/40 border border-rose-200">
                    @Html.AntiForgeryToken()
                    <div class="font-bold text-rose-950 text-sm flex items-center gap-1.5">
                        <span class="material-symbols-outlined text-rose-600">cancel</span>
                        <span>Reject Feedback</span>
                    </div>
                    <div>
                        <label for="reject-note" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Rejection Reason *</label>
                        <textarea id="reject-note" name="ResolutionNote" required maxlength="2000" rows="2"
                                  placeholder="Enter reason for rejection..."
                                  class="w-full px-3 py-2 bg-white border border-slate-200 rounded-xl text-xs text-slate-900 focus:outline-none focus:border-rose-500 box-border"></textarea>
                    </div>
                    <button type="submit" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-rose-600 hover:bg-rose-700 text-white text-xs font-semibold shadow-sm transition-all cursor-pointer">
                        <span class="material-symbols-outlined text-sm">close</span>
                        <span>Confirm Rejection</span>
                    </button>
                </form>
            </div>
        </div>
    }

    <!-- Associated Payroll Records Table (Manager Style) -->
    <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden">
        <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between bg-slate-50/60">
            <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-indigo-600 text-lg">receipt_long</span>
                <h3 class="text-sm font-bold text-slate-900">Original &amp; Correction Payrolls</h3>
            </div>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="border-b border-slate-150 bg-slate-50/50 text-[11px] font-bold text-slate-500 uppercase tracking-wider">
                        <th class="py-3.5 px-6">Payroll Version</th>
                        <th class="py-3.5 px-6">Status</th>
                        <th class="py-3.5 px-6 text-right">Gross Salary</th>
                        <th class="py-3.5 px-6 text-right">Applied Deductions</th>
                        <th class="py-3.5 px-6 text-right">Net Salary</th>
                        <th class="py-3.5 px-6 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 text-sm">
                    @foreach (var p in new[] { Model.OriginalPayroll, Model.CorrectionPayroll }.Where(p => p != null))
                    {
                        <tr class="hover:bg-slate-50/80 transition-colors">
                            <td class="py-4 px-6 font-semibold text-slate-900">
                                Payroll #@p!.PayrollId · Version @p.VersionNo
                            </td>
                            <td class="py-4 px-6">
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold @(p.Status == "CALCULATED" ? "bg-sky-50 text-sky-700 border border-sky-200" : p.Status == "APPROVED" ? "bg-emerald-50 text-emerald-700 border border-emerald-200" : "bg-slate-100 text-slate-700 border border-slate-200")">
                                    @p.Status
                                </span>
                            </td>
                            <td class="py-4 px-6 text-right font-medium text-slate-800">
                                @D.Money(p.GrossSalary)
                            </td>
                            <td class="py-4 px-6 text-right font-medium text-slate-800">
                                @D.Money(p.TotalDeduction)
                            </td>
                            <td class="py-4 px-6 text-right font-bold text-slate-900">
                                @D.Money(p.NetSalary)
                            </td>
                            <td class="py-4 px-6 text-right">
                                @if (accountant)
                                {
                                    <a asp-controller="AccountantPayrollRevision" asp-action="Review" asp-route-id="@p.PayrollId"
                                       class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold transition-all">
                                        <span class="material-symbols-outlined text-sm">rate_review</span>
                                        <span>Review</span>
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
