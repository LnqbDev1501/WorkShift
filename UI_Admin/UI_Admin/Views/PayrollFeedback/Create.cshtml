@model UI_Admin.Models.PayrollDocuments.FeedbackSubmitForm
@using D = UI_Admin.Models.Accountant.PayrollPeriods.PeriodDisplay
@using W = UI_Admin.Models.PayrollDocuments.PayrollDocumentDisplay
@{ ViewData["Title"] = "Submit Payroll Feedback"; }
<div class="px-7 py-4"><header class="form-heading"><h1 class="text-display-lg font-display-lg">Submit Payroll Feedback</h1><p>Payslip #@Model.Payslip.PayslipId · V@(Model.Payslip.VersionNo) · @Model.Payslip.PeriodCode</p><p>Deadline (UTC+7): @D.Time(Model.Payslip.FeedbackDeadlineAt)</p></header><form asp-action="Create" asp-route-id="@Model.Payslip.PayslipId" method="post" class="bg-surface-container-lowest rounded-xl p-5 max-w-3xl" data-feedback-deadline="@Model.Payslip.FeedbackDeadlineAt.ToString("O")"><div asp-validation-summary="All" class="text-red-700 mb-4" role="alert"></div><label for="reason">Reason</label><select id="reason" name="ReasonCode" required class="w-full border rounded-xl p-3 mb-4"><option value="">Choose a reason</option>@foreach (var r in W.Reasons) { <option value="@r" selected="@(r == Model.Input.ReasonCode)">@r</option> }</select><label for="description">Description</label><textarea id="description" name="Description" required maxlength="2000" rows="6" class="w-full border rounded-xl p-3 mb-4">@Model.Input.Description</textarea><p class="text-secondary mb-4">Chỉ gửi một phản hồi đang xử lý. Phản hồi đã gửi không thể sửa hoặc rút.</p><button type="submit" class="payroll-button primary px-5 py-2 rounded-xl bg-primary-container text-white" data-feedback-submit>Submit Feedback</button><a asp-controller="StaffPayslips" asp-action="Details" asp-route-id="@Model.Payslip.PayslipId" class="inline-block ml-4">Back to payslip</a></form></div>
@section Scripts { <script src="~/js/payslip-feedback-window.js" asp-append-version="true"></script> }
