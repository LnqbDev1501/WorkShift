@model UI_Admin.Models.PayrollDocuments.FeedbackSubmitForm
@using D = UI_Admin.Models.Accountant.PayrollPeriods.PeriodDisplay
@using W = UI_Admin.Models.PayrollDocuments.PayrollDocumentDisplay
@{
    ViewData["Title"] = "Submit Payroll Feedback";
}

<div class="px-7 py-6 max-w-[1400px] mx-auto space-y-6">
    <!-- Header Title & Action Bar -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-1.5 text-xs text-indigo-600 font-semibold uppercase tracking-wider mb-1">
                <span class="material-symbols-outlined text-sm">mark_email_read</span>
                <span>Payroll / Staff Feedback</span>
            </div>
            <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Submit Payroll Feedback</h1>
            <p class="text-sm text-slate-500 mt-0.5">
                Payslip #@Model.Payslip.PayslipId • Version V@(Model.Payslip.VersionNo) • Period @Model.Payslip.PeriodCode • Deadline (UTC+7): <strong class="text-slate-700">@D.Time(Model.Payslip.FeedbackDeadlineAt)</strong>
            </p>
        </div>
        <div class="flex items-center gap-3">
            <a asp-controller="StaffPayslips" asp-action="Details" asp-route-id="@Model.Payslip.PayslipId"
               class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-white hover:bg-slate-50 text-slate-700 hover:text-slate-900 border border-slate-200 text-sm font-medium transition-all shadow-sm">
                <span class="material-symbols-outlined text-lg">arrow_back</span>
                <span>Back to Payslip</span>
            </a>
        </div>
    </div>

    <!-- Feedback Submission Form Card (Manager Style) -->
    <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm max-w-2xl">
        <form asp-action="Create" asp-route-id="@Model.Payslip.PayslipId" method="post" class="space-y-5" data-feedback-deadline="@Model.Payslip.FeedbackDeadlineAt.ToString("O")">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-sm" role="alert"></div>

            <div>
                <label for="reason" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">
                    Feedback Reason <span class="text-rose-500">*</span>
                </label>
                <select id="reason" name="ReasonCode" required
                        class="w-full h-11 px-3.5 bg-slate-50/50 hover:bg-white focus:bg-white border border-slate-200 rounded-xl text-sm text-slate-800 focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 transition-all cursor-pointer box-border">
                    <option value="">Choose a reason</option>
                    @foreach (var r in W.Reasons)
                    {
                        <option value="@r" selected="@(r == Model.Input.ReasonCode)">@r</option>
                    }
                </select>
            </div>

            <div>
                <label for="description" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">
                    Detailed Remarks <span class="text-rose-500">*</span>
                </label>
                <textarea id="description" name="Description" required maxlength="2000" rows="5"
                          placeholder="Describe the discrepancy in detail (e.g. date of shift, missing work hours, or unrecognized deduction)..."
                          class="w-full px-3.5 py-2.5 bg-slate-50/50 hover:bg-white focus:bg-white border border-slate-200 rounded-xl text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 transition-all box-border">@Model.Input.Description</textarea>
            </div>

            <div class="p-3.5 rounded-xl bg-amber-50 border border-amber-200 text-xs text-amber-900 flex items-start gap-2.5">
                <span class="material-symbols-outlined text-amber-600 text-base shrink-0 mt-0.5">info</span>
                <span>Only one active feedback request is permitted per payslip. Submitted feedback cannot be edited or withdrawn.</span>
            </div>

            <div class="flex items-center gap-3 pt-2">
                <button type="submit" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 active:bg-indigo-800 text-white text-sm font-semibold shadow-sm transition-all cursor-pointer" data-feedback-submit>
                    <span class="material-symbols-outlined text-sm">send</span>
                    <span>Submit Feedback</span>
                </button>
                <a asp-controller="StaffPayslips" asp-action="Details" asp-route-id="@Model.Payslip.PayslipId"
                   class="px-4 py-2.5 rounded-xl bg-white hover:bg-slate-100 text-slate-700 border border-slate-200 text-sm font-semibold transition-all shadow-xs cursor-pointer">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/payslip-feedback-window.js" asp-append-version="true"></script>
}
