@model UI_Admin.Models.AttendanceRule.AttendanceRuleListViewModel

@{
    ViewData["Title"] = "Attendance Rules";
}

@section Styles {
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet" />
<style>
    .rules-page{min-height:100vh;padding:16px 28px 36px;color:#20233a;background:#f6f7fb;font-family:Arial,Helvetica,sans-serif;font-style:normal}
    .rules-body{max-width:1440px;margin:auto;padding-top:0}
    .page-heading{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;margin-bottom:16px}
    .eyebrow{display:flex;align-items:center;gap:9px;margin-bottom:5px;color:#50577a;font-size:13px;letter-spacing:.08em;text-transform:uppercase}
    .eyebrow i{width:8px;height:8px;background:#4f46e5;border-radius:50%}
    .page-heading h1{margin:0;color:#191c2a;font-size:22px;font-weight:600}
    .page-heading p{margin:4px 0 0;color:#5b6074;font-size:14px}
    .heading-actions{display:flex;gap:12px}
    .ui-button{display:inline-flex;align-items:center;justify-content:center;gap:9px;height:41px;padding:0 18px;border:0;border-radius:9px;font:500 14px Arial,Helvetica,sans-serif;text-decoration:none;cursor:pointer;box-shadow:0 2px 5px #1b1f360d}
    .ui-button.light{color:#25293b;background:#fff}
    .ui-button.primary{color:#fff;background:#5146e5;box-shadow:0 3px 7px #4f46e540}
    .symbol{font-family:Arial,sans-serif;font-size:17px}
    .metrics{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;margin-bottom:18px}
    .metric{display:flex;align-items:center;justify-content:space-between;min-height:108px;padding:17px 16px;background:#fff;border-radius:9px;box-shadow:0 1px 3px #191c2d0d}
    .metric-label{color:#454c6d;font-size:13px;font-weight:600;letter-spacing:.04em;text-transform:uppercase}
    .metric-value{margin-top:9px;color:#11131d;font-size:20px;font-weight:600}
    .metric-note{margin-top:7px;color:#555b71;font-size:13px}
    .metric-note.danger{color:#d11515}
    .metric-icon{display:grid;flex:0 0 40px;width:40px;height:40px;margin-left:14px;place-items:center;color:#4f46e5;background:#f1f2f7;border-radius:6px;font:21px Arial,sans-serif}
    .filter-card{margin-bottom:18px;padding:16px;background:#fff;border-radius:9px;box-shadow:0 1px 3px #191c2d12}
    .filters{display:grid;grid-template-columns:3fr 2fr auto;gap:12px}
    .search-box{position:relative}
    .search-box span{position:absolute;top:50%;left:14px;transform:translateY(-50%);color:#3f4a68;font:19px Arial,sans-serif}
    .filter-control{width:100%;height:41px;padding:0 13px;color:#1f2336;background:#f0f1f6;border:0;border-radius:7px;outline:none;font:400 14px Arial,Helvetica,sans-serif}
    .search-box input{padding-left:41px}
    .clear{min-width:102px;color:#42475a!important;background:#f0f1f6;box-shadow:none;text-decoration:none!important;transition:background .15s,color .15s}
    .clear:hover{color:#3028b8!important;background:#e5e7f0;text-decoration:none!important}
    .table-card{overflow:hidden;background:#fff;border-radius:9px;box-shadow:0 1px 3px #191c2d14}
    .rules-table{width:100%;border-collapse:collapse;table-layout:fixed}
    .rules-table th{height:38px;padding:0 16px;color:#4a516f;background:#f0f1f6;font-size:13px;font-weight:600;text-align:left;text-transform:uppercase}
    .rules-table td{height:72px;padding:10px 16px;color:#171a27;border-top:1px solid #f3f3f6;font-size:14px;font-style:normal;vertical-align:middle}
    .rules-table th:nth-child(1){width:26%}
    .rules-table th:nth-child(2){width:14%}
    .rules-table th:nth-child(3){width:14%}
    .rules-table th:nth-child(4){width:11%}
    .rules-table th:nth-child(5){width:14%}
    .rules-table th:nth-child(6){width:11%}
    .rules-table th:nth-child(7){width:10%}
    .rule-cell{display:flex;align-items:center;gap:12px}
    .rule-icon-box{display:grid;flex:0 0 36px;width:36px;height:36px;place-items:center;color:#4f46e5;background:#eef2ff;border-radius:11px;font-size:18px}
    .rule-icon-box.active{color:#059669;background:#ecfdf5}
    .rule-icon-box.scheduled{color:#7c3aed;background:#f5f3ff}
    .rule-icon-box.draft{color:#d97706;background:#fffbeb}
    .rule-icon-box.muted{color:#868a98;background:#e9eaee}
    .rule-name{display:flex;align-items:center;gap:7px;font-weight:600;color:#111827;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .rule-desc{color:#5b6074;font-size:12px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .pill{display:inline-flex;align-items:center;gap:5px;padding:4px 9px;background:#e9eaee;border-radius:12px;font-size:12px;font-weight:500;white-space:nowrap}
    .status{background:#dfe5f8;color:#20285a}
    .status.active{color:#065f46;background:#d1fae5}
    .status.scheduled{color:#5b21b6;background:#ede9fe}
    .status.draft{color:#92400e;background:#fef3c7}
    .status.cancelled{color:#596071;background:#e8e9ed}
    .status.archived{color:#4b5563;background:#f3f4f6}
    .dot{width:6px;height:6px;background:#4f46e5;border-radius:50%}
    .status.active .dot{background:#10b981}
    .status.scheduled .dot{background:#8b5cf6}
    .status.draft .dot{background:#f59e0b}
    .status.cancelled .dot{background:#89909d}
    .status.archived .dot{background:#9ca3af}
    .window-info{display:flex;flex-direction:column;gap:2px;font-size:13px}
    .window-sub{font-size:11px;color:#6b7280}
    .distance-pill{display:inline-flex;align-items:center;gap:4px;padding:3px 8px;background:#f1f5f9;color:#334155;border-radius:6px;font-size:12px;font-weight:600}
    .period-text{font-size:13px;color:#1f2937}
    .period-sub{font-size:11px;color:#6b7280;margin-top:2px}
    .actions{display:flex;align-items:center;gap:6px;white-space:nowrap}
    .icon-button{display:grid;width:32px;height:32px;padding:0;place-items:center;color:#4338ca;background:transparent;border:0;border-radius:7px;cursor:pointer;transition:background .15s}
    .icon-button:hover{background:#eef0ff}
    .icon-button.success{color:#4f46e5}
    .icon-button.success:hover{background:#eef2ff}
    .icon-button.danger{color:#e11d48}
    .icon-button.danger:hover{background:#ffe4e6}
    .icon-button svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
    .empty-row{text-align:center!important;color:#6b7280!important;height:100px!important}

    /* Modern Premium Modals */
    .modal-overlay{position:fixed;inset:0;z-index:99999;display:flex;align-items:center;justify-content:center;padding:16px;background:rgba(15,23,42,0.45);backdrop-filter:blur(4px);animation:modalFade .15s ease-out}
    .modal-box{background:#ffffff;border-radius:24px;max-width:440px;width:100%;padding:28px 24px;box-shadow:0 25px 50px -12px rgba(15,23,42,0.25);border:1px solid rgba(226,232,240,0.8);display:flex;flex-direction:column;gap:18px;animation:modalPop .2s cubic-bezier(0.16,1,0.3,1)}
    .modal-icon{width:60px;height:60px;border-radius:20px;display:flex;align-items:center;justify-content:center;margin:0 auto}
    .modal-icon.danger{background:#fff1f2;border:1px solid #fecdd3;color:#e11d48;outline:6px solid rgba(255,241,242,0.8)}
    .modal-icon.success{background:#ecfdf5;border:1px solid #a7f3d0;color:#059669;outline:6px solid rgba(236,253,245,0.8)}
    .modal-icon.publish{background:#eef2ff;border:1px solid #c7d2fe;color:#4f46e5;outline:6px solid rgba(238,242,255,0.8)}
    .modal-title{font-size:18px;font-weight:700;color:#0f172a;text-align:center;letter-spacing:-0.01em}
    .modal-desc{font-size:13.5px;color:#64748b;text-align:center;line-height:1.55}
    .modal-item-badge{background:#f8fafc;border:1px solid #e2e8f0;padding:10px 14px;border-radius:12px;font-size:13px;font-weight:600;color:#1e293b;text-align:center;word-break:break-word}
    .modal-actions{display:flex;gap:12px;margin-top:6px}
    .modal-btn{flex:1;height:42px;border-radius:12px;font-weight:600;font-size:14px;cursor:pointer;transition:all .15s ease;display:flex;align-items:center;justify-content:center;border:0}
    .modal-btn.cancel{background:#f1f5f9;color:#475569}
    .modal-btn.cancel:hover{background:#e2e8f0;color:#1e293b}
    .modal-btn.danger{background:#e11d48;color:#ffffff;box-shadow:0 4px 12px rgba(225,29,72,0.25)}
    .modal-btn.danger:hover{background:#be123c}
    .modal-btn.success{background:#059669;color:#ffffff;box-shadow:0 4px 12px rgba(5,150,105,0.25)}
    .modal-btn.success:hover{background:#047857}
    .modal-btn.publish{background:#4f46e5;color:#ffffff;box-shadow:0 4px 12px rgba(79,70,229,0.25)}
    .modal-btn.publish:hover{background:#4338ca}
    @@keyframes modalFade{from{opacity:0}to{opacity:1}}
    @@keyframes modalPop{from{opacity:0;transform:scale(0.95)}to{opacity:1;transform:scale(1)}}
    @@media(max-width:1100px){.metrics{grid-template-columns:repeat(2,1fr)}.filters{grid-template-columns:1fr 1fr auto}.table-card{overflow-x:auto}.rules-table{min-width:1050px}}
    @@media(max-width:700px){.rules-page{padding:16px 16px 32px}.page-heading{align-items:flex-start;flex-direction:column}.metrics{grid-template-columns:1fr}.filters{grid-template-columns:1fr}}
</style>
}

<!-- System Notification Modals (TempData) -->
@if (TempData["SuccessMessage"] is string successMessage && !string.IsNullOrWhiteSpace(successMessage))
{
    <div id="successModal" class="fixed inset-0 z-[99999] flex items-center justify-center bg-slate-900/40 backdrop-blur-xs p-4 animate-in fade-in duration-150">
        <div class="bg-white rounded-3xl p-7 max-w-sm w-full shadow-2xl border border-slate-100 flex flex-col items-center text-center space-y-4 animate-in fade-in zoom-in-95 duration-150">
            <div class="w-16 h-16 rounded-full bg-emerald-50 border-2 border-emerald-100 text-emerald-600 flex items-center justify-center shadow-xs ring-8 ring-emerald-50/70">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
            </div>
            <div class="space-y-1 text-center">
                <h3 class="text-lg font-bold text-slate-900 tracking-tight">Success</h3>
                <p class="text-sm text-slate-600 leading-relaxed">@successMessage</p>
            </div>
            <button type="button" class="w-full py-2.5 px-4 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-sm transition-all shadow-md shadow-indigo-600/20 cursor-pointer" onclick="document.getElementById('successModal').remove()">
                OK
            </button>
        </div>
    </div>
}

@if (TempData["ErrorMessage"] is string errorMessage && !string.IsNullOrWhiteSpace(errorMessage))
{
    <div id="errorModal" class="fixed inset-0 z-[99999] flex items-center justify-center bg-slate-900/40 backdrop-blur-xs p-4 animate-in fade-in duration-150">
        <div class="bg-white rounded-3xl p-7 max-w-sm w-full shadow-2xl border border-slate-100 flex flex-col items-center text-center space-y-4 animate-in fade-in zoom-in-95 duration-150">
            <div class="w-16 h-16 rounded-full bg-rose-50 border-2 border-rose-100 text-rose-600 flex items-center justify-center shadow-xs ring-8 ring-rose-50/70">
                <span class="material-symbols-outlined text-[30px]">error</span>
            </div>
            <div class="space-y-1 text-center">
                <h3 class="text-lg font-bold text-slate-900 tracking-tight">Action Failed</h3>
                <p class="text-sm text-slate-600 leading-relaxed">@errorMessage</p>
            </div>
            <button type="button" class="w-full py-2.5 px-4 rounded-xl bg-rose-600 hover:bg-rose-700 text-white font-semibold text-sm transition-all shadow-md shadow-rose-600/20 cursor-pointer" onclick="document.getElementById('errorModal').remove()">
                Close
            </button>
        </div>
    </div>
}

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div id="apiErrorModal" class="fixed inset-0 z-[99999] flex items-center justify-center bg-slate-900/40 backdrop-blur-xs p-4 animate-in fade-in duration-150">
        <div class="bg-white rounded-3xl p-7 max-w-sm w-full shadow-2xl border border-slate-100 flex flex-col items-center text-center space-y-4 animate-in fade-in zoom-in-95 duration-150">
            <div class="w-16 h-16 rounded-full bg-rose-50 border-2 border-rose-100 text-rose-600 flex items-center justify-center shadow-xs ring-8 ring-rose-50/70">
                <span class="material-symbols-outlined text-[30px]">warning</span>
            </div>
            <div class="space-y-1 text-center">
                <h3 class="text-lg font-bold text-slate-900 tracking-tight">Unable to Load Data</h3>
                <p class="text-sm text-slate-600 leading-relaxed">@Model.ErrorMessage</p>
            </div>
            <button type="button" class="w-full py-2.5 px-4 rounded-xl bg-rose-600 hover:bg-rose-700 text-white font-semibold text-sm transition-all shadow-md shadow-rose-600/20 cursor-pointer" onclick="document.getElementById('apiErrorModal').remove()">
                Close
            </button>
        </div>
    </div>
}

<!-- Cancel Rule Modal -->
<div id="cancelRuleModal" class="modal-overlay hidden">
    <div class="modal-box">
        <div class="modal-icon danger">
            <span class="material-symbols-outlined text-[30px]">event_busy</span>
        </div>
        <div class="space-y-2 text-center">
            <h3 class="modal-title">Cancel Attendance Rule</h3>
            <p class="modal-desc" id="cancelModalSubtext">Are you sure you want to cancel this policy?</p>
            <div class="modal-item-badge" id="cancelRuleNameText"></div>
        </div>
        <form asp-action="Cancel" method="post" id="cancelRuleForm" class="space-y-3">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="cancelRuleIdInput" value="" />
            <div id="cancelReasonContainer">
                <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">Cancellation Reason</label>
                <textarea name="cancellationReason" id="cancelReasonInput" rows="2" maxlength="500" class="w-full px-3.5 py-2.5 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:outline-none focus:ring-2 focus:ring-rose-500/20 focus:border-rose-500 transition-all text-slate-900" placeholder="Optional reason for cancellation..."></textarea>
            </div>
            <div class="modal-actions">
                <button type="button" class="modal-btn cancel" onclick="closeCancelRuleModal()">Cancel</button>
                <button type="submit" class="modal-btn danger">Confirm Cancel</button>
            </div>
        </form>
    </div>
</div>

<!-- Publish Rule Modal -->
<div id="publishRuleModal" class="modal-overlay hidden">
    <div class="modal-box">
        <div class="modal-icon publish">
            <span class="material-symbols-outlined text-[30px]">publish</span>
        </div>
        <div class="space-y-2 text-center">
            <h3 class="modal-title">Publish Attendance Rule</h3>
            <p class="modal-desc">Are you sure you want to publish this policy? It will take effect according to its scheduled effective date.</p>
            <div class="modal-item-badge" id="publishRuleNameText"></div>
        </div>
        <form asp-action="Publish" method="post" id="publishRuleForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="publishRuleIdInput" value="" />
            <div class="modal-actions">
                <button type="button" class="modal-btn cancel" onclick="closePublishRuleModal()">Cancel</button>
                <button type="submit" class="modal-btn publish">Publish Now</button>
            </div>
        </form>
    </div>
</div>

<section class="rules-page">
    <div class="rules-body">
        <!-- Page Header -->
        <div class="page-heading">
            <div>
                <div class="eyebrow"><i></i>Compliance & Attendance Policy Engine</div>
                <h1>Attendance Rules</h1>
                <p>Configure check-in and check-out time windows, grace periods, and GPS geo-fencing distance limits.</p>
            </div>
            <div class="heading-actions">
                <a asp-action="Create" class="ui-button primary" title="Create new attendance rule">
                    <span class="symbol">♙+</span>Create Rule
                </a>
            </div>
        </div>

        <!-- Metric Cards -->
        <partial name="_ListMetrics" model='@(new ListMetricViewModel[] {
            new("Total Rules", Model.TotalRules.ToString("N0"), "All configured policies", "policy", "#8b5cf6"),
            new("Active Rule", Model.ActiveRules.ToString("N0"), "Currently in effect", "verified", "#10b981"),
            new("Scheduled", Model.ScheduledRules.ToString("N0"), "Upcoming future activations", "schedule", "#4f46e5"),
            new("Draft Versions", Model.DraftRules.ToString("N0"), "Under review / unreleased", "pending_actions", "#f59e0b")
        })' />

        <!-- Filter Card -->
        <form asp-action="List" method="get" class="ws-list-filter" role="search">
            <div class="ws-filter-row">
                <label class="ws-filter-field ws-filter-keyword"><span class="material-symbols-outlined" aria-hidden="true">search</span><input aria-label="Search" asp-for="Query.Search" name="search" type="search" placeholder="Search rule name or description..." /></label>
                <div class="ws-filter-field"><select asp-for="Query.Status" name="status" aria-label="Status">
                            <option value="">All Statuses</option>
                            <option value="ACTIVE">Active</option>
                            <option value="SCHEDULED">Scheduled</option>
                            <option value="DRAFT">Draft</option>
                            <option value="CANCELLED">Cancelled</option>
                        </select></div>
                <partial name="_ListFilterActions" model='"List"' />
            </div>
        </form>

        <!-- Table Card -->
        <div class="table-card">
            <table class="rules-table">
                <thead>
                    <tr>
                        <th>Rule Name</th>
                        <th>Check-in Window</th>
                        <th>Check-out Window</th>
                        <th>GPS Radius</th>
                        <th>Effective Period</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="empty-row">No attendance rules found.</td>
                        </tr>
                    }
                    @foreach (var rule in Model.Items)
                    {
                        var statusLower = rule.Status.ToLowerInvariant();
                        var iconClass = statusLower switch
                        {
                            "active" => "active",
                            "scheduled" => "scheduled",
                            "draft" => "draft",
                            _ => "muted"
                        };

                        <tr>
                            <!-- Rule Name -->
                            <td>
                                <div class="rule-cell">
                                    <div class="rule-icon-box @iconClass">
                                        <span class="material-symbols-outlined text-[20px]">
                                            @(statusLower == "active" ? "verified" : statusLower == "scheduled" ? "event_upcoming" : statusLower == "draft" ? "edit_document" : "rule")
                                        </span>
                                    </div>
                                    <div style="min-width: 0;">
                                        <a asp-action="Detail" asp-route-id="@rule.AttendanceRuleId" class="rule-name" title="@rule.RuleName">@rule.RuleName</a>
                                    </div>
                                </div>
                            </td>

                            <!-- Check-in Window -->
                            <td>
                                <div class="window-info">
                                    <span>Early: <strong>@rule.CheckInBeforeMinutes mins</strong></span>
                                    <span class="window-sub">Grace: @rule.CheckInGraceMinutes mins</span>
                                </div>
                            </td>

                            <!-- Check-out Window -->
                            <td>
                                <div class="window-info">
                                    <span>After: <strong>@rule.CheckOutAfterMinutes mins</strong></span>
                                    <span class="window-sub">Grace: @rule.CheckOutGraceMinutes mins</span>
                                </div>
                            </td>

                            <!-- GPS Radius -->
                            <td>
                                <span class="distance-pill">
                                    <span class="material-symbols-outlined text-[15px] text-slate-500">pin_drop</span>
                                    @rule.MaxAttendanceDistanceMeters m
                                </span>
                            </td>

                            <!-- Effective Period -->
                            <td>
                                <div class="period-text">
                                    @(rule.EffectiveFrom.HasValue ? rule.EffectiveFrom.Value.ToString("dd/MM/yyyy") : "Immediately")
                                </div>
                                <div class="period-sub">
                                    @(rule.EffectiveTo.HasValue ? $"to {rule.EffectiveTo.Value:dd/MM/yyyy}" : "Indefinite")
                                </div>
                            </td>

                            <!-- Status -->
                            <td>
                                <span class="pill status @statusLower">
                                    <i class="dot"></i>
                                    @(rule.Status switch
                                    {
                                        "ACTIVE" => "Active",
                                        "SCHEDULED" => "Scheduled",
                                        "DRAFT" => "Draft",
                                        "CANCELLED" => "Cancelled",
                                        "ARCHIVED" => "Archived",
                                        _ => rule.Status
                                    })
                                </span>
                            </td>

                            <!-- Actions -->
                            <td>
                                <div class="actions">
                                    <!-- View Detail -->
                                    <a asp-action="Detail" asp-route-id="@rule.AttendanceRuleId" class="ws-icon-action icon-button" title="View details" aria-label="View details">
                                        <svg viewBox="0 0 24 24"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z"/><circle cx="12" cy="12" r="2.5"/></svg>
                                    </a>

                                    <!-- Edit & Publish (Only Draft) -->
                                    @if (rule.CanEdit)
                                    {
                                        <a asp-action="Edit" asp-route-id="@rule.AttendanceRuleId" class="ws-icon-action icon-button" title="Edit draft" aria-label="Edit draft">
                                            <svg viewBox="0 0 24 24"><path d="m14 5 5 5L8 21H3v-5L14 5Z"/><path d="m12 7 5 5"/></svg>
                                        </a>
                                        <button type="button" class="ws-icon-action icon-button success" title="Publish rule" aria-label="Publish rule" onclick="openPublishRuleModal(@rule.AttendanceRuleId, '@Html.Raw(rule.RuleName.Replace("'", "\\'"))')">
                                            <span class="material-symbols-outlined text-[18px]">publish</span>
                                        </button>
                                    }

                                    <!-- Cancel (Draft or Scheduled) -->
                                    @if (rule.CanCancel)
                                    {
                                        <button type="button" class="ws-icon-action icon-button danger" title="Cancel rule" aria-label="Cancel rule" onclick="openCancelRuleModal(@rule.AttendanceRuleId, '@Html.Raw(rule.RuleName.Replace("'", "\\'"))', '@rule.Status')">
                                            <svg viewBox="0 0 24 24"><path d="M18 6 6 18M6 6l12 12"/></svg>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <!-- Pagination -->
            <partial name="_ListPagination" model="@(new ListPaginationViewModel
            {
                PageNumber = Model.PageNumber,
                PageSize = Model.PageSize,
                TotalItems = Model.TotalItems,
                ItemLabel = "rules",
                PageParameter = "pageNumber",
            })" />
        </div>
    </div>
</section>

@section Scripts {

<script>
    function openCancelRuleModal(id, name, status) {
        document.getElementById('cancelRuleIdInput').value = id;
        document.getElementById('cancelRuleNameText').textContent = name;
        document.getElementById('cancelReasonInput').value = '';

        const isDraft = (status || '').toUpperCase() === 'DRAFT';
        const reasonContainer = document.getElementById('cancelReasonContainer');
        const modalSubtext = document.getElementById('cancelModalSubtext');

        if (reasonContainer) {
            if (isDraft) {
                reasonContainer.classList.add('hidden');
                if (modalSubtext) modalSubtext.textContent = 'Are you sure you want to cancel this draft policy?';
            } else {
                reasonContainer.classList.remove('hidden');
                if (modalSubtext) modalSubtext.textContent = 'Are you sure you want to cancel this scheduled policy? This will revoke its upcoming activation.';
            }
        }
        document.getElementById('cancelRuleModal').classList.remove('hidden');
    }
    function closeCancelRuleModal() {
        document.getElementById('cancelRuleModal').classList.add('hidden');
    }

    function openPublishRuleModal(id, name) {
        document.getElementById('publishRuleIdInput').value = id;
        document.getElementById('publishRuleNameText').textContent = name;
        document.getElementById('publishRuleModal').classList.remove('hidden');
    }
    function closePublishRuleModal() {
        document.getElementById('publishRuleModal').classList.add('hidden');
    }

</script>
}
