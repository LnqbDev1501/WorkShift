@model UI_Admin.Models.Staff.Shifts.StaffShiftListViewModel
@{
    Layout = "_StaffLayout";
    ViewData["Title"] = "Đăng ký ca làm việc";
    var isMySchedule = string.Equals(Model.ActiveTab, "my-schedule", StringComparison.OrdinalIgnoreCase);
}

<div class="p-6 max-w-[1440px] mx-auto space-y-6">
    <!-- Header Banner -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-white p-6 rounded-2xl border border-gray-100 shadow-sm">
        <div>
            <div class="flex items-center gap-2 mb-1.5">
                <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-indigo-50 text-indigo-700 border border-indigo-100">
                    <span class="w-1.5 h-1.5 rounded-full bg-indigo-600 animate-pulse"></span>
                    STAFF PORTAL
                </span>
            </div>
            <h1 class="text-2xl font-bold text-gray-900 tracking-tight">Đăng ký &amp; Lịch làm việc</h1>
            <p class="text-sm text-gray-500 mt-0.5">Chọn các ca mở tại chi nhánh để đăng ký đi làm và theo dõi lịch ca đã được phân công.</p>
        </div>
        <div class="flex items-center gap-2.5 flex-wrap">
            <a asp-controller="StaffEmployeeRequests" asp-action="Create" class="inline-flex items-center gap-1.5 px-4 py-2.5 text-xs font-semibold text-white bg-indigo-600 hover:bg-indigo-700 rounded-xl shadow-sm transition-colors">
                <span class="material-symbols-outlined text-[16px]">pending_actions</span>
                Tạo yêu cầu (Nghỉ/Đổi ca)
            </a>
            <a asp-action="Index" asp-route-tab="@Model.ActiveTab" asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")" asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")" class="inline-flex items-center gap-1.5 px-3.5 py-2.5 text-xs font-semibold text-gray-700 bg-gray-50 hover:bg-gray-100 border border-gray-200 rounded-xl transition-colors">
                <span class="material-symbols-outlined text-[16px]">refresh</span>
                Làm mới
            </a>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="rounded-2xl bg-rose-50 border border-rose-200 p-4 text-rose-700 text-sm flex items-center gap-3">
            <span class="material-symbols-outlined text-rose-600 text-[20px] shrink-0">error</span>
            <span>@Model.ErrorMessage</span>
        </div>
    }

    <!-- Tab Navigation & Filter Bar -->
    <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-4 sm:p-5 space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-gray-100 pb-4">
            <!-- Tabs -->
            <div class="flex items-center gap-2">
                <a asp-action="Index" asp-route-tab="available" asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")" asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")"
                   class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-semibold transition-all @(!isMySchedule ? "bg-indigo-600 text-white shadow-sm shadow-indigo-100" : "text-gray-600 hover:bg-gray-100")">
                    <span class="material-symbols-outlined text-[18px]">event_available</span>
                    <span>Ca có thể đăng ký</span>
                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold @(!isMySchedule ? "bg-white/20 text-white" : "bg-gray-200 text-gray-700")">
                        @Model.AvailableShifts.Count
                    </span>
                </a>

                <a asp-action="Index" asp-route-tab="my-schedule" asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")" asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")"
                   class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-semibold transition-all @(isMySchedule ? "bg-indigo-600 text-white shadow-sm shadow-indigo-100" : "text-gray-600 hover:bg-gray-100")">
                    <span class="material-symbols-outlined text-[18px]">calendar_month</span>
                    <span>Lịch làm của tôi</span>
                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold @(isMySchedule ? "bg-white/20 text-white" : "bg-gray-200 text-gray-700")">
                        @Model.MySchedule.Count
                    </span>
                </a>
            </div>

            <!-- Date Filter Form -->
            <form method="get" asp-action="Index" class="flex items-center gap-2.5 flex-wrap">
                <input type="hidden" name="tab" value="@Model.ActiveTab" />
                <div class="flex items-center gap-2">
                    <label for="fromDate" class="text-xs font-medium text-gray-500 whitespace-nowrap">Từ ngày:</label>
                    <input type="date" id="fromDate" name="fromDate" value="@Model.FromDate?.ToString("yyyy-MM-dd")" class="h-9 px-2.5 rounded-lg border border-gray-200 text-xs text-gray-800 focus:outline-none focus:ring-2 focus:ring-indigo-500" />
                </div>
                <div class="flex items-center gap-2">
                    <label for="toDate" class="text-xs font-medium text-gray-500 whitespace-nowrap">Đến ngày:</label>
                    <input type="date" id="toDate" name="toDate" value="@Model.ToDate?.ToString("yyyy-MM-dd")" class="h-9 px-2.5 rounded-lg border border-gray-200 text-xs text-gray-800 focus:outline-none focus:ring-2 focus:ring-indigo-500" />
                </div>
                <button type="submit" class="h-9 px-3.5 rounded-lg bg-gray-900 hover:bg-black text-white text-xs font-semibold shadow-sm transition-colors cursor-pointer">
                    Lọc ca
                </button>
            </form>
        </div>

        <!-- Tab 1: Available Shifts -->
        @if (!isMySchedule)
        {
            @if (Model.AvailableShifts.Count == 0)
            {
                <div class="py-12 text-center">
                    <span class="material-symbols-outlined text-gray-300 text-[48px] mb-2">event_busy</span>
                    <h3 class="text-sm font-bold text-gray-700">Không có ca làm việc nào mở đăng ký</h3>
                    <p class="text-xs text-gray-500 mt-1 max-w-md mx-auto">
                        Hiện tại chưa có ca làm việc nào mở hoặc đã hết hạn đăng ký trong khoảng thời gian đã chọn. Vui lòng chọn khoảng ngày khác hoặc liên hệ Quản lý chi nhánh.
                    </p>
                </div>
            }
            else
            {
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                    @foreach (var shift in Model.AvailableShifts)
                    {
                        var isRegistered = shift.IsRegistered;
                        var isOverdue = shift.IsRegistrationClosed;

                        <div class="p-5 rounded-2xl border transition-all duration-200 flex flex-col justify-between @(isRegistered ? "border-emerald-200 bg-emerald-50/20 shadow-sm" : "border-gray-200 bg-white hover:border-indigo-300 hover:shadow-md")">
                            <div>
                                <!-- Top Row: Shift Name & Branch -->
                                <div class="flex items-start justify-between gap-2 mb-3">
                                    <div>
                                        <h3 class="font-bold text-gray-900 text-sm">@shift.ShiftName</h3>
                                        <span class="inline-flex items-center gap-1 text-[11px] text-gray-500 mt-0.5">
                                            <span class="material-symbols-outlined text-[13px] text-gray-400">store</span>
                                            @shift.BranchName
                                        </span>
                                    </div>
                                    @if (isRegistered)
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800 border border-emerald-200">
                                            <span class="material-symbols-outlined text-[13px]">check</span>
                                            Đã đăng ký
                                        </span>
                                    }
                                    else if (isOverdue)
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-gray-100 text-gray-600 border border-gray-200">
                                            Hết hạn đăng ký
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-indigo-50 text-indigo-700 border border-indigo-200">
                                            Mở đăng ký
                                        </span>
                                    }
                                </div>

                                <!-- Date & Time -->
                                <div class="space-y-2 bg-gray-50/80 p-3 rounded-xl border border-gray-100 mb-3 text-xs">
                                    <div class="flex items-center gap-2 text-gray-700">
                                        <span class="material-symbols-outlined text-[16px] text-indigo-600">calendar_today</span>
                                        <span class="font-semibold">@shift.DateDisplay</span>
                                    </div>
                                    <div class="flex items-center justify-between text-gray-600">
                                        <div class="flex items-center gap-2">
                                            <span class="material-symbols-outlined text-[16px] text-indigo-600">schedule</span>
                                            <span>@shift.TimeDisplay</span>
                                        </div>
                                        <span class="font-semibold text-indigo-900 bg-indigo-100/60 px-2 py-0.5 rounded">
                                            @shift.DurationHours.ToString("0.#")h
                                        </span>
                                    </div>
                                </div>

                                <!-- Requirements / Remaining slots -->
                                <div class="space-y-1.5 mb-4">
                                    <span class="text-[10px] uppercase font-bold text-gray-400 tracking-wider block">Yêu cầu vị trí:</span>
                                    <div class="flex flex-wrap gap-1.5">
                                        @foreach (var req in shift.EmployeeRequirements)
                                        {
                                            var isFull = req.RemainingCount <= 0;
                                            <span class="inline-flex items-center gap-1 px-2 py-1 rounded-lg text-[11px] font-medium border @(isFull ? "bg-gray-100 text-gray-500 border-gray-200" : "bg-amber-50 text-amber-800 border-amber-200")">
                                                <span>@req.EmployeeTypeName:</span>
                                                <span class="font-bold">@req.AssignedCount/@req.RequiredCount</span>
                                                @if (isFull)
                                                {
                                                    <span class="text-[10px] text-gray-400">(Đủ)</span>
                                                }
                                                else
                                                {
                                                    <span class="text-[10px] text-amber-600 font-bold">(Còn @req.RemainingCount)</span>
                                                }
                                            </span>
                                        }
                                    </div>
                                </div>

                                <!-- Deadline note -->
                                <div class="text-[11px] text-gray-500 flex items-center gap-1 mb-4">
                                    <span class="material-symbols-outlined text-[14px] text-gray-400">timer</span>
                                    <span>Hạn đăng ký: <strong>@shift.DeadlineDisplay</strong></span>
                                </div>
                            </div>

                            <!-- Action button -->
                            <div class="pt-3 border-t border-gray-100">
                                @if (isRegistered && shift.CanCancel)
                                {
                                    <button type="button" onclick="openCancelModal(@shift.ShiftId, '@shift.ShiftName', '@shift.DateDisplay @shift.TimeDisplay')"
                                            class="w-full py-2.5 px-3 rounded-xl border border-rose-200 text-rose-600 hover:bg-rose-50 text-xs font-semibold transition-colors flex items-center justify-center gap-1 cursor-pointer">
                                        <span class="material-symbols-outlined text-[16px]">cancel</span>
                                        Hủy đăng ký ca này
                                    </button>
                                }
                                else if (isRegistered || isOverdue)
                                {
                                    <button type="button" disabled class="w-full py-2.5 px-3 rounded-xl bg-gray-100 text-gray-400 text-xs font-semibold cursor-not-allowed">
                                        @(isRegistered ? "Không thể hủy đăng ký" : "Đăng ký đã đóng")
                                    </button>
                                }
                                else
                                {
                                    <form asp-action="Register" method="post" onsubmit="this.querySelector('button').disabled=true;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="shiftId" value="@shift.ShiftId" />
                                        <input type="hidden" name="tab" value="available" />
                                        <input type="hidden" name="fromDate" value="@Model.FromDate?.ToString("yyyy-MM-dd")" />
                                        <input type="hidden" name="toDate" value="@Model.ToDate?.ToString("yyyy-MM-dd")" />
                                        <button type="submit" class="w-full py-2.5 px-4 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-xs transition-colors flex items-center justify-center gap-1.5 shadow-sm cursor-pointer">
                                            <span class="material-symbols-outlined text-[16px]">how_to_reg</span>
                                            Đăng ký ca làm này
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        }
        else
        {
            <!-- Tab 2: My Schedule -->
            @if (Model.MySchedule.Count == 0)
            {
                <div class="py-12 text-center">
                    <span class="material-symbols-outlined text-gray-300 text-[48px] mb-2">calendar_today</span>
                    <h3 class="text-sm font-bold text-gray-700">Chưa có ca làm việc nào trong lịch</h3>
                    <p class="text-xs text-gray-500 mt-1 max-w-md mx-auto">
                        Bạn chưa đăng ký hoặc chưa được xếp ca làm nào trong khoảng thời gian này. Hãy chuyển sang tab <strong>Ca có thể đăng ký</strong> để chọn ca phù hợp.
                    </p>
                    <div class="mt-4">
                        <a asp-action="Index" asp-route-tab="available" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-indigo-600 text-white text-xs font-semibold shadow-sm hover:bg-indigo-700 transition-colors">
                            <span class="material-symbols-outlined text-[16px]">how_to_reg</span>
                            Xem ca có thể đăng ký
                        </a>
                    </div>
                </div>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="border-b border-gray-100 text-[11px] font-bold uppercase tracking-wider text-gray-400 bg-gray-50/50">
                                <th class="py-3 px-4">Ca làm việc</th>
                                <th class="py-3 px-4">Ngày làm</th>
                                <th class="py-3 px-4">Thời gian</th>
                                <th class="py-3 px-4">Thời lượng</th>
                                <th class="py-3 px-4">Chi nhánh</th>
                                <th class="py-3 px-4">Trạng thái</th>
                                <th class="py-3 px-4 text-right">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100 text-xs">
                            @foreach (var shift in Model.MySchedule)
                            {
                                <tr class="hover:bg-gray-50/60 transition-colors">
                                    <td class="py-3.5 px-4 font-bold text-gray-900">
                                        @shift.ShiftName
                                    </td>
                                    <td class="py-3.5 px-4 text-gray-700 font-semibold">
                                        @shift.DateDisplay
                                    </td>
                                    <td class="py-3.5 px-4 text-gray-600 font-mono">
                                        @shift.TimeDisplay
                                    </td>
                                    <td class="py-3.5 px-4 text-gray-600">
                                        <span class="bg-indigo-50 text-indigo-700 font-bold px-2 py-0.5 rounded text-[11px]">
                                            @shift.DurationHours.ToString("0.#")h
                                        </span>
                                    </td>
                                    <td class="py-3.5 px-4 text-gray-600">
                                        @shift.BranchName
                                    </td>
                                    <td class="py-3.5 px-4">
                                        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800 border border-emerald-200">
                                            <span class="material-symbols-outlined text-[13px]">check</span>
                                            ASSIGNED
                                        </span>
                                    </td>
                                    <td class="py-3.5 px-4 text-right">
                                        <div class="flex items-center justify-end gap-2">
                                            <!-- Request button: View request feature for this shift! -->
                                            <a asp-controller="StaffEmployeeRequests" asp-action="Create"
                                               class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg bg-indigo-50 text-indigo-700 hover:bg-indigo-100 font-semibold text-[11px] transition-colors"
                                               title="Gửi đơn xin nghỉ hoặc đổi ca làm này">
                                                <span class="material-symbols-outlined text-[14px]">pending_actions</span>
                                                Gửi đơn
                                            </a>

                                            <!-- Cancel button -->
                                            @if (shift.CanCancel)
                                            {
                                            <button type="button" onclick="openCancelModal(@shift.ShiftId, '@shift.ShiftName', '@shift.DateDisplay @shift.TimeDisplay')"
                                                    class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg border border-rose-200 text-rose-600 hover:bg-rose-50 font-semibold text-[11px] transition-colors cursor-pointer"
                                                    title="Hủy đăng ký ca này">
                                                <span class="material-symbols-outlined text-[14px]">cancel</span>
                                                Hủy ca
                                            </button>
                                            }
                                            else
                                            {
                                                <span class="text-[11px] text-gray-500" title="@shift.CancellationBlockedReason">Không thể hủy đăng ký</span>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
    </div>
</div>

<!-- Modal: Hủy đăng ký ca làm -->
<div id="cancel-shift-modal" class="fixed inset-0 z-50 hidden bg-black/50 backdrop-blur-xs flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-md w-full p-6 space-y-4 shadow-xl border border-gray-100 animate-scale-in">
        <div class="flex items-center justify-between pb-3 border-b border-gray-100">
            <div class="flex items-center gap-2 text-rose-600 font-bold text-base">
                <span class="material-symbols-outlined text-[22px]">warning</span>
                <h3>Hủy đăng ký ca làm</h3>
            </div>
            <button type="button" onclick="closeCancelModal()" class="text-gray-400 hover:text-gray-600 text-lg leading-none cursor-pointer">×</button>
        </div>

        <div>
            <p class="text-xs text-gray-600 leading-relaxed">
                Bạn có chắc chắn muốn hủy đăng ký ca làm:
                <strong id="modal-shift-name" class="text-gray-900 block font-semibold mt-1"></strong>
                <span id="modal-shift-time" class="text-[11px] text-gray-500 block"></span>
            </p>
        </div>

        <form asp-action="Cancel" method="post" id="cancel-form" class="space-y-4">
            @Html.AntiForgeryToken()
            <input type="hidden" name="shiftId" id="modal-shift-id" />
            <input type="hidden" name="tab" value="@Model.ActiveTab" />
            <input type="hidden" name="fromDate" value="@Model.FromDate?.ToString("yyyy-MM-dd")" />
            <input type="hidden" name="toDate" value="@Model.ToDate?.ToString("yyyy-MM-dd")" />

            <div>
                <label for="cancel-reason" class="block text-xs font-semibold text-gray-700 mb-1">
                    Lý do hủy ca <span class="text-rose-600">*</span>
                </label>
                <textarea id="cancel-reason" name="reason" rows="3" required maxlength="500" placeholder="Vui lòng nhập lý do hủy ca (bắt buộc)..."
                          class="w-full p-3 rounded-xl border border-gray-300 text-xs text-gray-800 focus:outline-none focus:ring-2 focus:ring-rose-500 focus:border-rose-500"></textarea>
            </div>

            <div class="flex items-center justify-end gap-2.5 pt-2 border-t border-gray-100">
                <button type="button" onclick="closeCancelModal()" class="px-4 py-2 rounded-xl border border-gray-200 text-gray-600 text-xs font-semibold hover:bg-gray-50 transition-colors cursor-pointer">
                    Đóng
                </button>
                <button type="submit" class="px-4 py-2 rounded-xl bg-rose-600 hover:bg-rose-700 text-white text-xs font-semibold transition-colors shadow-sm cursor-pointer">
                    Xác nhận hủy ca
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    function openCancelModal(shiftId, shiftName, shiftTime) {
        document.getElementById('modal-shift-id').value = shiftId;
        document.getElementById('modal-shift-name').textContent = shiftName;
        document.getElementById('modal-shift-time').textContent = shiftTime;
        document.getElementById('cancel-reason').value = '';
        document.getElementById('cancel-shift-modal').classList.remove('hidden');
    }

    function closeCancelModal() {
        document.getElementById('cancel-shift-modal').classList.add('hidden');
    }
</script>
}
