@model UI_Admin.Models.Accountant.PayrollSettlement.CarryForwardListViewModel
@using D = UI_Admin.Models.Accountant.PayrollPeriods.PeriodDisplay
@{
    ViewData["Title"] = "Quản Lý Khoản Chuyển Kỳ (Carry Forward Deductions)";
}
@section Styles {
    <link rel="stylesheet" href="~/css/payroll.css" asp-append-version="true" />
}

<div class="payroll-page">
    <header class="payroll-heading">
        <div>
            <div class="list-eyebrow">CARRY FORWARD · GIẢM TRỪ CHUYỂN KỲ</div>
            <h1>Danh Sách Khoản Chuyển Kỳ (Carry Forward)</h1>
            <p>Theo dõi các khoản giảm trừ chưa khấu trừ hết được chuyển tiếp sang các kỳ lương sau.</p>
        </div>
        <div class="flex flex-wrap gap-2">
            <a asp-controller="AccountantPayrollPeriods" asp-action="Index" class="payroll-button">Quản lý kỳ lương</a>
        </div>
    </header>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="payroll-message error" role="alert">@Model.ErrorMessage</div>
    }

    <section class="bg-surface-container-lowest rounded-xl p-5 mb-5 shadow-sm">
        <form method="get" class="flex flex-wrap gap-4 items-end">
            <div>
                <label class="block text-xs font-semibold text-secondary uppercase tracking-wider mb-1">Tìm kiếm</label>
                <input type="text" name="Keyword" value="@Model.Query.Keyword" placeholder="Tên nhân viên, lý do..." class="border rounded-xl p-2.5 text-sm w-64" />
            </div>
            <div>
                <label class="block text-xs font-semibold text-secondary uppercase tracking-wider mb-1">Trạng thái</label>
                <select name="Status" class="border rounded-xl p-2.5 text-sm">
                    <option value="">Tất cả trạng thái</option>
                    <option value="OPEN" selected="@(Model.Query.Status == "OPEN")">OPEN (Chưa trừ)</option>
                    <option value="PARTIALLY_APPLIED" selected="@(Model.Query.Status == "PARTIALLY_APPLIED")">PARTIALLY_APPLIED (Đã trừ một phần)</option>
                    <option value="SETTLED" selected="@(Model.Query.Status == "SETTLED")">SETTLED (Đã trừ hết)</option>
                </select>
            </div>
            <button type="submit" class="payroll-button primary">Lọc dữ liệu</button>
            <a asp-action="Index" class="payroll-button">Đặt lại</a>
        </form>
    </section>

    <section class="payroll-table-card">
        <div class="payroll-table-toolbar">
            <strong>Khoản giảm trừ chuyển kỳ (@Model.Data.TotalItems khoản)</strong>
            <span>Trang @Model.Data.Page / @Math.Max(1, (int)Math.Ceiling(Model.Data.TotalItems / (double)Model.Data.PageSize))</span>
        </div>
        <div class="payroll-table-scroll">
            <table>
                <thead>
                    <tr>
                        <th>NHÂN VIÊN</th>
                        <th>KỲ NGUỒN</th>
                        <th>KHOẢN GIẢM TRỪ GỐC</th>
                        <th class="money">SỐ TIỀN GỐC</th>
                        <th class="money">ĐÃ TRỪ</th>
                        <th class="money">CÒN LẠI</th>
                        <th>TRẠNG THÁI</th>
                        <th>THAO TÁC</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Data.Items)
                    {
                        <tr>
                            <td>
                                <strong>@item.EmployeeName</strong>
                                <small class="text-xs text-secondary">ID: @item.UserId</small>
                            </td>
                            <td>
                                <strong>@item.SourcePeriodCode</strong>
                                <small class="text-xs text-secondary">Payroll #@item.SourcePayrollId · V@(item.SourcePayrollVersionNo)</small>
                            </td>
                            <td>
                                <strong>@item.SourceDetailDescription</strong>
                                <small class="text-xs text-secondary">@item.SourceDetailType · @item.Reason</small>
                            </td>
                            <td class="money">@D.Money(item.OriginalAmount)</td>
                            <td class="money text-emerald-700">@D.Money(item.TotalAppliedAmount)</td>
                            <td class="money text-red-700"><strong>@D.Money(item.RemainingAmount)</strong></td>
                            <td>
                                <span class="payroll-status @item.Status.ToLowerInvariant()">@item.Status.Replace('_', ' ')</span>
                            </td>
                            <td>
                                <a asp-action="Details" asp-route-id="@item.CarryForwardId" class="payroll-button">Xem Chi Tiết &amp; Lịch Sử</a>
                            </td>
                        </tr>
                    }
                    @if (Model.Data.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="8" class="payroll-empty">Không có khoản chuyển kỳ (Carry Forward) nào.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>
