@model UI_Admin.Models.Accountant.PayrollSettlement.CarryForwardDetailViewModel
@using D = UI_Admin.Models.Accountant.PayrollPeriods.PeriodDisplay
@{
    ViewData["Title"] = $"Carry Forward #{Model.Item.CarryForwardId} — {Model.Item.EmployeeName}";
}

<div class="px-7 py-6 max-w-[1400px] mx-auto space-y-6">
    <!-- Header Title & Action Bar -->
    <div class="flex flex-col md:flex-row md:items-start justify-between gap-4">
        <div>
            <div class="flex items-center gap-1.5 text-xs text-indigo-600 font-semibold uppercase tracking-wider mb-1">
                <span class="material-symbols-outlined text-sm">trending_down</span>
                <span>Payroll / Carry Forward Details</span>
            </div>
            <div class="flex items-center gap-3 flex-wrap">
                <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Carry Forward #@Model.Item.CarryForwardId — @Model.Item.EmployeeName</h1>
                @if (Model.Item.Status == "OPEN")
                {
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-amber-50 text-amber-700 border border-amber-200">
                        OPEN
                    </span>
                }
                else if (Model.Item.Status == "PARTIALLY_APPLIED")
                {
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-blue-50 text-blue-700 border border-blue-200">
                        PARTIALLY APPLIED
                    </span>
                }
                else if (Model.Item.Status == "SETTLED")
                {
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                        SETTLED
                    </span>
                }
                else
                {
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-slate-100 text-slate-700 border border-slate-200">
                        @Model.Item.Status
                    </span>
                }
            </div>
            <p class="text-sm text-slate-500 mt-1 flex flex-wrap items-center gap-2">
                <span>Employee ID: <strong class="text-slate-800">@Model.Item.UserId</strong></span>
                <span>•</span>
                <span>Source Period: <strong class="text-slate-800">@Model.Item.SourcePeriodCode</strong></span>
                <span>•</span>
                <span>Payroll #@Model.Item.SourcePayrollId · V@(Model.Item.SourcePayrollVersionNo)</span>
            </p>
        </div>

        <div class="flex items-center gap-3 shrink-0">
            <a asp-action="CarryForward"
               class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-white hover:bg-slate-50 text-slate-700 hover:text-slate-900 border border-slate-200 text-sm font-medium transition-all shadow-sm">
                <span class="material-symbols-outlined text-lg">arrow_back</span>
                <span>Back to Carry Forward</span>
            </a>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-sm flex items-center gap-3 shadow-sm">
            <span class="material-symbols-outlined text-rose-600 text-xl shrink-0">error</span>
            <span class="font-medium">@Model.ErrorMessage</span>
        </div>
    }

    <!-- 4 KPI Summary Cards (Manager Style) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm flex flex-col justify-between">
            <div class="flex items-center justify-between text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">
                <span>Original Amount</span>
                <span class="material-symbols-outlined text-indigo-600 text-lg">receipt</span>
            </div>
            <div>
                <div class="text-2xl font-bold text-slate-900 tracking-tight">@D.Money(Model.Item.OriginalAmount)</div>
                <div class="text-xs text-slate-400 mt-1">@Model.Item.SourceDetailType</div>
            </div>
        </div>

        <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm flex flex-col justify-between">
            <div class="flex items-center justify-between text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">
                <span>Total Deducted</span>
                <span class="material-symbols-outlined text-emerald-600 text-lg">check_circle</span>
            </div>
            <div>
                <div class="text-2xl font-bold text-emerald-700 tracking-tight">@D.Money(Model.Item.TotalAppliedAmount)</div>
                <div class="text-xs text-slate-400 mt-1">Across @Model.Applications.TotalItems period(s)</div>
            </div>
        </div>

        <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm flex flex-col justify-between">
            <div class="flex items-center justify-between text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">
                <span>Remaining Balance</span>
                <span class="material-symbols-outlined text-rose-600 text-lg">pending</span>
            </div>
            <div>
                <div class="text-2xl font-bold text-rose-700 tracking-tight">@D.Money(Model.Item.RemainingAmount)</div>
                <div class="text-xs text-slate-400 mt-1">Due for subsequent deduction</div>
            </div>
        </div>

        <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm flex flex-col justify-between">
            <div class="flex items-center justify-between text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">
                <span>Recovery Status</span>
                <span class="material-symbols-outlined text-indigo-600 text-lg">verified</span>
            </div>
            <div>
                <div class="text-2xl font-bold text-slate-900 tracking-tight">@Model.Item.Status.Replace('_', ' ')</div>
                <div class="text-xs text-slate-400 mt-1">FIFO deduction policy</div>
            </div>
        </div>
    </div>

    <!-- Deduction Source Snapshot Card -->
    <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm space-y-4">
        <div class="flex items-center gap-2 border-b border-slate-100 pb-3">
            <span class="material-symbols-outlined text-indigo-600 text-lg">info</span>
            <h2 class="text-xs font-bold text-slate-900 uppercase tracking-wider">Original Deduction Details</h2>
        </div>

        <dl class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4 text-xs">
            <div class="p-3 rounded-xl bg-slate-50 border border-slate-100">
                <dt class="text-slate-500 font-medium">Source Description</dt>
                <dd class="text-sm font-bold text-slate-900 mt-0.5">@Model.Item.SourceDetailDescription</dd>
            </div>
            <div class="p-3 rounded-xl bg-slate-50 border border-slate-100">
                <dt class="text-slate-500 font-medium">Underlying Reason</dt>
                <dd class="text-sm font-bold text-slate-900 mt-0.5">@Model.Item.Reason</dd>
            </div>
            <div class="p-3 rounded-xl bg-slate-50 border border-slate-100">
                <dt class="text-slate-500 font-medium">Source Period</dt>
                <dd class="text-sm font-bold text-indigo-600 mt-0.5">
                    <a asp-action="Details" asp-route-id="@Model.Item.SourcePayrollPeriodId" class="hover:underline">
                        @Model.Item.SourcePeriodCode
                    </a>
                </dd>
            </div>
        </dl>
    </div>

    <!-- Application History Table Card -->
    <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden">
        <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between bg-slate-50/60">
            <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-indigo-600 text-lg">history</span>
                <h3 class="text-sm font-bold text-slate-900">Deduction Recovery History</h3>
            </div>
            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold bg-indigo-50 text-indigo-700 border border-indigo-200">
                @Model.Applications.TotalItems @(Model.Applications.TotalItems == 1 ? "Application" : "Applications")
            </span>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-xs">
                <thead>
                    <tr class="border-b border-slate-150 bg-slate-50/50 text-[11px] font-bold text-slate-500 uppercase tracking-wider">
                        <th class="py-3.5 px-6">Application ID</th>
                        <th class="py-3.5 px-6">Applied Period</th>
                        <th class="py-3.5 px-6">Period Dates</th>
                        <th class="py-3.5 px-6 text-right font-bold text-indigo-900">Deducted Amount</th>
                        <th class="py-3.5 px-6">Applied At (UTC+7)</th>
                        <th class="py-3.5 px-6 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 text-sm">
                    @foreach (var app in Model.Applications.Items)
                    {
                        <tr class="hover:bg-slate-50/80 transition-colors">
                            <td class="py-4 px-6 font-mono font-semibold text-slate-900">
                                #@app.ApplicationId
                            </td>
                            <td class="py-4 px-6">
                                <div class="font-medium text-slate-800">@app.PeriodCode</div>
                                <div class="text-xs text-slate-400 mt-0.5">Payroll #@app.PayrollId · V@(app.PayrollVersionNo)</div>
                            </td>
                            <td class="py-4 px-6 text-xs text-slate-600">
                                @app.PeriodStart.ToString("dd/MM/yyyy") – @app.PeriodEnd.ToString("dd/MM/yyyy")
                            </td>
                            <td class="py-4 px-6 text-right font-bold text-emerald-600">
                                -@D.Money(app.AppliedAmount)
                            </td>
                            <td class="py-4 px-6 text-xs text-slate-600">
                                @app.AppliedAt.AddHours(7).ToString("dd/MM/yyyy HH:mm")
                            </td>
                            <td class="py-4 px-6 text-right">
                                <a asp-controller="AccountantPayrollPeriods" asp-action="Details" asp-route-id="@app.PayrollPeriodId"
                                   class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold transition-all">
                                    <span class="material-symbols-outlined text-sm">visibility</span>
                                    <span>View Period</span>
                                </a>
                            </td>
                        </tr>
                    }
                    @if (Model.Applications.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="p-8 text-center text-slate-400 text-xs">
                                No deduction applications recorded for this carry forward record yet.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
