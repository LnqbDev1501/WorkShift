@model UI_Admin.Models.Accountant.PayrollPeriods.PeriodListViewModel
@using D = UI_Admin.Models.Accountant.PayrollPeriods.PeriodDisplay
@{
    ViewData["Title"] = "Payroll Periods";
}

<div class="px-7 py-6 max-w-[1400px] mx-auto space-y-6">
    <!-- Header Title & Action Bar -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-1.5 text-xs text-indigo-600 font-semibold uppercase tracking-wider mb-1">
                <span class="material-symbols-outlined text-sm">calendar_month</span>
                <span>Payroll / Period Management</span>
            </div>
            <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Payroll Periods</h1>
            <p class="text-sm text-slate-500 mt-0.5">Manage weekly payroll periods, track source readiness, and submit periods for approval.</p>
        </div>
        <div class="flex items-center gap-3">
            <a asp-action="Create"
               class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold shadow-sm transition-all">
                <span class="material-symbols-outlined text-base">add</span>
                <span>Create Draft Period</span>
            </a>
        </div>
    </div>

    <!-- Alert Notifications -->
    @if (Model.Error != null || TempData["PeriodError"] is string)
    {
        <div class="p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-sm flex items-center gap-3 shadow-sm">
            <span class="material-symbols-outlined text-rose-600 text-xl shrink-0">error</span>
            <span class="font-medium">@(Model.Error ?? TempData["PeriodError"]?.ToString())</span>
        </div>
    }
    @if (TempData["PeriodSuccess"] is string success)
    {
        <div class="p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm flex items-center gap-3 shadow-sm">
            <span class="material-symbols-outlined text-emerald-600 text-xl shrink-0">check_circle</span>
            <span class="font-medium">@success</span>
        </div>
    }

    <!-- Stat Metric Cards (4-Grid) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm flex flex-col justify-between">
            <div class="flex items-center justify-between text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">
                <span>Total Periods</span>
                <span class="material-symbols-outlined text-indigo-600 text-lg">date_range</span>
            </div>
            <div>
                <div class="text-2xl font-bold text-slate-900 tracking-tight">@Model.Page.TotalItems.ToString("N0")</div>
                <div class="text-xs text-slate-400 mt-1">Matching current filters</div>
            </div>
        </div>

        <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm flex flex-col justify-between">
            <div class="flex items-center justify-between text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">
                <span>Draft Periods</span>
                <span class="material-symbols-outlined text-amber-600 text-lg">edit_note</span>
            </div>
            <div>
                <div class="text-2xl font-bold text-amber-700 tracking-tight">@Model.Page.Items.Count(p => p.Status == "DRAFT")</div>
                <div class="text-xs text-slate-400 mt-1">On current page</div>
            </div>
        </div>

        <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm flex flex-col justify-between">
            <div class="flex items-center justify-between text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">
                <span>Open Periods</span>
                <span class="material-symbols-outlined text-blue-600 text-lg">lock_open</span>
            </div>
            <div>
                <div class="text-2xl font-bold text-blue-700 tracking-tight">@Model.Page.Items.Count(p => p.Status == "OPEN")</div>
                <div class="text-xs text-slate-400 mt-1">Ready for calculation</div>
            </div>
        </div>

        <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm flex flex-col justify-between">
            <div class="flex items-center justify-between text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">
                <span>Closed Periods</span>
                <span class="material-symbols-outlined text-emerald-600 text-lg">task_alt</span>
            </div>
            <div>
                <div class="text-2xl font-bold text-emerald-700 tracking-tight">@Model.Page.Items.Count(p => p.Status == "CLOSED")</div>
                <div class="text-xs text-slate-400 mt-1">Completed &amp; settled</div>
            </div>
        </div>
    </div>

    <!-- Search & Filter Card (Manager Style) -->
    <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm">
        <form method="get" asp-action="Index" class="grid grid-cols-1 md:grid-cols-12 gap-4 items-end">
            <!-- Search Input -->
            <div class="md:col-span-4">
                <label for="search" class="block text-xs font-semibold text-slate-600 uppercase tracking-wider mb-2 truncate">Search Period</label>
                <div class="relative flex items-center">
                    <span class="material-symbols-outlined absolute left-3.5 pointer-events-none text-slate-400 text-lg">search</span>
                    <input type="text" id="search" name="Search" value="@Model.Query.Search" maxlength="200" placeholder="Search period code or name..."
                           class="w-full h-11 pl-10 pr-4 bg-slate-50/50 hover:bg-white focus:bg-white border border-slate-200 rounded-xl text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 transition-all box-border" />
                </div>
            </div>

            <!-- Status Filter -->
            <div class="md:col-span-3">
                <label for="status" class="block text-xs font-semibold text-slate-600 uppercase tracking-wider mb-2 truncate">Status</label>
                <select id="status" name="Status"
                        class="w-full h-11 px-3.5 bg-slate-50/50 hover:bg-white focus:bg-white border border-slate-200 rounded-xl text-sm text-slate-800 focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 transition-all cursor-pointer box-border">
                    <option value="" selected="@(string.IsNullOrEmpty(Model.Query.Status))">All Statuses</option>
                    @foreach (var s in D.Statuses)
                    {
                        <option value="@s" selected="@(Model.Query.Status == s)">@s.Replace('_', ' ')</option>
                    }
                </select>
            </div>

            <!-- Date Range Filter -->
            <div class="md:col-span-3 grid grid-cols-2 gap-2">
                <div>
                    <label for="startDateFrom" class="block text-xs font-semibold text-slate-600 uppercase tracking-wider mb-2 truncate">From</label>
                    <input type="date" id="startDateFrom" name="StartDateFrom" value="@Model.Query.StartDateFrom?.ToString("yyyy-MM-dd")"
                           class="w-full h-11 px-2.5 bg-slate-50/50 hover:bg-white focus:bg-white border border-slate-200 rounded-xl text-xs text-slate-800 focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 transition-all box-border" />
                </div>
                <div>
                    <label for="startDateTo" class="block text-xs font-semibold text-slate-600 uppercase tracking-wider mb-2 truncate">To</label>
                    <input type="date" id="startDateTo" name="StartDateTo" value="@Model.Query.StartDateTo?.ToString("yyyy-MM-dd")"
                           class="w-full h-11 px-2.5 bg-slate-50/50 hover:bg-white focus:bg-white border border-slate-200 rounded-xl text-xs text-slate-800 focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 transition-all box-border" />
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="md:col-span-2 flex items-center gap-2">
                <button type="submit" class="flex-1 h-11 inline-flex items-center justify-center gap-1.5 px-3 bg-indigo-600 hover:bg-indigo-700 active:bg-indigo-800 text-white rounded-xl text-sm font-semibold shadow-sm transition-all cursor-pointer box-border">
                    <span class="material-symbols-outlined text-base">filter_alt</span>
                    <span>Filter</span>
                </button>
                <a asp-action="Index" class="h-11 w-11 shrink-0 inline-flex items-center justify-center bg-slate-100 hover:bg-slate-200 text-slate-600 hover:text-slate-900 rounded-xl text-sm transition-all box-border" title="Reset Filters">
                    <span class="material-symbols-outlined text-base">restart_alt</span>
                </a>
            </div>
        </form>
    </div>

    <!-- Table Card (Manager Style) -->
    <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden">
        <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between bg-slate-50/60">
            <div class="flex items-center gap-2.5">
                <span class="material-symbols-outlined text-indigo-600 text-xl">calendar_view_week</span>
                <h2 class="text-sm font-bold text-slate-900">Payroll Periods</h2>
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold bg-indigo-50 text-indigo-700 border border-indigo-200">
                    @Model.Page.TotalItems @(Model.Page.TotalItems == 1 ? "Period" : "Periods")
                </span>
            </div>
        </div>

        @if (Model.Page.Items.Count == 0)
        {
            <div class="p-12 text-center">
                <div class="w-14 h-14 bg-slate-100 rounded-2xl flex items-center justify-center mx-auto mb-4 text-slate-400">
                    <span class="material-symbols-outlined text-3xl">calendar_today</span>
                </div>
                <h3 class="text-base font-bold text-slate-900">No Payroll Periods Found</h3>
                <p class="text-xs text-slate-500 max-w-sm mx-auto mt-1">Try another search or create a new draft period to begin.</p>
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="border-b border-slate-150 bg-slate-50/50 text-[11px] font-bold text-slate-500 uppercase tracking-wider">
                            <th class="py-3.5 px-6">Period</th>
                            <th class="py-3.5 px-6">Branch</th>
                            <th class="py-3.5 px-6">Work Week</th>
                            <th class="py-3.5 px-6">Staff / Timesheets</th>
                            <th class="py-3.5 px-6 text-right">Net Salary</th>
                            <th class="py-3.5 px-6">Status</th>
                            <th class="py-3.5 px-6 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 text-sm">
                        @foreach (var p in Model.Page.Items)
                        {
                            <tr class="hover:bg-slate-50/80 transition-colors">
                                <!-- Period -->
                                <td class="py-4 px-6">
                                    <div class="font-semibold text-slate-900">@p.PeriodCode</div>
                                    <div class="text-xs text-slate-400 mt-0.5">@p.PeriodName</div>
                                </td>

                                <!-- Branch -->
                                <td class="py-4 px-6 font-medium text-slate-800">
                                    @p.BranchName
                                </td>

                                <!-- Work Week -->
                                <td class="py-4 px-6 text-xs text-slate-600">
                                    @p.StartDate.ToString("dd/MM/yyyy") – @p.EndDate.ToString("dd/MM/yyyy")
                                </td>

                                <!-- Staff / Timesheets -->
                                <td class="py-4 px-6">
                                    <div class="font-medium text-slate-900">@p.ExpectedEmployeeCount Staff</div>
                                    <div class="text-xs text-slate-400 mt-0.5">@p.TotalPayrolls payrolls • @p.LockedTimesheetCount locked</div>
                                </td>

                                <!-- Net Salary -->
                                <td class="py-4 px-6 text-right font-bold text-slate-900">
                                    @D.Money(p.TotalNetSalary)
                                </td>

                                <!-- Status -->
                                <td class="py-4 px-6">
                                    @if (p.Status == "DRAFT")
                                    {
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-slate-100 text-slate-700 border border-slate-200">
                                            DRAFT
                                        </span>
                                    }
                                    else if (p.Status == "OPEN")
                                    {
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-blue-50 text-blue-700 border border-blue-200">
                                            OPEN
                                        </span>
                                    }
                                    else if (p.Status == "CALCULATED")
                                    {
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-sky-50 text-sky-700 border border-sky-200">
                                            CALCULATED
                                        </span>
                                    }
                                    else if (p.Status == "SUBMITTED")
                                    {
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-amber-50 text-amber-700 border border-amber-200">
                                            SUBMITTED
                                        </span>
                                    }
                                    else if (p.Status == "APPROVED")
                                    {
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                                            APPROVED
                                        </span>
                                    }
                                    else if (p.Status == "PAID")
                                    {
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-teal-50 text-teal-700 border border-teal-200">
                                            PAID
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-slate-100 text-slate-700 border border-slate-200">
                                            @p.Status.Replace('_', ' ')
                                        </span>
                                    }
                                </td>

                                <!-- Actions -->
                                <td class="py-4 px-6 text-right">
                                    <a asp-action="Details" asp-route-id="@p.PayrollPeriodId"
                                       class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold transition-all">
                                        <span class="material-symbols-outlined text-sm">visibility</span>
                                        <span>Details</span>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        @if (Model.Error == null && ViewData.ModelState.IsValid && Model.Page.TotalItems > Model.Page.PageSize)
        {
            <div class="px-6 py-4 border-t border-slate-100 bg-slate-50/50">
                <partial name="_ListPagination" model='@(new ListPaginationViewModel { PageNumber = Model.Page.PageNumber, PageSize = Model.Page.PageSize, TotalItems = Model.Page.TotalItems, PageParameter = "pageNumber", ItemLabel = "periods" })' />
            </div>
        }
    </div>
</div>
