@model UI_Admin.Models.Accountant.PayrollPeriods.PeriodForm
@{ var edit = Model.Id > 0; ViewData["Title"] = edit ? "Edit Draft Payroll Period" : "Create Payroll Period"; }
<div class="flex flex-col gap-unit-4 px-7 py-4">
    <header class="form-heading"><div class="list-eyebrow">PAYROLL · PERIOD MANAGEMENT</div><h1 class="text-display-lg font-display-lg">@ViewData["Title"]</h1><p>Select a work schedule week. The branch, dates, code and approval deadline are assigned by the system.</p></header>
    <form method="post" asp-action="@(edit ? "Edit" : "Create")" asp-route-id="@(edit ? Model.Id : (int?)null)" class="bg-surface-container-lowest rounded-xl shadow-sm p-5 max-w-3xl">
        <input asp-for="Id" type="hidden" />
        <div asp-validation-summary="All" class="text-red-700 mb-4" role="alert"></div>
        <div class="mb-5"><label asp-for="PeriodName" class="block text-label-md text-secondary mb-1">Period name</label><input asp-for="PeriodName" maxlength="200" required class="w-full h-[40px] px-3 border border-surface-container-high rounded-xl" /><span asp-validation-for="PeriodName" class="text-red-700 text-xs"></span></div>
        <div class="mb-5"><label asp-for="ScheduleWeekId" class="block text-label-md text-secondary mb-1">Work schedule week</label><select asp-for="ScheduleWeekId" required class="w-full h-[40px] px-3 border border-surface-container-high rounded-xl"><option value="">Choose a week</option>@foreach (var w in Model.Weeks) { <option value="@w.ScheduleWeekId">@w.WeekStartDate.ToString("dd/MM/yyyy") – @w.WeekEndDate.ToString("dd/MM/yyyy") · Week #@w.ScheduleWeekId · @w.Status</option> }</select><span asp-validation-for="ScheduleWeekId" class="text-red-700 text-xs"></span></div>
        @if (Model.WeeksLoaded && Model.Weeks.Count == 0) { <p class="text-secondary mb-4">No available work schedule weeks. A week that already has a payroll period cannot be selected.</p> }
        <p class="text-secondary mb-5 text-body-md">A new period starts as DRAFT. Editing/deleting is allowed only while the API permits it. Opening the period locks its configuration.</p>
        <div class="flex gap-3"><button type="submit" disabled="@(!Model.WeeksLoaded || Model.Weeks.Count == 0)" class="px-5 py-2 rounded-xl bg-primary-container text-white disabled:opacity-50">@(edit ? "Save Draft" : "Create Draft")</button><a asp-action="@(edit ? "Details" : "Index")" asp-route-id="@(edit ? Model.Id : (int?)null)" class="px-5 py-2 rounded-xl border border-surface-container-high">Back</a></div>
    </form>
</div>
