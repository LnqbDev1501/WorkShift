@model UI_Admin.Models.EmploymentContracts.EmploymentContractDetailViewModel

@{
    ViewData["Title"] = $"Contract {Model.ContractNumber} - Details";
    var statusUpper = Model.Status?.ToUpperInvariant() ?? "DRAFT";
}

<div class="flex flex-col w-full px-7 py-4">
    <partial name="_NotificationModal" />

    <!-- Navigation Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6">
        <div class="flex items-center gap-3">
            <a asp-controller="EmploymentContracts" asp-action="Index"
               class="inline-flex items-center justify-center w-9 h-9 rounded-xl bg-surface-container hover:bg-surface-container-high text-on-surface transition-colors shrink-0"
               title="Back to Employment Contracts">
                <span class="material-symbols-outlined text-[20px]">arrow_back</span>
            </a>
            <div>
                <div class="flex items-center gap-2">
                    <h1 class="text-display-md font-bold tracking-tight text-on-surface">Contract Details</h1>
                    @switch (statusUpper)
                    {
                        case "DRAFT":
                            <span class="inline-flex items-center gap-1.5 px-3 py-0.5 rounded-full text-label-sm bg-amber-50 text-amber-700 border border-amber-200 font-semibold">
                                <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>Draft
                            </span>
                            break;
                        case "PENDING_APPROVAL":
                            <span class="inline-flex items-center gap-1.5 px-3 py-0.5 rounded-full text-label-sm bg-purple-50 text-purple-700 border border-purple-200 font-semibold">
                                <span class="w-1.5 h-1.5 rounded-full bg-purple-500 animate-pulse"></span>Pending Approval
                            </span>
                            break;
                        case "APPROVED":
                            <span class="inline-flex items-center gap-1.5 px-3 py-0.5 rounded-full text-label-sm bg-blue-50 text-blue-700 border border-blue-200 font-semibold">
                                <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>Approved
                            </span>
                            break;
                        case "ACTIVE":
                            <span class="inline-flex items-center gap-1.5 px-3 py-0.5 rounded-full text-label-sm bg-emerald-50 text-emerald-700 border border-emerald-200 font-semibold">
                                <span class="w-1.5 h-1.5 rounded-full bg-emerald-600 animate-pulse"></span>Active
                            </span>
                            break;
                        case "REJECTED":
                            <span class="inline-flex items-center gap-1.5 px-3 py-0.5 rounded-full text-label-sm bg-rose-50 text-rose-700 border border-rose-200 font-semibold">
                                <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>Rejected
                            </span>
                            break;
                        case "TERMINATED":
                            <span class="inline-flex items-center gap-1.5 px-3 py-0.5 rounded-full text-label-sm bg-slate-100 text-slate-600 border border-slate-200 font-medium">
                                <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>Terminated
                            </span>
                            break;
                        case "EXPIRED":
                            <span class="inline-flex items-center gap-1.5 px-3 py-0.5 rounded-full text-label-sm bg-gray-100 text-gray-500 border border-gray-200 font-medium">
                                <span class="w-1.5 h-1.5 rounded-full bg-gray-400"></span>Expired
                            </span>
                            break;
                        default:
                            <span class="inline-flex items-center gap-1.5 px-3 py-0.5 rounded-full text-label-sm bg-gray-100 text-gray-500 border border-gray-200">@Model.Status</span>
                            break;
                    }
                </div>
                <p class="text-body-md text-secondary mt-0.5 font-mono text-xs">@Model.ContractNumber</p>
            </div>
        </div>
    </div>

    <!-- Status banners -->
    @if (statusUpper == "REJECTED")
    {
        <div class="mb-5 p-4 rounded-xl bg-rose-50 border border-rose-200 flex items-start gap-3">
            <span class="material-symbols-outlined text-rose-600 text-[22px] mt-0.5 flex-shrink-0">cancel</span>
            <div>
                <p class="font-semibold text-rose-800 text-sm">Contract Rejected</p>
                @if (!string.IsNullOrWhiteSpace(Model.ManagerRejectionComment))
                {
                    <p class="text-rose-700 text-xs mt-1">@Model.ManagerRejectionComment</p>
                }
            </div>
        </div>
    }
    @if (statusUpper == "TERMINATED")
    {
        <div class="mb-5 p-4 rounded-xl bg-slate-50 border border-slate-200 flex items-start gap-3">
            <span class="material-symbols-outlined text-slate-600 text-[22px] mt-0.5 flex-shrink-0">block</span>
            <div>
                <p class="font-semibold text-slate-700 text-sm">Contract Terminated</p>
                @if (!string.IsNullOrWhiteSpace(Model.TerminationReason))
                {
                    <p class="text-slate-600 text-xs mt-1">@Model.TerminationReason</p>
                }
            </div>
        </div>
    }

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-5">

        <!-- LEFT COLUMN (2/3): Contract + Staff Info -->
        <div class="lg:col-span-2 flex flex-col gap-5">

            <!-- Contract Information Card -->
            <div class="bg-surface-container-lowest rounded-xl shadow-sm border border-surface-container-high/60 overflow-hidden">
                <div class="px-6 py-4 border-b border-surface-container-high/60 flex items-center gap-2">
                    <span class="material-symbols-outlined text-[20px] text-primary">description</span>
                    <h2 class="font-title-md text-sm font-semibold text-on-surface">Contract Information</h2>
                </div>
                <div class="px-6 py-5 grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-4">
                    <div>
                        <p class="text-[11px] uppercase tracking-wider text-secondary font-semibold mb-1">Contract Number</p>
                        <p class="font-mono text-sm font-semibold text-on-surface">@Model.ContractNumber</p>
                    </div>
                    <div>
                        <p class="text-[11px] uppercase tracking-wider text-secondary font-semibold mb-1">Status</p>
                        <p class="text-sm text-on-surface">@Model.Status</p>
                    </div>
                    <div>
                        <p class="text-[11px] uppercase tracking-wider text-secondary font-semibold mb-1">Start Date</p>
                        <p class="text-sm text-on-surface tabular-nums">@Model.StartDate.ToString("dd/MM/yyyy")</p>
                    </div>
                    <div>
                        <p class="text-[11px] uppercase tracking-wider text-secondary font-semibold mb-1">End Date</p>
                        <p class="text-sm text-on-surface tabular-nums">
                            @(Model.EndDate.HasValue ? Model.EndDate.Value.ToString("dd/MM/yyyy") : "Open-ended")
                        </p>
                    </div>
                    <div>
                        <p class="text-[11px] uppercase tracking-wider text-secondary font-semibold mb-1">Hourly Rate</p>
                        <p class="text-sm font-bold text-on-surface tabular-nums">@Model.HourlyRate.ToString("N0") ₫/h</p>
                    </div>
                    <div>
                        <p class="text-[11px] uppercase tracking-wider text-secondary font-semibold mb-1">Replaces Contract</p>
                        <p class="text-sm text-on-surface">
                            @if (Model.ReplacesContractId.HasValue)
                            {
                                <a asp-controller="EmploymentContracts" asp-action="Details"
                                   asp-route-contractId="@Model.ReplacesContractId.Value"
                                   class="text-primary hover:underline font-mono">#@Model.ReplacesContractId.Value</a>
                            }
                            else
                            {
                                <span class="text-secondary">—</span>
                            }
                        </p>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.ContractTerms))
                    {
                        <div class="sm:col-span-2">
                            <p class="text-[11px] uppercase tracking-wider text-secondary font-semibold mb-1">Contract Terms</p>
                            <p class="text-sm text-on-surface leading-relaxed whitespace-pre-line">@Model.ContractTerms</p>
                        </div>
                    }
                </div>
            </div>

            <!-- Employee Information Card -->
            <div class="bg-surface-container-lowest rounded-xl shadow-sm border border-surface-container-high/60 overflow-hidden">
                <div class="px-6 py-4 border-b border-surface-container-high/60 flex items-center gap-2">
                    <span class="material-symbols-outlined text-[20px] text-primary">person</span>
                    <h2 class="font-title-md text-sm font-semibold text-on-surface">Employee Information</h2>
                </div>
                <div class="px-6 py-5 grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-4">
                    <div>
                        <p class="text-[11px] uppercase tracking-wider text-secondary font-semibold mb-1">Full Name</p>
                        <p class="text-sm font-semibold text-on-surface">@Model.FullName</p>
                    </div>
                    <div>
                        <p class="text-[11px] uppercase tracking-wider text-secondary font-semibold mb-1">Position</p>
                        <p class="text-sm text-on-surface">@Model.EmployeePosition</p>
                    </div>
                    <div>
                        <p class="text-[11px] uppercase tracking-wider text-secondary font-semibold mb-1">Phone</p>
                        <p class="text-sm text-on-surface font-mono">@Model.Phone</p>
                    </div>
                    <div>
                        <p class="text-[11px] uppercase tracking-wider text-secondary font-semibold mb-1">Identity No.</p>
                        <p class="text-sm text-on-surface font-mono">@Model.IdentityNo</p>
                    </div>
                    <div class="sm:col-span-2">
                        <p class="text-[11px] uppercase tracking-wider text-secondary font-semibold mb-1">Address</p>
                        <p class="text-sm text-on-surface">@Model.Address</p>
                    </div>
                    <div>
                        <p class="text-[11px] uppercase tracking-wider text-secondary font-semibold mb-1">Staff ID</p>
                        <p class="text-xs text-secondary font-mono">@Model.StaffId</p>
                    </div>
                </div>
            </div>

            <!-- Organization Card -->
            <div class="bg-surface-container-lowest rounded-xl shadow-sm border border-surface-container-high/60 overflow-hidden">
                <div class="px-6 py-4 border-b border-surface-container-high/60 flex items-center gap-2">
                    <span class="material-symbols-outlined text-[20px] text-primary">store</span>
                    <h2 class="font-title-md text-sm font-semibold text-on-surface">Organization at Contract Time</h2>
                </div>
                <div class="px-6 py-5 grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-4">
                    <div>
                        <p class="text-[11px] uppercase tracking-wider text-secondary font-semibold mb-1">Branch</p>
                        <p class="text-sm font-semibold text-on-surface">@Model.BranchName</p>
                    </div>
                    <div>
                        <p class="text-[11px] uppercase tracking-wider text-secondary font-semibold mb-1">Region</p>
                        <p class="text-sm text-on-surface">@Model.RegionName</p>
                    </div>
                    <div class="sm:col-span-2">
                        <p class="text-[11px] uppercase tracking-wider text-secondary font-semibold mb-1">Branch Address</p>
                        <p class="text-sm text-on-surface">@Model.BranchAddress</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- RIGHT COLUMN (1/3): Lifecycle & PDF -->
        <div class="flex flex-col gap-5">

            <!-- PDF Card -->
            <div class="bg-surface-container-lowest rounded-xl shadow-sm border border-surface-container-high/60 overflow-hidden">
                <div class="px-6 py-4 border-b border-surface-container-high/60 flex items-center gap-2">
                    <span class="material-symbols-outlined text-[20px] text-primary">picture_as_pdf</span>
                    <h2 class="font-title-md text-sm font-semibold text-on-surface">PDF Document</h2>
                </div>
                <div class="px-6 py-5 flex flex-col gap-3">
                    @if (Model.HasPdf)
                    {
                        <div class="flex items-center gap-3 p-3 rounded-lg bg-emerald-50 border border-emerald-200">
                            <span class="material-symbols-outlined text-emerald-600 text-[24px]">check_circle</span>
                            <div>
                                <p class="text-emerald-800 text-sm font-semibold">PDF Available</p>
                                @if (Model.PdfGeneratedAt.HasValue)
                                {
                                    <p class="text-emerald-700 text-xs">Generated: @Model.PdfGeneratedAt.Value.ToString("dd/MM/yyyy HH:mm")</p>
                                }
                            </div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(Model.ContractTemplateVersion))
                        {
                            <div>
                                <p class="text-[11px] uppercase tracking-wider text-secondary font-semibold mb-1">Template Version</p>
                                <p class="text-sm font-mono text-on-surface">@Model.ContractTemplateVersion</p>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="flex items-center gap-3 p-3 rounded-lg bg-surface-container-low border border-surface-container-high">
                            <span class="material-symbols-outlined text-secondary text-[24px]">picture_as_pdf</span>
                            <p class="text-secondary text-sm">No PDF generated yet.</p>
                        </div>
                    }
                </div>
            </div>

            <!-- Lifecycle Timeline Card -->
            <div class="bg-surface-container-lowest rounded-xl shadow-sm border border-surface-container-high/60 overflow-hidden">
                <div class="px-6 py-4 border-b border-surface-container-high/60 flex items-center gap-2">
                    <span class="material-symbols-outlined text-[20px] text-primary">history</span>
                    <h2 class="font-title-md text-sm font-semibold text-on-surface">Contract Lifecycle</h2>
                </div>
                <div class="px-6 py-5">
                    <ol class="relative border-l border-surface-container-high ml-3 space-y-4">

                        <!-- Created -->
                        <li class="ml-4">
                            <div class="absolute w-3 h-3 rounded-full bg-primary/70 -left-1.5 mt-1"></div>
                            <p class="text-xs font-semibold text-on-surface">Created</p>
                            <p class="text-[11px] text-secondary tabular-nums">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>
                            <p class="text-[11px] text-secondary font-mono">by @Model.CreatedBy.ToString()[..8]…</p>
                        </li>

                        <!-- Sent to Staff -->
                        @if (Model.SentToStaffAt.HasValue)
                        {
                            <li class="ml-4">
                                <div class="absolute w-3 h-3 rounded-full bg-blue-400 -left-1.5 mt-1"></div>
                                <p class="text-xs font-semibold text-on-surface">Sent to Employee</p>
                                <p class="text-[11px] text-secondary tabular-nums">@Model.SentToStaffAt.Value.ToString("dd/MM/yyyy HH:mm")</p>
                            </li>
                        }

                        <!-- Staff Responded -->
                        @if (Model.StaffRespondedAt.HasValue)
                        {
                            <li class="ml-4">
                                <div class="absolute w-3 h-3 rounded-full bg-indigo-400 -left-1.5 mt-1"></div>
                                <p class="text-xs font-semibold text-on-surface">Employee Responded</p>
                                <p class="text-[11px] text-secondary tabular-nums">@Model.StaffRespondedAt.Value.ToString("dd/MM/yyyy HH:mm")</p>
                            </li>
                        }

                        <!-- Staff Accepted -->
                        @if (Model.StaffAcceptedAt.HasValue)
                        {
                            <li class="ml-4">
                                <div class="absolute w-3 h-3 rounded-full bg-emerald-400 -left-1.5 mt-1"></div>
                                <p class="text-xs font-semibold text-on-surface">Employee Accepted</p>
                                <p class="text-[11px] text-secondary tabular-nums">@Model.StaffAcceptedAt.Value.ToString("dd/MM/yyyy HH:mm")</p>
                            </li>
                        }

                        <!-- Approved -->
                        @if (Model.ApprovedAt.HasValue)
                        {
                            <li class="ml-4">
                                <div class="absolute w-3 h-3 rounded-full bg-emerald-600 -left-1.5 mt-1"></div>
                                <p class="text-xs font-semibold text-emerald-700">Approved</p>
                                <p class="text-[11px] text-secondary tabular-nums">@Model.ApprovedAt.Value.ToString("dd/MM/yyyy HH:mm")</p>
                                @if (Model.ApprovedBy.HasValue)
                                {
                                    <p class="text-[11px] text-secondary font-mono">by @Model.ApprovedBy.Value.ToString()[..8]…</p>
                                }
                            </li>
                        }

                        <!-- Rejected -->
                        @if (Model.RejectedAt.HasValue)
                        {
                            <li class="ml-4">
                                <div class="absolute w-3 h-3 rounded-full bg-rose-500 -left-1.5 mt-1"></div>
                                <p class="text-xs font-semibold text-rose-700">Rejected</p>
                                <p class="text-[11px] text-secondary tabular-nums">@Model.RejectedAt.Value.ToString("dd/MM/yyyy HH:mm")</p>
                                @if (Model.RejectedBy.HasValue)
                                {
                                    <p class="text-[11px] text-secondary font-mono">by @Model.RejectedBy.Value.ToString()[..8]…</p>
                                }
                                @if (!string.IsNullOrWhiteSpace(Model.ManagerRejectionComment))
                                {
                                    <p class="text-[11px] text-rose-600 mt-0.5 italic">"@Model.ManagerRejectionComment"</p>
                                }
                            </li>
                        }

                        <!-- Terminated -->
                        @if (Model.TerminatedAt.HasValue)
                        {
                            <li class="ml-4">
                                <div class="absolute w-3 h-3 rounded-full bg-slate-500 -left-1.5 mt-1"></div>
                                <p class="text-xs font-semibold text-slate-600">Terminated</p>
                                <p class="text-[11px] text-secondary tabular-nums">@Model.TerminatedAt.Value.ToString("dd/MM/yyyy HH:mm")</p>
                                @if (Model.TerminationEffectiveAt.HasValue)
                                {
                                    <p class="text-[11px] text-secondary">Effective: @Model.TerminationEffectiveAt.Value.ToString("dd/MM/yyyy HH:mm")</p>
                                }
                                @if (!string.IsNullOrWhiteSpace(Model.TerminationReason))
                                {
                                    <p class="text-[11px] text-slate-500 italic mt-0.5">"@Model.TerminationReason"</p>
                                }
                            </li>
                        }

                        <!-- Last Updated -->
                        <li class="ml-4">
                            <div class="absolute w-3 h-3 rounded-full bg-secondary/40 -left-1.5 mt-1"></div>
                            <p class="text-xs font-semibold text-secondary">Last Updated</p>
                            <p class="text-[11px] text-secondary tabular-nums">@Model.UpdatedAt.ToString("dd/MM/yyyy HH:mm")</p>
                        </li>
                    </ol>
                </div>
            </div>

        </div>
    </div>
</div>
