@model UI_Admin.Models.EmploymentContracts.EmploymentContractDetailViewModel

@{
    ViewData["Title"] = $"Contract {Model.ContractNumber} - Details";
    var statusUpper = Model.Status?.ToUpperInvariant() ?? "DRAFT";
}

<div class="flex flex-col w-full px-7 py-4">
    <partial name="_NotificationModal" />

    <!-- Navigation Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6">
        <div class="flex items-center gap-3">
            <a asp-controller="EmploymentContracts" asp-action="Index"
               class="inline-flex items-center justify-center w-9 h-9 rounded-xl bg-surface-container hover:bg-surface-container-high text-on-surface transition-colors shrink-0"
               title="Back to Employment Contracts">
                <span class="material-symbols-outlined text-[20px]">arrow_back</span>
            </a>
            <div>
                <div class="flex items-center gap-2">
                    <h1 class="text-display-md font-bold tracking-tight text-on-surface">Contract Details</h1>
                    @switch (statusUpper)
                    {
                        case "DRAFT":
                            <span class="inline-flex items-center gap-1.5 px-3 py-0.5 rounded-full text-label-sm bg-amber-50 text-amber-700 border border-amber-200 font-semibold">
                                <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>Draft
                            </span>
                            break;
                        case "PENDING_APPROVAL":
                            <span class="inline-flex items-center gap-1.5 px-3 py-0.5 rounded-full text-label-sm bg-purple-50 text-purple-700 border border-purple-200 font-semibold">
                                <span class="w-1.5 h-1.5 rounded-full bg-purple-500 animate-pulse"></span>Pending Approval
                            </span>
                            break;
                        case "APPROVED":
                            <span class="inline-flex items-center gap-1.5 px-3 py-0.5 rounded-full text-label-sm bg-blue-50 text-blue-700 border border-blue-200 font-semibold">
                                <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>Approved
                            </span>
                            break;
                        case "ACTIVE":
                            <span class="inline-flex items-center gap-1.5 px-3 py-0.5 rounded-full text-label-sm bg-emerald-50 text-emerald-700 border border-emerald-200 font-semibold">
                                <span class="w-1.5 h-1.5 rounded-full bg-emerald-600 animate-pulse"></span>Active
                            </span>
                            break;
                        case "REJECTED":
                            <span class="inline-flex items-center gap-1.5 px-3 py-0.5 rounded-full text-label-sm bg-rose-50 text-rose-700 border border-rose-200 font-semibold">
                                <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>Rejected
                            </span>
                            break;
                        case "TERMINATED":
                            <span class="inline-flex items-center gap-1.5 px-3 py-0.5 rounded-full text-label-sm bg-slate-100 text-slate-600 border border-slate-200 font-medium">
                                <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>Terminated
                            </span>
                            break;
                        case "CANCELLED":
                            <span class="inline-flex items-center gap-1.5 px-3 py-0.5 rounded-full text-label-sm bg-rose-50 text-rose-700 border border-rose-200 font-semibold">
                                <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>Cancelled
                            </span>
                            break;
                        case "EXPIRED":
                            <span class="inline-flex items-center gap-1.5 px-3 py-0.5 rounded-full text-label-sm bg-gray-100 text-gray-500 border border-gray-200 font-medium">
                                <span class="w-1.5 h-1.5 rounded-full bg-gray-400"></span>Expired
                            </span>
                            break;
                        default:
                            <span class="inline-flex items-center gap-1.5 px-3 py-0.5 rounded-full text-label-sm bg-gray-100 text-gray-500 border border-gray-200">@Model.Status</span>
                            break;
                    }
                </div>
                <p class="text-body-md text-secondary mt-0.5 font-mono text-xs">@Model.ContractNumber</p>
            </div>
        </div>
        <div class="flex items-center gap-2">
            <a href="#contract-history-section"
               class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-surface-container hover:bg-surface-container-high border border-surface-container-high text-on-surface text-sm font-semibold transition-all shadow-sm">
                <span class="material-symbols-outlined text-[18px] text-primary">manage_history</span>
                <span>Contract History</span>
                @if (Model.History?.TotalItems > 0)
                {
                    <span class="px-2 py-0.5 rounded-full text-xs bg-primary/10 text-primary font-bold">@Model.History.TotalItems</span>
                }
            </a>
        </div>
    </div>

    <!-- Status banners -->
    @if (statusUpper == "REJECTED")
    {
        <div class="mb-5 p-4 rounded-xl bg-rose-50 border border-rose-200 flex items-start gap-3">
            <span class="material-symbols-outlined text-rose-600 text-[22px] mt-0.5 flex-shrink-0">cancel</span>
            <div>
                <p class="font-semibold text-rose-800 text-sm">Contract Rejected</p>
                @if (!string.IsNullOrWhiteSpace(Model.ManagerRejectionComment))
                {
                    <p class="text-rose-700 text-xs mt-1">@Model.ManagerRejectionComment</p>
                }
            </div>
        </div>
    }
    @if (statusUpper == "CANCELLED")
    {
        <div class="mb-5 p-5 rounded-2xl bg-rose-50/80 border border-rose-200/80 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div class="flex items-start gap-3.5">
                <div class="p-2.5 bg-rose-100 text-rose-700 rounded-xl shrink-0 mt-0.5">
                    <span class="material-symbols-outlined text-[24px]">event_busy</span>
                </div>
                <div class="flex-1">
                    <div class="flex items-center gap-2 flex-wrap mb-2">
                        <h3 class="font-bold text-rose-900 text-sm">Contract Cancelled</h3>
                        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-rose-100 text-rose-700 border border-rose-300">
                            <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>CANCELLED
                        </span>
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-x-6 gap-y-2 text-xs">
                        <div>
                            <span class="text-rose-600/80 font-medium block">Cancellation Reason:</span>
                            <span class="font-semibold text-rose-900">
                                @if (Model.CancellationReason == "NOT_ACCEPTED_BY_START_DATE" || (Model.CancellationReason?.Contains("quá ngày bắt đầu", StringComparison.OrdinalIgnoreCase) ?? false))
                                {
                                    <span>The employee did not accept before the start date (automatically cancelled).</span>
                                }
                                else
                                {
                                    @(string.IsNullOrWhiteSpace(Model.CancellationReason) ? "—" : Model.CancellationReason)
                                }
                            </span>
                        </div>
                        <div>
                            <span class="text-rose-600/80 font-medium block">Cancelled At:</span>
                            <span class="font-semibold text-rose-900 tabular-nums">
                                @(Model.CancelledAt.HasValue ? Model.CancelledAt.Value.ToString("dd/MM/yyyy HH:mm:ss") : "—")
                            </span>
                        </div>
                        <div>
                            <span class="text-rose-600/80 font-medium block">Action By:</span>
                            <span class="font-semibold text-rose-900">
                                @if (Model.CancelledBy.HasValue)
                                {
                                    <span class="font-mono">@Model.CancelledBy.Value</span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1 font-semibold text-slate-800">
                                        <span class="material-symbols-outlined text-[14px]">smart_toy</span> System
                                    </span>
                                }
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    @if (statusUpper == "TERMINATED")
    {
        <div class="mb-5 p-4 rounded-xl bg-slate-50 border border-slate-200 flex items-start gap-3">
            <span class="material-symbols-outlined text-slate-600 text-[22px] mt-0.5 flex-shrink-0">block</span>
            <div>
                <p class="font-semibold text-slate-700 text-sm">Contract Terminated</p>
                @if (!string.IsNullOrWhiteSpace(Model.TerminationReason))
                {
                    <p class="text-slate-600 text-xs mt-1">@Model.TerminationReason</p>
                }
            </div>
        </div>
    }

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-5">

        <!-- LEFT COLUMN (2/3): Contract + Staff Info -->
        <div class="lg:col-span-2 flex flex-col gap-5">

            <!-- Contract Information Card -->
            <div class="bg-surface-container-lowest rounded-xl shadow-sm border border-surface-container-high/60 overflow-hidden">
                <div class="px-6 py-4 border-b border-surface-container-high/60 flex items-center gap-2">
                    <span class="material-symbols-outlined text-[20px] text-primary">description</span>
                    <h2 class="font-title-md text-sm font-semibold text-on-surface">Contract Information</h2>
                </div>
                <div class="px-6 py-5 grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-4">
                    <div>
                        <p class="text-[11px] uppercase tracking-wider text-secondary font-semibold mb-1">Contract Number</p>
                        <p class="font-mono text-sm font-semibold text-on-surface">@Model.ContractNumber</p>
                    </div>
                    <div>
                        <p class="text-[11px] uppercase tracking-wider text-secondary font-semibold mb-1">Status</p>
                        <p class="text-sm text-on-surface">@Model.Status</p>
                    </div>
                    <div>
                        <p class="text-[11px] uppercase tracking-wider text-secondary font-semibold mb-1">Start Date</p>
                        <p class="text-sm text-on-surface tabular-nums">@Model.StartDate.ToString("dd/MM/yyyy")</p>
                    </div>
                    <div>
                        <p class="text-[11px] uppercase tracking-wider text-secondary font-semibold mb-1">End Date</p>
                        <p class="text-sm text-on-surface tabular-nums">
                            @(Model.EndDate.HasValue ? Model.EndDate.Value.ToString("dd/MM/yyyy") : "Open-ended")
                        </p>
                    </div>
                    <div>
                        <p class="text-[11px] uppercase tracking-wider text-secondary font-semibold mb-1">Hourly Rate</p>
                        <p class="text-sm font-bold text-on-surface tabular-nums">@Model.HourlyRate.ToString("N0") ₫/h</p>
                    </div>
                    <div>
                        <p class="text-[11px] uppercase tracking-wider text-secondary font-semibold mb-1">Replaces Contract</p>
                        <p class="text-sm text-on-surface">
                            @if (Model.ReplacesContractId.HasValue)
                            {
                                <a asp-controller="EmploymentContracts" asp-action="Details"
                                   asp-route-contractId="@Model.ReplacesContractId.Value"
                                   class="text-primary hover:underline font-mono">#@Model.ReplacesContractId.Value</a>
                            }
                            else
                            {
                                <span class="text-secondary">—</span>
                            }
                        </p>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.ContractTerms))
                    {
                        <div class="sm:col-span-2">
                            <p class="text-[11px] uppercase tracking-wider text-secondary font-semibold mb-1">Contract Terms</p>
                            <p class="text-sm text-on-surface leading-relaxed whitespace-pre-line">@Model.ContractTerms</p>
                        </div>
                    }
                </div>
            </div>

            <!-- Employee Information Card -->
            <div class="bg-surface-container-lowest rounded-xl shadow-sm border border-surface-container-high/60 overflow-hidden">
                <div class="px-6 py-4 border-b border-surface-container-high/60 flex items-center gap-2">
                    <span class="material-symbols-outlined text-[20px] text-primary">person</span>
                    <h2 class="font-title-md text-sm font-semibold text-on-surface">Employee Information</h2>
                </div>
                <div class="px-6 py-5 grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-4">
                    <div>
                        <p class="text-[11px] uppercase tracking-wider text-secondary font-semibold mb-1">Full Name</p>
                        <p class="text-sm font-semibold text-on-surface">@Model.FullName</p>
                    </div>
                    <div>
                        <p class="text-[11px] uppercase tracking-wider text-secondary font-semibold mb-1">Position</p>
                        <p class="text-sm text-on-surface">@Model.EmployeePosition</p>
                    </div>
                    <div>
                        <p class="text-[11px] uppercase tracking-wider text-secondary font-semibold mb-1">Phone</p>
                        <p class="text-sm text-on-surface font-mono">@Model.Phone</p>
                    </div>
                    <div>
                        <p class="text-[11px] uppercase tracking-wider text-secondary font-semibold mb-1">Identity No.</p>
                        <p class="text-sm text-on-surface font-mono">@Model.IdentityNo</p>
                    </div>
                    <div class="sm:col-span-2">
                        <p class="text-[11px] uppercase tracking-wider text-secondary font-semibold mb-1">Address</p>
                        <p class="text-sm text-on-surface">@Model.Address</p>
                    </div>
                    <div>
                        <p class="text-[11px] uppercase tracking-wider text-secondary font-semibold mb-1">Staff ID</p>
                        <p class="text-xs text-secondary font-mono">@Model.StaffId</p>
                    </div>
                </div>
            </div>

            <!-- Organization Card -->
            <div class="bg-surface-container-lowest rounded-xl shadow-sm border border-surface-container-high/60 overflow-hidden">
                <div class="px-6 py-4 border-b border-surface-container-high/60 flex items-center gap-2">
                    <span class="material-symbols-outlined text-[20px] text-primary">store</span>
                    <h2 class="font-title-md text-sm font-semibold text-on-surface">Organization at Contract Time</h2>
                </div>
                <div class="px-6 py-5 grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-4">
                    <div>
                        <p class="text-[11px] uppercase tracking-wider text-secondary font-semibold mb-1">Branch</p>
                        <p class="text-sm font-semibold text-on-surface">@Model.BranchName</p>
                    </div>
                    <div>
                        <p class="text-[11px] uppercase tracking-wider text-secondary font-semibold mb-1">Region</p>
                        <p class="text-sm text-on-surface">@Model.RegionName</p>
                    </div>
                    <div class="sm:col-span-2">
                        <p class="text-[11px] uppercase tracking-wider text-secondary font-semibold mb-1">Branch Address</p>
                        <p class="text-sm text-on-surface">@Model.BranchAddress</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- RIGHT COLUMN (1/3): Lifecycle & PDF -->
        <div class="flex flex-col gap-5">

            <!-- PDF Card -->
            <div class="bg-surface-container-lowest rounded-xl shadow-sm border border-surface-container-high/60 overflow-hidden">
                <div class="px-6 py-4 border-b border-surface-container-high/60 flex items-center gap-2">
                    <span class="material-symbols-outlined text-[20px] text-primary">picture_as_pdf</span>
                    <h2 class="font-title-md text-sm font-semibold text-on-surface">PDF Document</h2>
                </div>
                <div class="px-6 py-5 flex flex-col gap-3">
                    @if (Model.HasPdf)
                    {
                        <div class="flex items-center gap-3 p-3 rounded-lg bg-emerald-50 border border-emerald-200">
                            <span class="material-symbols-outlined text-emerald-600 text-[24px]">check_circle</span>
                            <div>
                                <p class="text-emerald-800 text-sm font-semibold">PDF Available</p>
                                @if (Model.PdfGeneratedAt.HasValue)
                                {
                                    <p class="text-emerald-700 text-xs">Generated: @Model.PdfGeneratedAt.Value.ToString("dd/MM/yyyy HH:mm")</p>
                                }
                            </div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(Model.ContractTemplateVersion))
                        {
                            <div>
                                <p class="text-[11px] uppercase tracking-wider text-secondary font-semibold mb-1">Template Version</p>
                                <p class="text-sm font-mono text-on-surface">@Model.ContractTemplateVersion</p>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="flex items-center gap-3 p-3 rounded-lg bg-surface-container-low border border-surface-container-high">
                            <span class="material-symbols-outlined text-secondary text-[24px]">picture_as_pdf</span>
                            <p class="text-secondary text-sm">No PDF generated yet.</p>
                        </div>
                    }
                </div>
            </div>

            <!-- Lifecycle Timeline Card -->
            <div class="bg-surface-container-lowest rounded-xl shadow-sm border border-surface-container-high/60 overflow-hidden">
                <div class="px-6 py-4 border-b border-surface-container-high/60 flex items-center gap-2">
                    <span class="material-symbols-outlined text-[20px] text-primary">history</span>
                    <h2 class="font-title-md text-sm font-semibold text-on-surface">Contract Lifecycle</h2>
                </div>
                <div class="px-6 py-5">
                    <ol class="relative border-l border-surface-container-high ml-3 space-y-4">

                        <!-- Created -->
                        <li class="ml-4">
                            <div class="absolute w-3 h-3 rounded-full bg-primary/70 -left-1.5 mt-1"></div>
                            <p class="text-xs font-semibold text-on-surface">Created</p>
                            <p class="text-[11px] text-secondary tabular-nums">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>
                            <p class="text-[11px] text-secondary font-mono">by @Model.CreatedBy.ToString()[..8]…</p>
                        </li>

                        <!-- Sent to Staff -->
                        @if (Model.SentToStaffAt.HasValue)
                        {
                            <li class="ml-4">
                                <div class="absolute w-3 h-3 rounded-full bg-blue-400 -left-1.5 mt-1"></div>
                                <p class="text-xs font-semibold text-on-surface">Sent to Employee</p>
                                <p class="text-[11px] text-secondary tabular-nums">@Model.SentToStaffAt.Value.ToString("dd/MM/yyyy HH:mm")</p>
                            </li>
                        }

                        <!-- Staff Responded -->
                        @if (Model.StaffRespondedAt.HasValue)
                        {
                            <li class="ml-4">
                                <div class="absolute w-3 h-3 rounded-full bg-indigo-400 -left-1.5 mt-1"></div>
                                <p class="text-xs font-semibold text-on-surface">Employee Responded</p>
                                <p class="text-[11px] text-secondary tabular-nums">@Model.StaffRespondedAt.Value.ToString("dd/MM/yyyy HH:mm")</p>
                            </li>
                        }

                        <!-- Staff Accepted -->
                        @if (Model.StaffAcceptedAt.HasValue)
                        {
                            <li class="ml-4">
                                <div class="absolute w-3 h-3 rounded-full bg-emerald-400 -left-1.5 mt-1"></div>
                                <p class="text-xs font-semibold text-on-surface">Employee Accepted</p>
                                <p class="text-[11px] text-secondary tabular-nums">@Model.StaffAcceptedAt.Value.ToString("dd/MM/yyyy HH:mm")</p>
                            </li>
                        }

                        <!-- Approved -->
                        @if (Model.ApprovedAt.HasValue)
                        {
                            <li class="ml-4">
                                <div class="absolute w-3 h-3 rounded-full bg-emerald-600 -left-1.5 mt-1"></div>
                                <p class="text-xs font-semibold text-emerald-700">Approved</p>
                                <p class="text-[11px] text-secondary tabular-nums">@Model.ApprovedAt.Value.ToString("dd/MM/yyyy HH:mm")</p>
                                @if (Model.ApprovedBy.HasValue)
                                {
                                    <p class="text-[11px] text-secondary font-mono">by @Model.ApprovedBy.Value.ToString()[..8]…</p>
                                }
                            </li>
                        }

                        <!-- Rejected -->
                        @if (Model.RejectedAt.HasValue)
                        {
                            <li class="ml-4">
                                <div class="absolute w-3 h-3 rounded-full bg-rose-500 -left-1.5 mt-1"></div>
                                <p class="text-xs font-semibold text-rose-700">Rejected</p>
                                <p class="text-[11px] text-secondary tabular-nums">@Model.RejectedAt.Value.ToString("dd/MM/yyyy HH:mm")</p>
                                @if (Model.RejectedBy.HasValue)
                                {
                                    <p class="text-[11px] text-secondary font-mono">by @Model.RejectedBy.Value.ToString()[..8]…</p>
                                }
                                @if (!string.IsNullOrWhiteSpace(Model.ManagerRejectionComment))
                                {
                                    <p class="text-[11px] text-rose-600 mt-0.5 italic">"@Model.ManagerRejectionComment"</p>
                                }
                            </li>
                        }

                        <!-- Terminated -->
                        @if (Model.TerminatedAt.HasValue)
                        {
                            <li class="ml-4">
                                <div class="absolute w-3 h-3 rounded-full bg-slate-500 -left-1.5 mt-1"></div>
                                <p class="text-xs font-semibold text-slate-600">Terminated</p>
                                <p class="text-[11px] text-secondary tabular-nums">@Model.TerminatedAt.Value.ToString("dd/MM/yyyy HH:mm")</p>
                                @if (Model.TerminationEffectiveAt.HasValue)
                                {
                                    <p class="text-[11px] text-secondary">Effective: @Model.TerminationEffectiveAt.Value.ToString("dd/MM/yyyy HH:mm")</p>
                                }
                                @if (!string.IsNullOrWhiteSpace(Model.TerminationReason))
                                {
                                    <p class="text-[11px] text-slate-500 italic mt-0.5">"@Model.TerminationReason"</p>
                                }
                            </li>
                        }

                        <!-- Cancelled -->
                        @if (Model.CancelledAt.HasValue || statusUpper == "CANCELLED")
                        {
                            <li class="ml-4">
                                <div class="absolute w-3 h-3 rounded-full bg-rose-500 -left-1.5 mt-1"></div>
                                <p class="text-xs font-semibold text-rose-700">Cancelled</p>
                                @if (Model.CancelledAt.HasValue)
                                {
                                    <p class="text-[11px] text-secondary tabular-nums">@Model.CancelledAt.Value.ToString("dd/MM/yyyy HH:mm")</p>
                                }
                                <p class="text-[11px] text-secondary font-mono">
                                    by @(Model.CancelledBy.HasValue ? Model.CancelledBy.Value.ToString()[..8] + "…" : "System")
                                </p>
                                @if (!string.IsNullOrWhiteSpace(Model.CancellationReason))
                                {
                                    <p class="text-[11px] text-rose-600 mt-0.5 italic">"@Model.CancellationReason"</p>
                                }
                            </li>
                        }

                        <!-- Last Updated -->
                        <li class="ml-4">
                            <div class="absolute w-3 h-3 rounded-full bg-secondary/40 -left-1.5 mt-1"></div>
                            <p class="text-xs font-semibold text-secondary">Last Updated</p>
                            <p class="text-[11px] text-secondary tabular-nums">@Model.UpdatedAt.ToString("dd/MM/yyyy HH:mm")</p>
                        </li>
                    </ol>
                </div>
            </div>

        </div>
    </div>

    <!-- Complete Contract Audit History Section -->
    <div id="contract-history-section" class="mt-8 bg-surface-container-lowest rounded-2xl shadow-sm border border-surface-container-high/60 overflow-hidden">
        <div class="px-6 py-5 border-b border-surface-container-high/60 flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-surface-container-low/40">
            <div class="flex items-center gap-3">
                <div class="p-2.5 bg-primary/10 text-primary rounded-xl">
                    <span class="material-symbols-outlined text-[24px]">manage_history</span>
                </div>
                <div>
                    <h2 class="text-base font-bold text-on-surface">Employment Contract Audit History</h2>
                    <p class="text-xs text-secondary mt-0.5">Chronological history of events, approval workflows, and data changes across the system.</p>
                </div>
            </div>
            @if (Model.History?.TotalItems > 0)
            {
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-primary/10 text-primary self-start sm:self-auto">
                    <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
                    @Model.History.TotalItems events
                </span>
            }
        </div>

        <div class="p-6">
            @if (Model.HistoryLoadFailed)
            {
                <div class="py-10 text-center flex flex-col items-center justify-center text-rose-600 bg-rose-50/50 rounded-xl border border-rose-200/60 p-6">
                    <span class="material-symbols-outlined text-[48px] text-rose-500 mb-2">error_outline</span>
                    <p class="text-sm font-semibold text-rose-900">Unable to load contract history</p>
                    <p class="text-xs text-rose-700 mt-1">@(Model.HistoryErrorMessage ?? "An error occurred while connecting to the contract history service.")</p>
                    <a asp-controller="EmploymentContracts" asp-action="Details"
                       asp-route-contractId="@Model.ContractId"
                       asp-fragment="contract-history-section"
                       class="mt-4 px-4 py-2 rounded-lg bg-surface-container hover:bg-surface-container-high border border-surface-container-high text-on-surface text-xs font-semibold transition-all inline-flex items-center gap-1.5 shadow-sm">
                        <span class="material-symbols-outlined text-[16px]">refresh</span>
                        <span>Retry</span>
                    </a>
                </div>
            }
            else if (Model.History?.Items != null && Model.History.Items.Count > 0)
            {
                <div class="relative border-l-2 border-slate-200 ml-4 space-y-6">
                    @foreach (var entry in Model.History.Items)
                    {
                        var isSystem = entry.ActorRole == "SYSTEM" || entry.ActorId == null || string.Equals(entry.ActorName, "System", StringComparison.OrdinalIgnoreCase) || string.Equals(entry.ActorName, "Hệ thống", StringComparison.OrdinalIgnoreCase);
                        var isManager = string.Equals(entry.ActorRole, "MANAGER", StringComparison.OrdinalIgnoreCase);
                        var isStaff = string.Equals(entry.ActorRole, "STAFF", StringComparison.OrdinalIgnoreCase);
                        var isAutoCancel = string.Equals(entry.Action, "AUTO_CANCEL_CONTRACT", StringComparison.OrdinalIgnoreCase);

                        <div class="relative pl-6">
                            <!-- Bullet Icon -->
                            <div class="absolute -left-[17px] top-1 w-8 h-8 rounded-full border-2 border-white flex items-center justify-center shadow-sm @(isAutoCancel ? "bg-rose-500 text-white" : isSystem ? "bg-slate-700 text-white" : isManager ? "bg-indigo-600 text-white" : "bg-teal-600 text-white")">
                                <span class="material-symbols-outlined text-[16px]">
                                    @(isAutoCancel ? "event_busy" : isSystem ? "smart_toy" : isManager ? "badge" : "person")
                                </span>
                            </div>

                            <!-- Event Card -->
                            <div class="p-4 rounded-xl border border-surface-container-high/60 bg-surface-container-lowest hover:border-primary/40 transition-colors shadow-sm">
                                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-2 border-b border-surface-container-high/40">
                                    <div class="flex items-center gap-2 flex-wrap">
                                        <h3 class="text-sm font-bold text-on-surface">@entry.ActionTitle</h3>
                                        <span class="px-2 py-0.5 rounded text-[11px] font-mono bg-slate-100 text-slate-700">@entry.Action</span>

                                        <!-- Actor Badge -->
                                        @if (isSystem)
                                        {
                                            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-semibold bg-slate-100 text-slate-700 border border-slate-300">
                                                <span class="material-symbols-outlined text-[14px]">smart_toy</span> System
                                            </span>
                                        }
                                        else if (isManager)
                                        {
                                            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-semibold bg-indigo-50 text-indigo-700 border border-indigo-200">
                                                <span class="material-symbols-outlined text-[14px]">badge</span> Manager: @entry.ActorName
                                            </span>
                                        }
                                        else if (isStaff)
                                        {
                                            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-semibold bg-teal-50 text-teal-700 border border-teal-200">
                                                <span class="material-symbols-outlined text-[14px]">person</span> Staff: @entry.ActorName
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium bg-slate-50 text-slate-600 border border-slate-200">
                                                @entry.ActorRole: @entry.ActorName
                                            </span>
                                        }
                                    </div>
                                    <span class="text-xs text-secondary tabular-nums font-medium shrink-0">
                                        @entry.Timestamp.ToString("dd/MM/yyyy HH:mm:ss")
                                    </span>
                                </div>

                                <!-- AUTO_CANCEL_CONTRACT Callout -->
                                @if (isAutoCancel)
                                {
                                    <div class="mt-3 p-3 rounded-xl bg-rose-50 border border-rose-200 text-xs text-rose-800 flex items-start gap-2.5">
                                        <span class="material-symbols-outlined text-rose-600 text-[18px] shrink-0 mt-0.5">warning</span>
                                        <div>
                                            <p class="font-bold text-rose-900">System auto-cancelled contract due to staff not accepting in time:</p>
                                            <p class="text-rose-700 mt-0.5">
                                                The contract acceptance window has passed (exceeded start date) without staff confirmation.
                                                The status has transitioned to <strong class="font-mono text-rose-900">CANCELLED</strong> with reason <strong class="text-rose-900">The employee did not accept before the start date</strong> (not TERMINATED).
                                            </p>
                                        </div>
                                    </div>
                                }

                                <!-- Status Transition -->
                                @if (!string.IsNullOrWhiteSpace(entry.FromStatus) || !string.IsNullOrWhiteSpace(entry.ToStatus))
                                {
                                    <div class="mt-3 flex items-center gap-2 text-xs">
                                        <span class="text-secondary font-medium">Status:</span>
                                        @if (!string.IsNullOrWhiteSpace(entry.FromStatus))
                                        {
                                            <span class="px-2 py-0.5 rounded font-mono bg-slate-100 text-slate-700">@entry.FromStatus</span>
                                            <span class="material-symbols-outlined text-[16px] text-secondary">arrow_forward</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(entry.ToStatus))
                                        {
                                            var toUpper = entry.ToStatus.ToUpperInvariant();
                                            var toClass = toUpper switch
                                            {
                                                "ACTIVE" => "bg-emerald-50 text-emerald-700 border border-emerald-200 font-semibold",
                                                "CANCELLED" => "bg-rose-50 text-rose-700 border border-rose-200 font-semibold",
                                                "TERMINATED" => "bg-slate-100 text-slate-700 border border-slate-300 font-medium",
                                                "PENDING_STAFF" => "bg-blue-50 text-blue-700 border border-blue-200",
                                                "REJECTED" => "bg-rose-50 text-rose-700 border border-rose-200",
                                                _ => "bg-slate-100 text-slate-700 font-mono"
                                            };
                                            <span class="px-2 py-0.5 rounded font-mono @toClass">@entry.ToStatus</span>
                                        }
                                    </div>
                                }

                                <!-- Reason & Notes -->
                                @if (!string.IsNullOrWhiteSpace(entry.Reason))
                                {
                                    <div class="mt-2.5 p-2.5 rounded-lg bg-amber-50/70 border border-amber-200/60 text-xs text-amber-900 flex items-start gap-2">
                                        <span class="material-symbols-outlined text-amber-600 text-[18px] shrink-0 mt-0.5">info</span>
                                        <div>
                                            @if (entry.Reason == "NOT_ACCEPTED_BY_START_DATE" || (entry.Reason?.Contains("quá ngày bắt đầu", StringComparison.OrdinalIgnoreCase) ?? false))
                                            {
                                                <span class="font-semibold">Reason:</span> <span>The employee did not accept before the start date</span>
                                            }
                                            else
                                            {
                                                <span class="font-semibold">Reason:</span> @entry.Reason
                                            }
                                        </div>
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(entry.Note))
                                {
                                    <div class="mt-2 text-xs text-secondary italic">
                                        Note: @entry.Note
                                    </div>
                                }

                                <!-- Changed Fields Table (for UPDATE_DRAFT) -->
                                @if (entry.ChangedFields != null && entry.ChangedFields.Count > 0)
                                {
                                    <div class="mt-3 overflow-x-auto rounded-lg border border-surface-container-high/60">
                                        <table class="w-full text-left text-xs">
                                            <thead class="bg-surface-container-low text-secondary font-semibold border-b border-surface-container-high/60">
                                                <tr>
                                                    <th class="py-1.5 px-3">Changed Field</th>
                                                    <th class="py-1.5 px-3">Previous Value</th>
                                                    <th class="py-1.5 px-3">New Value</th>
                                                </tr>
                                            </thead>
                                            <tbody class="divide-y divide-surface-container-high/40">
                                                @foreach (var field in entry.ChangedFields)
                                                {
                                                    <tr>
                                                        <td class="py-1.5 px-3 font-medium text-on-surface">@field.FieldName</td>
                                                        <td class="py-1.5 px-3 text-secondary">@(field.OldValue ?? "—")</td>
                                                        <td class="py-1.5 px-3 font-semibold text-primary">@(field.NewValue ?? "—")</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }

                                <!-- Change Request Items -->
                                @if (entry.ChangeRequestItems != null && entry.ChangeRequestItems.Count > 0)
                                {
                                    <div class="mt-3 overflow-x-auto rounded-lg border border-surface-container-high/60">
                                        <table class="w-full text-left text-xs">
                                            <thead class="bg-surface-container-low text-secondary font-semibold border-b border-surface-container-high/60">
                                                <tr>
                                                    <th class="py-1.5 px-3">Field Name</th>
                                                    <th class="py-1.5 px-3">Original Value</th>
                                                    <th class="py-1.5 px-3">Proposed Value</th>
                                                    <th class="py-1.5 px-3">Reason</th>
                                                </tr>
                                            </thead>
                                            <tbody class="divide-y divide-surface-container-high/40">
                                                @foreach (var crItem in entry.ChangeRequestItems)
                                                {
                                                    <tr>
                                                        <td class="py-1.5 px-3 font-medium text-on-surface">@crItem.FieldName</td>
                                                        <td class="py-1.5 px-3 text-secondary">@(crItem.OriginalValue ?? "—")</td>
                                                        <td class="py-1.5 px-3 font-semibold text-primary">@crItem.ProposedValue</td>
                                                        <td class="py-1.5 px-3 text-secondary italic">@(crItem.Reason ?? "—")</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>

                <!-- History Pagination -->
                @if (Model.History != null && Model.History.TotalPages > 1)
                {
                    var currentHistoryPage = Model.History.PageNumber;
                    var totalHistoryPages = Model.History.TotalPages;
                    var historyPageSize = Model.History.PageSize;

                    <div class="mt-6 pt-4 border-t border-surface-container-high/60 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs">
                        <div class="text-secondary">
                            Page <span class="font-semibold text-on-surface">@currentHistoryPage</span> of <span class="font-semibold text-on-surface">@totalHistoryPages</span> (Total @Model.History.TotalItems events)
                        </div>
                        <div class="flex items-center gap-1.5">
                            @if (currentHistoryPage > 1)
                            {
                                <a asp-controller="EmploymentContracts" asp-action="Details"
                                   asp-route-contractId="@Model.ContractId"
                                   asp-route-historyPage="@(currentHistoryPage - 1)"
                                   asp-route-historyPageSize="@historyPageSize"
                                   asp-fragment="contract-history-section"
                                   class="px-3 py-1.5 rounded-lg border border-surface-container-high bg-surface-container-low hover:bg-surface-container text-on-surface font-medium transition-colors flex items-center gap-1">
                                    <span class="material-symbols-outlined text-[16px]">chevron_left</span>
                                    <span>Previous</span>
                                </a>
                            }
                            else
                            {
                                <button type="button" disabled class="px-3 py-1.5 rounded-lg border border-surface-container-high bg-surface-container-low text-secondary/40 font-medium cursor-not-allowed flex items-center gap-1">
                                    <span class="material-symbols-outlined text-[16px]">chevron_left</span>
                                    <span>Previous</span>
                                </button>
                            }

                            @for (var p = Math.Max(1, currentHistoryPage - 2); p <= Math.Min(totalHistoryPages, currentHistoryPage + 2); p++)
                            {
                                var isCur = p == currentHistoryPage;
                                if (isCur)
                                {
                                    <span class="px-3 py-1.5 rounded-lg bg-primary text-on-primary font-bold">@p</span>
                                }
                                else
                                {
                                    <a asp-controller="EmploymentContracts" asp-action="Details"
                                       asp-route-contractId="@Model.ContractId"
                                       asp-route-historyPage="@p"
                                       asp-route-historyPageSize="@historyPageSize"
                                       asp-fragment="contract-history-section"
                                       class="px-3 py-1.5 rounded-lg border border-surface-container-high bg-surface-container-low hover:bg-surface-container text-on-surface font-medium transition-colors">@p</a>
                                }
                            }

                            @if (currentHistoryPage < totalHistoryPages)
                            {
                                <a asp-controller="EmploymentContracts" asp-action="Details"
                                   asp-route-contractId="@Model.ContractId"
                                   asp-route-historyPage="@(currentHistoryPage + 1)"
                                   asp-route-historyPageSize="@historyPageSize"
                                   asp-fragment="contract-history-section"
                                   class="px-3 py-1.5 rounded-lg border border-surface-container-high bg-surface-container-low hover:bg-surface-container text-on-surface font-medium transition-colors flex items-center gap-1">
                                    <span>Next</span>
                                    <span class="material-symbols-outlined text-[16px]">chevron_right</span>
                                </a>
                            }
                            else
                            {
                                <button type="button" disabled class="px-3 py-1.5 rounded-lg border border-surface-container-high bg-surface-container-low text-secondary/40 font-medium cursor-not-allowed flex items-center gap-1">
                                    <span>Next</span>
                                    <span class="material-symbols-outlined text-[16px]">chevron_right</span>
                                </button>
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="py-10 text-center flex flex-col items-center justify-center text-secondary">
                    <span class="material-symbols-outlined text-[48px] text-secondary/40 mb-2">history_toggle_off</span>
                    <p class="text-sm font-semibold text-on-surface">No history events recorded for this contract yet.</p>
                    <p class="text-xs text-secondary mt-1">Review, changes, submissions, and automated actions will be tracked here.</p>
                </div>
            }
        </div>
    </div>
</div>
