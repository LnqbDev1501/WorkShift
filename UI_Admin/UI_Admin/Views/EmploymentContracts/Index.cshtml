@model UI_Admin.Models.EmploymentContracts.EmploymentContractListViewModel

@{
    ViewData["Title"] = "Employment Contracts";
    var items = Model.Items;
    var currentPage = Model.PageNumber;
    var totalPages = Model.TotalPages;
    var hasFilters = !string.IsNullOrWhiteSpace(Model.Search)
        || (!string.IsNullOrWhiteSpace(Model.StatusFilter) && !Model.StatusFilter.Equals("all", StringComparison.OrdinalIgnoreCase))
        || Model.BranchIdFilter.HasValue
        || Model.RegionIdFilter.HasValue
        || !string.IsNullOrWhiteSpace(Model.StartDateFrom)
        || !string.IsNullOrWhiteSpace(Model.StartDateTo);
}

<div class="flex flex-col w-full gap-unit-4 px-7 py-4">

    <partial name="_NotificationModal" />

    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-unit-4">
        <div class="flex flex-col">
            <div class="list-eyebrow">HR Management</div>
            <div class="flex items-center gap-unit-3">
                <h1 class="font-display-lg text-display-lg text-on-surface tracking-tight">Employment Contracts</h1>
            </div>
            <p class="font-body-md text-body-md text-secondary mt-1">
                View and monitor part-time employment contracts across all branches.
            </p>
        </div>
    </div>

    <!-- Search & Filter Controls -->
    <div class="bg-surface-container-lowest rounded-xl p-4 shadow-sm border border-surface-container-high/60 my-2">
        <form method="get" asp-controller="EmploymentContracts" asp-action="Index"
              class="flex flex-col gap-3">
            <div class="flex flex-col sm:flex-row items-start sm:items-center gap-3 flex-wrap">

                <!-- Search Box -->
                <div class="relative w-full sm:w-72">
                    <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-[20px] text-secondary">search</span>
                    <input type="text"
                           id="filter-search"
                           name="search"
                           value="@Model.Search"
                           placeholder="Search by name, contract no..."
                           class="w-full h-10 pl-10 pr-4 bg-surface-container-low rounded-lg text-on-surface placeholder:text-secondary/70 font-body-md text-sm focus:outline-none focus:bg-surface-container-lowest focus:ring-2 focus:ring-primary border border-surface-container-high transition-all" />
                </div>

                <!-- Status Filter -->
                <div class="w-full sm:w-44">
                    <select id="filter-status" name="status" onchange="this.form.submit()"
                            class="w-full h-10 px-3 bg-surface-container-low rounded-lg text-on-surface font-body-md text-sm focus:outline-none focus:ring-2 focus:ring-primary border border-surface-container-high cursor-pointer transition-all">
                        <option value="all" selected="@(string.IsNullOrEmpty(Model.StatusFilter) || Model.StatusFilter == "all")">All Statuses</option>
                        <option value="DRAFT" selected="@(Model.StatusFilter == "DRAFT")">Draft</option>
                        <option value="PENDING_APPROVAL" selected="@(Model.StatusFilter == "PENDING_APPROVAL")">Pending Approval</option>
                        <option value="APPROVED" selected="@(Model.StatusFilter == "APPROVED")">Approved</option>
                        <option value="ACTIVE" selected="@(Model.StatusFilter == "ACTIVE")">Active</option>
                        <option value="REJECTED" selected="@(Model.StatusFilter == "REJECTED")">Rejected</option>
                        <option value="TERMINATED" selected="@(Model.StatusFilter == "TERMINATED")">Terminated</option>
                        <option value="EXPIRED" selected="@(Model.StatusFilter == "EXPIRED")">Expired</option>
                    </select>
                </div>

                <!-- Start Date From -->
                <div class="flex items-center gap-2">
                    <label class="text-xs text-secondary whitespace-nowrap">From:</label>
                    <input type="date" id="filter-start-from" name="startDateFrom" value="@Model.StartDateFrom"
                           class="h-10 px-3 bg-surface-container-low rounded-lg text-on-surface font-body-md text-sm focus:outline-none focus:ring-2 focus:ring-primary border border-surface-container-high transition-all" />
                </div>

                <!-- Start Date To -->
                <div class="flex items-center gap-2">
                    <label class="text-xs text-secondary whitespace-nowrap">To:</label>
                    <input type="date" id="filter-start-to" name="startDateTo" value="@Model.StartDateTo"
                           class="h-10 px-3 bg-surface-container-low rounded-lg text-on-surface font-body-md text-sm focus:outline-none focus:ring-2 focus:ring-primary border border-surface-container-high transition-all" />
                </div>

                <!-- Filter / Clear Buttons -->
                <div class="flex items-center gap-2 ml-auto">
                    <button type="submit" id="btn-filter"
                            class="h-10 px-4 rounded-lg bg-surface-container hover:bg-surface-container-high text-on-surface font-body-md-medium text-xs flex items-center gap-1.5 transition-colors cursor-pointer">
                        <span class="material-symbols-outlined text-[18px]">filter_list</span>
                        <span>Filter</span>
                    </button>
                    @if (hasFilters)
                    {
                        <a asp-controller="EmploymentContracts" asp-action="Index" id="btn-clear-filters"
                           class="h-10 px-3 rounded-lg text-secondary hover:text-on-surface hover:bg-surface-container font-body-md-medium text-xs flex items-center gap-1 transition-colors">
                            <span class="material-symbols-outlined text-[18px]">close</span>
                            <span>Clear</span>
                        </a>
                    }
                </div>
            </div>
        </form>
    </div>

    <!-- Results summary -->
    <div class="flex items-center justify-between px-1">
        <p class="text-xs text-secondary">
            @if (Model.TotalItems == 0)
            {
                <span>No contracts found.</span>
            }
            else
            {
                var first = (currentPage - 1) * Model.PageSize + 1;
                var last = Math.Min(currentPage * Model.PageSize, Model.TotalItems);
                <span>Showing @first–@last of @Model.TotalItems contract(s)</span>
            }
        </p>
    </div>

    <!-- Main Table -->
    <div class="bg-surface-container-lowest rounded-xl shadow-sm overflow-hidden border border-surface-container-high/60">
        <div class="overflow-x-auto">
            <table class="w-full text-left">
                <thead>
                    <tr class="h-[40px] bg-surface-container-low text-secondary text-label-md font-label-md uppercase tracking-wider">
                        <th class="px-unit-5 py-2" scope="col">Contract No.</th>
                        <th class="px-unit-4 py-2" scope="col">Employee</th>
                        <th class="px-unit-4 py-2" scope="col">Position</th>
                        <th class="px-unit-4 py-2" scope="col">Branch</th>
                        <th class="px-unit-4 py-2" scope="col">Region</th>
                        <th class="px-unit-4 py-2" scope="col">Start Date</th>
                        <th class="px-unit-4 py-2" scope="col">End Date</th>
                        <th class="px-unit-4 py-2" scope="col">Hourly Rate</th>
                        <th class="px-unit-4 py-2" scope="col">Status</th>
                        <th class="px-unit-4 py-2" scope="col">PDF</th>
                        <th class="px-unit-4 py-2 text-right" scope="col">Action</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-surface-container-high/40">
                    @if (!items.Any())
                    {
                        <tr>
                            <td colspan="11" class="px-6 py-16 text-center">
                                <div class="flex flex-col items-center gap-3 text-secondary">
                                    <span class="material-symbols-outlined text-[48px] text-secondary/40">description</span>
                                    <p class="font-body-md text-sm">No employment contracts match your filters.</p>
                                    @if (hasFilters)
                                    {
                                        <a asp-controller="EmploymentContracts" asp-action="Index"
                                           class="text-primary hover:underline text-xs font-medium">Clear filters</a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var contract in items)
                        {
                            var statusUpper = contract.Status?.ToUpperInvariant() ?? "";
                            <tr class="hover:bg-surface-container-low/50 transition-colors duration-100 group">
                                <!-- Contract Number -->
                                <td class="px-unit-5 py-3">
                                    <span class="font-mono text-xs font-semibold text-on-surface">@contract.ContractNumber</span>
                                </td>
                                <!-- Employee -->
                                <td class="px-unit-4 py-3">
                                    <div class="flex flex-col">
                                        <span class="font-body-md text-sm text-on-surface font-medium">@contract.StaffName</span>
                                        <span class="text-[11px] text-secondary font-mono">@contract.StaffId.ToString()[..8]…</span>
                                    </div>
                                </td>
                                <!-- Position -->
                                <td class="px-unit-4 py-3">
                                    <span class="text-sm text-secondary">@contract.EmployeePosition</span>
                                </td>
                                <!-- Branch -->
                                <td class="px-unit-4 py-3">
                                    <span class="text-sm text-on-surface">@contract.BranchName</span>
                                </td>
                                <!-- Region -->
                                <td class="px-unit-4 py-3">
                                    <span class="text-sm text-secondary">@contract.RegionName</span>
                                </td>
                                <!-- Start Date -->
                                <td class="px-unit-4 py-3">
                                    <span class="text-sm text-on-surface tabular-nums">@contract.StartDate.ToString("dd/MM/yyyy")</span>
                                </td>
                                <!-- End Date -->
                                <td class="px-unit-4 py-3">
                                    <span class="text-sm text-secondary tabular-nums">
                                        @(contract.EndDate.HasValue ? contract.EndDate.Value.ToString("dd/MM/yyyy") : "—")
                                    </span>
                                </td>
                                <!-- Hourly Rate -->
                                <td class="px-unit-4 py-3">
                                    <span class="text-sm font-semibold text-on-surface tabular-nums">@contract.HourlyRate.ToString("N0") ₫/h</span>
                                </td>
                                <!-- Status Badge -->
                                <td class="px-unit-4 py-3">
                                    @switch (statusUpper)
                                    {
                                        case "DRAFT":
                                            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-semibold bg-amber-50 text-amber-700 border border-amber-200">
                                                <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>Draft
                                            </span>
                                            break;
                                        case "PENDING_APPROVAL":
                                            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-semibold bg-purple-50 text-purple-700 border border-purple-200">
                                                <span class="w-1.5 h-1.5 rounded-full bg-purple-500 animate-pulse"></span>Pending
                                            </span>
                                            break;
                                        case "APPROVED":
                                            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-semibold bg-blue-50 text-blue-700 border border-blue-200">
                                                <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>Approved
                                            </span>
                                            break;
                                        case "ACTIVE":
                                            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
                                                <span class="w-1.5 h-1.5 rounded-full bg-emerald-600 animate-pulse"></span>Active
                                            </span>
                                            break;
                                        case "REJECTED":
                                            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-semibold bg-rose-50 text-rose-700 border border-rose-200">
                                                <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>Rejected
                                            </span>
                                            break;
                                        case "TERMINATED":
                                            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-semibold bg-slate-100 text-slate-600 border border-slate-200">
                                                <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>Terminated
                                            </span>
                                            break;
                                        case "EXPIRED":
                                            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-semibold bg-gray-100 text-gray-500 border border-gray-200">
                                                <span class="w-1.5 h-1.5 rounded-full bg-gray-400"></span>Expired
                                            </span>
                                            break;
                                        default:
                                            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-semibold bg-gray-50 text-gray-500 border border-gray-200">@contract.Status</span>
                                            break;
                                    }
                                </td>
                                <!-- PDF -->
                                <td class="px-unit-4 py-3">
                                    @if (contract.HasPdf)
                                    {
                                        <span class="material-symbols-outlined text-[20px] text-emerald-600" title="PDF available">picture_as_pdf</span>
                                    }
                                    else
                                    {
                                        <span class="material-symbols-outlined text-[20px] text-secondary/30" title="No PDF">picture_as_pdf</span>
                                    }
                                </td>
                                <!-- Action -->
                                <td class="px-unit-4 py-3 text-right">
                                    <a asp-controller="EmploymentContracts" asp-action="Details"
                                       asp-route-contractId="@contract.ContractId"
                                       class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg bg-surface-container hover:bg-primary-container hover:text-on-primary text-on-surface text-xs font-medium transition-all"
                                       title="View details">
                                        <span class="material-symbols-outlined text-[16px]">visibility</span>
                                        <span>View</span>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Pagination -->
    @if (totalPages > 1)
    {
        <div class="flex items-center justify-center gap-2 pt-2">
            @if (currentPage > 1)
            {
                <a asp-controller="EmploymentContracts" asp-action="Index"
                   asp-route-page="@(currentPage - 1)"
                   asp-route-search="@Model.Search"
                   asp-route-status="@Model.StatusFilter"
                   asp-route-branchId="@Model.BranchIdFilter"
                   asp-route-regionId="@Model.RegionIdFilter"
                   asp-route-startDateFrom="@Model.StartDateFrom"
                   asp-route-startDateTo="@Model.StartDateTo"
                   class="inline-flex items-center justify-center w-9 h-9 rounded-lg bg-surface-container hover:bg-surface-container-high text-on-surface transition-colors">
                    <span class="material-symbols-outlined text-[18px]">chevron_left</span>
                </a>
            }

            @for (int p = Math.Max(1, currentPage - 2); p <= Math.Min(totalPages, currentPage + 2); p++)
            {
                <a asp-controller="EmploymentContracts" asp-action="Index"
                   asp-route-page="@p"
                   asp-route-search="@Model.Search"
                   asp-route-status="@Model.StatusFilter"
                   asp-route-branchId="@Model.BranchIdFilter"
                   asp-route-regionId="@Model.RegionIdFilter"
                   asp-route-startDateFrom="@Model.StartDateFrom"
                   asp-route-startDateTo="@Model.StartDateTo"
                   class="inline-flex items-center justify-center w-9 h-9 rounded-lg text-sm font-medium transition-colors @(p == currentPage ? "bg-primary-container text-on-primary shadow-sm" : "bg-surface-container hover:bg-surface-container-high text-on-surface")">
                    @p
                </a>
            }

            @if (currentPage < totalPages)
            {
                <a asp-controller="EmploymentContracts" asp-action="Index"
                   asp-route-page="@(currentPage + 1)"
                   asp-route-search="@Model.Search"
                   asp-route-status="@Model.StatusFilter"
                   asp-route-branchId="@Model.BranchIdFilter"
                   asp-route-regionId="@Model.RegionIdFilter"
                   asp-route-startDateFrom="@Model.StartDateFrom"
                   asp-route-startDateTo="@Model.StartDateTo"
                   class="inline-flex items-center justify-center w-9 h-9 rounded-lg bg-surface-container hover:bg-surface-container-high text-on-surface transition-colors">
                    <span class="material-symbols-outlined text-[18px]">chevron_right</span>
                </a>
            }
        </div>
        <p class="text-center text-xs text-secondary pb-1">Page @currentPage of @totalPages</p>
    }

</div>
