@model UI_Admin.Models.Auth.StaffSetupViewModel
@{
    ViewData["Title"] = "Set Up Your Account";
    var apiBaseUrl = (ViewData["ApiBaseUrl"] as string) ?? "https://localhost:7193";
}
<link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />

<div class="ws-auth">
    <!-- Brand panel -->
    <aside class="ws-auth-brand">
        <span class="ws-auth-orb ws-auth-orb-a"></span>
        <span class="ws-auth-orb ws-auth-orb-b"></span>

        <div class="ws-auth-logo">
            <span class="ws-auth-logo-mark">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/></svg>
            </span>
            <span><strong>WorkShift</strong><small>Workforce OS</small></span>
        </div>

        <div class="ws-auth-hero">
            <span class="ws-auth-eyebrow"><span class="dot"></span>Account setup</span>
            <h1>Welcome, <em>@Model.FullName</em></h1>
            <p>Set your password to activate your WorkShift account and start managing your shifts.</p>
        </div>

        <div class="ws-auth-feats">
            <div class="ws-auth-feat">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#4ade80" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                <span><b>Secure by default</b> — your password is never stored in plain text.</span>
            </div>
            <div class="ws-auth-feat">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#4ade80" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-3.6 8-10V5l-8-3-8 3v7c0 6.4 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
                <span><b>Face check-in ready</b> — enable biometric login after setup.</span>
            </div>
            <div class="ws-auth-feat">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#4ade80" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="20" height="12" rx="3"/><circle cx="12" cy="12" r="2.6"/><path d="M6 12h.01M18 12h.01"/></svg>
                <span><b>All branches, one login</b> — access every store you're assigned to.</span>
            </div>
        </div>

        <div class="ws-auth-foot">
            <div class="ws-auth-stats">
                <span><b>Multi-branch</b><small>regions & stores unified</small></span>
                <span><b>Real-time</b><small>attendance & alerts</small></span>
                <span><b>Role-based</b><small>admin &middot; manager &middot; staff</small></span>
            </div>
            <span>&copy; 2026 WorkShift</span>
        </div>
    </aside>

    <!-- Form side -->
    <main class="ws-auth-form-wrap">
        <div class="ws-auth-card-form">
            <h2>Create your password</h2>
            <p class="ws-auth-sub">Your account <strong>@Model.Email</strong> is ready. Choose a strong password to continue.</p>

            <div id="invalid-link" class="ws-success ws-alert-error d-none">
                The setup link is invalid or has expired. Please ask your manager to resend it.
            </div>

            <form asp-action="StaffSetup" method="post" id="setup-form" novalidate>
                <input asp-for="Token" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

                <div class="ws-field">
                    <label asp-for="Password">New Password</label>
                    <div class="ws-input">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                        <input asp-for="Password" placeholder="Enter your password" autocomplete="new-password" id="setup-password" />
                        <button class="ws-eye" type="button" id="toggle-password" title="Show / hide password" aria-label="Show / hide password">
                            <svg id="eye-open" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg>
                            <svg id="eye-closed" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none"><path d="M9.9 4.24A9.5 9.5 0 0 1 12 4c6.5 0 10 8 10 8a17 17 0 0 1-2.16 3.19M6.61 6.61A16.8 16.8 0 0 0 2 12s3.5 8 10 8a9.9 9.9 0 0 0 5.39-1.61"/><line x1="2" y1="2" x2="22" y2="22"/><path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"/></svg>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="field-validation-error"></span>
                </div>

                <div class="ws-field">
                    <label asp-for="ConfirmPassword">Confirm Password</label>
                    <div class="ws-input">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                        <input asp-for="ConfirmPassword" placeholder="Confirm your password" autocomplete="new-password" id="confirm-password" />
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
                </div>

                <button type="submit" class="ws-btn" id="submit-btn">
                    Activate Account
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                </button>
            </form>

            <div class="ws-secure">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                Protected by Supabase Auth &middot; This link expires in 3 minutes
            </div>
        </div>
    </main>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var passwordInput = document.getElementById('setup-password');
            var toggle = document.getElementById('toggle-password');
            var open = document.getElementById('eye-open');
            var closed = document.getElementById('eye-closed');

            toggle?.addEventListener('click', function () {
                var show = passwordInput.type === 'password';
                passwordInput.type = show ? 'text' : 'password';
                open.style.display = show ? 'none' : '';
                closed.style.display = show ? '' : 'none';
                passwordInput.focus();
            });

            // Validate token on page load
            var tokenInput = document.querySelector('input[name="Token"]');
            var token = tokenInput?.value;

            if (!token) {
                showError("The setup link is invalid or has expired. Please ask your manager to resend it.");
                return;
            }

            // Call API to validate token
            fetch('@(apiBaseUrl.TrimEnd('/'))/api/auth/staff-setup/validate', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ token: token })
            })
            .then(function (response) {
                if (!response.ok) {
                    return response.json().then(function (data) {
                        throw new Error(data.message || "The setup link is invalid or has expired.");
                    });
                }
                return response.json();
            })
            .then(function (data) {
                // Token valid - form is ready
                document.getElementById('submit-btn').disabled = false;
                // Populate email and name display
                var emailEl = document.querySelector('.ws-auth-sub strong');
                if (emailEl && data.email) emailEl.textContent = data.email;
                var heroName = document.querySelector('.ws-auth-hero h1 em');
                if (heroName && data.fullName) heroName.textContent = data.fullName;
            })
            .catch(function (error) {
                showError(error.message);
            });

            function showError(message) {
                var errorBox = document.getElementById('invalid-link');
                errorBox.textContent = message;
                errorBox.classList.remove('d-none');
                var form = document.getElementById('setup-form');
                form.style.display = 'none';
            }

            // Form submit
            var form = document.getElementById('setup-form');
            form?.addEventListener('submit', function (e) {
                e.preventDefault();
                var pwd = passwordInput.value;
                var confirm = document.getElementById('confirm-password').value;
                if (pwd !== confirm) {
                    return; // Validation will handle
                }

                var btn = document.getElementById('submit-btn');
                btn.disabled = true;
                btn.innerHTML = 'Activating...<span class="spinner-border spinner-border-sm ms-2"></span>';

                fetch('@(apiBaseUrl.TrimEnd('/'))/api/auth/staff-setup/set-password', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ token: token, password: pwd })
                })
                .then(function (response) {
                    if (!response.ok) {
                        return response.json().then(function (data) {
                            throw new Error(data.message || "Unable to set password. Please try again.");
                        });
                    }
                    window.location.href = '/Auth/StaffSetupSuccess';
                })
                .catch(function (error) {
                    btn.disabled = false;
                    btn.innerHTML = 'Activate Account<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>';
                    var errorBox = document.getElementById('invalid-link');
                    errorBox.textContent = error.message;
                    errorBox.classList.remove('d-none');
                });
            });
        })();
    </script>
    <style>
        .ws-alert-error { background: #fef2f2; border-color: #fecaca; color: #b91c1c; }
        .spinner-border { display: inline-block; width: 1rem; height: 1rem; vertical-align: text-bottom; border: 0.2em solid currentColor; border-right-color: transparent; border-radius: 50%; animation: spinner .75s linear infinite; }
        @@keyframes spinner { to { transform: rotate(360deg); } }
    </style>
}