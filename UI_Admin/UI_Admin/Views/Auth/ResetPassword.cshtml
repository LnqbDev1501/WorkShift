@using UI_Admin.Models.Admin.UserAdmin
@model SetPasswordViewModel
@{
    ViewData["Title"] = "Reset password";
}

<div class="row justify-content-center mt-5"><div class="col-md-6 col-lg-5"><div class="card shadow-sm"><div class="card-body p-4">
    <h1 class="h3 mb-3">Choose a new password</h1>
    <div id="invalid-link" class="alert alert-danger d-none">The password reset link is invalid or has expired.</div>
    <form asp-action="ResetPassword" method="post" id="reset-password-form" hidden>
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <input asp-for="AccessToken" type="hidden" id="access-token" />
        <div class="mb-3"><label asp-for="Password" class="form-label"></label><div class="input-group"><input asp-for="Password" class="form-control" autocomplete="new-password" id="new-password" /><button type="button" class="btn btn-outline-secondary" data-toggle-password="new-password">Show</button></div><span asp-validation-for="Password" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="ConfirmPassword" class="form-label"></label><div class="input-group"><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" id="confirm-password" /><button type="button" class="btn btn-outline-secondary" data-toggle-password="confirm-password">Show</button></div><span asp-validation-for="ConfirmPassword" class="text-danger"></span></div>
        <button type="submit" class="btn btn-primary w-100" id="submit-button" disabled>Reset password</button>
    </form>
</div></div></div></div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            document.querySelectorAll('[data-toggle-password]').forEach(button => {
                button.addEventListener('click', () => {
                    const input = document.getElementById(button.dataset.togglePassword);
                    const hidden = input.type === 'password';
                    input.type = hidden ? 'text' : 'password';
                    button.textContent = hidden ? 'Hide' : 'Show';
                });
            });

            const hashParams = new URLSearchParams(window.location.hash.substring(1));
            const queryParams = new URLSearchParams(window.location.search);
            const token = hashParams.get('access_token') || queryParams.get('access_token');
            const linkType = hashParams.get('type') || queryParams.get('type');
            const isRecovery = !linkType || linkType === 'recovery';
            const error = hashParams.get('error_description') || queryParams.get('error_description');
            const tokenInput = document.getElementById('access-token');

            if ((token && isRecovery) || tokenInput.value) {
                if (token) tokenInput.value = token;
                document.getElementById('reset-password-form').hidden = false;
                document.getElementById('submit-button').disabled = false;
                if (window.location.hash) {
                    history.replaceState(null, '', window.location.pathname + window.location.search);
                }
                return;
            }

            const errorBox = document.getElementById('invalid-link');
            if (error) {
                errorBox.textContent = decodeURIComponent(error.replace(/\+/g, ' '));
            }
            errorBox.classList.remove('d-none');
        })();
    </script>
}
