@model UI_Admin.Models.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot password";
    ViewData["FullBleed"] = true;
}
<link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />

<div class="ws-auth">
    <!-- Brand panel -->
    <aside class="ws-auth-brand">
        <span class="ws-auth-orb ws-auth-orb-a"></span>
        <span class="ws-auth-orb ws-auth-orb-b"></span>

        <div class="ws-auth-logo">
            <span class="ws-auth-logo-mark">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/></svg>
            </span>
            <span><strong>WorkShift</strong><small>Workforce OS</small></span>
        </div>

        <div class="ws-auth-hero">
            <span class="ws-auth-eyebrow"><span class="dot"></span>Account recovery</span>
            <h1>Locked out? <em>Back on shift in a minute.</em></h1>
            <p>Enter your work email and we will send a secure reset link. The link expires quickly to keep every branch account safe.</p>
        </div>

        <div class="ws-auth-art" aria-hidden="true">
            <div class="ws-auth-card ws-auth-schedule">
                <h4>Reset link &middot; how it works</h4>
                <div class="ws-auth-week">
                    <div class="ws-auth-day on">1<b>@@</b></div>
                    <div class="ws-auth-day">2<b>&#10003;</b></div>
                    <div class="ws-auth-day">3<b>&#8635;</b></div>
                    <div class="ws-auth-day">4<b>&#9881;</b></div>
                    <div class="ws-auth-day">5<b>&#10003;</b></div>
                    <div class="ws-auth-day">6<b>&#10003;</b></div>
                    <div class="ws-auth-day">7<b>&#10003;</b></div>
                </div>
            </div>
            <div class="ws-auth-card ws-auth-toast">
                <span class="ws-auth-check" style="background:#e0e7ff;color:#4f46e5">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="3"/><path d="m22 7-10 6L2 7"/></svg>
                </span>
                <span><strong>Reset link on its way</strong><small>valid for a few minutes only</small></span>
            </div>
            <div class="ws-auth-card ws-auth-shift">
                <span class="ws-auth-check">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                </span>
                <span><strong>Back to the floor, fast</strong><small>one link &middot; new password &middot; done</small></span>
            </div>
        </div>

        <div class="ws-auth-feats">
            <div class="ws-auth-feat">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#4ade80" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-3.6 8-10V5l-8-3-8 3v7c0 6.4 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
                <span><b>Single-use secure link</b> — tied to your account and branch.</span>
            </div>
            <div class="ws-auth-feat">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#4ade80" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/></svg>
                <span><b>Expires in minutes</b> — request a fresh one any time.</span>
            </div>
            <div class="ws-auth-feat">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#4ade80" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                <span><b>Nothing to remember</b> — no security questions, no waiting on IT.</span>
            </div>
        </div>

        <div class="ws-auth-foot">
            <div class="ws-auth-stats">
                <span><b>Multi-branch</b><small>regions &amp; stores unified</small></span>
                <span><b>Real-time</b><small>attendance &amp; alerts</small></span>
                <span><b>Role-based</b><small>admin &middot; manager &middot; staff</small></span>
            </div>
            <span>&copy; 2026 WorkShift</span>
        </div>
    </aside>

    <!-- Form side -->
    <main class="ws-auth-form-wrap">
        <div class="ws-auth-card-form">
            <a asp-action="Login" class="ws-back">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M11 18l-6-6 6-6"/></svg>
                Back to sign in
            </a>
            @if (Model.Submitted)
            {
                <div class="ws-mail-art" aria-hidden="true">
                    <span class="ring">
                        <svg width="38" height="38" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="3"/><path d="m22 7-10 6L2 7"/></svg>
                    </span>
                </div>
                <h2>Check your inbox</h2>
                <p class="ws-auth-sub">If the email belongs to an active WorkShift account, a password reset link is on its way.</p>
                <div class="ws-success"><b>What to do next</b>Open the newest email from WorkShift and click the reset link before it expires.</div>
                <ul class="ws-tips">
                    <li><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>Nothing after a minute? Peek inside Spam / Promotions.</li>
                    <li><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>Links expire quickly — request a new one if yours lapses.</li>
                    <li><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>Still stuck? Ask your branch manager to verify your account.</li>
                </ul>
            }
            else
            {
                <h2>Forgot password?</h2>
                <p class="ws-auth-sub">No stress — enter your work email and we will send a reset link.</p>
                <form asp-action="ForgotPassword" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
                    <div class="ws-field">
                        <label asp-for="Email">Work email</label>
                        <div class="ws-input">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="3"/><path d="m22 7-10 6L2 7"/></svg>
                            <input asp-for="Email" placeholder="you@workshift.com" autocomplete="email" />
                        </div>
                        <span asp-validation-for="Email" class="field-validation-error"></span>
                    </div>
                    <button type="submit" class="ws-btn">
                        Send reset link
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m22 2-7 20-4-9-9-4z"/><path d="M22 2 11 13"/></svg>
                    </button>
                </form>
            }
            <div class="ws-secure">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                Protected by Supabase Auth &middot; links expire after a few minutes
            </div>
        </div>
    </main>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
