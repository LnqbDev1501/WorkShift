@model UI_Admin.Models.SetPasswordViewModel
@{
    ViewData["Title"] = "Set Password";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h3 mb-3">Set Password</h1>

                <p class="text-muted">
                    Your password must contain at least 6 characters, including
                    a letter, a number, an uppercase letter, and a special character.
                </p>

                <div id="invalid-link" class="alert alert-danger d-none">
                    The password setup link is invalid or has expired.
                </div>

                <form asp-action="SetPassword" method="post" id="set-password-form">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <input asp-for="AccessToken"
                           type="hidden"
                           id="access-token" />

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">
                            New Password
                        </label>

                        <div class="input-group">
                            <input asp-for="Password" class="form-control" autocomplete="new-password" id="new-password" />
                            <button type="button" class="btn btn-outline-secondary" data-toggle-password="new-password">Show</button>
                        </div>

                        <span asp-validation-for="Password"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ConfirmPassword" class="form-label">
                            Confirm Password
                        </label>

                        <div class="input-group">
                            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" id="confirm-password" />
                            <button type="button" class="btn btn-outline-secondary" data-toggle-password="confirm-password">Show</button>
                        </div>

                        <span asp-validation-for="ConfirmPassword"
                              class="text-danger">
                        </span>
                    </div>

                    <button type="submit"
                            class="btn btn-primary w-100"
                            id="submit-button"
                            disabled>
                        Set Password
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (() => {
            document.querySelectorAll('[data-toggle-password]').forEach(button => {
                button.addEventListener('click', () => {
                    const input = document.getElementById(button.dataset.togglePassword);
                    const hidden = input.type === 'password';
                    input.type = hidden ? 'text' : 'password';
                    button.textContent = hidden ? 'Hide' : 'Show';
                });
            });

            const parameters = new URLSearchParams(
                window.location.hash.substring(1)
            );

            const token = parameters.get('access_token');
            const linkType = parameters.get('type');

            const isPasswordSetup =
                linkType === 'invite' ||
                linkType === 'recovery';

            const error = parameters.get('error_description');
            const tokenInput = document.getElementById('access-token');

            if (token && isPasswordSetup) {
                tokenInput.value = token;

                document.getElementById('submit-button').disabled = false;

                history.replaceState(
                    null,
                    '',
                    window.location.pathname + window.location.search
                );

                return;
            }

            if (tokenInput.value) {
                document.getElementById('submit-button').disabled = false;
                return;
            }

            const errorBox = document.getElementById('invalid-link');

            errorBox.textContent = error
                ? decodeURIComponent(error.replace(/\+/g, ' '))
                : errorBox.textContent;

            errorBox.classList.remove('d-none');
        })();
    </script>
}
