@model UI_Admin.Models.PayrollDocuments.PayslipDetailsResponse
@using D = UI_Admin.Models.Accountant.PayrollPeriods.PeriodDisplay
@using W = UI_Admin.Models.PayrollDocuments.PayrollDocumentDisplay
@{
    var p = Model.Payslip;
    ViewData["Title"] = $"Payslip #{p.PayslipId} — {p.EmployeeName}";
}

<div class="px-7 py-6 max-w-[1400px] mx-auto space-y-6">
    <!-- Header Title & Action Bar -->
    <div class="flex flex-col md:flex-row md:items-start justify-between gap-4">
        <div>
            <div class="flex items-center gap-1.5 text-xs text-indigo-600 font-semibold uppercase tracking-wider mb-1">
                <span class="material-symbols-outlined text-sm">receipt_long</span>
                <span>Payroll / Official Payslip</span>
            </div>
            <div class="flex items-center gap-3 flex-wrap">
                <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Payslip #@p.PayslipId — @p.EmployeeName</h1>
                @if (p.Status == "PUBLISHED")
                {
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                        PUBLISHED
                    </span>
                }
                else if (p.Status == "REPLACED")
                {
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-slate-100 text-slate-600 border border-slate-200">
                        REPLACED
                    </span>
                }
                else
                {
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-slate-100 text-slate-700 border border-slate-200">
                        @p.Status
                    </span>
                }
            </div>
            <p class="text-sm text-slate-500 mt-1 flex flex-wrap items-center gap-2">
                <span>Period: <strong class="text-slate-800 font-semibold">@p.PeriodCode</strong></span>
                <span>•</span>
                <span>@p.PeriodStart.ToString("dd/MM/yyyy") – @p.PeriodEnd.ToString("dd/MM/yyyy")</span>
                <span>•</span>
                <span>Version: <strong class="text-indigo-600 font-mono font-bold">V@(p.VersionNo)</strong></span>
            </p>
        </div>

        <div class="flex items-center gap-2.5 shrink-0 flex-wrap">
            <a asp-action="Index"
               class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-white hover:bg-slate-50 text-slate-700 hover:text-slate-900 border border-slate-200 text-sm font-medium transition-all shadow-sm">
                <span class="material-symbols-outlined text-lg">arrow_back</span>
                <span>Back to Payslips</span>
            </a>
            <a asp-action="Versions" asp-route-id="@p.PayslipId"
               class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-white hover:bg-slate-50 text-slate-700 border border-slate-200 text-sm font-medium transition-all shadow-sm">
                <span class="material-symbols-outlined text-base">history</span>
                <span>Version History</span>
            </a>
        </div>
    </div>

    <!-- Alert Notifications -->
    <partial name="_PayrollWorkflowMessages" />

    <!-- 4 KPI Summary Cards (Manager Style) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- Work Pay -->
        <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm flex flex-col justify-between">
            <div class="flex items-center justify-between text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">
                <span>Work Pay</span>
                <span class="material-symbols-outlined text-indigo-600 text-lg">schedule</span>
            </div>
            <div>
                <div class="text-2xl font-bold text-slate-900 tracking-tight">@D.Money(p.WorkPay)</div>
                <div class="text-xs text-slate-400 mt-1">@p.TotalWorkHours.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) Work Hours</div>
            </div>
        </div>

        <!-- Total Rewards -->
        <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm flex flex-col justify-between">
            <div class="flex items-center justify-between text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">
                <span>Total Rewards</span>
                <span class="material-symbols-outlined text-emerald-600 text-lg">workspace_premium</span>
            </div>
            <div>
                <div class="text-2xl font-bold text-emerald-700 tracking-tight">@D.Money(p.TotalReward)</div>
                <div class="text-xs text-slate-400 mt-1">Bonuses &amp; Allowances</div>
            </div>
        </div>

        <!-- Total Deductions -->
        <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm flex flex-col justify-between">
            <div class="flex items-center justify-between text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">
                <span>Total Deductions</span>
                <span class="material-symbols-outlined text-rose-600 text-lg">remove_circle</span>
            </div>
            <div>
                <div class="text-2xl font-bold text-rose-700 tracking-tight">@D.Money(p.TotalDeduction)</div>
                <div class="text-xs text-slate-400 mt-1">Penalties &amp; Applied CF</div>
            </div>
        </div>

        <!-- Net Salary -->
        <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm flex flex-col justify-between">
            <div class="flex items-center justify-between text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">
                <span>Net Salary</span>
                <span class="material-symbols-outlined text-indigo-600 text-lg">payments</span>
            </div>
            <div>
                <div class="text-2xl font-bold text-slate-900 tracking-tight">@D.Money(p.NetSalary)</div>
                <div class="text-xs text-slate-400 mt-1">Final Disbursed Amount</div>
            </div>
        </div>
    </div>

    <!-- Employee Information Snapshot Card -->
    <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm space-y-4">
        <div class="flex items-center gap-2 border-b border-slate-100 pb-3">
            <span class="material-symbols-outlined text-indigo-600 text-lg">badge</span>
            <h2 class="text-xs font-bold text-slate-900 uppercase tracking-wider">Employee &amp; Statement Snapshot</h2>
        </div>

        <dl class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4 text-xs">
            <div class="p-3 rounded-xl bg-slate-50 border border-slate-100">
                <dt class="text-slate-500 font-medium">Employee</dt>
                <dd class="text-sm font-bold text-slate-900 mt-0.5">@p.EmployeeName</dd>
            </div>
            <div class="p-3 rounded-xl bg-slate-50 border border-slate-100">
                <dt class="text-slate-500 font-medium">Branch / Position</dt>
                <dd class="text-sm font-bold text-slate-900 mt-0.5">@p.BranchName • @p.EmployeePosition</dd>
            </div>
            <div class="p-3 rounded-xl bg-slate-50 border border-slate-100">
                <dt class="text-slate-500 font-medium">Hourly Base Rate</dt>
                <dd class="text-sm font-bold text-slate-900 mt-0.5">@D.Money(p.HourlyRate) / hour</dd>
            </div>
            <div class="p-3 rounded-xl bg-slate-50 border border-slate-100">
                <dt class="text-slate-500 font-medium">Published At (UTC+7)</dt>
                <dd class="text-sm font-bold text-slate-900 mt-0.5">@D.Time(p.PublishedAt)</dd>
            </div>
            <div class="p-3 rounded-xl bg-slate-50 border border-slate-100">
                <dt class="text-slate-500 font-medium">Feedback Deadline (UTC+7)</dt>
                <dd class="text-sm font-bold text-slate-900 mt-0.5">@D.Time(p.FeedbackDeadlineAt)</dd>
            </div>
            <div class="p-3 rounded-xl bg-slate-50 border border-slate-100">
                <dt class="text-slate-500 font-medium">Deferred Deduction Balance</dt>
                <dd class="text-sm font-bold text-amber-700 mt-0.5">@D.Money(p.DeferredDeductionAmount)</dd>
            </div>
        </dl>

        @if (!string.IsNullOrEmpty(p.CorrectionReason))
        {
            <div class="p-4 rounded-xl bg-amber-50 border border-amber-200 text-xs text-amber-900">
                <strong class="font-bold">Revision Notice:</strong>
                <span class="ml-1">@p.CorrectionReason</span>
            </div>
        }
    </div>

    <!-- 1. Work Details Table (Manager Style) -->
    <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden">
        <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between bg-slate-50/60">
            <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-indigo-600 text-lg">calendar_month</span>
                <h3 class="text-sm font-bold text-slate-900">1. Shift &amp; Attendance Details</h3>
            </div>
            <div class="text-xs text-slate-500 font-medium">
                Total: @p.TotalWorkHours.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) Hours
            </div>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-xs">
                <thead>
                    <tr class="border-b border-slate-150 bg-slate-50/50 text-[11px] font-bold text-slate-500 uppercase tracking-wider">
                        <th class="py-3.5 px-6">Work Date</th>
                        <th class="py-3.5 px-6">Shift / Scheduled</th>
                        <th class="py-3.5 px-6">Check In</th>
                        <th class="py-3.5 px-6">Check Out</th>
                        <th class="py-3.5 px-6">Payable Minutes</th>
                        <th class="py-3.5 px-6">Late / Early</th>
                        <th class="py-3.5 px-6">Status / Note</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var w in Model.WorkDetails.OrderBy(w => w.DisplayOrder))
                    {
                        <tr class="hover:bg-slate-50/80 transition-colors">
                            <td class="py-3.5 px-6 font-semibold text-slate-900">
                                @w.WorkDate.ToString("dd/MM/yyyy")
                            </td>
                            <td class="py-3.5 px-6">
                                <div class="font-medium text-slate-800">@w.ShiftName</div>
                                <div class="text-[11px] text-slate-400 mt-0.5">
                                    @W.Time(w.ScheduledStartAt) – @W.Time(w.ScheduledEndAt) · Break @w.BreakMinutes m
                                </div>
                            </td>
                            <td class="py-3.5 px-6 text-slate-700 font-mono">
                                @W.Time(w.CheckInTime)
                            </td>
                            <td class="py-3.5 px-6 text-slate-700 font-mono">
                                @W.Time(w.CheckOutTime)
                            </td>
                            <td class="py-3.5 px-6 font-semibold text-slate-900">
                                @w.PayableMinutes min
                                <span class="block text-[11px] text-slate-400 font-normal">Actual: @w.ActualWorkingMinutes min</span>
                            </td>
                            <td class="py-3.5 px-6 text-slate-600">
                                @if (w.TotalLateMinutes > 0)
                                {
                                    <span class="text-rose-600 block">Late: @w.TotalLateMinutes m (@w.ChargeableLateMinutes chargeable)</span>
                                }
                                @if (w.TotalEarlyLeaveMinutes > 0)
                                {
                                    <span class="text-amber-600 block">Early: @w.TotalEarlyLeaveMinutes m (@w.ChargeableEarlyLeaveMinutes chargeable)</span>
                                }
                                @if (w.TotalLateMinutes == 0 && w.TotalEarlyLeaveMinutes == 0)
                                {
                                    <span class="text-slate-400">—</span>
                                }
                            </td>
                            <td class="py-3.5 px-6">
                                <span class="font-medium text-slate-800">@w.AttendanceStatus</span>
                                @if (!string.IsNullOrEmpty(w.Note))
                                {
                                    <span class="text-[11px] text-slate-400 block mt-0.5">@w.Note</span>
                                }
                            </td>
                        </tr>
                    }
                    @if (Model.WorkDetails.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="py-8 text-center text-slate-400">
                                No shift work details recorded on this statement.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- 2, 3, 4. Calculation Details Groups -->
    @foreach (var group in new[]
    {
        (Title: "2. Work Pay Lines", Types: new[] { "WORK" }, Icon: "schedule"),
        (Title: "3. Reward & Bonus Lines", Types: new[] { "REWARD" }, Icon: "workspace_premium"),
        (Title: "4. Deduction & Penalty Lines", Types: new[] { "PENALTY", "ATTENDANCE_DEDUCTION", "CARRY_FORWARD_DEDUCTION" }, Icon: "remove_circle")
    })
    {
        var lines = Model.CalculationDetails.Where(d => group.Types.Contains(d.Type)).OrderBy(d => d.DisplayOrder).ToList();
        <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden">
            <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between bg-slate-50/60">
                <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-indigo-600 text-lg">@group.Icon</span>
                    <h3 class="text-sm font-bold text-slate-900">@group.Title</h3>
                </div>
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold bg-indigo-50 text-indigo-700 border border-indigo-200">
                    @lines.Count @(lines.Count == 1 ? "Line" : "Lines")
                </span>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse text-xs">
                    <thead>
                        <tr class="border-b border-slate-150 bg-slate-50/50 text-[11px] font-bold text-slate-500 uppercase tracking-wider">
                            <th class="py-3.5 px-6">Description</th>
                            <th class="py-3.5 px-6">Work Dates / Quantity</th>
                            <th class="py-3.5 px-6">Rate / Multiplier</th>
                            <th class="py-3.5 px-6 text-right">Full Amount</th>
                            <th class="py-3.5 px-6 text-right">Applied to Salary</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @foreach (var d in lines)
                        {
                            <tr class="hover:bg-slate-50/80 transition-colors">
                                <td class="py-3.5 px-6">
                                    <div class="font-bold text-slate-900">@d.Description</div>
                                    <div class="text-[11px] text-slate-400 mt-0.5">@d.Type @(!string.IsNullOrEmpty(d.Note) ? $"• {d.Note}" : "")</div>
                                </td>
                                <td class="py-3.5 px-6 text-slate-600">
                                    <div>@(d.WorkFrom?.ToString("dd/MM/yyyy") ?? "—") @(d.WorkTo.HasValue ? $"– {d.WorkTo.Value:dd/MM/yyyy}" : "")</div>
                                    @if (d.Quantity.HasValue)
                                    {
                                        <div class="text-[11px] text-slate-400 font-mono mt-0.5">Qty: @d.Quantity.Value.ToString("0.##")</div>
                                    }
                                </td>
                                <td class="py-3.5 px-6 text-slate-700">
                                    @if (d.Rate.HasValue)
                                    {
                                        <span>@D.Money(d.Rate.Value) × @d.Multiplier.ToString("0.##")x</span>
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </td>
                                <td class="py-3.5 px-6 text-right font-medium text-slate-800">
                                    @D.Money(d.Amount)
                                </td>
                                <td class="py-3.5 px-6 text-right font-bold text-slate-900">
                                    @(d.AppliedAmount.HasValue ? D.Money(d.AppliedAmount.Value) : "—")
                                </td>
                            </tr>
                        }
                        @if (lines.Count == 0)
                        {
                            <tr>
                                <td colspan="5" class="py-6 text-center text-slate-400">
                                    No records in this category.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
