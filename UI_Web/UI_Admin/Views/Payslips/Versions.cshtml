@model UI_Admin.Models.PayrollDocuments.PayslipVersionHistoryResponse
@using D = UI_Admin.Models.Accountant.PayrollPeriods.PeriodDisplay
@{
    ViewData["Title"] = "Payslip Version History";
}

<div class="px-7 py-6 max-w-[1400px] mx-auto space-y-6">
    <!-- Header Title & Action Bar -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-1.5 text-xs text-indigo-600 font-semibold uppercase tracking-wider mb-1">
                <span class="material-symbols-outlined text-sm">history</span>
                <span>Payroll / Payslip Versions</span>
            </div>
            <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Payslip Version History</h1>
            <p class="text-sm text-slate-500 mt-0.5">
                Period #@Model.PayrollPeriodId • Current Payslip #@Model.CurrentPayslipId
            </p>
        </div>
        <div class="flex items-center gap-3">
            <a asp-action="Index"
               class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-white hover:bg-slate-50 text-slate-700 hover:text-slate-900 border border-slate-200 text-sm font-medium transition-all shadow-sm">
                <span class="material-symbols-outlined text-lg">arrow_back</span>
                <span>Back to Payslips</span>
            </a>
        </div>
    </div>

    <!-- Table Card (Manager Style) -->
    <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden">
        <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between bg-slate-50/60">
            <div class="flex items-center gap-2.5">
                <span class="material-symbols-outlined text-indigo-600 text-xl">layers</span>
                <h2 class="text-sm font-bold text-slate-900">Historical Versions</h2>
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold bg-indigo-50 text-indigo-700 border border-indigo-200">
                    @Model.Versions.Count @(Model.Versions.Count == 1 ? "Version" : "Versions")
                </span>
            </div>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="border-b border-slate-150 bg-slate-50/50 text-[11px] font-bold text-slate-500 uppercase tracking-wider">
                        <th class="py-3.5 px-6">Version</th>
                        <th class="py-3.5 px-6">Status</th>
                        <th class="py-3.5 px-6 text-right">Net Salary</th>
                        <th class="py-3.5 px-6">Correction Reason</th>
                        <th class="py-3.5 px-6">Published (UTC+7)</th>
                        <th class="py-3.5 px-6 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 text-sm">
                    @foreach (var p in Model.Versions.OrderByDescending(p => p.VersionNo))
                    {
                        var isCurrent = p.PayslipId == Model.CurrentPayslipId;
                        <tr class="hover:bg-slate-50/80 transition-colors @(isCurrent ? "bg-indigo-50/20" : "")">
                            <td class="py-4 px-6 font-semibold text-slate-900">
                                <span class="inline-flex items-center gap-1.5">
                                    <strong class="font-mono text-indigo-600 font-bold">V@(p.VersionNo)</strong>
                                    @if (isCurrent)
                                    {
                                        <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-indigo-50 text-indigo-700 border border-indigo-200">CURRENT</span>
                                    }
                                </span>
                                <div class="text-xs text-slate-400 mt-0.5">Payslip #@p.PayslipId</div>
                            </td>
                            <td class="py-4 px-6">
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold @(p.Status == "PUBLISHED" ? "bg-emerald-50 text-emerald-700 border border-emerald-200" : "bg-slate-100 text-slate-600 border border-slate-200")">
                                    @p.Status
                                </span>
                            </td>
                            <td class="py-4 px-6 text-right font-bold text-slate-900">
                                @D.Money(p.NetSalary)
                            </td>
                            <td class="py-4 px-6 text-xs text-slate-600 max-w-sm">
                                <p class="line-clamp-2" title="@p.CorrectionReason">@(string.IsNullOrWhiteSpace(p.CorrectionReason) ? "—" : p.CorrectionReason)</p>
                            </td>
                            <td class="py-4 px-6 text-xs text-slate-600">
                                @D.Time(p.PublishedAt)
                            </td>
                            <td class="py-4 px-6 text-right">
                                <a asp-action="Details" asp-route-id="@p.PayslipId"
                                   class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold transition-all">
                                    <span class="material-symbols-outlined text-sm">visibility</span>
                                    <span>Details</span>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
