@if (TempData["WorkflowSuccess"] is string success)
{
    <div id="workflowSuccessBanner" class="p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm flex items-center justify-between gap-3 shadow-sm transition-all duration-300 mb-4" role="status">
        <div class="flex items-center gap-3">
            <span class="material-symbols-outlined text-emerald-600 text-xl shrink-0">check_circle</span>
            <span class="font-medium">@success</span>
        </div>
        <button type="button" aria-label="Close message" onclick="document.getElementById('workflowSuccessBanner')?.remove()" class="text-emerald-600 hover:text-emerald-950 hover:bg-emerald-100/70 p-1.5 rounded-lg transition-colors cursor-pointer shrink-0 inline-flex items-center justify-center">
            <span class="material-symbols-outlined text-lg leading-none block">close</span>
        </button>
    </div>
}

@if (TempData["WorkflowError"] is string error)
{
    <div id="workflowErrorBanner" class="p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-sm flex items-center justify-between gap-3 shadow-sm transition-all duration-300 mb-4" role="alert">
        <div class="flex items-center gap-3">
            <span class="material-symbols-outlined text-rose-600 text-xl shrink-0">error</span>
            <span class="font-medium">@error</span>
        </div>
        <button type="button" aria-label="Close message" onclick="document.getElementById('workflowErrorBanner')?.remove()" class="text-rose-600 hover:text-rose-950 hover:bg-rose-100/70 p-1.5 rounded-lg transition-colors cursor-pointer shrink-0 inline-flex items-center justify-center">
            <span class="material-symbols-outlined text-lg leading-none block">close</span>
        </button>
    </div>
}
