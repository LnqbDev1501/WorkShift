@model string
@{ var current = ViewContext.RouteData.Values["controller"]?.ToString(); var slips = Model + "Payslips"; var feedback = Model + "PayrollFeedback"; }
<a asp-controller="@slips" asp-action="Index" title="Payslips" aria-current="@(current == slips ? "page" : null)" class="sidebar-nav-item flex items-center gap-unit-3 px-unit-3 py-unit-2 rounded-lg @(current == slips ? "bg-primary-container text-white font-title-md shadow-sm" : "text-[#9ca3af] hover:bg-[#1f2937] hover:text-white") transition-all duration-150"><span class="material-symbols-outlined text-[20px] flex-shrink-0">receipt_long</span><span class="sidebar-full-label font-body-md-medium text-[13px] truncate">@(Model == "Staff" ? "My Payslips" : "Published Payslips")</span></a>
@if (Model != "Admin") { <a asp-controller="@feedback" asp-action="Index" title="Payroll Feedback" aria-current="@(current == feedback ? "page" : null)" class="sidebar-nav-item flex items-center gap-unit-3 px-unit-3 py-unit-2 rounded-lg @(current == feedback ? "bg-primary-container text-white font-title-md shadow-sm" : "text-[#9ca3af] hover:bg-[#1f2937] hover:text-white") transition-all duration-150"><span class="material-symbols-outlined text-[20px] flex-shrink-0">feedback</span><span class="sidebar-full-label font-body-md-medium text-[13px] truncate">@(Model == "Staff" ? "My Payroll Feedback" : "Payroll Feedback")</span></a> }
