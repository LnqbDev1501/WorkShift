@model UI_Admin.Models.EmployeeAdjustments.SaveEmployeeAdjustmentViewModel
@using UI_Admin.Models.EmployeeAdjustments
@{
    Layout = "_ManagerLayout";
    var label = EmployeeAdjustmentTypes.Label(Model.AdjustmentType);
    ViewData["Title"] = $"Edit Employee {label}";
}
<div class="flex flex-col w-full gap-unit-4 px-7 py-6 mx-auto" style="max-width: 1496px;">
    <div class="flex flex-wrap justify-between items-center gap-3">
        <div class="form-heading">
            <div class="list-eyebrow">People · Compensation</div>
            <h1 class="text-display-lg font-display-lg text-on-surface">Edit Employee @label</h1>
            <p>Change a pending @label.ToLowerInvariant(). Only pending items in your branch can be edited.</p>
        </div>
    </div>
    <form asp-action="Edit" asp-route-id="@Context.Request.RouteValues["id"]" method="post" class="bg-surface-container-lowest rounded-xl shadow-sm p-unit-5 flex flex-col gap-unit-4">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="text-red-700" role="alert"></div>
        <partial name="~/Views/Shared/EmployeeAdjustments/_FormFields.cshtml" model="Model" />
        <div class="flex justify-end gap-3">
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            <button type="submit" disabled="@(!Model.OptionsLoaded || Model.StaffOptions.Count == 0 || Model.AvailableDates.Count == 0)" class="btn btn-primary">Save changes</button>
        </div>
    </form>
</div>
