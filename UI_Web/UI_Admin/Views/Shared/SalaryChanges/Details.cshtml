@model UI_Admin.Models.SalaryChanges.SalaryChangeDetailsViewModel
@using D = UI_Admin.Models.SalaryChanges.SalaryChangeDisplay
@{
    var row = Model.Item;
    var admin = User.IsInRole("ADMIN");
    Layout = admin ? "_AdminLayout" : "_ManagerLayout";
    ViewData["Title"] = $"Salary Increase Request #{row.SalaryChangeRequestId}";
}
<div class="flex flex-col w-full gap-unit-4 px-7 py-6 mx-auto" style="max-width: 1496px;">
    <div class="flex items-center justify-between gap-3">
        <a asp-action="Index" class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-white hover:bg-slate-50 text-slate-700 font-semibold text-sm transition-all border border-slate-200 shadow-sm">
            <span class="material-symbols-outlined text-[18px]">arrow_back</span>
            <span>Back to requests</span>
        </a>
        <span class="rounded-full px-3 py-1 text-xs font-semibold @D.Badge(row.Status)">@row.Status</span>
    </div>
    <div class="flex flex-wrap justify-between items-center gap-3"><div class="form-heading"><div class="list-eyebrow">People · Compensation</div><h1 class="text-display-lg font-display-lg text-on-surface">@row.EmployeeName</h1><p>Request #@row.SalaryChangeRequestId · @row.BranchName</p></div></div>
    <partial name="~/Views/Shared/SalaryChanges/_Messages.cshtml" />
    <div asp-validation-summary="All" class="text-red-700" role="alert"></div>
    <partial name="_ListMetrics" model='@(new ListMetricViewModel[] {
        new("Previous rate", D.Money(row.CurrentHourlyRate), "Per hour · source history #" + row.CurrentSalaryHistoryId, "history", "#8b5cf6"),
        new("Proposed rate", D.Money(row.ProposedHourlyRate), "Per hour", "trending_up", "#10b981"),
        new("Proposed date", D.Date(row.ProposedEffectiveFrom), "Requested by Manager", "calendar_month", "#0891b2"),
        new("Approved date", D.Date(row.ApprovedEffectiveFrom), row.NewSalaryStatus ?? "Awaiting decision", "event_available", "#10b981")
    })' />
    <section class="bg-surface-container-lowest rounded-xl shadow-sm p-unit-5 flex flex-col gap-unit-4">
        <h2 class="text-title-lg font-semibold">Request information</h2>
        <dl class="grid grid-cols-1 md:grid-cols-3 gap-unit-4 text-body-md">
            <div><dt class="text-secondary">Employee</dt><dd>@row.EmployeeName<div class="text-xs break-all text-secondary">@row.UserId</div></dd></div>
            <div><dt class="text-secondary">Source contract</dt><dd>@row.ContractNumber · #@row.ContractId</dd></div>
            <div><dt class="text-secondary">Created (UTC+7)</dt><dd>@D.Time(row.CreatedAt)</dd></div>
            <div><dt class="text-secondary">Requested by</dt><dd class="break-all">@row.RequestedBy</dd></div>
            <div><dt class="text-secondary">Employee request</dt><dd>@if (row.EmployeeRequestId.HasValue && !admin) { <a asp-controller="ManagerEmployeeRequests" asp-action="Details" asp-route-id="@row.EmployeeRequestId" class="text-primary hover:underline">#@row.EmployeeRequestId</a> } else { @(row.EmployeeRequestId?.ToString() ?? "—") }</dd></div>
            <div><dt class="text-secondary">Previous proposal</dt><dd>@if (row.PreviousRequestId.HasValue) { <a asp-action="Details" asp-route-id="@row.PreviousRequestId" class="text-primary hover:underline">#@row.PreviousRequestId</a> } else { <span>—</span> }</dd></div>
        </dl>
        <div><h3 class="text-label-md text-secondary mb-1">Reason</h3><p class="whitespace-pre-wrap break-words">@row.Reason</p></div>
    </section>
    @if (row.Status == "APPROVED" || row.Status == "REJECTED")
    {
        <section class="bg-surface-container-lowest rounded-xl shadow-sm p-unit-5 flex flex-col gap-unit-3"><h2 class="text-title-lg font-semibold">Admin decision</h2><p>Reviewed: @D.Time(row.ReviewedAt) (UTC+7)</p><p class="text-sm break-all text-secondary">Reviewed by: @row.ReviewedBy</p><p class="whitespace-pre-wrap break-words">@(row.ReviewNote ?? "No review note.")</p>
            @if (row.EffectiveDateChangeReason != null) { <p>Reason for changing the effective date:</p><p class="whitespace-pre-wrap break-words">@row.EffectiveDateChangeReason</p> }
            @if (row.NewSalaryHistoryId.HasValue) { <p>New salary record #@row.NewSalaryHistoryId · @row.NewSalaryStatus · effective @D.Date(row.ApprovedEffectiveFrom).</p><p class="text-secondary text-sm">The previous rate remains in salary history for earlier work dates. A scheduled rate becomes active when its effective date arrives.</p> }
        </section>
    }
    @if (row.Status == "CANCELLED")
    { <section class="bg-surface-container-lowest rounded-xl shadow-sm p-unit-5"><h2 class="text-title-lg font-semibold mb-3">Cancellation</h2><p>@D.Time(row.CancelledAt) (UTC+7)</p><p class="text-sm break-all text-secondary">Cancelled by: @row.CancelledBy</p><p class="whitespace-pre-wrap break-words mt-3">@row.CancellationReason</p></section> }
    @if (admin && row.Status == "PENDING")
    {
        <section class="bg-surface-container-lowest rounded-xl shadow-sm p-unit-5 flex flex-col gap-unit-4">
            <h2 class="text-title-lg font-semibold">Review request</h2>
            @if (row.ApprovalBlockedReason != null) { <div role="alert" class="rounded-xl bg-amber-50 text-amber-800 p-unit-3">@row.ApprovalBlockedReason</div> }
            @if (row.CanApprove)
            {
                <form asp-action="Approve" asp-route-id="@row.SalaryChangeRequestId" method="post" class="flex flex-col gap-unit-3" data-salary-form>
                    @Html.AntiForgeryToken()
                    @if (row.RequiresEffectiveDateChange)
                    {
                        <p class="text-amber-800">The proposed date has arrived or passed. Select a new Monday from @D.Date(row.EarliestAllowedEffectiveFrom) onward.</p>
                        <div><label asp-for="Decision.ApprovedEffectiveFrom" class="block text-label-md text-secondary mb-2">New effective date *</label><input asp-for="Decision.ApprovedEffectiveFrom" type="date" min="@row.EarliestAllowedEffectiveFrom.ToString("yyyy-MM-dd")" required data-monday class="h-[44px] px-3 border border-surface-container-high rounded-xl" /><span asp-validation-for="Decision.ApprovedEffectiveFrom" class="text-red-700"></span></div>
                        <div><label asp-for="Decision.EffectiveDateChangeReason" class="block text-label-md text-secondary mb-2">Reason for date change *</label><textarea asp-for="Decision.EffectiveDateChangeReason" maxlength="1000" rows="3" required class="w-full p-3 border border-surface-container-high rounded-xl"></textarea><span asp-validation-for="Decision.EffectiveDateChangeReason" class="text-red-700"></span></div>
                    }
                    else { <p>The proposed effective date @D.Date(row.ProposedEffectiveFrom) will be kept.</p> }
                    <div><label for="ApprovalNote" class="block text-label-md text-secondary mb-2">Approval note (optional)</label><textarea id="ApprovalNote" name="Decision.ReviewNote" rows="3" maxlength="1000" class="w-full p-3 border border-surface-container-high rounded-xl">@Model.Decision.ReviewNote</textarea></div>
                    <div><button type="submit" class="btn btn-primary">Approve salary increase</button></div>
                </form>
            }
            @if (row.CanReject)
            {
                <form asp-action="Reject" asp-route-id="@row.SalaryChangeRequestId" method="post" class="border-t border-surface-container-low pt-4 flex flex-col gap-unit-3" data-salary-form>
                    @Html.AntiForgeryToken()
                    <div><label for="RejectionNote" class="block text-label-md text-secondary mb-2">Rejection reason *</label><textarea id="RejectionNote" name="Decision.ReviewNote" rows="3" required maxlength="1000" class="w-full p-3 border border-surface-container-high rounded-xl">@Model.Decision.ReviewNote</textarea></div>
                    <div><button type="submit" class="btn btn-secondary text-red-700">Reject request</button></div>
                </form>
            }
        </section>
    }
    @if (!admin && row.CanCancel)
    {
        <form asp-action="Cancel" asp-route-id="@row.SalaryChangeRequestId" method="post" class="bg-surface-container-lowest rounded-xl shadow-sm p-unit-5 flex flex-col gap-unit-3" data-salary-form>
            @Html.AntiForgeryToken()
            <h2 class="text-title-lg font-semibold">Cancel pending request</h2><p class="text-secondary">Only the Manager who created this request can cancel it before Admin makes a decision.</p>
            <div><label asp-for="Decision.Reason" class="block text-label-md text-secondary mb-2">Cancellation reason *</label><textarea asp-for="Decision.Reason" rows="3" required maxlength="1000" class="w-full p-3 border border-surface-container-high rounded-xl"></textarea><span asp-validation-for="Decision.Reason" class="text-red-700"></span></div><div><button type="submit" class="btn btn-secondary text-red-700">Cancel request</button></div>
        </form>
    }
    @if (!admin && row.Status is "REJECTED" or "CANCELLED") { <div><a asp-action="Create" asp-route-previousRequestId="@row.SalaryChangeRequestId" class="btn btn-primary">Create new proposal</a></div> }
</div>
@section Scripts { <script src="~/js/salary-changes.js" asp-append-version="true"></script> }
