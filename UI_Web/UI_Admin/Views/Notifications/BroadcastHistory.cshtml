@model UI_Admin.Models.NotificationListPageViewModel
@{
    ViewData["Title"] = "Broadcast History";
}

<div class="px-7 py-4 mx-auto space-y-4">
    <!-- Header Banner -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-white p-6 rounded-2xl border border-gray-100 shadow-sm">
        <div>
            <div class="flex items-center gap-2 mb-1.5">
                <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-blue-50 text-blue-700 border border-blue-100">
                    <span class="w-1.5 h-1.5 rounded-full bg-blue-600 animate-pulse"></span>
                    BROADCAST HUB
                </span>
                <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-gray-50 text-gray-600 border border-gray-200">
                    Admin Announcements
                </span>
            </div>
            <h1 class="text-2xl font-bold text-gray-900 tracking-tight">Broadcast History</h1>
            <p class="text-sm text-gray-500 mt-0.5">Review organization-wide broadcasts, announcements, and dispatched messages.</p>
        </div>
        <div class="flex flex-wrap items-center gap-2.5">
            <a asp-action="BroadcastHistory" class="inline-flex items-center gap-1.5 px-4 py-2 text-xs font-semibold text-gray-700 bg-gray-50 hover:bg-gray-100 border border-gray-200 rounded-xl transition-colors">
                <span class="material-symbols-outlined text-[16px]">refresh</span>
                Refresh
            </a>
            <a asp-action="Send" class="inline-flex items-center gap-1.5 px-4 py-2 text-xs font-semibold text-white bg-primary-container hover:bg-primary rounded-xl transition-colors shadow-sm">
                <span class="material-symbols-outlined text-[16px]">send</span>
                Send Broadcast
            </a>
        </div>
    </div>

    @if (TempData["NotificationSuccess"] is string successMessage)
    {
        <div class="p-4 rounded-xl bg-green-50 border border-green-200 text-sm font-medium text-green-700 flex items-center gap-2">
            <span class="material-symbols-outlined text-[18px]">check_circle</span>
            <span>@successMessage</span>
        </div>
    }

    <!-- KPI Summary Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-white p-5 rounded-2xl border border-gray-100 shadow-sm flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center flex-shrink-0">
                <span class="material-symbols-outlined text-[24px]">campaign</span>
            </div>
            <div>
                <p class="text-xs font-medium text-gray-500">Total Broadcasts</p>
                <div class="flex items-baseline gap-2 mt-0.5">
                    <span class="text-2xl font-bold text-gray-900">@Model.TotalCount</span>
                    <span class="text-xs text-gray-400">sent</span>
                </div>
            </div>
        </div>

        <div class="bg-white p-5 rounded-2xl border border-gray-100 shadow-sm flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center flex-shrink-0">
                <span class="material-symbols-outlined text-[24px]">view_list</span>
            </div>
            <div>
                <p class="text-xs font-medium text-gray-500">Shown</p>
                <div class="flex items-baseline gap-2 mt-0.5">
                    <span class="text-2xl font-bold text-gray-900">@Model.Items.Count</span>
                    <span class="text-xs text-gray-400">on page</span>
                </div>
            </div>
        </div>

        <div class="bg-white p-5 rounded-2xl border border-gray-100 shadow-sm flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-cyan-50 text-cyan-600 flex items-center justify-center flex-shrink-0">
                <span class="material-symbols-outlined text-[24px]">devices</span>
            </div>
            <div>
                <p class="text-xs font-medium text-gray-500">In-App Channels</p>
                <div class="flex items-baseline gap-2 mt-0.5">
                    <span class="text-2xl font-bold text-cyan-700">@Model.Items.Count(x => x.Channels != null && x.Channels.Contains("InApp"))</span>
                    <span class="text-xs text-gray-400">on page</span>
                </div>
            </div>
        </div>

        <div class="bg-white p-5 rounded-2xl border border-gray-100 shadow-sm flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center flex-shrink-0">
                <span class="material-symbols-outlined text-[24px]">mark_email_read</span>
            </div>
            <div>
                <p class="text-xs font-medium text-gray-500">Email Channels</p>
                <div class="flex items-baseline gap-2 mt-0.5">
                    <span class="text-2xl font-bold text-emerald-700">@Model.Items.Count(x => x.Channels != null && x.Channels.Contains("Email"))</span>
                    <span class="text-xs text-gray-400">on page</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter & Search Bar -->
    <form method="get" asp-action="BroadcastHistory" class="ws-list-filter" role="search">
        <input type="hidden" name="SortBy" value="CreatedAt" />
        <div class="ws-filter-row">
            <label class="ws-filter-field ws-filter-keyword">
                <span class="material-symbols-outlined" aria-hidden="true">search</span>
                <input aria-label="Search" type="text" name="Search" value="@Model.Search" placeholder="Search broadcast title or message..." />
            </label>
            <div class="ws-filter-field">
                <select aria-label="Sort order" name="SortOrder">
                    <option value="desc" selected="@(Model.SortOrder == "desc")">Newest first</option>
                    <option value="asc" selected="@(Model.SortOrder == "asc")">Oldest first</option>
                </select>
            </div>
            <details class="ws-filter-advanced">
                <summary title="Advanced filters" aria-label="Advanced filters">
                    <span class="material-symbols-outlined" aria-hidden="true">tune</span>
                    @if (Context.Request.Query.Any(q => new[] { "DateFrom", "DateTo" }.Contains(q.Key, StringComparer.OrdinalIgnoreCase) && !string.IsNullOrWhiteSpace(q.Value.ToString())))
                    {
                        <span class="ws-filter-indicator" aria-label="Advanced filters active"></span>
                    }
                </summary>
                <div class="ws-filter-panel">
                    <label class="ws-filter-field">
                        <span>Created from</span>
                        <input aria-label="Created from" name="DateFrom" value="@(Model.DateFrom?.ToString("yyyy-MM-dd"))" type="date" />
                    </label>
                    <label class="ws-filter-field">
                        <span>Created to</span>
                        <input aria-label="Created to" name="DateTo" value="@(Model.DateTo?.ToString("yyyy-MM-dd"))" type="date" />
                    </label>
                    <button type="submit" class="ws-filter-apply">Apply filters</button>
                </div>
            </details>
            <partial name="_ListFilterActions" model='"BroadcastHistory"' />
        </div>
    </form>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="p-4 rounded-xl bg-red-50 border border-red-200 text-sm text-red-700">@Model.ErrorMessage</div>
    }

    <!-- Notification Cards List -->
    @if (Model.Items.Count == 0)
    {
        <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-12 text-center">
            <div class="w-16 h-16 rounded-full bg-blue-50 text-blue-500 mx-auto flex items-center justify-center mb-3">
                <span class="material-symbols-outlined text-[32px]">campaign</span>
            </div>
            <h3 class="text-base font-bold text-gray-900">No broadcasts found</h3>
            <p class="text-xs text-gray-500 mt-1 max-w-sm mx-auto">No broadcast notifications match your active search or filters.</p>
        </div>
    }
    else
    {
        <div class="space-y-3">
            @foreach (var item in Model.Items)
            {
                <div class="group bg-white rounded-2xl border border-gray-100 shadow-sm hover:border-gray-200 hover:shadow-md transition-all p-4 sm:p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                    <div class="flex items-start gap-4 min-w-0">
                        <div class="w-11 h-11 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center flex-shrink-0 group-hover:scale-105 transition-transform">
                            <span class="material-symbols-outlined text-[22px]">campaign</span>
                        </div>

                        <div class="min-w-0 flex-1">
                            <div class="flex flex-wrap items-center gap-2 mb-1">
                                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-gray-100 text-gray-600 uppercase tracking-wider">
                                    @(string.IsNullOrWhiteSpace(item.NotificationType) ? "BROADCAST" : item.NotificationType)
                                </span>
                                <span class="inline-flex items-center gap-1 text-[11px] text-gray-400">
                                    <span class="material-symbols-outlined text-[13px]">schedule</span>
                                    @item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                </span>
                            </div>

                            <h3 class="text-[15px] font-bold text-gray-900 group-hover:text-blue-600 transition-colors truncate" title="@item.Title">
                                @(item.Title != null && item.Title.Length > 50 ? item.Title.Substring(0, 50) + "..." : item.Title)
                            </h3>

                            <div class="flex flex-wrap items-center gap-3 mt-1.5 text-xs text-gray-500">
                                @if (item.Channels != null && item.Channels.Count > 0)
                                {
                                    <span class="inline-flex items-center gap-1">
                                        <span class="material-symbols-outlined text-[14px] text-gray-400">cell_tower</span>
                                        @string.Join(", ", item.Channels.Select(c => c == "InApp" ? "In-App" : c))
                                    </span>
                                }
                                @if (!string.IsNullOrWhiteSpace(item.Audience))
                                {
                                    <span>• Audience: @item.Audience</span>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="flex items-center gap-2.5 self-end sm:self-center flex-shrink-0">
                        <a asp-action="Detail" asp-route-id="@item.NotificationId" class="inline-flex items-center gap-1.5 px-3.5 py-1.5 text-xs font-semibold text-blue-600 bg-blue-50 hover:bg-blue-100 border border-blue-100 rounded-xl transition-colors">
                            <span>Details</span>
                            <span class="material-symbols-outlined text-[14px]">arrow_forward</span>
                        </a>
                    </div>
                </div>
            }
        </div>

        <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-4">
            <partial name="_ListPagination" model="@(new ListPaginationViewModel
            {
                PageNumber = Model.Page,
                PageSize = Model.PageSize,
                TotalItems = Model.TotalCount,
                ItemLabel = "broadcasts"
            })" />
        </div>
    }
</div>
