@{
    Layout = "_StaffLayout";
    ViewData["Title"] = "Staff Workspace";
}

<div class="p-6 max-w-[1440px] mx-auto space-y-6">
    <!-- Header Banner -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-white p-6 rounded-2xl border border-gray-100 shadow-sm">
        <div>
            <div class="flex items-center gap-2 mb-1.5">
                <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-100">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-600 animate-pulse"></span>
                    STAFF WORKSPACE
                </span>
            </div>
            <h1 class="text-2xl font-bold text-gray-900 tracking-tight">Welcome, @User.Identity?.Name</h1>
            <p class="text-sm text-gray-500 mt-0.5">Your personal workspace for managing shifts, contracts, and requests.</p>
        </div>
        <div class="flex items-center gap-2.5 flex-wrap">
            <a asp-controller="StaffShifts" asp-action="Index" class="inline-flex items-center gap-1.5 px-4 py-2 text-xs font-semibold text-white bg-emerald-600 hover:bg-emerald-700 rounded-xl shadow-sm transition-colors">
                <span class="material-symbols-outlined text-[16px]">event_available</span>
                Shift registration
            </a>
            <a asp-controller="StaffEmployeeRequests" asp-action="Index" class="inline-flex items-center gap-1.5 px-4 py-2 text-xs font-semibold text-white bg-indigo-600 hover:bg-indigo-700 rounded-xl shadow-sm transition-colors">
                <span class="material-symbols-outlined text-[16px]">pending_actions</span>
                My Requests
            </a>
            <a asp-controller="StaffContracts" asp-action="Index" class="inline-flex items-center gap-1.5 px-4 py-2 text-xs font-semibold text-white bg-blue-600 hover:bg-blue-700 rounded-xl shadow-sm transition-colors">
                <span class="material-symbols-outlined text-[16px]">description</span>
                View My Contracts
            </a>
            <a asp-controller="StaffOrders" asp-action="Create" class="inline-flex items-center gap-1.5 px-4 py-2 text-xs font-semibold text-white bg-orange-600 hover:bg-orange-700 rounded-xl shadow-sm transition-colors">
                <span class="material-symbols-outlined text-[16px]">add_shopping_cart</span>
                Create Order
            </a>
        </div>
    </div>

    <!-- Shift Eligibility Guidance -->
    <div class="bg-gradient-to-r from-blue-50 to-indigo-50 border border-blue-200 rounded-2xl p-5 flex items-start gap-3.5 text-blue-900 shadow-sm">
        <span class="material-symbols-outlined text-blue-600 text-[26px] flex-shrink-0 mt-0.5">info</span>
        <div class="space-y-1">
            <h2 class="text-sm font-bold text-blue-950">Shift Assignment &amp; Contract Policy</h2>
            <p class="text-xs text-blue-800 leading-relaxed">
                To be scheduled and take shifts at your branch, your employment contract must be in <strong>ACTIVE</strong> (or <strong>SCHEDULED</strong> and accepted by you) status. If your contract is pending acceptance, please review and confirm it promptly so your shift schedule is not interrupted.
            </p>
        </div>
    </div>

    <!-- Quick Operations Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
        <!-- Create Order Card -->
        <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm hover:border-orange-200 transition-all flex flex-col justify-between">
            <div>
                <div class="flex items-center gap-3 mb-3">
                    <span class="w-10 h-10 rounded-xl bg-orange-50 text-orange-600 flex items-center justify-center">
                        <span class="material-symbols-outlined text-[22px]">add_shopping_cart</span>
                    </span>
                    <div>
                        <h3 class="text-base font-bold text-gray-900">Create Order</h3>
                        <span class="text-xs text-gray-400">New Customer Order</span>
                    </div>
                </div>
                <p class="text-xs text-gray-600 leading-relaxed mb-4">
                    Create a new customer order with product selection, pricing, and payment tracking.
                </p>
            </div>
            <div class="pt-3 border-t border-gray-50">
                <a asp-controller="StaffOrders" asp-action="Create" class="inline-flex items-center gap-1.5 px-3.5 py-2 text-xs font-semibold text-white bg-orange-600 hover:bg-orange-700 rounded-lg transition-colors">
                    <span>Create Order</span> &rarr;
                </a>
            </div>
        </div>

        <!-- My Orders Card -->
        <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm hover:border-indigo-200 transition-all flex flex-col justify-between">
            <div>
                <div class="flex items-center gap-3 mb-3">
                    <span class="w-10 h-10 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center">
                        <span class="material-symbols-outlined text-[22px]">receipt_long</span>
                    </span>
                    <div>
                        <h3 class="text-base font-bold text-gray-900">My Orders</h3>
                        <span class="text-xs text-gray-400">View & Manage Orders</span>
                    </div>
                </div>
                <p class="text-xs text-gray-600 leading-relaxed mb-4">
                    View your created orders, check status, and manage completion or cancellation.
                </p>
            </div>
            <div class="pt-3 border-t border-gray-50 flex items-center gap-2">
                <a asp-controller="StaffOrders" asp-action="Index" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-indigo-700 bg-indigo-50 hover:bg-indigo-100 rounded-lg transition-colors">
                    <span>View Orders</span> &rarr;
                </a>
            </div>
        </div>

        <!-- Complete Order Card -->
        <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm hover:border-emerald-200 transition-all flex flex-col justify-between">
            <div>
                <div class="flex items-center gap-3 mb-3">
                    <span class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center">
                        <span class="material-symbols-outlined text-[22px]">check_circle</span>
                    </span>
                    <div>
                        <h3 class="text-base font-bold text-gray-900">Complete Order</h3>
                        <span class="text-xs text-gray-400">Mark Order Complete</span>
                    </div>
                </div>
                <p class="text-xs text-gray-600 leading-relaxed mb-4">
                    Mark orders as completed after customer receives products and payment is confirmed.
                </p>
            </div>
            <div class="pt-3 border-t border-gray-50">
                <a asp-controller="StaffOrders" asp-action="Index" class="inline-flex items-center gap-1.5 px-3.5 py-2 text-xs font-semibold text-emerald-700 bg-emerald-50 hover:bg-emerald-100 rounded-lg transition-colors">
                    <span>Complete Order</span> &rarr;
                </a>
            </div>
        </div>

        <!-- Cancel Order Card -->
        <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm hover:border-red-200 transition-all flex flex-col justify-between">
            <div>
                <div class="flex items-center gap-3 mb-3">
                    <span class="w-10 h-10 rounded-xl bg-red-50 text-red-600 flex items-center justify-center">
                        <span class="material-symbols-outlined text-[22px]">cancel</span>
                    </span>
                    <div>
                        <h3 class="text-base font-bold text-gray-900">Cancel Order</h3>
                        <span class="text-xs text-gray-400">Cancel Pending Order</span>
                    </div>
                </div>
                <p class="text-xs text-gray-600 leading-relaxed mb-4">
                    Cancel orders that are no longer needed (only if not yet paid/completed).
                </p>
            </div>
            <div class="pt-3 border-t border-gray-50">
                <a asp-controller="StaffOrders" asp-action="Index" class="inline-flex items-center gap-1.5 px-3.5 py-2 text-xs font-semibold text-red-700 bg-red-50 hover:bg-red-100 rounded-lg transition-colors">
                    <span>Cancel Order</span> &rarr;
                </a>
            </div>
        </div>

        <!-- Requests Card -->
        <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm hover:border-indigo-200 transition-all flex flex-col justify-between">
            <div>
                <div class="flex items-center gap-3 mb-3">
                    <span class="w-10 h-10 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center">
                        <span class="material-symbols-outlined text-[22px]">pending_actions</span>
                    </span>
                    <div>
                        <h3 class="text-base font-bold text-gray-900">My Requests</h3>
                        <span class="text-xs text-gray-400">Leave, Late &amp; Early Departure</span>
                    </div>
                </div>
                <p class="text-xs text-gray-600 leading-relaxed mb-4">
                    Submit leave, late arrival, or early leave applications for scheduled shifts and track review results from branch management.
                </p>
            </div>
            <div class="pt-3 border-t border-gray-50 flex items-center gap-2">
                <a asp-controller="StaffEmployeeRequests" asp-action="Index" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-indigo-700 bg-indigo-50 hover:bg-indigo-100 rounded-lg transition-colors">
                    <span>View List</span> &rarr;
                </a>
                <a asp-controller="StaffEmployeeRequests" asp-action="Create" class="inline-flex items-center gap-1 px-3 py-1.5 text-xs font-semibold text-white bg-indigo-600 hover:bg-indigo-700 rounded-lg transition-colors ml-auto">
                    <span>Create New</span> +
                </a>
            </div>
        </div>

        <!-- Contracts Card -->
        <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm hover:border-blue-200 transition-all flex flex-col justify-between">
            <div>
                <div class="flex items-center gap-3 mb-3">
                    <span class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center">
                        <span class="material-symbols-outlined text-[22px]">description</span>
                    </span>
                    <div>
                        <h3 class="text-base font-bold text-gray-900">Employment Contracts</h3>
                        <span class="text-xs text-gray-400">My Employment Contracts</span>
                    </div>
                </div>
                <p class="text-xs text-gray-600 leading-relaxed mb-4">
                    Access your employment contracts, review hourly wage details, effective dates, download PDFs, and confirm contract acceptance.
                </p>
            </div>
            <div class="pt-3 border-t border-gray-50">
                <a asp-controller="StaffContracts" asp-action="Index" class="inline-flex items-center gap-1.5 px-3.5 py-2 text-xs font-semibold text-blue-700 bg-blue-50 hover:bg-blue-100 rounded-lg transition-colors">
                    <span>View Contracts</span> &rarr;
                </a>
            </div>
        </div>

        <!-- Notifications Card -->
        <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm hover:border-purple-200 transition-all flex flex-col justify-between">
            <div>
                <div class="flex items-center gap-3 mb-3">
                    <span class="w-10 h-10 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center">
                        <span class="material-symbols-outlined text-[22px]">notifications</span>
                    </span>
                    <div>
                        <h3 class="text-base font-bold text-gray-900">Notifications</h3>
                        <span class="text-xs text-gray-400">Personal Inbox</span>
                    </div>
                </div>
                <p class="text-xs text-gray-600 leading-relaxed mb-4">
                    Receive notifications from branch management regarding contract updates, request approvals, and shift scheduling.
                </p>
            </div>
            <div class="pt-3 border-t border-gray-50">
                <a asp-controller="Notifications" asp-action="Personal" class="inline-flex items-center gap-1.5 px-3.5 py-2 text-xs font-semibold text-purple-700 bg-purple-50 hover:bg-purple-100 rounded-lg transition-colors">
                    <span>View Notifications</span> &rarr;
                </a>
            </div>
        </div>

        <!-- Profile Card -->
        <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm hover:border-emerald-200 transition-all flex flex-col justify-between">
            <div>
                <div class="flex items-center gap-3 mb-3">
                    <span class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center">
                        <span class="material-symbols-outlined text-[22px]">person</span>
                    </span>
                    <div>
                        <h3 class="text-base font-bold text-gray-900">Account &amp; Profile</h3>
                        <span class="text-xs text-gray-400">Account Profile</span>
                    </div>
                </div>
                <p class="text-xs text-gray-600 leading-relaxed mb-4">
                    Review logged-in account details, update your password, and manage personal security settings.
                </p>
            </div>
            <div class="pt-3 border-t border-gray-50">
                <a asp-controller="Auth" asp-action="Profile" class="inline-flex items-center gap-1.5 px-3.5 py-2 text-xs font-semibold text-emerald-700 bg-emerald-50 hover:bg-emerald-100 rounded-lg transition-colors">
                    <span>View Profile</span> &rarr;
                </a>
            </div>
        </div>
    </div>
</div>
