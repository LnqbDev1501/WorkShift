@model UI_Admin.Models.PayrollDocuments.PayrollReview
@using D = UI_Admin.Models.Accountant.PayrollPeriods.PeriodDisplay
@using W = UI_Admin.Models.PayrollDocuments.PayrollDocumentDisplay
@{
    var p = Model.Payroll;
    var accountant = User.IsInRole("ACCOUNTANT");
    var hasMultipleVersions = Model.History.Versions.Count > 1;
    var previous = Model.History.Versions.FirstOrDefault(v => v.PayrollId == p.PreviousPayrollId);
    var activeIssue = Model.ActiveIssue;
    ViewData["Title"] = $"Payroll Review — {p.EmployeeName}";

    string? successMsg = (TempData["SuccessMessage"] ?? TempData["WorkflowSuccess"]) as string;
    string? errorMsg = (TempData["ErrorMessage"] ?? TempData["WorkflowError"]) as string;
}

<div class="px-7 py-6 max-w-[1440px] mx-auto space-y-6">
    <!-- Header Title & Action Bar -->
    <div class="flex flex-col md:flex-row md:items-start justify-between gap-4">
        <div>
            <div class="flex items-center gap-1.5 text-xs text-indigo-600 font-semibold uppercase tracking-wider mb-1">
                <span class="material-symbols-outlined text-sm">rate_review</span>
                <span>Payroll / Revision &amp; Correction</span>
            </div>
            <div class="flex items-center gap-3 flex-wrap">
                <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Review &amp; Correction — @p.EmployeeName</h1>
                @if (p.Status == "CALCULATED")
                {
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-sky-50 text-sky-700 border border-sky-200">
                        CALCULATED
                    </span>
                }
                else if (p.Status == "REJECTED")
                {
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-rose-50 text-rose-700 border border-rose-200">
                        REJECTED
                    </span>
                }
                else if (p.Status == "APPROVED")
                {
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                        APPROVED
                    </span>
                }
                else
                {
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-slate-100 text-slate-700 border border-slate-200">
                        @p.Status
                    </span>
                }
            </div>
            <p class="text-sm text-slate-500 mt-1 flex flex-wrap items-center gap-2">
                <span>Payroll #@p.PayrollId</span>
                <span>•</span>
                <span>Version V@(p.VersionNo)</span>
                <span>•</span>
                <span>Period Status: <strong class="text-slate-800 font-semibold">@Model.PeriodStatus</strong></span>
            </p>
        </div>

        <div class="flex items-center gap-2.5 shrink-0 flex-wrap">
            <a asp-controller="@(accountant ? "AccountantPayrollPeriods" : "Payroll")" asp-action="Details" asp-route-id="@p.PayrollPeriodId"
               class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-white hover:bg-slate-50 text-slate-700 border border-slate-200 text-sm font-medium transition-all shadow-sm">
                <span class="material-symbols-outlined text-base">arrow_back</span>
                <span>Back to Period</span>
            </a>
            @if (accountant)
            {
                <a asp-controller="AccountantPayrollCalculation" asp-action="Details" asp-route-id="@p.PayrollId"
                   class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-white hover:bg-slate-50 text-slate-700 border border-slate-200 text-sm font-medium transition-all shadow-sm">
                    <span class="material-symbols-outlined text-base">analytics</span>
                    <span>Calculation Details</span>
                </a>
            }
        </div>
    </div>

    <!-- Alert Notifications -->
    @if (!string.IsNullOrEmpty(successMsg))
    {
        <div id="alertSuccessBanner" class="p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm flex items-center justify-between gap-3 shadow-sm transition-all duration-300">
            <div class="flex items-center gap-3">
                <span class="material-symbols-outlined text-emerald-600 text-xl shrink-0">check_circle</span>
                <span class="font-medium">@successMsg</span>
            </div>
            <button type="button" aria-label="Close message" onclick="document.getElementById('alertSuccessBanner')?.remove()" class="text-emerald-600 hover:text-emerald-950 hover:bg-emerald-100/70 p-1.5 rounded-lg transition-colors cursor-pointer shrink-0 inline-flex items-center justify-center">
                <span class="material-symbols-outlined text-lg leading-none block">close</span>
            </button>
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMsg))
    {
        <div id="alertErrorBanner" class="p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-sm flex items-center justify-between gap-3 shadow-sm transition-all duration-300">
            <div class="flex items-center gap-3">
                <span class="material-symbols-outlined text-rose-600 text-xl shrink-0">error</span>
                <span class="font-medium">@errorMsg</span>
            </div>
            <button type="button" aria-label="Close message" onclick="document.getElementById('alertErrorBanner')?.remove()" class="text-rose-600 hover:text-rose-950 hover:bg-rose-100/70 p-1.5 rounded-lg transition-colors cursor-pointer shrink-0 inline-flex items-center justify-center">
                <span class="material-symbols-outlined text-lg leading-none block">close</span>
            </button>
        </div>
    }

    @if (!string.IsNullOrEmpty(p.RejectReason))
    {
        <div class="p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-900 text-sm flex items-start gap-3 shadow-sm">
            <span class="material-symbols-outlined text-rose-600 text-xl shrink-0 mt-0.5">report_problem</span>
            <div>
                <strong class="font-bold">Rejection / Revision Reason from Admin:</strong>
                <p class="mt-0.5 text-rose-800 font-medium">@p.RejectReason</p>
            </div>
        </div>
    }

    <!-- Stat Metric Cards (4-Grid) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- Work Pay -->
        <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm flex flex-col justify-between">
            <div class="flex items-center justify-between text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">
                <span>Work Pay</span>
                <span class="material-symbols-outlined text-indigo-600 text-lg">schedule</span>
            </div>
            <div>
                <div class="text-2xl font-bold text-slate-900 tracking-tight">@D.Money(p.WorkPay)</div>
                <div class="text-xs text-slate-400 mt-1">@p.TotalWorkHours.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) Hours</div>
            </div>
        </div>

        <!-- Rewards -->
        <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm flex flex-col justify-between">
            <div class="flex items-center justify-between text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">
                <span>Total Rewards</span>
                <span class="material-symbols-outlined text-emerald-600 text-lg">workspace_premium</span>
            </div>
            <div>
                <div class="text-2xl font-bold text-emerald-700 tracking-tight">@D.Money(p.TotalReward)</div>
                <div class="text-xs text-slate-400 mt-1">Included rewards</div>
            </div>
        </div>

        <!-- Deductions -->
        <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm flex flex-col justify-between">
            <div class="flex items-center justify-between text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">
                <span>Applied Deductions</span>
                <span class="material-symbols-outlined text-rose-600 text-lg">remove_circle</span>
            </div>
            <div>
                <div class="text-2xl font-bold text-rose-700 tracking-tight">@D.Money(p.TotalDeduction)</div>
                <div class="text-xs text-slate-400 mt-1">Amount applied in period</div>
            </div>
        </div>

        <!-- Net Salary -->
        <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm flex flex-col justify-between">
            <div class="flex items-center justify-between text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">
                <span>Net Salary</span>
                <span class="material-symbols-outlined text-indigo-600 text-lg">payments</span>
            </div>
            <div>
                <div class="text-2xl font-bold text-slate-900 tracking-tight">@D.Money(p.NetSalary)</div>
                <div class="text-xs text-slate-400 mt-1">Gross: @D.Money(p.GrossSalary)</div>
            </div>
        </div>
    </div>

    <!-- Correction Request Workflow Card -->
    @if (accountant)
    {
        @if (activeIssue != null)
        {
            <!-- Active Correction Request in Progress (Manager Card Style) -->
            <div class="bg-white border border-slate-200 rounded-2xl shadow-sm p-6 space-y-5">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-100 pb-4">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-xl bg-indigo-50 border border-indigo-100 text-indigo-600 flex items-center justify-center shrink-0">
                            <span class="material-symbols-outlined text-xl">build_circle</span>
                        </div>
                        <div>
                            <h2 class="text-base font-bold text-slate-900">Source Correction Request #@activeIssue.CorrectionRequestId</h2>
                            <p class="text-xs text-slate-500 mt-0.5">
                                Created: @activeIssue.CreatedAt.ToString("dd/MM/yyyy HH:mm") • 
                                Deadline: <strong class="text-slate-800 font-semibold">@(activeIssue.ResponseDeadlineAt.HasValue ? D.Time(activeIssue.ResponseDeadlineAt) : "—")</strong>
                                @if (activeIssue.ExpiredAt.HasValue)
                                {
                                    <span class="text-rose-600 font-semibold ml-1">• Expired at @D.Time(activeIssue.ExpiredAt)</span>
                                }
                            </p>
                        </div>
                    </div>
                    <div>
                        @if (activeIssue.Status == "OPEN")
                        {
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-amber-50 text-amber-700 border border-amber-200">
                                OPEN
                            </span>
                        }
                        else if (activeIssue.Status == "RESPONDED")
                        {
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-indigo-50 text-indigo-700 border border-indigo-200">
                                RESPONDED
                            </span>
                        }
                        else if (activeIssue.Status == "EXPIRED")
                        {
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-rose-50 text-rose-700 border border-rose-200">
                                EXPIRED
                            </span>
                        }
                        else if (activeIssue.Status == "COMPLETED")
                        {
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                                COMPLETED
                            </span>
                        }
                        else
                        {
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-slate-100 text-slate-700 border border-slate-200">
                                @activeIssue.Status
                            </span>
                        }
                    </div>
                </div>

                <!-- Reason Box -->
                <div class="p-4 rounded-xl bg-slate-50 border border-slate-100 text-xs">
                    <span class="font-semibold text-slate-500 uppercase tracking-wider block mb-1">Accountant's Reason</span>
                    <p class="text-slate-900 font-medium text-sm">@activeIssue.Reason</p>
                </div>

                @if (activeIssue.Status == "OPEN")
                {
                    <div class="p-4 rounded-xl bg-amber-50 border border-amber-200 text-amber-900 text-xs flex items-center gap-3">
                        <span class="material-symbols-outlined text-amber-600 text-lg shrink-0">hourglass_top</span>
                        <div class="font-medium">
                            Awaiting response from Branch Manager prior to deadline: <strong>@D.Time(activeIssue.ResponseDeadlineAt)</strong>.
                        </div>
                    </div>
                }
                else if (activeIssue.Status == "EXPIRED")
                {
                    <div class="p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-900 text-xs space-y-3">
                        <div class="flex items-center gap-2 font-bold text-sm text-rose-950">
                            <span class="material-symbols-outlined text-rose-600">error</span>
                            <span>Correction Request EXPIRED — Period Submission Blocked!</span>
                        </div>
                        <p class="text-rose-800">
                            The Manager response deadline (<strong>@D.Time(activeIssue.ResponseDeadlineAt)</strong>) has elapsed. Expired correction requests block period submission to Admin. Enter a reason below and resend the request to set a new response deadline.
                        </p>
                        <form asp-action="ResendCorrection" method="post" class="space-y-3 pt-2 border-t border-rose-200">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="requestId" value="@activeIssue.CorrectionRequestId" />
                            <input type="hidden" name="payrollId" value="@p.PayrollId" />
                            <div>
                                <label class="block text-xs font-semibold text-rose-950 uppercase tracking-wider mb-1">Resend Justification *</label>
                                <input name="reason" required placeholder="Enter resend reason (e.g. extending deadline for manager timesheet check)..."
                                       class="w-full h-11 px-3.5 bg-white border border-rose-200 rounded-xl text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:border-rose-500 focus:ring-2 focus:ring-rose-100 transition-all box-border" />
                            </div>
                            <button type="submit" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-rose-700 hover:bg-rose-800 text-white text-sm font-semibold shadow-sm transition-all cursor-pointer">
                                <span class="material-symbols-outlined text-base">forward_to_inbox</span>
                                <span>Resend to Manager (Set New Deadline)</span>
                            </button>
                        </form>
                    </div>
                }
                else if (activeIssue.Status == "RESPONDED")
                {
                    <!-- Manager's Response Box (Manager Modal Style) -->
                    <div class="p-4 rounded-xl bg-indigo-50/50 border border-indigo-200 space-y-2">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-semibold text-indigo-700 uppercase tracking-wider">Manager's Action</span>
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold @(activeIssue.ManagerAction == "CORRECT" ? "bg-indigo-600 text-white" : "bg-amber-500 text-white")">
                                @activeIssue.ManagerAction
                            </span>
                        </div>
                        <div class="text-xs text-slate-800">
                            <span class="font-semibold text-slate-600">Response Note:</span> @(activeIssue.ManagerNote ?? "No explanation note provided.")
                        </div>
                        <div class="text-[11px] text-slate-500">
                            Responded at: @D.Time(activeIssue.RespondedAt)
                        </div>
                    </div>

                    @if (activeIssue.ManagerAction == "EXPLAIN")
                    {
                        <!-- Accountant reviews EXPLAIN -->
                        <form asp-action="ReviewCorrection" method="post" class="space-y-4 pt-2">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="CorrectionRequestId" value="@activeIssue.CorrectionRequestId" />
                            <input type="hidden" name="payrollId" value="@p.PayrollId" />

                            <div>
                                <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">Accountant Review Decision</label>
                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                    <label class="flex items-start gap-2.5 p-3.5 rounded-xl border border-emerald-200 bg-emerald-50/40 hover:bg-emerald-50 cursor-pointer transition-colors">
                                        <input type="radio" name="Decision" value="ACCEPT_EXPLANATION" checked class="mt-0.5 text-emerald-600 focus:ring-emerald-500 cursor-pointer" />
                                        <div>
                                            <div class="text-xs font-bold text-emerald-900">Accept Explanation</div>
                                            <div class="text-[11px] text-slate-500 mt-0.5 font-normal">Retain current figures and complete this correction request.</div>
                                        </div>
                                    </label>
                                    <label class="flex items-start gap-2.5 p-3.5 rounded-xl border border-rose-200 bg-rose-50/40 hover:bg-rose-50 cursor-pointer transition-colors">
                                        <input type="radio" name="Decision" value="RETURN" class="mt-0.5 text-rose-600 focus:ring-rose-500 cursor-pointer" />
                                        <div>
                                            <div class="text-xs font-bold text-rose-900">Return Request</div>
                                            <div class="text-[11px] text-slate-500 mt-0.5 font-normal">Instruct Manager to re-verify or adjust attendance sources.</div>
                                        </div>
                                    </label>
                                </div>
                            </div>

                            <div>
                                <label for="review-note" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">
                                    Decision Note <span class="text-rose-500">*</span>
                                </label>
                                <textarea id="review-note" name="Note" required rows="2"
                                          placeholder="Enter your justification for accepting or returning this explanation..."
                                          class="w-full px-3.5 py-2.5 bg-slate-50/50 hover:bg-white focus:bg-white border border-slate-200 rounded-xl text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 transition-all box-border"></textarea>
                            </div>

                            <div class="flex items-center justify-end">
                                <button type="submit" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 active:bg-indigo-800 text-white text-sm font-semibold shadow-sm transition-all cursor-pointer">
                                    <span class="material-symbols-outlined text-sm">check</span>
                                    <span>Submit Review Decision</span>
                                </button>
                            </div>
                        </form>
                    }
                    else if (activeIssue.ManagerAction == "CORRECT")
                    {
                        <!-- CORRECT action: Preview & Recalculate -->
                        <div class="space-y-4 pt-2">
                            <div class="flex flex-wrap gap-3 items-center">
                                <a asp-action="PreviewCorrection" asp-route-payrollId="@p.PayrollId" asp-route-correctionRequestId="@activeIssue.CorrectionRequestId"
                                   class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-white hover:bg-slate-50 text-slate-700 border border-slate-200 text-sm font-semibold shadow-xs transition-all">
                                    <span class="material-symbols-outlined text-base">preview</span>
                                    <span>Preview Source Differences</span>
                                </a>
                                <form asp-action="Recalculate" method="post" class="inline-block">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="payrollId" value="@p.PayrollId" />
                                    <input type="hidden" name="correctionRequestId" value="@activeIssue.CorrectionRequestId" />
                                    <button type="submit" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold shadow-sm transition-all cursor-pointer">
                                        <span class="material-symbols-outlined text-base">refresh</span>
                                        <span>Recalculate Payroll (V@(p.VersionNo + 1))</span>
                                    </button>
                                </form>
                            </div>

                            @if (p.Status == "CALCULATED" && p.PreviousPayrollId.HasValue)
                            {
                                <div class="p-4 rounded-xl bg-emerald-50 border border-emerald-200 mt-4 space-y-3">
                                    <div class="flex items-center gap-2 text-emerald-900 font-bold text-sm">
                                        <span class="material-symbols-outlined text-emerald-600">verified</span>
                                        <span>Recalculation Succeeded (V@(p.VersionNo)). Confirm request completion:</span>
                                    </div>
                                    <form asp-action="CompleteCorrection" method="post" class="space-y-3">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="CorrectionRequestId" value="@activeIssue.CorrectionRequestId" />
                                        <input type="hidden" name="PayrollId" value="@p.PayrollId" />
                                        <div>
                                            <input name="Note" required placeholder="Completion note (e.g. verified updated attendance hours and computed V2)..."
                                                   class="w-full h-11 px-3.5 bg-white border border-slate-200 rounded-xl text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 transition-all box-border" />
                                        </div>
                                        <button type="submit" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-semibold shadow-sm transition-all cursor-pointer">
                                            <span class="material-symbols-outlined text-sm">done_all</span>
                                            <span>Complete Correction Request</span>
                                        </button>
                                    </form>
                                </div>
                            }

                            <!-- Shared source impact registration -->
                            <form asp-action="RegisterRelatedImpact" method="post" class="pt-3 border-t border-slate-100">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="requestId" value="@activeIssue.CorrectionRequestId" />
                                <input type="hidden" name="payrollId" value="@p.PayrollId" />
                                <button type="submit" class="text-xs text-indigo-600 hover:text-indigo-800 font-semibold underline cursor-pointer">
                                    Check and register source impact for other employees sharing this update
                                </button>
                            </form>
                        </div>
                    }
                }
            </div>
        }
        else
        {
            <!-- No Active Request: Form to Open One -->
            @if (Model.PeriodStatus is "CALCULATED" or "REVISION_REQUIRED" && p.Status is "CALCULATED" or "REJECTED")
            {
                <div class="bg-white border border-slate-200 rounded-2xl shadow-sm p-6 space-y-4">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-xl bg-indigo-50 border border-indigo-100 text-indigo-600 flex items-center justify-center shrink-0">
                            <span class="material-symbols-outlined text-xl">contact_support</span>
                        </div>
                        <div>
                            <h2 class="text-base font-bold text-slate-900">Request Manager Source Correction</h2>
                            <p class="text-xs text-slate-500 mt-0.5">Submit a verification request to the Branch Manager for attendance hours, penalties, or shift adjustments.</p>
                        </div>
                    </div>

                    <form asp-action="RequestCorrection" method="post" class="space-y-4">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="PayrollId" value="@p.PayrollId" />
                        <div>
                            <label for="req-reason" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">
                                Request Reason <span class="text-rose-500">*</span>
                            </label>
                            <textarea id="req-reason" name="Reason" required maxlength="2000" rows="3"
                                      placeholder="Describe specific discrepancies in work hours, hourly rates, or attendance records..."
                                      class="w-full px-3.5 py-2.5 bg-slate-50/50 hover:bg-white focus:bg-white border border-slate-200 rounded-xl text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 transition-all box-border"></textarea>
                        </div>
                        <div class="flex justify-end">
                            <button type="submit" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 active:bg-indigo-800 text-white text-sm font-semibold shadow-sm transition-all cursor-pointer">
                                <span class="material-symbols-outlined text-sm">send</span>
                                <span>Submit Request to Manager</span>
                            </button>
                        </div>
                    </form>
                </div>
            }
        }

        <!-- Explicit Resend Preview to Staff -->
        @if (Model.LatestFeedbackId.HasValue && (activeIssue == null || activeIssue.Status == "COMPLETED"))
        {
            <div class="bg-white border border-indigo-200 rounded-2xl shadow-sm p-6 space-y-4">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center shrink-0">
                        <span class="material-symbols-outlined text-xl">send_and_archive</span>
                    </div>
                    <div>
                        <h2 class="text-base font-bold text-slate-900">Resend Preview to Staff</h2>
                        <p class="text-xs text-slate-500 mt-0.5">
                            Following recalculation or accepted explanation, distribute updated preview V@(p.VersionNo) to the employee for review.
                        </p>
                    </div>
                </div>

                <form asp-action="ResendPreview" method="post" class="space-y-4">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="feedbackId" value="@Model.LatestFeedbackId.Value" />
                    <input type="hidden" name="payrollId" value="@p.PayrollId" />
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">
                            Resend Justification <span class="text-rose-500">*</span>
                        </label>
                        <input name="reason" required placeholder="Enter resend reason (e.g. updated attendance hours and recalculated V2)..."
                               class="w-full h-11 px-3.5 bg-slate-50/50 hover:bg-white focus:bg-white border border-slate-200 rounded-xl text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 transition-all box-border" />
                    </div>
                    <div class="flex justify-end">
                        <button type="submit" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 active:bg-indigo-800 text-white text-sm font-semibold shadow-sm transition-all cursor-pointer">
                            <span class="material-symbols-outlined text-sm">outgoing_mail</span>
                            <span>Resend Preview to Staff</span>
                        </button>
                    </div>
                </form>
            </div>
        }
    }

    <!-- Calculation Parameters Snapshot Card -->
    <div class="bg-white border border-slate-200 rounded-2xl shadow-sm p-6 space-y-4">
        <div class="flex items-center gap-2 border-b border-slate-100 pb-3">
            <span class="material-symbols-outlined text-indigo-600 text-lg">tune</span>
            <h3 class="text-sm font-bold text-slate-900 uppercase tracking-wider">Calculation Parameters &amp; Audit Sources</h3>
        </div>
        <dl class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs">
            <div class="p-3 rounded-xl bg-slate-50 border border-slate-100">
                <dt class="text-slate-500 font-medium">Hourly Rate Snapshot</dt>
                <dd class="text-sm font-bold text-slate-900 mt-0.5">@D.Money(p.HourlyRate) / hour</dd>
            </div>
            <div class="p-3 rounded-xl bg-slate-50 border border-slate-100">
                <dt class="text-slate-500 font-medium">Gross Salary</dt>
                <dd class="text-sm font-bold text-slate-900 mt-0.5">@D.Money(p.GrossSalary)</dd>
            </div>
            <div class="p-3 rounded-xl bg-slate-50 border border-slate-100">
                <dt class="text-slate-500 font-medium">Old Carry Forward Applied</dt>
                <dd class="text-sm font-bold text-slate-900 mt-0.5">@D.Money(p.CarryForwardDeduction)</dd>
            </div>
            <div class="p-3 rounded-xl bg-slate-50 border border-slate-100">
                <dt class="text-slate-500 font-medium">New Penalties (Full)</dt>
                <dd class="text-sm font-bold text-slate-900 mt-0.5">@D.Money(p.TotalPenalty)</dd>
            </div>
            <div class="p-3 rounded-xl bg-slate-50 border border-slate-100">
                <dt class="text-slate-500 font-medium">Attendance Deduction (Full)</dt>
                <dd class="text-sm font-bold text-slate-900 mt-0.5">@D.Money(p.AttendanceDeduction)</dd>
            </div>
            <div class="p-3 rounded-xl bg-slate-50 border border-slate-100">
                <dt class="text-slate-500 font-medium">Deferred Deduction (Next Period)</dt>
                <dd class="text-sm font-bold text-amber-700 mt-0.5">@D.Money(p.DeferredDeductionAmount)</dd>
            </div>
            <div class="p-3 rounded-xl bg-slate-50 border border-slate-100">
                <dt class="text-slate-500 font-medium">Locked Timesheet Source</dt>
                <dd class="text-sm font-bold text-slate-900 mt-0.5">Timesheet #@p.TimesheetId</dd>
            </div>
            <div class="p-3 rounded-xl bg-slate-50 border border-slate-100">
                <dt class="text-slate-500 font-medium">Salary History Source</dt>
                <dd class="text-sm font-bold text-indigo-600 mt-0.5">
                    @if (accountant)
                    {
                        <a asp-controller="AccountantSalaryHistory" asp-action="Details" asp-route-id="@p.SalaryHistoryId" class="hover:underline">
                            History #@p.SalaryHistoryId
                        </a>
                    }
                    else
                    {
                        <span>History #@p.SalaryHistoryId</span>
                    }
                </dd>
            </div>
            <div class="p-3 rounded-xl bg-slate-50 border border-slate-100">
                <dt class="text-slate-500 font-medium">Calculated At (UTC+7)</dt>
                <dd class="text-sm font-bold text-slate-900 mt-0.5">@D.Time(p.CalculatedAt)</dd>
            </div>
        </dl>
    </div>

    <!-- Calculation Breakdown Table -->
    <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden">
        <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between bg-slate-50/60">
            <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-indigo-600 text-lg">format_list_bulleted</span>
                <h3 class="text-sm font-bold text-slate-900">Calculation Details Breakdown</h3>
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold bg-indigo-50 text-indigo-700 border border-indigo-200">
                    @p.Details.Count @(p.Details.Count == 1 ? "Line" : "Lines")
                </span>
            </div>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-xs">
                <thead>
                    <tr class="border-b border-slate-150 bg-slate-50/50 text-[11px] font-bold text-slate-500 uppercase tracking-wider">
                        <th class="py-3.5 px-6">Type / Description</th>
                        <th class="py-3.5 px-6">Work Dates</th>
                        <th class="py-3.5 px-6 text-right">Quantity</th>
                        <th class="py-3.5 px-6 text-right">Rate</th>
                        <th class="py-3.5 px-6 text-right">Multiplier</th>
                        <th class="py-3.5 px-6 text-right">Full Amount</th>
                        <th class="py-3.5 px-6 text-right">Applied Amount</th>
                        <th class="py-3.5 px-6">Sources</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var line in p.Details.OrderBy(d => d.DisplayOrder).ThenBy(d => d.PayrollDetailId))
                    {
                        <tr class="hover:bg-slate-50/80 transition-colors">
                            <td class="py-3.5 px-6">
                                <div class="font-bold text-slate-900">@line.Description</div>
                                <div class="text-[11px] text-slate-400 mt-0.5">@line.Type • @line.ItemCode</div>
                                @if (!string.IsNullOrEmpty(line.Note))
                                {
                                    <div class="text-[11px] text-slate-500 italic mt-0.5">@line.Note</div>
                                }
                            </td>
                            <td class="py-3.5 px-6 text-slate-600">
                                @(line.WorkFrom?.ToString("dd/MM/yyyy") ?? "—")
                                @if (line.WorkTo.HasValue && line.WorkTo != line.WorkFrom)
                                {
                                    <span class="block text-[11px] text-slate-400">to @line.WorkTo.Value.ToString("dd/MM/yyyy")</span>
                                }
                            </td>
                            <td class="py-3.5 px-6 text-right font-medium text-slate-900">
                                @(line.Quantity?.ToString("0.##") ?? "—")
                            </td>
                            <td class="py-3.5 px-6 text-right font-medium text-slate-900">
                                @(line.Rate.HasValue ? D.Money(line.Rate.Value) : "—")
                            </td>
                            <td class="py-3.5 px-6 text-right font-medium text-slate-700">
                                @line.Multiplier.ToString("0.##")x
                            </td>
                            <td class="py-3.5 px-6 text-right font-semibold text-slate-900">
                                @D.Money(line.Amount)
                            </td>
                            <td class="py-3.5 px-6 text-right font-bold text-slate-900">
                                @(line.AppliedAmount.HasValue ? D.Money(line.AppliedAmount.Value) : "—")
                            </td>
                            <td class="py-3.5 px-6 text-[11px] text-slate-500 space-y-0.5">
                                @if (line.SalaryHistoryId.HasValue) { <div>Salary #@line.SalaryHistoryId</div> }
                                @if (line.PublicHolidayId.HasValue) { <div>Holiday #@line.PublicHolidayId</div> }
                                @if (line.HolidayPayRuleId.HasValue) { <div>Rule #@line.HolidayPayRuleId</div> }
                                @if (line.RewardPenaltyId.HasValue) { <div>Bonus/Penalty #@line.RewardPenaltyId</div> }
                                @if (line.AttendancePenaltyId.HasValue) { <div>Attendance #@line.AttendancePenaltyId</div> }
                                @if (line.CarryForwardId.HasValue) { <div>CF #@line.CarryForwardId</div> }
                            </td>
                        </tr>
                    }
                    @if (p.Details.Count == 0)
                    {
                        <tr>
                            <td colspan="8" class="py-8 text-center text-slate-400">
                                No calculation details recorded for this payroll.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Before / After Version Comparison (if previous version exists) -->
    @if (previous != null)
    {
        <div class="bg-white border border-slate-200 rounded-2xl shadow-sm p-6 space-y-4">
            <div class="flex items-center gap-2 border-b border-slate-100 pb-3">
                <span class="material-symbols-outlined text-indigo-600 text-lg">compare_arrows</span>
                <h3 class="text-sm font-bold text-slate-900">Version Comparison</h3>
                <span class="text-xs text-slate-500">Previous: V@(previous.VersionNo) (#@previous.PayrollId) → Current: V@(p.VersionNo) (#@p.PayrollId)</span>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse text-xs">
                    <thead>
                        <tr class="border-b border-slate-150 bg-slate-50/50 text-[11px] font-bold text-slate-500 uppercase tracking-wider">
                            <th class="py-3.5 px-6">Component</th>
                            <th class="py-3.5 px-6 text-right">Previous (V@(previous.VersionNo))</th>
                            <th class="py-3.5 px-6 text-right font-bold text-indigo-900">Current (V@(p.VersionNo))</th>
                            <th class="py-3.5 px-6 text-right font-bold">Difference</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        <tr class="hover:bg-slate-50/80">
                            <td class="py-3 px-6 font-medium text-slate-800">Total Work Hours</td>
                            <td class="py-3 px-6 text-right font-mono">@previous.TotalWorkHours.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) hrs</td>
                            <td class="py-3 px-6 text-right font-mono font-bold text-indigo-900">@p.TotalWorkHours.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) hrs</td>
                            <td class="py-3 px-6 text-right font-mono font-bold @(p.TotalWorkHours > previous.TotalWorkHours ? "text-emerald-600" : p.TotalWorkHours < previous.TotalWorkHours ? "text-rose-600" : "text-slate-500")">
                                @(p.TotalWorkHours - previous.TotalWorkHours != 0 ? (p.TotalWorkHours - previous.TotalWorkHours).ToString("+0.##;-0.##", System.Globalization.CultureInfo.InvariantCulture) + " hrs" : "—")
                            </td>
                        </tr>
                        <tr class="hover:bg-slate-50/80">
                            <td class="py-3 px-6 font-medium text-slate-800">Work Pay</td>
                            <td class="py-3 px-6 text-right font-mono">@D.Money(previous.WorkPay)</td>
                            <td class="py-3 px-6 text-right font-mono font-bold text-indigo-900">@D.Money(p.WorkPay)</td>
                            <td class="py-3 px-6 text-right font-mono font-bold @(p.WorkPay > previous.WorkPay ? "text-emerald-600" : p.WorkPay < previous.WorkPay ? "text-rose-600" : "text-slate-500")">
                                @(p.WorkPay - previous.WorkPay != 0 ? D.Money(p.WorkPay - previous.WorkPay) : "—")
                            </td>
                        </tr>
                        <tr class="hover:bg-slate-50/80">
                            <td class="py-3 px-6 font-medium text-slate-800">Total Rewards</td>
                            <td class="py-3 px-6 text-right font-mono">@D.Money(previous.TotalReward)</td>
                            <td class="py-3 px-6 text-right font-mono font-bold text-indigo-900">@D.Money(p.TotalReward)</td>
                            <td class="py-3 px-6 text-right font-mono font-bold @(p.TotalReward > previous.TotalReward ? "text-emerald-600" : p.TotalReward < previous.TotalReward ? "text-rose-600" : "text-slate-500")">
                                @(p.TotalReward - previous.TotalReward != 0 ? D.Money(p.TotalReward - previous.TotalReward) : "—")
                            </td>
                        </tr>
                        <tr class="hover:bg-slate-50/80">
                            <td class="py-3 px-6 font-medium text-slate-800">Total Penalties</td>
                            <td class="py-3 px-6 text-right font-mono">@D.Money(previous.TotalPenalty)</td>
                            <td class="py-3 px-6 text-right font-mono font-bold text-indigo-900">@D.Money(p.TotalPenalty)</td>
                            <td class="py-3 px-6 text-right font-mono font-bold">
                                @(p.TotalPenalty - previous.TotalPenalty != 0 ? D.Money(p.TotalPenalty - previous.TotalPenalty) : "—")
                            </td>
                        </tr>
                        <tr class="hover:bg-slate-50/80">
                            <td class="py-3 px-6 font-medium text-slate-800">Attendance Deductions</td>
                            <td class="py-3 px-6 text-right font-mono">@D.Money(previous.AttendanceDeduction)</td>
                            <td class="py-3 px-6 text-right font-mono font-bold text-indigo-900">@D.Money(p.AttendanceDeduction)</td>
                            <td class="py-3 px-6 text-right font-mono font-bold">
                                @(p.AttendanceDeduction - previous.AttendanceDeduction != 0 ? D.Money(p.AttendanceDeduction - previous.AttendanceDeduction) : "—")
                            </td>
                        </tr>
                        <tr class="bg-indigo-50/40 font-bold">
                            <td class="py-3.5 px-6 text-indigo-950 uppercase tracking-wider">Net Salary</td>
                            <td class="py-3.5 px-6 text-right font-mono text-slate-700">@D.Money(previous.NetSalary)</td>
                            <td class="py-3.5 px-6 text-right font-mono text-indigo-900 text-sm">@D.Money(p.NetSalary)</td>
                            <td class="py-3.5 px-6 text-right font-mono text-sm @(p.NetSalary > previous.NetSalary ? "text-emerald-600" : p.NetSalary < previous.NetSalary ? "text-rose-600" : "text-slate-500")">
                                @(p.NetSalary - previous.NetSalary != 0 ? D.Money(p.NetSalary - previous.NetSalary) : "0 ₫")
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
