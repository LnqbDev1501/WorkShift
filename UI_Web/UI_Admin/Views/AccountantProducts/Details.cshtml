@model UI_Admin.Models.Accountant.AccountantProductDetailViewModel

@{
    ViewData["Title"] = $"Product - {Model.ProductName}";
    var isActive = Model.Status.Equals("ACTIVE", StringComparison.OrdinalIgnoreCase);
}

<div class="flex flex-col w-full gap-unit-4 px-7 py-6 mx-auto" style="max-width: 1496px;">
    <div class="flex items-center">
        <a asp-controller="AccountantProducts" asp-action="Index" class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-white hover:bg-slate-50 text-slate-700 font-semibold text-sm transition-all border border-slate-200 shadow-sm">
            <span class="material-symbols-outlined text-[18px]">arrow_back</span>
            <span>Back to Products</span>
        </a>
    </div>
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-unit-4">
        <div class="flex items-center gap-unit-3 min-w-0 flex-1">
            <div class="flex flex-col min-w-0">
                <div class="list-eyebrow">Product Catalog</div>
                <h1 class="font-display-lg text-display-lg text-on-surface tracking-tight break-words break-all [overflow-wrap:anywhere]">@Model.ProductName</h1>
            </div>
            @if (isActive)
            {
                <span class="inline-flex items-center gap-1.5 h-6 px-2 rounded-full text-label-sm font-label-sm bg-emerald-50 text-emerald-700 shrink-0">Active</span>
            }
            else
            {
                <span class="inline-flex items-center gap-1.5 h-6 px-2 rounded-full text-label-sm font-label-sm bg-surface-container text-secondary shrink-0">Inactive</span>
            }
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-unit-4">
        <!-- General Info -->
        <div class="bg-surface-container-lowest rounded-xl shadow-sm p-unit-6 min-w-0">
            <div class="flex items-center gap-2.5 pb-unit-4 border-b border-surface-container-highest">
                <span class="p-2 rounded-lg bg-surface-container text-primary flex items-center justify-center">
                    <span class="material-symbols-outlined text-[20px]">inventory_2</span>
                </span>
                <h2 class="font-title-md text-title-md text-on-surface">General Information</h2>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-y-unit-4 gap-x-unit-6 pt-unit-4">
                <div class="flex flex-col min-w-0">
                    <span class="font-label-sm text-secondary uppercase tracking-wider text-[11px]">Product Code</span>
                    <div class="mt-0.5">
                        <span class="font-code-num text-code-num text-primary font-semibold bg-surface-container px-2 py-1 rounded break-words break-all [overflow-wrap:anywhere]">@Model.ProductCode</span>
                    </div>
                </div>
                <div class="flex flex-col min-w-0">
                    <span class="font-label-sm text-secondary uppercase tracking-wider text-[11px]">Price</span>
                    <span class="font-body-md-medium text-on-surface text-body-md mt-0.5 font-code-num font-semibold">@UI_Admin.Helpers.CurrencyHelper.FormatVnd(Model.Price)</span>
                </div>
                <div class="flex flex-col sm:col-span-2 min-w-0">
                    <span class="font-label-sm text-secondary uppercase tracking-wider text-[11px]">Product Name</span>
                    <span class="font-body-md-medium text-on-surface text-body-md mt-0.5 font-semibold break-words break-all [overflow-wrap:anywhere]">@Model.ProductName</span>
                </div>
                <div class="flex flex-col sm:col-span-2 min-w-0">
                    <span class="font-label-sm text-secondary uppercase tracking-wider text-[11px]">Description</span>
                    <span class="font-body-md text-on-surface text-body-md mt-0.5 break-words break-all [overflow-wrap:anywhere]">@(string.IsNullOrWhiteSpace(Model.Description) ? "No description provided." : Model.Description)</span>
                </div>
            </div>
        </div>

        <!-- Catalog Info -->
        <div class="bg-surface-container-lowest rounded-xl shadow-sm p-unit-6 min-w-0">
            <div class="flex items-center gap-2.5 pb-unit-4 border-b border-surface-container-highest">
                <span class="p-2 rounded-lg bg-surface-container text-primary flex items-center justify-center">
                    <span class="material-symbols-outlined text-[20px]">category</span>
                </span>
                <h2 class="font-title-md text-title-md text-on-surface">Catalog Information</h2>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-y-unit-4 gap-x-unit-6 pt-unit-4">
                <div class="flex flex-col min-w-0">
                    <span class="font-label-sm text-secondary uppercase tracking-wider text-[11px]">Branch</span>
                    <span class="font-body-md-medium text-on-surface text-body-md mt-0.5 font-semibold break-words break-all [overflow-wrap:anywhere]">@Model.BranchName</span>
                </div>
                <div class="flex flex-col min-w-0">
                    <span class="font-label-sm text-secondary uppercase tracking-wider text-[11px]">Category</span>
                    <a asp-controller="AccountantCategories" asp-action="Details" asp-route-id="@Model.CategoryId" class="font-body-md-medium text-primary text-body-md mt-0.5 hover:underline break-words break-all [overflow-wrap:anywhere]">@Model.CategoryName</a>
                </div>
                <div class="flex flex-col min-w-0">
                    <span class="font-label-sm text-secondary uppercase tracking-wider text-[11px]">Status</span>
                    <span class="font-body-md-medium text-body-md mt-0.5 font-semibold @(isActive ? "text-emerald-700" : "text-secondary")">@Model.Status</span>
                </div>
                <div class="flex flex-col sm:col-span-2 min-w-0">
                    <span class="font-label-sm text-secondary uppercase tracking-wider text-[11px]">Image</span>
                    @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl" alt="@Model.ProductName" class="mt-1 max-h-48 rounded-xl border border-surface-container-high object-contain" />
                    }
                    else
                    {
                        <span class="font-body-md text-secondary text-body-md mt-0.5 italic">No image provided.</span>
                    }
                </div>
            </div>
        </div>
    </div>
</div>