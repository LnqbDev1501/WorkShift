@model UI_Admin.Models.Manager.Attendance.ManagerDailyAttendanceViewModel
@{
    Layout = "_ManagerLayout";
    ViewData["Title"] = "Attendance Monitoring";
    var dateString = Model.Date?.ToString("yyyy-MM-dd");
    var activeWeek = Model.AvailableWeeks.FirstOrDefault(w => w.ScheduleWeekId == Model.SelectedScheduleWeekId)
                     ?? Model.AvailableWeeks.FirstOrDefault(w => w.IsCurrentWeek);
}

<div class="px-7 py-6 max-w-[1440px] mx-auto space-y-6">
    <!-- Breadcrumb & Top Bar -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-1.5 text-xs text-indigo-600 font-semibold uppercase tracking-wider mb-1">
                <span>Personnel &amp; Attendance</span>
                <span>/</span>
                <span class="text-slate-400">Attendance Monitoring</span>
            </div>
            <div class="flex items-center gap-3">
                <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Staff Attendance Monitoring</h1>
                @if (activeWeek != null)
                {
                    <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-indigo-50 text-indigo-700 border border-indigo-200">
                        @activeWeek.PeriodName
                    </span>
                }
            </div>
            <p class="text-xs text-slate-500 mt-1">
                View real-time and historical shift attendance logs, biometrics, GPS checks, and time calculations for branch staff.
            </p>
        </div>

        <div class="flex items-center gap-2">
            <a asp-action="Index"
               class="h-9 px-3.5 inline-flex items-center gap-1.5 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-xs font-semibold text-slate-700 shadow-xs transition-colors">
                <span class="material-symbols-outlined text-sm">refresh</span>
                <span>Refresh</span>
            </a>
        </div>
    </div>

    <!-- Alert Messages (Toast Banners) -->
    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div id="alertSuccessBanner" class="p-4 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-900 text-sm flex items-center justify-between gap-3 shadow-xs">
            <div class="flex items-center gap-2.5">
                <span class="material-symbols-outlined text-emerald-600 text-xl shrink-0">check_circle</span>
                <span class="font-medium">@Model.SuccessMessage</span>
            </div>
            <button type="button" onclick="document.getElementById('alertSuccessBanner')?.remove()" class="text-emerald-700 hover:text-emerald-950 p-1 rounded-lg">
                <span class="material-symbols-outlined text-lg leading-none">close</span>
            </button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div id="alertErrorBanner" class="p-4 rounded-2xl bg-rose-50 border border-rose-200 text-rose-900 text-sm flex items-center justify-between gap-3 shadow-xs">
            <div class="flex items-center gap-2.5">
                <span class="material-symbols-outlined text-rose-600 text-xl shrink-0">error</span>
                <span class="font-medium">@Model.ErrorMessage</span>
            </div>
            <button type="button" onclick="document.getElementById('alertErrorBanner')?.remove()" class="text-rose-700 hover:text-rose-950 p-1 rounded-lg">
                <span class="material-symbols-outlined text-lg leading-none">close</span>
            </button>
        </div>
    }

    <partial name="_ListMetrics" model='@(new ListMetricViewModel[] {
        new("Scheduled shifts", Model.Summary.TotalScheduled.ToString("N0"), $"{Model.Summary.LateCount} late · {Model.Summary.EarlyLeaveCount} early departure", "schedule"),
        new("In progress", Model.Summary.InProgressCount.ToString("N0"), "In selected scope", "timer"),
        new("Completed", Model.Summary.CompletedCount.ToString("N0"), $"{Model.Summary.PresentCount} present", "task_alt"),
        new("Absent", Model.Summary.AbsentCount.ToString("N0"), $"{Model.Summary.AbsentCount} absent", "person_off")
    })' />

    <!-- Search & Filter Controls -->
    <form method="get" asp-action="Index" class="ws-list-filter" role="search">
        <div class="ws-filter-row">
            <label class="ws-filter-field ws-filter-keyword"><span class="material-symbols-outlined" aria-hidden="true">search</span><input aria-label="Search" type="text" name="search" value="@Model.Search" placeholder="Search by staff name, email, shift..." /></label>
            <div class="ws-filter-field"><select aria-label="Weekly period" name="scheduleWeekId" onchange="this.form.submit()">
                            @foreach (var w in Model.AvailableWeeks)
                            {
                                var isSelected = Model.SelectedScheduleWeekId == w.ScheduleWeekId;
                                var currentTag = w.IsCurrentWeek ? " (Current)" : "";
                                <option value="@w.ScheduleWeekId" selected="@isSelected">
                                    @w.PeriodName@currentTag
                                </option>
                            }
                        </select></div>
            <div class="ws-filter-field"><select aria-label="Shift" name="shiftId" onchange="this.form.submit()">
                            <option value="">All Shifts (@Model.AvailableShifts.Count)</option>
                            @foreach (var s in Model.AvailableShifts)
                            {
                                var timeRange = $"{s.ScheduledStartAt.AddHours(7):HH:mm} - {s.ScheduledEndAt.AddHours(7):HH:mm}";
                                <option value="@s.ShiftId" selected="@(Model.ShiftId == s.ShiftId)">
                                    @s.ShiftName (@timeRange)
                                </option>
                            }
                        </select></div>
            <div class="ws-filter-field"><select aria-label="Status" name="status" onchange="this.form.submit()">
                            <option value="ALL" selected="@(Model.Status == "ALL")">All Statuses (@Model.Summary.TotalScheduled)</option>
                            <option value="WORKING" selected="@(Model.Status == "WORKING")">Working Now (@Model.Summary.InProgressCount)</option>
                            <option value="COMPLETED" selected="@(Model.Status == "COMPLETED")">Completed (@Model.Summary.CompletedCount)</option>
                            <option value="LATE" selected="@(Model.Status == "LATE")">Late Arrival (@Model.Summary.LateCount)</option>
                            <option value="EARLY_LEAVE" selected="@(Model.Status == "EARLY_LEAVE")">Early Leave (@Model.Summary.EarlyLeaveCount)</option>
                            <option value="ABSENT" selected="@(Model.Status == "ABSENT")">Absent / Pending (@Model.Summary.AbsentCount)</option>
                        </select></div>
            <details class="ws-filter-advanced">
                <summary title="Advanced filters" aria-label="Advanced filters"><span class="material-symbols-outlined" aria-hidden="true">tune</span>
                    @if (Context.Request.Query.Any(q => new[] { "date" }.Contains(q.Key, StringComparer.OrdinalIgnoreCase) && !string.IsNullOrWhiteSpace(q.Value.ToString()))) { <span class="ws-filter-indicator" aria-label="Advanced filters active"></span> }
                </summary>
                <div class="ws-filter-panel">
                    <label class="ws-filter-field"><span>Attendance date</span><input aria-label="Attendance date" type="date" name="date" value="@dateString" onchange="this.form.submit()" title="Filter by specific date (optional)" /></label>
                    <button type="submit" class="ws-filter-apply">Apply filters</button>
                </div>
            </details>
            <partial name="_ListFilterActions" model='"Index"' />
        </div>
    </form>

    <!-- Attendance Table Card -->
    <div class="bg-white border border-slate-200 rounded-2xl shadow-xs overflow-hidden">
        <div class="px-6 py-4 border-b border-slate-150 flex items-center justify-between bg-slate-50/60">
            <div class="flex items-center gap-2.5">
                <span class="material-symbols-outlined text-indigo-600 text-xl">fact_check</span>
                <h2 class="text-sm font-bold text-slate-900">
                    Shift Attendance Records
                    @if (Model.Date.HasValue)
                    {
                        <span class="font-normal text-slate-600">— @Model.Date.Value.ToString("dddd, dd/MM/yyyy")</span>
                    }
                </h2>
                <span class="ml-2 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-indigo-50 text-indigo-700 border border-indigo-200">
                    @Model.Items.Count of @Model.TotalCount Records
                </span>
            </div>
            <span class="text-xs text-slate-500 font-medium">Timezone: Vietnam (UTC+7)</span>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm text-slate-700">
                <thead class="bg-slate-50 text-xs font-semibold text-slate-500 uppercase tracking-wider border-b border-slate-200">
                    <tr>
                        <th scope="col" class="px-4 py-3.5 text-center w-12">#</th>
                        <th scope="col" class="px-5 py-3.5">Staff Member</th>
                        <th scope="col" class="px-5 py-3.5">Shift &amp; Date</th>
                        <th scope="col" class="px-4 py-3.5">Check-In</th>
                        <th scope="col" class="px-4 py-3.5">Check-Out</th>
                        <th scope="col" class="px-4 py-3.5 text-center">Work (H)</th>
                        <th scope="col" class="px-5 py-3.5 text-center">Status</th>
                        <th scope="col" class="px-4 py-3.5 text-center w-24">Action</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 font-medium text-xs">
                    @if (Model.Items == null || Model.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="8" class="px-6 py-12 text-center text-slate-400">
                                <div class="flex flex-col items-center justify-center gap-3">
                                    <div class="w-14 h-14 rounded-2xl bg-slate-100 flex items-center justify-center text-slate-400">
                                        <span class="material-symbols-outlined text-3xl">event_busy</span>
                                    </div>
                                    <div class="text-base font-semibold text-slate-700">No Attendance Records Found</div>
                                    <p class="text-xs text-slate-400 max-w-sm">No scheduled shift assignments or attendance logs match your filter criteria.</p>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        int index = (Model.PageIndex - 1) * Model.PageSize + 1;
                        foreach (var item in Model.Items)
                        {
                            var status = (item.AttendanceStatus ?? "SCHEDULED").ToUpperInvariant();
                            var scheduledDate = item.ScheduledStartAt.AddHours(7).ToString("ddd, dd/MM/yyyy");
                            var scheduledRange = $"{item.ScheduledStartAt.AddHours(7):HH:mm} – {item.ScheduledEndAt.AddHours(7):HH:mm}";
                            decimal workH = Math.Round((decimal)item.ActualWorkingMinutes / 60m, 1);
                            bool isLateExcused = item.TotalLateMinutes > 0 && item.ChargeableLateMinutes == 0;
                            bool isEarlyExcused = item.TotalEarlyLeaveMinutes > 0 && item.ChargeableEarlyLeaveMinutes == 0;

                            <tr class="hover:bg-slate-50/80 transition-colors">
                                <!-- Index -->
                                <td class="px-4 py-4 text-center font-mono text-slate-400">
                                    @(index++)
                                </td>

                                <!-- Staff Member -->
                                <td class="px-5 py-4">
                                    <div class="flex items-center gap-3">
                                        @if (!string.IsNullOrWhiteSpace(item.AvatarUrl))
                                        {
                                            <img src="@item.AvatarUrl"
                                                 alt="@item.FullName"
                                                 class="w-9 h-9 rounded-full object-cover border border-slate-200 shrink-0"
                                                 onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                                            <div class="hidden w-9 h-9 rounded-full bg-indigo-50 text-indigo-700 font-bold text-xs items-center justify-center border border-indigo-200 shrink-0">
                                                @(string.Concat(item.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).TakeLast(2).Select(w => char.ToUpperInvariant(w[0]))))
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="w-9 h-9 rounded-full bg-indigo-50 text-indigo-700 font-bold text-xs flex items-center justify-center border border-indigo-200 shrink-0">
                                                @(string.Concat(item.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).TakeLast(2).Select(w => char.ToUpperInvariant(w[0]))))
                                            </div>
                                        }
                                        <div class="flex flex-col min-w-0">
                                            <span class="font-bold text-slate-900 text-sm truncate">@item.FullName</span>
                                            <span class="text-[11px] text-slate-400 truncate">@item.RoleName • @item.Email</span>
                                        </div>
                                    </div>
                                </td>

                                <!-- Shift & Date -->
                                <td class="px-5 py-4">
                                    <div class="flex flex-col">
                                        <span class="font-bold text-slate-900 text-sm">@item.ShiftName</span>
                                        <span class="text-[11px] text-indigo-600 font-semibold mt-0.5">@scheduledDate</span>
                                        <span class="text-[11px] text-slate-500 font-medium flex items-center gap-1">
                                            <span class="material-symbols-outlined text-[13px] text-slate-400">schedule</span>
                                            <span>@scheduledRange</span>
                                        </span>
                                    </div>
                                </td>

                                <!-- Check-In -->
                                <td class="px-4 py-4">
                                    @if (item.CheckInTime.HasValue)
                                    {
                                        <div class="flex flex-col gap-0.5">
                                            <span class="font-bold text-slate-900 text-sm">
                                                @item.CheckInTime.Value.AddHours(7).ToString("HH:mm:ss")
                                            </span>
                                            <div class="flex items-center gap-1.5 text-[10px] text-slate-500">
                                                @if (item.CheckInFaceVerified == true)
                                                {
                                                    <span class="inline-flex items-center text-emerald-600" title="Face Biometric Verified">
                                                        <span class="material-symbols-outlined text-[14px]">face</span>
                                                    </span>
                                                }
                                                @if (item.CheckInDistanceMeters.HasValue)
                                                {
                                                    <span>@Math.Round(item.CheckInDistanceMeters.Value, 0)m GPS</span>
                                                }
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-slate-400 font-mono">--:--:--</span>
                                    }
                                </td>

                                <!-- Check-Out -->
                                <td class="px-4 py-4">
                                    @if (item.CheckOutTime.HasValue)
                                    {
                                        <div class="flex flex-col gap-0.5">
                                            <span class="font-bold text-slate-900 text-sm">
                                                @item.CheckOutTime.Value.AddHours(7).ToString("HH:mm:ss")
                                            </span>
                                            <div class="flex items-center gap-1.5 text-[10px] text-slate-500">
                                                @if (item.CheckOutFaceVerified == true)
                                                {
                                                    <span class="inline-flex items-center text-emerald-600" title="Face Biometric Verified">
                                                        <span class="material-symbols-outlined text-[14px]">face</span>
                                                    </span>
                                                }
                                                @if (item.CheckOutDistanceMeters.HasValue)
                                                {
                                                    <span>@Math.Round(item.CheckOutDistanceMeters.Value, 0)m GPS</span>
                                                }
                                            </div>
                                        </div>
                                    }
                                    else if (item.CheckInTime.HasValue)
                                    {
                                        if (status == "INCOMPLETE" || DateTime.UtcNow > item.ScheduledEndAt)
                                        {
                                            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[10px] font-bold bg-amber-50 text-amber-700 border border-amber-200" title="Shift ended without check-out">
                                                <span class="material-symbols-outlined text-[12px]">schedule</span>
                                                <span>MISSED OUT</span>
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[10px] font-bold bg-amber-50 text-amber-700 border border-amber-200">
                                                <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span>
                                                <span>WORKING</span>
                                            </span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-slate-400 font-mono">--:--:--</span>
                                    }
                                </td>

                                <!-- Work (H) -->
                                <td class="px-4 py-4 text-center font-mono font-bold text-slate-900">
                                    @if (workH > 0)
                                    {
                                        <span>@workH.ToString("0.0")h</span>
                                    }
                                    else
                                    {
                                        <span class="text-slate-300">0.0h</span>
                                    }
                                </td>

                                <!-- Status Badge -->
                                <td class="px-5 py-4 text-center">
                                    <div class="flex flex-col items-center gap-1">
                                        @if (item.IsExcusedLeave || status == "LEAVE")
                                        {
                                            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-bold bg-blue-50 text-blue-700 border border-blue-200">
                                                <span class="material-symbols-outlined text-sm">event_available</span>
                                                <span>ON LEAVE</span>
                                            </span>
                                        }
                                        else if (status is "ABSENT" or "NOT_CHECKED_IN")
                                        {
                                            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-bold bg-rose-50 text-rose-700 border border-rose-200">
                                                <span class="material-symbols-outlined text-sm">close</span>
                                                <span>@(status == "NOT_CHECKED_IN" ? "NOT IN YET" : "ABSENT")</span>
                                            </span>
                                        }
                                        else if (status == "COMPLETED")
                                        {
                                            if (isLateExcused || isEarlyExcused)
                                            {
                                                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-bold bg-sky-50 text-sky-700 border border-sky-200" title="Valid attendance: Late/Early departure fully excused by approved request">
                                                    <span class="material-symbols-outlined text-sm">verified</span>
                                                    <span>COMPLETED (EXCUSED)</span>
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                                                    <span class="material-symbols-outlined text-sm">check_circle</span>
                                                    <span>COMPLETED</span>
                                                </span>
                                            }
                                        }
                                        else if (status == "INCOMPLETE")
                                        {
                                            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-bold bg-amber-50 text-amber-700 border border-amber-200" title="Shift ended without check-out">
                                                <span class="material-symbols-outlined text-sm">schedule</span>
                                                <span>INCOMPLETE</span>
                                            </span>
                                        }
                                        else if (status == "IN_PROGRESS")
                                        {
                                            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-bold bg-amber-50 text-amber-700 border border-amber-200">
                                                <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span>
                                                <span>WORKING</span>
                                            </span>
                                        }
                                        else if (status == "LATE")
                                        {
                                            if (isLateExcused)
                                            {
                                                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-bold bg-sky-50 text-sky-700 border border-sky-200">
                                                    <span class="material-symbols-outlined text-sm">verified</span>
                                                    <span>LATE (EXCUSED)</span>
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-bold bg-amber-50 text-amber-700 border border-amber-200">
                                                    <span class="material-symbols-outlined text-sm">warning</span>
                                                    <span>LATE ARRIVAL</span>
                                                </span>
                                            }
                                        }
                                        else if (status == "EARLY_LEAVE")
                                        {
                                            if (isEarlyExcused)
                                            {
                                                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-bold bg-sky-50 text-sky-700 border border-sky-200">
                                                    <span class="material-symbols-outlined text-sm">verified</span>
                                                    <span>EARLY (EXCUSED)</span>
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-bold bg-orange-50 text-orange-700 border border-orange-200">
                                                    <span class="material-symbols-outlined text-sm">directions_walk</span>
                                                    <span>EARLY LEAVE</span>
                                                </span>
                                            }
                                        }
                                        else if (status == "LATE_AND_EARLY_LEAVE")
                                        {
                                            if (isLateExcused && isEarlyExcused)
                                            {
                                                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-bold bg-sky-50 text-sky-700 border border-sky-200">
                                                    <span class="material-symbols-outlined text-sm">verified</span>
                                                    <span>LATE &amp; EARLY (EXCUSED)</span>
                                                </span>
                                            }
                                            else if (isLateExcused)
                                            {
                                                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-bold bg-orange-50 text-orange-700 border border-orange-200">
                                                    <span class="material-symbols-outlined text-sm">warning</span>
                                                    <span>LATE (EXCUSED) &amp; EARLY</span>
                                                </span>
                                            }
                                            else if (isEarlyExcused)
                                            {
                                                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-bold bg-orange-50 text-orange-700 border border-orange-200">
                                                    <span class="material-symbols-outlined text-sm">warning</span>
                                                    <span>LATE &amp; EARLY (EXCUSED)</span>
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-bold bg-orange-50 text-orange-700 border border-orange-200">
                                                    <span class="material-symbols-outlined text-sm">warning</span>
                                                    <span>LATE &amp; EARLY</span>
                                                </span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-bold bg-slate-100 text-slate-600 border border-slate-200">
                                                <span>SCHEDULED</span>
                                            </span>
                                        }

                                        @if (!item.IsExcusedLeave && status != "LEAVE" && (isLateExcused || isEarlyExcused))
                                        {
                                            <div class="flex flex-wrap items-center justify-center gap-1">
                                                @if (isLateExcused)
                                                {
                                                    <span class="inline-flex items-center gap-0.5 px-1.5 py-0.5 rounded text-[10px] font-bold bg-sky-50 text-sky-700 border border-sky-200" title="Late arrival approved (@item.TotalLateMinutes mins, penalty waived)">
                                                        <span class="material-symbols-outlined text-[11px]">verified</span>
                                                        <span>Late @(item.TotalLateMinutes)m: Excused</span>
                                                    </span>
                                                }
                                                @if (isEarlyExcused)
                                                {
                                                    <span class="inline-flex items-center gap-0.5 px-1.5 py-0.5 rounded text-[10px] font-bold bg-sky-50 text-sky-700 border border-sky-200" title="Early departure approved (@item.TotalEarlyLeaveMinutes mins, penalty waived)">
                                                        <span class="material-symbols-outlined text-[11px]">verified</span>
                                                        <span>Early @(item.TotalEarlyLeaveMinutes)m: Excused</span>
                                                    </span>
                                                }
                                            </div>
                                        }
                                    </div>
                                </td>

                                <!-- Action Details -->
                                <td class="px-4 py-4 text-center">
                                    <a asp-action="Details"
                                       asp-route-id="@item.AssignmentId"
                                       title="View Full Details" class="ws-icon-action" aria-label="View Full Details"><span class="material-symbols-outlined" aria-hidden="true">visibility</span></a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <partial name="_ListPagination" model="@(new ListPaginationViewModel
        {
            PageNumber = Model.PageIndex,
            PageSize = Model.PageSize,
            TotalItems = Model.TotalCount,
            PageParameter = "page",
            ItemLabel = "attendance records",
        })" />
    </div>
</div>
