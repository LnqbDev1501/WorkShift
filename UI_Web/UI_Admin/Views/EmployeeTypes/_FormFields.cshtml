@model UI_Admin.Models.EmployeeTypes.EmployeeTypeFormViewModel
<div class="flex flex-col gap-6">
    <div class="flex flex-col gap-1.5">
        <label asp-for="TypeName" class="text-title-md text-on-surface font-semibold">Employee Type Name <span class="text-error">*</span></label>
        <input asp-for="TypeName" trimmed-input placeholder="e.g. Full-time, Part-time" class="w-full h-12 px-4 bg-surface-container-low border border-transparent rounded-xl text-on-surface font-body-md focus:outline-none focus:ring-2 focus:ring-primary-container/30 focus:border-primary-container" />
        <span asp-validation-for="TypeName" class="text-error text-body-sm"></span>
        <p class="text-body-sm text-secondary">Use a unique name with up to 100 characters after trimming leading and trailing whitespace.</p>
    </div>
    <div class="flex flex-col gap-1.5">
        <label asp-for="Description" class="text-title-md text-on-surface font-semibold"></label>
        <textarea asp-for="Description" trimmed-input rows="5" placeholder="Describe this employee classification..." class="w-full px-4 py-3 bg-surface-container-low border border-transparent rounded-xl text-on-surface font-body-md focus:outline-none focus:ring-2 focus:ring-primary-container/30 focus:border-primary-container"></textarea>
        <span asp-validation-for="Description" class="text-error text-body-sm"></span>
        <p class="text-body-sm text-secondary">Optional. Maximum 500 characters after trimming leading and trailing whitespace.</p>
    </div>
    @if (Model is UI_Admin.Models.EmployeeTypes.EditEmployeeTypeViewModel editModel)
    {
        <div class="flex flex-col gap-1.5">
            <span class="text-title-md text-on-surface font-semibold">Status</span>
            <div><partial name="_StatusBadge" model="editModel.Status" /></div>
            <p class="text-body-sm text-secondary">Use Deactivate or Restore from the employee type list to change status.</p>
        </div>
    }
</div>
