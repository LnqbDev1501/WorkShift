@model string
@if (Model == "ACTIVE")
{
    <span class="inline-flex items-center gap-1.5 h-6 px-2 rounded-full text-label-sm font-label-sm bg-emerald-50 text-emerald-700"><span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>Active</span>
}
else
{
    <span class="inline-flex items-center gap-1.5 h-6 px-2 rounded-full text-label-sm font-label-sm bg-surface-container text-secondary"><span class="w-1.5 h-1.5 rounded-full bg-secondary"></span>Inactive</span>
}
