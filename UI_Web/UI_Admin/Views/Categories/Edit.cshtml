@model UI_Admin.Models.Catalog.EditCategoryViewModel

@{
    ViewData["Title"] = "Edit Category";
}

<div class="ws-form-page px-4 sm:px-6 py-6">
    <div class="max-w-4xl mx-auto w-full flex flex-col gap-unit-4">
        <div class="flex items-center gap-unit-3">
            <a asp-controller="Categories" asp-action="Index" class="inline-flex items-center justify-center h-9 w-9 rounded-xl bg-surface-container-lowest hover:bg-surface-container text-secondary hover:text-on-surface transition-colors shadow-sm" title="Cancel">
                <span class="material-symbols-outlined text-[20px]">close</span>
            </a>
            <div class="flex flex-col">
                <div class="list-eyebrow">Product Catalog</div>
                <h1 class="font-display-lg text-display-lg text-on-surface tracking-tight">Edit Category</h1>
            </div>
        </div>

        <div class="w-full bg-surface-container-lowest rounded-2xl shadow-sm p-6 sm:p-8 border border-slate-200">
            <form method="post" asp-controller="Categories" asp-action="Edit" asp-route-id="@Model.CategoryId" class="flex flex-col gap-unit-4">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="CategoryId" />
                <input type="hidden" asp-for="Status" />
                <div asp-validation-summary="ModelOnly" class="text-error font-body-sm text-body-sm"></div>

                <div class="flex flex-col gap-unit-2">
                    <label asp-for="CategoryName" class="font-label-md text-label-md text-on-surface">Category Name <span class="text-error">*</span></label>
                    <input asp-for="CategoryName" class="w-full h-[40px] px-unit-3 bg-surface-container-lowest border border-surface-container-high rounded-xl text-on-surface font-body-md text-body-md placeholder:text-secondary focus:outline-none focus:ring-1 focus:ring-primary-container" type="text" />
                    <span asp-validation-for="CategoryName" class="text-error font-body-sm text-body-sm"></span>
                </div>

                <div class="flex flex-col gap-unit-2">
                    <label asp-for="Description" class="font-label-md text-label-md text-on-surface">Description</label>
                    <textarea asp-for="Description" rows="3" class="w-full px-unit-3 py-2 bg-surface-container-lowest border border-surface-container-high rounded-xl text-on-surface font-body-md text-body-md placeholder:text-secondary focus:outline-none focus:ring-1 focus:ring-primary-container"></textarea>
                    <span asp-validation-for="Description" class="text-error font-body-sm text-body-sm"></span>
                </div>

                <div class="flex items-center gap-unit-2 p-unit-3 bg-surface-container-low rounded-xl">
                    <span class="font-label-sm text-secondary uppercase tracking-wider text-[11px]">Status:</span>
                    <span class="font-body-md-medium text-body-md-medium @(Model.Status == "ACTIVE" ? "text-emerald-700" : "text-secondary")">@Model.Status</span>
                    <span class="font-label-sm text-secondary text-[12px]">• @Model.ProductCount products</span>
                </div>

                <div class="flex items-center justify-end gap-unit-3 pt-unit-2">
                    <a asp-controller="Categories" asp-action="Index" class="inline-flex items-center justify-center h-[40px] px-unit-4 rounded-xl bg-surface-container hover:bg-surface-container-high text-on-surface font-body-md-medium text-body-md-medium transition-colors">Cancel</a>
                    <button type="submit" class="inline-flex items-center justify-center gap-unit-2 h-[40px] px-unit-4 rounded-xl bg-primary-container hover:bg-primary text-on-primary font-body-md-medium text-body-md-medium transition-colors shadow-sm cursor-pointer">
                        <span class="material-symbols-outlined text-[20px]">save</span>
                        <span>Save Changes</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
