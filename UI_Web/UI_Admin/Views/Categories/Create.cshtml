@model UI_Admin.Models.Catalog.CreateCategoryViewModel

@{
    ViewData["Title"] = "Create Category";
}

<div class="ws-form-page px-4 sm:px-6 py-6">
    <div class="max-w-4xl mx-auto w-full flex flex-col gap-unit-4">
        <div class="flex flex-col">
                <div class="list-eyebrow">Product Catalog</div>
                <h1 class="font-display-lg text-display-lg text-on-surface tracking-tight">Create Category</h1>
            </div>

        <div class="w-full bg-surface-container-lowest rounded-2xl shadow-sm p-6 sm:p-8 border border-slate-200">
            <form method="post" asp-controller="Categories" asp-action="Create" class="flex flex-col gap-unit-4">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-error font-body-sm text-body-sm"></div>

                <div class="flex flex-col gap-unit-2">
                    <label asp-for="CategoryName" class="font-label-md text-label-md text-on-surface">Category Name <span class="text-error">*</span></label>
                    <input asp-for="CategoryName" class="w-full h-[40px] px-unit-3 bg-surface-container-lowest border border-surface-container-high rounded-xl text-on-surface font-body-md text-body-md placeholder:text-secondary focus:outline-none focus:ring-1 focus:ring-primary-container" placeholder="e.g. Beverages" type="text" />
                    <span asp-validation-for="CategoryName" class="text-error font-body-sm text-body-sm"></span>
                </div>

                <div class="flex flex-col gap-unit-2">
                    <label asp-for="Description" class="font-label-md text-label-md text-on-surface">Description</label>
                    <textarea asp-for="Description" rows="3" class="w-full px-unit-3 py-2 bg-surface-container-lowest border border-surface-container-high rounded-xl text-on-surface font-body-md text-body-md placeholder:text-secondary focus:outline-none focus:ring-1 focus:ring-primary-container" placeholder="Optional description..."></textarea>
                    <span asp-validation-for="Description" class="text-error font-body-sm text-body-sm"></span>
                </div>

                <div class="flex items-center justify-end gap-unit-3 pt-unit-2">
                    <a asp-controller="Categories" asp-action="Index" class="inline-flex items-center justify-center h-[40px] px-unit-4 rounded-xl bg-surface-container hover:bg-surface-container-high text-on-surface font-body-md-medium text-body-md-medium transition-colors">Cancel</a>
                    <button type="submit" class="inline-flex items-center justify-center gap-unit-2 h-[40px] px-unit-4 rounded-xl bg-primary-container hover:bg-primary text-on-primary font-body-md-medium text-body-md-medium transition-colors shadow-sm cursor-pointer">
                        <span class="material-symbols-outlined text-[20px]">add</span>
                        <span>Create Category</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
