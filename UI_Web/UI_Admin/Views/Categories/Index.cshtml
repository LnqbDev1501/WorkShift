@model UI_Admin.Models.Catalog.CategoryListPagedViewModel

@{
    ViewData["Title"] = "Categories";
    var canWrite = User.IsInRole("ADMIN") || User.IsInRole("MANAGER");
}

<div class="flex flex-col w-full gap-unit-4 px-7 py-4">

    <partial name="_NotificationModal" />

    <!-- Header Title & Action Bar -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-unit-4">
        <div class="flex flex-col">
            <div class="list-eyebrow">Product Catalog</div>
            <div class="flex items-center gap-unit-3">
                <h1 class="font-display-lg text-display-lg text-on-surface tracking-tight">Categories</h1>
            </div>
            <p class="font-body-md text-body-md text-secondary mt-1">Organize products into categories for ordering and reporting.</p>
        </div>
        @if (canWrite)
        {
            <div class="flex items-center gap-unit-3 self-start md:self-auto">
                <a asp-controller="Categories" asp-action="Create" class="inline-flex items-center justify-center gap-unit-2 h-[40px] px-unit-4 rounded-xl bg-primary-container hover:bg-primary text-on-primary font-body-md-medium text-body-md-medium transition-colors shadow-sm focus:outline-none cursor-pointer">
                    <span class="material-symbols-outlined text-[20px]">add</span>
                    <span>Create Category</span>
                </a>
            </div>
        }
    </div>

    <partial name="_ListMetrics" model='@(new ListMetricViewModel[] {
new("Matching Categories", Model.TotalItems.ToString("N0"), "Matching current filters", "category", "#8b5cf6"),
new("Active Categories", Model.Items.Count(x => x.Status == "ACTIVE").ToString("N0"), "On this page", "check_circle", "#10b981"),
new("Inactive Categories", Model.Items.Count(x => x.Status == "INACTIVE").ToString("N0"), "On this page", "pause_circle", "#f59e0b"),
new("Products", Model.Items.Sum(x => x.ProductCount).ToString("N0"), "Across categories on this page", "inventory_2", "#4f46e5")
})' />
    <!-- Filter Toolbar -->
    <form method="get" asp-controller="Categories" asp-action="Index" id="filter-form" class="ws-list-filter" role="search">
        <div class="ws-filter-row">
            <label class="ws-filter-field ws-filter-keyword"><span class="material-symbols-outlined" aria-hidden="true">search</span><input aria-label="Search" id="category-search" name="search" value="@Model.Search" placeholder="Search category name..." type="text"></label>
            <div class="ws-filter-field"><select aria-label="Status" id="status-filter" name="status" onchange="this.form.submit()">
                        <option value="all" selected="@(Model.StatusFilter == "all")">All Statuses</option>
                        <option value="active" selected="@(Model.StatusFilter == "active")">Active</option>
                        <option value="inactive" selected="@(Model.StatusFilter == "inactive")">Inactive</option>
                    </select></div>
            <partial name="_ListFilterActions" model='"Index"' />
        </div>
    </form>

    <!-- Main Table Container -->
    <div class="bg-surface-container-lowest rounded-xl shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left">
                <thead>
                    <tr class="h-[40px] bg-surface-container-low text-secondary text-label-md font-label-md uppercase tracking-wider">
                        <th class="px-unit-5 py-2" scope="col">Category Name</th>
                        <th class="px-unit-4 py-2" scope="col">Description</th>
                        <th class="px-unit-4 py-2 text-right" scope="col">Products</th>
                        <th class="px-unit-4 py-2" scope="col">Status</th>
                        <th class="px-unit-5 py-2 text-right" scope="col">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y-0" id="categories-table-body">
                    @if (Model.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="5" class="px-unit-5 py-8 text-center text-secondary font-body-md">
                                No categories found matching your filter criteria.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Items)
                        {
                            var isActive = item.Status.Equals("ACTIVE", StringComparison.OrdinalIgnoreCase);
                            <tr class="h-[56px] hover:bg-surface-container-low transition-colors group @(!isActive ? "bg-surface-container-lowest/70" : "")">
                                <td class="px-unit-5 py-2 font-body-md-medium text-body-md-medium max-w-xs break-words @(isActive ? "text-on-surface" : "text-secondary")" title="@item.CategoryName">
                                    @(item.CategoryName != null && item.CategoryName.Length > 50 ? item.CategoryName.Substring(0, 50) + "..." : item.CategoryName)
                                </td>
                                <td class="px-unit-4 py-2 font-body-md text-body-md text-secondary max-w-sm truncate">
                                    @(string.IsNullOrWhiteSpace(item.Description) ? "No description provided." : item.Description)
                                </td>
                                <td class="px-unit-4 py-2 font-code-num text-code-num @(isActive ? "text-on-surface" : "text-secondary") text-right whitespace-nowrap">
                                    @item.ProductCount products
                                </td>
                                <td class="px-unit-4 py-2 whitespace-nowrap">
                                    @if (isActive)
                                    {
                                        <span class="inline-flex items-center gap-1.5 h-6 px-2 rounded-full text-label-sm font-label-sm bg-emerald-50 text-emerald-700">
                                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1.5 h-6 px-2 rounded-full text-label-sm font-label-sm bg-surface-container text-secondary">
                                            <span class="w-1.5 h-1.5 rounded-full bg-secondary"></span>
                                            Inactive
                                        </span>
                                    }
                                </td>
                                <td class="px-unit-5 py-2 text-right whitespace-nowrap">
                                    <div class="inline-flex items-center justify-end gap-2">
                                        <a href="@Url.Action("Details", "Categories", new { id = item.CategoryId })" title="View details" aria-label="View details" class="ws-icon-action"><span class="material-symbols-outlined" aria-hidden="true">visibility</span></a>
                                        @if (canWrite)
                                        {
                                            <a href="@Url.Action("Edit", "Categories", new { id = item.CategoryId })" title="Edit" aria-label="Edit" class="ws-icon-action"><span class="material-symbols-outlined" aria-hidden="true">edit</span></a>
                                            @if (isActive)
                                            {
                                                <button type="button"
                                                        data-id="@item.CategoryId"
                                                        data-name="@item.CategoryName" title="Deactivate" aria-label="Deactivate" class="ws-icon-action danger open-deactivate-btn"><span class="material-symbols-outlined" aria-hidden="true">block</span></button>
                                            }
                                            else
                                            {
                                                <button type="button"
                                                        data-id="@item.CategoryId"
                                                        data-name="@item.CategoryName" title="Restore" aria-label="Restore" class="ws-icon-action open-restore-btn"><span class="material-symbols-outlined" aria-hidden="true">restore</span></button>
                                            }
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <!-- Pagination / Footer Bar -->
        <partial name="_ListPagination" model="@(new ListPaginationViewModel
        {
            PageNumber = Model.PageNumber,
            PageSize = Model.PageSize,
            TotalItems = Model.TotalItems,
            ItemLabel = "categories",
        })" />
    </div>

    @if (canWrite)
    {
        <!-- Deactivate Category Modal Dialog -->
        <div class="fixed inset-0 z-50 flex items-center justify-center bg-inverse-surface/50 backdrop-blur-xs transition-opacity duration-200 hidden" id="deactivate-category-modal">
            <div class="relative w-full max-w-lg bg-surface-container-lowest rounded-xl shadow-xl overflow-hidden p-unit-6 flex flex-col gap-unit-4">
                <div class="flex items-start gap-unit-3">
                    <div class="w-10 h-10 rounded-full bg-error-container text-error flex items-center justify-center shrink-0">
                        <span class="material-symbols-outlined text-[24px]">warning</span>
                    </div>
                    <div class="flex-1">
                        <h2 class="font-title-lg text-title-lg text-on-surface">Deactivate Category</h2>
                        <p class="font-body-sm text-body-sm text-secondary mt-1">Are you sure you want to deactivate <strong class="text-on-surface break-words break-all" id="deactivate-target-name">this category</strong>?</p>
                    </div>
                    <button class="text-secondary hover:text-on-surface p-1 rounded-lg hover:bg-surface-container transition-colors" id="close-deactivate-modal" type="button">
                        <span class="material-symbols-outlined text-[20px]">close</span>
                    </button>
                </div>
                <div class="p-unit-3 bg-surface-container-low rounded-lg text-body-sm text-secondary space-y-1">
                    <p>Deactivating this category hides it from product assignment.</p>
                    <p>Categories with active products cannot be deactivated. The category can be restored later.</p>
                </div>
                <form method="post" asp-controller="Categories" asp-action="Deactivate" id="deactivate-form" class="flex items-center justify-end gap-unit-3 pt-unit-2">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="deactivate-category-id" value="0" />
                    <button class="h-[40px] px-unit-4 rounded-xl bg-surface-container hover:bg-surface-container-high text-on-surface font-body-md-medium text-body-md-medium transition-colors cursor-pointer" id="cancel-deactivate-modal" type="button">Cancel</button>
                    <button class="h-[40px] px-unit-4 rounded-xl bg-error hover:bg-error-container hover:text-on-error-container text-white font-body-md-medium text-body-md-medium transition-colors shadow-sm cursor-pointer" id="confirm-deactivate-btn" type="submit">Deactivate Category</button>
                </form>
            </div>
        </div>

        <!-- Restore Category Modal Dialog -->
        <div class="fixed inset-0 z-50 flex items-center justify-center bg-inverse-surface/50 backdrop-blur-xs transition-opacity duration-200 hidden" id="restore-category-modal">
            <div class="relative w-full max-w-lg bg-surface-container-lowest rounded-xl shadow-xl overflow-hidden p-unit-6 flex flex-col gap-unit-4">
                <div class="flex items-start gap-unit-3">
                    <div class="w-10 h-10 rounded-full bg-primary-fixed text-primary flex items-center justify-center shrink-0">
                        <span class="material-symbols-outlined text-[24px]">restart_alt</span>
                    </div>
                    <div class="flex-1">
                        <h2 class="font-title-lg text-title-lg text-on-surface">Restore Category</h2>
                        <p class="font-body-sm text-body-sm text-secondary mt-1">Are you sure you want to restore <strong class="text-on-surface break-words break-all" id="restore-target-name">this category</strong>?</p>
                    </div>
                    <button class="text-secondary hover:text-on-surface p-1 rounded-lg hover:bg-surface-container transition-colors" id="close-restore-modal" type="button">
                        <span class="material-symbols-outlined text-[20px]">close</span>
                    </button>
                </div>
                <div class="p-unit-3 bg-surface-container-low rounded-lg text-body-sm text-secondary space-y-1">
                    <p>Restoring this category will change its status back to <strong class="text-on-surface font-medium">Active</strong>.</p>
                </div>
                <form method="post" asp-controller="Categories" asp-action="Restore" id="restore-form" class="flex items-center justify-end gap-unit-3 pt-unit-2">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="restore-category-id" value="0" />
                    <button class="h-[40px] px-unit-4 rounded-xl bg-surface-container hover:bg-surface-container-high text-on-surface font-body-md-medium text-body-md-medium transition-colors cursor-pointer" id="cancel-restore-modal" type="button">Cancel</button>
                    <button class="h-[40px] px-unit-4 rounded-xl bg-primary hover:bg-primary-container text-on-primary font-body-md-medium text-body-md-medium transition-colors shadow-sm cursor-pointer" id="confirm-restore-btn" type="submit">Confirm Restore</button>
                </form>
            </div>
        </div>
    }

</div>

@section Scripts {
    <script src="~/js/categories.js" asp-append-version="true"></script>
}
