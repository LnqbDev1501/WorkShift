@model UI_Admin.Models.Accountant.PayrollSettlement.PayrollSettlementSummaryResponse
@using D = UI_Admin.Models.Accountant.PayrollPeriods.PeriodDisplay
@{
    ViewData["Title"] = $"Settlement - {Model.PeriodCode}";
}

<div class="px-7 py-6 mx-auto space-y-6" style="max-width: 1496px;">
    <!-- Header Title & Action Bar -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-1.5 text-xs text-indigo-600 font-semibold uppercase tracking-wider mb-1">
                <span class="material-symbols-outlined text-sm">account_balance_wallet</span>
                <span>Payroll / Settlement &amp; Closure</span>
            </div>
            <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Payroll Period Settlement</h1>
            <p class="text-sm text-slate-500 mt-0.5">Confirm completed salary payments and finalize the payroll period.</p>
        </div>
        <div class="flex items-center gap-3">
            <a asp-action="Details" asp-route-id="@Model.PayrollPeriodId"
               class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-white hover:bg-slate-50 text-slate-700 hover:text-slate-900 border border-slate-200 text-sm font-medium transition-all shadow-sm">
                <span class="material-symbols-outlined text-lg">arrow_back</span>
                <span>Back to Period</span>
            </a>
        </div>
    </div>

    <!-- Alert Notifications -->
    @if (TempData["PeriodError"] is string error)
    {
        <div class="p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-sm flex items-center gap-3 shadow-sm">
            <span class="material-symbols-outlined text-rose-600 text-xl shrink-0">error</span>
            <span class="font-medium">@error</span>
        </div>
    }
    @if (TempData["PeriodSuccess"] is string success)
    {
        <div class="p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm flex items-center gap-3 shadow-sm">
            <span class="material-symbols-outlined text-emerald-600 text-xl shrink-0">check_circle</span>
            <span class="font-medium">@success</span>
        </div>
    }

    <!-- 4 Stat Metric Cards (Manager Style) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm flex flex-col justify-between">
            <div class="flex items-center justify-between text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">
                <span>Period Status</span>
                <span class="material-symbols-outlined text-indigo-600 text-lg">verified</span>
            </div>
            <div>
                <div class="text-2xl font-bold text-slate-900 tracking-tight">@Model.PeriodStatus.Replace('_', ' ')</div>
                <div class="text-xs text-slate-400 mt-1">@(Model.IsSettled ? "Settlement finalized" : "Ready for settlement")</div>
            </div>
        </div>

        <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm flex flex-col justify-between">
            <div class="flex items-center justify-between text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">
                <span>Total Net Disbursement</span>
                <span class="material-symbols-outlined text-emerald-600 text-lg">payments</span>
            </div>
            <div>
                <div class="text-2xl font-bold text-emerald-700 tracking-tight">@D.Money(Model.TotalNetSalary)</div>
                <div class="text-xs text-slate-400 mt-1">@Model.Employees.Count Employees</div>
            </div>
        </div>

        <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm flex flex-col justify-between">
            <div class="flex items-center justify-between text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">
                <span>Carry Forward Deducted</span>
                <span class="material-symbols-outlined text-amber-600 text-lg">trending_down</span>
            </div>
            <div>
                <div class="text-2xl font-bold text-amber-700 tracking-tight">@D.Money(Model.TotalCarryForwardApplied)</div>
                <div class="text-xs text-slate-400 mt-1">Previous balance recovered</div>
            </div>
        </div>

        <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm flex flex-col justify-between">
            <div class="flex items-center justify-between text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">
                <span>New Deferred Balance</span>
                <span class="material-symbols-outlined text-indigo-600 text-lg">forward</span>
            </div>
            <div>
                <div class="text-2xl font-bold text-indigo-700 tracking-tight">@D.Money(Model.TotalNewCarryForward)</div>
                <div class="text-xs text-slate-400 mt-1">Deferred to next period</div>
            </div>
        </div>
    </div>

    @if (Model.BlockingReasons.Count > 0)
    {
        <div class="bg-rose-50 border border-rose-200 text-rose-800 rounded-2xl p-5 shadow-sm" role="alert">
            <div class="font-bold mb-2 flex items-center gap-2 text-rose-950 text-sm">
                <span class="material-symbols-outlined text-rose-600">block</span>
                <span>Settlement Blocked</span>
            </div>
            <ul class="list-disc pl-5 space-y-1 text-xs">
                @foreach (var reason in Model.BlockingReasons)
                {
                    <li>@reason</li>
                }
            </ul>
        </div>
    }
    else if (!Model.IsSettled && Model.CanConfirmSettlement)
    {
        <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm space-y-4">
            <div class="flex items-center gap-2 border-b border-slate-100 pb-3">
                <span class="material-symbols-outlined text-indigo-600 text-lg">check_circle</span>
                <h3 class="text-sm font-bold text-slate-900 uppercase tracking-wider">Confirm Salary Settlement</h3>
            </div>
            <p class="text-xs text-slate-500">
                Confirming settlement will mark all current payrolls as <strong class="text-slate-700">PAID</strong>, apply Carry Forward deductions, defer remaining balances, and finalize period closure (<strong class="text-slate-700">PAID &rarr; CLOSED</strong>).
            </p>

            <form id="settlementForm" asp-action="ConfirmSettlement" asp-route-id="@Model.PayrollPeriodId" method="post" class="space-y-4 max-w-xl" onsubmit="return handleSettlementSubmit(this)">
                @Html.AntiForgeryToken()
                <label class="flex items-start gap-3 p-3.5 rounded-xl border border-slate-200 bg-slate-50/60 hover:bg-slate-50 cursor-pointer transition-colors">
                    <input type="checkbox" id="confirmedExternalSettlement" name="ConfirmedExternalSettlement" value="true" required class="mt-0.5 text-indigo-600 focus:ring-indigo-500 cursor-pointer" />
                    <span class="text-xs font-semibold text-slate-800">
                        I confirm that all net salaries have been paid to employees.
                    </span>
                </label>

                <div>
                    <label for="paymentReference" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">Payment Reference (Optional)</label>
                    <input type="text" id="paymentReference" name="PaymentReference" maxlength="100" placeholder="e.g. BANK-TX-20261018-01"
                           class="w-full h-11 px-3.5 bg-slate-50/50 hover:bg-white focus:bg-white border border-slate-200 rounded-xl text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 transition-all box-border" />
                </div>

                <div>
                    <label for="paymentNote" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">Settlement Notes (Optional)</label>
                    <textarea id="paymentNote" name="PaymentNote" maxlength="2000" rows="2" placeholder="Additional details regarding disbursement batch..."
                              class="w-full px-3.5 py-2.5 bg-slate-50/50 hover:bg-white focus:bg-white border border-slate-200 rounded-xl text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 transition-all box-border"></textarea>
                </div>

                <button type="button" onclick="showSettlementModal()" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 active:bg-indigo-800 text-white text-sm font-semibold shadow-sm transition-all cursor-pointer">
                    <span class="material-symbols-outlined text-sm">check_circle</span>
                    <span>Confirm Settlement &amp; Close Period</span>
                </button>
            </form>
        </div>

        <!-- Confirmation Modal for Settlement -->
        <div id="modalConfirmSettlement" class="fixed inset-0 z-50 hidden overflow-y-auto" role="dialog" aria-modal="true" aria-labelledby="modal-settle-title">
            <div class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs transition-opacity" onclick="closeModal('modalConfirmSettlement')"></div>
            <div class="flex min-h-full items-center justify-center p-4 text-center">
                <div class="relative transform overflow-hidden rounded-2xl bg-white text-left shadow-2xl transition-all sm:my-8 sm:w-full sm:max-w-lg border border-slate-200">
                    <div class="p-6">
                        <div class="flex items-center gap-4 mb-4">
                            <div class="w-12 h-12 rounded-2xl bg-indigo-50 border border-indigo-100 flex items-center justify-center text-indigo-600 shrink-0">
                                <span class="material-symbols-outlined text-2xl">account_balance_wallet</span>
                            </div>
                            <div>
                                <h3 class="text-lg font-bold text-slate-900" id="modal-settle-title">Confirm Settlement &amp; Close Period</h3>
                                <p class="text-xs text-slate-500">Period: @Model.PeriodCode • Total: @D.Money(Model.TotalNetSalary)</p>
                            </div>
                        </div>

                        <div class="grid grid-cols-2 gap-3 p-3.5 rounded-xl bg-slate-50 border border-slate-200 text-xs mb-4">
                            <div>
                                <span class="text-slate-400 block mb-0.5">Employees</span>
                                <strong class="text-slate-800 font-bold">@Model.Employees.Count Staff</strong>
                            </div>
                            <div>
                                <span class="text-slate-400 block mb-0.5">Total Net Disbursement</span>
                                <strong class="text-emerald-700 font-bold">@D.Money(Model.TotalNetSalary)</strong>
                            </div>
                        </div>

                        <div class="p-3.5 rounded-xl bg-amber-50 border border-amber-200 text-xs text-amber-900 flex items-start gap-2.5">
                            <span class="material-symbols-outlined text-amber-600 text-base shrink-0 mt-0.5">warning</span>
                            <span>This action confirms that all net salaries have been paid to employees and permanently closes the payroll period.</span>
                        </div>
                    </div>

                    <div class="px-6 py-4 bg-slate-50 border-t border-slate-100 flex items-center justify-end gap-3">
                        <button type="button" onclick="closeModal('modalConfirmSettlement')"
                                class="px-4 py-2.5 rounded-xl bg-white hover:bg-slate-100 text-slate-700 border border-slate-200 text-sm font-semibold transition-all shadow-xs cursor-pointer">
                            Cancel
                        </button>
                        <button type="button" onclick="executeSettlement()" id="btnConfirmFinalSettlement"
                                class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 active:bg-indigo-800 text-white text-sm font-semibold shadow-sm transition-all cursor-pointer">
                            <span class="material-symbols-outlined text-sm">check</span>
                            <span>Confirm Settlement &amp; Close</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (Model.IsSettled)
    {
        <div class="bg-emerald-50 border border-emerald-200 text-emerald-900 rounded-2xl p-5 shadow-sm flex items-start gap-3">
            <span class="material-symbols-outlined text-emerald-600 text-xl shrink-0 mt-0.5">verified</span>
            <div>
                <strong class="font-bold text-sm">Period Settled and Closed</strong>
                <p class="text-xs text-emerald-800 mt-0.5">
                    Paid at: @(Model.PaidAt.HasValue ? D.Time(Model.PaidAt) : "—") • 
                    Closed at: @(Model.ClosedAt.HasValue ? D.Time(Model.ClosedAt) : "—")
                </p>
            </div>
        </div>
    }

    <!-- Employee Settlement Table (Manager Style) -->
    <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden">
        <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between bg-slate-50/60">
            <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-indigo-600 text-lg">group</span>
                <h3 class="text-sm font-bold text-slate-900">Settled Employees</h3>
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold bg-indigo-50 text-indigo-700 border border-indigo-200">
                    @Model.Employees.Count @(Model.Employees.Count == 1 ? "Employee" : "Employees")
                </span>
            </div>
            <div class="text-xs font-bold text-slate-900">
                Total Net: @D.Money(Model.TotalNetSalary)
            </div>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="border-b border-slate-150 bg-slate-50/50 text-[11px] font-bold text-slate-500 uppercase tracking-wider">
                        <th class="py-3.5 px-6">Employee</th>
                        <th class="py-3.5 px-6">Version</th>
                        <th class="py-3.5 px-6">Status</th>
                        <th class="py-3.5 px-6 text-right">Net Salary</th>
                        <th class="py-3.5 px-6 text-right">CF Deducted</th>
                        <th class="py-3.5 px-6 text-right">New CF Deferred</th>
                        <th class="py-3.5 px-6 text-right">Payslip</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 text-sm">
                    @foreach (var emp in Model.Employees)
                    {
                        <tr class="hover:bg-slate-50/80 transition-colors">
                            <td class="py-4 px-6 font-semibold text-slate-900">
                                @emp.EmployeeName
                            </td>
                            <td class="py-4 px-6 font-medium text-slate-700">
                                V@(emp.VersionNo)
                            </td>
                            <td class="py-4 px-6">
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold @(emp.Status == "PAID" ? "bg-teal-50 text-teal-700 border border-teal-200" : "bg-slate-100 text-slate-700 border border-slate-200")">
                                    @emp.Status
                                </span>
                            </td>
                            <td class="py-4 px-6 text-right font-bold text-slate-900">
                                @D.Money(emp.NetSalary)
                            </td>
                            <td class="py-4 px-6 text-right text-xs font-medium text-amber-700">
                                @(emp.CarryForwardDeduction > 0 ? "-" + D.Money(emp.CarryForwardDeduction) : "—")
                            </td>
                            <td class="py-4 px-6 text-right text-xs font-medium text-indigo-700">
                                @(emp.DeferredDeductionAmount > 0 ? "+" + D.Money(emp.DeferredDeductionAmount) : "—")
                            </td>
                            <td class="py-4 px-6 text-right">
                                @if (emp.PayslipId.HasValue)
                                {
                                    <a asp-controller="AccountantPayslips" asp-action="Details" asp-route-id="@emp.PayslipId"
                                       class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold transition-all">
                                        <span class="material-symbols-outlined text-sm">receipt_long</span>
                                        <span>Payslip #@emp.PayslipId</span>
                                    </a>
                                }
                                else
                                {
                                    <span class="text-xs text-slate-400">Not issued</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openModal(id) {
            const modal = document.getElementById(id);
            if (modal) {
                modal.classList.remove('hidden');
                document.body.style.overflow = 'hidden';
            }
        }
        function closeModal(id) {
            const modal = document.getElementById(id);
            if (modal) {
                modal.classList.add('hidden');
                document.body.style.overflow = '';
            }
        }
        function showSettlementModal() {
            const chk = document.getElementById('confirmedExternalSettlement');
            if (!chk || !chk.checked) {
                if (chk) {
                    chk.focus();
                    chk.reportValidity();
                }
                return;
            }
            openModal('modalConfirmSettlement');
        }
        function executeSettlement() {
            const form = document.getElementById('settlementForm');
            const btn = document.getElementById('btnConfirmFinalSettlement');
            if (form && !form.dataset.submitting) {
                form.dataset.submitting = 'true';
                if (btn) {
                    btn.disabled = true;
                    btn.classList.add('opacity-75', 'cursor-not-allowed');
                    btn.innerText = 'Processing...';
                }
                form.submit();
            }
        }
        function handleSettlementSubmit(form) {
            if (form.dataset.submitting === 'true') return false;
            return true;
        }
    </script>
}