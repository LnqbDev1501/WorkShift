@model UI_Admin.Models.Accountant.PayrollPeriods.PeriodRecord
@using D = UI_Admin.Models.Accountant.PayrollPeriods.PeriodDisplay
@{
    ViewData["Title"] = $"{Model.PeriodCode} - Period Details";
    var status = Model.Status;
    var isDraft = status == "DRAFT";
    var isOpen = status == "OPEN";
    var isCalculated = status == "CALCULATED";
    var isRevisionRequired = status == "REVISION_REQUIRED";
    var isSubmitted = status == "SUBMITTED";
    var isApproved = status == "APPROVED";
    var isPaid = status == "PAID";
    var isClosed = status == "CLOSED";

    var totalWorkPay = Model.Payrolls.Sum(p => p.WorkPay);
    var totalReward = Model.Payrolls.Sum(p => p.TotalReward);
    var totalDeduction = Model.Payrolls.Sum(p => p.TotalDeduction);
    var totalPenalty = Model.Payrolls.Sum(p => p.TotalPenalty);
    var totalAttendanceDeduction = Model.Payrolls.Sum(p => p.AttendanceDeduction);
    var totalHours = Model.Payrolls.Sum(p => p.TotalWorkHours);

    var feedbacks = Model.Feedbacks ?? [];
    var corrections = Model.CorrectionRequests ?? [];

    var currentPayrolls = (Model.Payrolls ?? [])
        .Where(p => p.Status != "REPLACED")
        .GroupBy(p => p.UserId)
        .Select(g => g.OrderByDescending(p => p.VersionNo).ThenByDescending(p => p.PayrollId).First())
        .ToList();

    var leafCorrections = corrections
        .Where(c => !corrections.Any(n => n.PreviousRequestId == c.CorrectionRequestId))
        .ToList();

    var openIssues = leafCorrections.Count(c => c.Status is "OPEN" or "RESPONDED" or "RETURNED");
    var expiredIssues = leafCorrections.Count(c => c.Status == "EXPIRED");
    var hasUnresolvedCorrections = leafCorrections.Any(c => c.Status is "OPEN" or "RESPONDED" or "EXPIRED" or "RETURNED");

    int confirmedReviews = 0;
    int expiredReviews = 0;
    int pendingReviews = 0;
    int feedbackPendingReviews = 0;
    int unreviewedStaffCount = 0;

    foreach (var p in currentPayrolls)
    {
        var leaf = feedbacks
            .Where(f => f.EmployeeId == p.UserId && !feedbacks.Any(n => n.PreviousFeedbackId == f.FeedbackId))
            .OrderByDescending(f => f.FeedbackId)
            .FirstOrDefault();

        if (leaf == null || leaf.PayrollId != p.PayrollId)
        {
            unreviewedStaffCount++;
        }
        else if (leaf.ReviewStatus == "CONFIRMED")
        {
            confirmedReviews++;
        }
        else if (leaf.ReviewStatus == "EXPIRED")
        {
            expiredReviews++;
        }
        else if (leaf.ReviewStatus == "PENDING")
        {
            pendingReviews++;
        }
        else if (leaf.ReviewStatus == "FEEDBACK_PENDING")
        {
            feedbackPendingReviews++;
        }
        else
        {
            unreviewedStaffCount++;
        }
    }

    var allStaffReviewed = currentPayrolls.Count > 0
        && unreviewedStaffCount == 0
        && (confirmedReviews + expiredReviews) == currentPayrolls.Count;

    // Real submit condition based on backend rules (PayrollPreviewPolicy.RequireReviewed):
    var isEligibleToSubmit = (isCalculated || isRevisionRequired)
        && currentPayrolls.Count > 0
        && currentPayrolls.All(p => p.Status == "CALCULATED")
        && Model.RejectedPayrollCount == 0
        && allStaffReviewed
        && pendingReviews == 0
        && feedbackPendingReviews == 0
        && !hasUnresolvedCorrections;
}

<div class="px-7 py-6 max-w-[1400px] mx-auto space-y-6">
    <!-- Header Title & Action Bar -->
    <div class="flex flex-col md:flex-row md:items-start justify-between gap-4">
        <div>
            <!-- Breadcrumb -->
            <div class="flex items-center gap-1.5 text-xs text-indigo-600 font-semibold uppercase tracking-wider mb-1">
                <span class="material-symbols-outlined text-sm">calendar_month</span>
                <span>Payroll / Periods / Details</span>
            </div>

            <!-- Title & Status Badge -->
            <div class="flex items-center gap-3 flex-wrap">
                <h1 class="text-2xl font-bold text-slate-900 tracking-tight">@Model.PeriodName</h1>
                @if (isDraft)
                {
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-slate-100 text-slate-700 border border-slate-200">
                        DRAFT
                    </span>
                }
                else if (isOpen)
                {
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-blue-50 text-blue-700 border border-blue-200">
                        OPEN
                    </span>
                }
                else if (isCalculated)
                {
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-sky-50 text-sky-700 border border-sky-200">
                        CALCULATED
                    </span>
                }
                else if (isRevisionRequired)
                {
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-rose-50 text-rose-700 border border-rose-200">
                        REVISION REQUIRED
                    </span>
                }
                else if (isSubmitted)
                {
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-amber-50 text-amber-700 border border-amber-200">
                        SUBMITTED
                    </span>
                }
                else if (isApproved)
                {
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                        APPROVED
                    </span>
                }
                else if (isPaid)
                {
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-teal-50 text-teal-700 border border-teal-200">
                        PAID
                    </span>
                }
                else if (isClosed)
                {
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-slate-100 text-slate-700 border border-slate-200">
                        CLOSED
                    </span>
                }
                else
                {
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-slate-100 text-slate-700 border border-slate-200">
                        @status
                    </span>
                }
            </div>

            <!-- Single Subtitle Line: Period Code, Branch, Date Range -->
            <p class="text-sm text-slate-500 mt-1 flex flex-wrap items-center gap-2">
                <span class="font-semibold text-slate-700">@Model.PeriodCode</span>
                <span class="text-slate-300">•</span>
                <span>Branch: <strong class="text-slate-800">@Model.BranchName</strong></span>
                <span class="text-slate-300">•</span>
                <span>@Model.StartDate.ToString("dd/MM/yyyy") – @Model.EndDate.ToString("dd/MM/yyyy")</span>
            </p>
        </div>

        <!-- Back Button -->
        <div class="flex items-center gap-3 shrink-0">
            <a asp-action="Index" class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-white hover:bg-slate-50 text-slate-700 hover:text-slate-900 border border-slate-200 text-sm font-medium transition-all shadow-sm">
                <span class="material-symbols-outlined text-lg">arrow_back</span>
                <span>Back to Periods</span>
            </a>
        </div>
    </div>

    <!-- Period Action Bar (Horizontal, below header) -->
    <div class="flex flex-wrap items-center gap-2.5 pt-1">
        @if (isDraft)
        {
            @if (Model.CanUpdate)
            {
                <a asp-action="Edit" asp-route-id="@Model.PayrollPeriodId" class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-white hover:bg-slate-50 text-slate-700 border border-slate-200 text-sm font-medium shadow-sm transition-all">
                    <span class="material-symbols-outlined text-base">edit</span>
                    <span>Edit Period</span>
                </a>
            }
            @if (Model.CanOpen)
            {
                <a asp-action="Open" asp-route-id="@Model.PayrollPeriodId" class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold shadow-sm transition-all">
                    <span class="material-symbols-outlined text-base">lock_open</span>
                    <span>Open Period</span>
                </a>
            }
            @if (Model.CanDelete)
            {
                <a asp-action="Delete" asp-route-id="@Model.PayrollPeriodId" class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 text-sm font-medium transition-all">
                    <span class="material-symbols-outlined text-base">delete</span>
                    <span>Delete Draft</span>
                </a>
            }
        }
        @if (isOpen)
        {
            <a asp-controller="AccountantPayrollCalculation" asp-action="Index" asp-route-id="@Model.PayrollPeriodId" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold shadow-sm transition-all">
                <span class="material-symbols-outlined text-base">calculate</span>
                <span>Calculation Workspace</span>
            </a>
        }
        @if (isCalculated || isRevisionRequired)
        {
            <a asp-controller="AccountantPayrollCalculation" asp-action="Index" asp-route-id="@Model.PayrollPeriodId" class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-white hover:bg-slate-50 text-slate-700 border border-slate-200 text-sm font-medium shadow-sm transition-all">
                <span class="material-symbols-outlined text-base">calculate</span>
                <span>Calculation Workspace</span>
            </a>
            <a asp-action="SourceImpact" asp-route-id="@Model.PayrollPeriodId" class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-white hover:bg-slate-50 text-slate-700 border border-slate-200 text-sm font-medium shadow-sm transition-all">
                <span class="material-symbols-outlined text-base">sync_problem</span>
                <span>Check Source Impact</span>
            </a>
            <button type="button" onclick="openModal('modalSendPreviews')" class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-white hover:bg-slate-50 text-slate-700 border border-slate-200 text-sm font-medium shadow-sm transition-all cursor-pointer">
                <span class="material-symbols-outlined text-base">send</span>
                <span>Send Payroll Previews</span>
            </button>
            @if (isEligibleToSubmit)
            {
                <button type="button" onclick="openModal('modalSubmitPeriod')"
                        class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-semibold shadow-sm text-sm transition-all cursor-pointer">
                    <span class="material-symbols-outlined text-base">publish</span>
                    <span>Submit to Admin</span>
                </button>
            }
            else
            {
                <button type="button" disabled
                        class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-slate-100 text-slate-400 cursor-not-allowed text-sm transition-all"
                        title="Cannot submit: required staff previews, employee reviews, or manager corrections remain incomplete">
                    <span class="material-symbols-outlined text-base">publish</span>
                    <span>Submit to Admin</span>
                </button>
            }
        }
        @if (isApproved || isPaid || isClosed)
        {
            <a asp-action="Settlement" asp-route-id="@Model.PayrollPeriodId" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold shadow-sm transition-all">
                <span class="material-symbols-outlined text-base">account_balance_wallet</span>
                <span>@(isPaid || isClosed ? "View Settlement" : "Settle Entire Period")</span>
            </a>
            <a asp-controller="AccountantPayslips" asp-action="Index" asp-route-payrollPeriodId="@Model.PayrollPeriodId" class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-white hover:bg-slate-50 text-slate-700 border border-slate-200 text-sm font-medium shadow-sm transition-all">
                <span class="material-symbols-outlined text-base">receipt_long</span>
                <span>View Payslips</span>
            </a>
        }
        @if (Model.CanExport)
        {
            <a asp-action="Export" asp-route-id="@Model.PayrollPeriodId" download class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-white hover:bg-slate-50 text-slate-700 border border-slate-200 text-sm font-medium shadow-sm transition-all" title="Download official payroll report to your Downloads folder">
                <span class="material-symbols-outlined text-base">download</span>
                <span>Export Excel</span>
            </a>
        }
    </div>

    @if ((isCalculated || isRevisionRequired) && !isEligibleToSubmit)
    {
        <div class="p-4 rounded-2xl bg-indigo-50/50 border border-indigo-150 text-slate-800 text-xs flex items-start gap-3 shadow-xs">
            <span class="material-symbols-outlined text-indigo-600 text-lg shrink-0 mt-0.5">info</span>
            <div>
                <strong class="font-bold text-slate-900">Submission Checklist (Required before submitting to Admin):</strong>
                <ul class="list-disc pl-4 mt-1 space-y-0.5 text-slate-600">
                    @if (currentPayrolls.Count == 0)
                    {
                        <li>No payroll records available for calculation or submission.</li>
                    }
                    @if (feedbacks.Count == 0)
                    {
                        <li>Current payroll version has not been sent for review.</li>
                    }
                    else if (unreviewedStaffCount > 0)
                    {
                        <li><strong>@unreviewedStaffCount</strong> employee(s) do not have a valid preview for the current payroll version.</li>
                    }
                    @if (pendingReviews > 0)
                    {
                        <li><strong>@pendingReviews</strong> employee(s) are awaiting payroll review.</li>
                    }
                    @if (feedbackPendingReviews > 0)
                    {
                        <li><strong>@feedbackPendingReviews</strong> employee review(s) have pending feedback to resolve.</li>
                    }
                    @if (openIssues > 0)
                    {
                        <li><strong>@openIssues</strong> correction request(s) are still open.</li>
                    }
                    @if (expiredIssues > 0)
                    {
                        <li class="text-rose-700 font-semibold"><strong>@expiredIssues</strong> correction request(s) have expired and must be resent.</li>
                    }
                    @if (Model.RejectedPayrollCount > 0)
                    {
                        <li class="text-rose-700 font-semibold"><strong>@Model.RejectedPayrollCount</strong> rejected payroll record(s) require correction and recalculation.</li>
                    }
                </ul>
            </div>
        </div>
    }

    <!-- Alert Messages -->
    @if (TempData["PeriodError"] is string error)
    {
        <div class="p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-sm flex items-center gap-3 shadow-sm">
            <span class="material-symbols-outlined text-rose-600 text-xl shrink-0">error</span>
            <span class="font-medium">@error</span>
        </div>
    }
    <partial name="_PayrollWorkflowMessages" />
    @if (TempData["PeriodSuccess"] is string success)
    {
        <div class="p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm flex items-center gap-3 shadow-sm">
            <span class="material-symbols-outlined text-emerald-600 text-xl shrink-0">check_circle</span>
            <span class="font-medium">@success</span>
        </div>
    }

    @if (isRevisionRequired)
    {
        <div class="p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-900 text-sm flex items-start gap-3 shadow-sm">
            <span class="material-symbols-outlined text-rose-600 text-xl shrink-0 mt-0.5">report_problem</span>
            <div>
                <strong class="font-bold">Revision Required by Admin:</strong>
                <p class="mt-0.5 text-rose-800">
                    There are <strong>@Model.RejectedPayrollCount</strong> rejected payrolls or @Model.PendingCorrectionCount source correction requests that must be resolved with the Branch Manager before re-submitting to Admin.
                </p>
            </div>
        </div>
    }

    <!-- SUMMARY CARDS (Max 4 cards on desktop) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- 1. Total Net Salary -->
        <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm flex flex-col justify-between">
            <div class="flex items-center justify-between text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">
                <span>Net Salary</span>
                <span class="material-symbols-outlined text-indigo-600 text-lg">payments</span>
            </div>
            <div>
                <div class="text-2xl font-bold text-slate-900 tracking-tight">@D.Money(Model.TotalNetSalary)</div>
                <div class="text-xs text-slate-400 mt-1 truncate">
                    Work Pay: @D.Money(totalWorkPay) • @totalHours.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)h
                </div>
            </div>
        </div>

        <!-- 2. Staff / Payrolls -->
        <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm flex flex-col justify-between">
            <div class="flex items-center justify-between text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">
                <span>Staff &amp; Payrolls</span>
                <span class="material-symbols-outlined text-indigo-600 text-lg">badge</span>
            </div>
            <div>
                <div class="text-2xl font-bold text-slate-900 tracking-tight">@Model.TotalPayrolls / @Model.ExpectedEmployeeCount <span class="text-sm font-medium text-slate-500">Staff</span></div>
                <div class="text-xs @(Model.RejectedPayrollCount > 0 ? "text-rose-600 font-semibold" : "text-slate-400") mt-1 truncate">
                    @Model.LockedTimesheetCount Locked Timesheets • @Model.RejectedPayrollCount Rejected
                </div>
            </div>
        </div>

        <!-- 3. Timesheet Reviewed -->
        <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm flex flex-col justify-between">
            <div class="flex items-center justify-between text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">
                <span>Timesheets Reviewed</span>
                <span class="material-symbols-outlined text-indigo-600 text-lg">fact_check</span>
            </div>
            <div>
                <div class="text-2xl font-bold text-slate-900 tracking-tight">@Model.ReviewedTimesheetCount / @Model.ExpectedEmployeeCount</div>
                <div class="text-xs text-slate-400 mt-1 truncate">
                    @(Model.ReviewedTimesheetCount == Model.ExpectedEmployeeCount ? "100% Timesheets reviewed by Manager" : $"{Model.ExpectedEmployeeCount - Model.ReviewedTimesheetCount} timesheets pending review")
                </div>
            </div>
        </div>

        <!-- 4. Staff Review / Corrections Status -->
        <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm flex flex-col justify-between">
            <div class="flex items-center justify-between text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">
                <span>Reviews &amp; Corrections</span>
                <span class="material-symbols-outlined text-indigo-600 text-lg">rule</span>
            </div>
            <div>
                <div class="text-2xl font-bold text-slate-900 tracking-tight">
                    <span class="text-emerald-600">@confirmedReviews</span> <span class="text-xs font-medium text-slate-400">ok</span>
                    <span class="text-slate-300 mx-1">/</span>
                    <span class="@(openIssues > 0 ? "text-amber-600" : "text-slate-900")">@openIssues</span> <span class="text-xs font-medium text-slate-400">corr</span>
                </div>
                <div class="text-xs text-slate-400 mt-1 truncate">
                    @pendingReviews Staff Pending • @expiredIssues Expired Issues
                </div>
            </div>
        </div>
    </div>

    <!-- TIMESHEET & REVIEW PROGRESS (Organized in Manager style) -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <!-- 1. Timesheet Source Readiness -->
        <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm">
            <div class="flex items-center justify-between pb-3 mb-3 border-b border-slate-100">
                <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-indigo-600 text-lg">schedule</span>
                    <h2 class="text-xs font-bold text-slate-900 uppercase tracking-wider">1. Timesheet Source Readiness</h2>
                </div>
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold @(Model.LockedTimesheetCount == Model.ExpectedEmployeeCount ? "bg-emerald-50 text-emerald-700 border border-emerald-200" : "bg-amber-50 text-amber-700 border border-amber-200")">
                    @(Model.LockedTimesheetCount == Model.ExpectedEmployeeCount ? "Fully Locked" : "Reviewed / Pending Approval")
                </span>
            </div>

            <div class="grid grid-cols-2 gap-3 text-xs">
                <div class="bg-slate-50/70 p-3 rounded-xl border border-slate-100">
                    <span class="text-slate-500 block mb-1">Timesheets REVIEWED</span>
                    <strong class="text-sm font-bold text-slate-800">@Model.ReviewedTimesheetCount / @Model.ExpectedEmployeeCount staff</strong>
                </div>
                <div class="bg-slate-50/70 p-3 rounded-xl border border-slate-100">
                    <span class="text-slate-500 block mb-1">Timesheets LOCKED</span>
                    <strong class="text-sm font-bold text-slate-800">@Model.LockedTimesheetCount / @Model.ExpectedEmployeeCount staff</strong>
                </div>
            </div>

            <p class="text-[11px] text-slate-400 mt-3">
                Schedule Week: <strong class="text-slate-700 font-semibold">#@(Model.ScheduleWeekId.HasValue ? Model.ScheduleWeekId.Value.ToString() : "—")</strong> • Timesheets are officially locked upon Admin period approval.
            </p>
        </div>

        <!-- 2. Staff Review & Source Corrections -->
        <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm">
            <div class="flex items-center justify-between pb-3 mb-3 border-b border-slate-100">
                <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-indigo-600 text-lg">rate_review</span>
                    <h2 class="text-xs font-bold text-slate-900 uppercase tracking-wider">2. Staff Review &amp; Corrections</h2>
                </div>
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold @(isEligibleToSubmit ? "bg-emerald-50 text-emerald-700 border border-emerald-200" : "bg-amber-50 text-amber-700 border border-amber-200")">
                    @(isEligibleToSubmit ? "Eligible for Admin Submission" : "Pending Requirements")
                </span>
            </div>

            <div class="grid grid-cols-2 gap-3 text-xs">
                <div class="bg-slate-50/70 p-3 rounded-xl border border-slate-100">
                    <span class="text-slate-500 block mb-1">Staff Previews</span>
                    <strong class="text-xs font-bold text-slate-800">
                        <span class="text-emerald-700">@confirmedReviews Confirmed</span> · <span class="text-slate-600">@pendingReviews Pending</span>
                        @if (expiredReviews > 0)
                        {
                            <span class="text-amber-700 block mt-0.5">@expiredReviews Expired</span>
                        }
                    </strong>
                </div>
                <div class="bg-slate-50/70 p-3 rounded-xl border border-slate-100">
                    <span class="text-slate-500 block mb-1">Correction Requests</span>
                    <strong class="text-xs font-bold text-slate-800">
                        <span class="@(openIssues > 0 ? "text-amber-700" : "text-emerald-700")">@openIssues In Progress</span>
                        @if (expiredIssues > 0)
                        {
                            <span class="text-rose-700 block mt-0.5">@expiredIssues Expired</span>
                        }
                    </strong>
                </div>
            </div>

            <p class="text-[11px] text-slate-400 mt-3">
                Review Deadline (UTC+7): <strong class="text-slate-700 font-semibold">@(Model.InitialFeedbackDeadlineAt.HasValue ? D.Time(Model.InitialFeedbackDeadlineAt) : "Previews not sent")</strong>
                @if (expiredIssues > 0)
                {
                    <span class="text-rose-600 font-semibold block mt-1">⚠ @expiredIssues correction request(s) expired. Must resend or complete before submitting.</span>
                }
            </p>
        </div>
    </div>

    <!-- TABS NAVIGATION (Styled like Manager) -->
    <div class="border-b border-slate-200">
        <nav class="flex gap-6" aria-label="Tabs">
            <button type="button" onclick="switchPeriodTab('tab-payrolls', this)"
                    class="tab-btn pb-3 text-sm font-semibold border-b-2 border-indigo-600 text-indigo-600 flex items-center gap-2 cursor-pointer transition-all">
                <span>Employee Payrolls</span>
                <span class="px-2 py-0.5 rounded-full text-xs bg-indigo-50 text-indigo-700 border border-indigo-200 font-bold">@Model.Payrolls.Count</span>
            </button>
            <button type="button" onclick="switchPeriodTab('tab-corrections', this)"
                    class="tab-btn pb-3 text-sm font-medium border-b-2 border-transparent text-slate-500 hover:text-slate-800 flex items-center gap-2 cursor-pointer transition-all">
                <span>Manager Corrections</span>
                <span class="px-2 py-0.5 rounded-full text-xs @(openIssues > 0 ? "bg-amber-50 text-amber-700 border border-amber-200" : "bg-slate-100 text-slate-600") font-bold">
                    @(Model.CorrectionRequests?.Count ?? 0) @(openIssues > 0 ? $"({openIssues} open)" : "")
                </span>
            </button>
            <button type="button" onclick="switchPeriodTab('tab-feedbacks', this)"
                    class="tab-btn pb-3 text-sm font-medium border-b-2 border-transparent text-slate-500 hover:text-slate-800 flex items-center gap-2 cursor-pointer transition-all">
                <span>Staff Previews &amp; Feedback</span>
                <span class="px-2 py-0.5 rounded-full text-xs @(pendingReviews > 0 ? "bg-amber-50 text-amber-700 border border-amber-200" : "bg-slate-100 text-slate-600") font-bold">
                    @(Model.Feedbacks?.Count ?? 0) @(pendingReviews > 0 ? $"({pendingReviews} pending)" : "")
                </span>
            </button>
        </nav>
    </div>

    <!-- TAB 1: EMPLOYEE PAYROLLS TABLE -->
    <div id="tab-payrolls" class="tab-content">
        <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden">
            <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between bg-slate-50/60">
                <div class="flex items-center gap-2.5">
                    <span class="material-symbols-outlined text-indigo-600 text-xl">group</span>
                    <h2 class="text-sm font-bold text-slate-900">Current Employee Payrolls</h2>
                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold bg-indigo-50 text-indigo-700 border border-indigo-200">
                        @Model.Payrolls.Count @(Model.Payrolls.Count == 1 ? "Record" : "Records")
                    </span>
                </div>
            </div>

            @if (Model.Payrolls.Count == 0)
            {
                <div class="p-12 text-center">
                    <div class="w-14 h-14 bg-slate-100 rounded-2xl flex items-center justify-center mx-auto mb-4 text-slate-400">
                        <span class="material-symbols-outlined text-3xl">receipt_long</span>
                    </div>
                    <h3 class="text-base font-bold text-slate-900">No Payrolls Calculated Yet</h3>
                    <p class="text-xs text-slate-500 max-w-sm mx-auto mt-1">Open this period and proceed to the Calculation Workspace to run the initial calculation for all employees.</p>
                </div>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="border-b border-slate-150 bg-slate-50/50 text-[11px] font-bold text-slate-500 uppercase tracking-wider">
                                <th class="py-3.5 px-6">Employee / Version</th>
                                <th class="py-3.5 px-6">Work Hours</th>
                                <th class="py-3.5 px-6 text-right">Work Pay</th>
                                <th class="py-3.5 px-6 text-right">Adjustments</th>
                                <th class="py-3.5 px-6 text-right">Net Salary</th>
                                <th class="py-3.5 px-6">Status</th>
                                <th class="py-3.5 px-6 text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 text-sm">
                            @foreach (var p in Model.Payrolls)
                            {
                                var hasCorrection = Model.CorrectionRequests?.Any(c => c.PayrollId == p.PayrollId) == true;
                                <tr class="hover:bg-slate-50/80 transition-colors">
                                    <!-- Employee / Version -->
                                    <td class="py-4 px-6">
                                        <div class="flex items-center gap-3">
                                            <div class="w-9 h-9 rounded-xl bg-indigo-50 border border-indigo-100 flex items-center justify-center font-bold text-xs text-indigo-700 shrink-0">
                                                @(string.IsNullOrWhiteSpace(p.EmployeeFullName) ? "?" : p.EmployeeFullName.Trim()[..1])
                                            </div>
                                            <div>
                                                <div class="font-semibold text-slate-900">@p.EmployeeFullName</div>
                                                <div class="text-xs text-slate-400 mt-0.5">
                                                    @(p.EmployeePosition ?? "Employee") • @D.Money(p.HourlyRate)/h • Payroll #@p.PayrollId · V@(p.VersionNo)
                                                </div>
                                            </div>
                                        </div>
                                    </td>

                                    <!-- Work Hours -->
                                    <td class="py-4 px-6 font-medium text-slate-800">
                                        @p.TotalWorkHours.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) h
                                    </td>

                                    <!-- Work Pay -->
                                    <td class="py-4 px-6 text-right font-medium text-slate-800">
                                        @D.Money(p.WorkPay)
                                    </td>

                                    <!-- Adjustments -->
                                    <td class="py-4 px-6 text-right text-xs">
                                        @if (p.TotalReward > 0)
                                        {
                                            <span class="font-semibold text-emerald-600 block">+@D.Money(p.TotalReward)</span>
                                        }
                                        @if (p.TotalDeduction > 0)
                                        {
                                            <span class="font-semibold text-rose-600 block">-@D.Money(p.TotalDeduction)</span>
                                        }
                                        @if (p.CarryForwardDeduction > 0)
                                        {
                                            <span class="text-[11px] text-slate-400 block">CF: -@D.Money(p.CarryForwardDeduction)</span>
                                        }
                                        @if (p.TotalReward == 0 && p.TotalDeduction == 0)
                                        {
                                            <span class="text-slate-400">—</span>
                                        }
                                    </td>

                                    <!-- Net Salary -->
                                    <td class="py-4 px-6 text-right">
                                        <strong class="font-bold text-slate-900 text-sm">@D.Money(p.NetSalary)</strong>
                                    </td>

                                    <!-- Status -->
                                    <td class="py-4 px-6">
                                        @if (p.Status == "CALCULATED")
                                        {
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-sky-50 text-sky-700 border border-sky-200">
                                                CALCULATED
                                            </span>
                                        }
                                        else if (p.Status == "REJECTED")
                                        {
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-rose-50 text-rose-700 border border-rose-200">
                                                REJECTED
                                            </span>
                                        }
                                        else if (p.Status == "APPROVED")
                                        {
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                                                APPROVED
                                            </span>
                                        }
                                        else if (p.Status == "PAID")
                                        {
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-teal-50 text-teal-700 border border-teal-200">
                                                PAID
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-slate-100 text-slate-700 border border-slate-200">
                                                @p.Status.Replace('_', ' ')
                                            </span>
                                        }
                                    </td>

                                    <!-- Actions -->
                                    <td class="py-4 px-6 text-right">
                                        <div class="inline-flex items-center gap-1.5 justify-end">
                                            <a asp-controller="AccountantPayrollCalculation" asp-action="Details" asp-route-id="@p.PayrollId"
                                               class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold transition-all">
                                                <span class="material-symbols-outlined text-sm">visibility</span>
                                                <span>Details</span>
                                            </a>
                                            @if (p.Status == "REJECTED" || isRevisionRequired || hasCorrection)
                                            {
                                                <a asp-controller="AccountantPayrollRevision" asp-action="Review" asp-route-id="@p.PayrollId"
                                                   class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-indigo-50 hover:bg-indigo-100 text-indigo-700 text-xs font-semibold transition-all"
                                                   title="Review or create correction for this payroll">
                                                    <span class="material-symbols-outlined text-sm">rate_review</span>
                                                    <span>Review</span>
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- TAB 2: MANAGER CORRECTION REQUESTS -->
    <div id="tab-corrections" class="tab-content hidden">
        <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden">
            <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between bg-slate-50/60">
                <div class="flex items-center gap-2.5">
                    <span class="material-symbols-outlined text-indigo-600 text-xl">build_circle</span>
                    <h2 class="text-sm font-bold text-slate-900">Manager Source Correction Requests</h2>
                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold bg-indigo-50 text-indigo-700 border border-indigo-200">
                        @(Model.CorrectionRequests?.Count ?? 0) @((Model.CorrectionRequests?.Count ?? 0) == 1 ? "Request" : "Requests")
                    </span>
                </div>
            </div>

            @if (Model.CorrectionRequests == null || Model.CorrectionRequests.Count == 0)
            {
                <div class="p-12 text-center">
                    <div class="w-14 h-14 bg-slate-100 rounded-2xl flex items-center justify-center mx-auto mb-4 text-slate-400">
                        <span class="material-symbols-outlined text-3xl">task_alt</span>
                    </div>
                    <h3 class="text-base font-bold text-slate-900">No Correction Requests</h3>
                    <p class="text-xs text-slate-500 max-w-sm mx-auto mt-1">No source correction requests have been created for this period.</p>
                </div>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="border-b border-slate-150 bg-slate-50/50 text-[11px] font-bold text-slate-500 uppercase tracking-wider">
                                <th class="py-3.5 px-6">Request ID</th>
                                <th class="py-3.5 px-6">Employee</th>
                                <th class="py-3.5 px-6">Status</th>
                                <th class="py-3.5 px-6">Deadline (UTC+7)</th>
                                <th class="py-3.5 px-6">Manager Action</th>
                                <th class="py-3.5 px-6">Accountant Reason</th>
                                <th class="py-3.5 px-6 text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 text-sm">
                            @foreach (var c in Model.CorrectionRequests)
                            {
                                <tr class="hover:bg-slate-50/80 transition-colors">
                                    <td class="py-4 px-6 font-semibold text-slate-900">
                                        <span class="inline-flex items-center gap-1 font-mono text-xs text-slate-700 bg-slate-100 px-2 py-1 rounded-lg">
                                            #@c.CorrectionRequestId
                                        </span>
                                        <div class="text-xs text-slate-400 mt-1">Payroll #@c.PayrollId</div>
                                        @if (c.ResolvedPayrollId.HasValue)
                                        {
                                            <div class="text-[11px] text-emerald-700 font-medium">Resolved: #@c.ResolvedPayrollId</div>
                                        }
                                    </td>
                                    <td class="py-4 px-6 font-semibold text-slate-900">
                                        @c.EmployeeName
                                    </td>
                                    <td class="py-4 px-6">
                                        @if (c.Status == "OPEN")
                                        {
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-amber-50 text-amber-700 border border-amber-200">
                                                OPEN
                                            </span>
                                        }
                                        else if (c.Status == "RESPONDED")
                                        {
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-indigo-50 text-indigo-700 border border-indigo-200">
                                                RESPONDED
                                            </span>
                                        }
                                        else if (c.Status == "EXPIRED")
                                        {
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-rose-50 text-rose-700 border border-rose-200">
                                                EXPIRED
                                            </span>
                                        }
                                        else if (c.Status == "COMPLETED")
                                        {
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                                                COMPLETED
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-slate-100 text-slate-700 border border-slate-200">
                                                @c.Status
                                            </span>
                                        }
                                    </td>
                                    <td class="py-4 px-6 text-xs text-slate-600">
                                        <div>@D.Time(c.ResponseDeadlineAt)</div>
                                        @if (c.Status == "EXPIRED" && c.ExpiredAt.HasValue)
                                        {
                                            <div class="text-rose-600 font-semibold text-[11px]">Expired: @D.Time(c.ExpiredAt)</div>
                                        }
                                    </td>
                                    <td class="py-4 px-6 text-xs">
                                        @if (!string.IsNullOrEmpty(c.ManagerAction))
                                        {
                                            <span class="font-bold @(c.ManagerAction == "CORRECT" ? "text-indigo-600" : "text-amber-600")">
                                                @c.ManagerAction
                                            </span>
                                            @if (!string.IsNullOrEmpty(c.ManagerNote))
                                            {
                                                <p class="text-slate-500 text-[11px] mt-0.5 line-clamp-1" title="@c.ManagerNote">@c.ManagerNote</p>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-slate-400">—</span>
                                        }
                                    </td>
                                    <td class="py-4 px-6 text-xs text-slate-700 max-w-xs">
                                        <p class="line-clamp-2" title="@c.Reason">@c.Reason</p>
                                    </td>
                                    <td class="py-4 px-6 text-right">
                                        <a asp-controller="AccountantPayrollRevision" asp-action="Review" asp-route-id="@c.PayrollId"
                                           class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg @(c.Status == "EXPIRED" ? "bg-rose-600 hover:bg-rose-700 text-white" : "bg-slate-100 hover:bg-slate-200 text-slate-700") text-xs font-semibold transition-all">
                                            <span class="material-symbols-outlined text-sm">@(c.Status == "EXPIRED" ? "send" : "visibility")</span>
                                            <span>@(c.Status == "EXPIRED" ? "Resend to Manager" : "Review")</span>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- TAB 3: STAFF PREVIEWS & FEEDBACK -->
    <div id="tab-feedbacks" class="tab-content hidden">
        <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden">
            <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between bg-slate-50/60">
                <div class="flex items-center gap-2.5">
                    <span class="material-symbols-outlined text-indigo-600 text-xl">mark_email_read</span>
                    <h2 class="text-sm font-bold text-slate-900">Staff Previews &amp; Feedback</h2>
                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold bg-indigo-50 text-indigo-700 border border-indigo-200">
                        @(Model.Feedbacks?.Count ?? 0) @((Model.Feedbacks?.Count ?? 0) == 1 ? "Round" : "Rounds")
                    </span>
                </div>
            </div>

            @if (Model.Feedbacks == null || Model.Feedbacks.Count == 0)
            {
                <div class="p-12 text-center">
                    <div class="w-14 h-14 bg-slate-100 rounded-2xl flex items-center justify-center mx-auto mb-4 text-slate-400">
                        <span class="material-symbols-outlined text-3xl">send</span>
                    </div>
                    <h3 class="text-base font-bold text-slate-900">No Previews Sent Yet</h3>
                    <p class="text-xs text-slate-500 max-w-sm mx-auto mt-1">Click "Send Previews to Staff" above to distribute payroll previews for employee verification.</p>
                </div>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="border-b border-slate-150 bg-slate-50/50 text-[11px] font-bold text-slate-500 uppercase tracking-wider">
                                <th class="py-3.5 px-6">Feedback / Round</th>
                                <th class="py-3.5 px-6">Employee</th>
                                <th class="py-3.5 px-6">Review Status</th>
                                <th class="py-3.5 px-6">Feedback Status</th>
                                <th class="py-3.5 px-6">Deadline (UTC+7)</th>
                                <th class="py-3.5 px-6">Description</th>
                                <th class="py-3.5 px-6 text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 text-sm">
                            @foreach (var fb in Model.Feedbacks)
                            {
                                <tr class="hover:bg-slate-50/80 transition-colors">
                                    <td class="py-4 px-6 font-semibold text-slate-900">
                                        <span class="inline-flex items-center gap-1 font-mono text-xs text-slate-700 bg-slate-100 px-2 py-1 rounded-lg">
                                            #@fb.FeedbackId
                                        </span>
                                        <div class="text-xs text-slate-400 mt-1">Round @fb.RoundNo • Payroll #@fb.PayrollId</div>
                                    </td>
                                    <td class="py-4 px-6 font-semibold text-slate-900">
                                        @fb.EmployeeName
                                    </td>
                                    <td class="py-4 px-6">
                                        @if (fb.ReviewStatus == "PENDING")
                                        {
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-amber-50 text-amber-700 border border-amber-200">
                                                PENDING
                                            </span>
                                        }
                                        else if (fb.ReviewStatus == "CONFIRMED")
                                        {
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                                                CONFIRMED
                                            </span>
                                        }
                                        else if (fb.ReviewStatus == "EXPIRED")
                                        {
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-slate-100 text-slate-700 border border-slate-200">
                                                EXPIRED
                                            </span>
                                            <span class="text-[10px] text-slate-400 block mt-0.5">Deemed agreed</span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-slate-100 text-slate-700 border border-slate-200">
                                                @fb.ReviewStatus
                                            </span>
                                        }
                                    </td>
                                    <td class="py-4 px-6">
                                        @if (!string.IsNullOrEmpty(fb.Status))
                                        {
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-slate-100 text-slate-700 border border-slate-200">
                                                @fb.Status
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-slate-400 text-xs">—</span>
                                        }
                                    </td>
                                    <td class="py-4 px-6 text-xs text-slate-600">
                                        @D.Time(fb.ReviewDeadlineAt)
                                    </td>
                                    <td class="py-4 px-6 text-xs text-slate-700 max-w-xs">
                                        <p class="line-clamp-2" title="@fb.Description">@(string.IsNullOrWhiteSpace(fb.Description) ? "No remarks submitted" : fb.Description)</p>
                                    </td>
                                    <td class="py-4 px-6 text-right">
                                        <a asp-controller="AccountantPayrollFeedback" asp-action="Index" asp-route-payrollPeriodId="@Model.PayrollPeriodId" asp-route-userId="@fb.UserId"
                                           class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold transition-all">
                                            <span class="material-symbols-outlined text-sm">visibility</span>
                                            <span>Details</span>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- MODAL: SEND PREVIEWS (Centered WorkShift Modal Style) -->
<div id="modalSendPreviews" class="fixed inset-0 z-50 hidden overflow-y-auto" role="dialog" aria-modal="true" aria-labelledby="modal-send-previews-title">
    <div class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs transition-opacity" onclick="closeModal('modalSendPreviews')"></div>
    <div class="flex min-h-full items-center justify-center p-4 text-center">
        <div class="relative transform overflow-hidden rounded-2xl bg-white text-left shadow-2xl transition-all sm:my-8 sm:w-full sm:max-w-lg border border-slate-200">
            <form asp-action="SendPreviews" asp-route-id="@Model.PayrollPeriodId" method="post" onsubmit="return preventDoubleSubmit(this)">
                @Html.AntiForgeryToken()
                <div class="p-6">
                    <div class="flex items-center gap-4 mb-4">
                        <div class="w-12 h-12 rounded-2xl bg-indigo-50 border border-indigo-100 flex items-center justify-center text-indigo-600 shrink-0">
                            <span class="material-symbols-outlined text-2xl">send</span>
                        </div>
                        <div>
                            <h3 class="text-lg font-bold text-slate-900" id="modal-send-previews-title">Send Payroll Previews</h3>
                            <p class="text-xs text-slate-500">Period: @Model.PeriodCode • @Model.Payrolls.Count active payrolls</p>
                        </div>
                    </div>

                    <p class="text-xs text-slate-600 mb-4">
                        Send current payroll previews to employees for review.
                    </p>

                    <div class="mb-2">
                        <label for="initialFeedbackDeadlineAt" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">
                            Review Deadline (Optional, UTC+7)
                        </label>
                        <input type="datetime-local" id="initialFeedbackDeadlineAt" name="initialFeedbackDeadlineAt"
                               class="w-full h-11 px-3.5 bg-slate-50/50 hover:bg-white focus:bg-white border border-slate-200 rounded-xl text-sm text-slate-900 focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 transition-all box-border" />
                        <p class="text-[11px] text-slate-400 mt-1.5">
                            Leave blank to use the standard 24-hour review window from submission time. Or specify a custom deadline.
                        </p>
                    </div>
                </div>

                <div class="px-6 py-4 bg-slate-50 border-t border-slate-100 flex items-center justify-end gap-3">
                    <button type="button" onclick="closeModal('modalSendPreviews')"
                            class="px-4 py-2.5 rounded-xl bg-white hover:bg-slate-100 text-slate-700 border border-slate-200 text-sm font-semibold transition-all shadow-xs cursor-pointer">
                        Cancel
                    </button>
                    <button type="submit"
                            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 active:bg-indigo-800 text-white text-sm font-semibold shadow-sm transition-all cursor-pointer">
                        <span class="material-symbols-outlined text-sm">send</span>
                        <span>Send Previews</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL: SUBMIT PERIOD (Centered WorkShift Modal Style) -->
<div id="modalSubmitPeriod" class="fixed inset-0 z-50 hidden overflow-y-auto" role="dialog" aria-modal="true" aria-labelledby="modal-submit-period-title">
    <div class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs transition-opacity" onclick="closeModal('modalSubmitPeriod')"></div>
    <div class="flex min-h-full items-center justify-center p-4 text-center">
        <div class="relative transform overflow-hidden rounded-2xl bg-white text-left shadow-2xl transition-all sm:my-8 sm:w-full sm:max-w-lg border border-slate-200">
            <form asp-action="SubmitPeriod" asp-route-id="@Model.PayrollPeriodId" method="post" onsubmit="return preventDoubleSubmit(this)">
                @Html.AntiForgeryToken()
                <div class="p-6">
                    <div class="flex items-center gap-4 mb-4">
                        <div class="w-12 h-12 rounded-2xl bg-indigo-50 border border-indigo-100 flex items-center justify-center text-indigo-600 shrink-0">
                            <span class="material-symbols-outlined text-2xl">publish</span>
                        </div>
                        <div>
                            <h3 class="text-lg font-bold text-slate-900" id="modal-submit-period-title">Submit Payroll Period</h3>
                            <p class="text-xs text-slate-500">Submit this payroll period to Admin for final approval?</p>
                        </div>
                    </div>

                    <div class="grid grid-cols-3 gap-3 p-3.5 rounded-xl bg-slate-50 border border-slate-200 text-xs mb-4">
                        <div>
                            <span class="text-slate-400 block mb-0.5">Period Code</span>
                            <strong class="text-slate-800 font-bold">@Model.PeriodCode</strong>
                        </div>
                        <div>
                            <span class="text-slate-400 block mb-0.5">Payrolls</span>
                            <strong class="text-slate-800 font-bold">@Model.Payrolls.Count</strong>
                        </div>
                        <div>
                            <span class="text-slate-400 block mb-0.5">Total Net</span>
                            <strong class="text-emerald-700 font-bold">@D.Money(Model.TotalNetSalary)</strong>
                        </div>
                    </div>

                    <div class="p-3.5 rounded-xl bg-amber-50 border border-amber-200 text-xs text-amber-900 flex items-start gap-2.5">
                        <span class="material-symbols-outlined text-amber-600 text-base shrink-0 mt-0.5">warning</span>
                        <span>All required payroll reviews and corrections must be completed before submission.</span>
                    </div>
                </div>

                <div class="px-6 py-4 bg-slate-50 border-t border-slate-100 flex items-center justify-end gap-3">
                    <button type="button" onclick="closeModal('modalSubmitPeriod')"
                            class="px-4 py-2.5 rounded-xl bg-white hover:bg-slate-100 text-slate-700 border border-slate-200 text-sm font-semibold transition-all shadow-xs cursor-pointer">
                        Cancel
                    </button>
                    <button type="submit"
                            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 active:bg-indigo-800 text-white text-sm font-semibold shadow-sm transition-all cursor-pointer">
                        <span class="material-symbols-outlined text-sm">check</span>
                        <span>Confirm Submission</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openModal(id) {
            const modal = document.getElementById(id);
            if (modal) {
                modal.classList.remove('hidden');
                document.body.style.overflow = 'hidden';
            }
        }
        function closeModal(id) {
            const modal = document.getElementById(id);
            if (modal) {
                modal.classList.add('hidden');
                document.body.style.overflow = '';
            }
        }
        function preventDoubleSubmit(form) {
            if (form.dataset.submitting === 'true') return false;
            form.dataset.submitting = 'true';
            const btn = form.querySelector('button[type="submit"]');
            if (btn) {
                btn.disabled = true;
                btn.classList.add('opacity-75', 'cursor-not-allowed');
            }
            return true;
        }
        function switchPeriodTab(tabId, btn) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            document.querySelectorAll('.tab-btn').forEach(el => {
                el.classList.remove('border-indigo-600', 'text-indigo-600');
                el.classList.add('border-transparent', 'text-slate-500');
            });
            const target = document.getElementById(tabId);
            if (target) target.classList.remove('hidden');
            btn.classList.add('border-indigo-600', 'text-indigo-600');
            btn.classList.remove('border-transparent', 'text-slate-500');
        }
    </script>
}
