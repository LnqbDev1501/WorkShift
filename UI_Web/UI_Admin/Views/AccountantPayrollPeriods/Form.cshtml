@model UI_Admin.Models.Accountant.PayrollPeriods.PeriodForm
@{
    var edit = Model.Id > 0;
    ViewData["Title"] = edit ? "Edit Draft Payroll Period" : "Create Payroll Period";
}

<div class="ws-form-page px-4 sm:px-6 py-6">
    <div class="ws-form-container max-w-5xl mx-auto space-y-6">
        <!-- Header Title & Action Bar -->
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div>
                <div class="flex items-center gap-1.5 text-xs text-indigo-600 font-semibold uppercase tracking-wider mb-1">
                    <span class="material-symbols-outlined text-sm">calendar_month</span>
                    <span>Payroll / Period Management</span>
                </div>
                <h1 class="text-2xl font-bold text-slate-900 tracking-tight">@ViewData["Title"]</h1>
                <p class="text-sm text-slate-500 mt-0.5">
                    Select an approved work schedule week to generate a new payroll period. The branch, dates, and code will be configured automatically.
                </p>
            </div>
            <div class="flex items-center gap-3">
                <a asp-action="@(edit ? "Details" : "Index")" asp-route-id="@(edit ? Model.Id : (int?)null)"
                   class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-white hover:bg-slate-50 text-slate-700 hover:text-slate-900 border border-slate-200 text-sm font-medium transition-all shadow-sm"
                   title="Cancel">
                    <span class="material-symbols-outlined text-lg">close</span>
                    <span>Cancel</span>
                </a>
            </div>
        </div>

        <!-- Form Card -->
        <div class="bg-white border border-slate-200 rounded-2xl p-6 sm:p-8 shadow-sm">
            <form method="post" asp-action="@(edit ? "Edit" : "Create")" asp-route-id="@(edit ? Model.Id : (int?)null)" class="space-y-6">
                <input asp-for="Id" type="hidden" />

                @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
                {
                    <div asp-validation-summary="All" class="p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-sm mb-4" role="alert"></div>
                }

                <!-- Period Name -->
                <div>
                    <label asp-for="PeriodName" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">
                        Period Name <span class="text-rose-500">*</span>
                    </label>
                    <input asp-for="PeriodName" maxlength="200" required placeholder="e.g. Payroll Period Week 42 (Oct 2026)"
                           class="w-full h-11 px-3.5 bg-slate-50/50 hover:bg-white focus:bg-white border border-slate-200 rounded-xl text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 transition-all box-border" />
                    <span asp-validation-for="PeriodName" class="text-rose-600 text-xs mt-1 block"></span>
                </div>

                <!-- Schedule Week -->
                <div>
                    <label asp-for="ScheduleWeekId" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">
                        Work Schedule Week <span class="text-rose-500">*</span>
                    </label>
                    <select asp-for="ScheduleWeekId" required
                            class="w-full h-11 px-3.5 bg-slate-50/50 hover:bg-white focus:bg-white border border-slate-200 rounded-xl text-sm text-slate-800 focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 transition-all cursor-pointer box-border">
                        <option value="">Select a schedule week</option>
                        @foreach (var w in Model.Weeks)
                        {
                            <option value="@w.ScheduleWeekId">@w.WeekStartDate.ToString("dd/MM/yyyy") – @w.WeekEndDate.ToString("dd/MM/yyyy") · Week #@w.ScheduleWeekId · @w.Status</option>
                        }
                    </select>
                    <span asp-validation-for="ScheduleWeekId" class="text-rose-600 text-xs mt-1 block"></span>
                </div>

                @if (Model.WeeksLoaded && Model.Weeks.Count == 0)
                {
                    <div class="p-4 rounded-xl bg-amber-50 border border-amber-200 text-amber-800 text-xs flex items-center gap-2">
                        <span class="material-symbols-outlined text-base text-amber-600">info</span>
                        <span>No eligible work schedule weeks available. Schedule weeks must be approved and not already linked to an active payroll period.</span>
                    </div>
                }

                <div class="p-4 rounded-xl bg-slate-50 border border-slate-100 text-xs text-slate-600 leading-relaxed">
                    A newly created period starts in <strong class="text-slate-800">DRAFT</strong> status. You can edit or delete draft periods at any time. Once published (<strong class="text-slate-800">DRAFT → OPEN</strong>), configuration is locked and calculation becomes available.
                </div>

                <div class="flex items-center gap-3 pt-2">
                    <button type="submit" disabled="@(!Model.WeeksLoaded || Model.Weeks.Count == 0)"
                            class="inline-flex items-center gap-2 px-6 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 active:bg-indigo-800 text-white text-sm font-semibold shadow-sm transition-all cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed">
                        <span class="material-symbols-outlined text-base">save</span>
                        <span>@(edit ? "Save Changes" : "Create Draft Period")</span>
                    </button>
                    <a asp-action="@(edit ? "Details" : "Index")" asp-route-id="@(edit ? Model.Id : (int?)null)"
                       class="px-4 py-2.5 rounded-xl bg-white hover:bg-slate-100 text-slate-700 border border-slate-200 text-sm font-semibold transition-all shadow-xs cursor-pointer">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
