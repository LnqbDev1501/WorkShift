@model UI_Admin.Models.Accountant.SalaryHistory.SalaryHistoryItem
@using D = UI_Admin.Models.Accountant.SalaryHistory.SalaryHistoryDisplay
@{ ViewData["Title"] = "Salary Change Details"; }
<div class="flex flex-col w-full gap-unit-4 px-7 py-6 mx-auto" style="max-width: 1496px;">
    <div class="flex items-center">
        <a asp-action="Index" class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-white hover:bg-slate-50 text-slate-700 font-semibold text-sm transition-all border border-slate-200 shadow-sm">
            <span class="material-symbols-outlined text-[18px]">arrow_back</span>
            <span>Back to history</span>
        </a>
    </div>
    <div class="form-heading flex flex-wrap justify-between items-center gap-4"><div><div class="list-eyebrow">Payroll · Salary Records</div><h1 class="text-display-lg font-display-lg">Salary Change Details</h1><p>@Model.EmployeeFullName · Record #@Model.SalaryHistoryId</p></div></div>
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-unit-4">
        <section class="bg-surface-container-lowest rounded-xl shadow-sm p-unit-5 lg:col-span-2">
            <div class="flex justify-between items-center mb-5"><h2 class="text-title-md font-semibold">Salary Information</h2><span class="rounded-full px-3 py-1 text-xs font-semibold @D.Badge(Model.Status)">@D.Label(Model.Status)</span></div>
            <dl class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div><dt class="text-label-md text-secondary">Employee</dt><dd class="font-semibold mt-1">@Model.EmployeeFullName</dd><dd class="text-xs text-secondary break-all">@Model.UserId</dd></div>
                <div><dt class="text-label-md text-secondary">Change type</dt><dd class="mt-1">@D.Label(Model.ChangeType)</dd></div>
                <div><dt class="text-label-md text-secondary">Previous hourly rate</dt><dd class="text-title-md mt-1">@D.Money(Model.PreviousHourlyRate)</dd></div>
                <div><dt class="text-label-md text-secondary">Hourly rate</dt><dd class="text-title-md font-semibold text-primary mt-1">@D.Money(Model.HourlyRate) / hour</dd></div>
                <div><dt class="text-label-md text-secondary">Effective from</dt><dd class="mt-1">@D.Date(Model.EffectiveFrom)</dd></div>
                <div><dt class="text-label-md text-secondary">Effective to</dt><dd class="mt-1">@D.Date(Model.EffectiveTo)</dd></div>
                <div class="sm:col-span-2"><dt class="text-label-md text-secondary">Reason</dt><dd class="mt-1 whitespace-pre-wrap break-words">@(string.IsNullOrWhiteSpace(Model.Reason) ? "No reason recorded." : Model.Reason)</dd></div>
            </dl>
            <a asp-action="Index" asp-route-userId="@Model.UserId" class="inline-flex items-center gap-2 mt-6 text-primary hover:underline"><span class="material-symbols-outlined text-[18px]">history</span>View this employee's salary history</a>
        </section>
        <section class="bg-surface-container-lowest rounded-xl shadow-sm p-unit-5"><h2 class="text-title-md font-semibold mb-5">Record History</h2><dl class="space-y-5">
            <div><dt class="text-label-md text-secondary">Created by</dt><dd class="mt-1">@Model.CreatedByFullName</dd><dd class="text-xs text-secondary break-all">@Model.CreatedBy</dd></div>
            <div><dt class="text-label-md text-secondary">Created at (UTC+7)</dt><dd class="mt-1">@DateTime.SpecifyKind(Model.CreatedAt, DateTimeKind.Utc).AddHours(7).ToString("dd/MM/yyyy HH:mm")</dd></div>
            <div><dt class="text-label-md text-secondary">Salary increase request</dt><dd class="mt-1">@(Model.SalaryIncreaseRequestId.HasValue ? "#" + Model.SalaryIncreaseRequestId : "—")</dd></div>
        </dl></section>
    </div>
    <section class="bg-surface-container-lowest rounded-xl shadow-sm p-unit-5"><h2 class="text-title-md font-semibold mb-5">Related Employment Contract</h2><dl class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        <div><dt class="text-label-md text-secondary">Contract number</dt><dd class="mt-1">@Model.Contract.ContractNumber <span class="text-xs text-secondary">#@Model.Contract.ContractId</span></dd></div>
        <div><dt class="text-label-md text-secondary">Branch</dt><dd class="mt-1">@Model.Contract.BranchName</dd></div>
        <div><dt class="text-label-md text-secondary">Position</dt><dd class="mt-1">@Model.Contract.EmployeePosition</dd></div>
        <div><dt class="text-label-md text-secondary">Start date</dt><dd class="mt-1">@D.Date(Model.Contract.StartDate)</dd></div>
        <div><dt class="text-label-md text-secondary">End date</dt><dd class="mt-1">@D.Date(Model.Contract.EndDate)</dd></div>
        <div><dt class="text-label-md text-secondary">Contract status</dt><dd class="mt-1">@D.Label(Model.Contract.Status)</dd></div>
    </dl></section>
</div>
