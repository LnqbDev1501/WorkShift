@model UI_Admin.Models.Accountant.SalaryHistory.SalaryHistoryListViewModel
@using D = UI_Admin.Models.Accountant.SalaryHistory.SalaryHistoryDisplay
@{ ViewData["Title"] = "Salary History"; }
<div class="flex flex-col w-full gap-unit-4 px-7 py-4">
    <div class="form-heading"><div class="list-eyebrow">Payroll · Salary Records</div><h1 class="text-display-lg font-display-lg text-on-surface">Salary History</h1><p>Review employee hourly rates and salary changes in your branch.</p></div>
    @if (Model.ErrorMessage != null || TempData["SalaryHistoryError"] is string)
    { <div role="alert" class="rounded-xl bg-red-50 text-red-700 p-unit-4">@(Model.ErrorMessage ?? TempData["SalaryHistoryError"]?.ToString()) <a asp-action="Index" asp-all-route-data="@(Context.Request.Query.ToDictionary(q => q.Key, q => q.Value.ToString()))" class="underline ml-2">Retry</a></div> }
    <partial name="_ListMetrics" model='@(new ListMetricViewModel[] {
        new("Matching Records", Model.TotalItems.ToString("N0"), "Matching current filters", "history", "#8b5cf6"),
        new("Active", Model.Items.Count(i => i.Status == "ACTIVE").ToString(), "On this page", "check_circle", "#10b981"),
        new("Scheduled", Model.Items.Count(i => i.Status == "SCHEDULED").ToString(), "On this page", "schedule", "#4f46e5"),
        new("Employees", Model.Items.Select(i => i.UserId).Distinct().Count().ToString(), "On this page", "groups", "#4f46e5")
    })' />
    <form asp-action="Index" method="get" class="ws-list-filter" role="search">
        <div class="ws-filter-row">
            <label class="ws-filter-field ws-filter-keyword"><span class="material-symbols-outlined" aria-hidden="true">search</span><input aria-label="Search" id="Keyword" name="Keyword" value="@Model.Query.Keyword" maxlength="200" placeholder="Search employees..." /></label>
            <div class="ws-filter-field"><select aria-label="Status" id="Status" name="Status"><option value="">All statuses</option>@foreach (var value in new[] { "SCHEDULED", "ACTIVE", "INACTIVE" }) { <option value="@value" selected="@(Model.Query.Status == value)">@D.Label(value)</option> }</select></div>
            <div class="ws-filter-field"><select aria-label="Change type" id="ChangeType" name="ChangeType"><option value="">All changes</option>@foreach (var value in new[] { "INITIAL", "INCREASE", "DECREASE" }) { <option value="@value" selected="@(Model.Query.ChangeType == value)">@D.Label(value)</option> }</select></div>
            <details class="ws-filter-advanced">
                <summary title="Advanced filters" aria-label="Advanced filters"><span class="material-symbols-outlined" aria-hidden="true">tune</span>
                    @if (Context.Request.Query.Any(q => new[] { "EffectiveFrom", "EffectiveTo", "UserId" }.Contains(q.Key, StringComparer.OrdinalIgnoreCase) && !string.IsNullOrWhiteSpace(q.Value.ToString()))) { <span class="ws-filter-indicator" aria-label="Advanced filters active"></span> }
                </summary>
                <div class="ws-filter-panel">
                    <label class="ws-filter-field"><span>Effective from</span><input aria-label="Effective from" id="EffectiveFrom" name="EffectiveFrom" type="date" value="@Model.Query.EffectiveFrom?.ToString("yyyy-MM-dd")" /></label>
                    <label class="ws-filter-field"><span>Effective to</span><input aria-label="Effective to" id="EffectiveTo" name="EffectiveTo" type="date" value="@Model.Query.EffectiveTo?.ToString("yyyy-MM-dd")" /></label>
                    <label class="ws-filter-field"><span>Staff ID</span><input aria-label="Staff ID" id="UserId" name="UserId" value="@Model.Query.UserId" placeholder="Staff ID" /></label>
                    <p class="ws-filter-help">Shows salary records whose effective period overlaps the selected dates.</p>
                    <button type="submit" class="ws-filter-apply">Apply filters</button>
                </div>
            </details>
            <partial name="_ListFilterActions" model='"Index"' />
        </div>
        <div asp-validation-summary="All" class="text-red-700 text-body-md" role="alert"></div>
    </form>
    <div class="bg-surface-container-lowest rounded-xl shadow-sm overflow-hidden">
        <div class="overflow-x-auto"><table class="w-full text-left">
            <thead><tr class="bg-surface-container-low text-secondary text-label-md uppercase"><th scope="col" class="px-5 py-3">Employee</th><th scope="col" class="px-4 py-3">Previous rate</th><th scope="col" class="px-4 py-3">Hourly rate</th><th scope="col" class="px-4 py-3">Change</th><th scope="col" class="px-4 py-3">Effective period</th><th scope="col" class="px-4 py-3">Status</th><th scope="col" class="px-5 py-3 text-right">Details</th></tr></thead>
            <tbody>
                @if (Model.Items.Count == 0)
                { <tr><td colspan="7" class="px-5 py-12 text-center text-secondary">@(Model.ErrorMessage != null ? "Salary history could not be loaded." : !ViewData.ModelState.IsValid ? "Please correct the filters above." : "No salary records match your filters.")</td></tr> }
                @foreach (var row in Model.Items)
                {
                    <tr class="h-[64px] hover:bg-surface-container-low transition-colors border-b border-surface-container-low">
                        <td class="px-5 py-3"><span class="font-semibold">@row.EmployeeFullName</span><div class="text-xs text-secondary">@row.Contract.BranchName · @row.Contract.EmployeePosition</div></td>
                        <td class="px-4 py-3 whitespace-nowrap text-secondary">@D.Money(row.PreviousHourlyRate)</td><td class="px-4 py-3 whitespace-nowrap font-semibold text-primary">@D.Money(row.HourlyRate)<span class="text-xs text-secondary"> / hour</span></td>
                        <td class="px-4 py-3">@D.Label(row.ChangeType)</td><td class="px-4 py-3 whitespace-nowrap text-body-md">@D.Date(row.EffectiveFrom)<div class="text-xs text-secondary">to @D.Date(row.EffectiveTo)</div></td>
                        <td class="px-4 py-3"><span class="rounded-full px-3 py-1 text-xs font-semibold @D.Badge(row.Status)">@D.Label(row.Status)</span></td>
                        <td class="px-5 py-3 text-right"><a asp-action="Details" asp-route-id="@row.SalaryHistoryId" aria-label="View salary change for @row.EmployeeFullName" title="View salary record" class="ws-icon-action"><span class="material-symbols-outlined" aria-hidden="true">visibility</span></a></td>
                    </tr>
                }
            </tbody>
        </table></div>
        @if (Model.ErrorMessage == null && ViewData.ModelState.IsValid) { <partial name="_ListPagination" model='@(new ListPaginationViewModel { PageNumber = Model.PageNumber, PageSize = Model.PageSize, TotalItems = Model.TotalItems, ItemLabel = "salary records" })' /> }
    </div>
</div>
