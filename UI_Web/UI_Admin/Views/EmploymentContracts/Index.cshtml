@model UI_Admin.Models.EmploymentContracts.EmploymentContractListViewModel

@{
    ViewData["Title"] = "Employment Contracts";
    var items = Model.Items;
    var hasFilters = !string.IsNullOrWhiteSpace(Model.Search)
        || (!string.IsNullOrWhiteSpace(Model.StatusFilter) && !Model.StatusFilter.Equals("all", StringComparison.OrdinalIgnoreCase))
        || Model.BranchIdFilter.HasValue
        || Model.RegionIdFilter.HasValue
        || !string.IsNullOrWhiteSpace(Model.StartDateFrom)
        || !string.IsNullOrWhiteSpace(Model.StartDateTo);
}

<div class="flex flex-col w-full gap-unit-4 px-7 py-4">

    <partial name="_NotificationModal" />

    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-unit-4">
        <div class="flex flex-col">
            <div class="list-eyebrow">HR Management</div>
            <div class="flex items-center gap-unit-3">
                <h1 class="font-display-lg text-display-lg text-on-surface tracking-tight">Employment Contracts</h1>
            </div>
            <p class="font-body-md text-body-md text-secondary mt-1">
                View and monitor part-time employment contracts across all branches.
            </p>
        </div>
    </div>

    <partial name="_ListMetrics" model='@(new ListMetricViewModel[] {
        new("Matching contracts", Model.TotalItems.ToString("N0"), "Matching current filters", "contract", "#10b981"),
        new("Active", Model.Items.Count(x => x.Status == "ACTIVE").ToString("N0"), "On this page", "verified", "#10b981"),
        new("Awaiting approval", Model.Items.Count(x => x.Status == "PENDING_APPROVAL").ToString("N0"), "On this page", "pending_actions", "#f59e0b"),
        new("Awaiting staff", Model.Items.Count(x => x.Status == "PENDING_STAFF").ToString("N0"), "On this page", "person", "#4f46e5")
    })' />

    <!-- Search & Filter Controls -->
    <form method="get" asp-controller="EmploymentContracts" asp-action="Index" class="ws-list-filter" role="search">
        <div class="ws-filter-row">
            <label class="ws-filter-field ws-filter-keyword"><span class="material-symbols-outlined" aria-hidden="true">search</span><input aria-label="Search" type="text" id="filter-search" name="search" value="@Model.Search" placeholder="Search by name, contract no..." /></label>
            <div class="ws-filter-field"><select aria-label="Status" id="filter-status" name="status" onchange="this.form.submit()">
                            <option value="all" selected="@(string.IsNullOrEmpty(Model.StatusFilter) || Model.StatusFilter == "all")">All Statuses</option>
                            <option value="DRAFT" selected="@(Model.StatusFilter == "DRAFT")">Draft</option>
                            <option value="PENDING_APPROVAL" selected="@(Model.StatusFilter == "PENDING_APPROVAL")">Pending Approval</option>
                            <option value="PENDING_STAFF" selected="@(Model.StatusFilter == "PENDING_STAFF")">Pending Staff</option>
                            <option value="APPROVED" selected="@(Model.StatusFilter == "APPROVED")">Approved</option>
                            <option value="ACTIVE" selected="@(Model.StatusFilter == "ACTIVE")">Active</option>
                            <option value="REJECTED" selected="@(Model.StatusFilter == "REJECTED")">Rejected</option>
                            <option value="CANCELLED" selected="@(Model.StatusFilter == "CANCELLED")">Cancelled</option>
                            <option value="TERMINATED" selected="@(Model.StatusFilter == "TERMINATED")">Terminated</option>
                            <option value="EXPIRED" selected="@(Model.StatusFilter == "EXPIRED")">Expired</option>
                        </select></div>
            <details class="ws-filter-advanced">
                <summary title="Advanced filters" aria-label="Advanced filters"><span class="material-symbols-outlined" aria-hidden="true">tune</span>
                    @if (Context.Request.Query.Any(q => new[] { "startDateFrom", "startDateTo" }.Contains(q.Key, StringComparer.OrdinalIgnoreCase) && !string.IsNullOrWhiteSpace(q.Value.ToString()))) { <span class="ws-filter-indicator" aria-label="Advanced filters active"></span> }
                </summary>
                <div class="ws-filter-panel">
                    <label class="ws-filter-field"><span>Start date from</span><input aria-label="Start date from" type="date" id="filter-start-from" name="startDateFrom" value="@Model.StartDateFrom" /></label>
                    <label class="ws-filter-field"><span>Start date to</span><input aria-label="Start date to" type="date" id="filter-start-to" name="startDateTo" value="@Model.StartDateTo" /></label>
                    <button type="submit" class="ws-filter-apply">Apply filters</button>
                </div>
            </details>
            <partial name="_ListFilterActions" model='"Index"' />
        </div>
    </form>

    <!-- Main Table -->
    <div class="bg-surface-container-lowest rounded-xl shadow-sm overflow-hidden border border-surface-container-high/60">
        <div class="overflow-x-auto custom-scrollbar">
            <table class="w-full text-left min-w-[1100px] border-collapse">
                <thead>
                    <tr class="h-[42px] bg-surface-container-low text-secondary text-label-md font-label-md uppercase tracking-wider">
                        <th class="px-unit-4 py-2.5 whitespace-nowrap" scope="col">Contract No.</th>
                        <th class="px-unit-4 py-2.5 whitespace-nowrap" scope="col">Employee</th>
                        <th class="px-unit-3 py-2.5 whitespace-nowrap" scope="col">Position</th>
                        <th class="px-unit-3 py-2.5 whitespace-nowrap" scope="col">Branch</th>
                        <th class="px-unit-3 py-2.5 whitespace-nowrap" scope="col">Region</th>
                        <th class="px-unit-3 py-2.5 whitespace-nowrap" scope="col">Start Date</th>
                        <th class="px-unit-3 py-2.5 whitespace-nowrap" scope="col">End Date</th>
                        <th class="px-unit-3 py-2.5 whitespace-nowrap" scope="col">Hourly Rate</th>
                        <th class="px-unit-3 py-2.5 whitespace-nowrap" scope="col">Status</th>
                        <th class="px-unit-2 py-2.5 whitespace-nowrap text-center" scope="col">PDF</th>
                        <th class="px-unit-4 py-2.5 whitespace-nowrap text-right sticky right-0 bg-surface-container-low backdrop-blur-sm shadow-[-6px_0_10px_-4px_rgba(0,0,0,0.06)]" scope="col">Action</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-surface-container-high/40">
                    @if (!items.Any())
                    {
                        <tr>
                            <td colspan="11" class="px-6 py-16 text-center">
                                <div class="flex flex-col items-center gap-3 text-secondary">
                                    <span class="material-symbols-outlined text-[48px] text-secondary/40">description</span>
                                    <p class="font-body-md text-sm">No employment contracts match your filters.</p>
                                    @if (hasFilters)
                                    {
                                        <a asp-controller="EmploymentContracts" asp-action="Index"
                                           class="text-primary hover:underline text-xs font-medium">Clear filters</a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var contract in items)
                        {
                            var statusUpper = contract.Status?.ToUpperInvariant() ?? "";
                            <tr class="hover:bg-surface-container-low/50 transition-colors duration-100 group">
                                <!-- Contract Number -->
                                <td class="px-unit-4 py-3 whitespace-nowrap align-middle">
                                    <span class="font-mono text-xs font-semibold text-on-surface">@contract.ContractNumber</span>
                                </td>
                                <!-- Employee -->
                                <td class="px-unit-4 py-3 whitespace-nowrap align-middle">
                                    <div class="flex flex-col">
                                        <span class="font-body-md text-sm text-on-surface font-medium whitespace-nowrap">@contract.StaffName</span>
                                        <span class="text-[11px] text-secondary font-mono">@contract.StaffId.ToString()[..8]…</span>
                                    </div>
                                </td>
                                <!-- Position -->
                                <td class="px-unit-3 py-3 whitespace-nowrap align-middle">
                                    <span class="text-sm text-secondary">@contract.EmployeePosition</span>
                                </td>
                                <!-- Branch -->
                                <td class="px-unit-3 py-3 whitespace-nowrap align-middle">
                                    <span class="text-sm text-on-surface">@contract.BranchName</span>
                                </td>
                                <!-- Region -->
                                <td class="px-unit-3 py-3 whitespace-nowrap align-middle">
                                    <span class="text-sm text-secondary">@contract.RegionName</span>
                                </td>
                                <!-- Start Date -->
                                <td class="px-unit-3 py-3 whitespace-nowrap align-middle">
                                    <span class="text-sm text-on-surface tabular-nums">@contract.StartDate.ToString("dd/MM/yyyy")</span>
                                </td>
                                <!-- End Date -->
                                <td class="px-unit-3 py-3 whitespace-nowrap align-middle">
                                    <span class="text-sm text-secondary tabular-nums">
                                        @(contract.EndDate.HasValue ? contract.EndDate.Value.ToString("dd/MM/yyyy") : "—")
                                    </span>
                                </td>
                                <!-- Hourly Rate -->
                                <td class="px-unit-3 py-3 whitespace-nowrap align-middle">
                                    <span class="text-sm font-semibold text-on-surface tabular-nums">@($"{CurrencyHelper.FormatVnd(contract.HourlyRate)}/h")</span>
                                </td>
                                <!-- Status Badge -->
                                <td class="px-unit-3 py-3 whitespace-nowrap align-middle">
                                    @switch (statusUpper)
                                    {
                                        case "DRAFT":
                                            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-semibold bg-amber-50 text-amber-700 border border-amber-200 whitespace-nowrap">
                                                <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>Draft
                                            </span>
                                            break;
                                        case "PENDING_APPROVAL":
                                            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-semibold bg-purple-50 text-purple-700 border border-purple-200 whitespace-nowrap">
                                                <span class="w-1.5 h-1.5 rounded-full bg-purple-500 animate-pulse"></span>Pending
                                            </span>
                                            break;
                                        case "PENDING_STAFF":
                                            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-semibold bg-sky-50 text-sky-700 border border-sky-200 whitespace-nowrap">
                                                <span class="w-1.5 h-1.5 rounded-full bg-sky-500 animate-pulse"></span>Pending Staff
                                            </span>
                                            break;
                                        case "APPROVED":
                                            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-semibold bg-blue-50 text-blue-700 border border-blue-200 whitespace-nowrap">
                                                <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>Approved
                                            </span>
                                            break;
                                        case "ACTIVE":
                                            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200 whitespace-nowrap">
                                                <span class="w-1.5 h-1.5 rounded-full bg-emerald-600 animate-pulse"></span>Active
                                            </span>
                                            break;
                                        case "REJECTED":
                                            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-semibold bg-rose-50 text-rose-700 border border-rose-200 whitespace-nowrap">
                                                <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>Rejected
                                            </span>
                                            break;
                                        case "CANCELLED":
                                            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-semibold bg-rose-50 text-rose-700 border border-rose-200 whitespace-nowrap">
                                                <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>Cancelled
                                            </span>
                                            break;
                                        case "TERMINATED":
                                            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-semibold bg-slate-100 text-slate-600 border border-slate-200 whitespace-nowrap">
                                                <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>Terminated
                                            </span>
                                            break;
                                        case "EXPIRED":
                                            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-semibold bg-gray-100 text-gray-500 border border-gray-200 whitespace-nowrap">
                                                <span class="w-1.5 h-1.5 rounded-full bg-gray-400"></span>Expired
                                            </span>
                                            break;
                                        default:
                                            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-semibold bg-gray-50 text-gray-500 border border-gray-200 whitespace-nowrap">@contract.Status</span>
                                            break;
                                    }
                                </td>
                                <!-- PDF -->
                                <td class="px-unit-2 py-3 whitespace-nowrap text-center align-middle">
                                    @if (contract.HasPdf)
                                    {
                                        <span class="material-symbols-outlined text-[20px] text-emerald-600" title="PDF available">picture_as_pdf</span>
                                    }
                                    else
                                    {
                                        <span class="material-symbols-outlined text-[20px] text-secondary/30" title="No PDF">picture_as_pdf</span>
                                    }
                                </td>
                                <!-- Action -->
                                <td class="px-unit-4 py-3 whitespace-nowrap text-right align-middle sticky right-0 bg-surface-container-lowest group-hover:bg-surface-container-low/80 backdrop-blur-sm transition-colors shadow-[-6px_0_10px_-4px_rgba(0,0,0,0.06)]">
                                    <a asp-controller="EmploymentContracts" asp-action="Details"
                                       asp-route-contractId="@contract.ContractId"
                                       title="View details" aria-label="View details" class="ws-icon-action"><span class="material-symbols-outlined" aria-hidden="true">visibility</span></a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Pagination -->
    <partial name="_ListPagination" model="@(new ListPaginationViewModel
    {
        PageNumber = Model.PageNumber,
        PageSize = Model.PageSize,
        TotalItems = Model.TotalItems,
        ItemLabel = "contracts",
        PageParameter = "pageNumber",
    })" />

</div>
