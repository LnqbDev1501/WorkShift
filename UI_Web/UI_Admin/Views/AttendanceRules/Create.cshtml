@model UI_Admin.Models.AttendanceRule.CreateAttendanceRuleViewModel

@{
    ViewData["Title"] = "Create Attendance Rule";
    var minDate = DateTime.UtcNow.AddHours(7).ToString("yyyy-MM-dd");
}

@section Styles {
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet" />
<style>
    .field-validation-error {
        color: #dc2626;
        font-size: 12px;
        font-weight: 500;
        display: block;
        margin-top: 4px;
    }
    .input-validation-error {
        border-color: #dc2626 !important;
        background-color: #fff8f8 !important;
    }
    .timeline-bar {
        position: relative;
        height: 10px;
        background: #e2e8f0;
        border-radius: 9999px;
    }
    .timeline-window-in {
        position: absolute;
        top: 0;
        bottom: 0;
        background: #6366f1;
        border-radius: 9999px;
    }
    .timeline-window-out {
        position: absolute;
        top: 0;
        bottom: 0;
        background: #10b981;
        border-radius: 9999px;
    }
</style>
}

<div class="w-full px-7 pt-6 pb-12 bg-[#F6F7FB] min-h-screen">
    <div class="w-full max-w-[1440px] mx-auto space-y-6">

        <!-- Top Status Bar -->
        <div class="flex items-center justify-end">
            <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-slate-100 text-slate-600 text-xs font-semibold uppercase tracking-wider border border-slate-200 shadow-2xs">
                <span class="w-2 h-2 rounded-full bg-indigo-500 animate-pulse"></span>
                New Policy Draft
            </div>
        </div>

        <!-- Validation Error Banner -->
        @if (!ViewData.ModelState.IsValid && ViewData.ModelState.TryGetValue(string.Empty, out var modelStateErrors) && modelStateErrors.Errors.Count > 0)
        {
            <div id="createErrorBanner" class="p-4 bg-rose-50 border border-rose-200 rounded-xl flex items-start justify-between gap-3 text-rose-800 shadow-sm">
                <div class="flex items-start gap-2.5 min-w-0">
                    <span class="material-symbols-outlined text-[20px] shrink-0 mt-0.5 text-rose-600">error</span>
                    <div class="text-sm space-y-1 leading-relaxed">
                        @foreach (var error in modelStateErrors.Errors)
                        {
                            <div>@error.ErrorMessage</div>
                        }
                    </div>
                </div>
                <button type="button" class="p-1 rounded-lg hover:bg-rose-200/50 text-rose-700 transition-colors cursor-pointer shrink-0" title="Dismiss" onclick="document.getElementById('createErrorBanner').remove()">
                    <span class="material-symbols-outlined text-[18px]">close</span>
                </button>
            </div>
        }

        <!-- Main Form Card -->
        <form asp-action="Create" method="post" class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden divide-y divide-slate-100">
            @Html.AntiForgeryToken()

            <!-- 1. Header Section -->
            <div class="p-7 flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-slate-50/50">
                <div class="flex items-center gap-4">
                    <div class="w-14 h-14 rounded-2xl bg-indigo-50 border border-indigo-100 text-indigo-600 flex items-center justify-center shadow-xs shrink-0">
                        <span class="material-symbols-outlined text-[32px]">policy</span>
                    </div>
                    <div>
                        <h1 class="text-xl font-bold text-slate-900">Create Attendance Rule</h1>
                        <p class="text-sm text-slate-500 mt-1">Configure check-in / check-out windows, grace periods, GPS radius, and effective date.</p>
                    </div>
                </div>
                <div class="self-start sm:self-center">
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-amber-50 text-amber-700 text-xs font-semibold border border-amber-200">
                        <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
                        Status: Draft
                    </span>
                </div>
            </div>

            <!-- 2. General Information Section -->
            <div class="p-7 space-y-5">
                <div class="flex items-center gap-2 pb-2 border-b border-slate-100">
                    <span class="material-symbols-outlined text-indigo-600 text-[20px]">info</span>
                    <h2 class="text-base font-semibold text-slate-800">1. Policy Information</h2>
                </div>

                <div class="space-y-4">
                    <!-- Rule Name -->
                    <div>
                        <label asp-for="RuleName" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">
                            Rule Name <span class="text-rose-500">*</span>
                        </label>
                        <input asp-for="RuleName" class="w-full px-3.5 py-2.5 text-sm bg-slate-50/60 border border-slate-200 rounded-xl focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-600 transition-all placeholder:text-slate-400 font-medium text-slate-900" placeholder="e.g. Standard Attendance Policy 2026" maxlength="150" required />
                        <span asp-validation-for="RuleName"></span>
                    </div>

                    <!-- Description -->
                    <div>
                        <label asp-for="Description" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">
                            Description <span class="text-slate-400 font-normal lowercase">(optional)</span>
                        </label>
                        <textarea asp-for="Description" rows="2" class="w-full px-3.5 py-2.5 text-sm bg-slate-50/60 border border-slate-200 rounded-xl focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-600 transition-all placeholder:text-slate-400 text-slate-800" placeholder="Provide additional guidelines or target branch notes..." maxlength="500"></textarea>
                        <span asp-validation-for="Description"></span>
                    </div>
                </div>
            </div>

            <!-- 3. Time Windows & Grace Periods Section -->
            <div class="p-7 space-y-6">
                <div class="flex items-center gap-2 pb-2 border-b border-slate-100">
                    <span class="material-symbols-outlined text-indigo-600 text-[20px]">timer</span>
                    <h2 class="text-base font-semibold text-slate-800">2. Time Windows & Grace Periods</h2>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- Left Column: Check-in (Shift start) -->
                    <div class="p-5 bg-indigo-50/30 rounded-2xl border border-indigo-100/60 space-y-4">
                        <div class="flex items-center gap-2 text-indigo-900 font-semibold text-sm">
                            <span class="material-symbols-outlined text-[20px] text-indigo-600">login</span>
                            <span>Check-in Controls (Start of Shift)</span>
                        </div>

                        <!-- Check-in Before Minutes -->
                        <div>
                            <div class="flex items-center justify-between mb-1.5">
                                <label asp-for="CheckInBeforeMinutes" class="text-xs font-semibold text-slate-700 uppercase tracking-wider">
                                    Check-in Window <span class="text-rose-500">*</span>
                                </label>
                                <span class="text-[11px] font-medium text-slate-400 bg-white px-2 py-0.5 rounded-md border border-slate-200">0 - 120 mins</span>
                            </div>
                            <div class="relative">
                                <input asp-for="CheckInBeforeMinutes" type="number" min="0" max="120" class="w-full px-3.5 py-2.5 text-sm bg-white border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-600 transition-all font-semibold text-slate-900 pr-14" required />
                                <span class="absolute right-3.5 top-1/2 -translate-y-1/2 text-xs text-slate-400 font-medium pointer-events-none">mins</span>
                            </div>
                            <p class="text-[12px] text-slate-500 mt-1">Allows staff to check in up to this many minutes prior to shift start.</p>
                            <span asp-validation-for="CheckInBeforeMinutes"></span>
                        </div>

                        <!-- Check-in Grace Minutes -->
                        <div>
                            <div class="flex items-center justify-between mb-1.5">
                                <label asp-for="CheckInGraceMinutes" class="text-xs font-semibold text-slate-700 uppercase tracking-wider">
                                    Check-in Grace Period <span class="text-rose-500">*</span>
                                </label>
                                <span class="text-[11px] font-medium text-slate-400 bg-white px-2 py-0.5 rounded-md border border-slate-200">0 - 60 mins</span>
                            </div>
                            <div class="relative">
                                <input asp-for="CheckInGraceMinutes" type="number" min="0" max="60" class="w-full px-3.5 py-2.5 text-sm bg-white border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-600 transition-all font-semibold text-slate-900 pr-14" required />
                                <span class="absolute right-3.5 top-1/2 -translate-y-1/2 text-xs text-slate-400 font-medium pointer-events-none">mins</span>
                            </div>
                            <p class="text-[12px] text-slate-500 mt-1">Tolerance window for arriving late after shift start without penalty.</p>
                            <span asp-validation-for="CheckInGraceMinutes"></span>
                        </div>
                    </div>

                    <!-- Right Column: Check-out (Ra ca) -->
                    <div class="p-5 bg-emerald-50/30 rounded-2xl border border-emerald-100/60 space-y-4">
                        <div class="flex items-center gap-2 text-emerald-900 font-semibold text-sm">
                            <span class="material-symbols-outlined text-[20px] text-emerald-600">logout</span>
                            <span>Check-out Controls (End of Shift)</span>
                        </div>

                        <!-- Check-out After Minutes -->
                        <div>
                            <div class="flex items-center justify-between mb-1.5">
                                <label asp-for="CheckOutAfterMinutes" class="text-xs font-semibold text-slate-700 uppercase tracking-wider">
                                    Check-out Window <span class="text-rose-500">*</span>
                                </label>
                                <span class="text-[11px] font-medium text-slate-400 bg-white px-2 py-0.5 rounded-md border border-slate-200">0 - 120 mins</span>
                            </div>
                            <div class="relative">
                                <input asp-for="CheckOutAfterMinutes" type="number" min="0" max="120" class="w-full px-3.5 py-2.5 text-sm bg-white border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-600 transition-all font-semibold text-slate-900 pr-14" required />
                                <span class="absolute right-3.5 top-1/2 -translate-y-1/2 text-xs text-slate-400 font-medium pointer-events-none">mins</span>
                            </div>
                            <p class="text-[12px] text-slate-500 mt-1">Maximum allowed time to check out after shift has finished.</p>
                            <span asp-validation-for="CheckOutAfterMinutes"></span>
                        </div>

                        <!-- Check-out Grace Minutes -->
                        <div>
                            <div class="flex items-center justify-between mb-1.5">
                                <label asp-for="CheckOutGraceMinutes" class="text-xs font-semibold text-slate-700 uppercase tracking-wider">
                                    Check-out Grace Period <span class="text-rose-500">*</span>
                                </label>
                                <span class="text-[11px] font-medium text-slate-400 bg-white px-2 py-0.5 rounded-md border border-slate-200">0 - 60 mins</span>
                            </div>
                            <div class="relative">
                                <input asp-for="CheckOutGraceMinutes" type="number" min="0" max="60" class="w-full px-3.5 py-2.5 text-sm bg-white border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-600 transition-all font-semibold text-slate-900 pr-14" required />
                                <span class="absolute right-3.5 top-1/2 -translate-y-1/2 text-xs text-slate-400 font-medium pointer-events-none">mins</span>
                            </div>
                            <p class="text-[12px] text-slate-500 mt-1">Allows staff to check out this many minutes before shift end.</p>
                            <span asp-validation-for="CheckOutGraceMinutes"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 4. Geofencing & Activation Section -->
            <div class="p-7 space-y-6">
                <div class="flex items-center gap-2 pb-2 border-b border-slate-100">
                    <span class="material-symbols-outlined text-indigo-600 text-[20px]">location_on</span>
                    <h2 class="text-base font-semibold text-slate-800">3. Geofencing & Activation Schedule</h2>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- Max Attendance Distance -->
                    <div>
                        <div class="flex items-center justify-between mb-1.5">
                            <label asp-for="MaxAttendanceDistanceMeters" class="text-xs font-semibold text-slate-700 uppercase tracking-wider">
                                Max GPS Distance Radius <span class="text-rose-500">*</span>
                            </label>
                            <span class="text-[11px] font-medium text-slate-400 bg-slate-50 px-2 py-0.5 rounded-md border border-slate-200">1 - 20 m</span>
                        </div>
                        <div class="relative">
                            <input asp-for="MaxAttendanceDistanceMeters" type="number" min="1" max="20" class="w-full px-3.5 py-2.5 text-sm bg-slate-50/60 border border-slate-200 rounded-xl focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-600 transition-all font-semibold text-slate-900 pr-14" required />
                            <span class="absolute right-3.5 top-1/2 -translate-y-1/2 text-xs text-slate-400 font-medium pointer-events-none">meters</span>
                        </div>
                        <p class="text-[12px] text-slate-500 mt-1">Maximum allowable physical distance between employee and branch location.</p>
                        <span asp-validation-for="MaxAttendanceDistanceMeters"></span>
                    </div>

                    <!-- Effective From Date -->
                    <div>
                        <div class="flex items-center justify-between mb-1.5">
                            <label asp-for="EffectiveFrom" class="text-xs font-semibold text-slate-700 uppercase tracking-wider">
                                Effective From Date <span class="text-rose-500">*</span>
                            </label>
                            <span class="text-[11px] font-medium text-indigo-600 bg-indigo-50 px-2 py-0.5 rounded-md border border-indigo-100">Today or future date</span>
                        </div>
                        <input asp-for="EffectiveFrom" type="date" min="@minDate" class="w-full px-3.5 py-2.5 text-sm bg-slate-50/60 border border-slate-200 rounded-xl focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-600 transition-all font-medium text-slate-900 cursor-pointer" required />
                        <p class="text-[12px] text-slate-500 mt-1">Date when this policy will take active effect (today or later).</p>
                        <span asp-validation-for="EffectiveFrom"></span>
                    </div>
                </div>
            </div>

            <!-- 5. Form Submission Footer -->
            <div class="p-7 bg-slate-50/50 flex flex-col sm:flex-row items-center justify-between gap-4">
                <div class="text-xs text-slate-500 flex items-center gap-1.5">
                    <span class="material-symbols-outlined text-[16px] text-amber-500">info</span>
                    <span>New rules are created in <strong>Draft</strong> status and can be published later.</span>
                </div>
                <div class="flex items-center gap-3 w-full sm:w-auto">
                    <a asp-action="List" class="flex-1 sm:flex-none px-5 py-2.5 rounded-xl bg-white hover:bg-slate-100 text-slate-700 font-medium text-sm transition-colors border border-slate-200 text-center shadow-xs">
                        Cancel
                    </a>
                    <button type="submit" class="flex-1 sm:flex-none px-6 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-medium text-sm transition-all shadow-md shadow-indigo-600/20 text-center cursor-pointer flex items-center justify-center gap-2">
                        <span class="material-symbols-outlined text-[18px]">add_task</span>
                        <span>Save as Draft</span>
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
