@using UI_Admin.Models.Admin.UserAdmin
@model SetPasswordViewModel
@{
    ViewData["Title"] = "Set Password";
    ViewData["FullBleed"] = true;
}
<link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />

<div class="ws-auth">
    <!-- Brand panel -->
    <aside class="ws-auth-brand">
        <span class="ws-auth-orb ws-auth-orb-a"></span>
        <span class="ws-auth-orb ws-auth-orb-b"></span>

        <div class="ws-auth-logo">
            <span class="ws-auth-logo-mark">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/></svg>
            </span>
            <span><strong>WorkShift</strong><small>Workforce OS</small></span>
        </div>

        <div class="ws-auth-hero">
            <span class="ws-auth-eyebrow"><span class="dot"></span>Account activation &middot; Management</span>
            <h1>Welcome aboard, <em>activate your workspace.</em></h1>
            <p>Set a strong password to complete your Manager or Accountant onboarding and access your assigned branch operations.</p>
        </div>

        <div class="ws-auth-art" aria-hidden="true">
            <div class="ws-auth-card ws-auth-schedule">
                <h4>Workspace Access &middot; Ready</h4>
                <div class="ws-role-pills">
                    <span class="ws-role-pill active">Manager</span>
                    <span class="ws-role-pill active">Accountant</span>
                    <span class="ws-role-pill">Schedules</span>
                    <span class="ws-role-pill">Payroll</span>
                </div>
            </div>
            <div class="ws-auth-card ws-auth-toast">
                <span class="ws-auth-check">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                </span>
                <span><strong>Invitation verified</strong><small>Set password to unlock access</small></span>
            </div>
            <div class="ws-auth-card ws-auth-shift">
                <span class="ws-auth-check" style="background:#e0e7ff;color:#4f46e5">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-3.6 8-10V5l-8-3-8 3v7c0 6.4 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
                </span>
                <span><strong>Encrypted credentials</strong><small>Single-use link &middot; Supabase Auth</small></span>
            </div>
        </div>

        <div class="ws-auth-feats">
            <div class="ws-auth-feat">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#4ade80" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="3"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
                <span><b>Branch command &amp; approvals</b> — oversee shifts, attendance, and staff requests.</span>
            </div>
            <div class="ws-auth-feat">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#4ade80" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="20" height="12" rx="3"/><circle cx="12" cy="12" r="2.6"/><path d="M6 12h.01M18 12h.01"/></svg>
                <span><b>Payroll &amp; timesheet control</b> — review hours, adjustments, and period payouts.</span>
            </div>
            <div class="ws-auth-feat">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#4ade80" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-3.6 8-10V5l-8-3-8 3v7c0 6.4 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
                <span><b>Enterprise-grade protection</b> — encrypted password storage and role-based access.</span>
            </div>
        </div>

        <div class="ws-auth-foot">
            <div class="ws-auth-stats">
                <span><b>Multi-branch</b><small>regions &amp; stores unified</small></span>
                <span><b>Real-time</b><small>attendance &amp; alerts</small></span>
                <span><b>Role-based</b><small>admin &middot; manager &middot; accountant</small></span>
            </div>
            <span>&copy; 2026 WorkShift</span>
        </div>
    </aside>

    <!-- Form side -->
    <main class="ws-auth-form-wrap">
        <div class="ws-auth-card-form ws-setpw-card">
            <a asp-action="Login" class="ws-back">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M11 18l-6-6 6-6"/></svg>
                Back to sign in
            </a>

            <div class="ws-setpw-badge">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-3.6 8-10V5l-8-3-8 3v7c0 6.4 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
                Account Security Setup
            </div>

            <h2>Set your password</h2>
            <p class="ws-auth-sub">
                Create a strong password (6&ndash;16 characters) to activate your account and sign in to WorkShift.
            </p>

            <div id="invalid-link" class="ws-link-error d-none" role="alert">
                The password setup link is invalid or has expired.
            </div>

            <form asp-action="SetPassword" method="post" id="set-password-form">
                <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

                <input asp-for="AccessToken"
                       type="hidden"
                       id="access-token" />

                <div class="ws-field">
                    <label asp-for="Password">
                        New Password
                    </label>

                    <div class="ws-input">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                        <input asp-for="Password" placeholder="Create a strong password" autocomplete="new-password" id="new-password" />
                        <button type="button" class="ws-eye" data-toggle-password="new-password" title="Show / hide password" aria-label="Show / hide password">
                            <svg class="ws-eye-open" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg>
                            <svg class="ws-eye-closed" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none"><path d="M9.9 4.24A9.5 9.5 0 0 1 12 4c6.5 0 10 8 10 8a17 17 0 0 1-2.16 3.19M6.61 6.61A16.8 16.8 0 0 0 2 12s3.5 8 10 8a9.9 9.9 0 0 0 5.39-1.61"/><line x1="2" y1="2" x2="22" y2="22"/><path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"/></svg>
                        </button>
                    </div>

                    <span class="ws-caps" id="caps-hint">Caps Lock is on &mdash; passwords are case-sensitive.</span>

                    <div class="ws-pw-rules" id="pw-rules" aria-live="polite">
                        <span class="ws-pw-rule" data-rule="length"><i></i>6&ndash;16 characters</span>
                        <span class="ws-pw-rule" data-rule="upper"><i></i>Uppercase (A&ndash;Z)</span>
                        <span class="ws-pw-rule" data-rule="lower"><i></i>Lowercase (a&ndash;z)</span>
                        <span class="ws-pw-rule" data-rule="number"><i></i>Number (0&ndash;9)</span>
                        <span class="ws-pw-rule" data-rule="special"><i></i>Special character</span>
                        <span class="ws-pw-rule" data-rule="nospace"><i></i>No spaces</span>
                    </div>

                    <span asp-validation-for="Password"
                          class="field-validation-error">
                    </span>
                </div>

                <div class="ws-field">
                    <label asp-for="ConfirmPassword">
                        Confirm Password
                    </label>

                    <div class="ws-input">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-3.6 8-10V5l-8-3-8 3v7c0 6.4 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
                        <input asp-for="ConfirmPassword" placeholder="Re-enter your password" autocomplete="new-password" id="confirm-password" />
                        <button type="button" class="ws-eye" data-toggle-password="confirm-password" title="Show / hide confirm password" aria-label="Show / hide confirm password">
                            <svg class="ws-eye-open" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg>
                            <svg class="ws-eye-closed" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none"><path d="M9.9 4.24A9.5 9.5 0 0 1 12 4c6.5 0 10 8 10 8a17 17 0 0 1-2.16 3.19M6.61 6.61A16.8 16.8 0 0 0 2 12s3.5 8 10 8a9.9 9.9 0 0 0 5.39-1.61"/><line x1="2" y1="2" x2="22" y2="22"/><path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"/></svg>
                        </button>
                    </div>

                    <span asp-validation-for="ConfirmPassword"
                          class="field-validation-error">
                    </span>
                </div>

                <button type="submit"
                        class="ws-btn"
                        id="submit-button"
                        disabled>
                    Set Password
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                </button>
            </form>

            <div class="ws-secure">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                Protected by Supabase Auth &middot; Single-use activation link
            </div>
        </div>
    </main>
</div>

<style>
    .ws-setpw-card { max-width: 460px; }
    .ws-setpw-badge {
        display: inline-flex; align-items: center; gap: 6px;
        font-size: 11.5px; font-weight: 700; letter-spacing: .04em;
        color: var(--ws-indigo); background: #eef2ff; border: 1px solid #c7d2fe;
        border-radius: 999px; padding: 5px 12px; margin-bottom: 12px;
    }
    .ws-role-pills { display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; }
    .ws-role-pill {
        border-radius: 10px; background: #eef0f7; color: var(--ws-muted);
        font-size: 12px; font-weight: 700; padding: 8px 10px; text-align: center;
    }
    .ws-role-pill.active {
        background: linear-gradient(135deg, var(--ws-indigo), var(--ws-violet));
        color: #fff; box-shadow: 0 6px 14px rgba(79,70,229,.28);
    }
    .ws-link-error {
        display: flex; align-items: flex-start; gap: 10px;
        border-radius: 13px; background: #fef2f2; border: 1px solid #fecaca;
        color: #b91c1c; font-size: 13.5px; font-weight: 600; line-height: 1.5;
        padding: 13px 15px; margin-bottom: 18px;
        animation: ws-shake .4s ease;
    }
    .ws-link-error::before {
        content: "!"; flex: 0 0 auto; width: 20px; height: 20px; border-radius: 50%;
        background: #dc2626; color: #fff; font-size: 12px; font-weight: 800;
        display: grid; place-items: center; margin-top: 1px;
    }
    .ws-pw-rules {
        display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 6px 10px;
        margin-top: 10px; padding: 10px 12px; border-radius: 12px;
        background: #f8f9fd; border: 1px solid #eaecf4;
    }
    .ws-pw-rule {
        display: inline-flex; align-items: center; gap: 7px;
        font-size: 12px; font-weight: 500; color: #64748b;
        transition: color .18s ease;
    }
    .ws-pw-rule i {
        width: 14px; height: 14px; border-radius: 50%; flex: 0 0 auto;
        border: 1.5px solid #cbd5e1; background: #fff; position: relative;
        transition: background .18s ease, border-color .18s ease;
    }
    .ws-pw-rule.met { color: #15803d; font-weight: 600; }
    .ws-pw-rule.met i { background: #16a34a; border-color: #16a34a; }
    .ws-pw-rule.met i::after {
        content: ""; position: absolute; left: 4px; top: 1.5px;
        width: 4px; height: 7px; border: solid #fff; border-width: 0 1.8px 1.8px 0;
        transform: rotate(45deg);
    }
    .ws-btn:disabled {
        opacity: .52; cursor: not-allowed; transform: none !important;
        box-shadow: none !important; filter: grayscale(.15);
    }
    .ws-btn:disabled::after { animation: none; display: none; }
    @@media (max-width: 480px) {
        .ws-pw-rules { grid-template-columns: 1fr; }
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (() => {
            document.querySelectorAll('[data-toggle-password]').forEach(button => {
                button.addEventListener('click', () => {
                    const input = document.getElementById(button.dataset.togglePassword);
                    const hidden = input.type === 'password';
                    input.type = hidden ? 'text' : 'password';
                    const eyeOpen = button.querySelector('.ws-eye-open');
                    const eyeClosed = button.querySelector('.ws-eye-closed');
                    if (eyeOpen && eyeClosed) {
                        eyeOpen.style.display = hidden ? 'none' : '';
                        eyeClosed.style.display = hidden ? '' : 'none';
                    }
                    input.focus();
                });
            });

            const passwordInput = document.getElementById('new-password');
            const capsHint = document.getElementById('caps-hint');
            const ruleEls = {
                length: document.querySelector('[data-rule="length"]'),
                upper: document.querySelector('[data-rule="upper"]'),
                lower: document.querySelector('[data-rule="lower"]'),
                number: document.querySelector('[data-rule="number"]'),
                special: document.querySelector('[data-rule="special"]'),
                nospace: document.querySelector('[data-rule="nospace"]')
            };

            const updatePasswordChecklist = () => {
                const val = passwordInput ? passwordInput.value : '';
                const checks = {
                    length: val.length >= 6 && val.length <= 16,
                    upper: /[A-Z]/.test(val),
                    lower: /[a-z]/.test(val),
                    number: /\d/.test(val),
                    special: /[^a-zA-Z0-9\s]/.test(val),
                    nospace: val.length > 0 && !/\s/.test(val)
                };
                Object.keys(checks).forEach(key => {
                    ruleEls[key]?.classList.toggle('met', checks[key]);
                });
            };

            passwordInput?.addEventListener('input', updatePasswordChecklist);
            ['keyup', 'keydown'].forEach(evt => {
                passwordInput?.addEventListener(evt, e => {
                    if (e.getModifierState && capsHint) {
                        capsHint.classList.toggle('show', e.getModifierState('CapsLock'));
                    }
                });
            });
            passwordInput?.addEventListener('blur', () => capsHint?.classList.remove('show'));
            updatePasswordChecklist();

            const hashParams = new URLSearchParams(window.location.hash.substring(1));
            const queryParams = new URLSearchParams(window.location.search);

            const token = hashParams.get('access_token') || queryParams.get('access_token');
            const linkType = hashParams.get('type') || queryParams.get('type');

            const isPasswordSetup =
                !linkType ||
                linkType === 'invite' ||
                linkType === 'recovery';

            const error = hashParams.get('error_description') || queryParams.get('error_description');
            const tokenInput = document.getElementById('access-token');

            if (token && isPasswordSetup) {
                tokenInput.value = token;

                document.getElementById('submit-button').disabled = false;

                if (window.location.hash) {
                    history.replaceState(
                        null,
                        '',
                        window.location.pathname + window.location.search
                    );
                }

                return;
            }

            if (tokenInput.value) {
                document.getElementById('submit-button').disabled = false;
                return;
            }

            const errorBox = document.getElementById('invalid-link');

            errorBox.textContent = error
                ? decodeURIComponent(error.replace(/\+/g, ' '))
                : errorBox.textContent;

            errorBox.classList.remove('d-none');
        })();
    </script>
}
