@model string
@{
    ViewData["Title"] = "Email verified";
}

<div class="min-h-screen flex items-center justify-center bg-[#F6F7FB] px-4">
    <div class="bg-white rounded-2xl p-8 max-w-md w-full shadow-xl border border-[#e2e8f0] flex flex-col items-center text-center space-y-4">
        <div class="w-14 h-14 rounded-full bg-[#ecfdf5] border-2 border-[#a7f3d0] text-[#059669] flex items-center justify-center shadow-sm text-[32px] font-bold">
            ✓
        </div>
        <div class="space-y-1">
            <h1 class="text-xl font-bold text-gray-900">Email verified successfully</h1>
            <p class="text-sm text-gray-500">
                Your account email is now <strong class="text-gray-900 break-all">@Model</strong>.
            </p>
        </div>
        <a asp-controller="Auth" asp-action="Profile" class="w-full py-2.5 px-4 rounded-xl bg-[#4f46e5] hover:bg-[#4338ca] text-white text-sm font-medium transition-colors shadow-sm text-center">
            Back to My Profile
        </a>
    </div>
</div>
