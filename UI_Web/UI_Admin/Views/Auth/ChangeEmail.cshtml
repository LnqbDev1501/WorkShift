@using UI_Admin.Models.Admin.UserAdmin
@model UserDetailViewModel
@{
    Layout = User.IsInRole("ACCOUNTANT") ? "_AccountantLayout" : "_AdminLayout";
    ViewData["Title"] = "Change Email";
    var isActive = Model.IsActive;
}

<div class="flex flex-col w-full px-7 py-6">
    <div class="w-full max-w-[720px] mx-auto space-y-unit-6">
        <a asp-controller="Auth" asp-action="Profile" class="inline-flex items-center gap-1.5 text-secondary hover:text-primary font-body-md-medium text-body-sm transition-colors">
            <span class="material-symbols-outlined text-[18px]">arrow_back</span>
            <span>Back to Profile</span>
        </a>

        <div class="bg-surface-container-lowest rounded-xl p-unit-6 border border-[#e2e8f0] shadow-sm">
            <div class="flex items-center gap-2.5 pb-unit-4 border-b border-surface-container-highest">
                <span class="p-2 rounded-lg bg-surface-container text-primary flex items-center justify-center">
                    <span class="material-symbols-outlined text-[20px]">mail</span>
                </span>
                <div>
                    <h2 class="font-title-md text-title-md text-on-surface">Change Email</h2>
                    <p class="font-label-sm text-secondary">A verification link will be sent to the new address (valid for 3 minutes).</p>
                </div>
            </div>

            @if (TempData["EmailChangeSent"] is true or "true")
            {
                <div class="mt-unit-4 p-3 rounded-xl bg-[#ecfdf5] border border-[#a7f3d0] text-[#059669] font-body-md-medium text-body-sm flex items-center gap-2">
                    <span class="material-symbols-outlined text-[18px]">check_circle</span>
                    <span>A verification link has been sent. Please check the new inbox.</span>
                </div>
            }
            @if (TempData["EmailChangeError"] is string emailError && !string.IsNullOrWhiteSpace(emailError))
            {
                <div class="mt-unit-4 p-3 rounded-xl bg-[#fee2e2] border border-[#fecaca] text-[#991b1b] font-body-md-medium text-body-sm flex items-center gap-2">
                    <span class="material-symbols-outlined text-[18px]">error</span>
                    <span>@emailError</span>
                </div>
            }

            <form asp-controller="Auth" asp-action="RequestEmailChange" method="post" class="flex flex-col gap-unit-4 pt-unit-4">
                @Html.AntiForgeryToken()
                <div class="flex flex-col gap-unit-2">
                    <label class="font-label-md text-label-md text-on-surface">Current Email</label>
                    <div class="flex items-center gap-2">
                        <span class="font-body-md-medium text-secondary text-body-md break-all">@Model.Email</span>
                        @if (isActive)
                        {
                            <span class="material-symbols-outlined text-[15px] text-[#059669]" title="Verified Email">check_circle</span>
                        }
                    </div>
                </div>
                <div class="flex flex-col gap-unit-2">
                    <label for="new-email" class="font-label-md text-label-md text-on-surface">New Email <span class="text-error">*</span></label>
                    <input name="Email" id="new-email" type="email" class="w-full h-[40px] px-unit-3 bg-surface-container-lowest border border-surface-container-high rounded-xl text-on-surface font-body-md text-body-md placeholder:text-secondary focus:outline-none focus:ring-1 focus:ring-primary-container" placeholder="new-email@example.com" />
                </div>
                <div class="flex items-center justify-end">
                    <button type="submit" class="inline-flex items-center justify-center gap-unit-2 h-[40px] px-unit-4 rounded-xl bg-primary-container hover:bg-primary text-on-primary font-body-md-medium text-body-md-medium transition-colors shadow-sm cursor-pointer">
                        <span class="material-symbols-outlined text-[20px]">send</span>
                        <span>Send Verification Link</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
