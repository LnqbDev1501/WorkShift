@model UI_Admin.Models.LoginViewModel
@{
    ViewData["Title"] = "Sign in";
    ViewData["FullBleed"] = true;
}
<link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />

<div class="ws-auth">
    <!-- Brand panel -->
    <aside class="ws-auth-brand">
        <span class="ws-auth-orb ws-auth-orb-a"></span>
        <span class="ws-auth-orb ws-auth-orb-b"></span>

        <div class="ws-auth-logo">
            <span class="ws-auth-logo-mark">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/></svg>
            </span>
            <span><strong>WorkShift</strong><small>Workforce OS</small></span>
        </div>

        <div class="ws-auth-hero">
            <span class="ws-auth-eyebrow"><span class="dot"></span>Workforce operations &middot; Live</span>
            <h1>Every shift, every branch, <em>one command center.</em></h1>
            <p>Plan weekly schedules, verify attendance with face check-in, and close payroll without spreadsheets — across your entire store chain.</p>
        </div>

        <div class="ws-auth-art" aria-hidden="true">
            <div class="ws-auth-card ws-auth-schedule">
                <h4>This week &middot; District 1 Branch</h4>
                <div class="ws-auth-week">
                    <div class="ws-auth-day">M<b>12</b></div>
                    <div class="ws-auth-day on">T<b>13</b></div>
                    <div class="ws-auth-day on">W<b>14</b></div>
                    <div class="ws-auth-day">T<b>15</b></div>
                    <div class="ws-auth-day on">F<b>16</b></div>
                    <div class="ws-auth-day on">S<b>17</b></div>
                    <div class="ws-auth-day">S<b>18</b></div>
                </div>
            </div>
            <div class="ws-auth-card ws-auth-toast">
                <span class="ws-auth-check">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                </span>
                <span><strong>Checked in &middot; 07:58</strong><small>Face verified &middot; inside GPS fence</small></span>
            </div>
            <div class="ws-auth-card ws-auth-shift">
                <span class="ws-auth-check" style="background:#e0e7ff;color:#4f46e5">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                </span>
                <span><strong>Morning shift fully staffed</strong><small>8 / 8 slots &middot; 3 branches online</small>
                    <span class="ws-auth-avatars">
                        <span style="background:#4f46e5">LA</span><span style="background:#7c3aed">MK</span><span style="background:#0ea5e9">TP</span><span style="background:#f59e0b">+5</span>
                    </span>
                </span>
            </div>
        </div>

        <div class="ws-auth-feats">
            <div class="ws-auth-feat">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#4ade80" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="3"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
                <span><b>Smart weekly scheduling</b> — build, publish and swap shifts in minutes.</span>
            </div>
            <div class="ws-auth-feat">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#4ade80" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-3.6 8-10V5l-8-3-8 3v7c0 6.4 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
                <span><b>Face check-in &amp; GPS fence</b> — fraud-proof attendance, zero queues.</span>
            </div>
            <div class="ws-auth-feat">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#4ade80" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="20" height="12" rx="3"/><circle cx="12" cy="12" r="2.6"/><path d="M6 12h.01M18 12h.01"/></svg>
                <span><b>Payroll, contracts &amp; approvals</b> — from timesheet to payout in one flow.</span>
            </div>
        </div>

        <div class="ws-auth-foot">
            <div class="ws-auth-stats">
                <span><b>Multi-branch</b><small>Regions &amp; Stores unified</small></span>
                <span><b>Real-time</b><small>Attendance &amp; Alerts</small></span>
                <span><b>Role-based</b><small>Admin &middot; Manager &middot; Accountant</small></span>
            </div>
            <span>&copy; 2026 WorkShift</span>
        </div>
    </aside>

    <!-- Form side -->
    <main class="ws-auth-form-wrap">
        <div class="ws-auth-card-form">
            <h2>Welcome back</h2>
            <p class="ws-auth-sub">Sign in to your WorkShift workspace to manage shifts, people and payroll.</p>
            <form asp-action="Login" method="post" novalidate>
                @{
                    var modelErrors = ViewData.ModelState.ContainsKey(string.Empty)
                        ? ViewData.ModelState[string.Empty]!.Errors.Select(e => e.ErrorMessage).ToList()
                        : new List<string>();
                }
                @if (modelErrors.Count > 0)
                {
                    <div class="validation-summary-errors" id="login-error-alert" role="alert">
                        <ul>
                            @foreach (var error in modelErrors)
                            {
                                <li>@error</li>
                            }
                        </ul>
                        <button type="button" class="ws-alert-close" id="close-error-alert" aria-label="Close" title="Close notification">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="18" y1="6" x2="6" y2="18"></line>
                                <line x1="6" y1="6" x2="18" y2="18"></line>
                            </svg>
                        </button>
                    </div>
                }
                else
                {
                    <div asp-validation-summary="ModelOnly" class="validation-summary-errors" style="display:none;"></div>
                }
                <input asp-for="ReturnUrl" type="hidden" />
                <div class="ws-field">
                    <label asp-for="Email">Work email</label>
                    <div class="ws-input">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="3"/><path d="m22 7-10 6L2 7"/></svg>
                        <input asp-for="Email" placeholder="you@workshift.com" autocomplete="username" />
                    </div>
                    <span asp-validation-for="Email" class="field-validation-error"></span>
                </div>
                <div class="ws-field">
                    <label asp-for="Password">Password</label>
                    <div class="ws-input">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                        <input asp-for="Password" placeholder="Enter your password" autocomplete="current-password" id="login-password" />
                        <button class="ws-eye" type="button" id="toggle-password" title="Show / hide password" aria-label="Show / hide password">
                            <svg id="eye-open" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg>
                            <svg id="eye-closed" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none"><path d="M9.9 4.24A9.5 9.5 0 0 1 12 4c6.5 0 10 8 10 8a17 17 0 0 1-2.16 3.19M6.61 6.61A16.8 16.8 0 0 0 2 12s3.5 8 10 8a9.9 9.9 0 0 0 5.39-1.61"/><line x1="2" y1="2" x2="22" y2="22"/><path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"/></svg>
                        </button>
                    </div>
                    <span class="ws-caps" id="caps-hint">Caps Lock is on — passwords are case-sensitive.</span>
                    <span asp-validation-for="Password" class="field-validation-error"></span>
                </div>
                <div class="ws-row-between">
                    <span></span>
                    <a asp-action="ForgotPassword">Forgot password?</a>
                </div>
                <button type="submit" class="ws-btn">
                    Sign in
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                </button>
            </form>
            <div class="ws-secure">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                Protected by Supabase Auth &middot; sessions expire after 7 days
            </div>
        </div>
    </main>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var input = document.getElementById('login-password');
            var toggle = document.getElementById('toggle-password');
            var open = document.getElementById('eye-open');
            var closed = document.getElementById('eye-closed');
            toggle?.addEventListener('click', function () {
                var show = input.type === 'password';
                input.type = show ? 'text' : 'password';
                open.style.display = show ? 'none' : '';
                closed.style.display = show ? '' : 'none';
                input.focus();
            });
            var caps = document.getElementById('caps-hint');
            ['keyup', 'keydown'].forEach(function (evt) {
                input?.addEventListener(evt, function (e) {
                    if (e.getModifierState) caps.classList.toggle('show', e.getModifierState('CapsLock'));
                });
            });
            input?.addEventListener('blur', function () { caps.classList.remove('show'); });

            // Dismiss error alert on close button click
            var closeBtn = document.getElementById('close-error-alert');
            closeBtn?.addEventListener('click', function () {
                var alert = document.getElementById('login-error-alert') || this.closest('.validation-summary-errors');
                if (alert) {
                    alert.style.transition = 'opacity .2s ease, transform .2s ease';
                    alert.style.opacity = '0';
                    alert.style.transform = 'scale(0.95)';
                    setTimeout(function () {
                        alert.remove();
                    }, 200);
                }
            });

            // If user reloaded the page (F5 / browser refresh), ensure error notification disappears
            try {
                var navEntries = window.performance && performance.getEntriesByType ? performance.getEntriesByType('navigation') : null;
                var isReload = (navEntries && navEntries.length > 0 && navEntries[0].type === 'reload') ||
                               (window.performance && performance.navigation && performance.navigation.type === 1);
                if (isReload) {
                    var alertEl = document.getElementById('login-error-alert');
                    if (alertEl) alertEl.remove();
                    var summaryEls = document.querySelectorAll('.validation-summary-errors');
                    summaryEls.forEach(function (el) { el.remove(); });
                }
            } catch (_) {}
        })();
    </script>
}
