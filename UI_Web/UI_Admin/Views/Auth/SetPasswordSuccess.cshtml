@{
    ViewData["Title"] = "Password Set Successfully";
    ViewData["FullBleed"] = true;
}
<link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />

<div class="ws-auth">
    <aside class="ws-auth-brand">
        <span class="ws-auth-orb ws-auth-orb-a"></span>
        <span class="ws-auth-orb ws-auth-orb-b"></span>

        <div class="ws-auth-logo">
            <span class="ws-auth-logo-mark">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/></svg>
            </span>
            <span><strong>WorkShift</strong><small>Workforce OS</small></span>
        </div>

        <div class="ws-auth-hero">
            <span class="ws-auth-eyebrow"><span class="dot"></span>Activation complete</span>
            <h1>Account ready, <em>welcome to WorkShift.</em></h1>
            <p>Your password has been configured and your account is now active. Sign in to start managing your branch operations.</p>
        </div>

        <div class="ws-auth-feats">
            <div class="ws-auth-feat">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#4ade80" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                <span><b>Protected credentials</b> — encrypted and secured via Supabase Auth.</span>
            </div>
            <div class="ws-auth-feat">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#4ade80" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="3"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
                <span><b>Ready for your branch</b> — schedules, attendance, and payroll in one place.</span>
            </div>
            <div class="ws-auth-feat">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#4ade80" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-3.6 8-10V5l-8-3-8 3v7c0 6.4 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
                <span><b>Role-based workspace</b> — tailored tools for Managers and Accountants.</span>
            </div>
        </div>

        <div class="ws-auth-foot">
            <div class="ws-auth-stats">
                <span><b>Multi-branch</b><small>regions &amp; stores unified</small></span>
                <span><b>Real-time</b><small>attendance &amp; alerts</small></span>
                <span><b>Role-based</b><small>admin &middot; manager &middot; accountant</small></span>
            </div>
            <span>&copy; 2026 WorkShift</span>
        </div>
    </aside>

    <main class="ws-auth-form-wrap">
        <div class="ws-auth-card-form" style="text-align: center;">
            <div class="ws-mail-art" aria-hidden="true">
                <span class="ring" style="background: linear-gradient(135deg, #dcfce7, #bbf7d0); color: #15803d; box-shadow: inset 0 0 0 10px rgba(21,128,61,.12);">
                    <svg width="38" height="38" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                </span>
            </div>
            <h2>Password Set Successfully</h2>
            <p class="ws-auth-sub">Your account is now ready to sign in.</p>
            <a asp-action="Login" class="ws-btn" style="text-decoration: none;">
                Sign In Now
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </a>
            <div class="ws-secure">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                Protected by Supabase Auth &middot; Ready to sign in
            </div>
        </div>
    </main>
</div>
