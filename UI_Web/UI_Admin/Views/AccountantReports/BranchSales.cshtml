@model UI_Admin.Models.Accountant.BranchSalesReportViewModel
@{
    Layout = "_AccountantLayout";
    ViewData["Title"] = "Branch Sales Report";
    var admin = User.IsInRole("ADMIN");
}

<div class="flex flex-col w-full gap-unit-4 px-7 py-4">
    <!-- Header Title & Action Bar -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-unit-4">
        <div class="flex flex-col">
            <div class="list-eyebrow">Reports & Analytics</div>
            <div class="flex items-center gap-unit-3">
                <h1 class="font-display-lg text-display-lg text-on-surface tracking-tight">Branch Sales Report</h1>
            </div>
            <p class="font-body-md text-body-md text-secondary mt-1">@(admin ? "Export sales data by branch and date range." : "Export sales data for your assigned branch by date range.")</p>
        </div>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="bg-red-50 border border-red-200 text-red-800 px-4 py-3 rounded-xl text-sm font-medium flex items-center gap-2">
            <span class="material-symbols-outlined text-[20px]">error</span>
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-5">
        <form method="get" asp-action="ExportBranchSales" class="flex flex-col gap-4">
            <div class="grid grid-cols-1 sm:grid-cols-@(admin ? "4" : "3") gap-4">
                <div>
                    <label class="block text-xs font-medium text-slate-700 mb-1">Branch @(admin ? Html.Raw("<span class=\"text-red-500\">*</span>") : null)</label>
                    @if (admin)
                    {
                        <select name="branchId" required class="w-full h-10 px-3 rounded-lg border border-slate-300 text-sm">
                            <option value="">-- Select Branch --</option>
                            @foreach (var branch in Model.Branches)
                            {
                                <option value="@branch.Id" selected="@(Model.SelectedBranchId == branch.Id)">@branch.Name</option>
                            }
                        </select>
                    }
                    else
                    {
                        <div class="w-full h-10 px-3 rounded-lg border border-slate-200 bg-slate-50 text-slate-700 text-sm flex items-center gap-2">
                            <span class="material-symbols-outlined text-[18px] text-slate-400">store</span>
                            <span id="branchNameDisplay" class="font-medium text-slate-900">@(string.IsNullOrWhiteSpace(Model.BranchName) ? (ViewBag.BranchName ?? "Your Assigned Branch") : Model.BranchName)</span>
                        </div>
                    }
                </div>
                <div>
                    <label class="block text-xs font-medium text-slate-700 mb-1">From Date</label>
                    <input type="date" name="dateFrom" value="@Model.DateFrom?.ToString("yyyy-MM-dd")" class="w-full h-10 px-3 rounded-lg border border-slate-300 text-sm" />
                </div>
                <div>
                    <label class="block text-xs font-medium text-slate-700 mb-1">To Date</label>
                    <input type="date" name="dateTo" value="@Model.DateTo?.ToString("yyyy-MM-dd")" class="w-full h-10 px-3 rounded-lg border border-slate-300 text-sm" />
                </div>
            </div>

            <div id="totalOrdersAlert" class="hidden p-4 rounded-xl border text-sm flex items-center gap-2 transition-all">
                <span class="material-symbols-outlined text-[20px]" id="totalOrdersIcon">info</span>
                <span id="totalOrdersText" class="font-medium"></span>
            </div>

            <div class="flex items-center gap-3">
                <button type="button" id="btnTotalOrders" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 text-sm font-semibold transition-colors cursor-pointer border border-slate-300 shadow-sm">
                    <span class="material-symbols-outlined text-[18px] text-indigo-600">receipt_long</span>
                    Total Orders
                </button>
                <button type="submit" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold transition-colors cursor-pointer shadow-sm">
                    <span class="material-symbols-outlined text-[18px]">download</span>
                    Export Excel
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('btnTotalOrders').addEventListener('click', async function () {
            const dateFrom = document.querySelector('input[name="dateFrom"]').value;
            const dateTo = document.querySelector('input[name="dateTo"]').value;
            const branchSelect = document.querySelector('select[name="branchId"]');
            const branchId = branchSelect ? branchSelect.value : null;

            const btn = this;
            const alertBox = document.getElementById('totalOrdersAlert');
            const alertText = document.getElementById('totalOrdersText');
            const alertIcon = document.getElementById('totalOrdersIcon');

            if (branchSelect && !branchId) {
                alertBox.className = 'p-4 rounded-xl border border-red-200 bg-red-50 text-red-800 text-sm flex items-center gap-2';
                alertIcon.textContent = 'error';
                alertText.textContent = 'Please select a branch first.';
                alertBox.classList.remove('hidden');
                return;
            }

            if (dateFrom && dateTo && dateFrom > dateTo) {
                alertBox.className = 'p-4 rounded-xl border border-red-200 bg-red-50 text-red-800 text-sm flex items-center gap-2';
                alertIcon.textContent = 'error';
                alertText.textContent = 'The start date cannot be after the end date.';
                alertBox.classList.remove('hidden');
                return;
            }

            const originalHtml = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<span class="inline-block animate-spin mr-1">↻</span> Counting...';

            try {
                const params = new URLSearchParams();
                if (branchId) params.append('branchId', branchId);
                if (dateFrom) params.append('dateFrom', dateFrom);
                if (dateTo) params.append('dateTo', dateTo);

                const res = await fetch(`@Url.Action("CountOrders", "AccountantReports")?${params.toString()}`);
                const data = await res.json();
                if (data.success) {
                    alertBox.className = 'p-4 rounded-xl border border-emerald-200 bg-emerald-50 text-emerald-800 text-sm flex items-center gap-2';
                    alertIcon.textContent = 'check_circle';
                    alertText.textContent = data.message || `${data.totalOrders} orders have been found.`;
                    alertBox.classList.remove('hidden');
                    if (data.branchName) {
                        const bDisplay = document.getElementById('branchNameDisplay');
                        if (bDisplay) bDisplay.textContent = data.branchName;
                    }
                } else {
                    alertBox.className = 'p-4 rounded-xl border border-red-200 bg-red-50 text-red-800 text-sm flex items-center gap-2';
                    alertIcon.textContent = 'error';
                    alertText.textContent = data.message || 'Could not fetch order count.';
                    alertBox.classList.remove('hidden');
                }
            } catch (err) {
                alertBox.className = 'p-4 rounded-xl border border-red-200 bg-red-50 text-red-800 text-sm flex items-center gap-2';
                alertIcon.textContent = 'error';
                alertText.textContent = 'An error occurred while counting orders.';
                alertBox.classList.remove('hidden');
            } finally {
                btn.disabled = false;
                btn.innerHTML = originalHtml;
            }
        });
    </script>
}