@model UI_Admin.Models.Catalog.ProductDetailViewModel

@{
    ViewData["Title"] = $"Product - {Model.ProductName}";
    var canWrite = User.IsInRole("MANAGER");
    var isActive = Model.Status.Equals("ACTIVE", StringComparison.OrdinalIgnoreCase);
}

<div class="flex flex-col w-full gap-unit-4 px-7 py-4">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-unit-4">
        <div class="flex items-center gap-unit-3">
            <a asp-controller="Products" asp-action="Index" class="inline-flex items-center justify-center h-9 w-9 rounded-xl bg-surface-container-lowest hover:bg-surface-container text-secondary hover:text-on-surface transition-colors shadow-sm" title="Back">
                <span class="material-symbols-outlined text-[20px]">arrow_back</span>
            </a>
            <div class="flex flex-col">
                <div class="list-eyebrow">Product Catalog</div>
                <h1 class="font-display-lg text-display-lg text-on-surface tracking-tight">@Model.ProductName</h1>
            </div>
            @if (isActive)
            {
                <span class="inline-flex items-center gap-1.5 h-6 px-2 rounded-full text-label-sm font-label-sm bg-emerald-50 text-emerald-700">Active</span>
            }
            else
            {
                <span class="inline-flex items-center gap-1.5 h-6 px-2 rounded-full text-label-sm font-label-sm bg-surface-container text-secondary">Inactive</span>
            }
        </div>
        @if (canWrite)
        {
            <div class="flex items-center gap-unit-3 self-start md:self-auto">
                <a asp-controller="Products" asp-action="Edit" asp-route-id="@Model.ProductId" class="inline-flex items-center justify-center gap-unit-2 h-[40px] px-unit-4 rounded-xl bg-surface-container hover:bg-surface-container-high text-on-surface font-body-md-medium text-body-md-medium transition-colors shadow-sm">
                    <span class="material-symbols-outlined text-[20px]">edit</span>
                    <span>Edit</span>
                </a>
            </div>
        }
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-unit-4">
        <!-- General Info -->
        <div class="bg-surface-container-lowest rounded-xl shadow-sm p-unit-6">
            <div class="flex items-center gap-2.5 pb-unit-4 border-b border-surface-container-highest">
                <span class="p-2 rounded-lg bg-surface-container text-primary flex items-center justify-center">
                    <span class="material-symbols-outlined text-[20px]">inventory_2</span>
                </span>
                <h2 class="font-title-md text-title-md text-on-surface">General Information</h2>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-y-unit-4 gap-x-unit-6 pt-unit-4">
                <div class="flex flex-col">
                    <span class="font-label-sm text-secondary uppercase tracking-wider text-[11px]">Product Code</span>
                    <div class="mt-0.5">
                        <span class="font-code-num text-code-num text-primary font-semibold bg-surface-container px-2 py-1 rounded">@Model.ProductCode</span>
                    </div>
                </div>
                <div class="flex flex-col">
                    <span class="font-label-sm text-secondary uppercase tracking-wider text-[11px]">Price</span>
                    <span class="font-body-md-medium text-on-surface text-body-md mt-0.5 font-code-num font-semibold">@UI_Admin.Helpers.CurrencyHelper.FormatVnd(Model.Price)</span>
                </div>
                <div class="flex flex-col sm:col-span-2">
                    <span class="font-label-sm text-secondary uppercase tracking-wider text-[11px]">Product Name</span>
                    <span class="font-body-md-medium text-on-surface text-body-md mt-0.5 font-semibold">@Model.ProductName</span>
                </div>
                <div class="flex flex-col sm:col-span-2">
                    <span class="font-label-sm text-secondary uppercase tracking-wider text-[11px]">Description</span>
                    <span class="font-body-md text-on-surface text-body-md mt-0.5">@(string.IsNullOrWhiteSpace(Model.Description) ? "No description provided." : Model.Description)</span>
                </div>
            </div>
        </div>

        <!-- Catalog Info -->
        <div class="bg-surface-container-lowest rounded-xl shadow-sm p-unit-6">
            <div class="flex items-center gap-2.5 pb-unit-4 border-b border-surface-container-highest">
                <span class="p-2 rounded-lg bg-surface-container text-primary flex items-center justify-center">
                    <span class="material-symbols-outlined text-[20px]">category</span>
                </span>
                <h2 class="font-title-md text-title-md text-on-surface">Catalog Information</h2>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-y-unit-4 gap-x-unit-6 pt-unit-4">
                <div class="flex flex-col">
                    <span class="font-label-sm text-secondary uppercase tracking-wider text-[11px]">Branch</span>
                    <span class="font-body-md-medium text-on-surface text-body-md mt-0.5 font-semibold">@Model.BranchName</span>
                </div>
                <div class="flex flex-col">
                    <span class="font-label-sm text-secondary uppercase tracking-wider text-[11px]">Category</span>
                    <a asp-controller="Categories" asp-action="Details" asp-route-id="@Model.CategoryId" class="font-body-md-medium text-primary text-body-md mt-0.5 hover:underline">@Model.CategoryName</a>
                </div>
                <div class="flex flex-col">
                    <span class="font-label-sm text-secondary uppercase tracking-wider text-[11px]">Status</span>
                    <span class="font-body-md-medium text-body-md mt-0.5 font-semibold @(isActive ? "text-emerald-700" : "text-secondary")">@Model.Status</span>
                </div>
                <div class="flex flex-col sm:col-span-2">
                    <span class="font-label-sm text-secondary uppercase tracking-wider text-[11px]">Image</span>
                    @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl" alt="@Model.ProductName" class="mt-1 max-h-48 rounded-xl border border-surface-container-high object-contain" />
                    }
                    else
                    {
                        <span class="font-body-md text-secondary text-body-md mt-0.5 italic">No image provided.</span>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
