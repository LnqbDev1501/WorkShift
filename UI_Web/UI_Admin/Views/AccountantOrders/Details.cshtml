@model UI_Admin.Models.Accountant.AccountantOrderDetailViewModel
@{
    Layout = "_AccountantLayout";
    ViewData["Title"] = "Order Details";
}

<div class="flex flex-col w-full gap-unit-4 px-7 py-6 mx-auto" style="max-width: 1496px;">
    <div class="flex items-center">
        <a asp-action="Index" class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-white hover:bg-slate-50 text-slate-700 font-semibold text-sm transition-all border border-slate-200 shadow-sm">
            <span class="material-symbols-outlined text-[18px]">arrow_back</span>
            <span>Back to Orders</span>
        </a>
    </div>
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-unit-4 pb-2">
        <div class="flex items-center gap-3">
            <div class="flex flex-col">
                <div class="list-eyebrow">Order Management</div>
                <h1 class="font-display-lg text-display-lg text-on-surface tracking-tight">@Model.OrderNumber</h1>
                <p class="font-body-md text-secondary mt-0.5">Order details and invoice.</p>
            </div>
        </div>
        <div class="flex items-center gap-2">
            <a asp-action="Invoice" asp-route-id="@Model.OrderId" target="_blank"
                class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-primary-container hover:bg-primary text-white text-sm font-semibold transition-colors shadow-sm">
                <span class="material-symbols-outlined text-[18px]">receipt_long</span>
                View Invoice
            </a>
            <a asp-action="ExportInvoice" asp-route-id="@Model.OrderId"
                class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-semibold transition-colors shadow-sm">
                <span class="material-symbols-outlined text-[18px]">download</span>
                Export PDF
            </a>
        </div>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="bg-red-50 border border-red-200 text-red-800 px-4 py-3 rounded-xl text-sm font-medium flex items-center gap-2">
            <span class="material-symbols-outlined text-[20px]">error</span>
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 space-y-6">
            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
                <div class="px-5 py-4 border-b border-slate-100">
                    <h2 class="font-semibold text-slate-900">Order Items</h2>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-left">
                        <thead>
                            <tr class="bg-slate-50/80 border-b border-slate-200 text-slate-500 text-xs uppercase font-semibold">
                                <th class="px-5 py-3">Product</th>
                                <th class="px-4 py-3">Unit Price</th>
                                <th class="px-4 py-3">Qty</th>
                                <th class="px-4 py-3">Discount</th>
                                <th class="px-5 py-3 text-right">Total</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            @foreach (var item in Model.Items)
                            {
                                <tr class="hover:bg-slate-50/50">
                                    <td class="px-5 py-3.5 font-medium text-slate-900">@item.ProductName</td>
                                    <td class="px-4 py-3.5 text-slate-600">@CurrencyHelper.FormatVnd(item.UnitPrice)</td>
                                    <td class="px-4 py-3.5 text-slate-600">@item.Quantity</td>
                                    <td class="px-4 py-3.5 text-slate-600">@CurrencyHelper.FormatVnd(item.DiscountAmount)</td>
                                    <td class="px-5 py-3.5 text-right font-semibold text-slate-900">@CurrencyHelper.FormatVnd(item.TotalAmount)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="px-5 py-4 border-t border-slate-100 bg-slate-50/50 space-y-2">
                    <div class="flex justify-between text-sm">
                        <span class="text-slate-600">Subtotal</span>
                        <span class="font-medium">@CurrencyHelper.FormatVnd(Model.Subtotal)</span>
                    </div>
                    <div class="flex justify-between text-base font-bold">
                        <span>Total</span>
                        <span class="text-indigo-600">@CurrencyHelper.FormatVnd(Model.TotalAmount)</span>
                    </div>
                </div>
            </div>

            @if (Model.Payments.Any())
            {
                <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
                    <div class="px-5 py-4 border-b border-slate-100">
                        <h2 class="font-semibold text-slate-900">Payments</h2>
                    </div>
                    <div class="divide-y divide-slate-100">
                        @foreach (var payment in Model.Payments)
                        {
                            <div class="px-5 py-3.5 flex items-center justify-between">
                                <div>
                                    <p class="font-medium text-slate-900">@payment.PaymentMethod</p>
                                    <p class="text-xs text-slate-500">@payment.RecordedAt.ToString("dd/MM/yyyy HH:mm") — @payment.RecordedByName</p>
                                </div>
                                <span class="font-semibold text-emerald-600">@CurrencyHelper.FormatVnd(payment.Amount)</span>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <div>
            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
                <div class="px-5 py-4 border-b border-slate-100">
                    <h2 class="font-semibold text-slate-900">Order Info</h2>
                </div>
                <div class="px-5 py-4 space-y-3">
                    <div class="flex justify-between text-sm">
                        <span class="text-slate-500">Status</span>
                        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold @GetStatusColor(Model.Status)">@Model.Status</span>
                    </div>
                    <div class="flex justify-between text-sm">
                        <span class="text-slate-500">Payment</span>
                        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold @GetPaymentColor(Model.PaymentStatus)">@Model.PaymentStatus</span>
                    </div>
                    <div class="flex justify-between text-sm">
                        <span class="text-slate-500">Branch</span>
                        <span class="font-medium">@Model.BranchName</span>
                    </div>
                    <div class="flex justify-between text-sm">
                        <span class="text-slate-500">Staff</span>
                        <span class="font-medium">@Model.CreatedByName</span>
                    </div>
                    <div class="flex justify-between text-sm">
                        <span class="text-slate-500">Date</span>
                        <span class="font-medium">@Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</span>
                    </div>
                    @if (Model.PaidAt.HasValue)
                    {
                        <div class="flex justify-between text-sm">
                            <span class="text-slate-500">Paid At</span>
                            <span class="font-medium text-emerald-600">@Model.PaidAt.Value.ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@functions {
    string GetStatusColor(string status) => status.ToUpperInvariant() switch
    {
        "PENDING" => "bg-blue-50 text-blue-700",
        "COMPLETED" => "bg-emerald-50 text-emerald-700",
        "CANCELLED" => "bg-red-50 text-red-700",
        _ => "bg-slate-100 text-slate-600"
    };
    string GetPaymentColor(string status) => status.ToUpperInvariant() switch
    {
        "PAID" => "bg-emerald-50 text-emerald-700",
        "PARTIAL" => "bg-amber-50 text-amber-700",
        "UNPAID" => "bg-red-50 text-red-700",
        _ => "bg-slate-100 text-slate-600"
    };
}