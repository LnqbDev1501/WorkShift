@model UI_Admin.Models.Accountant.AccountantOrderListViewModel
@{
    Layout = "_AccountantLayout";
    ViewData["Title"] = "Orders";
}

<div class="flex flex-col gap-6 px-4 sm:px-7 py-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold text-slate-900">Orders</h1>
            <p class="text-slate-500 text-sm mt-0.5">@(User.IsInRole("ADMIN") ? "View all customer orders across branches." : "View customer orders in your assigned branch.")</p>
        </div>
    </div>

    <partial name="_ListMetrics" model='@(new ListMetricViewModel[] {
        new("Matching orders", Model.TotalItems.ToString("N0"), "Matching current filters", "shopping_bag"),
        new("Paid", Model.Items.Count(x => x.PaymentStatus == "PAID").ToString("N0"), "On this page", "payments"),
        new("Completed", Model.Items.Count(x => x.Status == "COMPLETED").ToString("N0"), "On this page", "task_alt"),
        new("Order value", Model.Items.Sum(x => x.TotalAmount).ToString("N0"), "VND on this page", "receipt_long")
    })' />
    <form method="get" asp-action="Index" class="ws-list-filter" role="search">
        <div class="ws-filter-row">
            <label class="ws-filter-field ws-filter-keyword"><span class="material-symbols-outlined" aria-hidden="true">search</span><input aria-label="Search" type="text" name="search" value="@Model.Search" placeholder="Order # or staff..." /></label>
            @if (User.IsInRole("ADMIN"))
            {
                <div class="ws-filter-field"><select aria-label="Branch" name="branchId">
                            <option value="">All Branches</option>
                            @foreach (var branch in Model.Branches)
                            {
                                <option value="@branch.Id" selected="@(Model.BranchId == branch.Id)">@branch.Name</option>
                            }
                        </select></div>
            }
            <div class="ws-filter-field"><select aria-label="Status" name="status">
                        <option value="all">All Statuses</option>
                        <option value="PENDING" selected="@(Model.StatusFilter == "PENDING")">Pending</option>
                        <option value="COMPLETED" selected="@(Model.StatusFilter == "COMPLETED")">Completed</option>
                        <option value="CANCELLED" selected="@(Model.StatusFilter == "CANCELLED")">Cancelled</option>
                    </select></div>
            <div class="ws-filter-field"><select aria-label="Payment status" name="paymentStatus">
                        <option value="all">All Payment</option>
                        <option value="PAID" selected="@(Model.PaymentStatusFilter == "PAID")">Paid</option>
                        <option value="PARTIAL" selected="@(Model.PaymentStatusFilter == "PARTIAL")">Partial</option>
                        <option value="UNPAID" selected="@(Model.PaymentStatusFilter == "UNPAID")">Unpaid</option>
                    </select></div>
            <details class="ws-filter-advanced">
                <summary title="Advanced filters" aria-label="Advanced filters"><span class="material-symbols-outlined" aria-hidden="true">tune</span>
                    @if (Context.Request.Query.Any(q => new[] { "dateFrom" }.Contains(q.Key, StringComparer.OrdinalIgnoreCase) && !string.IsNullOrWhiteSpace(q.Value.ToString()))) { <span class="ws-filter-indicator" aria-label="Advanced filters active"></span> }
                </summary>
                <div class="ws-filter-panel">
                    <label class="ws-filter-field"><span>Order date from</span><input aria-label="Order date from" type="date" name="dateFrom" value="@(Model.DateFrom?.ToString("yyyy-MM-dd"))" /></label>
                    <button type="submit" class="ws-filter-apply">Apply filters</button>
                </div>
            </details>
            <partial name="_ListFilterActions" model='"Index"' />
        </div>
    </form>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="bg-red-50 border border-red-200 text-red-800 px-4 py-3 rounded-xl text-sm font-medium flex items-center gap-2">
            <span class="material-symbols-outlined text-[20px]">error</span>
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-slate-50/80 border-b border-slate-200 text-slate-500 text-xs uppercase tracking-wider font-semibold">
                        <th class="px-5 py-3.5">Order #</th>
                        <th class="px-4 py-3.5">Branch</th>
                        <th class="px-4 py-3.5">Staff</th>
                        <th class="px-4 py-3.5">Date</th>
                        <th class="px-4 py-3.5">Items</th>
                        <th class="px-4 py-3.5">Total</th>
                        <th class="px-4 py-3.5">Payment</th>
                        <th class="px-4 py-3.5">Status</th>
                        <th class="px-5 py-3.5 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @if (!Model.Items.Any())
                    {
                        <tr>
                            <td colspan="9" class="px-6 py-14 text-center">
                                <div class="flex flex-col items-center gap-2.5 text-slate-400">
                                    <span class="material-symbols-outlined text-[48px] text-slate-300">receipt_long</span>
                                    <p class="font-medium text-slate-600 text-sm">No orders found.</p>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var order in Model.Items)
                        {
                            <tr class="hover:bg-slate-50/80 transition-colors">
                                <td class="px-5 py-4 font-medium text-slate-900">@order.OrderNumber</td>
                                <td class="px-4 py-4 text-slate-600">@order.BranchName</td>
                                <td class="px-4 py-4 text-slate-600">@order.CreatedByName</td>
                                <td class="px-4 py-4 text-slate-600">@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="px-4 py-4 text-slate-600">@order.ItemCount</td>
                                <td class="px-4 py-4 font-semibold text-slate-900">@order.TotalAmount.ToString("N0") VND</td>
                                <td class="px-4 py-4">
                                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold @GetPaymentColor(order.PaymentStatus)">
                                        @order.PaymentStatus
                                    </span>
                                </td>
                                <td class="px-4 py-4">
                                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold @GetStatusColor(order.Status)">
                                        @order.Status
                                    </span>
                                </td>
                                <td class="px-5 py-4 text-right">
                                    <a asp-action="Details" asp-route-id="@order.OrderId" title="View details" aria-label="View details" class="ws-icon-action"><span class="material-symbols-outlined" aria-hidden="true">visibility</span></a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <partial name="_ListPagination" model="@(new ListPaginationViewModel
        {
            PageNumber = Model.PageNumber,
            PageSize = Model.PageSize,
            TotalItems = Model.TotalItems,
            PageParameter = "page",
            ItemLabel = "orders",
        })" />
    </div>
</div>

@functions {
    string GetStatusColor(string status) => status.ToUpperInvariant() switch
    {
        "PENDING" => "bg-blue-50 text-blue-700",
        "COMPLETED" => "bg-emerald-50 text-emerald-700",
        "CANCELLED" => "bg-red-50 text-red-700",
        _ => "bg-slate-100 text-slate-600"
    };
    string GetPaymentColor(string status) => status.ToUpperInvariant() switch
    {
        "PAID" => "bg-emerald-50 text-emerald-700",
        "PARTIAL" => "bg-amber-50 text-amber-700",
        "UNPAID" => "bg-red-50 text-red-700",
        _ => "bg-slate-100 text-slate-600"
    };
}