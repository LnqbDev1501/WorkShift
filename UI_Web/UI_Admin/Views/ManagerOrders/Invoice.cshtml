@model UI_Admin.Models.Manager.ManagerOrderDetailViewModel
@{
    Layout = "_ManagerLayout";
    ViewData["Title"] = "Order Invoice";
}

<div class="flex flex-col gap-6 max-w-3xl mx-auto w-full px-7 py-4 print:p-0">
    <div class="flex items-center justify-between print:hidden">
        <div>
            <h1 class="text-2xl font-bold text-slate-900">Invoice</h1>
            <p class="text-slate-500 text-sm mt-0.5 break-words break-all">@Model.OrderNumber</p>
        </div>
        <div class="flex items-center gap-2">
            <button type="button" onclick="window.print()"
                class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-slate-900 hover:bg-slate-800 text-white text-sm font-semibold transition-colors cursor-pointer">
                <span class="material-symbols-outlined text-[18px]">print</span>
                Print
            </button>
            <a asp-action="ExportInvoice" asp-route-id="@Model.OrderId"
                class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold transition-colors">
                <span class="material-symbols-outlined text-[18px]">download</span>
                Export PDF
            </a>
            <a asp-action="Details" asp-route-id="@Model.OrderId"
                class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-slate-300 text-slate-700 hover:bg-slate-50 text-sm font-medium transition-colors">
                <span class="material-symbols-outlined text-[18px]">arrow_back</span>
                Back
            </a>
        </div>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-8">
        <div class="text-center border-b border-slate-200 pb-5">
            <h2 class="text-xl font-bold text-slate-900 tracking-wide">PAYMENT INVOICE</h2>
            <p class="text-slate-500 text-sm mt-1 break-words break-all">Order number: @Model.OrderNumber</p>
        </div>

        <div class="grid grid-cols-2 gap-4 py-5 text-sm border-b border-slate-100">
            <div>
                <span class="block text-xs uppercase tracking-wider text-slate-400 font-semibold">Branch</span>
                <span class="font-medium text-slate-900">@Model.BranchName</span>
            </div>
            <div>
                <span class="block text-xs uppercase tracking-wider text-slate-400 font-semibold">Date</span>
                <span class="font-medium text-slate-900">@Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</span>
            </div>
            <div>
                <span class="block text-xs uppercase tracking-wider text-slate-400 font-semibold">Staff</span>
                <span class="font-medium text-slate-900">@Model.CreatedByName</span>
            </div>
            <div>
                <span class="block text-xs uppercase tracking-wider text-slate-400 font-semibold">Payment</span>
                <span class="font-medium text-emerald-600">@Model.PaymentStatus</span>
            </div>
        </div>

        <table class="w-full text-left mt-5">
            <thead>
                <tr class="text-slate-500 text-xs uppercase font-semibold border-b border-slate-200">
                    <th class="py-2.5">Products</th>
                    <th class="py-2.5 text-right">Unit price</th>
                    <th class="py-2.5 text-center">Qty</th>
                    <th class="py-2.5 text-right">Amount</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 text-sm">
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td class="py-3 font-medium text-slate-900 break-words max-w-xs" title="@item.ProductName">@(item.ProductName != null && item.ProductName.Length > 50 ? item.ProductName.Substring(0, 50) + "..." : item.ProductName)</td>
                        <td class="py-3 text-right text-slate-600">@CurrencyHelper.FormatVnd(item.UnitPrice)</td>
                        <td class="py-3 text-center text-slate-600">@item.Quantity</td>
                        <td class="py-3 text-right font-semibold text-slate-900">@CurrencyHelper.FormatVnd(item.TotalAmount)</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="flex flex-col items-end gap-1.5 mt-5 pt-4 border-t border-slate-200 text-sm">
            <div class="flex justify-between w-64">
                <span class="text-slate-500">Subtotal</span>
                <span class="font-medium">@CurrencyHelper.FormatVnd(Model.Subtotal)</span>
            </div>
            <div class="flex justify-between w-64 text-base font-bold">
                <span>Total</span>
                <span class="text-indigo-600">@CurrencyHelper.FormatVnd(Model.TotalAmount)</span>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Note))
        {
            <div class="mt-6 pt-4 border-t border-slate-100">
                <span class="block text-xs uppercase tracking-wider text-slate-400 font-semibold mb-1">Notes</span>
                <p class="text-sm text-slate-600">@Model.Note</p>
            </div>
        }

        <p class="text-center text-xs text-slate-400 italic mt-8">Thank you for your business!</p>
    </div>
</div>
