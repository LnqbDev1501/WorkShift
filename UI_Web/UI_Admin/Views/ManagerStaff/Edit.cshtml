@model UI_Admin.Models.Catalog.EditStaffAccountViewModel

@{
    ViewData["Title"] = "Edit Staff Account";
}

<div class="flex flex-col w-full gap-unit-4 px-7 py-4">
    <div class="max-w-5xl mx-auto w-full flex flex-col gap-unit-4">
        <div class="flex items-center gap-unit-3">
            <a asp-controller="ManagerStaff" asp-action="Index" class="inline-flex items-center justify-center h-9 w-9 rounded-xl bg-surface-container-lowest hover:bg-surface-container text-secondary hover:text-on-surface transition-colors shadow-sm" title="Cancel">
                <span class="material-symbols-outlined text-[20px]">close</span>
            </a>
            <div class="flex flex-col">
                <div class="list-eyebrow">Staff Management</div>
                <h1 class="font-display-lg text-display-lg text-on-surface tracking-tight">Edit Staff Account</h1>
            </div>
        </div>

        <div class="w-full bg-surface-container-lowest rounded-2xl shadow-sm p-6 sm:p-8 border border-slate-200">
            <form method="post" asp-controller="ManagerStaff" asp-action="Edit" asp-route-id="@Model.UserId" enctype="multipart/form-data" class="flex flex-col gap-unit-4">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="UserId" />
                <input type="hidden" asp-for="Status" />
                <div asp-validation-summary="ModelOnly" class="text-error font-body-sm text-body-sm"></div>

                <div class="flex flex-col gap-unit-2">
                    <label class="font-label-md text-label-md text-on-surface">Email</label>
                    <div>
                        <span class="font-body-md-medium text-on-surface text-body-md break-all">@Model.Email</span>
                    </div>
                </div>

                <div class="flex flex-col gap-unit-2">
                    <label asp-for="FullName" class="font-label-md text-label-md text-on-surface">Full Name <span class="text-error">*</span></label>
                    <input asp-for="FullName" class="w-full h-[40px] px-unit-3 bg-surface-container-lowest border border-surface-container-high rounded-xl text-on-surface font-body-md text-body-md placeholder:text-secondary focus:outline-none focus:ring-1 focus:ring-primary-container" type="text" />
                    <span asp-validation-for="FullName" class="text-error font-body-sm text-body-sm"></span>
                </div>

                <div class="flex flex-col gap-unit-2">
                    <label asp-for="Phone" class="font-label-md text-label-md text-on-surface">Phone <span class="text-error">*</span></label>
                    <input asp-for="Phone" class="w-full h-[40px] px-unit-3 bg-surface-container-lowest border border-surface-container-high rounded-xl text-on-surface font-body-md text-body-md focus:outline-none focus:ring-1 focus:ring-primary-container" type="tel" inputmode="numeric" maxlength="10" oninput="this.value = this.value.replace(/[^0-9]/g, '')" />
                    <span asp-validation-for="Phone" class="text-error font-body-sm text-body-sm"></span>
                </div>

                <div class="flex flex-col gap-unit-2">
                    <label asp-for="IdentityNo" class="font-label-md text-label-md text-on-surface">Identity No <span class="text-error">*</span></label>
                    <input asp-for="IdentityNo" class="w-full h-[40px] px-unit-3 bg-surface-container-lowest border border-surface-container-high rounded-xl text-on-surface font-body-md text-body-md focus:outline-none focus:ring-1 focus:ring-primary-container font-code-num text-code-num" placeholder="e.g. 079099012345" type="text" inputmode="numeric" maxlength="12" oninput="this.value = this.value.replace(/[^0-9]/g, '').slice(0, 12)" onkeypress="return event.charCode >= 48 && event.charCode <= 57" />
                    <span asp-validation-for="IdentityNo" class="text-error font-body-sm text-body-sm"></span>
                </div>

                <div class="flex flex-col gap-unit-2">
                    <label asp-for="DateOfBirth" class="font-label-md text-label-md text-on-surface">Date of Birth <span class="text-error">*</span></label>
                    <input asp-for="DateOfBirth" class="w-full h-[40px] px-unit-3 bg-surface-container-lowest border border-surface-container-high rounded-xl text-on-surface font-body-md text-body-md focus:outline-none focus:ring-1 focus:ring-primary-container" type="date" />
                    <span asp-validation-for="DateOfBirth" class="text-error font-body-sm text-body-sm"></span>
                </div>

                <div class="flex flex-col gap-unit-2">
                    <label asp-for="Address" class="font-label-md text-label-md text-on-surface">Address <span class="text-error">*</span></label>
                    <textarea asp-for="Address" rows="3" class="w-full px-unit-3 py-2 bg-surface-container-lowest border border-surface-container-high rounded-xl text-on-surface font-body-md text-body-md focus:outline-none focus:ring-1 focus:ring-primary-container"></textarea>
                    <span asp-validation-for="Address" class="text-error font-body-sm text-body-sm"></span>
                </div>

                <div class="flex items-center gap-unit-2 p-unit-3 bg-surface-container-low rounded-xl">
                    <span class="font-label-sm text-secondary uppercase tracking-wider text-[11px]">Status:</span>
                    <span class="font-body-md-medium text-body-md-medium @(Model.Status == "ACTIVE" ? "text-emerald-700" : "text-secondary")">@Model.Status</span>
                </div>

                <div class="flex items-center justify-end gap-unit-3 pt-unit-2">
                    <a asp-controller="ManagerStaff" asp-action="Index" class="inline-flex items-center justify-center h-[40px] px-unit-4 rounded-xl bg-surface-container hover:bg-surface-container-high text-on-surface font-body-md-medium text-body-md-medium transition-colors">Cancel</a>
                    <button type="submit" class="inline-flex items-center justify-center gap-unit-2 h-[40px] px-unit-4 rounded-xl bg-primary-container hover:bg-primary text-on-primary font-body-md-medium text-body-md-medium transition-colors shadow-sm cursor-pointer">
                        <span class="material-symbols-outlined text-[20px]">save</span>
                        <span>Save Changes</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
