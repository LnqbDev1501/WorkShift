@model UI_Admin.Models.Catalog.EditStaffAccountViewModel

@{
    ViewData["Title"] = $"Edit Staff - {Model.FullName}";
}

<div class="flex flex-col w-full gap-unit-4 px-7 py-6">
    <div class="max-w-[1440px] mx-auto w-full flex flex-col gap-unit-4">
        <div class="flex items-center">
            <a asp-controller="ManagerStaff" asp-action="Details" asp-route-id="@Model.UserId" class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-white hover:bg-slate-50 text-slate-700 font-semibold text-sm transition-all border border-slate-200 shadow-sm">
                <span class="material-symbols-outlined text-[18px]">arrow_back</span>
                <span>Back to Staff Details</span>
            </a>
        </div>

        <div class="flex items-center gap-unit-3">
            <div class="flex flex-col">
                <div class="list-eyebrow">Staff Management</div>
                <h1 class="font-display-lg text-display-lg text-on-surface tracking-tight">Edit Staff Account</h1>
            </div>
        </div>

        <div class="w-full bg-surface-container-lowest rounded-2xl shadow-sm p-6 sm:p-8 border border-slate-200">
            <form method="post" asp-controller="ManagerStaff" asp-action="Edit" asp-route-id="@Model.UserId" onsubmit="return validateStaffForm()" class="flex flex-col gap-unit-5">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="UserId" />
                <input type="hidden" asp-for="Status" />
                <div asp-validation-summary="ModelOnly" class="text-error font-body-sm text-body-sm"></div>

                <!-- Non-editable information section -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-unit-4 p-4 rounded-xl bg-surface-container-low border border-surface-container-high">
                    <div class="flex flex-col gap-1 min-w-0">
                        <span class="font-label-sm text-secondary uppercase tracking-wider text-[11px] flex items-center gap-1">
                            <span>Email Address</span>
                            <span class="material-symbols-outlined text-[14px] text-secondary" title="Locked">lock</span>
                        </span>
                        <span class="font-body-md-medium text-on-surface text-body-md break-all">@Model.Email</span>
                        <span class="text-[11px] text-secondary">Email cannot be modified by Manager.</span>
                    </div>

                    <div class="flex flex-col gap-1 min-w-0">
                        <span class="font-label-sm text-secondary uppercase tracking-wider text-[11px] flex items-center gap-1">
                            <span>National Citizen ID / CCCD</span>
                            <span class="material-symbols-outlined text-[14px] text-secondary" title="Locked">lock</span>
                        </span>
                        <span class="font-body-md-medium text-on-surface text-body-md font-code-num">@(string.IsNullOrWhiteSpace(Model.IdentityNo) ? "—" : Model.IdentityNo)</span>
                        <span class="text-[11px] text-secondary">Citizen identity number is fixed and cannot be modified by Manager.</span>
                    </div>
                </div>

                <!-- Editable Fields -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-y-unit-4 gap-x-unit-6">
                    <div class="flex flex-col gap-unit-2 sm:col-span-2">
                        <label asp-for="FullName" class="font-label-md text-label-md text-on-surface">Full Name <span class="text-error">*</span></label>
                        <input asp-for="FullName" id="staff-fullname" maxlength="150" required class="w-full h-[40px] px-unit-3 bg-surface-container-lowest border border-surface-container-high rounded-xl text-on-surface font-body-md text-body-md placeholder:text-secondary focus:outline-none focus:ring-1 focus:ring-primary-container" type="text" />
                        <span asp-validation-for="FullName" class="text-error font-body-sm text-body-sm text-xs text-red-500"></span>
                    </div>

                    <div class="flex flex-col gap-unit-2">
                        <label asp-for="Phone" class="font-label-md text-label-md text-on-surface">Mobile Phone <span class="text-error">*</span></label>
                        <input asp-for="Phone" id="staff-phone" class="w-full h-[40px] px-unit-3 bg-surface-container-lowest border border-surface-container-high rounded-xl text-on-surface font-body-md text-body-md focus:outline-none focus:ring-1 focus:ring-primary-container font-code-num" type="tel" inputmode="numeric" maxlength="10" placeholder="e.g. 0912345678" oninput="this.value = this.value.replace(/[^0-9]/g, '')" required />
                        <span asp-validation-for="Phone" class="text-error font-body-sm text-body-sm text-xs text-red-500"></span>
                        <span id="staff-phone-error" class="hidden text-error font-body-sm text-body-sm text-xs text-red-500 mt-1"></span>
                    </div>

                    <div class="flex flex-col gap-unit-2">
                        <label asp-for="Gender" class="font-label-md text-label-md text-on-surface">Gender <span class="text-error">*</span></label>
                        <select asp-for="Gender" required class="w-full h-[40px] px-unit-3 bg-surface-container-lowest border border-surface-container-high rounded-xl text-on-surface font-body-md text-body-md focus:outline-none focus:ring-1 focus:ring-primary-container cursor-pointer">
                            <option value="MALE">Male</option>
                            <option value="FEMALE">Female</option>
                            <option value="OTHER">Other</option>
                        </select>
                        <span asp-validation-for="Gender" class="text-error font-body-sm text-body-sm text-xs text-red-500"></span>
                    </div>

                    <div class="flex flex-col gap-unit-2">
                        <label asp-for="DateOfBirth" class="font-label-md text-label-md text-on-surface">Date of Birth <span class="text-error">*</span></label>
                        <input asp-for="DateOfBirth" id="staff-dob" min="1900-01-01" max="@DateTime.UtcNow.AddYears(-18).ToString("yyyy-MM-dd")" class="w-full h-[40px] px-unit-3 bg-surface-container-lowest border border-surface-container-high rounded-xl text-on-surface font-body-md text-body-md focus:outline-none focus:ring-1 focus:ring-primary-container" type="date" required />
                        <span asp-validation-for="DateOfBirth" class="text-error font-body-sm text-body-sm text-xs text-red-500"></span>
                        <span id="staff-dob-error" class="hidden text-error font-body-sm text-body-sm text-xs text-red-500 mt-1"></span>
                    </div>

                    <div class="flex flex-col gap-unit-2 sm:col-span-2">
                        <label asp-for="Address" class="font-label-md text-label-md text-on-surface">Residential Address <span class="text-error">*</span></label>
                        <textarea asp-for="Address" id="staff-address" rows="3" maxlength="500" required class="w-full px-unit-3 py-2 bg-surface-container-lowest border border-surface-container-high rounded-xl text-on-surface font-body-md text-body-md focus:outline-none focus:ring-1 focus:ring-primary-container"></textarea>
                        <span asp-validation-for="Address" class="text-error font-body-sm text-body-sm text-xs text-red-500"></span>
                    </div>
                </div>

                <div class="flex items-center gap-unit-2 p-unit-3 bg-surface-container-low rounded-xl">
                    <span class="font-label-sm text-secondary uppercase tracking-wider text-[11px]">Account Status:</span>
                    <span class="font-body-md-medium text-body-md-medium @(Model.Status == "ACTIVE" ? "text-emerald-700" : "text-amber-700")">@Model.Status</span>
                </div>

                <div class="flex items-center justify-end gap-unit-3 pt-unit-2 border-t border-slate-200">
                    <a asp-controller="ManagerStaff" asp-action="Details" asp-route-id="@Model.UserId" class="inline-flex items-center justify-center h-[40px] px-unit-4 rounded-xl bg-surface-container hover:bg-surface-container-high text-on-surface font-body-md-medium text-body-md-medium transition-colors">Cancel</a>
                    <button type="submit" class="inline-flex items-center justify-center gap-unit-2 h-[40px] px-unit-4 rounded-xl bg-primary-container hover:bg-primary text-on-primary font-body-md-medium text-body-md-medium transition-colors shadow-sm cursor-pointer">
                        <span class="material-symbols-outlined text-[20px]">save</span>
                        <span>Save Changes</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function validateStaffForm() {
            let isValid = true;
            const phoneInput = document.getElementById('staff-phone');
            const phoneError = document.getElementById('staff-phone-error');
            if (phoneInput) {
                const val = phoneInput.value.trim();
                const phoneRegex = /^(03[2-9]|05[689]|07[06-9]|08[1-689]|09[0134678])\d{7}$/;
                if (!phoneRegex.test(val)) {
                    if (phoneError) {
                        phoneError.innerText = 'Invalid phone number. Please enter a valid 10-digit Vietnamese mobile number (032-039, 056, 058, 059, 070, 076-079, 081-086, 088, 089, 090, 091, 093, 094, 096-098).';
                        phoneError.classList.remove('hidden');
                    }
                    phoneInput.focus();
                    isValid = false;
                } else if (phoneError) {
                    phoneError.classList.add('hidden');
                }
            }

            const dobInput = document.getElementById('staff-dob');
            const dobError = document.getElementById('staff-dob-error');
            if (dobInput && isValid) {
                const dobVal = dobInput.value;
                if (!dobVal) {
                    if (dobError) {
                        dobError.innerText = 'Date of birth is required.';
                        dobError.classList.remove('hidden');
                    }
                    dobInput.focus();
                    isValid = false;
                } else {
                    const dob = new Date(dobVal);
                    const minDate = new Date('1900-01-01');
                    const today = new Date();
                    const eighteenYearsAgo = new Date(today.getFullYear() - 18, today.getMonth(), today.getDate());

                    if (dob < minDate) {
                        if (dobError) {
                            dobError.innerText = 'Date of birth must be on or after January 1, 1900.';
                            dobError.classList.remove('hidden');
                        }
                        dobInput.focus();
                        isValid = false;
                    } else if (dob > today) {
                        if (dobError) {
                            dobError.innerText = 'Date of birth cannot be in the future.';
                            dobError.classList.remove('hidden');
                        }
                        dobInput.focus();
                        isValid = false;
                    } else if (dob > eighteenYearsAgo) {
                        if (dobError) {
                            dobError.innerText = 'Staff must be at least 18 years old.';
                            dobError.classList.remove('hidden');
                        }
                        dobInput.focus();
                        isValid = false;
                    } else if (dobError) {
                        dobError.classList.add('hidden');
                    }
                }
            }

            return isValid;
        }
    </script>
}
