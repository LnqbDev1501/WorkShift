@model UI_Admin.Models.PayrollCalculation.CalculationPreviewViewModel
@using D = UI_Admin.Models.Accountant.PayrollPeriods.PeriodDisplay
@{
    ViewData["Title"] = "Preview Payroll Calculation";
}

<div class="px-7 py-6 max-w-[1440px] mx-auto space-y-6">
    <!-- Header Title & Action Bar -->
    <div class="flex flex-col md:flex-row md:items-start justify-between gap-4">
        <div>
            <div class="flex items-center gap-1.5 text-xs text-indigo-600 font-semibold uppercase tracking-wider mb-1">
                <span class="material-symbols-outlined text-sm">preview</span>
                <span>Payroll / Calculation Preview</span>
            </div>
            <h1 class="text-2xl font-bold text-slate-900 tracking-tight">
                @(Model.UserId.HasValue ? "Employee Payroll Preview" : "Batch Calculation Preview")
            </h1>
            <p class="text-sm text-slate-500 mt-1">
                Period #@Model.PeriodId • Verify work pay, rewards, deductions, and Carry Forward before saving.
            </p>
        </div>
        <div class="flex items-center gap-3 shrink-0 flex-wrap">
            <a asp-action="Index" asp-route-id="@Model.PeriodId"
               class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-white hover:bg-slate-50 text-slate-700 hover:text-slate-900 border border-slate-200 text-sm font-medium transition-all shadow-sm">
                <span class="material-symbols-outlined text-lg">arrow_back</span>
                <span>Back to Workspace</span>
            </a>
            @if (Model.UserId.HasValue)
            {
                <a asp-action="Preview" asp-route-id="@Model.PeriodId"
                   class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold transition-all shadow-sm">
                    <span class="material-symbols-outlined text-base">groups</span>
                    <span>Preview Entire Period</span>
                </a>
            }
        </div>
    </div>

    <!-- Compliance / Not Saved Notice -->
    <div class="p-4 rounded-2xl bg-amber-50 border border-amber-200 text-amber-900 text-sm flex items-start gap-3 shadow-sm">
        <span class="material-symbols-outlined text-amber-600 text-xl shrink-0 mt-0.5">info</span>
        <div>
            <strong class="font-bold">Preview Calculation — Not Yet Saved</strong>
            <p class="text-xs text-amber-800 mt-0.5">
                This preview is computed in-memory and does not create database records or deduct Carry Forward balances. Upon final confirmation, the server validates all sources and records payroll in a single atomic transaction.
            </p>
        </div>
    </div>

    @if (Model.Error != null)
    {
        <div class="p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-sm flex items-center gap-3 shadow-sm">
            <span class="material-symbols-outlined text-rose-600 text-xl shrink-0">error</span>
            <span class="font-medium">@Model.Error</span>
        </div>
    }

    @if (Model.Inputs != null)
    {
        @foreach (var warning in Model.Inputs.Readiness.Warnings)
        {
            <div class="p-3.5 rounded-xl bg-amber-50 border border-amber-200 text-amber-800 text-xs flex items-center gap-2">
                <span class="material-symbols-outlined text-base text-amber-600">warning</span>
                <span>@warning</span>
            </div>
        }
    }

    @foreach (var employee in Model.FailedEmployees)
    {
        <div class="p-3.5 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-xs flex items-center gap-2">
            <span class="material-symbols-outlined text-base text-rose-600">cancel</span>
            <span><strong>@employee.EmployeeName</strong>: @string.Join(" • ", employee.BlockingReasons)</span>
        </div>
    }

    @if (Model.Inputs == null && Model.Payrolls.Count == 0 && Model.Error == null)
    {
        <div class="bg-white border border-slate-200 rounded-2xl p-12 text-center shadow-sm">
            <div class="w-14 h-14 bg-slate-100 rounded-2xl flex items-center justify-center mx-auto mb-4 text-slate-400">
                <span class="material-symbols-outlined text-3xl">info</span>
            </div>
            <h3 class="text-base font-bold text-slate-900">No Eligible Employees to Calculate</h3>
            <p class="text-xs text-slate-500 max-w-sm mx-auto mt-1">Check readiness conditions in the workspace or inspect existing saved payrolls.</p>
        </div>
    }

    @if (Model.Payrolls.Count > 1)
    {
        <div class="p-4 rounded-2xl bg-white border border-slate-200 shadow-sm flex items-center justify-between text-sm">
            <span class="font-semibold text-slate-700">@Model.Payrolls.Count Employees Previewed</span>
            <span class="font-bold text-slate-900 text-base">Estimated Net Total: @D.Money(Model.Payrolls.Sum(p => p.NetSalary))</span>
        </div>
    }
</div>

@if (Model.Inputs != null && Model.Payrolls.Count == 0)
{
    <partial name="~/Views/PayrollCalculation/_AvailableInputs.cshtml" model="Model.Inputs" />
}

@foreach (var payroll in Model.Payrolls)
{
    <partial name="~/Views/PayrollCalculation/_CalculationDetail.cshtml" model="payroll" />
}

@if (Model.UserId.HasValue)
{
    <div class="px-7 pb-6 max-w-[1440px] mx-auto">
        <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm">
            <h3 class="text-sm font-bold text-slate-900 mb-1">Batch Calculation Policy</h3>
            <p class="text-xs text-slate-500 mb-4">
                Initial period calculation must be performed for all employees simultaneously in a single transaction. Individual employee saves are disabled.
            </p>
            <a asp-action="Preview" asp-route-id="@Model.PeriodId"
               class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold shadow-sm transition-all">
                <span class="material-symbols-outlined text-sm">groups</span>
                <span>Preview &amp; Calculate All Staff</span>
            </a>
        </div>
    </div>
}
else if (Model.CanSave)
{
    <div class="px-7 pb-6 max-w-[1440px] mx-auto">
        <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm">
            <h3 class="text-base font-bold text-slate-900 mb-1">Confirm Initial Batch Calculation</h3>
            <p class="text-xs text-slate-500 mb-4">
                Review all previewed lines above. This review token is valid for 15 minutes. Upon confirmation, all employees will receive Payroll V1 (CALCULATED) and the period will advance to CALCULATED.
            </p>
            <button type="button" onclick="openModal('modalConfirmCalculate')"
                    class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-indigo-600 hover:bg-indigo-700 active:bg-indigo-800 text-white text-sm font-semibold shadow-sm transition-all cursor-pointer">
                <span class="material-symbols-outlined text-base">check_circle</span>
                <span>Confirm &amp; Calculate Period (Batch Calculate)</span>
            </button>
        </div>
    </div>

    <!-- Centered Confirmation Modal -->
    <div id="modalConfirmCalculate" class="fixed inset-0 z-50 hidden overflow-y-auto" role="dialog" aria-modal="true" aria-labelledby="modal-calc-title">
        <div class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs transition-opacity" onclick="closeModal('modalConfirmCalculate')"></div>
        <div class="flex min-h-full items-center justify-center p-4 text-center">
            <div class="relative transform overflow-hidden rounded-2xl bg-white text-left shadow-2xl transition-all sm:my-8 sm:w-full sm:max-w-lg border border-slate-200">
                <form method="post" asp-action="CalculatePeriod" asp-route-id="@Model.PeriodId" data-calculation-form onsubmit="return handleCalcSubmit(this)">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="reviewToken" value="@Model.ReviewToken" />
                    <div class="p-6">
                        <div class="flex items-center gap-4 mb-4">
                            <div class="w-12 h-12 rounded-2xl bg-indigo-50 border border-indigo-100 flex items-center justify-center text-indigo-600 shrink-0">
                                <span class="material-symbols-outlined text-2xl">calculate</span>
                            </div>
                            <div>
                                <h3 class="text-lg font-bold text-slate-900" id="modal-calc-title">Confirm Batch Calculation</h3>
                                <p class="text-xs text-slate-500">Period #@Model.PeriodId</p>
                            </div>
                        </div>

                        <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 text-xs mb-4 space-y-1">
                            <div class="font-medium text-slate-800">Execute initial batch payroll calculation for all eligible employees.</div>
                            <div class="text-slate-500">Review token expires in 15 minutes.</div>
                        </div>

                        <div class="p-3.5 rounded-xl bg-amber-50 border border-amber-200 text-xs text-amber-900 flex items-start gap-2.5">
                            <span class="material-symbols-outlined text-amber-600 text-base shrink-0 mt-0.5">warning</span>
                            <span>All eligible employees will receive Payroll Version 1 (CALCULATED), and the period will advance to CALCULATED.</span>
                        </div>
                    </div>

                    <div class="px-6 py-4 bg-slate-50 border-t border-slate-100 flex items-center justify-end gap-3">
                        <button type="button" onclick="closeModal('modalConfirmCalculate')"
                                class="px-4 py-2.5 rounded-xl bg-white hover:bg-slate-100 text-slate-700 border border-slate-200 text-sm font-semibold transition-all shadow-xs cursor-pointer">
                            Cancel
                        </button>
                        <button type="submit" id="btnConfirmBatchCalculate"
                                class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 active:bg-indigo-800 text-white text-sm font-semibold shadow-sm transition-all cursor-pointer">
                            <span class="material-symbols-outlined text-sm">check</span>
                            <span>Confirm Batch Calculation</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/payroll-calculation.js" asp-append-version="true"></script>
    <script>
        function openModal(id) {
            const modal = document.getElementById(id);
            if (modal) {
                modal.classList.remove('hidden');
                document.body.style.overflow = 'hidden';
            }
        }
        function closeModal(id) {
            const modal = document.getElementById(id);
            if (modal) {
                modal.classList.add('hidden');
                document.body.style.overflow = '';
            }
        }
        function handleCalcSubmit(form) {
            if (form.dataset.submitting === 'true') return false;
            form.dataset.submitting = 'true';
            const btn = document.getElementById('btnConfirmBatchCalculate');
            if (btn) {
                btn.disabled = true;
                btn.classList.add('opacity-75', 'cursor-not-allowed');
                btn.innerText = 'Calculating...';
            }
            return true;
        }
    </script>
}
