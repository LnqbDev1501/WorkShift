@model UI_Admin.Models.PayrollCalculation.CalculationInputResponse
@using D = UI_Admin.Models.Accountant.PayrollPeriods.PeriodDisplay

<div class="px-7 py-6 max-w-[1440px] mx-auto space-y-6">
    <!-- Header Title & Action Bar -->
    <div class="flex flex-col md:flex-row md:items-start justify-between gap-4">
        <div>
            <div class="flex items-center gap-1.5 text-xs text-indigo-600 font-semibold uppercase tracking-wider mb-1">
                <span class="material-symbols-outlined text-sm">source</span>
                <span>Payroll / Available Source Data</span>
            </div>
            <h1 class="text-2xl font-bold text-slate-900 tracking-tight">@Model.Readiness.EmployeeName</h1>
            <p class="text-sm text-slate-500 mt-0.5">
                Branch: <strong class="text-slate-800">@Model.BranchName</strong> • Period: <strong class="text-slate-800">@Model.PeriodStatus</strong> • User ID: @Model.Readiness.UserId
            </p>
        </div>

        <div class="flex items-center gap-3">
            <a asp-action="Preview" asp-route-id="@Model.PayrollPeriodId" asp-route-userId="@Model.Readiness.UserId"
               class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-white hover:bg-slate-50 text-slate-700 hover:text-slate-900 border border-slate-200 text-sm font-medium transition-all shadow-sm">
                <span class="material-symbols-outlined text-lg">refresh</span>
                <span>Refresh Source Data</span>
            </a>
        </div>
    </div>

    <!-- Informational Card -->
    <div class="p-4 rounded-2xl bg-amber-50 border border-amber-200 text-amber-900 text-xs flex items-start gap-3 shadow-xs">
        <span class="material-symbols-outlined text-amber-600 text-lg shrink-0 mt-0.5">info</span>
        <div>
            <strong class="font-bold text-sm text-amber-950">Calculation Currently Blocked for this Employee</strong>
            <p class="text-amber-800 mt-1">
                You can inspect the underlying records below. These are live raw source records, not a finalized calculation snapshot. Missing records indicate prerequisites that must be resolved (e.g. reviewed timesheet, approved salary history, or settled previous carry forward) before calculation can proceed.
            </p>
        </div>
    </div>

    <!-- Source Groups Tables (Manager Style) -->
    @foreach (var type in new[] { "TIMESHEET", "WORK", "SALARY", "REWARD", "PENALTY", "ATTENDANCE_DEDUCTION", "CARRY_FORWARD", "HOLIDAY", "HOLIDAY_RULE" })
    {
        var rows = Model.Sources.Where(s => s.Type == type).ToList();
        var title = type switch
        {
            "TIMESHEET" => "Timesheet Source",
            "WORK" => "Work Shifts & Attendance",
            "SALARY" => "Salary Rate Records",
            "REWARD" => "Approved Rewards",
            "PENALTY" => "Recorded Penalties",
            "ATTENDANCE_DEDUCTION" => "Attendance Deductions",
            "CARRY_FORWARD" => "Available Carry Forward (FIFO)",
            "HOLIDAY" => "Public Holidays",
            _ => "Holiday Pay Rules"
        };

        <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden">
            <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between bg-slate-50/60">
                <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-indigo-600 text-lg">database</span>
                    <h3 class="text-sm font-bold text-slate-900">@title</h3>
                </div>
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold bg-indigo-50 text-indigo-700 border border-indigo-200">
                    @rows.Count @(rows.Count == 1 ? "Record" : "Records")
                </span>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse text-xs">
                    <thead>
                        <tr class="border-b border-slate-150 bg-slate-50/50 text-[11px] font-bold text-slate-500 uppercase tracking-wider">
                            <th class="py-3.5 px-6">Source / Description</th>
                            <th class="py-3.5 px-6">Status</th>
                            <th class="py-3.5 px-6">Dates / Range</th>
                            @if (type == "WORK")
                            {
                                <th class="py-3.5 px-6">Check In / Out (UTC+7)</th>
                            }
                            <th class="py-3.5 px-6">Minutes / Rate</th>
                            <th class="py-3.5 px-6 text-right font-bold text-indigo-900">Amount / Balance</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @foreach (var row in rows)
                        {
                            <tr class="hover:bg-slate-50/80 transition-colors">
                                <td class="py-3.5 px-6">
                                    <div class="font-bold text-slate-900">@row.Description</div>
                                    <div class="text-[11px] text-slate-400 mt-0.5 font-mono">Source ID: #@row.SourceId</div>
                                </td>
                                <td class="py-3.5 px-6">
                                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-medium bg-slate-100 text-slate-700 border border-slate-200">
                                        @(string.IsNullOrEmpty(row.Status) ? "RECORDED" : row.Status)
                                    </span>
                                </td>
                                <td class="py-3.5 px-6 text-slate-600">
                                    @(row.WorkDate?.ToString("dd/MM/yyyy") ?? row.EffectiveFrom?.ToString("dd/MM/yyyy") ?? "—")
                                    @if (row.EffectiveTo.HasValue)
                                    {
                                        <span class="block text-[11px] text-slate-400">to @row.EffectiveTo.Value.ToString("dd/MM/yyyy")</span>
                                    }
                                    @if (row.StartAt.HasValue)
                                    {
                                        <span class="block text-[11px] text-slate-400">@D.Time(row.StartAt) – @D.Time(row.EndAt)</span>
                                    }
                                </td>
                                @if (type == "WORK")
                                {
                                    <td class="py-3.5 px-6 text-slate-700 font-mono">
                                        @D.Time(row.CheckIn)
                                        <span class="block text-[11px] text-slate-400">@D.Time(row.CheckOut)</span>
                                    </td>
                                }
                                <td class="py-3.5 px-6 text-slate-700">
                                    @if (row.Minutes.HasValue)
                                    {
                                        <span class="font-medium">@row.Minutes minutes</span>
                                    }
                                    else if (row.Rate.HasValue)
                                    {
                                        <span class="font-medium">@D.Money(row.Rate.Value)/h</span>
                                    }
                                    else if (row.Multiplier.HasValue)
                                    {
                                        <span class="font-medium">×@row.Multiplier</span>
                                    }
                                    else
                                    {
                                        <span class="text-slate-400">—</span>
                                    }
                                </td>
                                <td class="py-3.5 px-6 text-right font-bold text-slate-900">
                                    @(row.Amount.HasValue ? D.Money(row.Amount.Value) : "—")
                                    @if (row.RemainingAmount.HasValue)
                                    {
                                        <span class="block text-[11px] text-amber-700 font-semibold">Remaining: @D.Money(row.RemainingAmount.Value)</span>
                                    }
                                </td>
                            </tr>
                        }
                        @if (rows.Count == 0)
                        {
                            <tr>
                                <td colspan="@(type == "WORK" ? 6 : 5)" class="py-6 text-center text-slate-400">
                                    No source records available in this category.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
